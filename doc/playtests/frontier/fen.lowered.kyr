Module campaign "Saint Orra — Ash and Silver" {
  Description "Installed situations share this persistent world.".
  Kind group.
  Kind place.
  Kind good.
  Kind stock.
  Kind pressure.
  Kind clock.
  Kind fact.
  Kind source.
  Kind mechanism.
  Kind capability.
  Kind member.
  Kind ability.
  Kind reward.
  Relation at(entity, place) exclusive.
  Relation route(place, place).
  Relation closed(place).
  Relation denied(group, place, place).
  Relation footway(place, place).
  Relation gate(group, place, place).
  Relation gatekeeper(group).
  Relation distinct(group, group).
  Relation able(group).
  Relation dead(group).
  Relation released(group).
  Relation sated(group).
  Relation acceptsFood(group).
  Relation carrying(group, good) exclusive.
  Relation unladen(group).
  Relation mayCollect(group, stock).
  Relation job(stock, good).
  Relation hostile(group, group).
  Relation recorded(pressure).
  Relation established(fact).
  Relation reveals(source, fact).
  Relation intact(source).
  Relation noticeable(source).
  Relation destructible(source).
  Relation mayExamine(group, source).
  Relation knows(group, fact).
  Relation assumesFalse(group, fact).
  Relation trusts(group, group).
  Relation learnedFrom(group, source, fact).
  Relation toldBy(group, group, fact).
  Relation publicPlace(place).
  Relation testimony(group, source).
  Relation functioning(mechanism).
  Relation mounted(mechanism, place).
  Relation barrier(mechanism, place).
  Relation operates(group, mechanism).
  Relation keyedBy(mechanism, group).
  Relation supports(group, group).
  Relation seeksBacking(group).
  Relation mandate(group, place).
  Relation controlled(place, group) exclusive.
  Relation informedPassage(place, place, fact).
  Relation capable(group, capability).
  Relation recognizes(group, capability).
  Relation receptive(group, capability).
  Relation memberOf(member, group).
  Relation awake(member).
  Relation needsCare(member).
  Relation canCast(member, ability).
  Relation treatable(member, ability).
  Relation restful(place).
  Relation offeredAt(reward, place).
  Relation giftEffect(reward, ability).
  Relation rewardFor(reward, fact).
  Relation claimed(reward).
  Relation refuge__expelled(group).
  Relation refuge__spoiled(place).
  Relation tower__flooded(place).
  Relation tower__rescued(group).
  Relation offers(group, good).
  Relation salvage(stock).
  Relation margin__frozen(place).
  Measure quantity(entity, good).
  Measure received(group).
  Measure claim(group).
  Measure mercy(group).
  Measure fee(stock).
  Measure required(stock, good).
  Measure watch(clock).
  Measure urgentAt(clock).
  Measure deficit(pressure).
  Measure enforceAt(group).
  Measure margin__departAt(pressure).
  Measure margin__freezeAt(pressure).
  Query paid(who: group) means received(who) >= claim(who).
  Query releaseAllowed(who: group) means (paid(who)) or (((acceptsFood(who)) and (sated(who))) or (watch(clock) >= mercy(who))).
  Entity party: group "Your company".
  Entity refuge__mere: group "Mere, keeper of the refuge".
  Entity refuge__tamsin: group "Tamsin, charcoal worker".
  Entity refuge__green: place "Saint Orra's green".
  Entity refuge__porch: place "Refuge porch".
  Entity refuge__cell: place "Locked guest house".
  Entity refuge__kiln: place "Charcoal kiln".
  Entity gold: good "Coin".
  Entity rations: good "Ration".
  Entity clock: clock "Campaign watch".
  Entity fellowship: capability "the Free Fellowship".
  Entity woodcraft: capability "ranger woodcraft".
  Entity refuge__cistern: stock "Refuge water reserve".
  Entity refuge__water: good "Clean water".
  Entity refuge__latch: mechanism "guest-house latch".
  Entity refuge__furnace: mechanism "kiln's forced-draft bellows".
  Entity refuge__runoff: fact "Silver residue from the watchtower stones is carried into the spring by the kiln's forced draft; Tamsin did not poison the water.".
  Entity refuge__cup: source "Ys’s signed water analysis beneath the testing cup".
  Entity refuge__ledger: source "Firing ledger: illness follows silver-stone firings, even during Tamsin's absence".
  Entity refuge__whereabouts: fact "Healer Ys went beneath the watchtower to recover its silver drain-key. She is alive, not hiding stolen medicine.".
  Entity refuge__letter: source "Ys's letter entrusted to Tamsin".
  Entity refuge__crawl: fact "A charcoal flue behind the kiln enters the watchtower's undercroft, bypassing the guardian's stair.".
  Entity refuge__sketch: source "Chalk flue survey behind the bellows".
  Entity refuge__member_guide: member "Elen" bound to refuge__guide.
  Entity refuge__member_shield: member "Bran" bound to refuge__shield.
  Entity refuge__member_lamp: member "Dori" bound to refuge__lamp.
  Entity refuge__member_keeper: member "Mere" bound to refuge__keeper.
  Entity refuge__member_worker: member "Tamsin" bound to refuge__worker.
  Entity attack: ability "Weapon attack".
  Entity defend: ability "Guard".
  Entity flee: ability "Retreat".
  Entity cleave: ability "Sweeping blow".
  Entity heal: ability "Mend wounds".
  Entity bless: ability "Bless the company".
  Entity purify: ability "Purify".
  Entity revive: ability "Recall the fallen".
  Entity bolt: ability "Ember bolt".
  Entity sleep: ability "Binding sleep".
  Entity ward: ability "Protective ward".
  Entity drain: ability "Siphon life".
  Entity venom: ability "Venom blade".
  Entity ambush: ability "Backstab".
  Entity summon: ability "Call a wisp".
  Entity rally: ability "Second wind".
  Entity wounding_blow: ability "Wounding blow".
  Entity dawn_spark: ability "Dawn spark".
  Entity rending_bite: ability "Rending bite".
  Entity camp_recovery: ability "Sheltered recovery".
  Entity cinder_lesson: ability "Cinder lesson".
  Entity cinder: ability "Cinder invocation".
  Entity rime_bite: ability "Rime bite".
  Entity winter_howl: ability "Winter howl".
  Entity tower__moor: place "Wind-bitten moor".
  Entity tower__cairn: place "Broken watchtower".
  Entity tower__vault: place "Drowned undercroft".
  Entity tower__spring: place "Silver-water reservoir".
  Entity tower__wolf: group "The grey she-wolf".
  Entity tower__hart: group "The antlered warden".
  Entity tower__ys: group "Ys, the missing healer".
  Entity tower__siphon: mechanism "the silver siphon".
  Entity tower__hatch: mechanism "reservoir inspection hatch".
  Entity tower__burial: fact "The antlered warden swore to keep grave robbers from the reservoir. Ys entered to drain it, not plunder the dead.".
  Entity tower__inscription: source "An oath carved into the watchtower stair".
  Entity tower__account: source "Ys's account of her descent".
  Entity tower__cinder_gift: reward "Ys's one-use cinder seal".
  Entity tower__member_animal: member "Grey" bound to tower__animal.
  Entity tower__member_warden: member "Antlered warden" bound to tower__warden.
  Entity tower__member_healer: member "Ys" bound to tower__healer.
  Entity margin__tala: group "Orin Reedwalker, northern guide and trader".
  Entity margin__frostback: group "Frostback, altered wolf".
  Entity margin__track: place "Alder causeway".
  Entity margin__camp: place "Reedcutters’ camp".
  Entity margin__ford: place "Silt ford".
  Entity margin__shrine: place "Drowned winter shrine".
  Entity margin__font: mechanism "the winter shrine's ice-pump".
  Entity margin__purse: stock "a salvager's scattered purse".
  Entity margin__winter: pressure "The camp’s frost line".
  Entity margin__old_trail: fact "A dry shepherds' ledge runs from the northern track into the winter shrine, bypassing the ford.".
  Entity margin__trail_note: source "The guide's marked shepherds' route".
  Entity margin__winter_engine: fact "The winter shrine's ice-pump causes the spreading frost; dismantling its exposed intake stops further growth but does not repair frozen shelters.".
  Entity margin__tide_marks: source "A salvager's account of the ice-pump and its tide marks".
  Entity margin__member_tala_person: member "Orin Reedwalker" bound to margin__tala_person.
  Entity margin__member_frostback_person: member "Frostback" bound to margin__frostback_person.
  Pursuit hear_challenge for refuge__mere priority 30 when knows(refuge__mere, refuge__runoff) seeks not (closed(refuge__cell)).
  Pursuit stop_poison for refuge__mere priority 20 when knows(refuge__mere, refuge__runoff) seeks not (functioning(refuge__furnace)).
  Pursuit return_to_duty for refuge__mere priority 10 when (not (functioning(refuge__furnace))) and (not (closed(refuge__cell))) seeks at(refuge__mere, refuge__porch).
  Pursuit seek_work for refuge__tamsin priority 10 when not (closed(refuge__cell)) seeks at(refuge__tamsin, refuge__kiln).
  Pursuit hungry for tower__wolf priority 10 when not (sated(tower__wolf)) seeks sated(tower__wolf).
  Pursuit let_pass for tower__wolf priority 9 when sated(tower__wolf) seeks released(tower__wolf).
  Pursuit honor_oath for tower__hart priority 30 when knows(tower__hart, tower__burial) seeks at(tower__hart, tower__moor).
  Pursuit open_drain for tower__ys priority 20 when able(tower__ys) seeks not (closed(tower__spring)).
  Pursuit homeward for tower__ys priority 10 when not (functioning(tower__siphon)) seeks at(tower__ys, refuge__green).
  Pursuit leave_danger for margin__tala priority 20 when (functioning(margin__font)) and (watch(clock) >= margin__departAt(margin__winter)) seeks at(margin__tala, refuge__green).
  Pursuit reopen_trade for margin__tala priority 10 when (not (functioning(margin__font))) and (not (margin__frozen(margin__camp))) seeks at(margin__tala, margin__camp).
  Rule refuge__fellowship_hearing when (released(refuge__mere)) and (closed(refuge__cell)) {
    Retract closed(refuge__cell).
  }
  Rule refuge__expulsion when (watch(clock) >= 28) and ((able(refuge__mere)) and ((not (knows(refuge__mere, refuge__runoff))) and (not (refuge__expelled(refuge__tamsin))))) {
    Assert refuge__expelled(refuge__tamsin).
    Assert at(refuge__tamsin, refuge__green).
    Assert closed(refuge__cell).
  }
  Rule refuge__pollution when (watch(clock) >= 20) and ((functioning(refuge__furnace)) and (not (refuge__spoiled(refuge__green)))) {
    Assert refuge__spoiled(refuge__green).
    Set quantity(refuge__cistern, refuge__water) to 0.
  }
  Rule tower__oath_passage when (knows(tower__hart, tower__burial)) and (not (released(tower__hart))) {
    Assert released(tower__hart).
  }
  Rule tower__overflow when (watch(clock) >= 36) and ((functioning(tower__siphon)) and (not (tower__flooded(tower__moor)))) {
    Assert tower__flooded(tower__moor).
    Assert closed(tower__cairn).
  }
  Rule tower__home when (at(tower__ys, refuge__green)) and (not (tower__rescued(tower__ys))) {
    Assert tower__rescued(tower__ys).
  }
  Rule tower__offer_lesson when (tower__rescued(tower__ys)) and ((able(tower__ys)) and (not (claimed(tower__cinder_gift)))) {
    Assert offeredAt(tower__cinder_gift, refuge__green).
    Assert at(tower__cinder_gift, refuge__green).
  }
  Rule margin__encroachment when (watch(clock) >= margin__freezeAt(margin__winter)) and ((functioning(margin__font)) and (not (margin__frozen(margin__camp)))) {
    Assert margin__frozen(margin__camp).
    Assert closed(margin__camp).
    Retract restful(margin__camp).
  }
  Observe refuge__arrival at refuge__green when (not (refuge__spoiled(refuge__green))) and (not (knows(refuge__mere, refuge__runoff))) "A barefoot child watches the testing cup beside the spring. A chalk notice blames Tamsin for the sickness; the cup covers Ys's sealed water analysis. Her note and the firing ledger can be read independently. East is the refuge porch, west the kiln, north the moor and ruined watchtower. Mere hears documented challenges. Read the analysis or the kiln ledger before accepting the accusation. The spring will be spoiled at watch 20 if firing continues.".
  Observe refuge__polluted at refuge__green when refuge__spoiled(refuge__green) "A silver scum covers the spring. Stopping the bellows now prevents further discharge but cannot restore the stored water. The refuge's clean-water reserve has been emptied. Water collected earlier remains yours.".
  Observe refuge__judgment at refuge__porch when (closed(refuge__cell)) and (able(refuge__mere)) "Mere holds the guest-house key. 'One sick child and a missing healer. I cannot risk another. I will open a hearing if you bring evidence against my judgment.' Her founding compact also admits a company of human, elf and dwarf together. Tamsin's expulsion is set for watch 28. The door is a physical barrier; if its keeper falls, you can recover her key and open it yourself; that proves nothing about the charge.".
  Observe refuge__hearing at refuge__porch when not (closed(refuge__cell)) "The guest-house door stands open. Tamsin can leave; Mere's decision is no longer a prison sentence. The illness and the missing healer remain separate problems. Disabling the kiln ends the discharge but also its warmth.".
  Observe refuge__guest at refuge__cell when at(refuge__tamsin, refuge__cell) "Tamsin sits beside a letter. 'Ys went to the tower, not away with the medicine. I promised to wait for her. Burning old stone made the glaze white; I thought it harmless.' She offers the letter freely. She cannot tell you what happened after Ys descended.".
  Observe refuge__empty at refuge__cell when not (at(refuge__tamsin, refuge__cell)) "Tamsin's blanket is folded on the empty pallet. Her letter remains; a person's departure does not erase written evidence.".
  Observe refuge__fire at refuge__kiln when functioning(refuge__furnace) "Bellows drive hot air through silver-flecked stones scavenged from the watchtower. You can dismantle the draft here without anyone's permission. It will stop the firing—and the refuge's heat. A ledger and flue survey lie under a loose slate. The water discharge will reach the spring at watch 20.".
  Observe refuge__cold at refuge__kiln when not (functioning(refuge__furnace)) "The dismantled bellows lie beside cold stone. No more silver ash rises toward the spring. Families huddle under blankets: removing a danger did not replace their livelihood or heat. The tower's drain still needs attention.".
  Observe refuge__cleared at refuge__kiln when (knows(refuge__mere, refuge__runoff)) and (at(refuge__tamsin, refuge__kiln)) "Tamsin has returned to her workplace after Mere accepted the evidence. The false accusation is withdrawn; the cold kiln remains a real loss. 'Find Ys. She knew how to drain the tower without firing these stones.'".
  Observe refuge__banished at refuge__green when (refuge__expelled(refuge__tamsin)) and (at(refuge__tamsin, refuge__green)) "Tamsin waits outside with her blanket. The expulsion happened even while you were elsewhere. Evidence can still change Mere's knowledge; it cannot erase the day Tamsin lost her shelter.".
  Observe refuge__rest_offer at refuge__porch when true "Spare pallets and a cookpot offer six hours of recovery here for one shared ration. You may stop, but the outside world will not wait. Recovery restores living companions' health and mana and treats bleeding; it does not reverse death or purge poison.".
  Observe refuge__cleared_square at refuge__green when (knows(refuge__mere, refuge__runoff)) and (not (refuge__spoiled(refuge__green))) "The spring runs clear and the accusation against Tamsin has been withdrawn. The refuge is colder after the kiln stopped. The northern track leads toward the trappers' camp; the watchtower still holds whatever this company has left unresolved. You can prepare at the refuge, speak to Ys if she has returned, or choose a fresh expedition.".
  Observe tower__trail at tower__moor when (not (tower__flooded(tower__moor))) and ((able(tower__wolf)) and (not (released(tower__wolf)))) "A gaunt she-wolf stands over a den at the tower path. She watches your food, not your throat. A ranger can read her warning and pass; anyone can give her a ration and wait for her to eat. You may fight, but her death will be permanent. The green is behind you; the watchtower lies beyond her.".
  Observe tower__quiet at tower__moor when (released(tower__wolf)) or (dead(tower__wolf)) "The path to the watchtower is passable. Beyond the broken arch, antlers scrape against stone. A low voice repeats an oath. The reservoir's tide mark is climbing toward watch 36.".
  Observe tower__flood at tower__moor when tower__flooded(tower__moor) "Silver water has drowned the direct tower path. The collapse cannot be reversed by stopping the siphon now. The charcoal flue remains another entrance if you discovered it. The green is still reachable.".
  Observe tower__warden at tower__cairn when (able(tower__hart)) and (not (released(tower__hart))) "A revenant wearing a stag's skull bars the stair. 'No plunderer passes.' The oath is carved beside its hand. Ordinary weapons deal half damage to it; fire deals half again as much, radiant twice as much. It can drain life, shield itself and cast sleep resisted by wisdom. Reading and communicating its oath may establish why you came; it is not a promise that every undead creature will listen.".
  Observe tower__departed at tower__cairn when released(tower__hart) "The warden has accepted the healer's purpose and left the stair. Its oath remains carved in stone. The reservoir is still dangerous; gaining passage did not repair it.".
  Observe tower__slain at tower__cairn when dead(tower__hart) "The antlered skull is broken. The stair is clear. No one remains here to guard the dead, and the tide continues to rise.".
  Observe tower__healer at tower__vault when (at(tower__ys, tower__vault)) and (able(tower__ys)) "Ys crouches above a silver tide. 'I can open the inspection hatch. You can dismantle the siphon beyond it; I cannot abandon the patients above until this is done.' The charcoal flue leads back to the kiln. The guardian's stair leads up to the watchtower.".
  Observe tower__working at tower__spring when functioning(tower__siphon) "Silver water climbs through a narrow glass tube. Its intake brace is exposed. Dismantling the siphon prevents the reservoir overflowing at watch 36; any flooded ground stays flooded. The hatch and undercroft remain behind you.".
  Observe tower__drained at tower__spring when not (functioning(tower__siphon)) "The tube drains and the water falls below the tide marks. The reservoir has stopped climbing. Ys can return by the tower path. The stair allows anyone already below to leave; the guardian bars entry, not escape.".
  Observe tower__returned at refuge__green when (tower__rescued(tower__ys)) and (able(tower__ys)) "Ys has returned from below the watchtower. She has seen what poisoned the spring and can offer her account here. The missing-person search is over, but spoiled water, a lost kiln and dead creatures remain consequences of your history.".
  Observe margin__approach at margin__track when true "The northern track leaves Orra behind. A side path reaches a camp of trappers and salvagers. Beyond it the white ford leads to a ruined shrine. The guide at camp knows a way around the ford. You can return to Orra from here without entering the shrine.".
  Observe margin__shelter at margin__camp when not (margin__frozen(margin__camp)) "Pallets surround a small cookpot. The guide sells finite rations when present; recovery here takes six hours and one shared ration. A marked route lies beside the fire. The shelters will fail at watch {margin__freezeAt(margin__winter)} if the ice-pump still runs. The guide plans to leave at watch {margin__departAt(margin__winter)}.".
  Observe margin__departure at margin__camp when (not (at(margin__tala, margin__camp))) and (not (margin__frozen(margin__camp))) "The guide has left. You can still use the pallets, but there is no one here to trade. Quieting the shrine before the shelters freeze can bring the guide back.".
  Observe margin__ice at margin__camp when margin__frozen(margin__camp) "The shelters have split beneath ice. They no longer offer safe recovery. The old camp will remain damaged even if you stop the source. Orra's refuge is still reachable by the northern track.".
  Observe margin__beast at margin__ford when able(margin__frostback) "The rime-matted wolf holds the causeway. Its cold bite can weaken a companion; its howl can stun unless resisted by wisdom. It resists physical and cold damage, but fire deals extra damage. A fire invocation from Ys can help. A guide's ledge can bypass the encounter entirely. Retreat preserves both sides' injuries.".
  Observe margin__carcass at margin__ford when dead(margin__frostback) "The altered wolf lies dead. The causeway is clear. Its death has not dismantled the machine beyond it.".
  Observe margin__working at margin__shrine when functioning(margin__font) "A bronze intake pumps silver-white cold into the ground. Its retaining pins are exposed and can be dismantled. A scattered purse lies among salvager's bones; you can take the money without repairing the shrine. The exit leads back toward the ford, and a dry ledge returns directly to the northern track.".
  Observe margin__quiet at margin__shrine when not (functioning(margin__font)) "The intake has stopped. Frost no longer advances from the shrine. Any shelter already split by ice remains ruined. The purse and the dead remain where this history left them. You can return to Orra, recover and choose another journey.".
  Observe margin__return_report at refuge__green when (margin__frozen(margin__camp)) and ((at(margin__tala, refuge__green)) and (able(margin__tala))) "The northern guide has returned with a report: the camp's shelters split under the shrine's frost. Their supply service has moved with them; the old safe stopping place has been lost.".
  Observe margin__signpost at refuge__green when true "A northern sign points toward a trappers' camp and a winter shrine. The guide there sells rations and knows the route. Ys went beneath the watchtower to the south of that margin; you can seek her, travel north or remain at the refuge. These are choices, not orders.".
  Initially Assert at(refuge__cistern, refuge__green).
  Initially Set quantity(refuge__cistern, refuge__water) to 2.
  Initially Assert mayCollect(party, refuge__cistern).
  Initially Assert unladen(party).
  Initially Assert at(party, refuge__green).
  Initially Assert at(refuge__mere, refuge__porch).
  Initially Assert at(refuge__tamsin, refuge__cell).
  Initially Assert route(refuge__green, refuge__porch).
  Initially Assert route(refuge__porch, refuge__green).
  Initially Assert route(refuge__green, refuge__kiln).
  Initially Assert route(refuge__kiln, refuge__green).
  Initially Assert route(refuge__porch, refuge__cell).
  Initially Assert route(refuge__cell, refuge__porch).
  Initially Assert closed(refuge__cell).
