  Initially Assert established(refuge__whereabouts).
  Initially Assert knows(refuge__tamsin, refuge__whereabouts).
  Initially Assert reveals(refuge__letter, refuge__whereabouts).
  Initially Assert at(refuge__letter, refuge__cell).
  Initially Assert intact(refuge__letter).
  Initially Assert noticeable(refuge__letter).
  Initially Assert mayExamine(party, refuge__letter).
  Initially Assert testimony(refuge__tamsin, refuge__letter).
  Initially Assert established(refuge__crawl).
  Initially Assert reveals(refuge__sketch, refuge__crawl).
  Initially Assert at(refuge__sketch, refuge__kiln).
