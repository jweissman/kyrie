  Initially Assert distinct(refuge__mere, refuge__tamsin).
  Initially Assert distinct(refuge__tamsin, party).
  Initially Assert distinct(refuge__tamsin, refuge__mere).
  Initially Assert at(tower__wolf, tower__moor).
  Initially Assert at(tower__hart, tower__cairn).
