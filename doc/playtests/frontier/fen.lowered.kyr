  Initially Assert destructible(refuge__sketch).
  Initially Assert restful(refuge__porch).
  Initially Set quantity(party, gold) to 4.
  Initially Set quantity(party, rations) to 2.
  Initially Assert memberOf(refuge__member_guide, party).
  Initially Assert memberOf(refuge__member_shield, party).
  Initially Assert memberOf(refuge__member_lamp, party).
  Initially Assert memberOf(refuge__member_keeper, refuge__mere).
