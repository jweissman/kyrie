  "established": [
    {
      "id": "refuge__runoff",
      "type": "fact",
      "name": "Silver residue from the watchtower stones is carried into the spring by the kiln's forced draft; Tamsin did not poison the water."
    },
    {
      "id": "refuge__whereabouts",
      "type": "fact",
      "name": "Healer Ys went beneath the watchtower to recover its silver drain-key. She is alive, not hiding stolen medicine."
    },
    {
      "id": "refuge__crawl",
      "type": "fact",
      "name": "A charcoal flue behind the kiln enters the watchtower's undercroft, bypassing the guardian's stair."
    },
    {
      "id": "tower__burial",
      "type": "fact",
      "name": "The antlered warden swore to keep grave robbers from the reservoir. Ys entered to drain it, not plunder the dead."
    },
    {
      "id": "margin__old_trail",
      "type": "fact",
      "name": "A dry shepherds' ledge runs from the northern track into the winter shrine, bypassing the ford."
    },
    {
      "id": "margin__winter_engine",
      "type": "fact",
      "name": "The winter shrine's ice-pump causes the spreading frost; dismantling its exposed intake stops further growth but does not repair frozen shelters."
    }
  ],
