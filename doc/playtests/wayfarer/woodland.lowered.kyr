  Initially Assert distinct(world__wildlife, world__host).
  Initially Assert distinct(world__wildlife, world__sentinel).
  Initially Assert distinct(world__sentinel, party).
  Initially Assert distinct(world__sentinel, world__apothecary).
  Initially Assert distinct(world__sentinel, world__guest).
  Initially Assert distinct(world__sentinel, world__host).
  Initially Assert distinct(world__sentinel, world__wildlife).
  Initially Assert fieldUsable(heal).
  Initially Assert fieldUsable(purify).
  Initially Assert fieldUsable(minor_healing_potion).
  Initially Assert fieldUsable(antidote_dose).
  Initially Assert fieldUsable(orsino_luminous_touch).
  Initially Assert fieldUsable(orsino_cure_minor).
  Initially Assert fieldUsable(orsino_fireproof).
  Initially Assert fieldUsable(wayfarer_blessing).
  Initially Assert established(charter__localfounding_oath).
  Initially Assert assumesFalse(world__host, charter__localfounding_oath).
  Initially Assert reveals(charter__charter, charter__localfounding_oath).
  Initially Assert at(charter__charter, world__porch).
  Initially Assert intact(charter__charter).
  Initially Assert noticeable(charter__charter).
  Initially Assert mayExamine(party, charter__charter).
  Initially Assert fieldUsable(heal).
  Initially Assert fieldUsable(purify).
  Initially Assert fieldUsable(minor_healing_potion).
  Initially Assert fieldUsable(antidote_dose).
  Initially Assert fieldUsable(orsino_luminous_touch).
  Initially Assert fieldUsable(orsino_cure_minor).
  Initially Assert fieldUsable(orsino_fireproof).
  Initially Assert fieldUsable(wayfarer_blessing).
  Budget 0.
  Goal false.

  Action wait(actor: group) "Wait" {
    Description "".
    Requires able(actor).
    Cost 1. Time 1.
    On success {
    }
  }

  Action travel(actor: group, origin: place, destination: place) "Travel to {destination}" {
    Description "".
    Requires (able(actor)) and ((at(actor, origin)) and ((route(origin, destination)) and ((not (closed(destination))) and (not (denied(actor, origin, destination)))))).
    Cost 1. Time 1.
    Result "You follow the route and arrive at the next place. People and dangers continue while you travel.".
    On success {
      Assert at(actor, destination).
    }
  }

  Action walk(actor: group, origin: place, destination: place) "Walk the footpath to {destination}" {
    Description "".
    Requires (able(actor)) and ((at(actor, origin)) and ((unladen(actor)) and (footway(origin, destination)))).
    Cost 1. Time 1.
    On success {
      Assert at(actor, destination).
    }
  }

  Action cross(actor: group, origin: place, destination: place, defender: group) "Cross past {defender} to {destination}" {
    Description "".
    Requires (able(actor)) and ((at(actor, origin)) and ((gate(defender, origin, destination)) and (((released(defender)) or (not (able(defender)))) and (not (closed(destination)))))).
    Cost 1. Time 1.
    On success {
      Assert at(actor, destination).
    }
  }

  Action pay(actor: group, recipient: group, site: place) "Give {recipient} one coin" {
    Description "".
    Requires (able(actor)) and ((able(recipient)) and ((distinct(actor, recipient)) and ((at(actor, site)) and ((at(recipient, site)) and (quantity(actor, gold) >= 1))))).
    Cost 1. Time 1.
    Result "You hand over one coin. It is now in the recipient’s purse.".
    On success {
      Decrease quantity(actor, gold) by 1.
      Increase quantity(recipient, gold) by 1.
      Increase received(recipient) by 1.
    }
  }

  Action give_food(actor: group, recipient: group, site: place) "Give {recipient} one ration" {
    Description "".
    Requires (able(actor)) and ((able(recipient)) and ((distinct(actor, recipient)) and ((at(actor, site)) and ((at(recipient, site)) and (quantity(actor, rations) >= 1))))).
    Cost 1. Time 1.
    Result "You offer a ration and step back. The recipient now owns it; what they do next is their decision.".
    On success {
      Decrease quantity(actor, rations) by 1.
      Increase quantity(recipient, rations) by 1.
    }
  }

  Action eat(actor: group) "Eat a ration" {
    Description "".
    Requires (able(actor)) and ((not (sated(actor))) and (quantity(actor, rations) >= 1)).
    Cost 1. Time 1.
    Result "The company shares a ration. This satisfies hunger but does not restore health or mana.".
    On success {
      Decrease quantity(actor, rations) by 1.
      Assert sated(actor).
    }
  }

  Action release(actor: group) "End the blockade" {
    Description "".
    Requires (able(actor)) and ((gatekeeper(actor)) and ((not (released(actor))) and (releaseAllowed(actor)))).
    Cost 1. Time 1.
    On success {
      Assert released(actor).
    }
  }

  Action collect(actor: group, store: stock, goods: good, site: place) "Collect one {goods} from {store}" {
    Description "".
    Requires (able(actor)) and ((at(actor, site)) and ((at(store, site)) and ((mayCollect(actor, store)) and ((unladen(actor)) and (quantity(store, goods) >= 1))))).
    Cost 1. Time 1.
    Result "You collect one unit from the available stock. It is now carried by the company.".
    On success {
      Decrease quantity(store, goods) by 1.
      Retract unladen(actor).
      Assert carrying(actor, goods).
    }
  }

  Action put(actor: group, store: stock, goods: good, site: place) "Deposit one {goods} in {store}" {
    Description "".
    Requires (able(actor)) and ((at(actor, site)) and ((at(store, site)) and (carrying(actor, goods)))).
    Cost 1. Time 1.
    Result "You deposit what the company was carrying. The stock increases and your hands are free.".
    On success {
      Retract carrying(actor, goods).
      Assert unladen(actor).
      Increase quantity(store, goods) by 1.
    }
  }

  Action fulfill_job(actor: group, store: stock, goods: good, site: place) "Deliver {goods} to {store} for pay" {
    Description "".
    Requires (able(actor)) and ((at(actor, site)) and ((at(store, site)) and ((carrying(actor, goods)) and ((job(store, goods)) and (quantity(store, gold) >= 1))))).
    Cost 1. Time 1.
    On success {
      Retract carrying(actor, goods).
      Assert unladen(actor).
      Increase quantity(store, goods) by 1.
      Decrease quantity(store, gold) by 1.
      Increase quantity(actor, gold) by 1.
    }
  }

  Action attack(actor: group, opponent: group, site: place) "Attack {opponent}" {
    Description "".
    Requires (able(actor)) and ((able(opponent)) and ((distinct(actor, opponent)) and ((at(actor, site)) and (at(opponent, site))))).
    Cost 1. Time 1.
    Resolve combat(opponent).
    On success {
      Assert hostile(actor, opponent).
      Assert hostile(opponent, actor).
    }
    On failure {
      Assert hostile(actor, opponent).
      Assert hostile(opponent, actor).
    }
  }

  Action examine(actor: group, witness: source, statement: fact, site: place) "Examine {witness}" {
    Description "".
    Requires (able(actor)) and ((at(actor, site)) and ((at(witness, site)) and ((noticeable(witness)) and ((intact(witness)) and ((mayExamine(actor, witness)) and ((reveals(witness, statement)) and ((established(statement)) and (not (learnedFrom(actor, witness, statement)))))))))).
    Cost 1. Time 1.
    On success {
      Assert knows(actor, statement).
      Retract assumesFalse(actor, statement).
      Assert learnedFrom(actor, witness, statement).
    }
  }

  Action tell(actor: group, recipient: group, statement: fact, site: place) "Tell {recipient}: {statement}" {
    Description "".
    Requires (able(actor)) and ((able(recipient)) and ((distinct(actor, recipient)) and ((at(actor, site)) and ((at(recipient, site)) and ((trusts(recipient, actor)) and ((knows(actor, statement)) and ((established(statement)) and (not (toldBy(recipient, actor, statement)))))))))).
    Cost 1. Time 1.
    Result "You explain what the evidence establishes. The listener accepts your account and sets aside a conflicting assumption; their next choices remain their own.".
    On success {
      Assert knows(recipient, statement).
      Retract assumesFalse(recipient, statement).
      Assert toldBy(recipient, actor, statement).
    }
  }

  Action ask(actor: group, informant: group, topic: source, statement: fact, site: place) "Ask {informant} about {topic}" {
    Description "Ask about an offered topic. The speaker shares an established fact they actually know.".
    Requires (able(actor)) and ((able(informant)) and ((distinct(actor, informant)) and ((at(actor, site)) and ((at(informant, site)) and ((testimony(informant, topic)) and ((reveals(topic, statement)) and ((noticeable(topic)) and ((knows(informant, statement)) and ((established(statement)) and (not (toldBy(actor, informant, statement)))))))))))).
    Cost 1. Time 1.
    Result "The speaker shares an account they know. You record it in your journal.".
    On success {
      Assert knows(actor, statement).
      Retract assumesFalse(actor, statement).
      Assert toldBy(actor, informant, statement).
    }
  }

  Action destroy_source(actor: group, witness: source, site: place) "Destroy {witness}" {
    Description "".
    Requires (able(actor)) and ((at(actor, site)) and ((at(witness, site)) and ((noticeable(witness)) and ((intact(witness)) and (destructible(witness)))))).
    Cost 1. Time 1.
    Result "You destroy this source of evidence. Existing knowledge and other sources remain.".
    On success {
      Retract intact(witness).
    }
  }

  Action take_control(actor: group, device: mechanism, keeper: group, site: place) "Take the key for {device} from {keeper}" {
    Description "Recover access from an incapacitated keeper here. You must still operate the mechanism yourself.".
    Requires (able(actor)) and ((not (able(keeper))) and ((at(actor, site)) and ((at(keeper, site)) and ((mounted(device, site)) and ((keyedBy(device, keeper)) and (not (operates(actor, device)))))))).
    Cost 1. Time 1.
    Result "You recover the keeper’s key. You can now operate the mechanism; it has not opened by itself.".
    On success {
      Assert operates(actor, device).
    }
  }

  Action endorse(actor: group, recipient: group, site: place) "Pledge support to {recipient}" {
    Description "Publicly put your name behind this person's claim.".
    Requires (able(actor)) and ((able(recipient)) and ((distinct(actor, recipient)) and ((at(actor, site)) and ((at(recipient, site)) and ((seeksBacking(recipient)) and (not (supports(actor, recipient)))))))).
    Cost 1. Time 1.
    On success {
      Assert supports(actor, recipient).
    }
  }

  Action enforce(actor: group, site: place) "Establish control of {site}" {
    Description "".
    Requires (able(actor)) and ((at(actor, site)) and ((mandate(actor, site)) and ((not (controlled(site, actor))) and (watch(clock) >= enforceAt(actor))))).
    Cost 1. Time 1.
    On success {
      Assert controlled(site, actor).
    }
  }

  Action disable(actor: group, device: mechanism, site: place) "Disable {device}" {
    Description "Dismantle an accessible mechanism you are equipped to work on. The change persists.".
    Requires (able(actor)) and ((at(actor, site)) and ((mounted(device, site)) and ((operates(actor, device)) and (functioning(device))))).
    Cost 1. Time 1.
    Result "You dismantle the operating mechanism. It stops; any earlier damage remains.".
    On success {
      Retract functioning(device).
    }
  }

  Action shut(actor: group, device: mechanism, site: place, destination: place) "Close {device}" {
    Description "Close the passage this mechanism controls. People already inside can leave.".
    Requires (able(actor)) and ((at(actor, site)) and ((mounted(device, site)) and ((barrier(device, destination)) and ((operates(actor, device)) and (not (closed(destination))))))).
    Cost 1. Time 1.
    Result "You close the barrier. People already beyond it can leave.".
    On success {
      Assert closed(destination).
    }
  }

  Action open(actor: group, device: mechanism, site: place, destination: place) "Open {device}" {
    Description "Reopen the physical passage. This does not make the place beyond it safe.".
    Requires (able(actor)) and ((at(actor, site)) and ((mounted(device, site)) and ((barrier(device, destination)) and ((operates(actor, device)) and (closed(destination)))))).
    Cost 1. Time 1.
    Result "You open the barrier. The passage beyond is now available, though it may still be dangerous.".
    On success {
      Retract closed(destination).
    }
  }

  Action passage(actor: group, origin: place, destination: place, statement: fact) "Follow the concealed passage to {destination}" {
    Description "".
    Requires (able(actor)) and ((at(actor, origin)) and ((informedPassage(origin, destination, statement)) and ((knows(actor, statement)) and (not (closed(destination)))))).
    Cost 1. Time 1.
    Result "You follow the route you learned about and emerge beyond the obstruction.".
    On success {
      Assert at(actor, destination).
    }
  }

  Action request_passage(actor: group, keeper: group, identity: capability, site: place) "Request passage from {keeper} as {identity}" {
    Description "Invoke a company identity this keeper has explicitly agreed to honor. This is not general persuasion.".
    Requires (able(actor)) and ((able(keeper)) and ((distinct(actor, keeper)) and ((at(actor, site)) and ((at(keeper, site)) and ((recognizes(keeper, identity)) and ((capable(actor, identity)) and (not (released(keeper))))))))).
    Cost 1. Time 1.
    Result "You invoke the compact. The keeper honors your company’s standing and grants passage.".
    On success {
      Assert released(keeper).
    }
  }

  Action approach_wildlife(actor: group, animal: group, skill: capability, site: place) "Approach {animal} using {skill}" {
    Description "Read the signals of an explicitly receptive animal and pass without provoking it. Hostile animals cannot be approached this way.".
    Requires (able(actor)) and ((able(animal)) and ((distinct(actor, animal)) and ((at(actor, site)) and ((at(animal, site)) and ((receptive(animal, skill)) and ((capable(actor, skill)) and ((not (hostile(animal, actor))) and (not (released(animal)))))))))).
    Cost 1. Time 1.
    Result "You read the animal’s signals and approach without provoking it. The guarded route is now available.".
    On success {
      Assert released(animal).
    }
  }

  Action field_spell(actor: group, caster: member, technique: ability, recipient: member, site: place) "Have {caster} use {technique} on {recipient}" {
    Description "Use a known healing or cleansing ability outside combat. Its normal mana cost is paid; combat cooldowns do not apply.".
    Requires (able(actor)) and ((at(actor, site)) and ((memberOf(caster, actor)) and ((memberOf(recipient, actor)) and ((fieldUsable(technique)) and ((awake(caster)) and ((awake(recipient)) and ((needsCare(recipient)) and ((canCast(caster, technique)) and (treatable(recipient, technique)))))))))).
    Cost 1. Time 1.
    Result "You pause to tend a companion. The same spell effects and mana costs apply here as in battle.".
    Resolve invoke(technique, caster, recipient).
    On success {
    }
  }

  Action rest(actor: group, site: place) "Rest and recover at {site}" {
    Description "Spend six hours and one shared ration at a safe shelter. Living companions recover HP and mana; bleeding is treated. Poison and death remain. Other people and deadlines continue.".
    Requires (able(actor)) and ((at(actor, site)) and ((restful(site)) and (quantity(actor, rations) >= 1))).
    Cost 1. Time 36.
    Result "You settle in for six hours, sharing a ration and tending your wounds. The world continues outside.".
    Resolve recover(actor).
    On success {
      Decrease quantity(actor, rations) by 1.
    }
  }

  Action learn_reward(actor: group, gift: reward, recipient: member, lesson: ability, proof: fact, site: place) "Accept {gift} for {recipient}" {
    Description "".
    Requires (able(actor)) and ((at(actor, site)) and ((offeredAt(gift, site)) and ((memberOf(recipient, actor)) and ((awake(recipient)) and ((giftEffect(gift, lesson)) and ((rewardFor(gift, proof)) and ((knows(actor, proof)) and (not (claimed(gift)))))))))).
    Cost 1. Time 1.
    Result "The chosen companion studies the one-use lesson. Its power is spent, but the learned ability remains available on future expeditions.".
    Resolve reward(lesson, recipient).
    On success {
      Assert claimed(gift).
      Retract offeredAt(gift, site).
      Retract at(gift, site).
    }
  }

  Action buy(actor: group, merchant: group, goods: good, site: place) "Buy one {goods} from {merchant} for two coins" {
    Description "Trade two coins for one unit from a present merchant's finite stock. This is a posted price, not a negotiation simulation.".
    Requires (able(actor)) and ((able(merchant)) and ((distinct(actor, merchant)) and ((at(actor, site)) and ((at(merchant, site)) and ((offers(merchant, goods)) and ((quantity(merchant, goods) >= 1) and (quantity(actor, gold) >= 2))))))).
    Cost 1. Time 1.
    Result "You pay two coins and receive one unit of supplies. The merchant's stock and both purses change accordingly.".
    On success {
      Decrease quantity(actor, gold) by 2.
      Increase quantity(merchant, gold) by 2.
      Decrease quantity(merchant, goods) by 1.
      Increase quantity(actor, goods) by 1.
    }
  }

  Action salvage_coin(actor: group, store: stock, site: place) "Recover a coin from {store}" {
    Description "".
    Requires (able(actor)) and ((at(actor, site)) and ((at(store, site)) and ((salvage(store)) and (quantity(store, gold) >= 1)))).
    Cost 1. Time 1.
    Result "You recover one coin from the finite cache. It is now in the company's purse.".
    On success {
      Decrease quantity(store, gold) by 1.
      Increase quantity(actor, gold) by 1.
    }
  }

  Action take_item(actor: group, find: item, form: itemkind, recipient: member, site: place) "Collect {find} for {recipient}" {
    Description "".
    Requires (able(actor)) and ((at(actor, site)) and ((at(find, site)) and ((not (forSale(find))) and ((itemKind(find, form)) and ((memberOf(recipient, actor)) and (awake(recipient))))))).
    Cost 1. Time 1.
    Result "The item is now carried by the chosen companion. It will remain with them between expeditions.".
    Resolve acquire(find, form, recipient).
    On success {
      Retract at(find, site).
    }
  }

  Action buy_item(actor: group, find: item, form: itemkind, recipient: member, merchant: group, site: place) "Buy {find} for {recipient}" {
    Description "".
    Requires (able(actor)) and ((at(actor, site)) and ((at(find, site)) and ((forSale(find)) and ((itemKind(find, form)) and ((memberOf(recipient, actor)) and ((awake(recipient)) and ((soldBy(find, merchant)) and ((able(merchant)) and ((at(merchant, site)) and ((distinct(actor, merchant)) and (quantity(actor, gold) >= price(find)))))))))))).
    Cost 1. Time 1.
    Result "You pay the posted price and take possession of the item. This finite stock is not replaced when you return.".
    Resolve purchase(find, form, recipient, actor, merchant).
    On success {
      Retract at(find, site).
      Retract forSale(find).
    }
  }

  Action equip_item(actor: group, tool: item, form: itemkind, wearer: member) "Equip {tool} on {wearer}" {
    Description "".
    Requires (able(actor)) and ((memberOf(wearer, actor)) and ((awake(wearer)) and ((ownedItem(tool, wearer)) and ((itemKind(tool, form)) and ((wearable(form)) and (not (wearing(tool, wearer)))))))).
    Cost 1. Time 1.
    Result "The companion equips the item. Another item in the same slot is put away; generated characteristics stay unchanged.".
    Resolve equip(tool, wearer).
    On success {
    }
  }

  Action use_item(actor: group, dose: item, form: itemkind, carrier: member, recipient: member) "Use {dose} on {recipient}" {
    Description "".
    Requires (able(actor)) and ((memberOf(carrier, actor)) and ((memberOf(recipient, actor)) and ((awake(carrier)) and ((awake(recipient)) and ((ownedItem(dose, carrier)) and ((itemKind(dose, form)) and (consumable(form)))))))).
    Cost 1. Time 1.
    Result "The single dose is spent. Its effects resolve on the chosen companion.".
    Resolve consume(dose, carrier, recipient).
    On success {
    }
  }

  Action transfer_item(actor: group, cargo: item, carrier: member, recipient: member) "Give {cargo} to {recipient}" {
    Description "".
    Requires (able(actor)) and ((memberOf(carrier, actor)) and ((memberOf(recipient, actor)) and ((not (ownedItem(cargo, recipient))) and ((awake(recipient)) and (ownedItem(cargo, carrier)))))).
    Cost 1. Time 1.
    Result "The companion takes the item and packs it away. Equipment can also be recovered from fallen companions.".
    Resolve transfer_item(cargo, carrier, recipient).
    On success {
    }
  }

  Action put_item(actor: group, cargo: item, carrier: member, site: place) "Set down {cargo}" {
    Description "".
    Requires (able(actor)) and ((at(actor, site)) and ((memberOf(carrier, actor)) and ((awake(carrier)) and (ownedItem(cargo, carrier))))).
    Cost 1. Time 1.
    Result "You leave the object here. Its position persists until somebody moves it.".
    Resolve drop(cargo, carrier).
    On success {
      Assert at(cargo, site).
    }
  }

  Action train_member(actor: group, mentor: group, student: member, lesson: ability, site: place) "Train {student} in {lesson}" {
    Description "".
    Requires (able(actor)) and ((able(mentor)) and ((distinct(actor, mentor)) and ((at(actor, site)) and ((at(mentor, site)) and ((memberOf(student, actor)) and ((awake(student)) and ((teaches(mentor, lesson)) and (canTrain(student, lesson))))))))).
    Cost 1. Time 6.
    Result "An hour of instruction spends 20 earned experience. The learned technique remains available on future expeditions.".
    Resolve train(lesson, student).
    On success {
    }
  }

  Action fulfill_commission(actor: group, buyer: group, cargo: item, carrier: member, receiver: member, site: place) "Deliver {cargo} to {buyer} for six coins" {
    Description "".
    Requires (able(actor)) and ((able(buyer)) and ((distinct(actor, buyer)) and ((at(actor, site)) and ((at(buyer, site)) and ((commissions(buyer, cargo)) and ((not (commissionPaid(buyer, cargo))) and ((quantity(buyer, gold) >= 6) and ((memberOf(carrier, actor)) and ((ownedItem(cargo, carrier)) and ((memberOf(receiver, buyer)) and (awake(receiver)))))))))))).
    Cost 1. Time 1.
    Result "The buyer takes actual possession of the commissioned object and pays six coins from their finite purse. The company no longer carries it.".
    Resolve transfer_item(cargo, carrier, receiver).
    On success {
      Decrease quantity(buyer, gold) by 6.
      Increase quantity(actor, gold) by 6.
      Assert commissionPaid(buyer, cargo).
    }
  }

  Action forage(actor: group, patch: stock, site: place) "Gather an edible ration from {patch}" {
    Description "".
    Requires (able(actor)) and ((at(actor, site)) and ((at(patch, site)) and ((forageStock(patch)) and ((capable(actor, woodcraft)) and (quantity(patch, rations) >= 1))))).
    Cost 1. Time 2.
    Result "Your woodcraft specialist gathers a shared ration from the identified edible patch. The finite patch is reduced; it does not replenish when you revisit.".
    On success {
      Decrease quantity(patch, rations) by 1.
      Increase quantity(actor, rations) by 1.
    }
  }

  Action risk_passage(actor: group, trap: hazard, origin: place, destination: place, blow: ability, victim: member) "Risk {trap} toward {destination}; {victim} leads" {
    Description "".
    Requires (able(actor)) and ((at(actor, origin)) and ((hazardPassage(trap, origin, destination)) and ((armed(trap)) and ((hazardEffect(trap, blow)) and ((memberOf(victim, actor)) and (awake(victim))))))).
    Cost 1. Time 1.
    Result "The leading companion tests the dangerous crossing. Its mechanism discharges once; the injuries and spent mechanism remain.".
    Resolve expose(blow, victim).
    On success {
      Retract armed(trap).
      Assert triggered(trap).
      Assert at(actor, destination).
    }
    On failure {
      Retract armed(trap).
      Assert triggered(trap).
    }
  }

  Action cleared_passage(actor: group, trap: hazard, origin: place, destination: place) "Cross the spent {trap} toward {destination}" {
    Description "".
    Requires (able(actor)) and ((at(actor, origin)) and ((hazardPassage(trap, origin, destination)) and (not (armed(trap))))).
    Cost 1. Time 1.
    Result "You cross the now-spent mechanism. It will not rearm when you return.".
    On success {
      Assert at(actor, destination).
    }
  }

  Action disarm(actor: group, trap: hazard, origin: place, destination: place, clue: fact) "Disarm {trap}" {
    Description "".
    Requires (able(actor)) and ((at(actor, origin)) and ((hazardPassage(trap, origin, destination)) and ((armed(trap)) and ((warning(trap, clue)) and ((knows(actor, clue)) and (capable(actor, delving))))))).
    Cost 1. Time 2.
    Result "Your delving specialist identifies the warned release and pins it safely. The spent mechanism stays disabled.".
    On success {
      Retract armed(trap).
    }
  }

  Action brace(actor: group, trap: hazard, origin: place, destination: place, clue: fact, kit: item, bearer: member) "Brace {trap} with {kit}" {
    Description "".
    Requires (able(actor)) and ((at(actor, origin)) and ((hazardPassage(trap, origin, destination)) and ((armed(trap)) and ((warning(trap, clue)) and ((knows(actor, clue)) and ((memberOf(bearer, actor)) and ((awake(bearer)) and ((ownedItem(kit, bearer)) and ((wearing(kit, bearer)) and (itemKind(kit, ropekit))))))))))).
    Cost 1. Time 2.
    Result "Following the warning, you pin and brace the moving parts with the climbing kit. This crossing remains safe. The reusable kit stays with its bearer.".
    On success {
      Retract armed(trap).
    }
  }

  Action climb(actor: group, origin: place, destination: place, kit: item, bearer: member) "Climb to {destination} using {kit}" {
    Description "".
    Requires (able(actor)) and ((at(actor, origin)) and ((climbingPassage(origin, destination)) and ((memberOf(bearer, actor)) and ((awake(bearer)) and ((ownedItem(kit, bearer)) and ((wearing(kit, bearer)) and (itemKind(kit, ropekit)))))))).
    Cost 1. Time 2.
    Result "The company anchors its line and climbs together. The kit opens this route without changing the underlying geography.".
    On success {
      Assert at(actor, destination).
    }
  }

  Action free_obstruction(actor: group, companion: group, device: mechanism, site: place) "Shift {device} to free {companion}" {
    Description "".
    Requires (able(actor)) and ((able(companion)) and ((at(actor, site)) and ((at(companion, site)) and ((trapped(companion)) and ((restrainedBy(companion, device)) and ((mounted(device, site)) and (obstruction(device)))))))).
    Cost 1. Time 2.
    Result "You lever the obstruction aside. The trapped person is free, but still needs a safe route home.".
    On success {
      Retract trapped(companion).
      Assert rescued(companion).
    }
  }

  Action escort(actor: group, companion: group, origin: place, destination: place) "Escort {companion} to {destination}" {
    Description "".
    Requires (able(actor)) and ((able(companion)) and ((distinct(actor, companion)) and ((at(actor, origin)) and ((at(companion, origin)) and ((rescued(companion)) and ((not (trapped(companion))) and ((route(origin, destination)) and ((not (closed(destination))) and (not (denied(actor, origin, destination))))))))))).
    Cost 1. Time 1.
    Result "You travel together. Your companion remains at the actual destination; no one teleports home.".
    On success {
      Assert at(actor, destination).
      Assert at(companion, destination).
    }
  }

  Action request_custody(actor: group, keeper: group, statement: fact, site: place) "Present the register and custody writ to {keeper}" {
    Description "".
    Requires (able(actor)) and ((able(keeper)) and ((distinct(actor, keeper)) and ((at(actor, site)) and ((at(keeper, site)) and ((acceptsCustody(keeper)) and ((requiresRecord(keeper, statement)) and ((knows(actor, statement)) and ((custodyWrit(actor)) and (not (custodyGranted(keeper, actor))))))))))).
    Cost 1. Time 1.
    Result "The keeper checks the named record and your custody writ. It allows passage under that authority. It remains alive, and the dead have not become ownerless loot.".
    On success {
      Assert custodyGranted(keeper, actor).
      Assert released(keeper).
    }
  }

  Action open_door(actor: group, door: door, site: place) "Open {door}" {
    Description "".
    Requires (able(actor)) and ((at(actor, site)) and ((doorHere(door, site)) and ((not (lockedDoor(door))) and (not (openedDoor(door)))))).
    Cost 1. Time 1.
    Result "You open the door. The threshold is now passable from either side.".
    On success {
      Assert openedDoor(door).
    }
  }

  Action close_door(actor: group, door: door, site: place) "Close {door}" {
    Description "".
    Requires (able(actor)) and ((at(actor, site)) and ((doorHere(door, site)) and (openedDoor(door)))).
    Cost 1. Time 1.
    Result "You close the door. It remains unlocked.".
    On success {
      Retract openedDoor(door).
    }
  }

  Action unlock_door(actor: group, door: door, key: item, carrier: member, site: place) "Unlock {door} with {key}" {
    Description "".
    Requires (able(actor)) and ((at(actor, site)) and ((doorHere(door, site)) and ((lockedDoor(door)) and ((keyFor(key, door)) and ((ownedItem(key, carrier)) and ((memberOf(carrier, actor)) and (awake(carrier)))))))).
    Cost 1. Time 1.
    Result "The carried key turns in the lock. The door is unlocked but still closed; the key stays with its owner.".
    On success {
      Retract lockedDoor(door).
    }
  }

  Action pick_door(actor: group, door: door, site: place) "Pick the lock on {door}" {
    Description "".
    Requires (able(actor)) and ((at(actor, site)) and ((doorHere(door, site)) and ((lockedDoor(door)) and ((pickableDoor(door)) and (capable(actor, delving)))))).
    Cost 1. Time 3.
    Result "The delver works the simple lock open. This takes half an hour and does not open the door itself.".
    On success {
      Retract lockedDoor(door).
    }
  }

  Action identify_species(actor: group, life: species, site: place) "Read the signs of {life}" {
    Description "A living woodcraft specialist identifies an authored species from signs in its declared habitat. This is identification, not a simulation of an ecosystem.".
    Requires (able(actor)) and ((at(actor, site)) and ((habitatSpecies(site, life)) and ((signsOf(site, life)) and ((capable(actor, woodcraft)) and (not (recognized(actor, life))))))).
    Cost 1. Time 1.
    Result "Your trail-wise companion identifies the species from its signs. Suitable resources here can now be gathered carefully.".
    On success {
      Assert recognized(actor, life).
    }
  }

  Action gather_herb(actor: group, herb: item, life: species, form: itemkind, recipient: member, site: place) "Gather {herb} for {recipient}" {
    Description "Collect a finite, authored herbal preparation. It does not regrow merely because you leave.".
    Requires (able(actor)) and ((at(actor, site)) and ((habitatSpecies(site, life)) and ((recognized(actor, life)) and ((harvestable(herb, life)) and ((at(herb, site)) and ((itemKind(herb, form)) and ((memberOf(recipient, actor)) and ((awake(recipient)) and (capable(actor, woodcraft)))))))))).
    Cost 1. Time 1.
    Result "You gather and dress the usable stems into one poultice. The patch is depleted; its preparation is now a real, single-use carried item.".
    Resolve acquire(herb, form, recipient).
    On success {
      Retract at(herb, site).
    }
  }

  Action field_ward(actor: group, caster: member, technique: ability, recipient: member, site: place) "Have {caster} ward {recipient} with {technique}" {
    Description "Prepare a persistent protective ward before entering danger. Normal mana is paid; duration counts owner-combat-turn boundaries rather than travel time.".
    Requires (able(actor)) and ((at(actor, site)) and ((memberOf(caster, actor)) and ((memberOf(recipient, actor)) and ((persistentWard(technique)) and ((awake(caster)) and ((awake(recipient)) and ((canCast(caster, technique)) and (treatable(recipient, technique))))))))).
    Cost 1. Time 1.
    Result "The companion prepares a protective ward. Its normal mana cost is paid, its source is recorded, and it persists into the next encounter.".
    Resolve invoke(technique, caster, recipient).
    On success {
    }
  }

  Action seek_blessing(actor: group, altar: shrine, patron: deity, recipient: member, site: place) "Keep the observance at {altar} for {recipient}" {
    Description "A companion versed in burial lore leads Veyra's observance. Spend one shared ration as hospitality. This shrine grants its blessing once per company: +2 to saves, for three owner-combat-turn boundaries. Travel does not consume it. It cannot stack with another shrine's identical blessing.".
    Requires (able(actor)) and ((at(actor, site)) and ((at(altar, site)) and ((shrineOf(altar, patron)) and ((capable(actor, burial_lore)) and ((memberOf(recipient, actor)) and ((awake(recipient)) and ((quantity(actor, rations) >= 1) and (not (honored(actor, altar)))))))))).
    Cost 1. Time 1.
    Result "You share food in the Keeper's name. A wayfarer's protection settles on the chosen companion; its source and remaining combat lifetime persist.".
    Resolve bless(altar, patron, recipient).
    On success {
      Decrease quantity(actor, rations) by 1.
      Assert honored(actor, altar).
    }
  }

  Action world__preparation(actor: group, site: place) "Ask about the fallen rack and the cellar key" {
    Description "Speak with someone here about an offered topic.".
    Requires ((able(actor)) and ((able(world__apothecary)) and ((distinct(actor, world__apothecary)) and ((at(actor, site)) and (at(world__apothecary, site)))))) and (true).
    Cost 1. Time 1.
    Result "'Tamsin came to compare her seeds with the old register. A rack fell while she was below. The brass key is on my counter; take it and unlock the cellar. A delver can work the lock too, but do not mistake an unlocked door for an open one. Bring her up with you. The archive below is older than this shop, and something has nested there.'".
    Speaker world__apothecary.
    On success {
    }
  }

  Action world__shelter(actor: group, site: place) "Ask why the travelers' hall is closed" {
    Description "Speak with someone here about an offered topic.".
    Requires ((able(actor)) and ((able(world__host)) and ((distinct(actor, world__host)) and ((at(actor, site)) and (at(world__host, site)))))) and (closed(world__hall)).
    Cost 1. Time 1.
    Result "'We have little food. I admit only our congregation. I swore to follow the founders, not every stranger's wish. Their charter is here. If it says otherwise, show it to me. The wayfarer stone is open to a company who knows Veyra's observance.'".
    Speaker world__host.
    On success {
    }
  }

  Action world__archive_warning(actor: group, site: place) "Ask what the archive holds" {
    Description "Speak with someone here about an offered topic.".
    Requires ((able(actor)) and ((able(world__apothecary)) and ((distinct(actor, world__apothecary)) and ((at(actor, site)) and (at(world__apothecary, site)))))) and (true).
    Cost 1. Time 1.
    Result "'The old families kept seeds and travelers’ names there. A pale hound has made a den among the shelves. It watches visitors from its niche; our last searchers left it alone and came back unharmed. The roots run toward an old drain. Look carefully before you choose a fight.'".
    Speaker world__apothecary.
    On success {
    }
  }

  Action rescue__pinned_request(actor: group, site: place) "Ask the trapped traveler what happened" {
    Description "Speak with someone here about an offered topic.".
    Requires ((able(actor)) and ((able(world__guest)) and ((distinct(actor, world__guest)) and ((at(actor, site)) and (at(world__guest, site)))))) and (trapped(world__guest)).
    Cost 1. Time 1.
    Result "'The load shifted and caught me. The obstruction can be levered aside. After that I need company along an actual safe route home; I cannot follow you if you simply walk away.'".
    Speaker world__guest.
    On success {
    }
  }

  Action rescue__freed_request(actor: group, site: place) "Ask the freed traveler what they need" {
    Description "Speak with someone here about an offered topic.".
    Requires ((able(actor)) and ((able(world__guest)) and ((distinct(actor, world__guest)) and ((at(actor, site)) and (at(world__guest, site)))))) and ((rescued(world__guest)) and (not (at(world__guest, world__street)))).
    Cost 1. Time 1.
    Result "'I can walk now. Escort me along the open ways, one place at a time. I will wait here if you go on without me.'".
    Speaker world__guest.
    On success {
    }
  }

  Action rescue__safe_return(actor: group, site: place) "Speak with the traveler after returning" {
    Description "Speak with someone here about an offered topic.".
    Requires ((able(actor)) and ((able(world__guest)) and ((distinct(actor, world__guest)) and ((at(actor, site)) and (at(world__guest, site)))))) and ((rescued(world__guest)) and (at(world__guest, world__street))).
    Cost 1. Time 1.
    Result "'You came back with me instead of just shifting the debris. I will remember that.' The journey home is a lasting fact, not the end of the campaign.".
    Speaker world__guest.
    On success {
    }
  }

  Action charter__keeper_concern(actor: group, site: place) "Ask why the shelter is closed" {
    Description "Speak with someone here about an offered topic.".
    Requires ((able(actor)) and ((able(world__host)) and ((distinct(actor, world__host)) and ((at(actor, site)) and (at(world__host, site)))))) and (closed(world__hall)).
    Cost 1. Time 1.
    Result "'I keep the founders' obligation, not a private inn. I thought their hospitality was reserved for members of our order. Read the charter here. If I have misunderstood it, tell me what it actually says.'".
    Speaker world__host.
    On success {
    }
  }

  Action charter__keeper_acceptance(actor: group, site: place) "Ask about the shelter's obligation" {
    Description "Speak with someone here about an offered topic.".
    Requires ((able(actor)) and ((able(world__host)) and ((distinct(actor, world__host)) and ((at(actor, site)) and (at(world__host, site)))))) and ((knows(world__host, charter__localfounding_oath)) and (not (closed(world__hall)))).
    Cost 1. Time 1.
    Result "'The founders required hospitality beyond our order. I was wrong to refuse it. The shelter is open; that does not make me the owner of your choices.'".
    Speaker world__host.
    On success {
    }
  }
}
