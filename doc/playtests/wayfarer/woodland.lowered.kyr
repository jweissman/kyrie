  Entity rally: ability "Second wind".
  Entity wounding_blow: ability "Wounding blow".
  Entity dawn_spark: ability "Dawn spark".
  Entity rending_bite: ability "Rending bite".
  Entity camp_recovery: ability "Sheltered recovery".
  Entity cinder_lesson: ability "Cinder lesson".
  Entity cinder: ability "Cinder invocation".
  Entity rime_bite: ability "Rime bite".
  Entity winter_howl: ability "Winter howl".
  Entity human_resolve: ability "Riverland resolve".
  Entity elf_focus: ability "Elder focus".
  Entity dwarf_guard: ability "Stone endurance".
  Entity goblin_feint: ability "Warren feint".
  Entity custodian_sweep: ability "Bronze sweep".
  Entity custodian_chain: ability "Burial chain".
  Entity censer_counterweight: ability "Falling counterweight".
  Entity censer_miasma: ability "Ossuary spore cloud".
  Entity censer_shutters: ability "Burial shutters".
  Entity minor_healing_potion: ability "Minor healing potion".
  Entity antidote_dose: ability "Antidote".
  Entity serewater_training: ability "Measured strike training".
  Entity brace_line: ability "Brace the line".
  Entity orsino_luminous_touch: ability "Luminous Touch".
  Entity orsino_cure_minor: ability "Cure Minor Wounds".
  Entity wayfarer_blessing: ability "Veyra’s wayfarer blessing".
  Entity burning_resin: ability "Burning resin".
  Entity bolt: ability "Ember bolt".
  Entity charter__localfounding_oath: fact "The founders obligated this shelter to receive travelers without requiring membership in their order.".
  Entity charter__charter: source "The founders' charter".
  Rule world__shutter_blocks when armed(world__dust_trap) {
    Assert denied(party, world__cellar, world__storeroom).
  }
  Rule world__shutter_cleared when not (armed(world__dust_trap)) {
    Retract denied(party, world__cellar, world__storeroom).
  }
  Rule world__rain_begins when watch(clock) >= world__closesAt(world__rain) {
    Assert world__rainArrived(world__rain).
    Assert denied(party, world__wood, world__ferry).
  }
  Rule charter__honor_founding_commitment when (knows(world__host, charter__localfounding_oath)) and ((able(world__host)) and ((at(world__host, world__porch)) and (closed(world__hall)))) {
    Retract closed(world__hall).
  }
  Observe world__arrival at world__street when true "Hearthleaf's painted mortar hangs over a shop door. To one side stands Veyra's roadside house; the road leads out through wooded ground toward an outlying settlement.".
  Observe world__shop_scene at world__shop when true "The air smells of cut herbs. A broad counter faces the street door; behind it, an ironbound door opens onto the cellar stair.".
  Observe world__key_on_counter at world__shop when at(world__cabinet_key, world__shop) "A brass key lies on the counter.".
  Observe world__medicine_on_counter at world__shop when at(world__medicine, world__shop) "A bottled healing draught stands among the jars.".
  Observe world__trapped_below at world__shop when (trapped(world__guest)) and (able(world__guest)) "From below, someone strikes the cellar ceiling. The apothecary knows who went down there.".
  Observe world__street_appeal at world__street when (trapped(world__guest)) and (able(world__guest)) "A cry carries from beneath the apothecary. A fallen drying rack has pinned someone below.".
  Observe world__street_refusal at world__street when closed(world__hall) "The roadside house’s hall is barred to strangers. Its keeper waits at the charter porch.".
  Observe world__cellar_scene at world__cellar when trapped(world__guest) "Drying frames have collapsed across a seed carrier's legs. The stair returns to the shop; the dry store leads deeper. The rack can be shifted without attacking anyone. Scored stone warns of a dust shutter at the dry-store threshold. Search before crossing; a delver can disarm it, or a leading companion can risk its discharge.".
  Observe world__cellar_freed at world__cellar when (rescued(world__guest)) and ((at(world__guest, world__cellar)) and (able(world__guest))) "The fallen frames have been levered aside. The seed carrier is on her feet, leaning against a shelf. She waits for someone to accompany her up the stair.".
  Observe world__store_scene at world__storeroom when true "Salt jars stand on dry shelves. Beneath their timber floor, worn stone steps descend into the pilgrims’ archive. A cool draught rises from the older halls.".
  Observe world__vault_scene at world__vault when able(world__sentinel) "Roots have broken the seed-register shelves. A pale cave hound watches from a niche, holding still as the company enters. Root marks cross the masonry toward a low arch.".
  Observe world__relic_present at world__vault when at(world__relic, world__vault) "Something worked in metal lies beside the seed register.".
  Observe world__shutter_ready at world__cellar when armed(world__dust_trap) "Scored stone and a fine trace of preservative powder mark the dry-store threshold. A careful search may reveal how the shutter releases.".
  Observe world__vault_quiet at world__vault when dead(world__sentinel) "The cave hound lies dead beside its niche. Roots still thrust between the register shelves, and damp curls the edges of the oldest pages.".
  Observe world__drain_scene at world__passageway when true "A narrow masonry drain curves toward daylight. Roots make handholds along the last steep stretch. Outside, the path runs past the upper mouth; the company could return by this entrance.".
  Observe world__porch_scene at world__porch when true "A weathered charter hangs beside Veyra’s wayfarer stone. A carved cup marks the stone’s shallow offering bowl: food for a stranger, shelter for a traveler. Beyond it, the inner hall smells of woodsmoke.".
  Observe world__shelter_open at world__hall when true "Travelers’ pallets surround a common hearth. A kettle hangs above the embers, and there is space to unpack, eat and tend the company’s wounds.".
  Observe world__valley_road at world__street when denied(party, world__street, world__ferry) "Floodwater cuts the raised road. The bank-side track remains the way around to the outlying settlement.".
  Observe world__upland_road at world__street when denied(party, world__wood, world__ferry) "A fallen bank cuts the woodland-to-waystation trail. The raised road leaves directly from town; the woodland track is an optional side journey.".
  Observe world__wood_scene at world__wood when true "The track follows a wooded bank. Broken stems and animal prints mark the verge; a trail-wise companion may recognize them. Yarrow grows where the sun reaches the path. A narrow animal trail leads into a clearing, while the onward road bends toward the outlying settlement.".
  Observe world__clearing_scene at world__clearing when able(world__wildlife) "A bristled boar roots in the clearing. It lifts its head at the company’s arrival, then paws the ground. There is room to read its movements and approach carefully—or return along the trail.".
  Observe world__clearing_loss at world__clearing when dead(world__wildlife) "The boar lies dead in the clearing. Its hoofprints still cut the ground beside the trail.".
  Observe world__ferry_scene at world__ferry when true "A roofed waiting house stands beside the road. Its dry benches and sheltered hearth offer a place to stop, share a meal and recover before the return journey.".
  Observe world__rain_cut at world__wood when world__rainArrived(world__rain) "Rain has made the low onward crossing impassable. You can still return to town or use the discovered drain. The raised road offers another way around from town, where it is passable.".
  Observe world__rainy_street at world__street when world__rainArrived(world__rain) "Heavy rain pools around the shop threshold. Water beats against the shutters and runs along the street gutters. Beyond the houses, the low paths are dark with mud.".
  Observe rescue__pinned at world__cellar when (trapped(world__guest)) and (able(world__guest)) "A traveler is pinned beneath a fallen obstruction. You can reach and speak to them. Moving the weight will free them; escorting them to safety will still require a traversable route.".
  Observe rescue__waiting at world__cellar when (rescued(world__guest)) and ((at(world__guest, world__cellar)) and (able(world__guest))) "The obstruction has been shifted. The traveler is free and waiting here. They will not teleport home or follow a company that leaves without escorting them.".
  Observe rescue__homecoming at world__street when (rescued(world__guest)) and ((at(world__guest, world__street)) and (able(world__guest))) "The rescued traveler has reached safety and remains here. The place where they were trapped stays changed.".
  Observe charter__refusal at world__porch when (closed(world__hall)) and (able(world__host)) "The keeper has drawn the shelter bolt. The founding charter is available to read. Reading it does not tell the keeper what you found; explain its obligation if the keeper trusts your report.".
  Observe charter__welcome at world__porch when not (closed(world__hall)) "The shelter is open. The forecourt still leads outside; entering does not close the institution behind you.".
  Observe charter__shelter_room at world__hall when not (closed(world__hall)) "The shelter's interior is accessible. Access and recovery are separate: this package does not create beds, supplies or a recovery service.".
  Initially Assert persistentWard(orsino_fireproof).
  Initially Assert at(world__apothecary, world__shop).
