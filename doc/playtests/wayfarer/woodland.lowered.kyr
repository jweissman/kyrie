  Entity world__herb_patch: item "Yarrow stems".
  Entity world__relic: item "Warden's blade".
  Entity world__medicine: item "Bottled healing draught".
  Entity world__cellar_door: door "The ironbound cellar door".
  Entity world__dust_trap: hazard "The preservative dust shutter".
  Entity world__rack: mechanism "The fallen drying rack".
  Entity world__bolt: mechanism "The keeper's admission bolt".
  Entity world__old_drain: fact "Root marks reveal a drain from the lower vault to the towpath.".
  Entity world__rain: pressure "Approaching heavy rain".
  Entity world__dust_warning: fact "The store threshold releases preservative dust; pin or brace its shutter, or accept its exposure.".
  Entity world__scored_stone: source "The shutter's scored warning stone".
  Entity world__member_guide: member "Elen" bound to world__guide.
  Entity world__member_shield: member "Bran" bound to world__shield.
  Entity world__member_lamp: member "Dori" bound to world__lamp.
  Entity world__member_apothecary_person: member "Orrin" bound to world__apothecary_person.
  Entity world__member_guest_person: member "Tamsin" bound to world__guest_person.
  Entity world__member_host_person: member "Voss" bound to world__host_person.
  Entity world__member_wildlife_person: member "The clearing's boar" bound to world__wildlife_person.
  Entity world__member_sentinel_person: member "The root-vault hound" bound to world__sentinel_person.
  Entity attack: ability "Weapon attack".
  Entity defend: ability "Guard".
  Entity flee: ability "Retreat".
  Entity cleave: ability "Sweeping blow".
  Entity heal: ability "Mend wounds".
  Entity bless: ability "Bless the company".
  Entity purify: ability "Purify".
  Entity revive: ability "Recall the fallen".
