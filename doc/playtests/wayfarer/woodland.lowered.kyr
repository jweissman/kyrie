  Measure world__closesAt(pressure).
  Query paid(who: group) means received(who) >= claim(who).
  Query releaseAllowed(who: group) means (paid(who)) or (((acceptsFood(who)) and (sated(who))) or (watch(clock) >= mercy(who))).
  Entity orsino_fireproof: ability "Fireproof ward".
  Entity world__apothecary: group "Orrin, apothecary".
  Entity world__guest: group "Tamsin, itinerant seed carrier".
  Entity world__host: group "Voss, keeper of the roadside house".
  Entity world__wildlife: group "The clearing's boar, territorial wildlife".
  Entity world__sentinel: group "The root-vault hound, cave scavenger".
  Place world__waking "The Waking World" is plane.
  Place world__vale "Greybough Uplands" is region within world__waking.
  Place world__town "Greybough" is settlement within world__vale.
  Place world__roadstead "Grey Pass waystation" is settlement within world__vale.
  Place world__wilds "Pine-and-yarrow upland" is wilderness within world__vale.
  Place world__street "Apothecary street" is room within world__town.
  Place world__ferry "Ferry landing" is room within world__roadstead.
  Place world__wood "The pine-root track" is room within world__wilds.
  Place world__clearing "A deer's clearing" is room within world__wilds.
  Place world__house "The Hearthleaf apothecary" is building within world__town.
  Place world__shop "Hearthleaf shop" is room within world__house.
  Place world__basement "Hearthleaf · Cellar level" is level within world__house.
  Place world__cellar "The fallen drying racks" is room within world__basement.
  Place world__storeroom "The dry store" is room within world__basement.
  Place world__archive "The pilgrims' archive" is site within world__town.
  Place world__vault_level "Archive · Lower halls" is level within world__archive.
  Place world__vault "The seed register vault" is room within world__vault_level.
  Place world__passageway "The root-cut drain" is room within world__vault_level.
  Place world__refuge "Veyra's roadside house" is building within world__town.
  Place world__porch "The charter porch" is room within world__refuge.
  Place world__hall "The travelers' hall" is room within world__refuge.
  Exit world__into_shop "Enter Hearthleaf" from world__street to world__shop by enter.
  Exit world__out_shop "Step out onto Apothecary street" from world__shop to world__street by leave.
  Exit world__cellar_stair "Descend to the drying cellar" from world__shop to world__cellar by descend through world__cellar_door.
  Exit world__cellar_return "Ascend to Hearthleaf shop" from world__cellar to world__shop by ascend through world__cellar_door.
  Exit world__stores_out "Walk to the dry store" from world__cellar to world__storeroom by walk.
  Exit world__stores_back "Return to the drying racks" from world__storeroom to world__cellar by walk.
  Exit world__archive_stair "Descend to the old archive" from world__storeroom to world__vault by descend.
  Exit world__archive_return "Ascend to the dry store" from world__vault to world__storeroom by ascend.
  Exit world__drain_in "Follow the concealed drain" from world__vault to world__passageway by walk known by world__old_drain.
  Exit world__drain_out "Return to the seed vault" from world__passageway to world__vault by walk.
  Exit world__drain_home "Climb out onto the towpath" from world__passageway to world__wood by ascend.
  Exit world__drain_down "Descend through the root-cut drain" from world__wood to world__passageway by descend known by world__old_drain.
  Exit world__to_refuge "Enter Veyra's porch" from world__street to world__porch by enter.
  Exit world__from_refuge "Leave the roadside house" from world__porch to world__street by leave.
  Exit world__enter_hall "Enter the travelers' hall" from world__porch to world__hall by walk.
  Exit world__leave_hall "Return to the charter porch" from world__hall to world__porch by walk.
  Exit world__ridge_road "Travel the raised road to the outlying settlement" from world__street to world__ferry by travel.
  Exit world__ridge_return "Travel the raised road to the town" from world__ferry to world__street by travel.
  Exit world__to_towpath "Travel out along the river" from world__street to world__wood by travel.
  Exit world__from_towpath "Travel back to the town" from world__wood to world__street by travel.
  Exit world__to_ferry "Travel to the ferry hamlet" from world__wood to world__ferry by travel.
  Exit world__from_ferry "Travel to the alderbank" from world__ferry to world__wood by travel.
  Exit world__to_clearing "Follow the deer trail" from world__wood to world__clearing by walk.
  Exit world__from_clearing "Return to the towpath" from world__clearing to world__wood by walk.
  Entity party: group "Your company".
  Entity gold: good "Coin".
