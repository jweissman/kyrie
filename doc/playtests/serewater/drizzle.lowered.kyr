  Entity march__line_cache: item "Surveyor’s line and pitons".
  Entity march__lantern_cache: item "Lantern of the named dead".
  Entity march__charm_cache: item "Warden's blade".
  Entity march__medicine_1: item "Nera’s first antidote".
  Entity march__medicine_2: item "Nera’s second antidote".
  Entity march__draught_1: item "Nera’s healing draught".
  Entity march__bearing_cache: item "Bronze tram bearing".
  Entity march__register_cache: item "Pell’s waxed register transcription".
  Entity march__vault_purse: stock "Scattered salvage coin".
  Entity march__founders_purse: stock "Scattered salvage coin".
  Entity march__workshop_purse: stock "Scattered salvage coin".
  Entity march__secret_stair: fact "A concealed stair joins the name room and family crypt".
  Entity march__lantern_letters: source "Names written in funeral light".
  Entity march__names_survive: fact "The waxed refuge register survives. Its family numbers identify the remains in the crypt; the flood refuge belonged to three settlements, not the salvage company.".
  Entity march__register_pages: source "Waxed register pages".
  Entity march__hoist_warning: fact "The hoist counterweight releases when the cable takes weight. Delving can pin it; a survey line can brace it. Otherwise the leading companion takes the risk.".
  Entity march__scored_timber: source "Scored counterweight warning".
  Entity march__vapour_warning: fact "The split preservative crock vents poison when its floorboard tilts. Delving can pin the board; a line braces it. An antidote removes poison after exposure.".
  Entity march__crock_label: source "Preservative crock warning".
  Entity march__shutter_warning: fact "The bronze shutter strikes and weakens an unready intruder. The release can be pinned or braced. The court itself is safe to converse in.".
  Entity march__shutter_scratches: source "Old shutter release scratches".
  Entity march__chalk_exit: fact "A chalk fault connects the founders gallery to the exposed drainage entrance. Once learned, this return route remains usable.".
  Entity march__survey_scratches: source "Chalk escape survey".
  Entity march__pell_map: fact "Pell surveyed the dry stair: vestibule, workshop, stores, refuge stair, then the great hall. The hoist is not the only descent.".
  Entity march__survey_board: source "Pell’s scratched survey board".
  Entity march__bearing_claim: fact "The company license covers the tram bearing and foundry machinery. It does not cover registered burials. Edda leaves for Reedwake if her permit expires.".
  Entity march__license_copy: source "Posted salvage license".
  Entity march__custodian_law: fact "The Mortuary Custodian admits a company bearing Iven’s custody writ and knowledge of the surviving register. It can also be bypassed by the line descent from the family crypt.".
  Entity march__custody_notice: source "Burial society notice".
  Entity march__member_guide: member "Elen" bound to march__guide.
  Entity march__member_shield: member "Bran" bound to march__shield.
  Entity march__member_lamp: member "Dori" bound to march__lamp.
  Entity march__member_nera_person: member "Nera" bound to march__nera_person.
  Entity march__member_iven_person: member "Iven" bound to march__iven_person.
  Entity march__member_edda_person: member "Edda" bound to march__edda_person.
  Entity march__member_pell_person: member "Pell" bound to march__pell_person.
  Entity march__member_custodian_person: member "Mortuary Custodian" bound to march__custodian_person.
  Entity march__member_roost_person: member "Ash the cave hound" bound to march__roost_person.
  Entity march__member_marshfang_person: member "Reedbank boar" bound to march__marshfang_person.
  Entity march__member_jory_person: member "Jory" bound to march__jory_person.
  Entity attack: ability "Weapon attack".
  Entity defend: ability "Guard".
  Entity flee: ability "Retreat".
  Entity cleave: ability "Sweeping blow".
  Entity heal: ability "Mend wounds".
  Entity bless: ability "Bless the company".
  Entity purify: ability "Purify".
  Entity revive: ability "Recall the fallen".
  Entity bolt: ability "Ember bolt".
  Entity sleep: ability "Binding sleep".
  Entity ward: ability "Protective ward".
  Entity venom: ability "Venom blade".
  Entity ambush: ability "Backstab".
  Entity summon: ability "Call a wisp".
  Entity rally: ability "Second wind".
  Entity wounding_blow: ability "Wounding blow".
  Entity dawn_spark: ability "Dawn spark".
  Entity rending_bite: ability "Rending bite".
  Entity camp_recovery: ability "Sheltered recovery".
  Entity cinder_lesson: ability "Cinder lesson".
  Entity cinder: ability "Cinder invocation".
  Entity rime_bite: ability "Rime bite".
  Entity winter_howl: ability "Winter howl".
  Entity human_resolve: ability "Riverland resolve".
  Entity elf_focus: ability "Elder focus".
  Entity dwarf_guard: ability "Stone endurance".
  Entity goblin_feint: ability "Warren feint".
  Entity custodian_sweep: ability "Bronze sweep".
  Entity custodian_chain: ability "Burial chain".
  Entity minor_healing_potion: ability "Minor healing potion".
  Entity antidote_dose: ability "Antidote".
  Pursuit permit_withdraw for march__edda priority 20 when (watch(clock) >= march__expiresAt(march__permit)) and (not (march__departed(march__edda))) seeks at(march__edda, march__yard).
  Pursuit permit_return for march__edda priority 20 when march__departed(march__edda) seeks at(march__edda, march__quay).
  Rule march__lit_inscription when (at(party, march__name_room)) and (capable(party, spectralSight)) {
    Assert noticeable(march__lantern_letters).
  }
  Rule march__departure_begins when (at(march__edda, march__yard)) and (watch(clock) >= march__expiresAt(march__permit)) {
    Assert march__departed(march__edda).
  }
  Rule march__rising_water when (watch(clock) >= march__risesAt(march__flood)) and (not (march__highWater(march__flood))) {
    Assert march__highWater(march__flood).
    Assert denied(party, march__drain, march__sluice).
  }
  Rule march__inscription_dark when not (capable(party, spectralSight)) {
    Retract noticeable(march__lantern_letters).
  }
  Observe march__scene_quay at march__quay when true "Barges nose into reed-fringed piles. Wool bales and repaired hulls keep Reedwake working. Censer Hill rises beyond the willow causeway: a derelict foundry above old flood-refuge chambers. West are Nera's supplies and the inn; east, the common shrine and salvage office. Washed-out burial bones trouble the boatmen. No one agrees that everything beneath the hill is salvage.".
  Observe march__scene_inn at march__inn when true "Dry boots hang above the hearth. A shared ration buys six hours on the upstairs pallets, with full recovery for living companions and treatment of bleeding. Poison requires an antidote or purification. The dead remain dead. A chalk board lists the road to Censer Hill and a note: 'Bring a line. Leave enough strength to come back.'".
  Observe march__scene_shrine at march__shrine when true "Two small altars face one another: the Keeper of Names, whose dead must not be lost, and the Returning Current, patron of safe journeys and reciprocal aid. Iven sorts water-stained name slips. His institution, not an anonymous force of magic, claims custody of Censer Hill's named burials.".
  Observe march__scene_outfitter at march__outfitter when true "Oilcloth, line, salves and carefully counted rations fill the shelves. Nera equips repeat customers; she cannot restock a limitless expedition. Physical medicines here are unique bottles. Choose their recipient when buying, then use or equip them from the party inventory. The climbing line in the hill's dry stores may open routes that strength alone cannot.".
  Observe march__scene_salvage at march__salvage when true "The licensed company's ledger is open to a sketch of a bronze tram bearing. Edda has gone to the upper workshop; a permit deadline may bring her back empty-handed. The office is not the burial society. A metal claim does not convey ownership of human remains.".
  Observe march__scene_causeway at march__causeway when true "Willow roots bind the old stone causeway across the reed floodplain. Waterfowl lift from the sedges. The dry ridge climbs to the foundry yard; a low path leads to the exposed drain. A rooted boar bars the drain path, but a woodcraft company can read its warning posture and pass without violence. A bed of edible marsh cress grows beside the willow poles; woodcraft can gather finite rations. The river mark rises later today; the ridge remains dry.".
  Observe march__scene_ridge at march__ridge when true "Short grass and hawthorn cling to pale limestone. Sheep bells sound from distant Chalkcross. A hazel stand offers finite edible nuts to a woodcraft company. The foundry yard lies uphill, Reedwake below. A worn hillside track descends toward the drain: a second way into the hill, not a portal to its end.".
  Observe march__scene_yard at march__yard when true "Rusting tram rails cross an ash-grown yard. The roofless vestibule enters level I; the causeway and ridge return to town. A surveyor's scratches mark a possible climb between this yard and the hoist shaft. Without a proper line the shaft is too exposed. The foundry once served all three river settlements; no faction built it alone.".
  Observe march__scene_drain at march__drain when true "A broken culvert breathes cold air beside the reeds. At low water it reaches level II's sluice walk. A chalk passage also returns here once its route is learned underground. The tide board's red notch means the culvert is under water; this blocks the entrance, not every way out.".
  Observe march__scene_vestibule at march__vestibule when trapped(march__pell) "A broken rack pins Pell's coat and boot beneath a timber. He is alive, angry and reachable. You can shift the rack and escort him back through ordinary routes. The workshop lies beyond. A survey board names the dry stores and an upper hoist; helping Pell need not mean carrying out Edda's salvage contract.".
  Observe march__scene_workshop at march__workshop when true "Half-cast bells lean against the wall. Edda's chalk circles identify reusable bronze, while burial marks below the stair declare another institution's custody. Routes reach the vestibule, casting gallery and dry stores. You can find wealth here without descending to the dead.".
  Observe march__scene_gallery at march__gallery when able(march__roost) "Ceramic moulds make narrow islands beneath a collapsed roof. A cave hound scavenges at the hoist entrance. You can fight, use ranger woodcraft to leave it unprovoked, or return through the stores to the dry refuge stair. Its survival does not reset when you leave.".
  Observe march__scene_furnace at march__furnace when true "A cracked furnace opens beneath the gallery. Slag-glass catches the light; a narrow workers’ loop joins the workshop and gallery. The safe floor here allows you to pause, count supplies and decide between the dry stores and the exposed hoist. The cold hearth holds only weathered slag; the great bell mould has split.".
  Observe march__scene_hoist at march__hoist when true "A slack cable loops around the hoist drum. The uncovered counterweight hangs above a narrow descent to the upper landing. A scored timber records how it releases. Read it before committing a leading companion. A line can brace the mechanism; a delving specialist can disarm it. The climbing scar rises to the yard.".
  Observe march__scene_stores at march__stores when true "A collapsed oilcloth chest stands against the inner wall. The dry stair descends to the refuge without touching the hoist counterweight. Taking the line gives a real tool to a particular companion; it is not a flag that ends the adventure.".
  Observe march__scene_stair at march__stair when true "Soot-black stone steps descend from the stores. Refuge arrows point toward the flood hall; return arrows point up. Even when the drain floods, this stair remains a dependable exit.".
  Observe march__scene_landing at march__landing when true "The hoist cage has sunk into gravel. A narrow crawl joins the flood hall; above is the spent or still-dangerous counterweight crossing. Returning by the dry stair avoids trusting the mechanism twice.".
  Observe march__scene_hall at march__hall when true "Three settlements carved their household tallies on the refuge pillars. The flood hall connects the dry stair, hoist landing, old kitchens and sluice walk. This was a shelter before it became an ossuary. The voices of the dead are not a substitute for the surviving register.".
  Observe march__scene_kitchen at march__kitchen when true "A sealed preservative crock has split beneath the route to the name room. Greenish dust traces the floor. The warning label identifies the vapour and the release; you can prepare an antidote, disarm it with delving, brace its lid with a line, risk exposure, or reach the lower vaults another way.".
  Observe march__scene_name_room at march__name_room when true "Waxed shelves and a funeral lampstand occupy the dry wall. The register identifies the families in the crypt; it is evidence of people, not proof that all valuables are yours. Tiny shining lettering on the rear wall suggests a concealed stair. An equipped names lantern makes that lettering legible.".
  Observe march__scene_sluice at march__sluice when true "Stone gutters run from the exposed drain through the old refuge. A dry wall-walk reaches the lower landing even when the entrance culvert floods. Flood marks record the next rise; the refuge stair remains an alternative way home.".
  Observe march__scene_lower at march__lower when true "A stair of river-smoothed limestone leaves the sluice walk and turns toward the family crypt. The path back is visible. Cold incense lies in the air. Old footmarks turn toward the family crypt.".
  Observe march__scene_crypt at march__crypt when true "Small alcoves hold bundled remains under numbered tiles. The hidden stair from the name room emerges behind a screen here. The Custodian's court stands ahead. A cleft leads to the founders' gallery, but descending it safely requires a line: lawful passage and physical bypass are different advantages.".
  Observe march__scene_court at march__court when true "A bronze dais rises beneath articulated burial shutters. It is funerary bronze and stone, bound to recognize a custody writ supported by the surviving names. It does not read your conscience. Present lawful records, fight it, or turn back. The shutter route offers another dangerous path toward the founders' gallery; its scratched warning is readable before crossing.".
  Observe march__scene_vault at march__vault when true "Named stone drawers remain in order. An offering tray stands before the named drawers. The guardian's permission admits you; it has not sold the dead. The court remains behind you. If you killed the guardian, its heavy footsteps have fallen silent.".
  Observe march__scene_founders at march__founders when true "Three bronze founders hold tools rather than crowns. Their plinths name the flood-refuge compact of Reedwake, Chalkcross and Brackenholt. A chalk passage leads toward the surface. A line can also climb to the family crypt. A small purse and a funerary technique remain; choosing a reward does not end the campaign.".
  Observe march__scene_chalk at march__chalk when true "A pale fault runs upward to the exposed drain. Survey scratches on this side reveal the way through, permanently adding it to your usable geography. Once known, it becomes another route for retreat or a second expedition. Your old footprints remain undisturbed beneath the dust.".
  Observe march__river_risen at march__drain when march__highWater(march__flood) "The red notch is under water. The culvert entrance is closed to you; an occupied sluice walk can still leave. The ridge, dry stair and learned chalk route remain available.".
  Observe march__edda_home at march__salvage when at(march__edda, march__quay) "Edda has withdrawn from the hill. Her permit deadline elapsed whether you were there or not. The bearing remains where this history left it.".
  Observe march__pell_safe at march__quay when (at(march__pell, march__quay)) and (rescued(march__pell)) "Pell is back at the river, alive because someone actually escorted him out. His old place in the vestibule is empty.".
  Observe march__guardian_dead at march__court when dead(march__custodian) "The Custodian lies still. Its burial chain hangs severed from a bronze hand. This is a lasting opening, and a lasting loss of the burial society’s protection.".
  Observe march__custody at march__court when custodyGranted(march__custodian, party) "The Custodian steps aside under the written mandate. Its force and the named burials remain intact.".
  Observe march__unpinned at march__vestibule when (rescued(march__pell)) and (at(march__pell, march__vestibule)) "The lifted rack rests against the wall. Pell is free and waiting. The workshop lies ahead; the yard leads home. Escort moves the company and Pell together along an ordinary route.".
  Observe march__empty_vestibule at march__vestibule when not (at(march__pell, march__vestibule)) "The lifted timber rack has been left against the wall. Pell has departed. His old survey scratches still point toward the workshop and dry stores.".
  Observe march__quiet_gallery at march__gallery when dead(march__roost) "The cave hound lies still beneath the moulds. The passage to the hoist remains clear. Its death has not repaired the exposed counterweight below.".
  Observe march__guardian_present at march__court when able(march__custodian) "The Mortuary Custodian waits on the dais, articulated bronze and stone. Its mandating inscription is visible. Address it, present the specified authority, withdraw or risk a confrontation.".
  Observe march__line_present at march__stores when at(march__line_cache, march__stores) "Inside the oilcloth chest lies a surveyor’s line and pitons. Choose a companion to carry it, then equip it for climbing and bracing.".
  Observe march__bearing_present at march__hoist when at(march__bearing_cache, march__hoist) "A heavy bronze bearing lies beside the drum, stamped with the salvage company’s chalk. Edda’s commission pays six coins for this actual object.".
  Observe march__register_present at march__name_room when at(march__register_cache, march__name_room) "The waxed refuge register lies on a stone reading stand. Its pages identify the families whose remains lie below.".
  Observe march__lantern_present at march__name_room when at(march__lantern_cache, march__name_room) "A warded names lantern stands in the lampstand. It needs no oil in this bounded funerary enchantment; equipping it reveals the concealed funerary inscriptions.".
  Observe march__charm_present at march__vault when at(march__charm_cache, march__vault) "A preserved relic rests in the offering tray. Inspect its actual equipment description before choosing a bearer; its fitted attachment changes that companion’s effective capabilities while equipped.".
  Initially Assert at(march__nera, march__outfitter).
  Initially Assert at(march__iven, march__shrine).
  Initially Assert at(march__edda, march__workshop).
  Initially Assert at(march__pell, march__vestibule).
  Initially Assert at(march__custodian, march__court).
  Initially Assert at(march__roost, march__gallery).
  Initially Assert at(march__marshfang, march__causeway).
  Initially Assert at(march__jory, march__inn).
  Initially Assert townDistrict(march__reedwake).
  Initially Assert district(march__quay, march__reedwake).
  Initially Assert district(march__inn, march__reedwake).
  Initially Assert district(march__shrine, march__reedwake).
  Initially Assert district(march__outfitter, march__reedwake).
  Initially Assert district(march__salvage, march__reedwake).
  Initially Assert wildernessDistrict(march__reedlands).
  Initially Assert district(march__causeway, march__reedlands).
  Initially Assert district(march__ridge, march__reedlands).
  Initially Assert district(march__yard, march__reedlands).
  Initially Assert district(march__drain, march__reedlands).
  Initially Assert undergroundDistrict(march__upperworks).
  Initially Assert district(march__vestibule, march__upperworks).
