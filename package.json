{
  "name": "kyrie",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "latest",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.169.0",
    "eslint-plugin-no-comments": "1.2.1",
    "jiti": "2.7.0",
    "playwright-core": "1.48.2",
    "typescript-eslint": "8.71.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "deem": "git+https://github.com:443/jweissman/deem.git#967deac5b8411a921b85ba9ef630d503081ce21e",
    "eslint": "^10.13.0",
    "languages": "git+https://github.com:443/jweissman/languages.git#b6e78c30e7024072c5f378e730d7f7b3121e30f2",
    "ohm-js": "^17.5.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.169.0"
  },
  "scripts": {
    "arena": "bun run scripts/arena.ts",
    "test": "bun test --parallel --timings=test/timings.json",
    "test:quick": "bun scripts/test-quick.ts",
    "test:contracts": "bun test --parallel test/choice-contract.test.ts test/creature-pipeline.test.ts test/creature-variation.test.ts test/devices.test.ts test/natural-history.test.ts test/geology.test.ts test/authorability.test.ts test/deem-cli.test.ts test/module-shadow.test.ts",
    "test:intent": "bun test test/objective-target.test.ts test/hex-ways.test.ts test/choice-contract.test.ts test/stakes.test.ts test/danger-talk.test.ts test/aim-inside-site.test.ts",
    "test:honest": "bun test test/honest-start.test.ts",
    "test:timings": "bun test --parallel --timings=test/timings.json --update-timings",
    "test:changed": "bun scripts/test-changed.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "typecheck:fast": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/root.tsbuildinfo && tsc --noEmit -p web --incremental --tsBuildInfoFile node_modules/.cache/tsc/web.tsbuildinfo",
    "play": "bin/kyrie campaign data/campaigns/the-long-man.campaign.json",
    "preview": "bin/kyrie preview",
    "kyrie": "bin/kyrie",
    "lint": "eslint . --max-warnings=0",
    "lint:fast": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix",
    "check": "bun run lint && bun run typecheck && bun run test",
    "check:fast": "bun run typecheck:fast && bun run lint:fast && bun run test:quick",
    "build": "bun build --compile ./src/cli/kyrie.ts --outfile dist/kyrie",
    "web:build": "bun run scripts/build-web.ts",
    "web:dev": "bun run scripts/build-web.ts --serve"
  },
  "bin": {
    "kyrie": "./bin/kyrie"
  }
}
