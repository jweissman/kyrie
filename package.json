{
  "name": "kyrie",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "latest",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint-plugin-no-comments": "1.2.1",
    "jiti": "2.7.0",
    "playwright-core": "1.48.2",
    "typescript-eslint": "8.71.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "deem": "git+https://github.com:443/jweissman/deem.git#967deac5b8411a921b85ba9ef630d503081ce21e",
    "eslint": "^10.13.0",
    "languages": "git+https://github.com:443/jweissman/languages.git#30d36c624e6a604b5ed9296dad5127b23aeb2285",
    "ohm-js": "^17.5.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "scripts": {
    "arena": "bun run scripts/arena.ts",
    "test": "bun test --parallel --timings=test/timings.json",
    "test:quick": "bun scripts/test-quick.ts",
    "test:timings": "bun test --parallel --timings=test/timings.json --update-timings",
    "test:fast": "bun test --parallel --path-ignore-patterns='test/deem-choice-space.test.ts'",
    "test:changed": "bun test --parallel --changed",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "play": "bin/kyrie campaign data/campaigns/the-long-man.campaign.json",
    "preview": "bin/kyrie preview",
    "kyrie": "bin/kyrie",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "check": "bun run lint && bun run typecheck && bun run test",
    "build": "bun build --compile ./src/cli/kyrie.ts --outfile dist/kyrie",
    "web:build": "bun run scripts/build-web.ts",
    "web:dev": "bun run scripts/build-web.ts --serve"
  },
  "bin": {
    "kyrie": "./bin/kyrie"
  }
}
