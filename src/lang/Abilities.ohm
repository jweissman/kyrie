KyrAbilities <: Kyr {
  Program = Statement+
  Statement = AbilityAction Save? Outcome* "."
  AbilityAction = Conditional | Damage | Healing | Defend | Apply | Remove | DrainLevel | Drain | Revive | Kill | Flee | Gain | Learn | Summon | Travel | Cast | Try
  Conditional = "If" expression "," AbilityAction
  Save = "unless" ident "save" "against" Amount
  Outcome = ";" "a" ident "save" "against" Amount Verdict "it"  -- saved
          | ";" "resisting" Verdict "it"                         -- resisted
          | ";" "only" "on" ident ("or" ident)*                  -- only
  Verdict = "halves" | "negates"
  Damage = "Deal" Amount DamageType "damage" "to" Target
  Healing = "Heal" Amount "health" "to" Target
  Defend = "Defend"
  Apply = "Apply" ident "to" Target "for" integer Span
  Remove = "Remove" ident "from" Target
  Drain = "Drain" Amount "health" "from" Target
  DrainLevel = "Drain" Amount Levels "from" Target
  Levels = "levels" | "level"
  Revive = "Revive" Target "with" Amount "health"
  Kill = "Kill" Target
  Flee = "Flee"
  Gain = "Grant" Amount Resource "to" Target
  Learn = "Teach" ident "to" Target
  Summon = "Summon" ident "for" Target
  Travel = "Travel" "to" ident
  Cast = "Cast" ident "on" Target
  Try = "Try" ident "on" Target  -- on
      | "Try" ident "here"       -- here
  Span = Turns | Hours
  Turns = "turns" | "turn"
  Hours = "hours" | "hour"
  Amount = expression | integer
  DamageType = ident
  Target = "dead ally" | "random enemy" | "enemies" | "allies" | "party" | "enemy" | "ally" | "self" | "all" | "it" | "here"
  Resource = ident
}
