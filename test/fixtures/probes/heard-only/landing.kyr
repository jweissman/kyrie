Module heardonly "A verdict given at the landing, and news within the town, whoever is there" {
  Place vale "the vale" is region.
  Place town "Haybridge" is settlement within vale at 0, 0.
  Place landing "the landing" is room within town at 0, 0 outdoors.
  Place fields "the fields" is wilderness within vale at 1, 0.
  Place road "the road" is room within fields at 0, 0 outdoors.
  Passage into_town "the road into Haybridge" is road between road and landing taking 1 hour.
  Company party "You" of 1 at road.
  Relation condemned(group). Relation risen(group).
  // Done to the company wherever it is, and heard only on the landing: the lint leaves it alone.
  Rule verdict heard at landing when watch(clock) >= 2 and not condemned(party) says "'Condemned,' says the surveyor." { Assert condemned(party). }
  // Done whether or not the company is in the town, and told only to one in it.
  Rule sexton heard within town when watch(clock) >= 2 and not risen(party) says "The sexton has gone back up the tower." { Assert risen(party). }
  Goal false.
}
