Module lanthorn "The Lanthorn" {
  Description "A citadel of the Lamplighters across the head of the Gap: a gatehouse over the road, a court and a beacon tower on the crag above it, and below, cut into the rock, the cellars where they kept bottled light. Ottilie Ninefingers holds the gate and the court and tolls the road. Nobody holds the cellars.".
  Entity party: group "Your company".
  Place varrow "The region" is region.
  Place toll_gate "The road below the gate" is room.
  Place gap_far "The road beyond the gate" is room.
  Place shoulder "The fell above" is room.
  Place home_town "The town beyond" is room.
  Place supplier "Where the crew buy on credit" is room.
  Entity provider: group "Who sells the crew meal on credit".
  Place cairn_field "Where the goat path comes down behind the Toll" is room.
  Entity skerry_road: passage "The road down from there to the town".
  Entity claimant: group "Who would take the Lanthorn if it stood empty".
  Place lamps "The temple of lamps" is room.
  Entity reeve: group "The reeve who wants the Toll ended".
  Entity bounty: fact "The reeve's bounty on the Toll".

  Place lanthorn "the Lanthorn" is site within varrow at 3, 0.
  Place gatehouse "The gatehouse" is level within lanthorn.
  Place citadel "The court" is level within lanthorn.
  Place tower "The beacon tower" is level within lanthorn.
  Place roof "The top of the tower" is level within lanthorn.
  Place wick "The Wick" is level within lanthorn.
  Place undercroft "The undercroft" is level within lanthorn.

  Place guardroom "the guardroom" is room within gatehouse at 0, 0.
  Place winch_room "the winch room" is room within citadel at 0, 2.
  Place gate_passage "the gate passage" is room within gatehouse at 0, 1.
  Place wall_walk "the wall walk" is room within citadel at 1, 2.
  Place gorge "the gorge under the walls" is room within gatehouse at 0, 2.
  Place kitchen "the kitchen" is room within citadel at 0, 0.
  Place court "the Lamp Court" is room within citadel at 1, 0.
  Place chapter_house "the chapter house" is room within citadel at 2, 0.
  Place tower_foot "the foot of the beacon tower" is room within citadel at 1, 1.
  Place solar "the warden's solar" is room within tower at 0, 0.
  Place lantern "the lantern" is room within roof at 0, 0.
  Place stair_foot "the Wick crossing" is room within wick at 1, 0.
  Place cistern "the cistern" is room within wick at 0, 0.
  Place lamp_works "the lamp-works" is room within wick at 2, 0.
  Place glasshouse "the glass-house" is room within wick at 3, 0.
  Place bottle_cellar "the bottle cellar" is room within wick at 2, 1.
  Place deep_cellar "the deep cellar" is room within undercroft at 0, 0.
  Place first_vault "the vault of the First Light" is room within undercroft at 1, 0.
  Place crack_foot "the bottom of the crack" is room within undercroft at 0, 1.
  Initially Assert unlit(stair_foot). Initially Assert unlit(cistern). Initially Assert unlit(lamp_works).
  Initially Assert unlit(glasshouse). Initially Assert unlit(bottle_cellar). Initially Assert unlit(deep_cellar).
  Initially Assert unlit(first_vault). Initially Assert unlit(crack_foot). Initially Assert unlit(gorge).
  Initially Assert indoors(guardroom). Initially Assert indoors(winch_room). Initially Assert indoors(kitchen).
  Initially Assert indoors(chapter_house). Initially Assert indoors(solar).

  // The road goes through the gatehouse; the citadel is on the crag above it, the cellars in the rock below.
  Passage outer_gate "the outer gate" is gate between toll_gate and gate_passage.
  Passage far_gate "the far portcullis" is gate between gate_passage and gap_far.
  Passage guard_door "the guardroom door" is door between gate_passage and guardroom.
  Passage guard_stair "the guardroom stair" is stair between guardroom and winch_room.
  Passage winch_door "the winch-room door" is door between winch_room and wall_walk.
  Passage court_steps "the court steps" is steps between wall_walk and court.
  Passage kitchen_door "the kitchen door" is door between court and kitchen.
  Passage chapter_doors "the chapter-house doors" is doorway between court and chapter_house.
  Passage tower_door "the tower door" is door between court and tower_foot.
  Passage tower_stair "the tower stair" is stair between tower_foot and solar.
  Passage lantern_stair "the lantern stair" is stair between solar and lantern.
  // Other ways in: the kitchen postern, barred inside; a chain from the fell to the top of the tower; the cistern's
  // overflow from the gorge; and, from the cellars, a stair, a well, a flue and a crack that goes further down.
  Passage postern "the kitchen postern" is door between kitchen and gap_far.
  Passage gorge_path "the scramble down into the gorge" is climb between gap_far and gorge taking 30 minutes needing climbing or rope.
  Passage beacon_chain "the beacon chain" is climb between shoulder and lantern taking 1 hour hidden until chain_known needing climbing or rope.
  Passage well "the court well" is shaft between court and cistern needing rope or climbing.
  Passage wick_stair "the Lamplighters' stair" is stair between chapter_house and stair_foot hidden until wick_stair_known.
  Passage works_arch "the lamp-works arch" is arch between stair_foot and lamp_works.
  Passage cistern_walk "the cistern walk" is passage between stair_foot and cistern.
  Passage glass_door "the glass-house door" is doorway between lamp_works and glasshouse.
  Passage cellar_steps "the cellar steps" is steps between lamp_works and bottle_cellar.
  Passage flue "the furnace flue" is crawl between glasshouse and court hidden until flue_known needing climbing or rope.
  Passage overflow "the cistern overflow" is culvert between cistern and gorge.
  Passage deep_stair "the deep stair" is stair between bottle_cellar and deep_cellar.
  Passage sun_door "the sun-door" is door between deep_cellar and first_vault.
  Passage crack "the crack in the deep cellar's floor" is crawl between deep_cellar and crack_foot taking 1 hour.

  // The gate passage, the guardroom and the winch room.
  Observe passage_scene at gate_passage when true "A vaulted tunnel through the gatehouse, wide enough for a cart. The vault is pierced with square holes, and the far end is closed by an iron portcullis.".
  Observe guardroom_scene at guardroom when true "Bunks, a brazier, a table scarred with knife-games, and a crossbow rack with two gaps in it.".
  Observe winch_scene at winch_room when true "A low room over the gate passage. A great windlass with a capstan bar, and in the floor a row of square holes looking down into the tunnel. A heap of round stones lies beside each.".
  Observe walk_scene at wall_walk when true "The wall walk runs along the top of the curtain wall from the gatehouse to the court, with the Gap a long way down on one side.".
  Observe gorge_scene at gorge when true "The gorge under the walls, wet and loud. Out of a culvert in the cliff above, water comes down in a thin fall.".
  Observe road_far_scene at gap_far when true "On the Skerry side the gatehouse is a blank wall with a portcullis in it. Along the cliff, under the kitchen windows, there is a small iron-bound postern, and below the road the cliff drops into a gorge.".
  Observe chain_seen at shoulder when not knows(party, chain_known) "From the shoulder you can see the top of the Lanthorn's tower across the gulf, close enough to throw a stone at, and an old chain slung between it and a ring in the rock beside you." teaches chain_known.
  Entity chain_known: fact "An old chain runs from a ring in the rock on the shoulder of Hushing Fell to the top of the Lanthorn's tower. A climber could go across it.".
  Initially Assert established(chain_known).

  Person wardens "the gate wardens" at gate_passage {
    Role "two of Ninefingers' crew, keeping the gate". Ancestry human. Calling thief. Level 1. Numbers 2.
    Called "Dace", "Lumpkin".
    Guards outer_gate. Guards far_gate.
    State watching blocking "Two of Ninefingers' men lean on the inside of the gate with crossbows, waiting for someone to tax.".
  }
  // Two crowns a head: paid at either end of the passage, the wardens open the gate and wind up the portcullis.
  Initially Assert tolls(wardens, toll_gate). Initially Assert tolls(wardens, gap_far).
  Action pay_toll(actor: group, site: place) "Pay the wardens the Toll, six coin" {
    Description "Two crowns a head. The wardens open the gate and let the company through the passage, and no further.".
    Requires able(actor) and company(actor) and at(actor, site) and tolls(wardens, site) and able(wardens)
      and state(wardens, watching) and not tolerates(wardens, actor) and quantity(actor, gold) >= 6.
    On success { Decrease quantity(actor, gold) by 6. Increase quantity(wardens, gold) by 6. Assert tolerates(wardens, actor). }
    Result "Coins go through the grille. A bar scrapes, and the gate swings open.".
  }
  // The toll buys one passage: through the gate and out at either end.
  Relation passing(group).
  Rule toll_used when tolerates(wardens, party) and at(party, gate_passage) and not admits(ninefingers, party) and not guest(party) {
    Assert passing(party).
  }
  Rule toll_spent when passing(party) and not at(party, gate_passage) { Retract passing(party). Retract tolerates(wardens, party). }
  // A visitor who asks for Ninefingers is taken up to her, and must touch nothing on the way.
  Relation guest(group).
  Action ask_audience(actor: group, site: place) "Ask the wardens for a word with Ninefingers" {
    Description "They will fetch her answer. If she will see you, they will take you up through the gatehouse and across the court to her tower. Not at night: she sleeps.".
    Requires able(actor) and company(actor) and at(actor, site) and tolls(wardens, site) and able(wardens)
      and state(wardens, watching) and not alarmed(ninefingers) and not guest(actor) and not admits(ninefingers, actor) and not hostile(ninefingers, actor)
      and not dark().
    Time 3.
    On success { Assert guest(actor). Assert tolerates(wardens, actor). Assert tolerates(coll, actor). Assert tolerates(crew, actor).
      Assert state(guard_lock, open). }
    Result "Dace looks you over through the grille, spits, and goes off up the stair. He is gone a long time. 'She'll see you,' he says, and unbars the gate. 'Up through the guardroom and across the court. Touch nothing. Speak when you're spoke to.'".
  }
  Rule guest_strays when guest(party) and (at(party, kitchen) or at(party, chapter_house) or at(party, lantern))
    says "'Here! Where d'you think you're going?'" {
    Retract guest(party). Retract tolerates(crew, party). Retract tolerates(wardens, party). Retract tolerates(coll, party).
    Assert alarmed(ninefingers).
  }
  Relation admitted(group).
  Rule guest_admitted when guest(party) and at(party, gate_passage) { Assert admitted(party). }
  Rule guest_leaves when guest(party) and admitted(party) and (at(party, toll_gate) or at(party, gap_far)) {
    Retract guest(party). Retract admitted(party). Retract tolerates(crew, party). Retract tolerates(wardens, party).
    Retract tolerates(coll, party).
  }
  Rule guest_betrays when guest(party) and alarmed(ninefingers) {
    Retract guest(party). Retract tolerates(crew, party). Retract tolerates(wardens, party). Retract tolerates(coll, party).
  }
  // Rob her and she remembers: her people shoot on sight.
  Rule marked when alarmed(ninefingers) and not hostile(ninefingers, party) and not admits(ninefingers, party)
    and not lifted(toll) { Assert hostile(ninefingers, party). }
  Hazard bolts "Crossbow bolts through the grille" means "Deal (1d8) physical damage to ally unless dexterity save against (13).".
  Relation shotAt(group).
  Rule shot_at when hostile(ninefingers, party) and at(party, ?post) and tolls(?collector, ?post)
    and serves(?collector, ninefingers) and able(?collector) and not shotAt(party) says "A crossbow bolt cracks off the stones by your feet. 'That's them!'" {
    Assert strikes(bolts, party). Assert shotAt(party).
  }
  Rule shot_reset when shotAt(party) and not at(party, toll_gate) and not at(party, gap_far) and not at(party, cairn_field) {
    Retract shotAt(party).
  }
  Thing gate_bar "the outer gate" on outer_gate is scenery {
    State barred blocking "The outer gate is shut and barred on the inside; there is a grille in it at head height.".
    State open "The outer gate stands open.".
  }
  Rule gate_opens when tolerates(wardens, party) and state(gate_bar, barred) { Assert state(gate_bar, open). }
  Rule gate_shuts when not tolerates(wardens, party) and state(gate_bar, open) and able(wardens) and tolls(wardens, toll_gate)
    and not at(party, gate_passage) { Assert state(gate_bar, barred). }
  Thing portcullis "the far portcullis" on far_gate {
    State down blocking "The far end of the gate passage is shut by an iron portcullis, down to the stones.".
    State up "The far portcullis is wound up into its slot.".
  }
  Thing windlass "the windlass" at winch_room {
    State slack "The windlass's rope is slack, and the portcullis it works is down.".
    State wound "The windlass is wound tight and pawled.".
    Change wind "Wind up the far portcullis" from slack to wound needing brawn.
    Change let_go "Knock out the pawl and let the portcullis fall" from wound to slack.
  }
  Rule portcullis_rises when state(windlass, wound) and state(portcullis, down) { Assert state(portcullis, up). }
  Rule toll_passage when tolerates(wardens, party) and state(portcullis, down) and able(wardens) { Assert state(portcullis, up). }
  Rule portcullis_falls when not tolerates(wardens, party) and state(windlass, slack) and state(portcullis, up)
    and able(wardens) and tolls(wardens, gap_far) { Assert state(portcullis, down). }
  Thing guard_lock "the guardroom door's lock" on guard_door {
    State locked blocking "The guardroom door is locked.".
    State open "The guardroom door stands unlocked.".
    Change pick "Pick the guardroom door's lock" from locked to open needing lockwork.
    Change force "Put a shoulder to the guardroom door" from locked to open needing brawn.
  }
  Rule wardens_object when state(guard_lock, open) and together(wardens, party) and able(wardens)
    and not admits(ninefingers, party) and not guest(party) and not alarmed(ninefingers)
    says "'That's not the road!' The wardens drop their crossbows and come at you with their knives." {
    Assert alarmed(ninefingers). Assert assails(wardens, party).
  }
  Thing toll_box "the toll-box" at guardroom {
    Holds.
    State chained closed "An iron toll-box is chained to the table leg.".
    State open "The toll-box stands open on the table.".
    Change pick "Pick the toll-box's lock" from chained to open needing lockwork.
    Change smash "Smash the toll-box open" from chained to open needing brawn.
  }
  Item day_toll "the day's takings" is toll_silver in toll_box.
  Item guard_rope "a coil of rope" is rope at guardroom.

  // Murder holes: once the gatehouse is roused, stones come down on whoever is in the passage.
  Hazard dropped_stones "Stones from the murder holes" means "Deal (2d4) physical damage to ally unless dexterity save against (12).".
  Rule gate_roused when (not able(wardens) or routed(wardens)) and not alarmed(ninefingers) and not lifted(toll)
    says "Somewhere above, a bell starts to clang." { Assert alarmed(ninefingers). }
  Rule stones_fall when alarmed(ninefingers) and at(party, gate_passage) and able(crew) and not admits(ninefingers, party)
    and dice(clock) <= 40 says "Stones come down through the holes in the vault." { Assert strikes(dropped_stones, party). }

  // The court.
  Observe court_scene at court when true "The Lamp Court: flagstones, a well with a winch-post, goats, and in the middle a dry fountain shaped like a great lamp. The beacon tower stands at one corner, black, its top open to the sky.".
  Observe crew_heard at court when at(crew, chapter_house) and state(crew, carousing) and able(crew) "From the chapter house: dice, laughter, a lot of voices, and someone singing about a ninth finger.".
  Observe crew_snoring at court when at(crew, chapter_house) and state(crew, sleeping) and able(crew) "From the chapter house, snoring, a lot of it.".
  Observe fountain_warm at court when dark() and not knows(party, flue_known) "At night the stone lamp in the dry fountain is warm to the touch, and a draught comes up out of its mouth that smells of hot glass." teaches flue_known.
  Observe kitchen_scene at kitchen when true "A smoky kitchen with a hearth you could stand in, a trough, and a door in the far wall barred with an oak beam.".
  Observe chapter_scene at chapter_house when true "The Lamplighters' chapter house: a long hall, and over it, on a chain, an iron wheel of lamps like the one in the temple at Hollin, all dark. A great iron counterweight hangs from the chain at the back of the hall.".
  Observe tower_foot_scene at tower_foot when true "The bottom of the beacon tower, a round room with a stair going up the wall.".

  Thing postern_bar "the beam across the postern" at kitchen {
    State barred "An oak beam lies across the postern door in iron brackets.".
    State lifted "The postern's beam leans against the wall.".
    Change lift "Lift the beam off the postern" from barred to lifted needing brawn.
    Change drop "Drop the beam across the postern" from lifted to barred.
  }
  Thing postern_door "the postern door" on postern {
    State shut blocking "The postern is shut, and from the outside there is nothing to take hold of.".
    State unbarred "The postern stands unbarred.".
  }
  Rule postern_opens when state(postern_bar, lifted) and state(postern_door, shut) { Assert state(postern_door, unbarred). }
  Rule postern_closes when state(postern_bar, barred) and state(postern_door, unbarred) { Assert state(postern_door, shut). }

  // A captive in the kitchen, who knows the Lanthorn's ways and wants to go home to Skerry.
  Person tamsin "Tamsin" at kitchen {
    Role "a Skerry girl kept to cook for the crew". Ancestry human. Calling commoner. Level 1. Peaceable.
    State chained "A thin girl in a sacking apron scours pots at the trough, with a chain from her ankle to the hearth-iron.".
    State freed "Tamsin sits by the hearth with her ankle free, rubbing it.".
    Change unchain "Strike off Tamsin's chain" from chained to freed needing brawn or lockwork.
    Uses go. Plans 12 steps.
  }
  Pursuit stay_close for tamsin "keeping close to you" priority 30 when following(tamsin, party) seeks together(tamsin, party).
  Topic tamsin_below with tamsin "Ask Tamsin about the cellars" when true once {
    Says "'They won't go below,' Tamsin whispers. 'Not since Wat went down the stair behind the counterweight, in the chapter house, and came back up white as milk with his torch out and wouldn't say what he saw. There's something that walks about down there and clicks.'".
    On discuss { Assert knows(actor, wick_stair_known). }
  }
  Topic tamsin_postern with tamsin "Ask Tamsin about the barred door" when true once {
    Says "'That's the postern,' says Tamsin. 'It goes out onto the road on the Skerry side. I take the slops out that way at dawn, and Coll stands in the door and watches me so I don't run.'".
  }
  Rule tamsin_follows when state(tamsin, freed) and not acceptsEscort(tamsin, party)
    says "Tamsin looks at the door, and at you. 'Take me home,' she says. 'Skerry. Please.'" { Assert acceptsEscort(tamsin, party). }
  // Skerry takes her back, and gives the company what it can (the homecoming is people's, in world_people).
  Initially Assert home(tamsin, home_town). Initially Set thanks(tamsin) to 10.
  Rule tamsin_home when cameHome(tamsin) and not lifted(captivity)
    says "Tamsin runs the last stretch. Somebody in Skerry screams her name, and then everybody is shouting." {
    Assert lifted(captivity).
  }
  Entity captivity: fact "Tamsin's captivity in the Lanthorn's kitchen.".
  Initially Assert serves(wardens, ninefingers). Initially Assert serves(crew, ninefingers). Initially Assert serves(coll, ninefingers).
  Initially Assert serves(carters, ninefingers). Initially Assert keyholder(ninefingers, gate_bar).
  Initially Assert keyholder(ninefingers, portcullis). Initially Assert keyholder(ninefingers, postern_door).
  Initially Assert keyholder(ninefingers, guard_lock).
  Initially Assert holds(ninefingers, gate_passage). Initially Assert holds(ninefingers, guardroom).
  Initially Assert holds(ninefingers, winch_room). Initially Assert holds(ninefingers, wall_walk).
  Initially Assert holds(ninefingers, court). Initially Assert holds(ninefingers, kitchen).
  Initially Assert holds(ninefingers, chapter_house). Initially Assert holds(ninefingers, tower_foot).
  Initially Assert holds(ninefingers, solar). Initially Assert holds(ninefingers, lantern).

  Person crew "Ninefingers' crew" at chapter_house {
    Role "the cut-throats who hold the Lanthorn". Ancestry human. Calling warrior. Level 1. Numbers 4.
    Called "Black Wat", "Sallow Jen", "the Prior", "Tobe".
    State carousing "Ninefingers' crew sprawl at the long tables drinking Hollin ale on Crake's Ford credit, dicing for who keeps the gate tomorrow.".
    State sleeping "Ninefingers' crew snore on the benches and under the tables, among the jugs.".
    State hunting "Ninefingers' crew, awake and armed, are looking for whoever rang the bell.".
    Uses go, assail. Plans 6 steps.
  }
  Rule crew_sleep when dark() and state(crew, carousing) and not alarmed(ninefingers) { Assert state(crew, sleeping). }
  Rule crew_wake when not dark() and state(crew, sleeping) { Assert state(crew, carousing). }
  Rule crew_roused when alarmed(ninefingers) and (state(crew, sleeping) or state(crew, carousing)) { Assert state(crew, hunting). }
  Rule crew_stir when state(crew, sleeping) and together(crew, party) and not tolerates(crew, party)
    and ((capable(party, stealth) and dice(clock) <= 5) or (not capable(party, stealth) and dice(clock) <= 25))
    says "Someone on the benches sits up, blinks at you, and shouts." { Assert state(crew, carousing). Assert alarmed(ninefingers). }
  Rule crew_challenge when (state(crew, carousing) or state(crew, hunting)) and together(crew, party) and not tolerates(crew, party) and able(crew)
    and at(party, ?p) and holds(ninefingers, ?p)
    says "The crew come up off the benches with their knives out." { Assert alarmed(ninefingers). Assert assails(crew, party). }
  Pursuit hunt for crew "hunting intruders through the Lanthorn" priority 30 when alarmed(ninefingers) and not tolerates(crew, party)
    and at(party, ?p) and holds(ninefingers, ?p) seeks assails(crew, party).

  // The lamp-wheel's counterweight swings aside from the head of a stair.
  Discovery wick_stair_known "Behind the iron counterweight at the back of the chapter house, a stair goes down into the rock." {
    Found by searching chapter_house "The counterweight is hung to swing. Behind it, a stair goes down into the rock, and cold air comes up it.".
  }
  Discovery flue_known "The furnace flue from the Lamplighters' glass-house comes up through the dry fountain in the Lamp Court." {
    Found by searching glasshouse "The furnace's flue is wide enough for a child, or a thin adult with a rope, and daylight shows at the top of it.".
  }

  // The crew eat a sack of meal a night. When the store runs low the carters go down to Crake's Ford for more, on
  // credit; if nothing comes back up, Ninefingers sends the whole crew down to take it from Skerry instead.
  Initially Set quantity(ninefingers, rations) to 4.
  Relation laden(group).
  Initially Assert credit(ninefingers, provider).
  Person carters "Ninefingers' carters" at court {
    Role "two of the crew, who fetch meal and ale up the Gap road with a goat-cart". Ancestry human. Calling warrior. Level 1. Numbers 2.
    Called "Abel Sink", "Dunny".
    Uses go, load_up. Plans 16 steps.
    State carting "Two of the crew lead a goat-cart, swearing at the goats.".
  }
  Action load_up(actor: group, seller: group, site: place) "Load meal and ale on credit" {
    Requires able(actor) and serves(actor, ninefingers) and credit(ninefingers, seller) and at(actor, site)
      and at(seller, site) and quantity(seller, rations) >= 4 and not laden(actor).
    Time 6.
    On success { Assert laden(actor). Decrease quantity(seller, rations) by 4. Increase owes(ninefingers, seller) by 8. }
    Seen "{actor} load a goat-cart with meal and ale on credit, and somebody writes it down.".
  }
  Pursuit fetch for carters "fetching meal and ale from Crake's Ford" priority 20 when quantity(ninefingers, rations) <= 2 and not laden(carters)
    seeks laden(carters).
  Pursuit haul for carters "hauling supplies up to the Lanthorn" priority 20 when laden(carters) seeks at(carters, court).
  Rule supplies_in when laden(carters) and at(carters, court) { Retract laden(carters). Increase quantity(ninefingers, rations) by 4. }
  Rule crew_eats when untilLight(clock) == 1 and quantity(ninefingers, rations) >= 1 and able(crew) and not lifted(toll) {
    Decrease quantity(ninefingers, rations) by 1.
  }
  Pursuit forage for crew "going down to Skerry to take what they need" priority 25 when quantity(ninefingers, rations) <= 0
    and able(crew) and not laden(crew) and not lifted(toll) seeks at(crew, home_town).
  Rule crew_takes when at(crew, home_town) and quantity(ninefingers, rations) <= 0 and not laden(crew)
    says "Ninefingers' crew come down into Skerry with knives out and go through the houses, and take the mine's meal store away up the road on their backs." {
    Assert laden(crew). Increase losses(home_town) by 3.
  }
  Pursuit carry for crew "carrying what they took back up to the Lanthorn" priority 25 when laden(crew) seeks at(crew, chapter_house).
  Rule spoils_in when laden(crew) and at(crew, chapter_house) { Retract laden(crew). Increase quantity(ninefingers, rations) by 6. }

  // The goat path: seen from the tower, it gets a watch of its own, and the Toll is taken on the cairn field too.
  Person lookouts "the cairn-field watch" at guardroom {
    Role "two of Ninefingers' crew, sent to keep the goat path". Ancestry human. Calling thief. Level 1. Numbers 2.
    Called "Hodge", "Wenlock".
    State watching blocking "Two of Ninefingers' crew sit on a cairn by the road with bows across their knees, looking up at the fell.".
  }
  Initially Assert serves(lookouts, ninefingers).
  // Ninefingers has seen the goat path used, from her tower.
  Relation pathSeen(group).
  Rule spotted when at(party, shoulder) and not dark() and tolls(wardens, toll_gate) and able(wardens)
    and not pathSeen(ninefingers) and not admits(ninefingers, party)
    says "Across the gulf a figure on the Lanthorn's tower stops, watches you a long moment, and goes down the stair in a hurry." {
    Assert pathSeen(ninefingers).
  }
  Rule watch_posted when pathSeen(ninefingers) and tolls(wardens, toll_gate) and able(lookouts)
    and not tolls(lookouts, cairn_field) and untilLight(clock) == 1 and not together(lookouts, party) {
    Assert at(lookouts, cairn_field). Assert tolls(lookouts, cairn_field). Assert guards(lookouts, skerry_road).
  }
  Action pay_watch(actor: group, site: place) "Pay the cairn-field watch the Toll, six coin" {
    Description "The same two crowns a head, on this side of the Gap too.".
    Requires able(actor) and company(actor) and at(actor, site) and tolls(lookouts, site) and at(lookouts, site)
      and able(lookouts) and not tolerates(lookouts, actor) and quantity(actor, gold) >= 6.
    On success { Decrease quantity(actor, gold) by 6. Increase quantity(lookouts, gold) by 6. Assert tolerates(lookouts, actor). }
    Result "Hodge bites one of the coins and waves you on.".
  }
  Relation hailed(group).
  Rule watch_demands when together(lookouts, party) and tolls(lookouts, cairn_field) and able(lookouts)
    and not tolerates(lookouts, party) and not hostile(ninefingers, party) and not hailed(party)
    says "'Toll's six coin this side too,' says Hodge, and puts an arrow to the string. 'Goat path or no goat path.'" {
    Assert hailed(party).
  }
  Rule watch_paid_once when not at(party, cairn_field) and (tolerates(lookouts, party) or hailed(party))
    and not admits(ninefingers, party) { Retract tolerates(lookouts, party). Retract hailed(party). }
  Rule watch_recalled when lifted(toll) and guards(lookouts, skerry_road) { Retract guards(lookouts, skerry_road). }
  Rule watch_fights when together(lookouts, party) and hostile(ninefingers, party) and able(lookouts) and not routed(lookouts)
    says "The watch on the cairn field see who you are and come down off the cairn with knives out." { Assert assails(lookouts, party). }

  // What the crew owe the Heron and Eel, and what the Heron has left.
  Topic debt with provider "Ask what Ninefingers' crew owe" when owes(ninefingers, provider) >= 8 {
    Says "'Write it down, they say, and I write it down.' She shows you a slate covered both sides. 'If they ever pay me I'll buy sheep again. If they stop coming I'll know they've found someone else to eat.'".
  }

  // The tower: Big Coll on the stair, Ninefingers in the solar above, and a false step on the way to the lantern.
  Person coll "Big Coll" at tower_foot {
    Role "Ninefingers' doorman". Ancestry human. Calling warrior. Level 2.
    Guards tower_stair.
    State minding blocking "Big Coll sits on the bottom step of the tower stair, which he fills.".
  }
  Rule tower_roused when (not able(coll) or routed(coll) or not able(ninefingers)) and not alarmed(ninefingers)
    and not lifted(toll) { Assert alarmed(ninefingers). }
  Rule coll_rises when alarmed(ninefingers) and together(coll, party) and able(coll) and not tolerates(coll, party)
    says "Big Coll stands up off the step, and keeps standing up for a while." { Assert assails(coll, party). }
  Observe solar_scene at solar when true "The warden's solar: a round room with a fire, a carved table, tapestries of lamps, and windows on three sides of the Gap. A narrower stair goes on up.".
  Person ninefingers "Ottilie Ninefingers" at solar {
    Role "who holds the Lanthorn and tolls the Gap". Ancestry human. Calling thief. Level 3.
    Wants noonlight. Wants first_light.
    State holding "Ottilie Ninefingers sits with her boots on the Lamplighters' table, counting the Toll with four fingers and a thumb on her left hand, and four on her right.".
    State abed "Ninefingers sleeps under a heap of furs in the Lamplighters' great bed, with her boots on.".
  }
  Rule nine_sleeps when dark() and state(ninefingers, holding) and not together(ninefingers, party) { Assert state(ninefingers, abed). }
  Rule nine_rises when not dark() and state(ninefingers, abed) { Assert state(ninefingers, holding). }
  Rule nine_stirs when state(ninefingers, abed) and together(ninefingers, party) and not guest(party) and not admits(ninefingers, party)
    and ((capable(party, stealth) and dice(clock) <= 8) or (not capable(party, stealth) and dice(clock) <= 30))
    says "The heap of furs on the bed sits up, and is Ninefingers, with a knife already in her hand." { Assert state(ninefingers, holding). }
  Rule nine_fights when state(ninefingers, holding) and together(ninefingers, party) and not guest(party) and not admits(ninefingers, party)
    and able(ninefingers) and not lifted(toll) says "'COLL!' Ninefingers comes over the table at you." {
    Assert alarmed(ninefingers). Assert assails(ninefingers, party).
  }
  Topic nine_toll with ninefingers "Ask Ninefingers to lift the Toll" when state(ninefingers, holding) once {
    Says "'Lift it?' Ninefingers laughs. 'The Toll's my living. Find me a better one.' She taps the floor with her boot. 'There's a better one under us, if my lads had the stomach for it. The Lamplighters bottled light and sold it to kings, and the cellars are full of it. Bring me a jar of noonlight and I'll believe you can bring me more. Bring me the big one they kept for the beacon, and I'll take my lads and go somewhere warm, and you can have your road.'".
    On discuss { Assert knows(actor, nine_bargain). }
  }
  Objective deal when knows(party, nine_bargain) and not lifted(toll) "Ninefingers will lift the Toll for the company for a jar of noonlight, and leave the Gap for the First Light.".
  Entity nine_bargain: fact "Ninefingers will let the company come and go for a jar of noonlight from the Lanthorn's cellars, and will leave the Lanthorn for good for the First Light, the great jar the Lamplighters kept for the beacon.".
  Initially Assert established(nine_bargain).
  Rule nine_pleased when keeps(ninefingers, ?jar) and itemKind(?jar, noonlight) and not admits(ninefingers, party)
    says "Ninefingers holds the jar up to the window, and noon comes out of it onto her face. 'Well, now,' she says. 'Come and go as you like. Tell the lads I said so.'" {
    Retract hostile(ninefingers, party). Retract alarmed(ninefingers). Assert admits(ninefingers, party). Retract guest(party).
  }
  // Ninefingers has told her crew to let the company come and go in the Lanthorn as it likes (admits, in dominion).
  Place south "the road south, out of the Varrow" is room within gatehouse.
  Rule nine_goes when keeps(ninefingers, ?jar) and itemKind(?jar, first_light) and not at(ninefingers, south)
    says "Ninefingers wraps the First Light in her cloak like a baby. By evening the crew have packed the goats, and the Lanthorn's gate stands open and nobody in it." {
    Assert at(ninefingers, south). Assert at(crew, south). Assert at(wardens, south). Assert at(coll, south).
    Assert at(lookouts, south). Assert state(portcullis, up). Assert lifted(toll). Assert earned(party).
  }
  Entity toll: fact "Ninefingers' Toll on the Gap road.".
  Rule unheld when lifted(toll) and holds(ninefingers, ?p) { Retract holds(ninefingers, ?p). }
  Rule toll_ends when lifted(toll) and tolls(?collector, ?post) and serves(?collector, ninefingers) {
    Retract tolls(?collector, ?post).
  }
  Rule gate_left when lifted(toll) and state(gate_bar, barred) and not holds(?power, gate_passage) { Assert state(gate_bar, open). }
  Rule emptied when lifted(toll) and not holds(?power, gate_passage) and not vacant(gate_passage)
    and not taken(gate_passage) { Assert vacant(gate_passage). }
  // Whoever takes it after Ninefingers holds the gate against everyone they do not know.
  Relation taken(place).
  Initially Assert covets(claimant, gate_passage).
  Rule claimed when holds(claimant, gate_passage) and not taken(gate_passage) { Assert taken(gate_passage). }
  Rule claimants_bar when holds(claimant, gate_passage) and posts(?band, claimant) and together(?band, party)
    and able(?band) and not routed(?band) and not tolerates(?band, party)
    says "Small shapes come boiling out of the guardroom and the gate passage, shrieking with laughter." {
    Assert assails(?band, party).
  }
  Observe claimed_scene at toll_gate when holds(claimant, gate_passage)
    "Somebody has moved into the Lanthorn. The toll board is gone from the gate, smoke goes up from the guardroom chimney, and things hang from the gatehouse windows that turn in the wind.".
  Observe empty_scene at toll_gate when vacant(gate_passage)
    "The Lanthorn's gate stands open and nobody keeps it. The toll board lies face down in the road.".
  Rule leaderless when not able(ninefingers) and able(crew) and not lifted(toll) and untilLight(clock) == 1
    says "Without Ninefingers the crew quarrel all night over her strongbox and her boots, and by morning they have gone over the Gap in three directions." {
    Assert at(crew, south). Assert at(wardens, south). Assert at(coll, south). Assert at(carters, south).
    Assert at(lookouts, south). Assert lifted(toll).
  }
  Rule broken when not able(ninefingers) and not able(crew) and not lifted(toll) { Assert lifted(toll). Assert earned(party). }
  // Only the company that ended the Toll is paid for it: not the dark, not a crew that ran from it.
  Relation earned(group).
  Rule chief_fell when not able(ninefingers) and not earned(party) { Assert earned(party). }
  Topic claim_bounty with reeve "Tell the reeve the Toll is ended" when lifted(toll) and earned(actor) and knows(actor, bounty) once {
    Says "Garrow goes to the window, as if he could see the Gap from it, and then counts fifty crowns out of a strongbox onto the ledger without a word. Then he shakes your hand for rather a long time.".
    On discuss { Increase quantity(actor, gold) by 50. }
  }
  Relation lifted(entity).

  Thing strongbox "Ninefingers' strongbox" at solar {
    Holds.
    State locked closed "An iron strongbox stands under the table, locked with three locks.".
    State open "Ninefingers' strongbox stands open.".
    Change pick "Pick the strongbox's three locks" from locked to open needing lockwork.
  }
  Item season_toll "a season of the Toll" is toll_silver in strongbox.
  Thing bell_wire "a wire from the strongbox's lid" at solar {
    State set "".
    State cut "A cut wire hangs from the strongbox's lid.".
    Change cut "Cut the wire from the strongbox's lid" from set to cut needing trapwork after learning wire_known.
  }
  Entity wire_known: fact "A fine wire runs from the lid of Ninefingers' strongbox up into the ceiling, to a bell somewhere.".
  Initially Assert established(wire_known).
  Observe wire_tell near strongbox when tried(strongbox, looking) and state(bell_wire, set) "A wire as fine as a hair runs from the strongbox's lid up a chair-leg and into a crack in the ceiling." teaches wire_known.
  Rule bell_rings when state(bell_wire, set) and state(strongbox, open) says "A bell rings below, wildly, and goes on ringing." {
    Assert state(bell_wire, cut). Assert alarmed(ninefingers).
  }

  Observe lantern_scene at lantern when true "The top of the tower is open to the sky. A great cradle of bronze stands in the middle, and around it on gimbals hang mirrors as big as doors, green with age, all pointing at the empty cradle. A square shaft goes down beside it into the dark of the rock.".
  Hazard falling_step "A falling step" means "Deal (1d8) physical damage to ally unless dexterity save against (13).".
  Thing false_step "a step on the lantern stair" on lantern_stair {
    State poised dangerous "The lantern stair is steep and narrow, and one step near the top is newer stone than the rest.".
    State fallen "A gap in the lantern stair shows where a step dropped away. There is room to step across.".
    Hurts with falling_step when poised then fallen.
  }
  Rule step_shown when (tried(false_step, prodding) or tried(false_step, pushing)) and state(false_step, poised)
    says "The newer step tips and drops away down the stairwell; a long time later it hits something." {
    Assert state(false_step, fallen).
  }

  // The beacon: the First Light in the cradle, and noon goes down the shaft into the deep cellar.
  Thing cradle "the beacon cradle" at lantern {
    Holds.
    State empty "The beacon cradle is empty.".
  }
  Rule beacon_lit when inside(?jar, cradle) and itemKind(?jar, first_light) and not kindled(beacon)
    says "Light pours out of the cradle and the mirrors catch it, one after another, until the top of the tower is too bright to look at. Down the shaft beside the cradle it goes like water, into the rock. Far below something that was never alive screams." {
    Assert kindled(beacon). Assert state(unlight, scorched).
  }
  Entity beacon: scenery "the Lanthorn's beacon".
  Relation kindled(entity).
  Observe beacon_burns at lantern when kindled(beacon) "The beacon burns in its cradle, and the mirrors throw its light down the valley as far as the sea.".

  // The Wick: the Lamplighters' cellars, where they made and kept bottled light.
  Observe stair_foot_scene at stair_foot when true "The foot of a long stair, in a vaulted crossing cut from the rock. Iron lamp-hooks in every wall, all empty. One way smells of water.".
  Observe cistern_scene at cistern when true "A great cistern under the court, black water in a vault held up by pillars. A shaft comes down through the roof from the court above, a rope's end hanging in it. At the far end the water spills into a culvert.".
  Observe works_scene at lamp_works when true "The lamp-works: benches, wick-looms, grinding wheels, racks of lamp-glasses in every size. Everything is clean.".
  Observe glass_scene at glasshouse when true "The glass-house: a beehive furnace, cold, and moulds for lenses as big as cartwheels. A flue goes up from the furnace into the rock.".
  Observe cellar_scene at bottle_cellar when true "The bottle cellar: racks to the ceiling, and in them jars, thousands of jars, every one dark. Here and there one still glows like a coal.".
  Observe deep_scene at deep_cellar when not lightless(deep_cellar) "The deep cellar is round, and its walls are covered in writing, line after line in the Lamplighters' hand, the same words over and over: KEEP IT LIT.".
  Observe vault_scene at first_vault when true "A small vault, warm as a summer afternoon.".
  Observe crack_scene at crack_foot when true "The crack opens into a narrow cave that goes on down. Far off, very small, there are lights: green, gold and white.".

  Thing sluice "the sluice gate" at cistern {
    State shut "An iron sluice gate stands in the cistern's far wall, shut, its wheel rusted.".
    State open "The sluice stands open; the cistern's water roars away down a channel in the rock.".
    Change open "Wrench the sluice wheel round" from shut to open needing brawn.
  }
  Hazard cold_water "The flooded culvert" means "Deal (1d6) cold damage to ally unless constitution save against (12).".
  Thing flood "the water in the overflow" on overflow {
    State brimming dangerous "The overflow culvert is full of black water to the roof. It would have to be swum, holding your breath, in the dark.".
    State drained "The overflow culvert is drained, a wet tunnel you can walk stooping.".
    Hurts with cold_water when brimming then brimming.
  }
  Rule culvert_drains when state(sluice, open) and state(flood, brimming) { Assert state(flood, drained). }
  Discovery cistern_find "Something lies on the cistern's shelf under the water." {
    Found by searching cistern "Under the water on a shelf by the steps, something pale: a drowned Lamplighter's chain of office.".
  }
  Item chain_of_office "a Lamplighter's chain of office" is grave_rings at cistern hidden until cistern_find.

  // The Tender minds the dark, not thieves: it trims what has gone out, and anyone it finds without light.
  Person tender "the Tender" at lamp_works {
    Role "the Lamplighters' bronze lamp-tender". Species bronze_construct.
    State tending "A bronze figure with a lamp-cage for a head walks the lamp-works on its round, trimming wicks in empty lamps and polishing glass nobody will look through.".
  }
  Rule tender_trims when together(tender, party) and benighted(party) and able(tender) and not tolerates(tender, party)
    says "Something bronze clicks in the dark, comes closer, and its shears open: it has found a wick gone out." {
    Assert assails(tender, party).
  }
  Rule tender_to_cellar when at(tender, lamp_works) and not together(tender, party) and dice(clock) <= 8 { Assert at(tender, bottle_cellar). }
  Rule tender_to_glass when at(tender, bottle_cellar) and not together(tender, party) and dice(clock) <= 8 { Assert at(tender, glasshouse). }
  Rule tender_home when at(tender, glasshouse) and not together(tender, party) and dice(clock) <= 8 { Assert at(tender, lamp_works). }

  Thing racks "the jar racks" at bottle_cellar {
    Holds.
  }
  Item noon_jar "a jar of noonlight" is noonlight in racks.
  Item moon_jar "a jar of moonlight" is moonlight in racks.
  Item moon_jar_two "a second jar of moonlight" is moonlight in racks.
  // A jar gone bad: tried with a pry or a flame, it bursts.
  Hazard soured_burst "Soured light" means "Deal (2d6) radiant damage to ally unless constitution save against (12). Apply blinded to ally for 3 turns unless constitution save against (12).".
  Thing soured "a jar that glows the colour of a bruise" at bottle_cellar {
    State whole "One jar on the end of a rack glows the colour of a bruise. The light in it moves.".
    State burst "Shards of a jar lie under the racks, and the wall behind is scorched in the shape of a hand.".
  }
  Observe soured_tell near soured when tried(soured, looking) and state(soured, whole) "Close to, the bruise-coloured light presses against the glass where your face is, and follows you when you move. The stopper is cracked.".
  Observe soured_hums near soured when tried(soured, listening) and state(soured, whole) "The jar hums, very softly, like a wasp in a bottle.".
  Rule soured_bursts when (tried(soured, prying) or tried(soured, burning) or tried(soured, prodding)) and state(soured, whole)
    says "The jar bursts. For a moment the cellar is full of a bruise-coloured noon." {
    Assert state(soured, burst). Assert strikes(soured_burst, party).
  }

  // The Unlight: light kept too long in the dark, gone wrong. It eats light, and its hounds hunt whoever it leaves blind.
  Thing unlight "the Unlight" at deep_cellar is scenery {
    State ravening "In the middle of the cellar the dark is thicker than dark: a stain on the air that your light falls into and does not come out of.".
    State scorched "The stain in the deep cellar's air has shrunk to the size of a fist, and trembles.".
    State gone "Nothing is left of the Unlight but a scorch on the floor, and the words on the walls.".
    State waking "The stain in the deep cellar's air has grown back to the size of a man, and the dark around it is deepening.".
    Change scorch "Unstop the noonlight at the Unlight" from ravening to scorched consuming noonlight.
    Change scorch_again "Unstop the noonlight at the Unlight" from waking to scorched consuming noonlight.
    Change burn_out "Pour out the First Light on the Unlight" from ravening to scorched consuming first_light.
  }
  Initially Assert lightless(deep_cellar).
  // Each night the Unlight grows, and the dark spreads up through the Wick toward the crew; scorched, it shrinks and
  // starts again; only the beacon ends it.
  Measure gloom(entity).
  Initially Set gloom(unlight) to 0.
  Rule unlight_grows when untilLight(clock) == 1 and not kindled(beacon) and not state(unlight, gone) { Increase gloom(unlight) by 1. }
  Rule unlight_wakes when state(unlight, scorched) and gloom(unlight) >= 4 { Assert state(unlight, waking). Assert lightless(deep_cellar). }
  Rule unlight_ravens when state(unlight, waking) and gloom(unlight) >= 6 { Assert state(unlight, ravening). }
  Rule dark_cellar when state(unlight, ravening) and gloom(unlight) >= 8 and not lightless(bottle_cellar) { Assert lightless(bottle_cellar). }
  Rule dark_works when state(unlight, ravening) and gloom(unlight) >= 12 and not lightless(lamp_works) {
    Assert lightless(lamp_works). Assert lightless(glasshouse).
  }
  Rule dark_crossing when state(unlight, ravening) and gloom(unlight) >= 16 and not lightless(stair_foot) {
    Assert lightless(stair_foot). Assert lightless(cistern).
  }
  Rule dark_hall when state(unlight, ravening) and gloom(unlight) >= 20 and not lightless(chapter_house)
    says "The lamps in the Lanthorn go out all at once, and do not light again." { Assert lightless(chapter_house). }
  Rule dark_scorched at deep_cellar when state(unlight, scorched) and lightless(deep_cellar)
    says "Noon pours into the deep cellar. The dark screams without a sound and shrinks, and for the first time in a hundred years the walls are seen." {
    Set gloom(unlight) to 0. Retract lightless(deep_cellar). Retract lightless(bottle_cellar). Retract lightless(lamp_works).
    Retract lightless(glasshouse). Retract lightless(stair_foot). Retract lightless(cistern). Retract lightless(chapter_house).
  }
  Rule unlight_ends when kindled(beacon) and not state(unlight, gone) { Assert state(unlight, gone). }
  Rule crew_quit when lightless(chapter_house) and able(ninefingers) and not lifted(toll)
    says "Ninefingers' crew come out of the chapter house in the dark, running, with their torches dead in their hands, and do not stop at the gate." {
    Assert at(ninefingers, south). Assert at(crew, south). Assert at(wardens, south). Assert at(coll, south). Assert at(carters, south).
    Assert at(lookouts, south). Assert lifted(toll). Assert state(portcullis, up).
  }
  Observe lamps_gutter at lamps when gloom(unlight) >= 8 and state(unlight, ravening) "The lamps in the great iron wheel burn low and blue, and three have gone out that nobody can relight.".
  Observe lamps_steady at lamps when kindled(beacon) "Every lamp in the temple burns tall and steady, and Mother Ash has taken to humming.".
  Observe skerry_robbed at home_town when losses(home_town) >= 3 "Doors in Skerry hang off their hinges, and the mine's meal store stands empty: Ninefingers' crew came down and took it.".
  Observe toll_gone at home_town when lifted(toll) "Carts come down into Skerry from the Gap with grain on them, and people stand in the street to watch them come.".

  Person glooms "the glooms" at deep_cellar {
    Role "hound-shaped pieces of the dark". Species cave_hound. Numbers 3.
    State prowling "Something keeps just beyond the edge of the light: three shapes like hounds cut out of the dark.".
  }
  Rule glooms_hunt when together(glooms, party) and benighted(party) and able(glooms) and not routed(glooms)
    says "The dark comes at you on all sides, with teeth." { Assert assails(glooms, party). }
  Rule glooms_shy when together(glooms, party) and not benighted(party) and able(glooms) and capable(party, sunlight)
    says "The glooms flinch from the noonlight and pour away down the crack like spilled ink." { Assert at(glooms, crack_foot). }
  Thing sun_lock "the sun-door's lock" on sun_door {
    State sealed blocking "The sun-door is a disc of bronze with no handle and no keyhole, only a hollow in the middle the size of a jar's mouth.".
    State open "The sun-door has rolled aside into the wall.".
    Change open "Hold noonlight to the hollow in the sun-door" from sealed to open needing sunlight.
  }
  Item first "the First Light" is first_light at first_vault.
  Goal lifted(toll) or kindled(beacon).
}
