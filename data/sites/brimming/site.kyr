Module brimming "The Brimming" {
  Description "Caverns under Skerry's mine, where the Glimmerkin keep light the way other folk keep bees: bottled, traded, guarded. A market under a roof of glow-worms, a still black lake with one boat on it, and beyond the lake a crack that goes up toward the Lanthorn's cellars, out of which, lately, the dark comes down at night.".
  Entity party: group "Your company".
  Place varrow "The region" is region.
  Place mine_head "The mine head above" is room.
  Place crack_foot "The bottom of the crack below the Lanthorn" is room.
  Entity hest: group "The mine captain".
  Entity glooms: group "The Unlight's hounds".
  Entity unlight: scenery "The Unlight".
  Entity ravening: condition "ravening".

  Place brimming "the Brimming" is site within varrow at 5, 2.
  Place galleries "The deep galleries" is level within brimming.
  Place caverns "The caverns" is level within brimming.
  Place deep_gallery "the deep gallery" is room within galleries at 0, 0.
  Place breakthrough "the breakthrough" is room within galleries at 1, 0.
  Place market "the Glimmer Market" is room within caverns at 1, 1.
  Place mother_hall "the Wick-Mother's hall" is room within caverns at 0, 1.
  Place farm "the glow-worm farm" is room within caverns at 1, 2.
  Place lake_shore "the shore of the still lake" is room within caverns at 2, 1.
  Place far_shore "the far shore" is room within caverns at 3, 1.
  Place dark_reach "the dark reach" is room within caverns at 3, 0.
  Initially Assert unlit(deep_gallery). Initially Assert unlit(breakthrough). Initially Assert unlit(far_shore).
  Initially Assert unlit(dark_reach).

  // Down the mine's deep shaft in the cage, which Captain Hest keeps chained; along the gallery to where the miners
  // broke through; down the Glimmerkin's ladder; across the lake by their boat; and up the crack to the Lanthorn.
  Passage cage "the deep cage" is shaft between mine_head and deep_gallery taking 20 minutes.
  Passage gallery_way "the deep gallery" is passage between deep_gallery and breakthrough taking 20 minutes.
  Passage ladder_way "the Glimmerkin's ladder" is ladder between breakthrough and market.
  Passage hall_arch "the arch to the Wick-Mother's hall" is arch between market and mother_hall.
  Passage farm_way "the low way to the farm" is passage between market and farm.
  Passage shore_way "the way down to the shore" is passage between market and lake_shore.
  Passage lake "the still lake" is ferry between lake_shore and far_shore taking 30 minutes.
  Passage reach_way "a cleft in the rock" is passage between far_shore and dark_reach.
  Passage up_crack "the crack going up" is climb between dark_reach and crack_foot taking 1 hour needing climbing or rope.

  Observe gallery_scene at deep_gallery when true "A gallery deeper than the rest, its timbers newer. A board nailed across a side-drift says KEEP OUT in a hurried hand. The air moves, coming up from somewhere.".
  Observe break_scene at breakthrough when true "The gallery ends in a ragged hole where the miners broke into a cave. Two miners' lamps lie on the floor by the hole, cold, their oil still in them.".
  Observe market_scene at market when true "A cavern roofed with glow-worms like a night sky, and under it stalls of jars that shine: green, gold, white as noon. Small soft-footed people with eyes like a cat's in lamplight move between them, talking in whispers.".
  Observe hall_scene at mother_hall when true "A round hall with a fire of something that burns without smoke, and a very old Glimmerkin in a shawl beside it, knitting, with a jar of moonlight in her lap.".
  Observe farm_scene at farm when true "Racks of damp wood strung with glow-worm threads, and Glimmerkin with jars going softly along them, harvesting the light.".
  Observe shore_scene at lake_shore when true "A black lake as still as glass, going off into the dark. A flat boat, and a post with a little bell on it.".
  Observe far_scene at far_shore when true "The far shore of the lake: stones, and Glimmerkin jars smashed on them, dark.".
  Observe reach_scene at dark_reach when true "A cleft going up into the rock, cold, with a draught coming down it that smells of nothing at all. Up there, a long way, is the Lanthorn.".

  // The cage: chained, and Captain Hest will not lower anyone until someone has found what took his men.
  Thing cage_chain "the chain on the deep cage" on cage {
    State chained blocking "The deep cage is chained to its post, with a padlock.".
    State loose "The deep cage hangs ready at the top of the shaft.".
    Change pick "Pick the padlock on the deep cage's chain" from chained to loose needing lockwork.
  }
  Topic hest_cage with hest "Ask Captain Hest to lower you down the deep shaft" when state(cage_chain, chained) once {
    Says "Hest looks at you a long time. 'Find out what took Dunstan and Rafe,' he says, 'and bring me back anything of theirs. I'll lower you, and I'll be at the top when you come up, if you come up.' He takes the key off his belt.".
    On discuss { Assert state(cage_chain, loose). }
  }
  Item lamp_one "Dunstan's lamp" is moonlight at breakthrough.
  Observe miners_fate at breakthrough when true "By the hole, scratches in the rock at the height of a man's hand, going away into the dark in a line: fingernails.".
  Relation returned(entity).
  Rule lamp_home when holding(party, moonlight) and at(party, mine_head) and not returned(lamp_one) and not at(lamp_one, breakthrough)
    says "Hest takes Dunstan's lamp and turns it over in his hands. 'It still burns,' he says. 'It never went out. It was him that went out.' He pays you what he would have paid Dunstan for a month." {
    Assert returned(lamp_one). Increase quantity(party, gold) by 12.
  }

  // The Glimmerkin.
  Person mother "the Wick-Mother" at mother_hall {
    Role "the eldest of the Glimmerkin". Ancestry glimmerkin. Calling mage. Level 4. Peaceable.
    State knitting "The Wick-Mother knits by her smokeless fire and watches you over the needles.".
  }
  Person traders "the Glimmerkin traders" at market {
    Role "sellers of bottled light". Ancestry glimmerkin. Calling thief. Level 1. Numbers 3. Peaceable.
    Called "Tallow", "Flicker", "Glede".
    Sells moonlight for 15 coin from 3.
    Sells noonlight for 45 coin from 1.
    Buys gilt_crown for 4 coin. Buys sun_disc for 40 coin. Buys grave_rings for 10 coin.
  }
  Initially Set quantity(traders, gold) to 120.
  Person ferryman "Spill the ferryman" at lake_shore {
    Role "who poles the boat across the still lake". Ancestry glimmerkin. Calling commoner. Level 1. Peaceable.
    State waiting "Spill sits in the boat with his pole across his knees, humming.".
  }
  Thing boat "the flat boat" on lake is scenery {
    State moored blocking "The flat boat is tied up, and Spill will not have strangers poling it.".
    State poled "Spill has the boat out on the lake for you.".
  }
  Action hire_boat(actor: group, site: place) "Pay Spill two coin to pole you across" {
    Requires able(actor) and at(actor, site) and at(ferryman, site) and state(boat, moored) and quantity(actor, gold) >= 2.
    On success { Decrease quantity(actor, gold) by 2. Increase quantity(ferryman, gold) by 2. Assert state(boat, poled). }
    Result "Spill counts the coins twice and pushes off. The boat makes no sound at all on the still water.".
  }
  Rule boat_back when state(boat, poled) and not at(party, lake_shore) and not at(party, far_shore) { Assert state(boat, moored). }

  Entity dark_comes: fact "At night the dark comes down the crack from the Lanthorn into the Brimming, and drinks the Glimmerkin's jars; three lamp-keepers have gone into it and not come back.".
  Initially Assert established(dark_comes).
  Topic mother_dark with mother "Ask the Wick-Mother what is wrong in the Brimming" when true once {
    Says "'The dark comes down,' she says, and her needles stop. 'From up there, from the Lamplighters' cellars, down the crack and across the lake. It drinks our jars. It took three of our lamp-keepers, and your miners, who came blundering in with their lamps lit like supper.' She looks at you. 'The Lamplighters made it. They kept light too long in the dark, and it soured. It wants burning out with noon. We have one jar of noon left, and it is for sale, because we are poor.'".
    On discuss { Assert knows(actor, dark_comes). }
  }
  Topic mother_thanks with mother "Tell the Wick-Mother the dark is burnt out" when not state(unlight, ravening) and knows(actor, dark_comes) once {
    Says "The Wick-Mother puts down her knitting and takes your hands in her small dry ones. 'Then the Brimming owes you,' she says. 'Take this.' It is a jar of noonlight, the last one, and she does not let go of it for a moment.".
    On discuss { Assert knows(actor, mother_grateful). }
  }
  Entity mother_grateful: fact "The Wick-Mother has given the company her last jar of noonlight, in thanks for burning out the dark.".
  Initially Assert established(mother_grateful).
  Item gift_jar "the Wick-Mother's jar of noonlight" is noonlight at mother_hall hidden until mother_grateful.
  Measure jars_lost(place).
  // While the Unlight ravens, its hounds come down the crack at night and drink the jars on the far shore.
  Rule dark_comes_down when state(unlight, ravening) and dark() and untilLight(clock) == 6 and dice(clock) <= 40 {
    Increase jars_lost(market) by 1.
  }
  Observe jars_dark at market when jars_lost(market) >= 1 and state(unlight, ravening) "Some of the jars on the stalls have gone dark since you were last here, and the traders talk about it in whispers.".
  Rule glooms_on_shore when state(unlight, ravening) and dark() and at(party, far_shore) and at(glooms, crack_foot) and able(glooms)
    and dice(clock) <= 30 says "Out of the cleft comes cold, and in the cold, shapes like hounds cut out of the dark." {
    Assert at(glooms, far_shore).
  }
  Goal returned(lamp_one) or knows(party, mother_grateful).
}
