Module pantry "Wayside pantry" {
  Description "A caretaker moves the last ration into the pantry. The provision deadline continues offscreen.".
  Entity party: group "Visiting company".
  Entity watcher: group "Guard elsewhere".
  Entity carrier: group "Pantry caretaker".
  Entity road: place "Imported crossing exit".
  Entity shelter: place "Wayside shelter".
  Entity cache: stock "Ration crate".
  Entity granary: stock "Pantry".
  Entity gold: good "Coin". Entity rations: good "Ration".
  Entity clock: clock "Campaign watch".
  Entity winter: pressure "Pantry deadline".
  Initially Assert at(carrier, shelter). Initially Assert unladen(carrier).
  Initially Assert at(cache, shelter). Initially Assert at(granary, shelter).
  Initially Assert mayCollect(carrier, cache).
  Initially Assert route(road, shelter). Initially Assert route(shelter, road).
  Query supplied() means quantity(granary, rations) >= 1.
  Query missed() means recorded(winter) and deficit(winter) > 0.
  Goal supplied().
}
