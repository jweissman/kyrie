{
  "frontier_margin": {
    "__no_id": true,
    "biome": "fen",
    "pace": "ordinary",
    "name": "The northern margin",
    "creatures": [],
    "actors": "=gen(frontier_empty_actors)",
    "labels": "=gen(frontier_labels)",
    "casting": "=gen(frontier_casting)",
    "_freeze": "=lookup(frontierDelay, #pace)",
    "initial": "=concat(gen(frontier_departure), gen(frontier_freeze), gen(frontier_supplies))",
    "outcomes": "=gatherEntries(frontierLedger, outcomes)"
  },
  "frontier_empty_actors": {
    "__no_id": true,
    "order": []
  },
  "frontier_labels": {
    "__no_id": true,
    "track": "=lookup(frontierName, #biome + \" track\")",
    "camp": "=lookup(frontierName, #biome + \" camp\")",
    "ford": "=lookup(frontierName, #biome + \" ford\")",
    "shrine": "=lookup(frontierName, #biome + \" shrine\")"
  },
  "frontier_casting": {
    "__no_id": true,
    "tala": "=gen(frontier_person)",
    "frostback": "=gen(frontier_beast)"
  },
  "frontier_person": {
    "__no_id": true,
    "raceId": "=defined(guideRace) ? #guideRace : lookup(frontierPeople, #biome)",
    "classId": "ranger",
    ">name": "=defined(guideName) ? #guideName : lookup(frontierGuide, guide)"
  },
  "frontier_departure": {
    "__no_id": true,
    ">name": "departAt",
    "args": [
      "winter"
    ],
    "value": "=#_freeze - 12"
  },
  "frontier_freeze": {
    "__no_id": true,
    ">name": "freezeAt",
    "args": [
      "winter"
    ],
    "value": "=#_freeze"
  },
  "frontier_beast": {
    "__no_id": true,
    "level": "=defined(beastLevel) ? #beastLevel : lookup(frontierBeastLevel, #biome)"
  },
  "frontier_supplies": {
    "__no_id": true,
    ">name": "quantity",
    "args": [
      "tala",
      "rations"
    ],
    "value": "=lookup(frontierProvision, #biome)"
  }
}