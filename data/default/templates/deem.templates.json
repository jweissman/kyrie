{
  "creature": {
    "__no_id": true,
    "raceId": "=lookup(creaturePopulation, defined('population') ? #population : any)",
    "_race": "=lookup(creatureRace, #raceId)",
    "classId": "=pick(dig(#_race, 'classes'))",
    "_class": "=lookup(creatureClass, #classId)",
    "level": 1,
    "_kind": "=defined('kind') ? #kind : dig(#_race, 'nameGroup')",
    "_hitDie": "=defined('hitDie') ? #hitDie : dig(#_class, 'hitDie')",
    "_primary": "=defined('primary') ? #primary : dig(#_class, 'primary')",
    "name": "=lookup(forename, #_kind)",
    "*attributes": "=gen(attributes)",
    "maxHp": "=max(1, #_hitDie + 1d4 + statMod(#constitution) + (#level - 1) * dig(#_class, 'hpPerLevel'))",
    "speed": "=max(0, statMod(#dexterity) + 1d4)",
    "_heritage": "=defined(backgroundId) ? dig(#_race, \"creationAbilities\") : concat()",
    "abilities": "=uniq(concat(dig(#_class, \"abilities\"), #_heritage))",
    "maxMana": "=dig(#_class, 'mana')"
  },
  "attributes": {
    "__no_id": true,
    "_primary": "=defined(primary) ? #primary : \"\"",
    "strength": "=min(18, 3d6 + (#_primary == \"strength\" ? 2 : 0))",
    "dexterity": "=min(18, 3d6 + (#_primary == \"dexterity\" ? 2 : 0))",
    "intelligence": "=min(18, 3d6 + (#_primary == \"intelligence\" ? 2 : 0))",
    "wisdom": "=min(18, 3d6 + (#_primary == \"wisdom\" ? 2 : 0))",
    "constitution": "=min(18, 3d6 + (#_primary == \"constitution\" ? 2 : 0))",
    "charisma": "=min(18, 3d6 + (#_primary == \"charisma\" ? 2 : 0))"
  },
  "character": {
    "__no_id": true,
    "*creature": "=gen(creature)"
  },
  "situation": {
    "__no_id": true,
    "name": "The disputed crossing",
    "cargo": "=lookup(supplies, cargo)",
    "pressure": "=lookup(pressure, bridge)",
    "deadline": "=4 + 1d6",
    "hasRations": "=rand() > 0.35",
    "gold": "=oneOf(0, 8)"
  },
  "module": {
    "__no_id": true,
    "townName": "=lookup(townName, settlement)",
    "cargoName": "=lookup(supplies, cargo)",
    "approaches": "=sample(gatherEntries(approach, crossing), 3)",
    "deadline": "=4 + 1d6",
    "rations": "=oneOf(0, 1)",
    "gold": "=oneOf(0, 8)",
    "hungry": "=rand() > 0.25"
  },
  "adventure": {
    "__no_id": true,
    "profile": "crossing",
    "_setting": "=lookup(adventureSetting, #profile)",
    "name": "=lookup(townName, settlement)",
    "deadline": 8,
    "mercyAt": 7,
    "urgentAt": 4,
    "claim": 3,
    "grain": 1,
    "playerGold": 3,
    "rations": 1,
    "creatures": "=dig(#_setting, 'creatures')",
    "actors": "=gen(adventure_actors)",
    "pressure": "=gen(adventure_pressure)",
    "outcomes": "=dig(#_setting, 'outcomes')",
    "initial": "=concat(gen(initial_claim), gen(initial_mercy), gen(initial_urgency), gen(initial_grain), gen(initial_parcel), gen(initial_fee), gen(initial_target), gen(initial_purse), gen(initial_rations))",
    "labels": "=gen(adventure_labels)"
  },
  "adventure_actors": {
    "__no_id": true,
    "order": "=dig(#_setting, 'actors')"
  },
  "adventure_pressure": {
    "__no_id": true,
    "id": "winter",
    "at": "=#deadline",
    "measure": {
      "kind": "call",
      "name": "quantity",
      "args": [
        "granary",
        "grain"
      ]
    },
    "required": "=#grain"
  },
  "initial_claim": {
    "__no_id": true,
    "args": [
      "guard"
    ],
    "value": "=#claim",
    ">name": "claim"
  },
  "initial_mercy": {
    "__no_id": true,
    "args": [
      "guard"
    ],
    "value": "=#mercyAt + (defined(now) ? #now : 0)",
    ">name": "mercy"
  },
  "initial_urgency": {
    "__no_id": true,
    "args": [
      "clock"
    ],
    "value": "=#urgentAt + (defined(now) ? #now : 0)",
    ">name": "urgentAt"
  },
  "initial_grain": {
    "__no_id": true,
    "args": [
      "consignment",
      "grain"
    ],
    "value": "=#grain",
    ">name": "quantity"
  },
  "initial_parcel": {
    "__no_id": true,
    "args": [
      "parcels",
      "parcel"
    ],
    "value": "=1",
    ">name": "quantity"
  },
  "initial_fee": {
    "__no_id": true,
    "args": [
      "market",
      "gold"
    ],
    "value": "=1",
    ">name": "quantity"
  },
  "initial_target": {
    "__no_id": true,
    "args": [
      "granary",
      "grain"
    ],
    "value": "=#grain",
    ">name": "required"
  },
  "initial_purse": {
    "__no_id": true,
    "args": [
      "party",
      "gold"
    ],
    "value": "=#playerGold",
    ">name": "quantity"
  },
  "initial_rations": {
    "__no_id": true,
    "args": [
      "party",
      "rations"
    ],
    "value": "=#rations",
    ">name": "quantity"
  },
  "adventure_labels": {
    "__no_id": true,
    "village": "=#name"
  },
  "information_unit": {
    "__no_id": true,
    "id": "=dig(#_information, 'id')",
    "text": "=dig(#_information, 'text')",
    "knownBy": "=dig(#_information, 'knownBy')",
    "deniedBy": "=dig(#_information, 'deniedBy')",
    "sources": "=dig(#_information, 'sources')"
  }
}