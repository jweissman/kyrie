Module origin "What is owed" {
  Kind chapter. Entity title: chapter "What is owed".
  Entity party: group "You".
  Place shop "The shop" is room.
  Entity creditor: group "The merchant". Entity keeper: group "Whoever keeps the inn". Entity loan: debt "What you owe".
  // The work the merchant tells of once paid, and the way there (see Origins.after; PT-01).
  Entity named: fact "Where it is". Entity found: fact "The way there".
  // What the innkeeper tells of the country round, once asked (see RegionRumours).
  Entity told: fact "What is out in the country round".
  Kind debt. Measure owed(debt).
  Relation extended(group). Relation called(group). Relation squared(group). Relation termed(group).
  // Once answered, the creditor's greeting is not said again.
  Relation spoke(group).
  Initially Set owed(loan) to 50. Initially Assert inDebtTo(party, creditor).
  Observe owed at shop as feature when owed(loan) > 0 and watch(clock) < 2 "You owe {creditor} fifty coin, for {lost} that went into the river at the ford last spring, oxen and all. {creditor} has been patient, and wrote to say so: patient until market day, ten days from now, and not after.".
  // Come in off the road, the town named: the opening had told what was owed and never where (its critique).
  Observe arrival at shop as feature when watch(clock) < 1 "{homename} has not changed. You come in off the road with your head down, past faces that knew you once, and go straight to {creditor}'s door: better it is done at once.".
  Observe sees near creditor when owed(loan) > 0 and watch(clock) < 2 and not spoke(party) "'{protagonist},' says {creditor}, and does not get up. 'Fifty coin, by market day. You'll have heard I said so.'".
  Topic promise with creditor "Tell {creditor} you will have it by market day" when owed(loan) > 0 and not called(actor) once {
    Says "'See that I do,' says {creditor}, going back to the tally. 'There's no shortage of work for someone with nothing to lose. Ask at the inn.'".
    On discuss { Assert spoke(actor). }
  }
  // Gone out of the shop, the creditor has been heard: the aim does not go back to the shop on coming in again (the owner,
  // 9 November: the aim had turned from the inn to the shop and back each time the company went through its door).
  Rule heard_out when not spoke(party) and not at(party, shop) { Assert spoke(party). }
  // Asked for, the terms are said; taken, they are kept (the follow-up review asked, and owed five coin more).
  Topic more_time with creditor "Ask {creditor} for five days more" when owed(loan) > 0 and not extended(actor)
    and not termed(actor) and not called(actor) once {
    Says "{creditor} looks at you for a long moment. 'Five days. And five coin more, for the asking. Take it or leave it.'".
    On discuss { Assert termed(actor). Assert spoke(actor). }
  }
  Topic take_time with creditor "Take the five days, for five coin more" when owed(loan) > 0 and termed(actor)
    and not extended(actor) and not called(actor) once {
    Says "'Done,' says {creditor}, and writes it in the tally, five days on and five coin more.".
    On discuss { Assert extended(actor). Increase owed(loan) by 5. }
  }
  Topic pay with creditor "Pay {creditor} what you owe" when owed(loan) > 0 and quantity(actor, gold) >= owed(loan) once {
    Says "{creditor} counts it twice, and sweeps it into the drawer. 'We're square.' For the first time, a smile. 'I didn't think you would.'{after}".
    On discuss { Decrease quantity(actor, gold) by owed(loan). Set owed(loan) to 0. Retract inDebtTo(actor, creditor). Assert squared(actor).
      Assert knows(actor, named). Assert knows(actor, found). }
  }
  Rule called_in when owed(loan) > 0 and not called(party) and ((watch(clock) >= 1440 and not extended(party)) or watch(clock) >= 2160) says "Word has gone round {homename}: {creditor} has called in what you owe, and will not deal with you, nor will anyone who wants {creditor}'s custom." {
    Assert called(party). Assert refusesService(creditor, party).
  }
  Topic pay_late with creditor "Pay {creditor} what you owe, late" when called(actor) and owed(loan) > 0 and quantity(actor, gold) >= owed(loan) once {
    Says "{creditor} takes it without a word, and without looking at you. It is paid. It is not forgotten.".
    On discuss { Decrease quantity(actor, gold) by owed(loan). Set owed(loan) to 0. Retract inDebtTo(actor, creditor). Assert squared(actor). Retract refusesService(creditor, actor). }
  }
  // The debt said where the company can do something about it: first the creditor; once spoken to or left, the inn, where
  // the creditor said work is asked after; with the coin in hand, the creditor again. The aim had led back to the shop
  // the company had just left with nothing to pay (the owner, 7 November: aims still chaotic).
  Objective owing when owed(loan) > 0 and not called(party) and not spoke(party) and at(party, shop) toward creditor "You owe {creditor} at {homename} {owed(loan)} coin, by market day.".
  Objective owing_work when owed(loan) > 0 and not called(party) and (spoke(party) or not at(party, shop)) and quantity(party, gold) < owed(loan) and not knows(party, told) toward keeper "You owe {creditor} {owed(loan)} coin by market day. There is work for someone with nothing to lose: ask {keeper} at {inn} what is out in the country round.".
{out}
  Objective owing_paid when owed(loan) > 0 and not called(party) and (spoke(party) or not at(party, shop)) and quantity(party, gold) >= owed(loan) toward creditor "You have the {owed(loan)} coin you owe {creditor}: pay it at {shop}, before market day.".
  Objective owing_late when owed(loan) > 0 and called(party) toward creditor "{creditor} has called in what you owe: {owed(loan)} coin.".
  Goal squared(party).
}
