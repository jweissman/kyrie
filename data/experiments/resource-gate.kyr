Module resource_gate "Resource-gated capability experiment" {
  Kind party. Kind stock. Kind good. Kind asset. Kind term. Kind need. Kind clock. Kind place.
  Relation at(entity, place) exclusive.
  Relation controls(party, asset).
  Relation permitted(party, asset).
  Relation enabled(asset).
  Relation installed(asset).
  Relation deadlineRecorded(need).
  Measure quantity(entity, good).
  Measure received(term).
  Measure delivered(need).
  Measure deficit(need).
  Measure watch(clock).
  Entity provider: party "Provider".
  Entity beneficiary: party "Beneficiary".
  Entity party: party "Visitor".
  Entity source: stock "Capability input port".
  Entity capability: asset "Capability".
  Entity term: term "Enabling requirement".
  Entity need: need "Provision".
  Entity clock: clock "Watch clock".
  Entity site: place "Interaction site".
  Entity gold: good "Gold". Entity filter: good "Filter". Entity coal: good "Coal".
  Entity grain: good "Grain". Entity water: good "Water". Entity raw_water: good "Raw water".
  Initially Assert at(provider, site).
  Initially Assert at(beneficiary, site).
  Initially Assert at(party, site).
  Initially Assert controls(provider, capability).
  Goal delivered(need) >= 3.
  Budget 6.
}
