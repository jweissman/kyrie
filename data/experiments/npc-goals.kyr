Module courier_goals "Two goals, one courier and one cargo slot" {
  Kind person. Kind place. Kind item.
  Relation at(person, place) exclusive.
  Relation carrying(person, item) exclusive.
  Relation critical(place).
  Measure stock(entity, item).
  Query empty(who: person) means not carrying(who, parcel) and not carrying(who, medicine).
  Entity courier: person "Courier".
  Entity depot: place "Depot". Entity market: place "Market". Entity clinic: place "Clinic".
  Entity parcel: item "Paid parcel". Entity medicine: item "Medicine". Entity coin: item "Coin".
  Initially Assert at(courier, depot).
  Initially Set stock(depot, parcel) to 1.
  Initially Set stock(depot, medicine) to 1.
  Goal stock(courier, coin) >= 2.
  Budget 10.
  Action load_parcel "Load paid parcel" {
    Requires at(courier, depot) and empty(courier) and stock(depot, parcel) >= 1.
    Cost 1. Time 1.
    On success { Decrease stock(depot, parcel) by 1. Assert carrying(courier, parcel). }
  }
  Action unload_parcel "Return parcel to depot" {
    Requires at(courier, depot) and carrying(courier, parcel).
    Cost 1. Time 1.
    On success { Retract carrying(courier, parcel). Increase stock(depot, parcel) by 1. }
  }
  Action load_medicine "Load medicine" {
    Requires at(courier, depot) and empty(courier) and stock(depot, medicine) >= 1.
    Cost 1. Time 1.
    On success { Decrease stock(depot, medicine) by 1. Assert carrying(courier, medicine). }
  }
  Action to_market "Travel to market" {
    Requires at(courier, depot).
    Cost 1. Time 1.
    On success { Assert at(courier, market). }
  }
  Action to_clinic "Travel to clinic" {
    Requires at(courier, depot).
    Cost 1. Time 1.
    On success { Assert at(courier, clinic). }
  }
  Action return_depot "Return to depot" {
    Requires at(courier, market) or at(courier, clinic).
    Cost 1. Time 1.
    On success { Assert at(courier, depot). }
  }
  Action deliver_parcel "Complete paid work" {
    Requires at(courier, market) and carrying(courier, parcel).
    Cost 1. Time 1.
    On success { Retract carrying(courier, parcel). Increase stock(market, parcel) by 1.
      Increase stock(courier, coin) by 2. }
  }
  Action deliver_medicine "Provision clinic" {
    Requires at(courier, clinic) and carrying(courier, medicine).
    Cost 1. Time 1.
    On success { Retract carrying(courier, medicine). Increase stock(clinic, medicine) by 1. }
  }
}
