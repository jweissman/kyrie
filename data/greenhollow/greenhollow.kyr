Module greenhollow "A House Above Older Halls" {
  Description "An apothecary's damaged cellar stands over a pilgrims' archive. Someone is trapped below; a keeper disputes the old refuge's purpose. Beyond the houses, tracks and medicinal plants follow the river and woodland. The house needs hands, the refuge needs an answer, and the older halls still hold the names and seeds of past travelers.".
  Place waking "The Waking World" is plane.
  Place vale "Greenhollow Vale" is region within waking.
  Place town "Greenhollow" is settlement within vale.
  Place roadstead "Ferry hamlet" is settlement within vale.
  Place wilds "Alderbank habitat" is wilderness within vale.
  Place street "Apothecary street" is room within town.
  Place ferry "Ferry landing" is room within roadstead.
  Place wood "The old towpath" is room within wilds.
  Place clearing "A deer's clearing" is room within wilds.
  Place house "The Hearthleaf apothecary" is building within town.
  Place shop "Hearthleaf shop" is room within house.
  Place basement "Hearthleaf · Cellar level" is level within house.
  Place cellar "The fallen drying racks" is room within basement.
  Place storeroom "The dry store" is room within basement.
  Place archive "The pilgrims' archive" is site within town.
  Place vault_level "Archive · Lower halls" is level within archive.
  Place vault "The seed register vault" is room within vault_level.
  Place passageway "The root-cut drain" is room within vault_level.
  Place refuge "Veyra's roadside house" is building within town.
  Place porch "The charter porch" is room within refuge.
  Place hall "The travelers' hall" is room within refuge.
  Exit into_shop "Enter Hearthleaf" from street to shop by enter.
  Exit out_shop "Step out onto Apothecary street" from shop to street by leave.
  Exit cellar_stair "Descend to the drying cellar" from shop to cellar by descend through cellar_door.
  Exit cellar_return "Ascend to Hearthleaf shop" from cellar to shop by ascend through cellar_door.
  Exit stores_out "Walk to the dry store" from cellar to storeroom by walk.
  Exit stores_back "Return to the drying racks" from storeroom to cellar by walk.
  Exit archive_stair "Descend to the old archive" from storeroom to vault by descend.
  Exit archive_return "Ascend to the dry store" from vault to storeroom by ascend.
  Exit drain_in "Follow the concealed drain" from vault to passageway by walk known by old_drain.
  Exit drain_out "Return to the seed vault" from passageway to vault by walk.
  Exit drain_home "Climb out onto the towpath" from passageway to wood by ascend.
  Exit drain_down "Descend through the root-cut drain" from wood to passageway by descend known by old_drain.
  Exit to_refuge "Enter Veyra's porch" from street to porch by enter.
  Exit from_refuge "Leave the roadside house" from porch to street by leave.
  Exit enter_hall "Enter the travelers' hall" from porch to hall by walk.
  Exit leave_hall "Return to the charter porch" from hall to porch by walk.
  Exit ridge_road "Travel the raised road to the outlying settlement" from street to ferry by travel.
  Exit ridge_return "Travel the raised road to the town" from ferry to street by travel.
  Exit to_towpath "Travel out along the river" from street to wood by travel.
  Exit from_towpath "Travel back to the town" from wood to street by travel.
  Exit to_ferry "Travel to the ferry hamlet" from wood to ferry by travel.
  Exit from_ferry "Travel to the alderbank" from ferry to wood by travel.
  Exit to_clearing "Follow the deer trail" from wood to clearing by walk.
  Exit from_clearing "Return to the towpath" from clearing to wood by walk.

  Entity party: group "Your company".
  Entity gold: good "Coin". Entity rations: good "Shared ration". Entity clock: clock "Campaign time".
  Entity fellowship: capability "Free Fellowship". Entity woodcraft: capability "Woodcraft".
  Entity delving: capability "Delving". Entity burial_lore: capability "Burial lore". Entity arcane_lore: capability "Arcane lore".
  Entity veyra: deity "Veyra, Keeper of the Last Road".
  Entity wayshrine: shrine "Veyra's wayfarer stone".
  Entity yarrow: species "Yarrow". Entity alder: species "Alder". Entity reddeer: species "Red deer".
  Entity otter: species "River otter". Entity greywolf: species "Grey wolf".
  Entity brasskey: itemkind "Brass cabinet key". Entity yarrowbundle: itemkind "Yarrow preparation".
  Entity ropekit: itemkind "Line and pitons". Entity protectivecharm: itemkind "Protective charm".
  Entity wardblade: itemkind "Warden's blade". Entity healingdraught: itemkind "Healing draught".
  Entity cabinet_key: item "The apothecary's cellar key". Entity herb_patch: item "Yarrow stems".
  Entity relic: item "An archive relic". Entity medicine: item "Bottled healing draught".
  Entity cellar_door: door "The ironbound cellar door".
  Entity dust_trap: hazard "The preservative dust shutter".
  Entity rack: mechanism "The fallen drying rack". Entity bolt: mechanism "The keeper's admission bolt".
  Entity old_drain: fact "Root marks reveal a drain from the lower vault to the towpath.".
  Entity rain: pressure "Approaching heavy rain". Measure closesAt(pressure).
  Relation rainArrived(pressure).

  Person apothecary "Maren" at shop { Role "apothecary". Class commoner. Level 2. }
  Person guest "Tamsin" at cellar { Role "itinerant seed carrier". Class thief. Level 2. }
  Person host "Cira" at porch { Role "keeper of the roadside house". Class commoner. Level 2. Uses open. }
  Person wildlife "The clearing's boar" at clearing { Role "territorial wildlife". Race boar. Class wild_beast. Level 2. }
  Person sentinel "The root-vault hound" at vault { Role "cave scavenger". Race cave_hound. Class wild_beast. Level 2. }
  Initially Assert at(party, street).
  Initially Assert at(cabinet_key, shop). Initially Assert itemKind(cabinet_key, brasskey).
  Initially Assert keyFor(cabinet_key, cellar_door). Initially Assert lockedDoor(cellar_door).
  Initially Assert pickableDoor(cellar_door).
  Initially Assert trapped(guest). Initially Assert restrainedBy(guest, rack).
  Initially Assert mounted(rack, cellar). Initially Assert obstruction(rack). Initially Assert home(guest, street).
  Initially Assert at(relic, vault). Initially Assert at(medicine, shop). Initially Assert itemKind(medicine, healingdraught).
  Initially Assert at(herb_patch, wood). Initially Assert itemKind(herb_patch, yarrowbundle).
  Initially Assert habitatSpecies(wood, yarrow). Initially Assert signsOf(wood, yarrow).
  Initially Assert harvestable(herb_patch, yarrow).
  Initially Assert at(wayshrine, porch). Initially Assert shrineOf(wayshrine, veyra).
  Initially Assert restful(hall). Initially Assert restful(ferry).
  Initially Assert mounted(bolt, porch). Initially Assert barrier(bolt, hall). Initially Assert operates(host, bolt).
  Initially Assert closed(hall). Initially Assert trusts(host, party).
  Initially Assert receptive(wildlife, woodcraft).
  Initially Assert discoverable(vault, old_drain).
  Initially Assert armed(dust_trap). Initially Assert hazardPassage(dust_trap, cellar, storeroom).
  Initially Assert hazardEffect(dust_trap, censer_miasma). Initially Assert warning(dust_trap, dust_warning).
  Initially Assert at(dust_trap, cellar).
  Discovery dust_warning "The store threshold releases preservative dust; pin or brace its shutter, or accept its exposure." {
    Source scored_stone "The shutter's scored warning stone" at cellar readable by party.
  }
  Initially Assert discoverable(cellar, dust_warning).
  Rule shutter_blocks when armed(dust_trap) { Assert denied(party, cellar, storeroom). }
  Rule shutter_cleared when not armed(dust_trap) { Retract denied(party, cellar, storeroom). }
  Initially Assert offers(apothecary, rations).

  Topic preparation with apothecary "Ask about the fallen rack and the cellar key" when true {
    Says "'Tamsin came to compare her seeds with the old register. A rack fell while she was below. The brass key is on my counter; take it and unlock the cellar. A delver can work the lock too, but do not mistake an unlocked door for an open one. Bring her up with you. The archive below is older than this shop, and something has nested there.'".
  }
  Topic shelter with host "Ask why the travelers' hall is closed" when closed(hall) {
    Says "'We have little food. I admit only our congregation. I swore to follow the founders, not every stranger's wish. Their charter is here. If it says otherwise, show it to me. The wayfarer stone is open to a company who knows Veyra's observance.'".
  }
  Topic archive_warning with apothecary "Ask what the archive holds" when true {
    Says "'The old families kept seeds and travelers’ names there. A pale hound has made a den among the shelves. It watches visitors from its niche; our last searchers left it alone and came back unharmed. The roots run toward an old drain. Look carefully before you choose a fight.'".
  }
  Observe arrival at street when true "Hearthleaf's painted mortar hangs over a shop door. To one side stands Veyra's roadside house; the road leads out through wooded ground toward an outlying settlement.".
  Observe shop_scene at shop when true "The air smells of cut herbs. A broad counter faces the street door; behind it, an ironbound door opens onto the cellar stair.".
  Observe key_on_counter at shop when at(cabinet_key, shop) "A brass key lies on the counter.".
  Observe medicine_on_counter at shop when at(medicine, shop) "A bottled healing draught stands among the jars.".
  Observe trapped_below at shop when trapped(guest) and able(guest) "From below, someone strikes the cellar ceiling. The apothecary knows who went down there.".
  Observe street_appeal at street when trapped(guest) and able(guest) "A cry carries from beneath the apothecary. A fallen drying rack has pinned someone below.".
  Observe street_refusal at street when closed(hall) "The roadside house’s hall is barred to strangers. Its keeper waits at the charter porch.".
  Observe cellar_scene at cellar when trapped(guest) "Drying frames have collapsed across a seed carrier's legs. The stair returns to the shop; the dry store leads deeper. The rack can be shifted without attacking anyone. Scored stone warns of a dust shutter at the dry-store threshold. Search before crossing; a delver can disarm it, or a leading companion can risk its discharge.".
  Observe cellar_freed at cellar when rescued(guest) and at(guest, cellar) and able(guest) "The fallen frames have been levered aside. The seed carrier is on her feet, leaning against a shelf. She waits for someone to accompany her up the stair.".
  Observe store_scene at storeroom when true "Salt jars stand on dry shelves. Beneath their timber floor, worn stone steps descend into the pilgrims’ archive. A cool draught rises from the older halls.".
  Observe vault_scene at vault when able(sentinel) "Roots have broken the seed-register shelves. A pale cave hound watches from a niche, holding still as the company enters. Root marks cross the masonry toward a low arch.".
  Observe relic_present at vault when at(relic, vault) "Something worked in metal lies beside the seed register.".
  Observe shutter_ready at cellar when armed(dust_trap) "Scored stone and a fine trace of preservative powder mark the dry-store threshold. A careful search may reveal how the shutter releases.".
  Observe vault_quiet at vault when dead(sentinel) "The cave hound lies dead beside its niche. Roots still thrust between the register shelves, and damp curls the edges of the oldest pages.".
  Observe drain_scene at passageway when true "A narrow masonry drain curves toward daylight. Roots make handholds along the last steep stretch. Outside, the path runs past the upper mouth; the company could return by this entrance.".
  Observe porch_scene at porch when true "A weathered charter hangs beside Veyra’s wayfarer stone. A carved cup marks the stone’s shallow offering bowl: food for a stranger, shelter for a traveler. Beyond it, the inner hall smells of woodsmoke.".
  Observe shelter_open at hall when true "Travelers’ pallets surround a common hearth. A kettle hangs above the embers, and there is space to unpack, eat and tend the company’s wounds.".
  Observe valley_road at street when denied(party, street, ferry) "Floodwater cuts the raised road. The bank-side track remains the way around to the outlying settlement.".
  Observe upland_road at street when denied(party, wood, ferry) "A fallen bank cuts the woodland-to-waystation trail. The raised road leaves directly from town; the woodland track is an optional side journey.".
  Observe wood_scene at wood when true "The track follows a wooded bank. Broken stems and animal prints mark the verge; a trail-wise companion may recognize them. Yarrow grows where the sun reaches the path. A narrow animal trail leads into a clearing, while the onward road bends toward the outlying settlement.".
  Observe clearing_scene at clearing when able(wildlife) "A bristled boar roots in the clearing. It lifts its head at the company’s arrival, then paws the ground. There is room to read its movements and approach carefully—or return along the trail.".
  Observe clearing_loss at clearing when dead(wildlife) "The boar lies dead in the clearing. Its hoofprints still cut the ground beside the trail.".
  Observe ferry_scene at ferry when true "A roofed waiting house stands beside the road. Its dry benches and sheltered hearth offer a place to stop, share a meal and recover before the return journey.".
  Rule rain_begins when watch(clock) >= closesAt(rain) { Assert rainArrived(rain). Assert denied(party, wood, ferry). }
  Observe rain_cut at wood when rainArrived(rain) "Rain has made the low onward crossing impassable. You can still return to town or use the discovered drain. The raised road offers another way around from town, where it is passable.".
  Observe rainy_street at street when rainArrived(rain) "Heavy rain pools around the shop threshold. Water beats against the shutters and runs along the street gutters. Beyond the houses, the low paths are dark with mud.".
  Goal false.
}
