Module den "A den in the wild" {
  Description "Something has made its den out in the wild and takes what strays near it. Clear it out, and take what it dragged home.".
  Entity party: group "Your company".
  Place den "The den" is room.
  Measure hoard(entity).
  Relation looted(group). Relation driven(group).
  Person beasts "the beasts" at den {
    Role "a beast". Creature terrain any. Numbers 2.
    State lurking "Eyes shine at the back of {den}. Bones lie scattered in front of it.".
  }
  Action smoke_out(actor: group, spot: place) "Smoke {beasts} out of {den} with green wood" {
    Description "Someone who knows animals can drive them off without a fight. They will not be dead, and you will not be paid for their hides.".
    Requires able(actor) and at(actor, spot) and at(beasts, spot) and not dead(beasts) and capable(actor, woodcraft).
    Time 1.
    On success { Assert driven(beasts). Assert peaceable(beasts). Retract at(beasts, spot). }
    Result "You build a smoky fire of green wood upwind of {den}. After an hour {beasts} break out of the far side and are gone up the hill.".
  }
  Action plunder(actor: group, spot: place) "Search {den} for what was dragged in" {
    Requires able(actor) and at(actor, spot) and (dead(beasts) or driven(beasts)) and not looted(actor).
    Time 2.
    On success { Increase quantity(actor, gold) by hoard(beasts). Assert looted(actor). }
    Result "Among the bones are coins and a broken buckle: {hoard(beasts)} coin in all.".
  }
  Observe cleared at den when dead(beasts) "{den} is quiet now. Flies settle on what is left.".
  Observe emptied at den when driven(beasts) "{den} is empty and still smells of smoke. Tracks lead away up the hill.".
  Entity rumour: fact "Folk who go out to {den} come back short of a sheep or a dog, or don't come back. Something has made its den there.".
  Initially Assert established(rumour).
  Objective clear when knows(party, rumour) and not dead(beasts) and not driven(beasts) "{beasts} have a den at {den}.".
  Goal dead(beasts) or driven(beasts).
}
