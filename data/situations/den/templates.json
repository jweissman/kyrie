{
  "den": {
    "__no_id": true,
    "terrain": "forest",
    "name": "A den in the wild",
    "_family": "=lookup(denFamily, #terrain)",
    "_species": "=#_family == 'animal' ? lookup(denSpecies, #terrain) : lookup(denPeople, #_family)",
    "creatures": [],
    "actors": {
      "order": []
    },
    "casting": "=defined('beast') ? gen(den_species_casting) : gen(den_casting)",
    "labels": "=defined('beast') ? gen(den_species_labels) : gen(den_labels)",
    "initial": "=concat(gen(den_hoard))",
    "_lair": "=lookup(denLair, #_family)",
    "facts": "=concat(gen(den_nature), gen(den_lair), gen(den_leader_at), gen(den_find_a), gen(den_find_b), gen(den_marvel))",
    "outcomes": [
      {
        "id": "cleared",
        "predicate": "dead(beasts) or driven(beasts) or laid(beasts)"
      }
    ]
  },
  "den_casting": {
    "__no_id": true,
    "beasts": "=gen(den_beast)",
    "leader": "=gen(den_leader)"
  },
  "den_beast": {
    "__no_id": true,
    "role": "=#_family == 'animal' ? lookup(denRole, #_species) : 'an outlaw'",
    "raceId": "=#_species",
    "classId": "=#_family == 'animal' ? nihil : lookup(denCalling, #_family)",
    "count": 2
  },
  "den_labels": {
    "__no_id": true,
    "beasts": "=lookup(denLabel, #_family)"
  },
  "den_hoard": {
    "__no_id": true,
    ">name": "hoard",
    "args": [
      "beasts"
    ],
    "value": "=2d6 + 2"
  },
  "den_species_casting": {
    "__no_id": true,
    "beasts": "=gen(den_species_beast)",
    "leader": "=gen(den_species_leader)"
  },
  "den_species_beast": {
    "__no_id": true,
    "role": "=#beastRole",
    "raceId": "=#beast",
    "count": "=#beastCount",
    "aspect": "=defined('beastAspect') ? #beastAspect : ''",
    "template": "=defined('beastTemplate') ? #beastTemplate : ''",
    "variations": "=defined('beastVariations') ? #beastVariations : nihil"
  },
  "den_species_labels": {
    "__no_id": true,
    "beasts": "=#beastLabel"
  },
  "den_nature": {
    "__no_id": true,
    ">name": "=defined('beastNature') ? #beastNature : (#_family == 'animal' ? 'wild' : 'stubborn')",
    "args": [
      "beasts"
    ]
  },
  "den_leader": {
    "__no_id": true,
    "role": "a captain of the outlaws",
    "raceId": "=#_species",
    "classId": "warrior",
    "level": 3
  },
  "den_species_leader": {
    "__no_id": true,
    "role": "=defined('beastRole') ? #beastRole : 'a beast'",
    "raceId": "=#beast",
    "template": "=defined('beastTemplate') ? #beastTemplate : ''",
    "variations": "=defined('beastTemplate') ? nihil : (hasValue(denLeaderBeast, #beast) ? concat('pack_leader') : nihil)"
  },
  "den_lair": {
    "__no_id": true,
    ">name": "lairkind",
    "args": "=concat('beasts', #_lair)"
  },
  "den_find_a": {
    "__no_id": true,
    ">name": "at",
    "args": "=concat('find_' + lookup(denFindCommon, #_family), 'den')"
  },
  "den_find_b": {
    "__no_id": true,
    ">name": "at",
    "args": "=concat('find_' + lookup(denFindFine, #_family), 1d6 > 4 ? 'den' : 'gone')"
  },
  "den_marvel": {
    "__no_id": true,
    ">name": "marvelled",
    "args": "=concat('beasts', lookup(denMarvel, #terrain))"
  },
  "den_leader_at": {
    "__no_id": true,
    ">name": "at",
    "args": "=concat('leader', #_lair == 'l_lead' ? 'den' : 'gone')"
  }
}
