{
  "den": {
    "__no_id": true,
    "terrain": "forest",
    "name": "A den in the wild",
    "_family": "=lookup(denFamily, #terrain)",
    "_request": "=gen(den_request)",
    "_creature": "=gen(creature, #_request)",
    "creatures": [],
    "actors": {
      "order": []
    },
    "casting": "=defined('beast') ? gen(den_species_casting) : gen(den_casting)",
    "labels": "=defined('beast') ? gen(den_species_labels) : gen(den_labels)",
    "initial": "=concat(gen(den_hoard))",
    "facts": "=concat(gen(den_nature))",
    "outcomes": [
      {
        "id": "cleared",
        "predicate": "dead(beasts) or driven(beasts) or laid(beasts)"
      }
    ]
  },
  "den_casting": {
    "__no_id": true,
    "beasts": "=gen(den_beast)"
  },
  "den_beast": {
    "__no_id": true,
    "role": "=#_family == 'animal' ? 'a ' + dig(#_creature, 'body') : 'an outlaw'",
    "parameters": "=gen(den_constraints)",
    "count": 2
  },
  "den_constraints": {
    "__no_id": true,
    "family": "=#_family",
    "body": "=dig(#_creature, 'body')",
    "raceId": "=dig(#_creature, 'raceId')"
  },
  "den_labels": {
    "__no_id": true,
    "beasts": "=lookup(denLabel, #_family)"
  },
  "den_hoard": {
    "__no_id": true,
    ">name": "hoard",
    "args": [
      "beasts"
    ],
    "value": "=2d6 + 2"
  },
  "den_request": {
    "__no_id": true,
    "terrain": "=#terrain",
    "family": "=#_family"
  },
  "den_species_casting": {
    "__no_id": true,
    "beasts": "=gen(den_species_beast)"
  },
  "den_species_beast": {
    "__no_id": true,
    "role": "=#beastRole",
    "raceId": "=#beast",
    "count": "=#beastCount",
    "aspect": "=defined('beastAspect') ? #beastAspect : ''",
    "template": "=defined('beastTemplate') ? #beastTemplate : ''"
  },
  "den_species_labels": {
    "__no_id": true,
    "beasts": "=#beastLabel"
  },
  "den_nature": {
    "__no_id": true,
    ">name": "=defined('beastNature') ? #beastNature : (#_family == 'animal' ? 'wild' : 'stubborn')",
    "args": [
      "beasts"
    ]
  }
}
