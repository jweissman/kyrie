Module toll_customs "Customs-men on the road" {
  Description "A lord's customs-men, keeping his toll on the road: a small fee, collected by right, and the law behind it. They pay for their bread at the inn, and take a cartload at a time, so there is less for everyone else. Run their toll or raise a hand to them, and the settlement they answer to will not serve you.".
  Entity party: group "Your company".
  Place post "The road they keep" is room.
  Place market "The settlement they answer to" is room.
  Entity provider: group "Who sells them bread".

  Person chief "the toll-reeve" at post {
    Role "the lord's toll-reeve". Ancestry human. Calling warrior. Level 2.
    State watching "A man in a good grey coat sits at a trestle by a bar across the road, with a ledger and a strongbox.".
  }
  Person keepers "the customs-men" at post {
    Role "the lord's customs-men". Ancestry human. Calling warrior. Level 1. Numbers 2.
    Called "Fenn", "Garrick".
    Uses go, assail. Plans 6 steps.
    State idle "Two men in the lord's livery lean on the bar across the road.".
  }
  Initially Assert serves(keepers, chief). Initially Assert holds(chief, post). Initially Assert posts(keepers, chief).
  Initially Assert tolls(keepers, post).
  Initially Set quantity(chief, rations) to 4.

  // The toll: three coin, by right, written in the ledger. Running it is breaking the lord's law.
  Relation stopped(group).
  Rule stops when at(party, post) and tolls(keepers, post) and able(keepers) and not tolerates(keepers, party)
    and not stopped(party) and not hostile(chief, party)
    says "The bar stays down. 'The lord's toll,' says the reeve, dipping his pen. 'Three coin. Names?'" {
    Assert stopped(party).
  }
  Action pay_toll(actor: group, site: place) "Pay the lord's toll, three coin" {
    Description "Three coin, written in the ledger. The bar goes up.".
    Requires able(actor) and company(actor) and at(actor, site) and tolls(keepers, site) and at(keepers, site)
      and able(keepers) and not tolerates(keepers, actor) and quantity(actor, gold) >= 3.
    On success { Decrease quantity(actor, gold) by 3. Increase quantity(chief, gold) by 3. Assert tolerates(keepers, actor).
      Assert tolerates(chief, actor). }
    Result "The reeve writes you down, sands the ink, and nods to Fenn, who lifts the bar.".
  }
  // Running the toll, or turning on the lord's men, puts the company outside the law the settlement keeps.
  Rule ran_toll when stopped(party) and not at(party, post) and not tolerates(keepers, party) and tolls(keepers, post) {
    Retract stopped(party). Assert hostile(chief, party). Assert refusesService(provider, party).
  }
  Rule paid_once when tolerates(keepers, party) and not at(party, post) {
    Retract tolerates(keepers, party). Retract tolerates(chief, party). Retract stopped(party).
  }
  Rule outlawed when (routed(chief) or not able(chief) or routed(keepers)) and not refusesService(provider, party)
    says "Word goes down the road ahead of you: the lord's toll-house has been attacked." {
    Assert refusesService(provider, party). Assert hostile(chief, party).
  }
  Rule set_on when at(party, post) and hostile(chief, party) and able(keepers) and not routed(keepers) and tolls(keepers, post)
    says "'Outlaws!' The customs-men draw their swords." {
    Assert assails(keepers, party).
  }
  Observe outlawed_at_inn at market when refusesService(provider, party) "The door of the inn is barred against you, and someone inside says the lord's name loudly.".

  // And the lord answers. Riders go out to the settlement his toll answers to and wait there for whoever did it: they
  // warn, and take the lord's fine if it is paid; otherwise they take the company, or try to.
  Place hall "The lord's hall" is room.
  Person riders "the lord's riders" at hall {
    Role "the lord's riders, sent after whoever turned on his toll". Ancestry human. Calling warrior. Level 2. Numbers 3.
    Called "Aldred", "Wace", "Hubert".
    Temperament territorial.
    Warns "Three riders in the lord's colours are waiting on the green. Their captain looks at you, and at a paper in his hand, and back at you. 'In the lord's name,' he says. 'Twenty coin for his toll-house, or you come with us.'".
  }
  Initially Assert serves(riders, chief).
  Relation sent().
  Rule sends when hostile(chief, party) and not sent() says "Behind you, word is going along the road: the lord is sending riders out to {market}, asking after a company that turned on his toll." {
    Assert sent(). Retract at(riders, hall). Assert at(riders, market). Set patience(riders) to 2.
  }
  Action pay_fine(actor: group, site: place) "Pay the lord's fine, twenty coin" {
    Description "The lord's riders take twenty coin for his toll-house, write you down, and go home; the settlement serves you again.".
    Requires able(actor) and company(actor) and at(actor, site) and at(riders, site) and able(riders) and hostile(chief, actor)
      and quantity(actor, gold) >= 20.
    On success { Decrease quantity(actor, gold) by 20. Increase quantity(chief, gold) by 20. Retract hostile(chief, actor).
      Assert tolerates(riders, actor). Retract refusesService(provider, actor). Retract warned(riders, actor). Retract at(riders, site).
      Assert at(riders, hall). }
    Result "The captain counts it twice, writes in his book, and the riders turn their horses for home. Behind them the door of the inn is unbarred.".
  }

  // Bread, paid for: they take a cartload when they run low, and there is that much less in the inn.
  Rule eats when untilLight(clock) == 1 and quantity(chief, rations) >= 1 and able(keepers) { Decrease quantity(chief, rations) by 1. }
  Rule buys when untilLight(clock) == 2 and quantity(chief, rations) <= 1 and quantity(provider, rations) >= 3 and able(keepers) {
    Decrease quantity(provider, rations) by 3. Increase quantity(chief, rations) by 3. Increase quantity(provider, gold) by 6.
  }

  Rule broken when (not able(chief) or routed(chief)) and tolls(keepers, post) {
    Retract tolls(keepers, post). Retract holds(chief, post).
  }
  Goal not tolls(keepers, post).
}
