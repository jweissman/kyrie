Module gate "The last sea-gate" {
  Description "The fen of Iscoed lies lower than the sea, and the Water-Wardens' sea-gates have kept it dry since before there were Rìs. The last of them, at {hamlet}, no longer shuts. At the spring tide the sea will come over into the fen, and {hamlet} and its eel-weirs with it. The reeve at {town} has posted thirty crowns.".
  Entity party: group "Your company".
  Place town "The town" is settlement.
  Place green "The green" is room.
  Place hamlet "The hamlet" is settlement.
  Place hamletgreen "The hamlet's green" is room.
  Relation mended(group). Relation flooded(group). Relation gateClaimed(group). Relation gateTried(group).

  Entity failing: fact "The last of the Water-Wardens' sea-gates, at {hamlet}, no longer shuts: at the spring tide, six days off, the sea will come over into the fen. The reeve at {town} pays thirty crowns to have it mended.".
  Initially Assert established(failing). Initially Assert established(tide).
  Entity cut: fact "The pin that held the sea-gate's pawl was sawn through, not worn: someone wanted the gate at {hamlet} to stand open.".
  Entity tide: fact "The spring tide comes six days from your coming to Iscoed, at the full moon.".
  // What the cold pans' module (data/goings-on/iscoed-pans, installed before this one) keeps of the cut: clear once the
  // gate is wound shut, the sea off it (ST-04); and what came of the fuel boat, for the reeve's tally and Ifan.
  Entity cutclear: fact "The cut clear". Entity poledword: fact "The fuel boat poled down the cut".
  Entity saltwhole: fact "The whole load to the salter". Entity saltshared: fact "The load shared".
  Entity saltlost: fact "The brine spoiled".
  Relation saltWritten(group).

  Kind pawl_kind "the sea-gate's pawl" is gear worth 6 weighing 6 described "A tooth of bronze-shod iron as long as a forearm, curved to fit a ratchet, with a hole through its heel where a pin went. The Water-Wardens' mark, a wave inside a ring, is cut into its face.".
  Place bank "the sea-bank at {hamlet}" is room within hamlet at 4, 0.
  Place gatehouse "the Wardens' gatehouse" is room within hamlet at 5, 0 indoors.
  Place well "the gate-well, under the gatehouse" is room within hamlet at 5, 1.
  Passage bank_path "the path along the sea-bank" is passage between hamletgreen and bank.
  Passage gate_door "the gatehouse door" is door between bank and gatehouse.
  Passage well_ladder "the iron ladder down the gate-well" is ladder between gatehouse and well.
  Initially Assert unlit(well).
  Item pawl "the sea-gate's pawl" is pawl_kind at well hidden until pawl_found.

  Person reeve "Reeve Annis Talfryn" at green { Role "the reeve of Iscoed, who keeps the march and the sea-gates for the Rì". Pronouns she. Peaceable. Manner grim.
    // Bran let out quietly at the counter, not before her: she has heard, and says so to the one who did it, until told
    // how (the drove-response audit's still-open, CL-32).
    Greets "The reeve looks up. 'The Brynach man is out,' she says. 'Mardle says his count was wrong. He did not say how you knew.'" when knows(party, freedword) and not knows(party, ruledword) and not knows(party, clerkkept) and not knows(party, clerkgone) and not mardleTold(party).
    Greets "The reeve looks up. 'Twelve crowns, Mardle tells me,' she says. 'I would sooner have heard it from you.'" when knows(party, clerkkept) and not mardleTold(party).
    Greets "The reeve looks up. 'Mardle is packing his house,' she says. 'I hear you read his book for him.' She nearly smiles." when knows(party, clerkgone) and not knows(party, ruledword) and not mardleTold(party). }
  Thing notice "the reeve's notice" at green {
    State posted "A notice in a clerk's hand is nailed to the post by the well: THE SEA-GATE AT GATESEND IS TO BE MENDED BEFORE THE SPRING TIDE. THIRTY CROWNS OF THE REEVE TO WHOEVER MENDS IT. A. TALFRYN, REEVE.".
  }
  // The notice is a lead, not the aim (HP-01): read, it says who to ask; the gate is an aim once the reeve is asked
  // (reeve_gate), and the lead's knowing is let go then, as a job's is when it is paid. The green had given two
  // stories' aims at once on the drove road, before anyone there had asked the company for anything.
  Entity gate_posted: fact "A notice on the well-post at {town}, under the reeve's seal: thirty crowns to whoever mends the sea-gate at {hamlet}. Reeve Annis Talfryn is on the green.".
  Initially Assert askedOf(gate_posted, reeve).
  Observe notice_read at green as sign when not mended(party) and not flooded(party) and not knows(party, failing) and not knows(party, gate_posted) "A notice is nailed to the post by the well, newer than the others, the reeve's seal at its foot." teaches gate_posted.
  Observe bank_scene at bank when not mended(party) and not flooded(party) "The sea-bank runs straight as a rule between the grey water and the green fen, a man's height above both. Where it meets the river stands a squat stone gatehouse, and from under it, even now at the ebb, the sea runs into the fen with a sound like a mill-race.".
  Observe bank_mended at bank when mended(party) "The sea-bank runs straight between the grey water and the green fen. Under the gatehouse the water lies still.".
  Observe bank_flooded at bank when flooded(party) "The fen behind the sea-bank is a sheet of grey water to the ridge, with the roofs of {hamlet} standing out of it and gulls on the ridge-trees.".
  Observe gatehouse_scene at gatehouse when not mended(party) and (not at(conger, well) or not able(conger)) "Inside, a windlass of black oak as thick as a man fills the room, its drum wound with chain that goes down through a slot in the floor. A ratchet ring of bronze is set round its axle. Over the door a wave inside a ring is cut in the lintel.".
  // At night, the conger in the well below is heard from here, before anyone goes down (CP-18); killed, it is heard
  // no more (GR-04).
  Observe gatehouse_night at gatehouse when not mended(party) and at(conger, well) and able(conger) "Something big is feeding in the gate-well: down the slot in the floor its water slaps and heaves, though the tide has not turned. Over it a windlass of black oak as thick as a man fills the room, its drum wound with chain that goes down through the slot. A ratchet ring of bronze is set round its axle. Over the door a wave inside a ring is cut in the lintel.".
  // The socket is empty only until the pawl is set in it (cold play 4, CL-47's 30: "an empty socket" after winding).
  // And said as it is to a company holding the pawl, that has tried it (OR-252: "an empty socket" to one with the pawl
  // in hand, twice tried).
  Observe socket_empty at gatehouse when not mended(party) and not holding(party, pawl_kind) "Beside the ratchet ring is an empty socket, cut for something the shape of a tooth.".
  Observe socket_held at gatehouse when not mended(party) and holding(party, pawl_kind) and not gateTried(party) "Beside the ratchet ring is the socket the pawl you carry was cut for, empty.".
  Observe socket_tried at gatehouse when not mended(party) and holding(party, pawl_kind) and gateTried(party) "The pawl's socket beside the ratchet ring is still empty, its rim scraped bright where the pawl slipped out of it.".
  Observe gatehouse_wound at gatehouse when mended(party) "Inside, a windlass of black oak as thick as a man fills the room, its drum wound tight with chain that goes down through a slot in the floor. A ratchet ring of bronze is set round its axle, and the pawl stands in its socket against a tooth of it. Over the door a wave inside a ring is cut in the lintel.".
  Observe well_scene at well when true "The iron rungs end in silt. Water stands knee-deep, cold and moving, and the gate's great chain goes down past you into the dark to the sluice below.".
  // What comes up the chain at night (CP-18: the warrior's route met no danger in 34 turns, the gate-well only dark): a
  // conger out of the sluice, feeding in the well's moving water from dark to first light, gone back down by day. Heard
  // from the gatehouse before anyone goes down; in the well it warns, and comes at whoever stays to search the silt.
  // One, a lone company's match, as the undertown's packs are (src/world/region-undertown.ts's values).
  Person conger "the conger in the gate-well" nowhere {
    Role "a sea-eel thicker than a man's arm and longer than he is tall, come up the gate's chain from the sluice to feed". Species eel. Numbers 1. Level 5. Temperament territorial. Lair well.
    Warns "The water about your knees heaves. A grey back as long as you are rolls past the chain, turns, and comes round again, slower.".
    Comes "The conger comes at you out of the silt, its jaws wide.".
  }
  Initially Set encounterXp(conger) to 60.
  Rule conger_rises when not at(conger, well) and able(conger) and not at(party, well) and (hour(clock) >= 21 or hour(clock) < 6) { Assert at(conger, well). }
  Rule conger_sinks when at(conger, well) and not at(party, well) and hour(clock) >= 6 and hour(clock) < 21 { Retract at(conger, well). }
  Discovery fault_found "The great windlass of the sea-gate at {hamlet} has lost its pawl, the iron tooth that holds it: without it the gate cannot be wound shut and held." {
    Found by searching gatehouse "The socket beside the ratchet is empty, and its pin-holes are bright. The pawl that should stand in it, the iron tooth that holds the drum, is gone. Whatever held it, it went down: there are fresh scrapes on the slot's edge where something heavy fell.".
  }
  Discovery pawl_found "The sea-gate's pawl lies at the bottom of the gate-well, in the silt." {
    Found by searching well "Your foot finds it before your hands do: under the silt, a curved bar of iron as long as your forearm, bronze-shod, the wardens' wave cut in its face.".
  }
  Observe pin_seen at gatehouse as sign when holding(party, pawl_kind) and not knows(party, cut) "Turning the pawl over in the light at the door, you see that the stub of its pin is bright and square: sawn through, not worn." teaches cut.

  Topic reeve_gate with reeve "Ask the reeve about the sea-gate at Gatesend" when not mended(party) and not flooded(party) once {
    Says "'It will not shut,' says the reeve. 'It has not shut since the new moon. I have written to the Rì's engineers in Dun Rìerdan, and they will come in the summer, with a bill, and the fen will have been sea since the spring.' She looks at you as if measuring rope. 'Six days to the spring tide. Thirty crowns. Nobody in Gatesend will go into the gatehouse now, with the sea running under it like a mill-race.'".
    On discuss { Assert knows(actor, failing). Assert knows(actor, tide). Retract knows(actor, gate_posted). }
  }
  Action wind_gate(actor: group, site: place) "Set the pawl in its socket and wind the sea-gate shut" {
    Time 1 hours.
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, gatehouse) and holding(actor, pawl_kind)
      and not mended(actor) and not flooded(actor).
    Resolve check(actor, brawn, dc_fair).
    On success { Spend pawl_kind from actor. Assert mended(actor). Assert knows(actor, shut). Assert knows(actor, cutclear). }
    On failure { Assert gateTried(actor). }
    Result "The pawl drops into its socket with a sound like a bell. Then the long work: the windlass bars, a turn and a rest and a turn, the chain coming up wet out of the slot link by link, the pawl clacking over the ratchet. Below, at last, something enormous seats itself in stone, and the mill-race sound stops.".
    // With more than one on the bars, it is not one pair of arms that fails (cold play 5, CL-39's 11: Gesk hauling
    // beside her, the failure still said "more weight than yours").
    Otherwise "The drum will not come round, though every one of you is on the bars. You hang there until your arms shake, and the chain slips back a link at a time. It wants more weight than you have between you, or a fresh try." when count(memberOf(?m, party)) > 1.
    Otherwise "The drum will not come round. You hang on the bar until your arms shake and the chain slips back a link at a time. It wants more weight than yours, or a fresh try.".
  }
  // The wardens' own way, for one without the arms for it: at low water the sea is off the gate, and it comes round
  // to anyone who knows the hour (the tide-table) and holds the pawl, as it came round for the wardens.
  Action wind_at_ebb(actor: group, site: place) "Wind the sea-gate shut at low water, as the wardens' slate says" {
    Time 30 minutes.
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, gatehouse) and holding(actor, pawl_kind)
      and knows(actor, tides) and not mended(actor) and not flooded(actor)
      and ((hour(clock) >= 4 and hour(clock) < 7) or (hour(clock) >= 16 and hour(clock) < 19)).
    Result "With the sea gone out from under it, the drum comes round as easily as a well-winch. The pawl drops in with a sound like a bell, and clacks over the ratchet tooth by tooth, and below, something enormous seats itself in stone. The mill-race sound stops.".
    On success { Spend pawl_kind from actor. Assert mended(actor). Assert knows(actor, shut). Assert knows(actor, cutclear). }
  }
  // The claim, and with it what came of the cold pans' fuel boat (data/goings-on/iscoed-pans; ST-04): which pans burned
  // is the salt the reeve writes into her tally before it goes north (what the Exchange reads of a tally past the march
  // is its own: WD-16).
  Topic claim with reeve "Tell the reeve the sea-gate at Gatesend shuts" when mended(party) and not gateClaimed(actor) and not knows(actor, saltwhole) and not knows(actor, saltshared) and not knows(actor, saltlost) once {
    Says "The reeve rides out to see for herself before she pays, and stands on the sea-bank a long while with the wind in her cloak. Then thirty crowns, counted out on the gatehouse sill. 'The fen owes you,' she says. 'So do I. When the tally goes up to the Tower of the Scales this quarter, I will need someone to carry it who knows what the sea costs.'".
    On discuss { Increase quantity(actor, gold) by 30. Assert gateClaimed(actor). Give tally_case to actor. Assert knows(actor, road_north). }
  }
  Topic claim_whole with reeve "Tell the reeve the sea-gate at Gatesend shuts" when mended(party) and not gateClaimed(actor) and knows(actor, saltwhole) once {
    Says "The reeve rides out to see for herself before she pays, and stands on the sea-bank a long while with the wind in her cloak. Then thirty crowns, counted out on the gatehouse sill. 'The fen owes you,' she says. 'So do I. When the tally goes up to the Tower of the Scales this quarter, I will need someone to carry it who knows what the sea costs.' Before she seals the tally she adds a line to it in her own hand, reading it out as she writes: 'Salt of {town}: one salter's pans, a month's boiling; Ffion Wyn's, none.' She seals it. 'A short march. The Exchange will price Iscoed's jar as dear as ever, and thank me for it.'".
    On discuss { Increase quantity(actor, gold) by 30. Assert gateClaimed(actor). Give tally_case to actor. Assert knows(actor, road_north). Assert saltWritten(actor). }
  }
  Topic claim_shared with reeve "Tell the reeve the sea-gate at Gatesend shuts" when mended(party) and not gateClaimed(actor) and knows(actor, saltshared) once {
    Says "The reeve rides out to see for herself before she pays, and stands on the sea-bank a long while with the wind in her cloak. Then thirty crowns, counted out on the gatehouse sill. 'The fen owes you,' she says. 'So do I. When the tally goes up to the Tower of the Scales this quarter, I will need someone to carry it who knows what the sea costs.' Before she seals the tally she adds a line to it in her own hand, reading it out as she writes: 'Salt of {town}: two salters' pans, a fortnight's boiling each, and every raker paid.' She seals it. 'Less salt than a month of the one, and more mouths fed. The Exchange sets its price on the salt, not the mouths.'".
    On discuss { Increase quantity(actor, gold) by 30. Assert gateClaimed(actor). Give tally_case to actor. Assert knows(actor, road_north). Assert saltWritten(actor). }
  }
  Topic claim_lost with reeve "Tell the reeve the sea-gate at Gatesend shuts" when mended(party) and not gateClaimed(actor) and knows(actor, saltlost) once {
    Says "The reeve rides out to see for herself before she pays, and stands on the sea-bank a long while with the wind in her cloak. Then thirty crowns, counted out on the gatehouse sill. 'The fen owes you,' she says. 'So do I. When the tally goes up to the Tower of the Scales this quarter, I will need someone to carry it who knows what the sea costs.' Before she seals the tally she adds a line to it in her own hand, reading it out as she writes: 'Salt of {town}: the brine spoiled for want of fuel, the season lost.' She seals it without looking at you. 'The Exchange will set Iscoed's price on what is left, and what is left is dear.'".
    On discuss { Increase quantity(actor, gold) by 30. Assert gateClaimed(actor). Give tally_case to actor. Assert knows(actor, road_north). Assert saltWritten(actor). }
  }
  // The reason to go north: the reeve's quarter-tally for the Exchange in Dun Rìerdan, carried by one who knows what
  // the sea costs (see data/goings-on/rierdan-scales).
  Entity road_north: fact "The reeve's quarter-tally goes north up the salt road to the Exchange in the Tower of the Scales, in Dun Rìerdan, where the salt price of the realm is set.".
  Entity tally_kept: fact "".
  Item tally_case "the reeve's quarter-tally, in a scroll-case" is scrollcase at gatehouse hidden until tally_kept.
  // The pans settled after the claim, while the tally is still in hand: she has it back to write the salt in.
  Rule salt_whole heard at green when at(party, green) and holding(party, scrollcase) and knows(party, saltwhole) and at(reeve, green) and not saltWritten(party) says "The reeve has the tally back off you a moment and adds a line in her own hand, reading it out as she writes: 'Salt of {town}: one salter's pans, a month's boiling; Ffion Wyn's, none.' She gives it back. 'A short march. The Exchange will price Iscoed's jar as dear as ever, and thank me for it.'" { Assert saltWritten(party). }
  Rule salt_shared heard at green when at(party, green) and holding(party, scrollcase) and knows(party, saltshared) and at(reeve, green) and not saltWritten(party) says "The reeve has the tally back off you a moment and adds a line in her own hand, reading it out as she writes: 'Salt of {town}: two salters' pans, a fortnight's boiling each, and every raker paid.' She gives it back. 'Less salt than a month of the one, and more mouths fed. The Exchange sets its price on the salt, not the mouths.'" { Assert saltWritten(party). }
  Rule salt_lost heard at green when at(party, green) and holding(party, scrollcase) and knows(party, saltlost) and at(reeve, green) and not saltWritten(party) says "The reeve has the tally back off you a moment and adds a line in her own hand, reading it out as she writes: 'Salt of {town}: the brine spoiled for want of fuel, the season lost.' She gives it back without looking at you. 'The Exchange will set Iscoed's price on what is left, and what is left is dear.'" { Assert saltWritten(party). }
  Objective north_aim when knows(party, road_north) and holding(party, scrollcase) toward town "Take the reeve's tally north up the salt road to the Tower of the Scales in Dun Rìerdan.".
  // What the drove's inquiry found, for the reeve to hear (data/goings-on/iscoed-drove): Mardle told the company to
  // trouble her with nothing, and she had no word to say of it (the second cold play, CL-03); not once she has heard it
  // herself, on the green (ruledword: ST-02's collision).
  Entity drovedrowned: fact "The drowned four". Entity forged: fact "The count written over". Entity freedword: fact "Bran out".
  Entity clerkgone: fact "Mardle shown up". Entity clerkkept: fact "Mardle paid off". Entity ruledword: fact "Ruled before the reeve".
  Relation mardleTold(group).
  Topic reeve_mardle with reeve "Tell the reeve how Mardle counts the droves" when knows(actor, freedword) and (knows(actor, drovedrowned) or knows(actor, forged)) and not knows(actor, ruledword) and not mardleTold(actor) once {
    Says "The reeve hears it out without a word. 'Third drove this year,' she says at last. 'I had wondered why the Brynach men stopped selling here.' She writes something on her tablet and underlines it. 'He keeps the Rì's book, and I keep the Rì's march. I will have the book off him by the quarter-day.'".
    On discuss { Assert mardleTold(actor). }
  }
  // Shown the sawn pin, she comes out to the gate herself, and is there when Ifan's boat comes (ST-03's collision).
  Relation reeveWarned(group). Relation reeveSaw(group).
  Topic reeve_cut with reeve "Show the reeve the pawl's sawn pin" when knows(actor, cut) once {
    Says "The reeve's face does not change, but she goes very still. 'Sawn,' she says. 'Then someone wants the fen wet, or the gate open. The cut runs under the bank to the sea, and a boat could come and go by it at night with no customs-man the wiser.' She looks toward the waterfront. 'Keep that to yourself until I know who. I will be out at the gate myself before the tide.'".
    On discuss { Assert reeveWarned(actor). }
  }
  Rule floods when not mended(party) and not flooded(party) and watch(clock) >= 864 says "The spring tide comes in on the full moon, high and grey, and does not stop at the sea-bank. By morning the fen behind {hamlet} is under water to the ridge." {
    Assert flooded(party). Assert stale(failing).
  }
  Milestone m_mended "shut the last of the Water-Wardens' sea-gates" worth 200 when mended(party).
  Milestone m_cut "found that the sea-gate's pawl had been sawn loose" worth 50 when knows(party, cut).
  Objective gate_aim when knows(party, failing) and not knows(party, fault_found) and not knows(party, pawl_found) and not mended(party) and not flooded(party) toward gatehouse by bank "Find out why the sea-gate at {hamlet} will not shut, before the spring tide.".
  Objective gate_pawl when knows(party, fault_found) and not knows(party, pawl_found) and not mended(party) and not flooded(party) toward well by gatehouse "Find the sea-gate's lost pawl: something heavy went down the gate-well under the gatehouse.".
  Objective gate_take when knows(party, pawl_found) and not holding(party, pawl_kind) and not mended(party) and not flooded(party) toward well "Bring the sea-gate's pawl up out of the gate-well.".
  Objective gate_wind when holding(party, pawl_kind) and not mended(party) and not flooded(party) toward gatehouse "Take the pawl to the windlass at {hamlet}, and wind the sea-gate shut.".
  Objective gate_claim when mended(party) and not gateClaimed(party) toward reeve "Tell the reeve at {town} that the sea-gate shuts.".
  Rule word_old when mended(party) and not stale(failing) { Assert stale(failing). }
  // And what was found of the fault is over with it, the pawl's lying in the silt once it is lifted, and the spring
  // tide once it has come (FH-25: the Notes had kept all three after the gate was wound shut).
  Rule fault_old when mended(party) and not stale(fault_found) { Assert stale(fault_found). }
  Rule pawl_old when (holding(party, pawl_kind) or mended(party)) and not stale(pawl_found) { Assert stale(pawl_found). }
  Rule tide_old when watch(clock) >= 864 and not stale(tide) { Assert stale(tide). }
  // What the company did, for those who live under the gate to answer (the weir's Nest: data/origins/weir), and the
  // hamlet itself, the first time the company comes down to it after (cold play 5's one change: nobody remarked it).
  Entity shut: fact "The sea-gate at {hamlet} shuts again: the company wound it shut before the spring tide.".
  Relation thanked(group).
  Rule hamlet_thanks when mended(party) and at(party, hamletgreen) and not thanked(party) says "Doors are open all along the lane. Someone has chalked a wave inside a ring on the well-post, and an old man you have never met takes your hand in both of his and says nothing at all." { Assert thanked(party). }
  // The sawn pin is a question: who wants the gate open? Whoever cut it comes and goes under the gatehouse, and the
  // store behind the chain answers it (cold play 5's 8, cold play 4's 29: the pin led nowhere).
  Objective gate_cutter when knows(party, cut) and not knows(party, store_found) and not letThrough(party) and not turnedBack(party) and not ifanHeard(party) and not flooded(party) toward gallery by well "Find out who sawed through the pawl's pin, and why they want the sea-gate open.".

  // ── The lower works: under the gate-well, the Water-Wardens' sluice gallery, their tide-room, a store the smugglers
  // keep behind the chain, and past the lower sluice door the wardens' undercroft. The door opens with the wardens'
  // sluice-key and only at low water, when the sea's weight is off it; the tide-room has both the key and the table
  // that says when. The eels in the gallery hunt the running water, and lie stranded on the silt at the ebb.
  Relation offstage(entity).
  Place gallery "the sluice gallery" is room within hamlet at 5, 2.
  Place tideroom "the wardens' tide-room" is room within hamlet at 6, 2.
  Place store "the smugglers' store, behind the chain" is room within hamlet at 4, 2.
  Place undercroft "the wardens' undercroft" is room within hamlet at 5, 3.
  Initially Assert unlit(gallery). Initially Assert unlit(tideroom). Initially Assert unlit(store). Initially Assert unlit(undercroft).
  Passage well_culvert "the culvert along the chain" is passage between well and gallery taking 10 minutes.
  Passage tide_arch "a low arch out of the water" is doorway between gallery and tideroom.
  Passage store_ledge "the ledge behind the chain" is crawl between gallery and store hidden until store_found.
  Passage lower_door "the lower sluice door" is door between gallery and undercroft opening when holding(party, sluice_key_kind) and ((hour(clock) >= 4 and hour(clock) < 7) or (hour(clock) >= 16 and hour(clock) < 19)) "The lower sluice door is bronze, as high as two men, and it does not move: there is a keyhole in its face the size of a thumb, and the whole weight of the sea behind it.".
  Kind sluice_key_kind "the wardens' sluice-key" is gear worth 10 weighing 1 described "A key of green bronze as long as your hand, its bow a wave inside a ring, its bit cut in five steps like a stair.".
  Kind tide_table_kind "the wardens' tide-table" is document teaching tides worth 4 weighing 1 described "A slate as broad as a tray, framed in bronze, ruled into the moon's days. Against each is cut the hour the water stands lowest at the sea-gate: before dawn and before dusk, a little later every day.".
  Kind ledger_kind "a smuggler's tally" is document teaching ledger worth 0 weighing 1 described "A strip of birch-bark scored in a fisherman's tallies: boats, sacks, and against every tenth sack a mark like a little book, which is how a man who cannot write writes clerk.".
  Kind bronze_kind "a bronze sluice-fitting" is treasure worth 25 weighing 4 described "A hinge-strap of the Water-Wardens' bronze, green and heavy, cast with the wave in its ring.".
  Kind wardens_ring_kind "a warden's ring" is treasure worth 40 weighing 0 described "A plain ring of dark bronze, too large for any finger you have, with a wave inside a ring cut into its bezel. Inside the band, in the old script, a single word.".
  Entity tides: fact "The water stands lowest at the sea-gate before dawn and before dusk: then the lower sluice door has no sea behind it.".
  Entity ledger: fact "The smugglers who use the sluice-cut pay the customs clerk one sack in ten to look the other way.".
  Entity wardens_end: fact "The Water-Wardens wrote in their undercroft that the sea is not kept out but bargained with, a tide at a time, for as long as someone keeps the bargain.".
  Item tide_table "the wardens' tide-table" is tide_table_kind at tideroom.
  Item sluice_key "the wardens' sluice-key" is sluice_key_kind at tideroom.
  Kind salt_sack_kind "a sack of untaxed salt" is treasure worth 8 weighing 10 described "A sack of coarse grey sea-salt, tied with tarred cord, and no reeve's brand on it anywhere.".
  Item salt_sacks "a sack of untaxed salt" is salt_sack_kind at store.
  Item tally "a smuggler's tally" is ledger_kind at store.
  Item fitting "a bronze sluice-fitting" is bronze_kind at undercroft.
  Item ring "a warden's ring" is wardens_ring_kind at undercroft hidden until ring_found.

  Observe gallery_scene at gallery when true "A long vault of dressed stone, the gate's chain going down its middle into a slot full of loud black water. The water runs the length of the gallery toward a bronze door at the far end, and a low arch opens on your right above the flood.".
  Observe tideroom_scene at tideroom when true "A dry cell above the water, its walls cut with lines and lines of marks: notches, and moons, and against each moon an hour. A slate framed in bronze hangs by the door, and on a peg under it a key.".
  Observe store_scene at store when true "A dry vault stacked with sacks, new rope, and a lantern with its glass sooted. The sacks are salt, and none of them carries the reeve's brand.".
  Observe undercroft_scene at undercroft when true "Beyond the door the water has gone out, and the floor is silt and weed between pillars. On the far wall the Water-Wardens cut their words a man's height high, every letter as deep as a finger.".
  Observe wall_read at undercroft as sign when not knows(party, wardens_end) "The words on the wall are in the old script, and simple enough to make out: the sea is not kept out, it is bargained with, a tide at a time." teaches wardens_end.
  Discovery store_found "Behind the gate's great chain a ledge runs into the dark, its edge rubbed bright by ropes." {
    Found by searching gallery "Behind the chain, where nobody would stand, the stone of the ledge is rubbed bright, and a coil of new rope is tied off to a ring. Someone comes here, and not to mend the gate.".
  }
  Discovery ring_found "A warden's ring lies in the silt under the carved wall." {
    Found by searching undercroft "Under the carved wall, where the silt is deepest, your fingers close on a ring.".
  }

  Person eels "the gallery eels" at gallery {
    Role "black eels, thick as a wrist and long as a man, that hunt the running water of the gallery". Species eel. Numbers 2. Level 2. Temperament territorial.
    Warns "The black water by your knees heaves, and something as long as you are slides past and turns.".
    State hunting "Something long and black turns in the running water.".
    State stranded "The eels lie on the silt of the gallery floor, thrashing weakly, with the water gone from under them.".
  }
  Rule eels_ebb heard at gallery when state(eels, hunting) and ((hour(clock) >= 4 and hour(clock) < 7) or (hour(clock) >= 16 and hour(clock) < 19)) says "The water in the gallery drops all at once, as if a plug were drawn, and two long black eels are left writhing on the silt." { Assert state(eels, stranded). Assert peaceable(eels). }
  Rule eels_flow when state(eels, stranded) and not ((hour(clock) >= 4 and hour(clock) < 7) or (hour(clock) >= 16 and hour(clock) < 19)) { Assert state(eels, hunting). Retract peaceable(eels). }
  Initially Assert state(eels, hunting).
  Milestone m_store "found the smugglers' store behind the sea-gate's chain" worth 60 when knows(party, store_found).
  Milestone m_undercroft "opened the Water-Wardens' lower sluice door" worth 120 when been(party, undercroft).
  Objective gate_tides when holding(party, sluice_key_kind) and not been(party, undercroft) and not knows(party, tides) toward tideroom "Find when the water is low at the sea-gate: the wardens' slate in the tide-room says.".
  Objective gate_door when holding(party, sluice_key_kind) and knows(party, tides) and not been(party, undercroft) toward gallery "Open the lower sluice door with the wardens' key at low water, before dawn or before dusk.".
  Topic reeve_ledger with reeve "Show the reeve the smuggler's tally" when holding(actor, ledger_kind) once {
    Says "The reeve turns the bark over twice. 'One in ten,' she says. 'A little book.' She does not need to say whose. 'The customs-house will have a new clerk by the quarter-day. And Gatesend will have its gate kept.' She gives you five crowns for the tally and keeps it.".
    On discuss { Spend ledger_kind from actor. Increase quantity(actor, gold) by 5. Assert exposed(actor). }
  }
  Relation exposed(group).

  // What the country remembers of it: the gate shut or the fen drowned, said where it is talked of, at the well of
  // Porthalen and on Gatesend's green, for as long as anyone is there to say it.
  Observe shut_talk at green as sign when mended(party) "At the well they are talking of the sea-gate at Gatesend: shut the night before the spring tide, and by someone from outside.".
  Observe flood_talk at green as sign when flooded(party) "Gatesend's people are sleeping in the shrine at Porthalen, and the reeve's notice on the well-post has a line through it.".
  Observe hamlet_shut at hamletgreen as sign when mended(party) "Every weir below the sea-bank has a trap set in it, and the water through them runs the right way: out.".
  Observe hamlet_flooded at hamletgreen as sign when flooded(party) "Water stands a foot deep in the lanes. The doors are shut and the nets are gone off the fences, and nobody is about.".

  // ── The fen-boat: what an expedition's gains buy at Porthalen that a company could not do before. A boat-wright on
  // the landing builds the flat fen-boats the eel-men pole; owned, it takes the company where no road goes: down the
  // sluice-cut by water into the smugglers' store (the lower works' other way in), and out across the drowned fen to
  // the drowned mere, where the Barrow-Kin's chapel stands in the water with its bell.
  Relation boated(group). Relation rung(group).
  Person wright "Gwil Pryce" at green { Role "a boat-wright on the landing, who builds the flat fen-boats the eel-men pole". Pronouns he. Peaceable. Manner cheerful. }
  Entity boat_offer: fact "Gwil Pryce, the boat-wright on Porthalen's landing, sells a fen-boat with its pole for thirty coin: it goes where no road does, by the cuts and the meres.".
  Observe wright_sign at green as sign when not boated(party) and not knows(party, boat_offer) "On the landing a man is caulking the seams of a flat-bottomed boat no longer than a cart, and three more stand finished on trestles with a chalked price on each: thirty." teaches boat_offer.
  // Spoken to with less than thirty coin, he had greeted the company "You look like a person with a question" and had
  // nothing to say (cold play 4, CL-49): he says what his boats are for, and what one costs.
  Topic wright_boats with wright "Ask Gwil Pryce what his boats are for" when not boated(party) once {
    Says "Gwil slaps the hull on the nearest trestle. 'Fen-boats. Flat as a door, draw a hand of water. The eel-men pole them up the cuts and over the meres, where there's no road and never will be. Thirty coin, and the pole with it.' He squints out over the levels. 'Since the sea-gate went, there's more water out there than there's been in my life.'".
    On discuss { Assert knows(actor, boat_offer). }
  }
  Action buy_boat(actor: group, site: place) "Buy one of Gwil's fen-boats, thirty coin" {
    Speaker wright. Time 20 minutes.
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, green) and quantity(actor, gold) >= 30 and not boated(actor).
    Result "Gwil spits on his palm and shakes on it, and walks you down to the water to show you how she poles: stand at the stern, push off the bottom, never against the bank. 'She'll go anywhere there's a hand of water,' he says. 'The cuts, the meres. The old channel to the drowned mere, if you want to see the bell.'".
    On success { Decrease quantity(actor, gold) by 30. Assert boated(actor). }
  }
  Place sluicecut "the sluice-cut, by water" is room within hamlet at 3, 1.
  Place mere "the drowned mere" is room within hamlet at 1, 4 outdoors.
  Place chapel "the drowned chapel in the drowned mere" is room within hamlet at 0, 4.
  Initially Assert unlit(chapel).
  Passage bank_cut "the fen-boat, down the sluice-cut" is passage between bank and sluicecut taking 20 minutes opening when boated(party) "There is no way down the sluice-cut but by water, and you have no boat.".
  Passage cut_store "the water-gate under the ledge" is passage between sluicecut and store opening when boated(party) "".
  Passage bank_mere "the fen-boat, out across the fen to the drowned mere" is passage between bank and mere taking 1 hours opening when boated(party) "The drowned mere is a mile out across the fen, and there is no road to it, only water.".
  Passage mere_chapel "the chapel's drowned door" is doorway between mere and chapel.
  Observe cut_scene at sluicecut when true "A straight cut of black water runs under the sea-bank, its stone sides green to the tide-line. At its end a low water-gate opens under a ledge: the smugglers' way into the sea-gate, and now yours.".
  Observe mere_scene at mere when true "A round mere of still grey water, wider than Porthalen, with reeds all round it and the sky lying in it. In its middle a chapel stands up out of the water to its window-sills, its little bell-cote leaning.".
  Observe chapel_scene at chapel when true "Water to the knee, cold and clear over a floor of bones laid in rows like cobbles. On the wall over the altar the Barrow-Kin's dead are painted standing, each with a bell in its hand.".
  Entity bell_known: fact "In the drowned mere the Barrow-Kin's chapel stands in the water, and its bell rings for the dead whenever the tide turns at the sea-gate.".
  Thing bell "the chapel's bell" at chapel {
    State still "A bronze bell hangs from a beam over the water, green, with a rope of rotten hair.".
    State ringing "The bell is still humming, a long time after.".
    Change ring "Ring the chapel's bell" from still to ringing.
  }
  Rule bell_rung when state(bell, ringing) and not rung(party) says "The note goes out over the mere and does not stop. Across the fen, a mile off, something answers it: the sea-gate's chain, moving in its slot, as if the tide had heard." teaches bell_known { Assert rung(party). }
  Kind bell_coin_kind "a Barrow-Kin's bell-coin" is treasure worth 30 weighing 0 described "A coin of the old bronze with a bell struck on one face and on the other nothing, worn smooth by a dead hand.".
  Item bell_coins "a Barrow-Kin's bell-coin" is bell_coin_kind at chapel hidden until coins_found.
  Discovery coins_found "Among the bones of the chapel floor lies a bell-coin of the Barrow-Kin." {
    Found by searching chapel "Under the water, between two rows of the bone floor, your fingers find a coin, then the hollow where a hand held it.".
  }
  Milestone m_boat "bought a fen-boat and took it out on the drowned mere" worth 80 when been(party, mere).
  Objective boat_out when boated(party) and not been(party, mere) toward bank "Take the fen-boat out from the sea-bank at Gatesend, across the drowned fen to the drowned mere and its chapel.".
  // The claim the sawn pin reveals, made by someone with a stake in it (the owner's structural critique, 18 November,
  // ST-03: the smugglers had acted nowhere in the six days): Ifan Rhys, an eel-man of the hamlet whose family has run
  // the sluice-cut since before the Wardens shut it, and who takes the reeve's gate for the Rì's toll by another name.
  Relation prowled(group). Relation cursed(group). Relation boatCome(group). Relation letThrough(group).
  Relation turnedBack(group). Relation ifanHeard(group). Relation ifanMet(group). Relation ifanAsked(group). Relation ifanSaid(group).
  // Who he is where he is (OR-251: "mending a trap at his door" while he poled a boat under the gatehouse floor).
  Person ifan "Ifan Rhys" at hamletgreen { Role "an eel-man of {hamlet}, mending a trap at his door" when not at(ifan, gatehouse).
    Role "an eel-man of {hamlet}, at the pole of a flat-bottomed boat under the gatehouse floor" when at(ifan, gatehouse). Pronouns he.
    Peaceable. Manner acerbic. }
  Topic ifan_gate with ifan "Ask Ifan about the sea-gate" when not mended(party) and not flooded(party) once {
    Says "'Open a month,' says Ifan, and does not look up from the trap. 'The eels come up with the sea. Best run since my father's time.' He pulls a withy tight with his teeth. 'Not everyone wants it shut, whatever the reeve's paper says.'".
    On discuss { Assert ifanAsked(actor). }
  }
  Topic ifan_claim with ifan "Ask Ifan who wanted the gate open" when knows(actor, cut) and not at(ifan, gatehouse) and not ifanHeard(actor) once {
    Says "Ifan puts the trap down. 'The Wardens shut that cut on my grandfather, and the reeve keeps it shut for the Rì, and every sack that comes up it pays the Rì or the clerk at {town} or nobody.' He looks at the gatehouse. 'Shut it, and my children eat what the toll leaves. Leave it a tide, and they eat. You choose, since you're choosing.'".
    On discuss { Assert ifanHeard(actor). }
  }
  Topic ifan_claim_boat with ifan "Ask Ifan who wanted the gate open" when knows(actor, cut) and at(ifan, gatehouse) and not ifanHeard(actor) once {
    Says "Ifan leans on the pole and looks up at you through the slot. 'The Wardens shut that cut on my grandfather, and the reeve keeps it shut for the Rì, and every sack that comes up it pays the Rì or the clerk at {town} or nobody.' He looks at the gatehouse. 'Shut it, and my children eat what the toll leaves. Leave it a tide, and they eat. You choose, since you're choosing.'".
    On discuss { Assert ifanHeard(actor). }
  }
  // Ifan's clock, three beats before the tide (the critique's clock test: warning, deterioration, crisis).
  Rule prowling when not mended(party) and not flooded(party) and not prowled(party) and watch(clock) >= 288 says "Word from {hamlet}: someone was in the Wardens' gatehouse in the night. The ratchet ring is greased, and wet boot-prints go to the well." { Assert prowled(party). }
  // How Bran was got out reaches the gate (ST-04): with Mardle gone the smugglers have lost the one they paid, and are at
  // the gatehouse a day sooner; with Mardle paid, he has sent Ifan word the company is coming.
  Rule prowling_early when knows(party, clerkgone) and not mended(party) and not flooded(party) and not prowled(party) and watch(clock) >= 144 says "Word from {hamlet}: someone was in the Wardens' gatehouse in the night, and not careful about it. The ratchet ring is greased, the floor is wet to the well, and a pry-bar has been left by the windlass." { Assert prowled(party). }
  Rule ifan_warned when knows(party, clerkkept) and ifanAsked(party) and not ifanSaid(party) says "'The clerk at {town} sent word you'd be along,' Ifan adds, still not looking up. 'Said you were the paying kind.'" { Assert ifanSaid(party). }
  Rule ifan_unpaid when knows(party, clerkgone) and ifanHeard(party) and not ifanSaid(party) says "'And Mardle's gone,' says Ifan. 'There was a man at the customs-house who could be talked to. You saw to that. So now it is the gate, or it is nothing.'" { Assert ifanSaid(party). }
  Rule cursing when not mended(party) and not flooded(party) and prowled(party) and not cursed(party) and watch(clock) >= 576 says "The eel-men of {hamlet} will not go near the gatehouse now. Someone has told them a drowned warden walks the sea-bank at night, and Ifan Rhys tells it loudest." { Assert cursed(party). }
  // The crisis's two choices are made about the boat under the gate, where the scene's four are chosen (ST-03): as his,
  // beside his talk, they had been had only by talking to him (CL-54's opener).
  // What came of the boat is exported as the relations themselves (letThrough, turnedBack, named), for those beyond
  // this module to answer (the weir's Nest: data/origins/weir).
  Thing ifanboat "Ifan Rhys's boat, under the shut gate" nowhere {
    State waiting "Below the slot Ifan Rhys holds his boat against the shut gate with the pole, and waits.".
  }
  Rule boat_comes when mended(party) and not flooded(party) and not boatCome(party) and at(party, gatehouse) and not reeveWarned(party) says "Below the gatehouse a flat-bottomed boat noses up the sluice-cut against the shut gate, low in the water with sacks, and Ifan Rhys at the pole. He looks up at you through the slot in the floor and does not call out." { Assert boatCome(party). Retract at(ifan, hamletgreen). Assert at(ifan, gatehouse). Assert at(ifanboat, gatehouse). }
  // With the reeve come out to the gate, the boat is let through or turned back in front of her.
  Rule boat_watched when mended(party) and not flooded(party) and not boatCome(party) and at(party, gatehouse) and reeveWarned(party) says "Below the gatehouse a flat-bottomed boat noses up the sluice-cut against the shut gate, low in the water with sacks, and Ifan Rhys at the pole. Behind you the door bangs: the reeve has ridden out to see the gate for herself, as she said she would, and she stands at the slot beside you, looking down at him." { Assert boatCome(party). Retract at(ifan, hamletgreen). Assert at(ifan, gatehouse). Assert at(ifanboat, gatehouse). Retract at(reeve, green). Assert at(reeve, gatehouse). }
  // Under the reeve's eyes or not: come out to the gate, she sees who lets the boat through or turns it back, writes
  // it down and rides back to the landing; not come, nobody sees it.
  Action let_through(actor: group, site: place) "Wind the gate up a tide's height and let Ifan's boat through" {
    Time 30 minutes.
    Requires able(actor) and at(actor, site) and at(actor, gatehouse) and boatCome(actor) and not letThrough(actor) and not turnedBack(actor).
    Result "The drum takes the chain up a turn, the boat slides through on the last of the flood, and you wind it down again. Ifan lifts a hand from the pole as he passes under. Nobody else sees it.".
    Result "The drum takes the chain up a turn, and the boat slides through on the last of the flood under the reeve's eyes. Ifan does not lift his hand this time. 'So that is who,' says the reeve, and writes on her tablet, and rides back to {town} without another word to you." when reeveSaw(actor).
    On success {
      Retract at(ifanboat, gatehouse). Assert letThrough(actor). Retract at(ifan, gatehouse). Assert at(ifan, hamletgreen).
      If at(reeve, gatehouse), Assert reeveSaw(actor).
      If at(reeve, gatehouse), Assert at(reeve, green).
    }
  }
  Action turn_back(actor: group, site: place) "Keep the gate shut, and tell Ifan to take his boat back down the cut" {
    Time 10 minutes.
    Requires able(actor) and at(actor, site) and at(actor, gatehouse) and boatCome(actor) and not letThrough(actor) and not turnedBack(actor).
    Result "Ifan looks at the shut gate a long moment, then at you. 'Then the reeve's clerk eats this winter,' he says, 'and my children don't.' He turns the boat in the cut with one push and is gone into the dark.".
    Result "Ifan looks up at the shut gate, and at the reeve beside you, a long moment. 'Ifan Rhys,' says the reeve, and writes it down. 'The Rì's toll on every sack since the new moon, or the boat.' He turns the boat in the cut with one push and is gone into the dark, and the reeve rides back to {town}." when reeveSaw(actor).
    On success {
      Retract at(ifanboat, gatehouse). Assert turnedBack(actor). Retract at(ifan, gatehouse). Assert at(ifan, hamletgreen).
      If at(reeve, gatehouse), Assert reeveSaw(actor).
      If at(reeve, gatehouse), Assert at(reeve, green).
    }
  }
  // What the reeve, having seen it, says of it after (her own topic at {town}).
  Topic reeve_let with reeve "Ask the reeve about Ifan Rhys's boat" when letThrough(actor) and reeveSaw(actor) once {
    Says "'You wound the Rì's gate up for a smuggler,' says the reeve, 'in front of the Rì's reeve.' She does not raise her voice. 'The thirty crowns are for a gate that shuts, and it shuts. Do not ask me for anything else this quarter.'".
  }
  Topic reeve_turned with reeve "Ask the reeve about Ifan Rhys's boat" when turnedBack(actor) and reeveSaw(actor) once {
    Says "'Ifan Rhys will pay the toll on every sack since the new moon, or lose the boat,' says the reeve. 'His children will be hungry this winter. That is his doing, not yours.' She looks at you a moment longer. 'But it was you at the gate.'".
  }
  // Back at {town} with what the reeve did not see for herself, who it was is the company's to tell or to keep (the
  // defect-centres review's sea-gate increment: one new choice after the return). Told, she writes his name down, and
  // the hamlet knows by the next time the company comes (ifan_named); kept, nothing is said, and Ifan goes on.
  Relation named(group). Relation ifanNamed(group).
  Topic reeve_name with reeve "Tell the reeve it is Ifan Rhys's boat that comes up the cut" when (boatCome(actor) or ifanHeard(actor)) and not reeveSaw(actor) and not letThrough(actor) and not named(actor) once {
    Says "'Ifan Rhys,' says the reeve, and writes it on her tablet. 'His grandfather ran that cut, and his father paid the Rì for it, and he has been paying nobody.' She looks up. 'The toll on every sack since the new moon, or the boat. You will not be thanked for this on the lane.'".
    On discuss { Assert named(actor). }
  }
  Topic reeve_name_let with reeve "Tell the reeve it is Ifan Rhys's boat that comes up the cut" when letThrough(actor) and not reeveSaw(actor) and not named(actor) once {
    Says "The reeve writes the name down before you have finished. Then she waits. 'And on the night after you shut it,' she says, 'did his boat come up against the gate?' You say nothing, and she writes something else. 'The thirty crowns are for a gate that shuts. Do not bring me half of a thing again.'".
    On discuss { Assert named(actor). }
  }
  Rule ifan_named when named(party) and at(party, hamletgreen) and not ifanNamed(party) says "Ifan Rhys's boat is drawn up on the bank below his door, with the reeve's chalk on its bow. Ifan is on his step. He watches you come the length of the lane and does not get up." { Assert ifanNamed(party). }
  // The cold pans' fuel boat poled down the cut by day (data/goings-on/iscoed-pans): on the eel-men's water, seen.
  Relation ifanPoled(group).
  Rule ifan_poled heard at hamletgreen when knows(party, poledword) and at(party, hamletgreen) and at(ifan, hamletgreen) and not boatCome(party) and not ifanPoled(party) says "Ifan Rhys looks up from his trap as you come along the lane. 'You poled Ianto's boat down our cut in broad day,' he says. 'Half {hamlet} watched you go by. Next time you're on our water, ask.'" { Assert ifanPoled(party). }
  Rule ifan_after when letThrough(party) and not named(party) and at(party, hamletgreen) and not ifanMet(party) says "Ifan Rhys is mending a trap at his door. He nods to you as you pass, as one eel-man to another, and says nothing of boats." { Assert ifanMet(party). }
  Rule ifan_cold when turnedBack(party) and not named(party) and at(party, hamletgreen) and not ifanMet(party) says "Ifan Rhys's door is shut, and his nets are off the fence. A child on the step watches you all the way along the lane." { Assert ifanMet(party). }
  Goal mended(party).
}
