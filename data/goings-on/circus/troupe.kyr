Module circus "Wapshott's Peregrine Circus" {
  // ── The company of the circus ─────────────────────────────────────────────────────────────────────────────────
  // Each travels with the wagons and keeps a post on the ground (the front, the ring, the backyard, the wagons, the
  // menagerie); the performers are in the ring for the morning's rehearsal and the evening's show. How each thinks
  // of the company is their regard for it.
  Measure regard(group).
  Relation metCircus(group).

  Person wapshott "Colonel Florian Wapshott" at tober_a {
    Role "the proprietor of Wapshott's Grand Peregrine Circus". Ancestry human. Peaceable. Pronouns he. Manner jovial.
    Greets "A big man in a crimson coat with frogging across the chest, a moustache dyed the black of a new boot, and a voice like a church organ with the stops out, takes your hand before you have offered it. 'Colonel Florian Augustus Wapshott,' he says, 'Proprietor, Ringmaster, and Sole Patentee of the Grand Peregrine Circus and Hippodrama, at your service, and very much at your disposal, and if you are from the Rates, I am not here.' He considers you. 'You are not from the Rates. You have an honest face. I have one myself; I keep it for Sundays.'".
    Greets again "'My friend!' The Colonel opens his arms as if you had been away at the wars. 'You find me at a moment of TRIUMPH, or very nearly. What can Wapshott's do for you? More to the point, what can you do for Wapshott's?'".
  }
  Person ada "Ada Thripp" at tober_a {
    Role "the circus's book-keeper". Ancestry human. Peaceable. Pronouns she. Manner acerbic.
    Greets "A young woman in a green bonnet with ink on her fingers sits in the hatch of the ticket wagon with a cash-box, a ledger and a pencil behind each ear. 'Ada Thripp,' she says. 'I keep the books. Somebody has to; the Colonel thinks a ledger is a kind of hat.' She looks you up and down as if pricing you. 'If you have come to be paid, the answer is Thursday. If you have come to pay, you are the first this week and I could kiss you.'".
    Greets again "Ada Thripp looks up from the ledger. 'Oh, it's you,' she says, in a voice that means it is better than it might have been.".
  }
  Person mumchance "Mumchance" at tober_a {
    Role "the circus's old clown". Ancestry human. Peaceable. Pronouns he. Manner stoic.
    Greets "An old man sits on an upturned bucket in his shirtsleeves, painting his face white in a bit of mirror nailed to a wagon wheel. He has a long, lined, patient face, like a horse that has seen everything twice. He finishes the line of his mouth before he looks at you. 'They call me Mumchance,' he says, in a soft dry voice that you have to lean toward, 'because in the ring I never say a word. Out here I say several.'".
    Greets again "Mumchance lifts one hand from his knee and lets it fall again.".
  }
  Person pip "Pip Gallant" at tober_a {
    Role "the circus's ring-girl and Mumchance's apprentice". Ancestry human. Calling monk. Level 1. Peaceable. Pronouns she. Manner cheerful.
    Greets "A girl of seventeen or so, all elbows, with a broom twice her height and sawdust in her hair, falls over the broom, rolls, comes up on her feet, and bows. 'Meant that,' she says. 'Pip Gallant. I sweep the ring and hold the hoops and I'm going to be the greatest clown since Mumchance, only he says I have to learn to fall first, and I've been learning to fall for two years, and I can fall really well now, look.' She falls over again.".
    Greets again "'Hullo!' says Pip, from somewhere she has just landed.".
    Joins "Pip goes and tells Mumchance, and comes back with her bundle, a juggling club and a red nose in her pocket for emergencies. 'He said, go and fall over in front of the world,' she says, 'and come back funnier. He shook my hand. He's never shaken my hand.' She wipes her eyes with the back of her wrist, briskly. 'Right. Where are we going?'".
    Leaves "'I'll go back to the wagons,' says Pip. 'Mumchance will want to know if I've been falling properly.' She salutes, upside down, and goes.".
  }
  Person zephyrine "Mademoiselle Zéphyrine" at tober_a {
    Role "the Sylph of the Wire". Ancestry human. Peaceable. Pronouns she. Manner proud.
    Known as "a woman in a silver wrap" when not knows(party, zephyrine_named).
    Greets "A slight woman with her hair scraped up in a silver net, her feet in soft kid slippers, is doing something to the inside of one ankle with a strip of linen, very slowly, as if the ankle were a violin. 'I am Zéphyrine,' she says, in an accent that comes from somewhere, though perhaps not from anywhere in particular. 'The Sylph. Of the Wire.' She looks at you with very still grey eyes. 'You have come to look at me. Everyone does. It is permitted.'".
    Greets again "Zéphyrine inclines her head, exactly as far as a sylph should.".
  }
  Entity zephyrine_named: fact "The Sylph of the Wire at Wapshott's is Mademoiselle Zéphyrine.".
  Rule zephyrine_known when addressed(zephyrine, party) and not knows(party, zephyrine_named) says "She is Mademoiselle Zéphyrine, the Sylph of the Wire." teaches zephyrine_named { }
  Person hal "Hal Quincey" at tober_a {
    Role "a tumbler, one of the Brothers Quincey". Ancestry human. Peaceable. Pronouns he. Manner proud.
    Greets "A square young man in tights and a striped jersey is doing handsprings across the sawdust, one after another, very fast, as if to get away from something. He lands in front of you. 'Hal Quincey,' he says. 'The elder. By eleven minutes. The better, by more than that. If you're looking for my brother, he's the one over there pretending he can't see me.'".
    Greets again "Hal Quincey nods to you from a handstand.".
  }
  Person dunstan "Dunstan Quincey" at tober_a {
    Role "a tumbler, one of the Brothers Quincey". Ancestry human. Peaceable. Pronouns he. Manner grim.
    Greets "A square young man in tights and a striped jersey, the image of the other one across the ring, is stretching his hamstrings with tremendous dignity. 'Dunstan Quincey,' he says. 'Of the Brothers Quincey. There is, for the time being, only one Brother Quincey. Tell the other one that, if he asks. He won't ask. He's too proud. It's the only thing he ever invented.'".
    Greets again "Dunstan Quincey nods, and looks across the ring to see whether his brother saw him nod.".
  }
  Person honoria "Honoria Bulstrode" at tober_a {
    Role "the Ox of Abernant, strongwoman and cook". Ancestry human. Peaceable. Pronouns she. Manner compassionate.
    Greets "A woman as wide as a doorway, in a flowered apron, is lifting a cauldron off the fire one-handed and setting it on the grass as if it were a teacup. 'Honoria Bulstrode,' she says, wiping her hand to shake yours, which she does gently, like someone who has broken hands before by accident. 'The Ox of Abernant on the bills; Mrs Bulstrode at the stove. Have you eaten? You haven't. Sit there. No, there. The other one's a goose.'".
    Greets again "'Sit down,' says Honoria Bulstrode, already reaching for a bowl.".
  }
  Person fipps "Signor Cornelius Fipps" at tober_a {
    Role "the circus's bandmaster". Ancestry human. Peaceable. Pronouns he. Manner cheerful. Wants band_serpent_kind.
    Greets "A round man with a round face and a black wooden horn wound three times round his body is polishing the horn's mouthpiece on his waistcoat. 'Fipps,' he says. 'Signor Fipps, for the profession; Cornelius to my friends; Corny to the Colonel, who has no idea how much I mind. The band, sir: myself on the serpent, young Tom Gale on cornet, and Abel Rudd on the drum, who is deaf, which is a help.' He pats the horn. 'This is the serpent. She is very old and she has a crack, and there are three notes she will not play, and one of them is the one we need.'".
    Greets again "Fipps lifts the serpent an inch in greeting, and it makes a small sad noise of its own accord.".
  }
  Person hench "Lucius Hench" at tober_a {
    Role "the circus's wardrobe-master". Ancestry human. Peaceable. Pronouns he. Manner acerbic.
    Greets "A thin, upright man in a black coat brushed till it shines, with a tape-measure round his neck like a chain of office and six pins in his lapel, looks up from the spangled bodice he is mending without moving his head. 'Hench,' he says. 'Wardrobe. I was eleven years valet to the Margravine of Oster and I have dressed a bishop for his own funeral, and I now sew sequins on the trousers of tumblers who will not stand still.' He bites a thread. 'You have a button loose. No, don't touch it. Give it to me.'".
    Greets again "Hench looks at your clothes before he looks at you, and sighs, and then nods.".
  }
  Person lusk "Gideon Lusk" at tober_a {
    Role "the circus's boss canvasman". Ancestry human. Peaceable. Pronouns he. Manner stoic.
    Greets "A very large man with a beard like a hedge and hands like spades is splicing a rope with his teeth and one hand. He takes the rope out of his teeth. 'Lusk,' he says. That seems to be all. Then, after a while: 'Canvas.' Then, after another while, as if he had thought hard about whether you deserved it: 'Mind the guys.'".
    Greets again "Lusk nods.".
  }
  Person nance "Nance Tibbet" at tober_a {
    Role "the Sibyl of the Seven Rivers, fortune-teller". Ancestry human. Peaceable. Pronouns she. Manner jovial.
    Greets "An old woman in nine shawls, rings on every finger and two on one thumb, is sitting on the steps of a black wagon with SIBYL on it in gold, smoking a clay pipe. 'Nance Tibbet,' she says, 'the Sibyl of the Seven Rivers, which the Colonel made up; I'm from a town with one river and that one's mostly mud.' She looks at your face the way a horse-coper looks at teeth. 'You want to know something. Everybody who comes to the Sibyl wants to know something. It's usually something they know already.'".
    Greets again "'Back again, dearie,' says Nance Tibbet. 'They always come back. I'd say I foresaw it, but I'd be lying, and I only lie for money.'".
  }
  Person billie "Billie Ostrander" at tober_a {
    Role "the keeper of the circus's horses and beasts" when menagerieOpen(wapshotts).
    Role "the circus's horse-keeper". Ancestry human. Peaceable. Pronouns she. Manner grim.
    Greets "A broad-shouldered woman in a man's coat and gaiters, with a curry-comb in one hand and an apple in the other, is grooming an old grey horse who is pretending not to notice. 'Wilhelmina Ostrander,' she says. 'Billie. I keep the horses: the four ponies and His Lordship here, Bucephalus, who keeps himself. My father was a drover. I've been kicked by everything with legs.' She hands the horse the apple. 'Don't feed him. He'll tell you he's starving. He's lying.'".
    Greets again "Billie Ostrander nods without stopping what her hands are doing.".
  }
  Species circus_horse "an old grey horse" like horse tame described "A tall grey horse, almost white with age, with a Roman nose, a plume holder on his bridle, and the bearing of a retired general who has heard better speeches.".
  Person bucephalus "Bucephalus" at tober_a {
    Role "the circus's old grey horse". Species circus_horse. Peaceable. Pronouns he.
    Greets "Bucephalus looks at you down the length of his nose, decides you have no apples, and looks at the horizon instead.".
  }
  Person quirk "Sidney Quirk" at tober_a {
    Role "the circus's advance agent and bill-poster". Ancestry human. Peaceable. Pronouns he. Manner cheerful.
    Greets "A thin man with a paste-pot in one hand, a brush in the other and a roll of bills under each arm is pasting a bill to the wall at a speed that suggests he has been asked to stop. 'Quirk!' he says. 'Advance agent, Wapshott's. I go a day ahead and bill everything that holds still. Walls, barns, gates, a hearse, once, by mistake, though the family were very good about it.' He looks at you with professional interest. 'You're nice and flat across the back. Hold still a moment.'".
    Greets again "'Still flat?' says Sidney Quirk hopefully, lifting his brush.".
  }

  Initially Assert travels(wapshott). Initially Assert travels(ada). Initially Assert travels(mumchance). Initially Assert travels(pip).
  Initially Assert travels(zephyrine). Initially Assert travels(hal). Initially Assert travels(dunstan). Initially Assert travels(honoria).
  Initially Assert travels(fipps). Initially Assert travels(hench). Initially Assert travels(lusk). Initially Assert travels(nance).
  Initially Assert travels(billie). Initially Assert travels(bucephalus). Initially Assert travels(quirk).
  Initially Assert post(wapshott, rk_wagons). Initially Assert post(ada, rk_tober). Initially Assert post(mumchance, rk_yard).
  Initially Assert post(pip, rk_ring). Initially Assert post(zephyrine, rk_wagons). Initially Assert post(hal, rk_ring).
  Initially Assert post(dunstan, rk_ring). Initially Assert post(honoria, rk_yard). Initially Assert post(fipps, rk_tober).
  Initially Assert post(hench, rk_wagons). Initially Assert post(lusk, rk_tober). Initially Assert post(nance, rk_tober).
  Initially Assert post(billie, rk_yard). Initially Assert post(bucephalus, rk_yard). Initially Assert post(quirk, rk_tober).
  Initially Assert performer(wapshott). Initially Assert performer(mumchance). Initially Assert performer(pip). Initially Assert performer(zephyrine).
  Initially Assert performer(hal). Initially Assert performer(dunstan). Initially Assert performer(honoria). Initially Assert performer(bucephalus).
  Initially Assert performer(fipps).
  Initially Assert parades(wapshott). Initially Assert parades(mumchance). Initially Assert parades(fipps). Initially Assert parades(bucephalus).
  Initially Assert parades(pip). Initially Assert parades(honoria).
  Initially Assert serves(ada, wapshott). Initially Assert serves(lusk, wapshott). Initially Assert serves(quirk, wapshott).
  Rule met_circus when (addressed(wapshott, party) or addressed(ada, party) or addressed(mumchance, party) or addressed(pip, party) or addressed(honoria, party))
    and not metCircus(party) { Assert metCircus(party). }

  // ── The life of the place: what is going on, by the hour and the day of the stand ─────────────────────────────
  Query standDay(n: concern) means pitched(n).
  Observe yard_morning near cookfire when pitched(wapshotts) and at(cookfire, ?r) and hour(clock) >= 6 and hour(clock) < 9 "Honoria Bulstrode is frying bacon by the hundredweight in a pan like a cartwheel, and the whole circus is queuing for it in its nightshirts, in order of precedence: the Colonel first, then Bucephalus, then everyone else.".
  Observe yard_noon near cookfire when pitched(wapshotts) and at(cookfire, ?r) and hour(clock) >= 12 and hour(clock) < 14 "It is the dead hour after dinner. Somebody is asleep under every wagon. A dog has stolen a sausage and is being chased, without much conviction, by a man in a sequinned jacket.".
  Observe yard_afternoon near cookfire when pitched(wapshotts) and at(cookfire, ?r) and hour(clock) >= 14 and hour(clock) < 18 and day(clock) == arrivedDay(wapshotts) "The backyard is all hammering: the seat-scaffolding going up inside, the ring boards being knocked together, Lusk's lads singing a heaving song with only one verse, which is mostly the word HEAVE.".
  Observe yard_afternoon2 near cookfire when pitched(wapshotts) and at(cookfire, ?r) and hour(clock) >= 14 and hour(clock) < 18 and day(clock) == arrivedDay(wapshotts) + 1 "Washing day: every guy-rope round the backyard is hung with tights, spangled bodices, a clown's white smock and a vast flowered apron, and the big top looks as if it had been dressed for a wedding by someone who had never been to one.".
  Observe yard_afternoon3 near cookfire when pitched(wapshotts) and at(cookfire, ?r) and hour(clock) >= 14 and hour(clock) < 18 and day(clock) >= arrivedDay(wapshotts) + 2 "Last day of the stand: the circus is already half-packed in its head. Crates are being nailed. The Colonel is walking round and round the wagons with a list, adding things to it.".
  Observe yard_evening near cookfire when pitched(wapshotts) and at(cookfire, ?r) and hour(clock) >= 18 and hour(clock) < 19 "The half-hour before the show: everyone in the backyard is in costume and in a temper. Somebody cannot find a shoe. Somebody else is being sick behind the canvas wagon, as they are every night, and then goes on and is wonderful.".
  Observe yard_night near cookfire when pitched(wapshotts) and at(cookfire, ?r) and hour(clock) >= 21 and showDay(wapshotts) == day(clock) "After the show the backyard is lamplight and steam: performers in their shirts eating stew off their knees, telling each other what went wrong. Somebody has a fiddle. The Colonel is counting the takings aloud to Ada Thripp, who is counting them silently and getting a different number.".
  Observe yard_good_night near cookfire when pitched(wapshotts) and at(cookfire, ?r) and hour(clock) >= 21 and lastNightGood(wapshotts) "It was a good house tonight, and the whole backyard knows it: everybody is talking at once, the Quinceys' quarrel is forgotten for ten minutes, and the Colonel has given Bucephalus a whole loaf.".
  Observe ring_rehearsal near ringpost when rehearsal() and at(ringpost, ?r) and not feudMended(hal) "It is rehearsal. The Brothers Quincey are tumbling, one at each end of the ring, not looking at each other. Up on the wire the Sylph is walking very slowly back and forth, back and forth, in a grey practice dress, like somebody pacing a landing at night.".
  Observe ring_rehearsal_mended near ringpost when rehearsal() and at(ringpost, ?r) and feudMended(hal) "It is rehearsal. The Brothers Quincey are working the Turn in the middle of the ring, back to back, arguing in whispers about the left foot, which is how brothers agree. Up on the wire the Sylph is walking very slowly back and forth in a grey practice dress.".
  Observe ring_rehearsal_pip near pip when rehearsal() and at(pip, ?r) and ringHere(?r) "Pip is holding a hoop for nobody, and then jumping through it herself, and falling, and getting up.".
  Observe tober_front near pole when pitched(wapshotts) and at(pole, ?r) and hour(clock) >= 17 and hour(clock) < 19 "In front of the big top the band is playing the people in: a cornet, a drum and the serpent, which goes BUMP, BUMP under everything like a cow in a cellar. A crowd is gathering at the flap, and Ada Thripp, in the hatch of the ticket wagon, is taking their coins with a face like a tax.".

  // ── Colonel Florian Wapshott ───────────────────────────────────────────────────────────────────────────────────
  Topic wap_circus with wapshott "Ask the Colonel about his circus" when true once {
    Says "'The Grand Peregrine Circus and Hippodrama,' says the Colonel, 'founded by myself in a field, with one horse and a borrowed ladder, nineteen years ago this Lammas. We have played before the crowned heads of nowhere I can name for legal reasons, and the uncrowned heads of everywhere.' He spreads his arms to take in the big top, the wagons, a goose. 'Eleven wagons. Thirty souls. One horse of genius. We go round {town_a}, {town_b} and {town_c} like the hand of a clock, and the clock, my friend, is going to strike.' He lowers his voice to a mere bellow. 'Wapshott's is going to be a household word. I have not yet decided which word.'".
    On discuss { Increase regard(wapshott) by 1. }
  }
  Topic wap_colonel with wapshott "Ask the Colonel what he was a colonel of" when true once {
    Says "'The Ninth Volunteers,' says the Colonel, without hesitation. Then, with a little: 'Fusiliers.' Then: 'Of a sort.' He strokes his moustache. 'I bought the commission from a man in the Waggoner at Dunmere for a meat pie and my second-best hat. He was a colonel, there is no doubt of it. He had the paper. That he was a colonel of something that existed I will not swear to, but nor, my friend, will you swear that it didn't.' He beams. 'Never ask a showman for his papers. Ask him for his show.'".
  }
  Topic wap_ambition with wapshott "Ask the Colonel what he wants" when regard(wapshott) >= 1 once {
    Says "The Colonel is silent, which is so rare that a canvasman looks round. 'A roof,' he says at last. 'Not a canvas one. A building. An amphitheatre, with a ring of oak and a gallery and gas, in a city, with WAPSHOTT'S cut in stone over the door, where a horse could be stabled in winter and a clown could grow old in a chair by a stove. And a warrant. A Royal Warrant, framed, on the wall of the ticket office: BY APPOINTMENT.' He clears his throat enormously. 'And in the meantime, a menagerie. One must start somewhere. Madame Sallow has a menagerie. Madame Sallow has a camel. A camel!' He looks at you as if you had personally failed to provide one.".
    On discuss { Assert knows(actor, wapshott_dreams). }
  }
  Entity wapshott_dreams: fact "Colonel Wapshott wants a building, a Royal Warrant, and in the meantime a menagerie, because his rival Madame Sallow has a camel.".
  Topic wap_sallow with wapshott "Ask the Colonel who Madame Sallow is" when knows(actor, wapshott_dreams) once {
    Says "'Cordelia Sallow,' says the Colonel, and for once in his life he says something quietly. 'We were partners, once. Wapshott and Sallow's Royal Circus. She had the head for figures and I had the head for everything else, and we were to be married at the Fair at Dunmere, in the lion's cage, for the publicity.' He looks at his boots. 'She went off with the lion, the elephant and the ledger, and started the Imperial Hippodrome, and has done very well, and I wish her every success, in a distant country, with damp.' He brightens with an effort. 'She has a camel. It is not a very good camel.'".
    On discuss { Assert knows(actor, sallow_known). }
  }
  Entity sallow_known: fact "Madame Cordelia Sallow, of Sallow's Imperial Hippodrome, was once the Colonel's partner and his betrothed; she left him at the altar, in a lion's cage, with the ledger.".
  Topic wap_money with wapshott "Ask the Colonel how the circus is doing for money" when true once {
    Says "'Splendidly,' says the Colonel. 'Brilliantly. The houses are full, the public is enraptured, and the money comes in like the tide.' A pause. 'And goes out like it. Ask Ada. No, don't ask Ada; she will show you the book, and the book is a pessimist.'".
  }
  Topic wap_honest with wapshott "Tell the Colonel that some of his bills are not true" when knows(actor, wapshott_dreams) once {
    Says "The Colonel looks genuinely hurt. 'Not true? My friend. A bill is not a sworn statement. A bill is a promise of wonder. If I put THE SYLPH OF THE WIRE, A LADY OF THE AIR FROM THE COURTS OF THE EAST, I promise you a lady of the air, and she is one, I have seen her up there, and as for the courts of the East, everybody comes from the east of somewhere.' He puts a hand on your shoulder. 'Nobody ever came out of Wapshott's feeling they had been cheated. Some of them came out feeling they had been magnificently cheated. That is a different thing. That is art.'".
  }

  // ── Ada Thripp ────────────────────────────────────────────────────────────────────────────────────────────────
  Topic ada_book with ada "Ask Ada to show you how the books stand" when true {
    Says "Ada turns the ledger round so you can read it, and taps the bottom of the page with her pencil. 'In the strongbox: {strongbox(wapshotts)} coin. In the larder: {larder(wapshotts)} days' food for thirty people and a horse who eats for six. The canvas: {canvas(wapshotts)}, out of three, which is my own measure, and means Lusk is worried. Wages owed and unpaid: {arrears(wapshotts)} stands.' She closes it. 'Every three days we strike, and every strike the wages are due, ten coin for the company, and every day the larder wants three. The houses pay it, when they come. When they don't, the Colonel has an idea, and the ideas cost money.'".
  }
  Topic ada_how with ada "Ask Ada how you could help the circus pay its way" when true once {
    Says "Ada counts it off on inky fingers. 'Fill the benches: the bills, the parade, a town that likes us, a show that goes right. Keep the larder full, and buy it cheaper than the Colonel does, which is any price at all. Keep the canvas sound, or the rain comes in and the house goes home. Keep the wages paid, or Lusk's lads sit down. And if you can do anything at all, do it in the ring, because a new face in the ring is worth a cartload of bills.' She looks at you. 'Or sign the book and be a hand. Two coin a stand, when I've got it, and all the stew you can eat.'".
  }
  Topic ada_self with ada "Ask Ada how she came to keep the circus's books" when true once {
    Says "'The Colonel bought forty yards of rope from my father's chandlery in Marlow with an IOU,' says Ada. 'I came after it. I found him in this wagon eating sardines off a playbill with the ledger propping up the table, and I opened it, and I couldn't leave. It was like finding a beautiful house with no roof.' She sniffs. 'That was four years ago. I'm going to own a quarter-share in this circus by the time I'm thirty, and when I do, the first thing I'm going to do is take away his pen.'".
    On discuss { Increase regard(ada) by 1. }
  }
  Topic ada_secret with ada "Ask Ada what she is always writing in the back of the ledger" when regard(ada) >= 1 once {
    Says "Ada goes red to the bonnet. 'Accounts,' she says. You wait. 'Oh, very well.' She turns the ledger over and opens it from the back, where the pages are close-written in a different, wilder hand. 'THE BRIGAND'S BRIDE, OR, THE FATAL CONVENT. A Romance in Forty Parts, by A Lady of the Road. They print it in Dunmere at a penny a part and they've sold eleven hundred.' She shuts it. 'If you tell the Colonel I will put you in it, and something will happen to you in a crypt.'".
    On discuss { Assert knows(actor, ada_writes). Increase regard(ada) by 1. }
  }
  Entity ada_writes: fact "Ada Thripp, who keeps Wapshott's books, secretly writes a penny romance, THE BRIGAND'S BRIDE, as A Lady of the Road.".
  Topic ada_pension with ada "Ask Ada why there is a coin a week written against Mrs Gale" when regard(ada) >= 2 once {
    Says "Ada is quiet a moment. 'Tom Gale's father was a flyer. He came off the bar at Wakeham six years ago and the Colonel has paid his widow a coin a week ever since, out of his own share, in a week when there is no share, and he made me promise not to put it in the book.' She looks at the line. 'I put it in the book. I put it in very small. He's a vain, idle, ridiculous man and he'd sell his own grandmother for a camel.' She dips her pen. 'And he's never once missed that coin.'".
    On discuss { Assert knows(actor, wapshott_pension). Increase regard(ada) by 1. }
  }
  Entity wapshott_pension: fact "Colonel Wapshott has paid the widow of a flyer killed in his ring a coin a week for six years, out of his own share, and told nobody.".

  // ── Mumchance ─────────────────────────────────────────────────────────────────────────────────────────────────
  Topic mum_silence with mumchance "Ask Mumchance why he never speaks in the ring" when true once {
    Says "'Because a laugh,' says Mumchance, 'is a thing the audience does, not a thing I do. If I talk, I tell them what is funny. If I don't, they have to find it themselves, and what you find yourself you keep.' He considers the white of his face in the mirror. 'Also when I was young I had a voice like a gate and they threw things.'".
    On discuss { Increase regard(mumchance) by 1. }
  }
  Topic mum_past with mumchance "Ask Mumchance where he learned to fall" when true once {
    Says "'My father was a fencing-master,' says Mumchance. 'Augustin Fell, of the Salle Fell in Dunmere. He meant me for the sword. He taught me the feint and the parry and the lunge, and where to put my feet, and I learned that the whole art of the sword is making the other fellow sure you are somewhere you are not.' He smiles, very slightly. 'Then I saw a clown fall down a flight of stairs at the Midsummer Fair, all twelve, and get up, and look at the stairs as if they had insulted his mother. And I thought: that is the same art. That is the same art done better. I ran off with the circus the next morning. My father never forgave me, and he came to see me every year, at the back, where he thought I couldn't see.'".
    On discuss { Assert knows(actor, gentle_art_heard). Increase regard(mumchance) by 1. }
  }
  Entity gentle_art_heard: fact "Mumchance, the old clown, was a fencing-master's son: he holds that clowning and fencing are the same art, making the other fellow sure you are somewhere you are not.".
  Topic mum_pip with mumchance "Ask Mumchance about Pip" when true once {
    Says "'Pip,' says Mumchance, and something in the white face moves. 'She falls well. She has learned the fall. She has not learned the get-up, which is the hard part, and the funny part.' He looks across at the ring, where Pip is falling off a barrel on purpose. 'She wants to be famous. That's all right. I wanted to be famous. Then I wanted to be good. Then I wanted to be kind, and that's when I got funny.' He blots his lip. 'She'll go, one day. Somebody ought to take her and show her the world. Somebody who'll bring her back.'".
  }
  Topic mum_knees with mumchance "Ask Mumchance how he does, at his age, in the ring" when true once {
    Says "Mumchance rubs his knee. 'The knees,' he says, 'are seventy. The rest of me is forty, and the face is nine.' He is quiet. 'The Colonel has been looking at clowns. Young ones, at other circuses. He thinks I don't know. He put my name smaller on the bills this year: MUMCHANCE THE SILENT, under THE BROTHERS QUINCEY, in the size of type they use for the price of children.' He goes back to his mirror. 'Honoria makes me a liniment. It smells of a horse's funeral. It works, if somebody will buy the camphor.'".
    On discuss { Assert knows(actor, knees_known). }
  }
  Entity knees_known: fact "Mumchance's knees are bad; Honoria Bulstrode makes him a liniment, if somebody will buy the camphor for it.".

  // ── Pip Gallant ──────────────────────────────────────────────────────────────────────────────────────────────
  Topic pip_dream with pip "Ask Pip what kind of clown she means to be" when true once {
    Says "'A loud one,' says Pip at once. 'A loud, big, enormous one, with a trick bicycle and a goose. Mumchance says the silence is the thing, and I believe him, I do, only I can't do it. I open my mouth and things come out of it.' She juggles three oranges, drops two and catches the third on her nose. 'He says I'll find my own way. I'd like to find it somewhere else than {town_c}, that's all. I've been to {town_c} eleven times and the cross has never once done anything.'".
    On discuss { Increase regard(pip) by 1. }
  }
  Topic pip_quinceys with pip "Ask Pip why the Brothers Quincey are not speaking" when not feudMended(hal) once {
    Says "'The Quincey Turn,' says Pip, rolling her eyes so hard she nearly falls over. 'Their famous somersault: two of you, back to back, over each other, at the same time, like a wheel. They both say they invented it. Hal says he dreamed it, Dunstan says he worked it out on paper. They've not said a word to each other for three weeks, they send messages through me, and now their pyramid falls down every night. Hal says tell Dunstan his left foot's late. Dunstan says tell Hal his left foot can go to the devil.' She sighs. 'I'm a ring-girl, not a post office.'".
    On discuss { Assert knows(actor, feud_known). }
  }
  Entity feud_known: fact "The Brothers Quincey have not spoken for three weeks: each claims to have invented the Quincey Turn, and their act falls apart nightly.".
  Topic mum_pip_go with mumchance "Ask Mumchance whether Pip might come with you for a while, and see the world" when fallLearned(actor) and regard(pip) >= 2 and not willing(pip, actor) and not travelsWith(pip, actor) once {
    Says "Mumchance does not answer at once. He finishes the line of his eyebrow, and looks at it, and wipes it off, and does it again. 'I said somebody ought to take her,' he says. 'Somebody who'd bring her back.' He puts the brush down. 'She can fall. She can't get up yet. The world's where you learn to get up.' He turns on his bucket and looks at you, the whole white face. 'Bring her back funnier. And bring her back.'".
    On discuss { Assert willing(pip, actor). Set hire(pip) to 0. }
  }
  Topic pip_road with pip travelling "Ask Pip what she makes of the road" when travelsWith(pip, actor) {
    Says "'It's bigger than I thought,' says Pip. 'It just keeps going. In the circus the world's always forty-two feet across.' She practises a fall off a stile, lands, and gets up thinking. 'Mumchance said the get-up's the funny part. I think I see. You fall, and the world waits to see what you'll do about it, and what you do about it is the joke.'".
  }

  // ── Zéphyrine ────────────────────────────────────────────────────────────────────────────────────────────────
  Topic zeph_wire with zephyrine "Ask Zéphyrine what it is like on the wire" when knows(actor, zephyrine_named) once {
    Says "'Quiet,' says Zéphyrine. 'Everything below is noise and smell and people eating oranges, and up there is a line as wide as your finger and nothing else in the world. One does not walk the wire. One agrees with it.' She tightens the linen round her ankle. 'I am going to walk across a river one day, from a steeple to a field, with all the town underneath with their mouths open. The Ascension, they will call it. I have the rope ordered. I do not have the steeple.'".
    On discuss { Increase regard(zephyrine) by 1. Assert knows(actor, ascension_known). }
  }
  Entity ascension_known: fact "Zéphyrine dreams of the Ascension: a wire from a steeple to a field, over the heads of a whole town.".
  Topic zeph_where with zephyrine "Ask Zéphyrine where she comes from" when knows(actor, zephyrine_named) once {
    Says "'From the East,' says Zéphyrine. A pause. 'From a long way east.' Another pause. 'The east of somewhere.' She looks away from you, toward the road, and her accent for a moment goes somewhere else entirely, somewhere with tripe in it. 'Excuse me. I must warm up.'".
    On discuss { Assert knows(actor, zeph_evasive). }
  }
  Entity zeph_evasive: fact "Zéphyrine will not say where she comes from, and when she is pressed her accent slips toward somewhere much nearer than the East.".

  // ── The Brothers Quincey ──────────────────────────────────────────────────────────────────────────────────────
  Topic hal_turn with hal "Ask Hal about the Quincey Turn" when true once {
    Says "'I dreamed it,' says Hal. 'Eleven years old, in the loft of the Waggoner at Dunmere: two of us, back to back, over and over, like the spokes of a wheel. I woke up and I knew how. I showed him in the morning, and he got out a slate and drew a picture of it, and now he says the picture came first.' He does a furious back-flip. 'You can't draw a somersault. You can't draw a dream. Tell him that. No, don't tell him that. Don't tell him anything. I'm not speaking to him.'".
  }
  Topic dun_turn with dunstan "Ask Dunstan about the Quincey Turn" when true once {
    Says "'I worked it out,' says Dunstan. 'On the slate, in the loft of the Waggoner at Dunmere. Angles. Where the weight goes, where the hands go, which foot leaves first. You can't dream a thing like that, you'd break your neck. He'd been dreaming about it, that's true; he'd been dreaming about it for a year and falling on his head.' He stretches. 'Our father used to say we'd fight over the last breath in the room. He'd know what to do. He'd bang our heads together.'".
    On discuss { Assert knows(actor, father_quincey). }
  }
  Entity father_quincey: fact "The Brothers Quincey's late father would have known how to settle their quarrel over the Quincey Turn.".

  // ── Honoria Bulstrode ─────────────────────────────────────────────────────────────────────────────────────────
  Topic hon_strength with honoria "Ask Honoria how she came to be the Ox of Abernant" when true once {
    Says "'Abernant's a quarry town,' says Honoria. 'My father cut slate. When I was fourteen the slate-cart went over on the quarry road with my brother under it, and I lifted it. That's all. I didn't know I could till I did.' She stirs the pot. 'The Colonel heard about it in a tavern and came to Abernant with a contract and a bunch of violets. I lift Bucephalus now, every night, on a platform, and he hates it, and he lets me, because I give him the end of the bread.'".
    On discuss { Increase regard(honoria) by 1. }
  }
  Topic hon_teashop with honoria "Ask Honoria what she is saving for" when regard(honoria) >= 1 once {
    Says "Honoria lifts the lid of a tea-caddy on the shelf of the cookhouse wagon and shows you, very shyly, the coins in it. 'A tea-shop,' she says. 'With a bow window, and a bell on the door, and little cakes in rows. Somewhere I never have to lift anything heavier than a pot.' She puts the lid back. 'Another eight years, at this rate. Mumchance says he'll come and sit in the window and frighten off the customers.' She goes pink. 'He's an old fool. We were nearly married once, you know. In Wakeham. Then the bridge washed out, and the circus went round by Marlow, and somehow we never got back to it.'".
    On discuss { Assert knows(actor, honoria_mumchance). }
  }
  Entity honoria_mumchance: fact "Honoria Bulstrode and Mumchance were nearly married once, at Wakeham, and somehow never got back to it.".
  Topic hon_larder with honoria "Ask Honoria how the larder stands" when true {
    Says "'{larder(wapshotts)} days,' says Honoria, 'if nobody has seconds, and everybody has seconds.' She tips her head at the town. 'I buy what I can off {merchant_a} and the rest, at whatever price the Colonel has agreed to, which is always the first one they say. If somebody could talk them down, I'd cook them a pie in the shape of their own head.'".
  }

  // ── Signor Fipps ─────────────────────────────────────────────────────────────────────────────────────────────
  Topic fipps_overture with fipps "Ask Fipps what he is writing on the backs of the playbills" when true once {
    Says "'The Grand Circus Overture,' says Fipps reverently, 'in four movements, for a band of twenty. The Entry of the Horses. The Ascent. The Fall of the Clown. The Apotheosis.' He sighs. 'We are a band of three. I have arranged it for three. The Apotheosis is mostly drum.' He polishes the serpent. 'And she won't play the low G, which is the note the whole Apotheosis turns on. A new serpent, from a proper maker, is twenty coin. I have asked the Colonel for a serpent eleven times.'".
    On discuss { Assert knows(actor, fipps_serpent). }
  }
  Entity fipps_serpent: fact "Signor Fipps, the bandmaster, needs a new serpent, a bass horn, because his old one will not play the low G; he has asked the Colonel for one eleven times.".

  // ── Lucius Hench ─────────────────────────────────────────────────────────────────────────────────────────────
  Topic hench_court with hench "Ask Hench about his years with the Margravine" when true once {
    Says "'Eleven years,' says Hench, threading a needle without looking at it. 'Her Grace of Oster. I dressed her for two weddings, three funerals, a christening and a war. I know the order of precedence of every coronet from here to the sea, how to bow to a margrave, an archduke and a dowager who is all three, and which fork.' He bites the thread. 'Then she married a man who liked his own valet, and I went for a walk, and the walk ended here. I now dress a horse.' A pause. 'He has better posture than the Margrave.'".
    On discuss { Assert knows(actor, hench_court). }
  }
  Topic hench_progress with hench "Ask Hench whether the old courts ever went travelling" when knows(actor, hench_court) once {
    Says "'The old kings did nothing else,' says Hench. 'The Household of the Progress: the whole court on the roads from spring to Michaelmas, two hundred wagons, a chapel on wheels, the Treasury in an iron cart, and the Menagerie Royal behind it all in cages, so that the country could see what the king owned. A crowned wheel on every wagon.' He bites a thread. 'They went round, my dear, exactly as we go round, only with archbishops instead of Quinceys. The last Progress was three hundred years ago. The Household still exists, on paper, in a house near the sea, with a Steward and no wagons.' He smooths the bodice on his knee. 'I have sometimes thought the Colonel was born three hundred years too late, and on the wrong side of the wheel.'".
    On discuss { Assert knows(actor, progress_known). }
  }
  Entity progress_known: fact "The old kings' Household of the Progress went round the country with two hundred wagons and the Menagerie Royal, under a crowned wheel; it still exists, on paper, with a Steward and no wagons.".
  Entity hench_court: fact "Lucius Hench, Wapshott's wardrobe-master, was eleven years valet to the Margravine of Oster, and knows the forms of every court.".
  Topic hench_owed with hench "Ask Hench how the wardrobe does" when true once {
    Says "'Spangles,' says Hench, 'are the curse of my life. They come off in the ring, and the ring eats them, and I sew them back, and the Colonel does not pay for the gold braid, which I bought in {town_a} on my own account last spring and have not been paid for since.' He holds up a tumbler's jersey with a rent in it from collar to hip. 'One of the Quinceys. They tear each other's costumes now, on the turn, out of spite, and pretend it is the other's fault, and I am to make them whole by seven.'".
  }

  Topic mum_slee with mumchance "Ask Mumchance what he makes of Varney Slee" when knows(actor, slee_named) once {
    Says "'He makes things easy,' says Mumchance. 'He told me so. He told Hal he could make the Turn easy for him, at the Hippodrome, with a net.' He is quiet. 'Everything worth doing in this tent is hard. The fall's easy. Anybody falls. The get-up's hard. A man who makes things easy is a man who has never got up.' He looks at his knee. 'Mind, I've known some very nice men with nets.'".
  }

  // ── Gideon Lusk ──────────────────────────────────────────────────────────────────────────────────────────────
  Topic lusk_canvas with lusk "Ask Lusk how the canvas is" when true {
    Says "Lusk looks up at the big top for a long time. 'Old,' he says. Then: 'Rotten at the seams, two places.' Then, because you are still there: '{canvas(wapshotts)} of three. Every strike takes it down a bit. Rain on a bad seam, and the house gets wet, and a wet house goes home.' He picks up a palm and needle as big as a dagger. 'Somebody who can mend could help. Somebody who'd sit up here with me an hour.'".
  }
  Topic lusk_lads with lusk "Ask Lusk about his canvasmen" when true once {
    Says "'Eight lads,' says Lusk. 'Good lads.' A long silence. 'Owed.' He drives a stake in with one blow. 'Ten coin a stand, for all of us, at the strike. If it's not paid, they'll put the big top up, because they're good lads. If it's not paid twice, they won't, because they're not fools.'".
  }
  Topic lusk_nell with lusk "Ask Lusk whether he has family" when regard(lusk) >= 1 once {
    Says "Lusk stops working, which you have not seen him do. 'Nell,' he says. 'Eight. Lives with her gran in {town_b}.' He takes a folded paper out of his shirt: a child's drawing of a very large man and a very small tent. 'I see her three days every round. She wants to come with the wagons. Her gran says no circus. Her gran's right.' He folds it up again, carefully, along the same old creases. 'Her gran's always right. It's a terrible thing in a woman.'".
    On discuss { Assert knows(actor, nell_known). }
  }
  Entity nell_known: fact "Gideon Lusk's daughter Nell, eight, lives with her grandmother in {town_b} and longs to go with the wagons; her grandmother says no circus.".

  // ── Nance Tibbet ─────────────────────────────────────────────────────────────────────────────────────────────
  Topic nance_fortune with nance "Ask Nance to tell your fortune, for a coin" when quantity(actor, gold) >= 1 and not toldFortune(actor) once {
    Says "Nance takes your coin, and your hand, and does not look at the hand at all; she looks at your face, the way a horse-coper looks at teeth. 'You'll go a long way,' she says, 'and most of it on foot. You'll meet a tall man who talks too much, and a quiet one who doesn't talk enough, and you'll have to choose which to believe, and you'll be wrong, and it'll come out right.' She lets go. 'That's the fortune. Here's the free part: the brothers in tights want their heads knocked together, the girl on the wire wants her mother, and the Colonel wants a camel. Everybody in this circus wants something, dearie, except the horse. The horse has everything.'".
    On discuss { Decrease quantity(actor, gold) by 1. Increase quantity(nance, gold) by 1. Assert toldFortune(actor). }
  }
  Relation toldFortune(group).
  Topic nance_zeph with nance "Ask Nance what she meant about the girl on the wire" when toldFortune(actor) once {
    Says "Nance puffs her pipe. 'Susan Pruett,' she says. 'Don't look like that, I've known since the first night; she sat on my steps and cried and I held her hand and the hand told me nothing and the crying told me everything. Ran away from {town_c} at fifteen with a rope over her shoulder and her mother's tripe-knife, to be something nobody in {town_c} had ever seen. She's never once been home. Every time we come round to {town_c} she has a headache.' She taps out the pipe. 'Her mother's still there. Dresses tripe in the lane behind the green. Never says a word about a daughter. Never misses a night of the circus, either. Sits at the back.'".
    On discuss { Assert knows(actor, susan_pruett). }
  }
  Entity susan_pruett: fact "The Sylph of the Wire is really Susan Pruett of {town_c}, who ran away at fifteen; her mother, a tripe-dresser in {town_c}, still lives there and comes to every show, at the back.".
  Topic nance_trouble with nance "Ask Nance what she sees coming for the circus" when metCircus(actor) once {
    Says "'Money,' says Nance, 'which is what I always see coming, and it never does.' Then she looks at you properly. 'There's a woman who owns the Colonel's debts. Not yet. She will. I've seen her man about the place in a grey hat asking what the canvas is worth. You don't ask what a thing is worth unless you mean to own it.'".
    On discuss { Assert knows(actor, grey_hat). }
  }
  Entity grey_hat: fact "A man in a grey hat has been about Wapshott's, asking what its canvas is worth.".

  // ── Billie Ostrander and Bucephalus ──────────────────────────────────────────────────────────────────────────
  Topic billie_horse with billie "Ask Billie about Bucephalus" when true once {
    Says "'Twenty-six,' says Billie. 'Bought from a knacker's yard at nine for the price of his hide, and he has never forgiven anybody. He knows every cue in the show. He knows them better than the Colonel. If the band plays wrong, he stops dead in the ring and looks at Fipps until Fipps plays right.' She runs a hand down his neck. 'He's the only one in this circus that's never been paid and never once complained. That's breeding.'".
  }
  Topic billie_beasts with billie "Ask Billie what she thinks of the Colonel's menagerie" when knows(actor, wapshott_dreams) once {
    Says "Billie's jaw sets. 'I think,' she says, 'that a beast in a box is a sad thing and a beast in a dirty box is a wicked one, and that the Colonel has never in his life cleaned out a box.' She goes on grooming. 'If he does it, I'll keep them. Somebody has to. They'll be kept right, or I'll go. And anything that talks back,' she says, 'talks to me first.'".
    On discuss { Increase regard(billie) by 1. }
  }
  Action pat_bucephalus(actor: group, site: place) "Offer Bucephalus the heel of a loaf" {
    Time 0.
    Requires able(actor) and at(actor, site) and at(bucephalus, site) and not patted(bucephalus).
    On success { Assert patted(bucephalus). Increase regard(billie) by 1. }
    Result "Bucephalus considers the bread for a long time, as if it were a petition. Then he takes it, with lips like a velvet purse, and lets you stand beside him while he eats it, which Billie says afterwards is more than he lets the Colonel do.".
  }
  Relation patted(group).

  // ── Sidney Quirk ─────────────────────────────────────────────────────────────────────────────────────────────
  Topic quirk_bills with quirk "Ask Quirk about his bills" when true once {
    Says "'A bill,' says Quirk, pasting as he talks, 'is the circus before the circus. People see it on Tuesday and they've been to the show in their heads by Thursday, and on Friday they come to see if it's as good as the one they had.' He slaps one onto a gatepost. 'Every bill I put up's a coin at the flap. Every one somebody tears down is a coin I'll never see.' He lowers his voice. 'Somebody's been tearing them down. Ahead of me, behind me. Pasting over them with gold and blue.'".
    On discuss { Assert knows(actor, bills_torn). }
  }
  Entity bills_torn: fact "Somebody has been pasting over Wapshott's bills with Sallow's Imperial Hippodrome's, gold and blue.".

  // Talk among them, as the company stands by: what one says of another.
  Rule overheard_hench near hench when at(party, ?r) and at(hench, ?r) and at(hal, ?r) and not overheardHench(party)
    says "'Your knee's out again,' Hench says to Hal Quincey, without looking up from his needle. 'Not your knee, your costume. Though now I look, your knee as well.'" { Assert overheardHench(party). }
  Relation overheardHench(group).
  Rule overheard_cook near honoria when at(party, ?r) and at(honoria, ?r) and at(mumchance, ?r) and not overheardCook(party)
    says "'You've not eaten,' Honoria says to Mumchance. 'I've eaten,' says Mumchance. 'You've not eaten properly,' says Honoria, and gives him a bowl, and he eats it, and neither of them says anything else, and it is the most married thing you have ever seen." { Assert overheardCook(party). }
  Relation overheardCook(group).
  Rule overheard_ada near ada when at(party, ?r) and at(ada, ?r) and at(wapshott, ?r) and not overheardAda(party)
    says "'Ada,' says the Colonel, 'I have had an idea.' 'No,' says Ada. 'You haven't heard it.' 'I don't need to hear it, I can see its shadow.'" { Assert overheardAda(party). }
  Relation overheardAda(group).
}
