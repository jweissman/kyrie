Module circus "Wapshott's Peregrine Circus" {
  // ── Act IV.iii: the Sundial ──────────────────────────────────────────────────────────────────────────────────────
  // Eleven days each way, the longest the circus has ever been off its wagons. A brig of ninety tons with a dead
  // captain's name still on her papers; a mate made master by a fever; a crew who think the voyage is mad and are
  // paid enough not to say so; a naturalist with a contract; a showman who cannot be seen to be afraid. The days are
  // told in three scenes: the clauses read aloud, the storm, the calm.
  Place sundial "The brig Sundial" is region.
  Place ship "the brig Sundial" is wilderness within sundial at 0, 0.
  Place deck "the Sundial's deck" is room within ship at 0, 0 outdoors.
  Place hold "the Sundial's hold" is room within ship at 1, 0.
  Place great_cabin "the great cabin" is room within ship at 2, 0.
  Relation berthA(concern). Relation berthS(concern). Relation atSea(concern). Relation outward(concern). Relation homeward(concern).
  Relation stormOn(concern). Relation stormDone(concern). Relation calmDone(concern). Relation lashed(group). Relation clausesRead(concern).
  Relation colonelCovered(concern). Relation colonelNamedFear(concern). Relation vanceKnown(concern). Relation billieSat(concern).
  Measure sailDay(concern). Measure stormAt(concern).

  Rule berth_set when voyageReady(wapshotts) and not berthA(wapshotts) and not berthS(wapshotts) and not atSea(wapshotts) and not voyaged(wapshotts) { Assert berthA(wapshotts). }
  Passage gangway_a "the Sundial's gangway" is passage between green_a and deck
    opening when berthA(wapshotts) "The quay is empty but for a heap of rope and a gull.".
  Passage gangway_s "the gangway to the Progress's quay" is passage between deck and landing
    opening when berthS(wapshotts) "The Sundial rides far out, and between her and the island there is nothing but water.".

  Observe deck_scene at deck when true "The Sundial is a brig of ninety tons, tarred, patched and spotless, with SUNDIAL cut over her taffrail and under it the name of a captain who is dead. Her crew of nine go about their work in a silence that is not hostile. The mate, who is her master now, keeps one hand on the rail as if it were someone's shoulder.".
  Observe hold_scene at hold when true "The hold smells of tar and bilge and the biscuit of a long voyage. Cages are stowed along both sides, empty, with fresh straw, built to Billie's measure in the fair town in a week; at the after end, lashed down, a big case of lamp-black and spirit that Sir Gervase calls his apparatus.".
  Observe great_cabin_scene at great_cabin when true "A low cabin lit by a stern window, with a table nailed to the floor, a chart of the Southern Sea pinned over it, and a litter of Sir Gervase's papers weighted with a beetle in a box. The chart stops, at its bottom edge, in a drawn hand that points off the paper.".
  Passage deck_hold "the hatch to the hold" is passage between deck and hold.
  Passage deck_cabin "the cabin door" is door between deck and great_cabin.

  Rule aboard at deck when at(party, deck) and voyageReady(wapshotts) and not voyaged(wapshotts) and wapshottAboard(wapshotts)
    says "The gangway comes in with a thump. The Colonel stands on the deck of the Sundial in his best coat with his hat held in front of him like a plate, and Ada Thripp, on the quay, with her pen behind her ear, lifts one hand and lets it drop. The mate says, to nobody, 'Mind your heads in the hatch.' You are, for the first time since the Fair, not on the circus's ground. Nobody has told the wagons." {
    Assert voyaged(wapshotts). Assert away(wapshott). Assert at(wapshott, deck). Assert following(wapshott, party).
    Assert away(fenwick). Assert at(fenwick, deck). Assert following(fenwick, party). Assert away(crewe). Assert at(crewe, deck).

    Increase quantity(party, rations) by 12. }
  Rule aboard_billie when at(party, deck) and voyaged(wapshotts) and billieAboard(wapshotts) and not away(billie) { Assert away(billie). Assert at(billie, deck). Assert following(billie, party). }
  Rule aboard_mumchance when at(party, deck) and voyaged(wapshotts) and mumchanceAboard(wapshotts) and not away(mumchance) { Assert away(mumchance). Assert at(mumchance, deck). Assert following(mumchance, party). }
  Rule circus_lies_up when voyaged(wapshotts) and not backFromSarn(wapshotts) and moveDay(wapshotts) < day(clock) + 2 { Set moveDay(wapshotts) to day(clock) + 3. }

  Action cast_off_out(actor: group, site: place) "Ask Mate Crewe to cast off for Sarn on the morning ebb" {
    Speaker crewe.
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, deck) and voyaged(wapshotts) and berthA(wapshotts) and not homeward(wapshotts) and not outward(wapshotts).
    Time 0.
    On success { Retract berthA(wapshotts). Assert atSea(wapshotts). Assert outward(wapshotts). Set sailDay(wapshotts) to day(clock). }
    Result "'Let go for'ard,' says Crewe, in a voice you have not heard from him, and the quay slides away: Ada, the heap of rope, the gull, the fair town's roofs with the Hippodrome's flag at the far end of them, going down one by one behind the Sundial's wake. The Colonel does not wave. He stands with his hat on and his chin up, like a man going on in the ring.".
  }
  Rule landfall_out when atSea(wapshotts) and outward(wapshotts) and day(clock) >= sailDay(wapshotts) + 11 and hour(clock) >= 6 {
    Retract atSea(wapshotts). Assert berthS(wapshotts). }
  Rule landfall_home when atSea(wapshotts) and homeward(wapshotts) and day(clock) >= sailDay(wapshotts) + 11 and hour(clock) >= 6 {
    Retract atSea(wapshotts). Assert berthA(wapshotts). }
  Observe at_sea_out at deck when atSea(wapshotts) and outward(wapshotts) and not stormDone(wapshotts) "Nothing but water, in every direction, for the ninth hour of the third day. The log says eleven days. The wind says it will do as it likes.".
  Observe at_sea_after at deck when atSea(wapshotts) and outward(wapshotts) and stormDone(wapshotts) "The sea has gone the colour of slate, and the sky has been wrung out. Somewhere under the keel the bottom falls away to a depth that has no number.".
  Observe land_out at deck when berthS(wapshotts) "Land at last, a green line on the south horizon that does not move like a cloud. The smell comes out to meet you before the sight: wet earth, eggs, rot, hot stone, and the sweetness of an enormous number of flowers. A quay of cut stone stands at the mouth of a bay, with a post on it, and a wheel on the post.".
  Observe land_home at deck when berthA(wapshotts) and homeward(wapshotts) "The fair town's roofs, and the flag of the Hippodrome, and on the quay a heap of rope and a gull. Ada is not there. Ada, you will learn, has not left the ticket wagon in eleven days.".

  // The contract, as the cabin has it.
  Topic fenwick_clauses with fenwick "Ask Sir Gervase what he has signed the Colonel to" when atSea(wapshotts) and outward(wapshotts) and not clausesRead(wapshotts) once {
    Says "'A pair of everything,' says Sir Gervase, 'living where possible, in spirits where not, and the Colonel's name on the title page, in capitals.' He pats the beetle-box. 'He asked for the capitals.'".
    On discuss { Assert clausesRead(wapshotts). Assert clauseBeasts(wapshotts). }
  }

  // The storm: the Colonel's hands on the rail.
  Rule storm_comes when atSea(wapshotts) and outward(wapshotts) and day(clock) >= sailDay(wapshotts) + 4 and hour(clock) >= 18 and not stormDone(wapshotts) and not stormOn(wapshotts) {
    Assert stormOn(wapshotts). Set stormAt(wapshotts) to watch(clock). }
  Observe storm_scene at deck when stormOn(wapshotts) "The sky to windward has come down to the sea. Crewe shouts for hands to the sheets, and the Sundial lies over until her yards are in the water. Rain like thrown gravel. In the dark, at the lee rail, the Colonel is singing the Galop from the Grand Entry at the top of his voice, with both hands clamped white on the wood.".
  Action lash_down(actor: group, site: place) "Lash yourselves to the main-mast with a rope" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, deck) and stormOn(wapshotts) and holding(actor, rope) and not lashed(party).
    Time 0.
    On success { Assert lashed(party). }
    Result "You pass the line round the mast and round each other, and the sea comes over the rail.".
  }
  Hazard storm_wave "A sea over the rail" means "Deal (3d6) physical damage to ally unless strength save against (14).".
  Rule storm_breaks when stormOn(wapshotts) and watch(clock) >= stormAt(wapshotts) + 6 {
    Retract stormOn(wapshotts). Assert stormDone(wapshotts). Retract lashed(party). }
  Rule storm_strikes at deck when stormOn(wapshotts) and watch(clock) >= stormAt(wapshotts) + 3 and at(party, deck) and not lashed(party) and not stormHit(party)
    says "A green sea comes aboard abeam and takes the deck from end to end." { Assert strikes(storm_wave, party). Assert stormHit(party). }
  Relation stormHit(group).
  Rule storm_clear when stormDone(wapshotts) and stormHit(party) { Retract stormHit(party). }
  Topic wap_fear_cover with wapshott "Say nothing of his hands on the rail, and sing the second verse with him" when stormDone(wapshotts) and not colonelCovered(wapshotts) and not colonelNamedFear(wapshotts) once {
    Says "You pick up the Galop at the second verse, flat, and the Colonel looks at you with a face of such naked gratitude that you have to look at the sea. He does not say one word of the storm. He tells Crewe, loudly and at length, that it was a capital blow, and that in the Peninsula he had seen worse. He has never been to the Peninsula.".
    On discuss { Assert colonelCovered(wapshotts). }
  }
  Topic wap_fear_name with wapshott "Tell the Colonel you saw his hands on the rail, and that it was well done to sing" when stormDone(wapshotts) and not colonelCovered(wapshotts) and not colonelNamedFear(wapshotts) once {
    Says "The Colonel goes still. Then he puts his hat on, straight, and says, 'I was extremely frightened.' It is the first thing you have heard him say in an ordinary voice. 'I have been frightened every night of my life,' he says, 'and it has not once been the right night.' He looks at his hands. 'Do not tell Ada.' He does not speak to you again for a day, and the next morning he brings you tea himself, in the wrong cup, and spills it.".
    On discuss { Assert colonelNamedFear(wapshotts). Increase regard(billie) by 1. }
  }

  // The calm, and the dead captain.
  Rule calm_comes when atSea(wapshotts) and outward(wapshotts) and day(clock) >= sailDay(wapshotts) + 7 and hour(clock) >= 10 and not calmDone(wapshotts) { Assert calmDone(wapshotts). }
  Observe calm_scene at deck when calmDone(wapshotts) and atSea(wapshotts) and outward(wapshotts) "The wind has simply stopped. The sea is a sheet of hot lead; the sails hang like washing. The crew lie in the shade of the boat with their hats over their faces. A turtle, enormous, rides past on the surface with an air of having been invited.".
  Topic crewe_vance with crewe "Ask Mate Crewe about Captain Vance" when calmDone(wapshotts) and atSea(wapshotts) and not vanceKnown(wapshotts) once {
    Says "'Born on Sarn,' says Crewe, after a long time. 'His grandfather was the last Warden. The Wardens stopped being paid the year the Progress was dissolved, and the last of them stayed thirty-one years keeping the books, and put his grandson on a trader at nine, with the Preserve's key round his neck and a note to keep it. The boy kept it forty years. He never went back, because there was nothing to go back to but a rule and a lot of animals. He read your letter at Port Dree. He said, a Keeper, and sat down on a bollard.' Crewe turns his hat. 'He took the last clutch off the beds himself. He said the Keeper had asked, and somebody ought to answer.' He puts the hat on. 'He has the key, the Captain. It's in the cabin. It opens a door that isn't there any more.'".
    On discuss { Assert vanceKnown(wapshotts). Give preserve_key to actor. }
  }
  Kind preserve_key "the Preserve's key" is gear worth 0 weighing 1 described "A bronze key as long as a hand with a crowned wheel for a bow, worn smooth by a boy's chest and a man's. It is the key of the Preserve-house door.".
  Topic billie_rail with billie "Sit with Billie at the rail in the calm" when calmDone(wapshotts) and atSea(wapshotts) and billieAboard(wapshotts) and not billieSat(wapshotts) once {
    Says "'I kept a lion once,' says Billie, to the water. 'At Dunmere. His name was Nebuchadnezzar and I was nineteen, and I used to sit with him in the cage because it was warm. He was blind by then.' She says nothing for some time. 'Every cage I ever kept, I knew the day it would be the last. This is the first time I have gone to a place to see what the cages were for.' She turns her cup. 'I'll tell you what I'm afraid of. That it'll be better than the Colonel's tent, and he'll never forgive it.'".
    On discuss { Assert billieSat(wapshotts). Increase regard(billie) by 1. }
  }

  // Homeward: what was put in the hold.
  Observe hold_specimens at hold when homeward(wapshotts) and takeSpecimens(wapshotts) "The cages along both sides of the hold are full, and nobody has said so. A pair of fern-runners sit pressed together in one, as like two people on a coach as animals can be. The hook-claw's cage is the quiet one.".
  Observe hold_egg at hold when homeward(wapshotts) and takeEgg(wapshotts) "In a basket by the galley stove, wrapped in the Colonel's best coat and a damp cloth, a grey loaf-big egg. Somebody turns it every hour on the hour. It is, for the whole of the crew, a ship's pet.".
  Observe hold_empty at hold when homeward(wapshotts) and takeLeave(wapshotts) "The cages along both sides of the hold are empty, with the straw as fresh as it was. The Colonel, who is sitting among them with his back against a bar, says it is the best hold he has ever been in.".

  Rule hatchlings_aboard when voyaged(wapshotts) and hatchlingsPenned(wapshotts) and not hatchlingsHome(party) and at(hatchlings, ?r) and distinct(?r, hold) {
    Retract travels(hatchlings). Retract post(hatchlings, rk_beasts). Retract at(hatchlings, ?r). Assert at(hatchlings, hold). }
  Rule crew_aboard_home when homeward(wapshotts) and not dead(mudge) and away(mudge) { Retract away(mudge). Assert at(mudge, deck). }
  Rule cook_aboard_home when homeward(wapshotts) and away(nunn) { Retract away(nunn). Assert at(nunn, deck). }
  Rule hull_leaks when homeward(wapshotts) and atSea(wapshotts) and hullHoled(wapshotts) and hour(clock) == 6 and bailedDay(wapshotts) < day(clock) { Set bailedDay(wapshotts) to day(clock). Decrease quantity(party, rations) by 2 or to nothing. }
  Measure bailedDay(concern).
  Observe hull_water at hold when homeward(wapshotts) and hullHoled(wapshotts) "Water slops over the hold floor at every roll, and Mr Mudge is bailing with a cage-bucket, singing.".
  Topic nunn_home with nunn "Ask Aggie what was in the stew" when homeward(wapshotts) and atSea(wapshotts) once {
    Says "'Mr Mudge,' says Aggie, and stirs. 'Mostly.'".
  }
  Rule home_from_sarn at green_a when voyaged(wapshotts) and homeward(wapshotts) and not backFromSarn(wapshotts) and not atSea(wapshotts) and at(party, green_a) {
    Assert backFromSarn(wapshotts). Retract away(wapshott). Retract away(fenwick). Retract away(billie). Retract away(mumchance). Retract away(crewe). Retract away(mudge). Retract away(nunn).
    Retract following(wapshott, party). Retract following(fenwick, party). Retract following(billie, party). Retract following(mumchance, party).
    Set moveDay(wapshotts) to day(clock) + 1. Set homeDay(wapshotts) to day(clock). }
  Measure homeDay(concern).
  Chapter ch_voyage "The Sundial" when within(party, sundial) "Eleven days out, with a naturalist, a showman and a dead man's crew. The wagons are a long way behind.".
  Milestone m_clauses "had the contract read at sea" worth 100 when clausesRead(wapshotts).
  Milestone m_storm "rode out the storm with the Colonel" worth 150 when colonelCovered(wapshotts) or colonelNamedFear(wapshotts).
  Milestone m_vance "learned who Captain Vance was" worth 200 when vanceKnown(wapshotts).
}
