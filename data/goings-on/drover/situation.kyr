Module drover "The drover who did not come home" {
  Description "A drover went out on the road three days ago with a cart and two oxen and did not come home. His dog did, alone, in the night. His wife cooks at the inn and will not talk about it; his son talks of nothing else.".
  Entity party: group "Your company".
  Place green "The green" is room.
  Place taproom "The taproom" is room.
  Place road "The road" is room.
  Relation told(group). Relation gone(group).
  Entity missing: fact "A drover went out on the road from {green} three days ago and did not come home. His dog did.".
  Initially Assert established(missing). Initially Assert staged(road, missing).

  Person wife "The drover's wife" at taproom { Role "the drover's wife, who cooks at the inn". Pronouns she. Peaceable. }
  Person son "The drover's son" at green { Role "the drover's son, who wants to go after his father". Pronouns he. Peaceable. }
  // The dog that came home: a real dog, lame in the off forefoot, who lets anyone who is kind to her look at her; and
  // whoever does sees where she has been.
  Person dog "the grey dog" at green { Role "the drover's dog". Species dog. Pronouns she. Peaceable. }
  Observe dog_waits near dog of dog when not told(wife) and at(dog, green) "A grey dog lies by the door of {taproom} with her head on her paws, watching the road. She holds one forefoot off the ground.".
  Observe dog_in near dog of dog when told(wife) and at(dog, taproom) "The grey dog lies by the kitchen fire with her chin on her paws.".
  Rule dog_goes_in when told(wife) and at(dog, green) { Assert at(dog, taproom). }
  Entity dog_mud: fact "The grey dog came home caked in black ditch-mud, the off forefoot cut as if on iron.".
  Observe dog_tells near dog as sign when petted(dog, party) and not knows(party, dog_mud) "Under your hand her coat is stiff with dried black mud to the belly: ditch-mud, not road dust, as if she had lain a long time somewhere low and wet. The pad of the off forefoot is cut clean across, the way iron cuts." teaches dog_mud.
  Observe dog_muddy near dog of dog as sign when knows(party, dog_mud) and not knows(party, found_cart) "Her coat is stiff with black ditch-mud to the belly.".
  Observe ruts at road when not knows(party, found_cart) "Fresh ruts run off the edge of the road here, where the bank drops away.".

  Discovery found_cart "The drover's cart went off the road in the night. He is under it, a day or more dead, and whatever had the oxen dragged them off toward the hills." {
    Found by searching road "Below the road, where the bank drops away, a cart lies on its side in the ditch with a man under it, a day or more dead. The oxen are gone; something had them, and dragged them off toward the hills.".
  }
  Item knife "a drover's knife with a horn handle" is dagger at road hidden until found_cart.
  // Said while it is so: taken, the knife is no longer in his belt (the follow-up review took it and it stayed).
  Observe knife_belt at road when knows(party, found_cart) and at(knife, road) "His knife is still in his belt.".

  // To one of the family the drover is a father, his wife a mother, his son a brother: they say other things.
  Observe wife_kin near wife when kin(party, wife) and not told(wife) "Your mother is at the hearth with her back to the room.".
  Observe son_kin near son when kin(party, son) and not told(son) and at(son, green) "Your brother is sitting on a rail with your father's old spear across his knees, watching the road. He is taller by a head than when you went away.".
  Observe son_kin_in near son when kin(party, son) and not told(son) and at(son, taproom) "Your brother sits by the kitchen fire with your father's old spear across his knees, not drinking. He is taller by a head than when you went away.".
  // Until he has somewhere to go, the son keeps the green by day and comes in to his mother after dark.
  Rule son_goes_in when dark() and at(son, green) and not willing(son, party) { Assert at(son, taproom). }
  Rule son_comes_out when not dark() and at(son, taproom) and not willing(son, party) { Assert at(son, green). }
  Observe son_kin_ready near son when kin(party, son) and told(son) and not knows(party, found_cart) "Your brother is waiting by the rail with the spear, ready when you are.".
  Observe wife_kin_told near wife when kin(party, wife) and told(wife) "Your mother is at the hearth, at her work, and looks up now and then at the door.".
  Topic wife_where with wife "Ask your mother where he was going" when kin(actor, wife) and not told(wife) once {
    Says "'Out on {road}, with the salt for the reed-cutters,' says your mother, and keeps her eyes on the pot. 'Three days there and back, the way he goes. The dog came home on the fourth, lame in the off foot.' She wipes her hands, though they are dry. 'Nobody will go and look. I am glad you came.'".
  }
  Topic wife_told_kin with wife "Tell your mother what you found on the road" when knows(actor, found_cart) and kin(actor, wife) and not told(wife) once {
    Says "Your mother does not sit down. She takes your face in her hands and looks at it for a long time. 'I knew,' she says. 'The dog knew.' Then she goes back to the pot, because there are people to feed.".
    On discuss { Assert told(wife). }
  }
  Topic son_plan with son "Ask {son} what he means to do" when kin(actor, son) and not knows(actor, found_cart) and not told(son) once {
    Says "'Go after him,' says {son}. 'Mother says wait. I have waited three days.' He looks at you, and at the road. 'If you are going, I am coming with you. If you are not, I am going anyway.'".
    On discuss { Assert willing(son, actor). Assert told(son). }
  }
  // Not to one who knelt by the cart himself: he was there.
  Topic son_found_kin with son "Tell {son} what you found" when knows(actor, found_cart) and kin(actor, son)
    and not knows(actor, son_knelt) once {
    Says "{son} hears it out, and is quiet for a long time. 'Then whatever had the oxen is still out there,' he says. 'I want to see it.'".
    On discuss { Assert willing(son, actor). Assert told(son). }
  }
  Topic wife_husband with wife "Ask {wife} about her husband" when not told(wife) and not kin(actor, wife) once {
    Says "'He went out with the cart three days back,' says {wife}, and keeps her eyes on the pot. 'The dog came home. He didn't.'".
  }
  Topic wife_told with wife "Tell {wife} what you found on the road" when knows(actor, found_cart) and not told(wife) and not kin(actor, wife) once {
    Says "{wife} puts down the ladle and sits. After a while she says, 'I knew. The dog knew.' She takes coin from her apron and puts it in your hand without counting it. 'For going.'".
    On discuss { Assert told(wife). Increase quantity(actor, gold) by 6. }
  }
  Topic wife_knife with wife "Show {wife} her husband's knife" when carries(actor, knife) and told(wife) once {
    Says "She turns the knife over in her hands, and gives it back. 'Keep it. He would want it used, not hung on a wall.'".
  }
  Topic son_father with son "Ask {son} about his father" when not knows(actor, found_cart) and not kin(actor, son) once {
    Says "'Three days,' says {son}. 'Mother says wait. I have waited.' He looks at the road. 'If you are going that way, I will come.'".
  }
  Topic son_found with son "Tell {son} what you found" when knows(actor, found_cart) and not kin(actor, son)
    and not knows(actor, son_knelt) once {
    Says "{son} hears it out. 'Then whatever had the oxen is still out there,' he says. 'I am coming with you. No hire. I want to see it.'".
    On discuss { Assert willing(son, actor). Assert told(son). }
  }
  // Once he has come with you, the son talks on the way: he knows the road his father took, and the cart.
  Topic son_road with son travelling "Ask {son} about the road your father took" when kin(actor, son) and awake(member_son_person) and not knows(actor, found_cart) once {
    Says "'{road}, to market. He knew every rut of it.' {son} kicks at a stone. 'He had the left wheel out of true all spring and would not see to it. If the cart went off the road, look for where a wheel like that would take it.'".
  }
  Topic son_road_stranger with son travelling "Ask {son} about the road his father took" when not kin(actor, son) and awake(member_son_person) and not knows(actor, found_cart) once {
    Says "'{road}, to market,' says {son}. 'He knew it in the dark. The left wheel of the cart was out of true. If it went off the road, that is why.'".
  }
  Topic son_night with son travelling "Sit up late with {son}" when awake(member_son_person) and dark() once {
    Says "'He used to sing to the oxen,' says {son}. 'Terrible songs. He made them up as he went, and they liked them better than anything.' He is quiet a while. 'Mother would not have him sing in the house.'".
  }
  Event son_wheel at road when travelsWith(son, party) and awake(member_son_person) and at(party, road) and not knows(party, found_cart) "{son} stops where the ruts go off the road and stands looking at them. 'That is the left wheel,' he says. 'That is his.'".
  Entity son_knelt: fact "{son} knelt by the cart.".
  Observe son_kneels at road as event when travelsWith(son, party) and awake(member_son_person) and knows(party, found_cart) and not knows(party, son_knelt) "{son} goes down the bank to the cart before anyone can stop him, and kneels there a long time. When he comes back up he has nothing to say, and nobody asks him to." teaches son_knelt.
  // Left alone too long, the son goes out after his father himself.
  Rule son_goes at green when watch(clock) >= 204 and not told(son) and at(son, green) says "{son} has taken his father's old spear and gone out on the road alone. Nobody stopped him." { Retract at(son, green). Assert gone(son). }

  Objective road when knows(party, missing) and not knows(party, found_cart) and not kin(party, wife) "A drover from {green} went out on the road and did not come home.".
  Objective tell when knows(party, found_cart) and not told(wife) and not kin(party, wife) "The drover's wife, at the inn, does not know what you found.".
  Objective road_kin when kin(party, wife) and not knows(party, found_cart) "Your father went out on {road} with the cart, and did not come home.".
  Objective tell_kin when kin(party, wife) and knows(party, found_cart) and not told(wife) "Your mother, at the inn, does not know what you found.".
  Goal told(wife).
}
