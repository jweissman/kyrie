Module fever "A fever on the green" {
  Description "A child in one of the houses on the green has a fever that will not break. The herbs have run out, and there are willows out on the road by the water, if anyone will go. Herbs bought anywhere would do as well.".
  Entity party: group "Your company".
  Place green "The green" is room.
  Place road "The road" is room.
  Relation mended(group). Relation lost(group). Relation offered(group).
  Entity sick: fact "A child on {green} has a fever that will not break, and the herbs have run out.".
  Initially Assert established(sick).

  Person mother "The sick child's mother" at green { Role "a mother with a sick child". Peaceable. Wants herbs. }
  Person sister "The sick child's sister" at green { Role "the sick child's elder sister". Peaceable. }
  Observe shutters at green when not mended(mother) and not lost(mother) "The shutters of one house on the green are drawn in daylight, and a woman stands in its door, watching the road.".
  Observe mended_scene at green when mended(mother) "The shutters of the house on the green are open, and a child's voice comes out of it, complaining.".
  Observe lost_scene at green when lost(mother) "The shutters of the house on the green stay drawn, and there are flowers on the step.".
  Observe willows at road when not knows(party, bark_found) "Willows lean over the water below the road.".

  Discovery bark_found "Willow bark breaks a fever; there is plenty below the road." {
    Found by searching road "Below the road the willows grow thick along the water. The bark comes away in long strips: bitter, good for a fever.".
  }
  Item bark "a bundle of willow bark" is herbs at road hidden until bark_found.

  Topic mother_child with mother "Ask {mother} about the child" when not mended(mother) and not lost(mother) once {
    Says "'Three days,' says {mother}. 'Hot as a stone in the sun, and the herb-wife has nothing left. There were willows out on the road, by the water, when I was a girl.' She looks at you. 'I cannot leave her.'".
  }
  // Whatever herbs are given her, she uses.
  Rule mended_by when keeps(mother, ?i) and not mended(mother) and not lost(mother) says "{mother} takes the herbs inside without a word. By evening the fever has broken." { Assert mended(mother). }
  Rule lost_child when watch(clock) >= 240 and not mended(mother) and not lost(mother) says "In the morning the shrine bell is rung once, slowly. The child on the green has died." { Assert lost(mother). }

  Topic sister_thanks with sister "Speak with {sister}" when mended(mother) and not offered(sister) once {
    Says "'She is eating,' says {sister}, as if she does not believe it. 'You went when nobody else would. If you are going on, I will come. I can pull my weight.'".
    On discuss { Assert offered(sister). Assert willing(sister, actor). }
  }
  Topic sister_lost with sister "Speak with {sister}" when lost(mother) once {
    Says "{sister} does not look up. 'You came through here,' she says. 'Everybody comes through here.'".
  }

  Objective herbs when knows(party, sick) and not mended(mother) and not lost(mother) "A child on {green} has a fever; it needs herbs, or willow bark from the road.".
  Goal mended(mother).
}
