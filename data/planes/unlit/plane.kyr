Module unlit "The Unlit" {
  Description "The cellar of the world, where the Lamplighters laid down their light: a country of ash under no sky, where nothing shines but what is carried in and fire burns small and cold. Their beacons stood at its doors. The last of their wardens is dead and not gone, and still counts what he kept when the doors were shut.".
  Entity party: group "Your company".
  // Where its doors open in the Varrow, and the Unlight whose going showed the first of them.
  Place deep_cellar "The Lanthorn's deep cellar" is room.
  Place far_shore "The far shore of the still lake" is room.
  Entity unlight: scenery "The Unlight". Entity unlight_gone: condition "gone".

  Place unlit "the Unlit" is plane.
  Place cellarlands "the Cellarlands" is region within unlit.
  Place ash "the Ash" is wilderness within cellarlands at 0, 0.
  Place lampfall "Lampfall" is site within cellarlands at 1, 0.
  Place lampfall_court "the outer court" is level within lampfall.
  Place lampfall_keep "the keep" is level within lampfall.
  Place lampfall_tower "the beacon tower" is level within lampfall.
  Place veil_foot "the foot of the veil" is room within ash at 0, 1.
  Place ash_road "the ash road" is room within ash at 1, 1.
  Place cinders "the cinder hollow" is room within ash at 1, 2.
  Place mere_edge "the edge of the Ash Mere" is room within ash at 2, 2.
  Place drowned_stair "the head of the drowned stair" is room within ash at 3, 2.
  Place arch "the Arch of Ways" is room within ash at 2, 0.
  Place lamp_door "the Lamplighters' door" is room within ash at 3, 0.
  Place gate_ward "the gate ward of Lampfall" is room within lampfall_court at 0, 0.
  Place ledger_hall "the ledger hall" is room within lampfall_keep at 0, 0.
  Place jar_vault "the jar vault" is room within lampfall_keep at 1, 0.
  Place beacon_room "the beacon room" is room within lampfall_tower at 0, 0.
  Initially Assert law(unlit, unlit_law). Entity unlit_law: law "the Unlit's law". Entity beacon_law: law "under the beacon".
  Initially Assert lightless(veil_foot). Initially Assert lightless(ash_road). Initially Assert lightless(cinders).
  Initially Assert lightless(mere_edge). Initially Assert lightless(drowned_stair). Initially Assert lightless(arch).
  Initially Assert lightless(lamp_door). Initially Assert lightless(gate_ward). Initially Assert lightless(ledger_hall).
  Initially Assert lightless(jar_vault). Initially Assert lightless(beacon_room).

  // The veil: under the scorch the Unlight left, the floor of the deep cellar is thin. It cannot be seen until the
  // Unlight is gone, and cannot be passed without sunlight to see by on the other side.
  Discovery veil_known "Where the Unlight was, the deep cellar's floor is thin as a curtain: there is somewhere else under it, and the Lamplighters' writing on the walls is a warning about what." {
    Found by searching deep_cellar "Where the scorch is, the floor gives under your hand like cloth, and through it comes a cold that has never been warm.".
  }
  Passage veil "the veil under the deep cellar" is portal between deep_cellar and veil_foot taking 1 hour hidden until veil_known needing sunlight.
  Thing unlight_stain "the dark over the veil" on veil {
    State filled blocking "The Unlight sits on the place where the floor is thin.".
    State clear "Nothing sits over the scorch now.".
  }
  Rule veil_clears when state(unlight, unlight_gone) and state(unlight_stain, filled) { Assert state(unlight_stain, clear). }
  // The drowned stair: the Lamplighters' other door, under the still lake, found from either side by looking hard.
  Discovery mere_way_known "Under the still lake a stair goes down, and on down, out of the water and into the Unlit: the Lamplighters' back door, which the Glimmerkin's boatmen will not pole over." {
    Found by searching far_shore "Where the jars lie smashed, steps go down into the lake, cut in the rock, and the water over them is not as deep as it is black.".
    Found by searching drowned_stair "The stair goes on up into still black water, and very far up there is a little green light, a Glimmerkin jar.".
  }
  Passage drowned_way "the drowned stair" is portal between far_shore and drowned_stair taking 2 hours hidden until mere_way_known.

  Passage ash_way "the ash road" is road between veil_foot and ash_road taking 2 hours.
  Passage cinder_way "the slope of the cinder hollow" is path between ash_road and cinders taking 1 hour.
  Passage mere_way "the mere path" is path between cinders and mere_edge taking 1 hour.
  Passage shore_walk "the shore of the Ash Mere" is path between mere_edge and drowned_stair taking 1 hour.
  Passage arch_way "the Arch road" is road between ash_road and arch taking 2 hours.
  Passage door_walk "the walk under the Arch" is path between arch and lamp_door taking 30 minutes.
  Passage lampfall_way "Lampfall's causeway" is causeway between ash_road and gate_ward taking 1 hour.
  Passage keep_door "the keep door" is door between gate_ward and ledger_hall.
  Passage vault_door "the vault door" is door between ledger_hall and jar_vault.
  Passage beacon_stair "the beacon stair" is stair between ledger_hall and beacon_room.

  Observe veil_scene at veil_foot when true "You stand on ash under no sky. Above you, very far up, the Lanthorn's cellar is a pale smudge, like a window seen from the bottom of a well. Your light falls a few feet and stops.".
  Observe road_scene at ash_road when true "A road of laid stone runs across the ash, lamp-posts every hundred paces, every lamp dead. Far off to one side something stands up out of the plain with a tower on it.".
  Observe cinder_scene at cinders when true "A hollow full of cinders that were once something else: furniture, books, a cart. Things move at the edge of your light and are gone.".
  Observe mere_scene at mere_edge when true "The Ash Mere: a lake of fine grey dust, flat as water, going off into the dark. Here and there it dimples, as if something under it breathed.".
  Observe stair_scene at drowned_stair when true "Steps come up out of the dust here, wet, as if from under water. Above them the dark is a little less dark.".
  Observe arch_scene at arch when true "A great arch stands by itself on the plain, carved all over with lamps. Something hangs in it like a spider in a doorway: a round body of plates, and too many eyes, and every eye turned on you.".
  Observe door_scene at lamp_door when true "Past the arch, a door stands in the ash with no wall round it: oak, iron-bound, a brass lamp-and-hand on it, a keyhole the shape of a seal.".
  Observe gate_scene at gate_ward when true "Lampfall's gate stands open. Inside, the outer court is full of lamp-posts in rows like an orchard, all dead.".
  Observe hall_scene at ledger_hall when true "The ledger hall: shelves of ledgers to a ceiling lost in dark, and at a desk in the middle something in a Lamplighter's robes writing by no light at all.".
  Observe vault_scene at jar_vault when true "The jar vault: racks of jars, most of them dark, a few still burning low, like coals at the end of a night.".
  Observe beacon_scene at beacon_room when not kindled_here(beacon_room) "The beacon room: a cradle of mirrors around an empty bowl, and a shaft above it going up into nothing.".
  Observe beacon_lit at beacon_room when kindled_here(beacon_room) "The beacon burns in Lampfall's cradle, and the mirrors throw noon across the Ash as far as you can see.".

  // The shades: what is left of those who came down after light and did not go back. They keep away from the living,
  // and cannot bear the sun; cornered in their hollow they fight.
  Person shades "the shades" at ash_road {
    Role "the grey dead of the Ash". Species spirit. Level 6. Numbers 4.
  }
  Initially Assert temperament(shades, temper_wary). Initially Assert refuge(shades, cinders).
  Initially Assert fears(shades, sunlight). Initially Assert flinch(shades, shades_flee). Initially Assert onslaught(shades, shades_turn).
  Entity shades_flee: fact "Grey shapes that were watching you from the edge of your light draw back into the dark, toward the cinder hollow.".
  Entity shades_turn: fact "In the cinder hollow there is nowhere left for the shades to go. They come at you out of the cinders, cold as wells.".
  // The wraiths ride the road: they fall on whatever is on it, and go up and down it all the time.
  Person wraiths "the wraith riders" at arch {
    Role "the riders of the ash road". Species wraith. Level 9. Numbers 3.
  }
  Initially Assert temperament(wraiths, temper_savage). Initially Assert onslaught(wraiths, wraiths_come).
  Entity wraiths_come: fact "Out of the dark along the road, three riders without faces, on horses made of nothing, come at you at a gallop.".
  Rule wraiths_ride when at(wraiths, arch) and able(wraiths) and not together(wraiths, party) and dice(clock) <= 15 { Assert at(wraiths, ash_road). }
  Rule wraiths_return when at(wraiths, ash_road) and able(wraiths) and not together(wraiths, party) and dice(clock) <= 15 { Assert at(wraiths, arch). }
  // The Mere's mouth: it lies under the dust and strikes, unless someone sees the dust breathe first.
  Person mouther "the thing under the Mere" at mere_edge {
    Role "a mouth in the dust". Species mouther. Level 10.
  }
  Initially Assert temperament(mouther, temper_ambush). Initially Assert warning(mouther, mouther_seen).
  Initially Assert onslaught(mouther, mouther_rises).
  Entity mouther_seen: fact "The dust at the Mere's edge breathes in, and out, in a ring a cart wide. There is something under it, and it has noticed you.".
  Entity mouther_rises: fact "The dust at your feet opens into a mouth.".
  // The Watcher in the Arch keeps the Lamplighters' door, and lets by only those who carry the Charter's seal.
  Entity lamplighter_seal: itemkind "Lamplighters' seal".
  Person watcher "the Watcher in the Arch" at arch {
    Role "the keeper of the Arch of Ways". Species discerner. Level 12.
  }
  Initially Assert temperament(watcher, temper_obedient). Initially Assert lair(watcher, arch).
  Initially Assert onslaught(watcher, watcher_wakes).
  Entity watcher_wakes: fact "Every eye in the Arch opens at once, and the Watcher unfolds out of it.".
  Rule watcher_knows_seal when together(watcher, party) and holding(party, lamplighter_seal) and not tolerates(watcher, party)
    says "The Watcher's eyes go to the seal you carry, one after another, and close. It folds itself back into the Arch and lets you by." {
    Assert tolerates(watcher, party).
  }

  // The Hollow Warden: the last warden of Lampfall, who shut the doors with the light inside and himself with it. He
  // keeps the ledger of every jar, and names a price for leaving; he will take coin, or better, light.
  Person hollow "the Hollow Warden" at ledger_hall {
    Role "the last warden of Lampfall, dead and not gone". Species lich. Level 14.
    State writing "The thing in the Lamplighter's robes writes on, a line to every jar, and does not look up.".
  }
  Person hollow_guard "the warden's lamp-bearers" at gate_ward {
    Role "the warden's dead servants". Species ghoul. Level 8. Numbers 2.
  }
  Initially Assert temperament(hollow, temper_proud). Initially Assert lair(hollow, ledger_hall).
  Initially Assert warning(hollow, hollow_price). Initially Assert onslaught(hollow, hollow_rises). Initially Set tribute(hollow) to 120.
  Entity hollow_price: fact "'A hundred and twenty crowns,' says the Hollow Warden without looking up, 'for the light you burned on my road. Or a jar of noon, which is better than crowns. Or stay, and go in the ledger with the rest.'".
  Entity hollow_rises: fact "The Hollow Warden lays down his pen. 'Entered,' he says, and stands.".
  Initially Assert temperament(hollow_guard, temper_territorial). Initially Assert warning(hollow_guard, guard_warns).
  Initially Assert onslaught(hollow_guard, guard_comes).
  Entity guard_warns: fact "Two dead men in the Lamplighters' grey stand up from the gate steps and lift their dark lamps at you. They do not need to speak.".
  Entity guard_comes: fact "The lamp-bearers come down the steps at you, swinging the iron lamps like flails.".
  Action pay_in_light(actor: group, site: place) "Give the Hollow Warden a jar of noonlight" {
    Requires able(actor) and company(actor) and at(actor, site) and at(hollow, site) and able(hollow)
      and warned(hollow, actor) and holding(actor, noonlight).
    On success { Assert tolerates(hollow, actor). Retract warned(hollow, actor). Assert paid_in_light(actor). }
    Result "The Hollow Warden takes the jar in both hands and holds it to where his face was. 'Entered,' he says, and writes, and does not look at you again until you ask him something.".
  }
  Relation paid_in_light(group).
  Topic hollow_door with hollow "Ask the Hollow Warden about the way to the sea" when tolerates(hollow, party) once {
    Says "'The Lamplighters had a door for every beacon,' says the Hollow Warden. 'The Lanthorn's, under its deep cellar. The one under the lake. And the one past the Arch, to the hall in Brack where they kept the Charter. The Watcher keeps it for them still, and lets by only the seal.'".
    On discuss { Assert knows(actor, brack_door_known). }
  }
  Entity brack_door_known: fact "Past the Arch of Ways in the Unlit stands the Lamplighters' door to their hall in Brack, kept by the Watcher, who lets by only those carrying the Charter's seal.".
  Initially Assert established(brack_door_known).

  // The jar vault: the light the Lamplighters laid down, and what the Hollow Warden took from his own order.
  Thing vault_racks "the vault racks" at jar_vault {
    Holds.
  }
  Item vault_noon "a jar of noonlight, still burning" is noonlight in vault_racks.
  Item vault_noon_two "a second jar of noonlight" is noonlight in vault_racks.
  Item vault_moon "a jar of moonlight" is moonlight in vault_racks.
  Item last_light "the Last Light of Lampfall" is first_light in vault_racks.
  Item regalia "the Lamplighters' regalia" is hollow_regalia at ledger_hall.
  // Whatever was agreed, his order's regalia taken from under his pen ends it.
  Rule regalia_stolen when holding(party, hollow_regalia) and together(hollow, party) and able(hollow)
    and not assails(hollow, party) says "The pen stops. 'That,' says the Hollow Warden, 'was never in the ledger.' He stands." {
    Retract tolerates(hollow, party). Assert assails(hollow, party).
  }
  Observe vault_guarded at jar_vault when able(hollow) and not tolerates(hollow, party) "Every jar on the racks has a line in the ledger, and you can feel the ledger knowing you are here.".
  Rule vault_robbed when at(party, jar_vault) and able(hollow) and not tolerates(hollow, party) and not warned(hollow, party)
    and not assails(hollow, party) says "Out in the hall the pen stops." {
    Assert at(hollow, jar_vault). Assert assails(hollow, party).
  }

  // Lampfall's beacon: a Last Light in its cradle relights it, and the Unlit's law changes where the light reaches.
  Thing far_cradle "Lampfall's beacon cradle" at beacon_room {
    Holds.
    State dark "The cradle of mirrors is empty and cold.".
  }
  Relation kindled_here(place).
  Rule lampfall_lit when inside(?jar, far_cradle) and itemKind(?jar, first_light) and not kindled_here(beacon_room)
    says "Noon leaps up out of the cradle and the mirrors take it and throw it out over the Ash. For the first time in a hundred years the lamp-posts on the ash road have shadows." {
    Assert kindled_here(beacon_room). Retract law(unlit, unlit_law). Assert law(unlit, beacon_law).
    Retract lightless(beacon_room). Retract lightless(ledger_hall). Retract lightless(jar_vault). Retract lightless(gate_ward).
    Retract lightless(ash_road). Retract lightless(veil_foot). Retract lightless(arch).
  }
  Rule shades_go when kindled_here(beacon_room) and able(shades) and not at(shades, cinders)
    says "Under the beacon's light the shades on the road thin like smoke and are gone." {
    Assert at(shades, cinders). Assert routed(shades).
  }
  Objective lampfall_seen when knows(party, brack_door_known) "Past the Arch of Ways in the Unlit, a door opens on the Lamplighters' hall in Brack.".
  Goal kindled_here(beacon_room) or paid_in_light(party).
}
