Module varrow "The Varrow" {
  Description "A high valley cut through the Thrumm by the Varrow river. The old salt road climbs from Hollin, the lowland market town, past Crake's Ford, over Gaunt's Gap to Skerry and its silver mine. Hollin wants Skerry's silver; Skerry eats Hollin's grain; the Gap is the lifeline, and someone has put a toll on it.".

  Place varrow "The Varrow" is region.
  Place hollin "Hollin" is settlement within varrow at 0, 1.
  Place lowroad "the Varrow road" is wilderness within varrow at 1, 1.
  Place ford "Crake's Ford" is settlement within varrow at 2, 1.
  Place downs "the Gorse Downs" is wilderness within varrow at 2, 2.
  Place climb "the Gap road" is wilderness within varrow at 3, 1.
  Place fell "Hushing Fell" is wilderness within varrow at 4, 0.
  Place heights "the Skerry heights" is wilderness within varrow at 4, 1.
  Place skerry "Skerry" is settlement within varrow at 5, 1.

  Place wheatsheaf_house "The Wheatsheaf" is building within hollin.
  Place chandlery_house "Ottar's chandlery" is building within hollin.
  Place vane_house "Vane's" is building within hollin.
  Place lamp_house "The Temple of the Kindly Lamp" is building within hollin.
  Place reeve_house "The reeve's hall" is building within hollin.
  Place heron_house "The Heron and Eel" is building within ford.
  Place smithy_house "Jory's smithy" is building within ford.
  Place pick_house "The Lamp and Pick" is building within skerry.
  Place assay_house "The Assay" is building within skerry.

  Place market "Hollin market" is room within hollin at 1, 1.
  Place wheatsheaf "the Wheatsheaf's taproom" is room within wheatsheaf_house at 0, 1.
  Place chandlery "Ottar's chandlery" is room within chandlery_house at 2, 1.
  Place goldsmith "Vane's counting-room" is room within vane_house at 1, 2.
  Place lamp_temple "the Temple of the Kindly Lamp" is room within lamp_house at 1, 0.
  Place reeve_hall "the reeve's hall" is room within reeve_house at 0, 2.
  Place barrows "Two Barrows" is room within lowroad at 0, 0.
  Place alders "the alder bend" is room within lowroad at 1, 0.
  Place ford_green "Crake's Ford" is room within ford at 0, 0.
  Place far_bank "the far bank of the ford" is room within ford at 1, 0.
  Place heron "the Heron and Eel" is room within heron_house at 0, 1.
  Place smithy "Jory's smithy" is room within smithy_house at 1, 1.
  Place drove_track "the drove track" is room within downs at 0, 0.
  Place stones "the Whispering Stones" is room within downs at 1, 0.
  Place knot_foot "below the Hob-Knot" is room within downs at 1, 1.
  Place switchbacks "the switchbacks" is room within climb at 0, 0.
  Place cairn "the wayside cairn" is room within climb at 1, 0.
  Place toll_gate "the Toll gate" is room within climb at 2, 0.
  Place shoulder "the shoulder of the fell" is room within fell at 0, 0.
  Place stair_foot "the foot of the pilgrims' stair" is room within fell at 1, 0.
  Place gap_far "the far side of the Gap" is room within heights at 0, 0.
  Place cairn_field "the cairn field" is room within heights at 1, 0.
  Place square "Skerry square" is room within skerry at 0, 0.
  Place pick_inn "the Lamp and Pick" is room within pick_house at 0, 1.
  Place assay "the Assay" is room within assay_house at 1, 1.
  Place mine_head "the mine head" is room within skerry at 1, 0.
  Place glimmer_stall "the Glimmerkin stall" is room within skerry at 2, 0.

  Passage wheatsheaf_door "the Wheatsheaf's door" is door between wheatsheaf and market.
  Passage chandlery_door "Ottar's door" is door between chandlery and market.
  Passage vane_door "Vane's door" is door between goldsmith and market.
  Passage temple_porch "the temple porch" is doorway between lamp_temple and market.
  Passage reeve_door "the reeve's door" is door between reeve_hall and market.
  Passage valley_road "the Varrow road" is road between market and barrows taking 3 hours.
  Passage river_road "the river road" is road between barrows and alders taking 1 hour.
  Passage alder_lane "the lane to the ford" is road between alders and ford_green taking 1 hour.
  Passage heron_door "the Heron's door" is door between heron and ford_green.
  Passage smithy_door "the smithy door" is doorway between smithy and ford_green.
  Passage the_ford "the ford" is ford between ford_green and far_bank taking 30 minutes.
  Passage downs_track "the drove track onto the downs" is track between ford_green and drove_track taking 1 hour.
  Passage stone_path "the path to the stones" is path between drove_track and stones taking 1 hour.
  Passage knot_path "the path below the ring-fort" is path between stones and knot_foot taking 30 minutes hidden until hob_knot_known.
  Passage gap_road "the Gap road" is road between far_bank and switchbacks taking 2 hours.
  Passage cairn_road "the road past the cairn" is road between switchbacks and cairn taking 1 hour.
  Passage toll_road "the last pull to the Toll" is road between cairn and toll_gate taking 1 hour.
  Passage goat_path "the goat path over the shoulder" is climb between switchbacks and shoulder taking 3 hours hidden until goat_path_known needing climbing or rope.
  Passage shoulder_down "the scree down to the cairn field" is path between shoulder and cairn_field taking 2 hours.
  Passage stair_path "the path to the pilgrims' stair" is path between shoulder and stair_foot taking 1 hour.
  Passage heights_road "the heights road" is road between gap_far and cairn_field taking 1 hour.
  Passage skerry_road "the road down into Skerry" is road between cairn_field and square taking 1 hour.
  Passage pick_door "the Lamp and Pick's door" is door between pick_inn and square.
  Passage assay_door "the Assay door" is door between assay and square.
  Passage mine_yard "the mine yard" is passage between square and mine_head.
  Passage stall_way "the awning by the mine head" is passage between mine_head and glimmer_stall.

  Company party "Your company" of 3 at market.
  Initially Set quantity(party, gold) to 15. Initially Set quantity(party, rations) to 2.

  // The weather turns before dawn: rain in the valley is snow on the high ground. Rain swells the ford; snow shuts
  // the goat path and slows the Gap road; fog hides the road's landmarks and those who wait beside it.
  Entity sky: scenery "the sky over the Varrow".
  Entity fair: condition "fair". Entity rain: condition "rain". Entity fog: condition "fog".
  Initially Assert state(sky, fair).
  Rule rain_comes when untilLight(clock) == 1 and state(sky, fair) and dice(clock) <= 25 { Assert state(sky, rain). }
  Rule fog_comes when untilLight(clock) == 1 and state(sky, fair) and dice(clock) > 25 and dice(clock) <= 40 { Assert state(sky, fog). }
  Rule clears when untilLight(clock) == 1 and not state(sky, fair) and dice(clock) > 55 { Assert state(sky, fair). }
  Thing spate "the Varrow at the ford" on the_ford is scenery {
    State fordable "The Varrow runs knee-deep and clear over the ford stones.".
    State swollen blocking "The Varrow is in spate, brown and loud, over the ford stones. Nobody crosses today.".
  }
  Rule ford_swells when state(sky, rain) and state(spate, fordable) { Assert state(spate, swollen). }
  Rule ford_falls when state(sky, fair) and state(spate, swollen) and untilLight(clock) == 2 { Assert state(spate, fordable). }
  Thing drifts "the snow on the shoulder" on goat_path is scenery {
    State clear "The goat path picks its way up the shoulder of the fell, steep but clear.".
    State drifted blocking "Snow has filled the goat path to the waist. Nobody goes over the shoulder until it melts.".
  }
  Rule snow_falls when state(sky, rain) and state(drifts, clear) { Assert state(drifts, drifted). }
  Rule snow_melts when state(sky, fair) and state(drifts, drifted) and untilLight(clock) == 3 { Assert state(drifts, clear). }
  Rule gap_slow when state(sky, rain) { Set travelTime(gap_road) to 18. Set travelTime(cairn_road) to 9. }
  Rule gap_fast when not state(sky, rain) { Set travelTime(gap_road) to 12. Set travelTime(cairn_road) to 6. }
  Observe rain_low at barrows when state(sky, rain) "Rain sweeps up the valley in grey curtains. The road is mud.".
  Observe rain_ford at ford_green when state(sky, rain) "Rain drums on the Heron's thatch.".
  Observe rain_high at switchbacks when state(sky, rain) "Sleet on the switchbacks, and snow higher up: the shoulder of the fell has gone white.".
  Observe fog_low at barrows when state(sky, fog) "Fog lies in the valley so thick the barrows are only shapes, and the road vanishes ten paces on.".
  Observe fog_high at cairn when state(sky, fog) "The cairn looms out of fog. Below, nothing; above, nothing.".

  // Hollin.
  Observe market_scene at market when true "Hollin market: carts, a wool-cross, a well with a stone roof. Wagons for the Gap stand loaded and going nowhere; their drivers argue about the Toll.".
  Observe wheatsheaf_scene at wheatsheaf when true "A long low taproom smelling of beer and wet wool. A board by the hearth lists the Toll in chalk, and someone has added a rude drawing.".
  Observe chandlery_scene at chandlery when true "Coils of rope, poles in a rack, lamp-oil in stone jars and sacks of hard bread.".
  Observe goldsmith_scene at goldsmith when true "A narrow counting-room with a barred window, a balance under a glass bell, and a stone for testing gold.".
  Observe temple_scene at lamp_temple when true "A small temple with no images, only lamps: hundreds of them, in niches, on chains, in a great iron wheel, all kept burning.".
  Observe reeve_scene at reeve_hall when true "The reeve's hall is a counting-house with a dais. Ledgers lie open; most of the figures are red.".
  Person wenna "Wenna" at wheatsheaf {
    Role "keeper of the Wheatsheaf". Profession innkeeper. Peaceable.
    Sells rations for 2 coin from 8.
  }
  Person ottar "Ottar" at chandlery {
    Role "chandler". Profession herbalist. Peaceable.
    Sells torch for 1 coin from 8.
    Sells rope for 1 coin from 3.
    Sells pole for 1 coin from 2.
    Sells crowbar for 3 coin from 1.
    Sells rations for 2 coin from 6.
    Sells bandages for 1 coin from 4.
  }
  Person iselde "Iselde Vane" at goldsmith {
    Role "goldsmith". Ancestry human. Peaceable.
    Buys grave_rings for 12 coin. Buys chapel_plate for 18 coin. Buys jade_idol for 25 coin. Buys bronze_bearing for 8 coin.
  }
  Person ash "Mother Ash" at lamp_temple {
    Role "keeper of the Kindly Lamp". Ancestry human. Calling cleric. Level 4. Profession priest. Peaceable.
    Offers healing "the lamp's oil on every wound, and a prayer" for 3 coin.
  }
  Person garrow "Aldous Garrow" at reeve_hall {
    Role "reeve of Hollin". Ancestry human. Peaceable.
  }
  Topic wenna_toll with wenna "Ask Wenna about the Toll" when true {
    Says "'Ninefingers,' says Wenna, and spits in the fire. 'Ottilie Ninefingers and forty cut-throats, sitting in the old Lanthorn at the top of the Gap, and every cart that goes over pays her two crowns a wheel. Skerry's starving and we're drowning in unsold grain. The reeve's offering money to whoever shifts her.'".
  }
  Topic wenna_barrows with wenna "Ask Wenna what is said on the road" when true once {
    Says "'Carters coming down say there's lights at Two Barrows some nights,' says Wenna. 'Little lights, low down, going in and out of the mounds as if they owned them. And the Hobs are out again on the downs: they had the Midsummer wool off three carts last month, and Bryony Crake's sheep.'".
    On discuss { Assert knows(actor, barrow_lights). }
  }
  Topic garrow_bounty with garrow "Ask the reeve what he wants done about the Toll" when not knows(actor, bounty) once {
    Says "'Ottilie Ninefingers out of the Lanthorn,' says Garrow, 'dead, gone or paid off, I don't care which, and the Gap open. The town will pay fifty crowns. Her men are thieves, not soldiers, but there are a great many of them, and the Lanthorn was built to keep armies out. Nobody has been inside it in a hundred years who came back to talk about it, except Ninefingers.'".
    On discuss { Assert knows(actor, bounty). }
  }
  Topic ash_lanthorn with ash "Ask Mother Ash about the Lanthorn" when true once {
    Says "'The Lamplighters built it,' says Mother Ash, 'to hold a light at the top of the Gap that could be seen from the sea. They kept light the way you keep wine: bottled, laid down, aged. Something got into their cellars that ate it, and the beacon went out, and they went with it. This temple is what is left of them down here: we keep the lamps lit, because they asked us to, and nobody remembers why it matters.' She looks at the iron wheel of lamps. 'The lamps have been guttering this autumn. All of them, a little, every night.'".
    On discuss { Assert knows(actor, dimming). }
  }
  Entity barrow_lights: fact "Little lights are seen at Two Barrows on the Varrow road some nights, going in and out of the mounds.".
  Entity bounty: fact "The reeve of Hollin will pay fifty crowns to whoever ends the Toll at the Gap.".
  Entity dimming: fact "The Lamplighters who built the Lanthorn kept bottled light; something that eats light got into their cellars and put out their beacon. Hollin's temple lamps have been guttering all autumn.".
  Initially Assert established(barrow_lights). Initially Assert established(bounty). Initially Assert established(dimming).
  Objective end_toll when knows(party, bounty) "The reeve of Hollin will pay fifty crowns to whoever ends the Toll at the Gap.".

  // The Varrow road.
  Observe barrows_scene at barrows when not state(sky, fog) "Two grassy barrows stand by the road like a pair of sleeping cattle. The nearer has a dark slot low on its side, half hidden by brambles. Beyond them the valley narrows toward the ford.".
  Observe alders_scene at alders when true "The road bends with the river under alders. Someone has built a fishing platform out over the water, and a boat is pulled up beneath it.".
  Observe barrow_glow at barrows when dark() and not state(sky, fog) "Low down on the nearer barrow, a faint light moves behind the brambles, and goes out." teaches barrow_lights.

  // Crake's Ford.
  Observe ford_scene at ford_green when true "A hamlet of slate and turf at the ford of the Varrow: a dozen houses, the Heron and Eel, a smithy, and sheep-pens standing empty.".
  Observe far_bank_scene at far_bank when true "The far bank of the ford, where the Gap road leaves the river and starts to climb.".
  Observe heron_scene at heron when true "Eel-traps hang in the rafters. The fire is peat and the ale is thin.".
  Observe smithy_scene at smithy when true "The forge is banked and cold. Jory is sharpening scythes that nobody will use this year.".
  Person bryony "Bryony Crake" at heron {
    Role "keeper of the Heron and Eel". Profession innkeeper. Peaceable.
    Sells rations for 2 coin from 4.
  }
  Person jory "Jory" at smithy {
    Role "smith of Crake's Ford". Ancestry human. Peaceable.
    Sells pole for 1 coin from 1.
    Sells crowbar for 3 coin from 1.
  }
  Topic bryony_hobs with bryony "Ask Bryony about the Hobs" when true once {
    Says "'They come down off the downs at night when the moon's thin,' says Bryony, 'and take what isn't nailed down. They took my sheep, every one, and laughed doing it. Their ring-fort's somewhere past the Whispering Stones; my Tam followed them once as far as the stones and came back without his boots.'".
  }
  Topic bryony_toll with bryony "Ask Bryony about the Ninefingers" when true once {
    Says "'Her men come down for meal and ale,' says Bryony, 'on what they call credit. Every week. If they don't come one week, it means they're eating something else, and I'd like to know what.'".
  }
  Topic jory_path with jory "Ask Jory about getting over the Gap without paying" when true once {
    Says "Jory looks at the door before he answers. 'My brother takes salt over the shoulder of the fell by the goat path,' he says. 'Leave the road at the switchbacks, where a cairn of white stones marks a gully, and climb. You want a rope or a climber, and you want clear weather: snow fills it in an hour. It comes down in the cairn field above Skerry, behind the Toll.'".
    On discuss { Assert knows(actor, goat_path_known). }
  }
  Discovery goat_path_known "A goat path leaves the Gap road at the switchbacks, by a cairn of white stones, and climbs over the shoulder of Hushing Fell to the cairn field above Skerry, behind the Toll. It needs a rope or a climber, and clear weather." {
    Found by searching switchbacks with woodcraft "Up the gully by the white cairn: droppings, and the scrape of boot-nails on bare rock. A path, and someone uses it.".
  }
  Discovery hob_knot_known "The Hob-Knot, the Hobs' ring-fort, stands past the Whispering Stones on the Gorse Downs, by a path through the gorse." {
    Found by searching stones "Beyond the stones a path has been beaten through the gorse: narrow, and bloody with bramble scratches at the height of a short person.".
  }

  // The Gorse Downs.
  Observe drove_scene at drove_track when true "Gorse and heather, and the drove track wandering between them. Sheep-droppings, but no sheep.".
  Observe stones_scene at stones when true "A ring of nine grey stones, each taller than a man. The wind makes a sound in the gaps between them like people talking just out of hearing.".
  Observe knot_foot_scene at knot_foot when true "Below a hill crowned with a ring of earth and stakes. Smoke rises inside it. The stakes have things hung on them that turn in the wind.".

  // The Gap road.
  Observe switchbacks_scene at switchbacks when true "The road climbs in switchbacks above the river. A cairn of white stones stands by a gully where the road turns for the third time.".
  Observe cairn_scene at cairn when not state(sky, fog) "A wayside cairn of offerings: pins, buttons, a doll's shoe. Above, the road makes its last pull to the Gap, and the Lanthorn stands over it, black against the sky.".
  Observe toll_scene at toll_gate when true "The road runs straight into a gatehouse built across the Gap. The gate is shut. A board nailed to it reads TOLL: TWO CROWNS A WHEEL, TWO A HEAD, BY ORDER, and someone has scratched a ninth finger on the drawn hand.".

  // Hushing Fell and the heights.
  Observe shoulder_scene at shoulder when true "The shoulder of Hushing Fell: rock and old snow, and the whole Varrow laid out below. Up the fell, a stair has been cut into the rock, going up into cloud. A bell sounds from somewhere above, once.".
  Observe stair_foot_scene at stair_foot when true "The foot of a stair cut into the fell, worn into hollows by feet. A post by it holds a rope that goes up into the cloud, and a small bell.".
  Observe gap_far_scene at gap_far when true "Behind the Lanthorn the Gap opens onto the heights: stone, heather, and far off the smoke of Skerry.".
  Observe cairn_field_scene at cairn_field when true "A field of cairns, hundreds, each one a miner's grave. The road to Skerry runs between them.".

  // Skerry.
  Observe square_scene at square when true "Skerry square: grey stone houses round a mine head with a great wheel. Everyone is thin. A queue at the Assay waits to sell silver nobody can carry down to Hollin.".
  Observe pick_scene at pick_inn when true "Miners' lamps hang over every table; half of them are out.".
  Observe assay_scene at assay when true "Scales, ingots stacked like bread, and an assayer who has not been paid in coin since summer.".
  Observe mine_head_scene at mine_head when true "The mine head: the wheel, the cage, and a cold breath coming up the shaft. A notice says DEEP GALLERIES CLOSED.".
  Observe stall_scene at glimmer_stall when true "Under the awning by the mine head, a stall hung with jars that glow: green, gold, white as noon.".
  Person hest "Captain Hest" at mine_head {
    Role "captain of the Skerry mine". Ancestry dwarf. Peaceable.
  }
  Person keld "Keld" at pick_inn {
    Role "keeper of the Lamp and Pick". Profession innkeeper. Peaceable.
    Sells rations for 3 coin from 3.
    Sells torch for 1 coin from 4.
  }
  Topic hest_deep with hest "Ask Captain Hest about the deep galleries" when true once {
    Says "'We broke through into caves in the spring,' says Hest. 'Big ones, with folk in them: the Glimmerkin, little lantern-eyed people, who trade us light in jars. Then the lamps started going out in the deep galleries. Not blown out: eaten. You can watch a flame get smaller and smaller as if something was drinking it. I closed the deep galleries after two men went down and only their lamps came back, cold.'".
    On discuss { Assert knows(actor, lamps_eaten). }
  }
  Entity lamps_eaten: fact "In the deep galleries of the Skerry mine, lamps go out as if something drinks the flame; two miners were lost there.".
  Initially Assert established(lamps_eaten).

  Goal false.
}
