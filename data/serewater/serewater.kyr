  Initially Assert district(vestibule, upperworks).
  Initially Assert district(workshop, upperworks).
  Initially Assert district(gallery, upperworks).
  Initially Assert district(furnace, upperworks).
  Initially Assert district(hoist, upperworks).
  Initially Assert district(stores, upperworks).
  Entity refugehalls: districtkind "Censer Hill II · Flood refuge". Initially Assert undergroundDistrict(refugehalls).
  Initially Assert district(stair, refugehalls).
  Initially Assert district(landing, refugehalls).
  Initially Assert district(hall, refugehalls).
  Initially Assert district(kitchen, refugehalls).
  Initially Assert district(name_room, refugehalls).
  Initially Assert district(sluice, refugehalls).
  Entity lowerossuary: districtkind "Censer Hill III · Ossuary". Initially Assert undergroundDistrict(lowerossuary).
  Initially Assert district(lower, lowerossuary).
  Initially Assert district(crypt, lowerossuary).
  Initially Assert district(court, lowerossuary).
  Initially Assert district(vault, lowerossuary).
  Initially Assert district(founders, lowerossuary).
  Initially Assert district(chalk, lowerossuary).
