Module serewater "Serewater March — Censer Hill" {
  Description "A river town, a broken bellfoundry, a refuge for the displaced, and the burial chambers beneath it. The March will outlast an expedition. Choose what to carry, whose claims to honor, and when to return.".
  Entity reedwake: districtkind "Reedwake". Initially Assert townDistrict(reedwake).
  Initially Assert district(quay, reedwake).
  Initially Assert district(inn, reedwake).
  Initially Assert district(shrine, reedwake).
  Initially Assert district(outfitter, reedwake).
  Initially Assert district(salvage, reedwake).
  Entity reedlands: districtkind "Willow floodplain and chalk ridge". Initially Assert wildernessDistrict(reedlands).
  Initially Assert district(causeway, reedlands).
  Initially Assert district(ridge, reedlands).
  Initially Assert district(yard, reedlands).
  Initially Assert district(drain, reedlands).
