  Place vault "III.4 · Named vault" is room within level_three.
  Place founders "III.5 · Founders’ gallery" is room within level_three.
  Place chalk "III.6 · Chalk escape passage" is room within level_three.
  Person nera "Nera" at outfitter { Role "outfitter". Class commoner. Level 2. Uses travel. }
  Person iven "Iven" at shrine { Role "burial keeper". Race human. Class cleric. Level 2. Uses travel. }
  Person edda "Edda" at workshop { Role "salvage forewoman". Class fighter. Level 3. Uses travel. }
  Person pell "Pell" at vestibule { Role "surveyor". Class thief. Level 2. Uses travel. }
  Person custodian "Mortuary Custodian" at court { Role "mortuary guardian". Race bronze_construct. Class mortuary_custodian. Level 5. Uses travel. }
  Person roost "Ash the cave hound" at gallery { Role "cave scavenger". Race cave_hound. Class wild_beast. Uses travel. }
  Person marshfang "Reedbank boar" at causeway { Role "floodplain wildlife". Race boar. Class wild_beast. Uses travel. }
  Person jory "Jory" at inn { Role "retired ferry guard". Race human. Class fighter. Level 3. }
  Entity serewater_training: ability "Measured strike". Entity brace_line: ability "Brace line".
  Initially Assert teaches(jory, serewater_training). Initially Assert teaches(iven, brace_line).
  Initially Set encounterXp(roost) to 20. Initially Set encounterXp(marshfang) to 20. Initially Set encounterXp(custodian) to 60.
  Topic jory_training with jory "Ask Jory how to improve after an expedition" when true {
    Says "'A live return is worth more than a brave corpse,' Jory says. 'Twenty earned experience buys an hour of instruction. I teach a measured strike; Iven teaches a brace line at the shrine. Choose which companion learns. The new technique remains yours on the next descent.'".
  }
  Measure risesAt(pressure). Measure expiresAt(pressure).
  Relation departed(group). Relation highWater(pressure).
  Initially Assert at(party, quay). Initially Assert unladen(party).
  Initially Assert restful(inn). Initially Assert restful(quay).
  Initially Assert acceptsCustody(custodian). Initially Assert requiresRecord(custodian, names_survive).
  Initially Assert assumesFalse(iven, names_survive).
  Initially Assert trapped(pell). Initially Assert restrainedBy(pell, rack). Initially Assert mounted(rack, vestibule). Initially Assert obstruction(rack). Initially Assert home(pell, quay).
  Initially Assert receptive(marshfang, woodcraft). Initially Assert receptive(roost, woodcraft).
