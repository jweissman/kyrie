Module site_capabilities "Places, commitments and mechanisms" {
  Kind mechanism.
  Relation functioning(mechanism).
  Relation mounted(mechanism, place).
  Relation barrier(mechanism, place).
  Relation operates(group, mechanism).
  Relation keyedBy(mechanism, group).
  Relation supports(group, group).
  Relation seeksBacking(group).
  Relation mandate(group, place).
  Relation controlled(place, group) exclusive.
  Relation informedPassage(place, place, fact).
  Measure enforceAt(group).
  Goal false.
  Action take_control(actor: group, device: mechanism, keeper: group, site: place) "Take the key for {device} from {keeper}" {
    Result "You recover the keeper\u2019s key. You can now operate the mechanism; it has not opened by itself.".
    Description "Recover access from an incapacitated keeper here. You must still operate the mechanism yourself.".
    Requires able(actor) and not able(keeper) and at(actor, site) and at(keeper, site)
      and mounted(device, site) and keyedBy(device, keeper) and not operates(actor, device).
    On success { Assert operates(actor, device). }
  }
  Action endorse(actor: group, recipient: group, site: place) "Pledge support to {recipient}" {
    Description "Publicly put your name behind this person's claim.".
    Requires able(actor) and able(recipient) and distinct(actor, recipient) and at(actor, site)
      and at(recipient, site) and seeksBacking(recipient) and not supports(actor, recipient).
    On success { Assert supports(actor, recipient). }
  }
  Action enforce(actor: group, site: place) "Establish control of {site}" {
    Requires able(actor) and at(actor, site) and mandate(actor, site) and not controlled(site, actor)
      and watch(clock) >= enforceAt(actor).
    On success { Assert controlled(site, actor). }
  }
  Action disable(actor: group, device: mechanism, site: place) "Disable {device}" {
    Result "You dismantle the operating mechanism. It stops; any earlier damage remains.".
    Description "Dismantle an accessible mechanism you are equipped to work on. The change persists.".
    Requires able(actor) and at(actor, site) and mounted(device, site) and operates(actor, device)
      and functioning(device).
    On success { Retract functioning(device). }
  }
  Action shut(actor: group, device: mechanism, site: place, destination: place) "Close {device}" {
    Result "You close the barrier. People already beyond it can leave.".
    Description "Close the passage this mechanism controls. People already inside can leave.".
    Requires able(actor) and at(actor, site) and mounted(device, site) and barrier(device, destination)
      and operates(actor, device) and not closed(destination).
    On success { Assert closed(destination). }
  }
  Action open(actor: group, device: mechanism, site: place, destination: place) "Open {device}" {
    Result "You open the barrier. The passage beyond is now available, though it may still be dangerous.".
    Description "Reopen the physical passage. This does not make the place beyond it safe.".
    Requires able(actor) and at(actor, site) and mounted(device, site) and barrier(device, destination)
      and operates(actor, device) and closed(destination).
    On success { Retract closed(destination). }
  }
  Action passage(actor: group, origin: place, destination: place, statement: fact) "Follow the concealed passage to {destination}" {
    Result "You follow the route you learned about and emerge beyond the obstruction.".
    Requires able(actor) and at(actor, origin) and informedPassage(origin, destination, statement)
      and knows(actor, statement) and not closed(destination).
    On success { Assert at(actor, destination). }
  }
}
