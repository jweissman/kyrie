Module adventure_rules "Small campaign rules" {
  Kind group. Kind place. Kind good. Kind stock. Kind pressure. Kind clock.
  Relation at(entity, place) exclusive.
  Relation route(place, place).
  Relation closed(place).
  Relation denied(group, place, place).
  Relation footway(place, place).
  Relation gate(group, place, place).
  Relation gatekeeper(group).
  Relation distinct(group, group).
  Relation able(group).
  Relation dead(group).
  Relation released(group).
  Relation sated(group).
  Relation acceptsFood(group).
  Relation carrying(group, good) exclusive.
  Relation unladen(group).
  Relation mayCollect(group, stock).
  Relation job(stock, good).
  Relation hostile(group, group).
  Relation recorded(pressure).
  Measure quantity(entity, good).
  Measure received(group).
  Measure claim(group).
  Measure mercy(group).
  Measure fee(stock).
  Measure required(stock, good).
  Measure watch(clock).
  Measure urgentAt(clock).
  Measure deficit(pressure).
  Query paid(who: group) means received(who) >= claim(who).
  Query releaseAllowed(who: group) means paid(who)
    or (acceptsFood(who) and sated(who)) or watch(clock) >= mercy(who).
  Goal false.

  Action wait(actor: group) "Wait" {
    Requires able(actor). Time 1.
  }
  Action travel(actor: group, origin: place, destination: place) "Travel to {destination}" {
    Result "You follow the route and arrive at the next place. People and dangers continue while you travel.".
    Requires able(actor) and at(actor, origin) and route(origin, destination) and not closed(destination) and not denied(actor, origin, destination).
    On success { Assert at(actor, destination). }
  }
  Action walk(actor: group, origin: place, destination: place) "Walk the footpath to {destination}" {
    Requires able(actor) and at(actor, origin) and unladen(actor) and footway(origin, destination).
    On success { Assert at(actor, destination). }
  }
  Action cross(actor: group, origin: place, destination: place, defender: group) "Cross past {defender} to {destination}" {
    Requires able(actor) and at(actor, origin) and gate(defender, origin, destination)
      and (released(defender) or not able(defender)) and not closed(destination).
    On success { Assert at(actor, destination). }
  }
  Action pay(actor: group, recipient: group, site: place) "Give {recipient} one coin" {
    Result "You hand over one coin. It is now in the recipient\u2019s purse.".
    Requires able(actor) and able(recipient) and distinct(actor, recipient) and at(actor, site) and at(recipient, site)
      and quantity(actor, gold) >= 1.
    On success { Decrease quantity(actor, gold) by 1. Increase quantity(recipient, gold) by 1.
      Increase received(recipient) by 1. }
  }
  Action give_food(actor: group, recipient: group, site: place) "Give {recipient} one ration" {
    Result "You offer a ration and step back. The recipient now owns it; what they do next is their decision.".
    Requires able(actor) and able(recipient) and distinct(actor, recipient) and at(actor, site) and at(recipient, site)
      and quantity(actor, rations) >= 1.
    On success { Decrease quantity(actor, rations) by 1. Increase quantity(recipient, rations) by 1. }
  }
  Action eat(actor: group) "Eat a ration" {
    Result "The company shares a ration. This satisfies hunger but does not restore health or mana.".
    Requires able(actor) and not sated(actor) and quantity(actor, rations) >= 1.
    On success { Decrease quantity(actor, rations) by 1. Assert sated(actor). }
  }
  Action release(actor: group) "End the blockade" {
    Requires able(actor) and gatekeeper(actor) and not released(actor) and releaseAllowed(actor).
    On success { Assert released(actor). }
  }
  Action collect(actor: group, store: stock, goods: good, site: place) "Collect one {goods} from {store}" {
    Result "You collect one unit from the available stock. It is now carried by the company.".
    Requires able(actor) and at(actor, site) and at(store, site) and mayCollect(actor, store)
      and unladen(actor) and quantity(store, goods) >= 1.
    On success { Decrease quantity(store, goods) by 1. Retract unladen(actor). Assert carrying(actor, goods). }
  }
  Action put(actor: group, store: stock, goods: good, site: place) "Deposit one {goods} in {store}" {
    Result "You deposit what the company was carrying. The stock increases and your hands are free.".
    Requires able(actor) and at(actor, site) and at(store, site) and carrying(actor, goods).
    On success { Retract carrying(actor, goods). Assert unladen(actor). Increase quantity(store, goods) by 1. }
  }
  Action fulfill_job(actor: group, store: stock, goods: good, site: place) "Deliver {goods} to {store} for pay" {
    Requires able(actor) and at(actor, site) and at(store, site) and carrying(actor, goods)
      and job(store, goods) and quantity(store, gold) >= 1.
    On success { Retract carrying(actor, goods). Assert unladen(actor). Increase quantity(store, goods) by 1.
      Decrease quantity(store, gold) by 1. Increase quantity(actor, gold) by 1. }
  }
  Action attack(actor: group, opponent: group, site: place) "Attack {opponent}" {
    Requires able(actor) and able(opponent) and distinct(actor, opponent) and at(actor, site) and at(opponent, site).
    Resolve combat(opponent).
    On success { Assert hostile(actor, opponent). Assert hostile(opponent, actor). }
    On failure { Assert hostile(actor, opponent). Assert hostile(opponent, actor). }
  }
}
