{
  "discovery": {
    "__no_id": true,
    "actor": "=dig(#_binding, 'actor')",
    "source": "=dig(#_binding, 'source')",
    "fact": "=dig(#_binding, 'fact')",
    "place": "=dig(#_binding, 'place')"
  },
  "orchard_situation": {
    "__no_id": true,
    "name": "The Glass Orchard",
    "creatures": "=gatherEntries(orchardContent, creatures)",
    "actors": "=gen(orchard_actors)",
    "discoveries": "=mapGenList(discovery, gatherEntries(discoveryBindings, orchard), '_binding')",
    "initial": [],
    "outcomes": "=gatherEntries(orchardContent, outcomes)"
  },
  "orchard_actors": {
    "__no_id": true,
    "order": "=gatherEntries(orchardContent, actors)"
  }
}
