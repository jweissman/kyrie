Module corrow "The Road the Star Came Down" {
  Description "Act II, the Grey Country: the Margin, entered by being forgotten and left by being remembered.".

  // ── What the Unsaid is ───────────────────────────────────────────────────────────────────────────────────────────
  // In 412 the Lettings read the star's name in the Root's memories and let it go, by order of both councils, and the
  // star stayed. Ever since, the name has been gathering forgotten things round itself in the Margin. The body woke in
  // 2641 and went after the jewel. The name wants to go after its body.
  Discovery unsaid_is_name "The Unsaid is the Nail's own name. In 412 the Lettings, by order of both councils, read the star's name in the Root and let it go into the Lap, and the star stayed where it was. The name has been in the Margin ever since, gathering forgotten things round itself; the body lay in the Well without it until 2641. A name without its thing wants its thing.".
  Thing warden_chest "a deadiron-bound chest in the old warden's office" at gaol_ring is scenery {
    State shut "In the wreck of the Concord warden's office, under fallen rock, a chest bound in black iron that no fire touched.".
  }
  Discovery warden_ledger "The Concord Warden's account book for 412, kept from thinning in deadiron: 'To the Letting school, for the Long Rite against the star's name, by order of both councils: forty weights of silver, paid. Fog. No market. To searchers for Keld Hollow, sixty men, nine days. Nothing found. They say the road there is longer than it was. The Keeper does not know her daughter. Fog.'" {
    Source warden_book "the Concord Warden's account book of 412" at gaol_ring readable by party.
  }
  Observe name_and_body near party when knows(party, warden_ledger) and knows(party, root_gift) and not knows(party, unsaid_is_name) "The Warden's account and the bear's night in the Root fit together like the two halves of a broken plate: the Lettings read the star's name in the Root, where the oldest witnesses had seen it fall, and let the name go. Not the star. Its name. Which is somewhere still." teaches unsaid_is_name.
  Topic ferran_told with ferran "Tell Ferran Cosk what is waiting in the grey" when knows(actor, unsaid_is_name) and not turned(ferran) and not unsaidCrossed(margin) {
    Says "Ferran Cosk listens to the end with his hands folded, and then he takes the Open Hand's book of syllables off its shelf, the one they have been filling for a year, and looks at it. 'My great-grandfather's rite,' he says. 'The star's name. We were going to say it at the Seam, out of mercy.' He closes the book. He does not burn it; he gives it to you. 'Whatever you need forgotten,' he says, 'the Open Hand will forget it. That is the only thing we are good for.'".
    On discuss { Assert turned(ferran). }
  }

  // ── The Open Hand's rite ─────────────────────────────────────────────────────────────────────────────────────────
  // On the fortieth day the Open Hand go down to the Seam and say what they have. The name needs seven syllables:
  // two have come through the Seam on Strays over the years; Webb carries one, two with the Short Grey record; the
  // three Strays of Keld carry three, if the Open Hand took them; and a company that said its syllables in the chamber
  // gave one more.
  Measure gathered(place). Relation tallied(place). Relation unsaidCrossed(place).
  Rule tally_base when watch(clock) >= 5600 and not tallied(margin) { Assert tallied(margin). Set gathered(margin) to 2. Assert tallyWebb(margin). }
  Relation tallyWebb(place). Relation tallyStrays(place). Relation tallyStirred(place).
  Rule tally_webb when tallyWebb(margin) and not webbNamed(webb) and able(webb) { Retract tallyWebb(margin). Increase gathered(margin) by syllables(webb). Assert tallyStrays(margin). }
  Rule tally_no_webb when tallyWebb(margin) and (webbNamed(webb) or not able(webb)) { Retract tallyWebb(margin). Assert tallyStrays(margin). }
  Rule tally_strays when tallyStrays(margin) and strayTaken(keld) and not namedStrays(keld) { Retract tallyStrays(margin). Increase gathered(margin) by 3. Assert tallyStirred(margin). }
  Rule tally_no_strays when tallyStrays(margin) and (not strayTaken(keld) or namedStrays(keld)) { Retract tallyStrays(margin). Assert tallyStirred(margin). }
  Rule tally_stirred when tallyStirred(margin) and unsaidStirred(corrow) { Retract tallyStirred(margin). Increase gathered(margin) by 1. }
  Rule tally_unstirred when tallyStirred(margin) and not unsaidStirred(corrow) { Retract tallyStirred(margin). }
  Rule open_hand_rite when watch(clock) >= 5616 and gathered(margin) >= 7 and not turned(ferran) and not unsaidCrossed(margin)
    and not unsaidHoused(margin) and not unsaidSent(margin) and not unsaidSlain(margin)
    says "On the fortieth day the Open Hand go down the Peleth stair in grey, thirty of them, with Ferran Cosk at their head carrying a book. Three days later the Registry enters a line in a tone it has never used: 'Arrival, unlicensed, from below.' What came up the stair that night wore a hundred lost coats and a hundred lost hats and walked like nobody at all, and went north-north-east across the plateau without stopping, toward the road the star went up." {
    Assert unsaidCrossed(margin). Assert at(unsaid, limbo).
  }
  Rule open_hand_short when watch(clock) >= 5616 and gathered(margin) < 7 and not turned(ferran) and not unsaidCrossed(margin) and not riteFailed(margin)
    and not unsaidHoused(margin) and not unsaidSent(margin) and not unsaidSlain(margin)
    says "On the fortieth day the Open Hand go down to the Seam and say what they have, all of it, in the dark, for a night and a day. The lake steams. The grey shore comes so close you could step onto it. Nothing crosses. Ferran Cosk comes up the stair with his book and sits on the rim for a long time." {
    Assert riteFailed(margin).
  }
  Relation riteFailed(place).

  // ── Going across ─────────────────────────────────────────────────────────────────────────────────────────────────
  // The prioress's sisters forget the company at the Seam; the anchors above say its names without stopping. Each
  // ordinary anchor holds two days. A Keld never tires: a Keld cannot forget.
  Place margin "the Margin" is plane.
  Place grey_country "the grey country" is region within margin.
  Place grey_near "the grey shore" is wilderness within grey_country at 0, 1.
  Place hollow "Keld Hollow" is settlement within grey_country at 1, 0.
  Place grey_far "the grey further in" is wilderness within grey_country at 2, 1.

  Place grey_shore "the grey shore" is room within grey_near at 0, 0 outdoors.
  Place drifts "the drifts" is room within grey_near at 1, 0 outdoors.
  Place hollow_lanes "the lanes of Keld Hollow" is room within hollow at 0, 0 outdoors.
  Place reeve_house "the reeve's house" is room within hollow at 1, 0.
  Place far_field "the far field" is room within hollow at 0, 1 outdoors.
  Place grey_library "the untitled library" is room within grey_far at 0, 0.
  Place mountain_place "the mountain's place" is room within grey_far at 1, 0 outdoors.
  Place short_grey_fog "the fog of 2604" is room within grey_far at 0, 1 outdoors.
  Place unsaid_court "the gathering" is room within grey_far at 2, 0 outdoors.

  Relation riteArranged(group). Measure anchorDays(place). Measure nextAnchor(place). Relation inMargin(place).
  Relation crossing(group). Relation stranded(group).
  Initially Assert inMargin(grey_shore). Initially Assert inMargin(drifts). Initially Assert inMargin(hollow_lanes).
  Initially Assert inMargin(reeve_house). Initially Assert inMargin(far_field). Initially Assert inMargin(grey_library).
  Initially Assert inMargin(mountain_place). Initially Assert inMargin(short_grey_fog). Initially Assert inMargin(unsaid_court).

  Passage seam_lake "the lake at the Seam" is passage between seam and grey_shore taking 1 hour
    opening when riteArranged(rook) and anchorDays(margin) > 0 "The lake is only cold water to the ankle, and the far wall is only a wall.".
  Passage shore_drifts "the drifts along the shore" is path between grey_shore and drifts taking 30 minutes.
  Passage drifts_hollow "a lane nobody remembers" is path between drifts and hollow_lanes taking 1 hour.
  Passage reeve_door "the reeve's door" is door between hollow_lanes and reeve_house.
  Passage far_field_gate "the gate to the far field" is gate between hollow_lanes and far_field.
  Passage hollow_far "the grey road" is path between hollow_lanes and grey_library taking 2 hours.
  Passage library_place "a fence round nothing" is path between grey_library and mountain_place taking 1 hour.
  Passage library_fog "into the fog" is path between grey_library and short_grey_fog taking 1 hour.
  Passage place_court "toward what is gathering" is path between mountain_place and unsaid_court taking 1 hour.

  Topic rook_anchor with rook "Ask Prioress Rook to anchor the company across the lake at the Seam" when knows(actor, seam_found) and not riteArranged(rook) {
    Says "The prioress is quiet for a long time. 'Thirty years nobody has asked,' she says. 'My sisters will go down with you to the chamber and forget you there: that is how you cross. Then they will come up, and we will say your names here, all of us, in turns, day and night, until you walk back out of the lake.' She takes your hands one by one and looks at each face as if learning it. 'We are only nurses. We can hold you two days. If you want longer, ask the people who owe you, or who love you. Ask a Keld if you can find one who will; a Keld cannot forget, and will hold you as long as you need.'".
    On discuss { Assert riteArranged(rook). Set anchorDays(margin) to 2. }
  }
  Relation anchoring(group).
  Topic pennick_anchor with pennick "Ask Judge Pennick to stand anchor for the company" when riteArranged(rook) and deedsBack(pennick) and not anchoring(pennick) {
    Says "'The law is a way of remembering on purpose,' says the judge. 'I said that to you once. I'll sit in the hospice and say your names in court hours and out of them.' She writes them down first, so she will have them right.".
    On discuss { Assert anchoring(pennick). Increase anchorDays(margin) by 2. }
  }
  Topic prew_anchor with nameless "Ask Absalom Prew to stand anchor for the company" when riteArranged(rook) and prewBack(nameless) and not anchoring(nameless) {
    Says "'Seven months nobody could say my name,' says Absalom Prew. 'I'll say yours till my voice goes.' His wife, beside him, says she will say them when it does.".
    On discuss { Assert anchoring(nameless). Increase anchorDays(margin) by 2. }
  }
  Topic bram_anchor with bram "Ask Bram Coyle to stand anchor for the company" when riteArranged(rook) and lensHome(bram) and not anchoring(bram) {
    Says "Bram puts the lens in his drawer with the ring and the bill of sale. 'Things come back to this house,' he says. 'So will you.'".
    On discuss { Assert anchoring(bram). Increase anchorDays(margin) by 2. }
  }
  Topic saska_anchor with saska "Ask Mother Saska to stand anchor for the company" when riteArranged(rook) and not anchoring(saska) {
    Says "Mother Saska looks at you for a long time. 'My grandmother was over there,' she says. 'The anchors who brought her back were Marra Coyle and her daughter, and they said her name for nine days.' She settles in her chair. 'I will not forget you. I cannot. Go and come back.'".
    On discuss { Assert anchoring(saska). Increase anchorDays(margin) by 100. }
  }
  Relation lensHome(group).
  Event lens_home near bram when keeps(bram, wenna_lens) "Bram unwraps the lens and holds it to the window, and the window stands in it whole. He puts it back in the drawer with Wenna's mother's ring." then {
    Assert lensHome(bram).
  }
  Initially Assert wants(bram, wenna_lens_kind).

  // The days in the grey, counted by the anchors' voices.
  Rule into_the_grey when at(party, ?p) and inMargin(?p) and not crossing(party) { Assert crossing(party). Set nextAnchor(margin) to watch(clock) + 144. }
  Rule out_of_the_grey when crossing(party) and at(party, ?p) and not inMargin(?p) { Retract crossing(party). }
  Rule anchors_tire when crossing(party) and watch(clock) >= nextAnchor(margin) and anchorDays(margin) > 0 {
    Decrease anchorDays(margin) by 1. Set nextAnchor(margin) to nextAnchor(margin) + 144.
  }
  Rule anchors_fall_silent when crossing(party) and anchorDays(margin) == 0 and not stranded(party)
    says "Somewhere very far off, a voice that has been saying your name for days says it once more, hoarsely, and stops. Nobody takes it up. The grey is very quiet, and you find you cannot remember what the shore looked like, or which way it was." {
    Assert stranded(party).
  }
  Observe anchors_heard at grey_shore when crossing(party) and anchorDays(margin) > 0 "Very faint, from nowhere, voices are saying your names, one after another, over and over, the way a grave-caller reads a row.".
  Observe end_stranded near party when stranded(party) and not knows(party, ending_told) "Nobody is saying your names. You are in the grey with the gloves and the lost buckets and the field-names nobody beats any more, and in the Corrow they are trying to remember who it was the hospice was anchoring that winter, and failing." teaches ending_told.

  // ── The grey country ─────────────────────────────────────────────────────────────────────────────────────────────
  Observe grey_shore_scene at grey_shore when true "A shore of grey grass under a sky the colour of nothing, with no sun and no horizon. Behind you is a lake, and in it, faint as breath on glass, the dome of the Seam. Things stand on the shore with their backs to the water: a sheep, a cart-wheel, a man in a Peleth coat, all quite still, all facing inland.".
  Observe drifts_scene at drifts when true "The drifts. Lost things lie against fences that are forgotten boundaries, banked like snow on the windward side: gloves by the thousand, buttons, keys, a Peleth ledger swollen to twice its size, a child's shoe, a whole hayrick, a dog collar, a well-bucket. Everything anyone in the Corrow ever put down and forgot is here, and most of it is single.".
  Observe hollow_scene at hollow_lanes when true "Keld Hollow: thirty houses in a lane, whole and swept, with smoke going up straight from every chimney into the no-sky. Nobody is in the lanes. The houses remember being lived in; their people went home in 2606.".
  Observe reeve_empty at reeve_house when webbNamed(webb) "The reeve's house. The hearth is cold for the first time in two hundred years: the one this house was keeping warm has gone home to Keld, and it knows. A bed, a chair, a coat-peg with nothing on it. It is waiting for somebody.".
  Observe reeve_kept at reeve_house when not webbNamed(webb) "The reeve's house. A fire on the hearth, low. A young man's coat on the peg by the door, still warm, as if he had just gone out to the far field and would be back in a minute.".
  Observe far_field_scene at far_field when true "The far field: a stone wall round a square of grey grass, and in the middle a hay-fork standing upright in the ground where somebody stuck it and walked away.".
  Observe library_scene at grey_library when true "A library with no titles: shelves going away in every direction, and on them books, scrolls, keepstone plates, tally-chains, all without a name, all Calvessan. Half of a people's history, let go on one night in 1 BB to save the world. Some of the books are open, as if someone had been reading.".
  Observe place_scene at mountain_place when true "Here is a hole. Not in the ground: in the grey itself, a hole-shaped absence a kilometre and more across, ribbed down its sides, three hundred metres deep, with nothing at the bottom and nothing in it at all. It is exactly the shape of the Socket. It is where the mountain belongs. It is waiting.".
  Observe fog_scene at short_grey_fog when true "Fog, standing still. In it, the Wend valley of 2604 as the Short Grey left it: a stretch of road, a hedge, a pear-tree, and a woman's footprints going in and not coming out.".
  Observe gathering_scene at unsaid_court when not unsaidCrossed(margin) and not unsaidSent(margin) and not unsaidSlain(margin) "Things are gathering here, drawn in from the whole grey country the way water is drawn to a drain: coats, hats, a cart, a carved door, names off gravestones written on nothing, a Peleth ledger, a great deal of fog. In the middle of it all something stands up out of it, tall, and wears it.".
  Observe gathering_empty at unsaid_court when unsaidCrossed(margin) or unsaidSent(margin) or unsaidSlain(margin) "Nothing is gathering here now. The things lie where they fell.".

  // The blue bucket, which Sabeth Coyle lost on an elver morning in 2601.
  Kind blue_bucket "a blue bucket, a good one, with an old chalk tally on its side" is treasure worth 0 weighing 2.
  Item bucket "a blue bucket" is blue_bucket at drifts.
  Event bucket_home near bram when keeps(bram, bucket) "Bram turns the bucket round in his hands and reads the chalk on its side, which has not rubbed off in a hundred and thirty years: eleven strokes, in his great-great-grandmother's hand. 'Gran said there was a blue bucket,' he says. 'Her gran's. It went in the fog one elver morning.' He sets it on the bench by the lens-grinder's lap, and it looks as if it had always been there." then {
    Assert bucketHome(bram).
  }
  Relation bucketHome(group).
  Initially Assert wants(bram, blue_bucket).

  // The untitled library: the old rite of 300 BB, and what the Unsaid is.
  Discovery way_home_rite "The Forgetting of the Way Home, laid in an untitled Calvessan plate in the grey library: in 300 BB, when an Ondrek war-band held the Wendhead, three hundred of the Calvessa sat in a ring across the raiders' road and forgot, together and on purpose, the road home. The raiders wandered the plateau until they died. It needs three hundred who can forget, sitting across the road the enemy must take, and it takes something from them in payment. The plate does not say what. The rite is laid so that whoever performs it will not remember doing so." {
    Source rite_plate "an untitled plate of laid stone, open on a reading-stand" at grey_library readable by party.
  }
  Discovery library_name "In the untitled library, an open book in Concord hand of 412: the Lettings' own record of the Long Rite. They read the star's name in the Root, it says, and let it go; and on the last page, in another hand: 'The star did not go. We have let go of the wrong thing.'" {
    Source rite_record "an open book in Concord hand" at grey_library readable by party.
  }
  Observe library_inference near party when knows(party, library_name) and not knows(party, unsaid_is_name) "'We have let go of the wrong thing.' The name went. The star stayed. And something in the grey has been gathering itself round a name ever since." teaches unsaid_is_name.

  // The mountain's place: a stone of the absence is Hightown's place in a pocket.
  Kind place_stone "a stone of the mountain's place, which weighs nothing at all" is treasure worth 0 weighing 0.
  Item absence "a stone of the mountain's place" is place_stone at mountain_place.
  Observe absence_seen at mountain_place when at(absence, mountain_place) "On the lip of the hole a stone lies loose, grey, ribbed like the rest. When you lift it, it weighs nothing at all, and your hand knows the shape of the Socket.".

  // Iniry Calde, forgotten in the Short Grey of 2604.
  Person iniry "Iniry Calde" at short_grey_fog {
    Role "a Calvessan mnemonist of 590 AB, forgotten in the Short Grey". Ancestry human. Calling mage. Level 9. Peaceable.
    State forgotten "A woman in a Calvessan robe sits on a milestone in the fog with her hands in her lap. She is young-looking and very old at once, and furious, and patient.".
    State returned "Iniry Calde is in the Corrow again, and does not like the weather.".
  }
  Topic iniry_who with iniry "Ask the woman on the milestone who she is" when state(iniry, forgotten) once {
    Says "'Iniry Calde,' she says, 'of the charge of the old forgettings. They locked me in the Quiet Gaol in 590 for trying to forget the Chain. A party of heroes let me out in 2601. Three years later a fool of a Letting brother and I tried his great-grandfather's rite, and it took us both.' She considers you. 'Nobody up there has said my name in a hundred and twenty-seven years. You cannot anchor what nobody remembers.' She looks at the fog. 'I know the old rites better than anyone living or forgotten. Learn my name, up there, from someone who wrote it down, and say it at the shore, and I will come.'".
  }
  Topic iniry_rite with iniry "Ask Iniry Calde about the Forgetting of the Way Home" when state(iniry, forgotten) once {
    Says "'Three hundred,' she says at once. 'Who can forget: no Keld, then. Sitting in a ring across the road the enemy must take, before it takes it. You will lose something. You choose what; the rite takes it whether you choose or not, so choose.' She almost smiles. 'It is the only rite that ever won a war in this country. They taught it to children once, without its words, as a skipping game.'".
    On discuss { Assert knows(actor, way_home_rite). }
  }
  Discovery iniry_named "In the Letting record of the Short Grey, among the lost: 'Iniry, of the old charge, Calde; went into the fog on the fortieth day with Brother Cosk, saying she would bring him back. Neither came.'".
  Observe iniry_in_record near party when carries(party, short_grey) and knows(party, short_grey_syllable) and not knows(party, iniry_named) "Further on in the record, among the lost: 'Iniry, of the old charge, Calde; went into the fog on the fortieth day with Brother Cosk, saying she would bring him back. Neither came.'" teaches iniry_named.
  Action call_iniry(actor: group, site: place) "Say Iniry Calde's name aloud on the shore, as the record wrote it, and mean it" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, grey_shore) and knows(actor, iniry_named) and state(iniry, forgotten).
    Time 1.
    On success { Assert state(iniry, returned). Assert at(iniry, hospice_hall). }
    Result "You say it to the grey: Iniry, of the old charge, Calde. For a while nothing. Then she is beside you on the shore with fog on her robe, and she walks past you into the lake without a word, and the lake lets her. When you come up she is in the hospice hall, drinking the prioress's tea and telling her everything she is doing wrong.".
  }

  // ── The Unsaid ───────────────────────────────────────────────────────────────────────────────────────────────────
  Person unsaid "the Unsaid" at unsaid_court {
    Role "a name without its thing, wearing forgotten things". Peaceable.
  }
  Relation unsaidHoused(place). Relation unsaidSent(place). Relation unsaidSlain(place).
  Discovery road_fragments "Three fragments of a road, given up by the Unsaid: the keeper Wenna Coyle's lapses as she fled with the Hush in 2641, moments she let fall into the grey as she went: a night sky with a burnt line up it, north-north-east and up; a wall of cloud with a door in it; a long road of fused air with a star at the end of it, burning.".
  Topic unsaid_wants with unsaid "Ask the Unsaid what it wants" when not unsaidCrossed(margin) and not unsaidSent(margin) and not unsaidSlain(margin) and not unsaidHoused(margin) {
    Says "It does not speak. Things speak for it: a lost hat says 'I', a Peleth ledger says 'was', a gravestone name nobody reads says 'mine'. Slowly, out of a hundred dropped words, you hear it: I WAS SAID ONCE AND THEN NOT. I AM THE SAYING WITHOUT THE THING. THE THING HAS GONE UP THE ROAD AFTER THE JEWEL. I HAVE THREE PIECES OF THE ROAD THAT THE KEEPER DROPPED. TELL ME THE REST. OR SAY ME, AT THE SEAM, AND I WILL FIND IT MYSELF.".
  }
  Action house_unsaid(actor: group, site: place) "Ask Teshen to give the Unsaid a name and a place: the reeve's empty house in Keld Hollow" {
    Description "A Stray named aloud by someone who means it, and given a place, stops taking. The reeve's house is empty now that Corin is home.".
    Requires able(actor) and company(actor) and at(actor, site) and at(unsaid, site) and travelsWith(teshen, actor)
      and knows(actor, unsaid_is_name) and webbNamed(webb) and not unsaidHoused(margin) and not unsaidSent(margin) and not unsaidSlain(margin) and not unsaidCrossed(margin).
    Time 2.
    On success { Assert unsaidHoused(margin). Assert at(unsaid, reeve_house). Assert knows(actor, road_fragments). }
    Result "Teshen walks into the gathering until the things it wears brush her face, and stands there. 'You're the name of the star,' she says, 'that was said and then not. That's who you are. It's not nothing; it's a name.' The coats and the hats go still. 'And your place is the reeve's house in the Hollow, where Corin lived, because Corin's gone home and the house is waiting for somebody, and the somebody is you.' For a long time nothing moves. Then the Unsaid walks past her, very slowly, out of the gathering and down the grey road, shedding gloves, toward Keld Hollow. When it is gone there are three things lying where it stood: three pieces of a road.".
  }
  Action send_unsaid(actor: group, site: place) "Tell the Unsaid where its body went" {
    Description "North-north-east, and up: the road the star came down. Telling is acting.".
    Requires able(actor) and company(actor) and at(actor, site) and at(unsaid, site)
      and (knows(actor, wenna_band) or knows(actor, horn_bearing) or knows(actor, nail_negative))
      and not unsaidHoused(margin) and not unsaidSent(margin) and not unsaidSlain(margin) and not unsaidCrossed(margin).
    Time 1.
    On success { Assert unsaidSent(margin). Assert at(unsaid, limbo). Assert knows(actor, road_fragments). }
    Result "You tell it: north-north-east and up, the road the star came down, the way the horn points. The things it wears turn, all together, like a field of barley in wind, toward a direction that is not a direction in the grey. Then they fall. Coats, hats, ledgers, fog: all of it drops in a heap where it stood, and in the heap lie three pieces of a road, and the Unsaid is gone, up and out, after its body.".
  }
  Action unmake_unsaid(actor: group, site: place) "Tear the forgotten things off the Unsaid until there is nothing left to wear them" {
    Description "Everything it wears was taken from somebody.".
    Requires able(actor) and company(actor) and at(actor, site) and at(unsaid, site)
      and not unsaidHoused(margin) and not unsaidSent(margin) and not unsaidSlain(margin) and not unsaidCrossed(margin).
    Time 6.
    On success { Assert unsaidSlain(margin). Assert at(unsaid, limbo). Assert knows(actor, road_fragments). }
    Result "You pull. Coats come away, and hats, and names, and the fog it wears like wool tears and drifts off, and under each thing there is another, and you pull for an hour while it says nothing at all. At the end there is a heap of the forgotten, and nothing standing in it, and three pieces of a road at the bottom. Then the heap is not there. Everything it took has gone home at once: across the whole grey country things are lifting and going, and through the grey sky above the mountain's place something enormous and invisible is falling, back, toward where it belongs.".
  }
  // Everything the Unsaid took goes home at once: the mountain's place among them.
  Rule place_returns when unsaidSlain(margin) and not placeReturned(margin) and not crashed(hightown) and not lost(hightown) and not grounded(hightown)
    says "In the Corrow, at the same hour, every Counterweight on Hightown stops what they are doing and looks north, at the lake, and knows it, all at once, as if they had always known." {
    Assert placeReturned(margin). Increase heard(hightown) by 600.
  }
  Relation placeReturned(place).

  // Teshen, at last, can be a stranger.
  Action teshen_stays(actor: group, site: place) "Let Teshen stay in the grey, where nobody can see her" {
    Description "Over here she is the first Keld in a hundred and twenty years that nobody remembers.".
    Requires able(actor) and company(actor) and at(actor, site) and travelsWith(teshen, actor) and at(actor, ?p) and inMargin(?p).
    Time 1.
    On success { Retract travelsWith(teshen, actor). Assert at(teshen, hollow_lanes). Assert strangerAtLast(teshen). }
    Result "Teshen stands in the grey and looks at her own hands as if they were someone else's. 'Nobody's looking at me,' she says. 'Nobody here is going to remember my face.' She laughs, and then she is crying, and then she laughs again. 'Go on. I'll be in the Hollow. If you ever need a stranger, come and not-find me.' She walks off up the lane, and for the first time since you met her, you find you cannot quite remember what she looks like.".
  }
  Relation strangerAtLast(group).
}
