Module gaunt "A Winter in Carth" {
  // The country beyond a march of a generated world: the company that comes in at the Penitent's Cross is the world's own.
  Entity party: group "Your company".
  // What is said of the Levels of Gaunt in the country behind it: once it is seen through, it is old news there.
  Entity word: fact "What is said of Gaunt and the Ash Day trial in the country behind it.".
  Rule word_old when bookClosed() and not stale(word) { Assert stale(word). }
}
