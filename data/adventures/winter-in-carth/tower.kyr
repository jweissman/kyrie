Module gaunt "A Winter in Carth" {
  // ── The unfinished tower ──────────────────────────────────────────────────────────────────────────────────────────
  // The north tower has stood unfinished since the year the Commerce began, because the Fabric's fees are the
  // Commerce's tithe, and the day the tower is finished the Fabric has no reason to take them. Old Joby Thwaite, master
  // mason, seventy-one, sets its last course by day; by night Canon Hamo Laverock, Master of the Fabric, has his men take
  // it down. Joby does not know why it never rises. Laverock is also the Scaifes' landlord, and the Consistory's
  // prosecutor.
  Person joby "Old Joby Thwaite" at fat_lamb {
    Role "a master mason of seventy-one with stone-dust in his eyebrows and hands like two mallets, eating a pie with great concentration". Ancestry human. Peaceable. Pronouns he. Manner jovial.
    Greets "The old man with the stone-dust eyebrows points at the bench opposite with his pie. 'Sit,' he says. 'You've a look of somebody who's seen the north tower. Everybody gets that look.' He chews. 'Fifty-three years I've been setting the last course on it. Fifty-three. I'm the only man alive who's seen it with all four corners level.' He chews. 'Tuesday week, that was.'".
    Greets again "Joby Thwaite waves his pie at you.".
  }
  // His day: the tower by day, the Fat Lamb at noon and in the evening.
  Rule joby_tower when daytime() and not (hour(clock) >= 12 and hour(clock) < 13) and not at(joby, tower_foot) and not jobyGuards(joby) { Assert at(joby, tower_foot). }
  Rule joby_dinner when hour(clock) >= 12 and hour(clock) < 13 and not at(joby, fat_lamb) and not jobyGuards(joby) { Assert at(joby, fat_lamb). }
  Rule joby_evening when hour(clock) >= 18 and hour(clock) < 22 and not at(joby, fat_lamb) and not jobyGuards(joby) { Assert at(joby, fat_lamb). }
  Rule joby_bed when (hour(clock) >= 22 or hour(clock) < 7) and not at(joby, masons_lodge) and not jobyGuards(joby) { Assert at(joby, masons_lodge). }
  Relation jobyKnows(group). Relation jobyLeave(group). Relation jobyGuards(group). Relation courseSet(group).
  Topic joby_tower with joby "Ask Joby Thwaite why the north tower is never finished" when not jobyKnows(joby) once {
    Says "'Frost,' says Joby. 'The Master of the Fabric says frost. You set a course, and the frost gets in the mortar overnight, and in the morning it's spalled, and you've to take it down and set it again.' He finishes his pie and looks at the crust. 'Fifty-three years I've been a mason, and I never saw frost do it in a night anywhere but here.' He brushes his hands. 'I'd a lad once who said it wasn't frost. Said it in here, drunk, at that table. They put him out of the Gate of Ash for it.' He looks at the crust a long time. 'Laverock says it's the tower. It's a holy tower. It's humble. It doesn't want to be finished.' He looks at you. 'I'd like to see it finished,' he says, simply, 'before I'm humble.'".
  }
  Initially Assert teachesAt(unbuilding, gaol_lane). Initially Assert teachesAt(unbuilding, tower_foot).
  Discovery unbuilding "By night, by lantern, Canon Laverock's men take down the course of stone Joby Thwaite's masons set on the north tower by day: the tower is kept unfinished on purpose.".
  Observe unbuilt_seen at tower_foot when (hour(clock) >= 21 or hour(clock) < 4) and not seenOnce(unbuilding) "Up on the scaffold, at the top platform, by the light of a horn lantern, three men in the Fabric's brown are taking today's course of white stone down, one block at a time, with a crowbar and a rope and a great deal of care, and lowering it on the pulley to the ground, where a fourth man stacks it with the others, quietly, under a tarpaulin. One of them says something and another laughs, softly. Below them, in the shadow of the lodge door, a canon in a fur tippet is watching, with his hands in his sleeves." teaches unbuilding.
  Observe unbuilt_lane at gaol_lane when (hour(clock) >= 21 or hour(clock) < 4) and not seenOnce(unbuilding) "Over the Close wall you can see the top of the north tower's scaffold, and on the top platform, by the light of a horn lantern, men in brown taking the day's new stone down, block by block, very carefully, and lowering it on a rope; a canon in a fur tippet watching from below with his hands in his sleeves." teaches unbuilding.
  Topic joby_told with joby "Tell Joby Thwaite what you have seen on the scaffold at night" when knows(actor, unbuilding) and not jobyKnows(joby) once {
    Says "Joby Thwaite puts down his pie. He sits for a long time with his big hands flat on the table. 'Frost,' he says at last. 'Fifty-three years.' And then, much more quietly: 'Cuthbert.' He does not shout; masons do not. He stands up, very slowly, as a wall stands up. 'Fastens' Eve,' he says. 'We'll set it in the morning, and we'll sit up with it at night, the lodge, all of us, with our mallets. Let them come with their crowbar.' He looks at you. 'You'll come and sit with us. The lodge door's open to you, now, the yard door off the Steps. Any time. Tell the lads Joby said.'".
    On discuss { Assert jobyKnows(joby). Assert jobyLeave(party). }
  }
  Topic joby_fold with joby "Tell Joby Thwaite that his son is alive, in the put-outs' fold on the Levels" when jobyKnows(joby) and knows(actor, cuthbert_story) and not jobyToFold(joby) once {
    Says "Joby Thwaite holds the last of his pie and does not eat it. 'Alive,' he says. 'Out there.' He turns his head as if he could see through the wall of the Fat Lamb and both the walls of the city to the Levels. 'Nineteen years. I could have walked it in an hour.' He puts the pie down. 'Ash Day,' he says. 'When the course is set and stood. I'll take him a lantern. He'll know what it means.'".
    On discuss { Assert jobyToFold(joby). }
  }
  // Fastens' Eve: the masons sit up with the stone; whoever sits with them sees the Fabric's men come and go away.
  Rule masons_guard when jobyKnows(joby) and eveDay() and hour(clock) >= 20 and not jobyGuards(joby) { Assert jobyGuards(joby). Assert at(joby, tower_foot). }
  Rule masons_stand when jobyGuards(joby) and ashDay() and hour(clock) >= 6 and not courseSet(joby) { Assert courseSet(joby). Retract jobyGuards(joby). }
  Rule masons_seen at tower_foot when jobyGuards(joby) and at(party, tower_foot) and hour(clock) >= 22 and not spread(masons_seen)
    says "At ten the Fabric's men come round the lodge corner with their lantern and their crowbar, and stop. On the scaffold, on every platform, in the dark, there is a mason sitting with his mallet across his knees: eleven of them, and Joby at the top, with his legs over the edge. Nobody says a word. After a while the Fabric's men go away. Somebody on the second platform begins to sing, quietly, a masons' song about a wall, and the others take it up, and at midnight, when the tenor bell rings the Fast in over their heads, they are still singing." { Assert spread(masons_seen). }
  Entity masons_seen: fact "the masons on the scaffold".
  Observe course_stands at tower_foot when courseSet(joby) and not nightfall() "On the top platform of the north tower the new course of white stone is still there in the morning, all four corners level, and Joby Thwaite is sitting on it with his legs over the edge, asleep.".

  // The Fabric's night-men: from nine till four they hold the scaffold-yard, and nobody who sees them there is meant to
  // say so. They warn once, and then they are four men with crowbars in the dark. Ways round them: watch from Gaol Lane
  // over the wall; come into the yard at dusk, before they do; sit up with Joby's masons on Fastens' Eve, when they do
  // not come; or have their canon silenced.
  Person nightmen "the Fabric's night-men" at limbo {
    Role "four labourers in the Fabric's brown, with crowbars, and a horn lantern held low". Ancestry human. Calling warrior. Level 1. Numbers 4. Pronouns they.
    Temperament territorial. Refuge limbo.
    Warns "Four men in the Fabric's brown come out of the dark under the scaffold with crowbars, and one of them lifts a horn lantern to look at you, and lowers it. 'Fabric's business,' he says, quite low. 'There's nobody in the scaffold-yard at night. There never has been. Go back over the wall the way you came, and in the morning you'll not have seen anything; or stop, and in the morning they'll find you at the foot of it, and say it was the frost.'".
    Comes "They come at you all together and without a word, the way they take the stone down: carefully, and for wages.".
    Pleads "The night-men back off into the dark of the lodge corner with their crowbars held out in front of them, and the one with the lantern says, 'All right. All right. We were never here,' and blows it out.".
  }
  Rule nightmen_come when (hour(clock) >= 21 or hour(clock) < 4) and at(nightmen, limbo) and able(nightmen) and not routed(nightmen) and not jobyGuards(joby) and not pellowGone(pellow) { Assert at(nightmen, tower_foot). }
  Rule nightmen_go when hour(clock) >= 4 and hour(clock) < 21 and at(nightmen, tower_foot) { Assert at(nightmen, limbo). }
  Rule nightmen_stand_down when (jobyGuards(joby) or pellowGone(pellow)) and at(nightmen, tower_foot) { Assert at(nightmen, limbo). }

  // ── Canon Hamo Laverock ─────────────────────────────────────────────────────────────────────────────────────────────
  Person pellow "Canon Hamo Laverock" at close_green {
    Role "the Master of the Fabric, in a fur tippet, a pleasant round man with very clean hands". Ancestry human. Peaceable. Pronouns he. Manner jovial.
    Greets "'Welcome to the Close,' says the round canon, warmly. 'You'll have seen the tower. Everybody looks at the tower. Two hundred and eleven years.' He beams up at it. 'A great work of faith is never finished. That is how you know it is a great work of faith.'".
    Greets again "Canon Laverock beams at you.".
  }
  Rule pellow_day when daytime() and not sitting() and not at(pellow, close_green) and not pellowGone(pellow) { Assert at(pellow, close_green). }
  Rule pellow_night when not daytime() and at(pellow, close_green) { Assert at(pellow, limbo). }
  Relation pellowGone(group). Relation pellowExposed(group). Relation arrearsForgiven(group). Relation pellowBargain(group).
  Topic pellow_hern with pellow "Ask Canon Laverock about Ninian Hern" when true once {
    Says "The canon's face does something complicated and kindly. 'Poor Hern. A great penitent, once. Thirty years on the Steps.' He shakes his head. 'And now he says the Commerce of Merit is a fraud, on the Minster steps, to the Fabric's own congregation. Do you know what the Commerce of Merit builds?' He points at the tower. 'That. Faith made stone. If nobody pays for penance, nobody pays for the tower.' He lowers his voice. 'I shall prosecute him myself. Very gently. And he will be put out, gently, at the Gate of Ash, and the tower will go on.'".
  }
  Topic pellow_tell with pellow "Tell Canon Laverock you have seen his men take the tower down by night" when knows(actor, unbuilding) and not pellowExposed(pellow) and not pellowBargain(pellow) once {
    Says "Canon Laverock does not stop smiling, which is a terrible thing to watch. He takes your arm and walks you across the lawn, out of anyone's hearing. 'The frost,' he says. 'And if it were not the frost, what then? A finished tower is a finished tithe. Two hundred clerks, sixty masons, the Stand, the Row: it all hangs on the north tower not being finished.' He pats your arm. 'You've come down the fell. You'll know the Scaifes at Carth: the Fabric's tenants, two years behind. Lady Day, they go.' He lets that sit. 'Or they don't. Their arrears could be forgiven. Today. If you'd the goodness to have seen nothing on the scaffold.'".
    On discuss { Assert knows(actor, pellow_offer). }
  }
  Discovery pellow_offer "Canon Laverock will forgive the Scaifes' arrears to the Fabric, if the company keeps quiet about the unbuilding of the north tower.".
  Action take_pellow_bargain(actor: group, site: place) "Tell Canon Laverock you saw nothing on the scaffold, if the Scaifes' arrears are forgiven" {
    Requires able(actor) and company(actor) and at(actor, site) and at(pellow, site) and knows(actor, pellow_offer) and not pellowBargain(pellow) and not pellowExposed(pellow).
    Time 2 minutes.
    On success { Assert pellowBargain(pellow). Assert arrearsForgiven(carth_vigil). }
    Result "'Saw nothing,' says Canon Laverock, delighted. 'Nothing at all. The frost.' He writes a note on a leaf of his pocket-book and tears it out: the arrears of the tenement of Carth forgiven by the Master of the Fabric, for a work of charity. He gives it to a passing servitor. 'There,' he says. 'Mercy. That's what the Fabric is for.' He goes off across the Close humming. Up on the scaffold a mason is setting a white stone that will not be there in the morning.".
  }
  // Told to the Lady Penitentiary, at her desk or under her mask, Laverock is silenced: she does not let a canon who unbuilds
  // the Minster prosecute a man for saying the Commerce is a fraud.
  Rule pellow_silenced when pellowExposed(pellow) and not pellowGone(pellow) { Assert pellowGone(pellow). Assert at(pellow, limbo). }
}
