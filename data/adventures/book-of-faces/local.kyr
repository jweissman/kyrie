Module ombra "The Book of Faces" {
  // ── The city's most local file ────────────────────────────────────────────────────────────────────────────────────
  // Four small stories that belong to nobody's plot: two people who dislike each other on a ferry and love each other
  // in sentences (the Heron and the Lamp, Round 2); a letter-writer in whose book four hundred people have confided;
  // two umbrella-shops that have fought forty years over which was first; and a tallyman who bet his face on an eel.
  // Each is comic by procedure (a usage followed to its humane end) and each has a clock. Ids are lc_ except the
  // people the other files name (cosimo, lamb, sweet, ostler, penhallow).
  //
  // What this file asks of the others, and offers them:
  //   reads   rill (drip.kyr), vail (warrant.kyr), moll (faces.kyr), lacke and fenn (counting.kyr), faces, heat, goodwill.
  //   moves   cosimo, lamb, sweet and mine by their own rules; on the Swap night it also puts rill and cosimo at the
  //           Drip landing (see lc_swap_stage), since the Swap is the one night a ferrywoman's place is fixed by law.
  //   asserts roundDone(party, r_lovers), loversMet, loversRevealed, loversTogether, goodwill(face_magpie),
  //           and the lc_ relations below, which the integrator may read.

  // ── What the company has done, and what the city has done about it ───────────────────────────────────────────────
  // The Heron and the Lamp.
  Relation lcCosOpen(group). Relation lcCosWaited(group). Relation lcCosWilling(group). Relation lcCosEscorted(group).
  Relation lcRillOpen(group). Relation lcRillMayRefuse(group). Relation lcRillFear(group).
  Relation lcForged(group). Relation lcConfessed(group). Relation lcTold(group). Relation lcEstranged(group).
  Relation lcPaired(group). Relation lcLanternLow(group). Relation lcLanternHigh(group). Relation lcLifted(group).
  Relation lcByLaugh(group). Relation lcMetDark(group). Relation lcCivil(group). Relation lcLettersStopped(group).
  Relation lcCosUmbrella(group). Relation lcCosHurt(group). Relation lcStrokesSaid(group). Relation lcSentences(group).
  Measure lcCourage(group). Measure lcThaw(group). Measure lcBlessing(group).
  // Lyle and the Book of Hands.
  Relation lcDemand(group). Relation lcLambOpen(group). Relation lcLambKnown(group).
  Relation lcWarned(group). Relation lcWarnedHalf(group). Relation lcDecoyMade(group). Relation lcDecoyPassed(group).
  Relation lcIndexGiven(group). Relation lcSealed(group). Relation lcRead(group). Relation lcBurned(group).
  Relation lcSurrendered(group). Relation lcLedgerSafe(group). Relation lcDecoyCaught(group).
  // The umbrella war.
  Relation lcJudging(group). Relation lcTrialDraw(group). Relation lcRigged(group). Relation lcRiot(group).
  Relation lcDuelOff(group). Relation lcDuelled(group). Relation lcFuneral(group). Relation lcTruce(group).
  Relation lcMerged(group). Relation lcWedded(group). Relation lcPatentO(group). Relation lcPatentP(group).
  Relation lcQuiet(group). Relation lcBound(group). Relation lcLantern(group). Relation lcStood(group).
  Relation lcOstlerAsked(group). Relation lcPenAsked(group). Relation lcOstlerYields(group). Relation lcPenYields(group).
  Relation lcChildrenMet(group). Relation lcChildrenTold(group).
  // Sweet's wager.
  Relation lcSweetLost(group). Relation lcSweetBack(group). Relation lcSweetNew(group). Relation lcSweetSlate(group).
  Relation lcSweetTallied(group). Relation lcRaceFixed(group). Relation lcRaceRun(group). Relation lcRematch(group).
  Relation lcGudgeKept(group). Relation lcSweetAsked(group). Relation lcGudgeHeard(group).

  Query lcWarOver() means lcMerged(party) or lcWedded(party) or lcPatentO(party) or lcPatentP(party).
  Query lcSweetBareNow() means lcSweetLost(party) and not lcSweetBack(party) and not lcSweetNew(party) and not lcSweetSlate(party).
  Query lcRowQuiet() means lcWarOver() or lcTruce(party) or lcQuiet(party).
  // The company's readiness for the Swap: what the talk with each of them has done.
  Query lcPrep() means lcThaw(party) + lcCourage(party) + lcBlessing(party) >= 4.
  Query lcPrepHigh() means lcThaw(party) + lcCourage(party) + lcBlessing(party) >= 6.
  Query lcSour() means (lcForged(party) and not lcConfessed(party)) or lcTold(party) or lcEstranged(party).
  Query lcBoatOut() means lcPaired(party) and swapNight() and not lcOutcome(party).
  Query lcTrialOn() means day(clock) == 3 and hour(clock) >= 14 and hour(clock) < 17.
  Query lcRaceOn() means day(clock) == 3 and hour(clock) >= 18 and hour(clock) < 20.

  // ── Rooms of my own ───────────────────────────────────────────────────────────────────────────────────────────────
  // Lyle's booth is behind her stall in the arcade; Cosimo has a room over the umbrella-shops; and the Swap puts two
  // masks in a boat in the middle of the Cuff, which is a room for one night.
  Place lc_booth_house "the letter-writer's booth" is building within post_sleeve.
  Place lc_booth "the letter-writer's booth" is room within lc_booth_house at 0, 0 indoors.
  Place lc_dray_house "the lodging over Penhallow's" is building within drip_sleeve.
  Place lc_dray_room "the room under the slates" is room within lc_dray_house at 4, 0 indoors.
  Place lc_cuff "the middle of the Cuff" is room within drip_sleeve at 3, 4 outdoors.
  Passage lc_booth_door "the booth's curtain" is doorway between arcade and lc_booth.
  Passage lc_dray_stair "the stair to the lodging" is stair between umbrella_row and lc_dray_room.
  Passage lc_cuff_way "the Swap ferry" is ferry between drip_landing and lc_cuff opening when lcBoatOut() "A ferry-stage with a chain across it, and a board: THE SWAP. FOR PAIRS ONLY, AT THE NINTH BELL OF THE FIFTH DAY.".

  // ── Scenes: Umbrella Row and the two shops ────────────────────────────────────────────────────────────────────────
  Observe lc_row_day at umbrella_row when publicHours() "Umbrella Row is the one street in the Drip that is never entirely wet. It is roofed, after a fashion, by what it sells: umbrellas hung from every sill and hook and line, open, bobbing on their cords, red oilskin and green and the colour of weak tea, so that you walk in a long tent made of other people's wares and the rain makes the sound of a drum being brushed. At the two ends of the lane two shops stand eleven paces apart, door to door, and over each door hangs an umbrella as big as a cartwheel and a board that says THE FIRST. The boards do not agree which of them is lying.".
  Observe lc_row_night at umbrella_row when privateHours() "The Row at night is a tunnel of shut umbrellas, folded like bats, dripping. The two shops have their shutters up and their lamps out, and from between them, eleven paces of dark, comes the sound of two people not sleeping. A stair goes up beside Penhallow's to a lodging under the slates, with a candle in its window, late.".
  Observe lc_row_usages at umbrella_row when publicHours() "At the head of the lane, under its own scrap of oilcloth, a board painted with the Usages of Umbrella Row, in the careful, outraged lettering of a thing that has had to be enforced. The fourth and the fifth have been gone over in fresh paint." teaches lc_usages.
  Observe lc_row_cousins at umbrella_row when day(clock) == 3 and hour(clock) >= 13 and hour(clock) < 17 and not lcRowQuiet() "Each shop has put out its cousin. Ostler's has a big slow man in an oilskin hood, standing in his own doorway as a man stands who has been told which door; Penhallow's a lean one, who keeps turning his umbrella, closed, in his hand, so that the ferrule goes round and round like the needle of an instrument. Neither looks at the other. Between them somebody has chalked a line across the cobbles and somebody else has rubbed half of it out.".
  Observe lc_row_waiting at umbrella_row when day(clock) == 3 and hour(clock) >= 17 and hour(clock) < 19 and lcDuelled(party) "The cobbles in front of Ostler's have been scrubbed, and the scrubbing has made it worse. Penhallow's shutters are up. Nobody is selling anybody an umbrella, and the rain, which has no cousins, comes down on both doors alike.".
  Observe lc_row_after at umbrella_row when day(clock) > 3 and lcDuelled(party) and not lcWarOver() and not lcFuneral(party) "Umbrella Row is open, and it is quiet in a way that costs money. Ostler's cousin sits on a stool with his arm in a sling and Penhallow's has a bandage round his head like a man in a mask he did not choose, and neither shop will serve a customer who has been in the other.".
  Observe lc_row_funeral at umbrella_row when lcFuneral(party) "There is crêpe on Ostler's door, a hand's breadth of black over the board that says THE FIRST, and Penhallow's shutters are closed in the middle of the day. In the eleven paces between them, nobody walks. The Concord ended the feuds three hundred years ago, and the Row has been very proud of it, and has just found out how much of the pride was habit.".
  Observe lc_row_merged at umbrella_row when lcMerged(party) "One board now hangs where there were two, over a door that has been cut through the wall between the shops: OSTLER & PENHALLOW, THE FIRST. Underneath, in smaller letters, still wet, AND ONLY. The two cartwheel umbrellas have been lashed together over the gap, a double canopy, and the Row walks under it as under a roof, in the dry, a little stunned.".
  Observe lc_row_wed at umbrella_row when lcWedded(party) "The Row has been hung with ribbons, red oilcloth ribbons, in two shades that were chosen, you can see, by two different committees and have been made to agree. The two boards still say THE FIRST, but someone has run a line of paint between them, from one to the other, like a stitch.".
  Observe lc_row_patent_o at umbrella_row when lcPatentO(party) "Ostler's has a new board, THE FIRST BY THE ROW'S OWN JUDGEMENT, with a ribbon on it, and a queue. Penhallow's has the shutters half down and a boy sweeping nothing off the step.".
  Observe lc_row_patent_p at umbrella_row when lcPatentP(party) "Penhallow's has a new board, THE FIRST BY THE ROW'S OWN JUDGEMENT, with a ribbon on it, and a queue. Ostler's has the shutters half down and a girl standing in the door with her arms folded over her apron, looking at nothing.".

  Observe lc_ostler_day at ostler_shop when publicHours() "Ostler's is a long low room that smells of hot wax and wet wool, and every flat thing in it is covered in ribs: whalebone, cane, and a pale split wood that {ostler} will not name, laid out in fans like the bones of some enormous hand. Oilcloth hangs from the rafters in bolts. Over the bench, in a glass case with brass corners, THE FIRST: an umbrella the colour of old tea, so patched that it is more patch than umbrella, with a card pinned under it in a hand like a row of fence-posts: OSTLER'S, 1251, RIBBED, OILED, AND NEVER LEAKED.".
  Observe lc_ostler_night at ostler_shop when privateHours() "The shop is dark and smells of cooling wax. In the case over the bench THE FIRST hangs very still, like a thing that has heard its name in the next room.".
  Observe lc_penhallow_day at penhallow_shop when publicHours() "Penhallow's smells of linseed and hot pitch and is so tidy it looks like a grievance. Every rib hangs by its length, every bolt of oilcloth by its shade, every ferrule on its own nail. Over the counter, in a glass case with brass corners, THE FIRST: an umbrella the colour of old tea, so patched that it is more patch than umbrella, with a card pinned under it in a copperplate hand: PENHALLOW'S, 1250, RIBBED, OILED, AND NEVER LEAKED.".
  Observe lc_penhallow_night at penhallow_shop when privateHours() "The shop is dark and orderly, and above the ceiling a floorboard creaks at intervals, as a floorboard does under a man who is walking the length of a small room and turning round.".

  // ── Scenes: the eel-pond ──────────────────────────────────────────────────────────────────────────────────────────
  Observe lc_pond_day at eel_pond when publicHours() "The eel-pond is a brown square of water the size of a threshing-floor, walled with slats, at the foot of the lane where the Drip gives up pretending to be a street. Nine flumes of planking run into it, each with a grating at its end and a number burnt into its post, and along the far side stands a shed with a hundred little doors, in each of which something is thinking. An old man in a patched Cockle sits on an upturned tub with a long-handled net across his knees. The Drip's eels are raced, bet on, and eaten, in that order, and not by the same people.".
  Observe lc_pond_night at eel_pond when privateHours() "The pond is black and ticking with rain. In the shed a hundred doors are shut on a hundred eels, and the smell of the place, mud and fish and lamp-oil, is the smell of the Drip's whole supper.".
  Observe lc_pond_lovers at eel_pond when hour(clock) >= 17 and hour(clock) < 20 and not lcChildrenMet(party) "At the far corner, where the last flume meets the wall, two Cockles stand a decent yard apart: a girl in an oilcloth hood, a boy with a cane. They are looking, with great attention, at an eel. They are not looking at each other, with even greater attention, and every so often one of them says something and the other does not answer for a long time, in the manner of people who have said it all before and are saving the rest." teaches lc_children_known.
  Observe lc_pond_race at eel_pond when lcRaceOn() and not lcRaceRun(party) "Half the Drip has come down to the pond with its umbrellas, and the pond has been railed, and nine lane-boards set, and odds chalked on a slate that is being rubbed out faster than it is written. At the near end a lanky tallyman in a Magpie is arguing happily with the air, with one hand on his own mask as though to keep it on.".
  Observe lc_pond_after at eel_pond when lcSweetLost(party) and not lcSweetBack(party) and not lcSweetNew(party) and not lcSweetSlate(party) "Under the shed's eaves, with his back to the slats and his knees up, a bare man sits on a lobster-pot. Nobody has told him to go. Nobody has spoken to him either: the pond has done what the Drip does with a face that has been lost, which is to walk round it, carefully, as round a puddle that might be deeper than it looks.".

  // ── Scenes: the arcade, and Lyle's booth ──────────────────────────────────────────────────────────────────────────
  Observe lc_arcade_day at arcade when publicHours() "The letter-writers' arcade is a row of stalls under one long awning of tarred canvas, every stall a desk and a stool and a stove the size of a hat, and above each a painted board: LETTERS WRITTEN, READ, FAIR-COPIED, ANSWERED. The Crows sit in their dominoes with their sleeves pinned back, and the rain comes off the awning in a fringe, and nobody under it raises their voice. Ombra is a city in which nobody is anybody, and it has to write to somebody.".
  Observe lc_arcade_night at arcade when privateHours() "The awning drips on the shut boards of the stalls. One lamp is lit at the far end, behind a curtain, and under the curtain a line of yellow, and the small dry sound of a pen that does not hurry.".
  Observe lc_arcade_stall at arcade when publicHours() and not lcSurrendered(party) and not lcBurned(party) "The last stall under the awning is the oldest: its board says only H. LAMB, and under that, in letters long since gone grey, ANSWERED. Behind the stool a curtain is looped back from a door the width of a coffin, and on a shelf inside it stand two baskets, side by side, each tied with wool, one red and one green. A lamp is painted on one lid and a heron on the other, and the hand that painted them is not the hand on the board." teaches lc_baskets.
  Observe lc_arcade_shut at arcade when publicHours() and (lcSurrendered(party) or lcBurned(party)) "The last stall under the awning has its board turned to the wall. The stool is gone in. The curtain has been let down, and tied.".
  Observe lc_booth_scene at lc_booth when true "A room the size of a confessional with a stove in it, and a desk that has taken most of the room and is not giving it back. Pens in a jar, sand in a box, a drift of fair copies under a stone. On the shelf over the stove two wool-tied baskets, a lamp on one lid and a heron on the other. Against the wall, in a sailcloth binding gone black at the edges with thumbs, stands the thickest book you have seen outside the Chapel: the Book of Hands, in which, it is said, there is no secret in Ombra that has ever been written down that is not also written there, in a smaller hand, with a price.".
  Observe lc_keyman_here at arcade when publicHours() and at(lc_keyman, arcade) "A man in a domino the grey of a key stands at the head of Lyle's stall with his back to the rain and his hands behind him, not buying anything. The Crows on either side have found something to write.".

  // ── Scenes: Cosimo's room ─────────────────────────────────────────────────────────────────────────────────────────
  Observe lc_dray_scene at lc_dray_room when true "A room under the slates over Penhallow's, reached by a stair so narrow it has opinions. A bed made with a clerk's corners, a table, a stool, a window on the Row so that the whole of the umbrella war can be followed from the pillow. A candle trimmed too short, a cut quill, a sandbox, and a japanned tin box the size of a loaf, with a lock in it that has never been turned. On the wall a card in a neat hand: ENTER NOTHING UNTIL IT BALANCES.".

  // ══ THE UMBRELLA WAR ═════════════════════════════════════════════════════════════════════════════════════════════════
  // Ostler's and Penhallow's have fought forty years over which made the first ribbed oiled umbrella: a Feud in
  // miniature, of the kind the Concord abolished three hundred years ago and could not quite make go away. The Concord
  // forbids a person to quarrel with a person; it never forbade a cousin, a cousin being nobody's person. On the
  // Deepening, at five, the hired cousins will settle it on the Row. Before that, at two, the Row's own custom (a
  // Trial of Umbrellas before a judge who sits bare, so that no face has a side in him) may be called, and has not been,
  // for forty years, because old Corder who judged it is dead and nobody in the Drip will sit bare in public.
  // On the Row a person is called by the shop that fed them, and the register's surnames are another matter: Maud Orrell is
  // an Ostler, Silas Haskew a Penhallow (the lint will not let two adventures share a surname, and the legacy ones had these).
  // Both Firsts are the work of one hand: Margery Ostler's, who married a Penhallow. Neither family knows. Three things
  // would tell them: the seam, the Usage that makes each pitch the other's umbrella, and two children.
  Discovery lc_usages "The Usages of Umbrella Row are painted on a board at the head of the lane: a cousin may be hired to quarrel where a person may not; the Trial of Umbrellas is called on the Third Day before a judge who sits bare, so that no face has a side in him; each maker pitches the other's First; and whoever loses a Trial is sheltered by the winner, and where both lose each shelters the other.".
  Discovery lc_war_known "Maud Orrell and Silas Haskew, across Umbrella Row, have fought forty years over which of their shops made the first ribbed, oiled umbrella; each has THE FIRST in a glass case, and each has hired a cousin to settle it with ferrules on the Row at five on the Deepening.".
  Discovery lc_children_known "A girl and a boy, both in Cockles, meet at the eel-pond in the evenings and say very little; neither has told the other whose child they are, and the Concord would not have let them ask.".
  Discovery lc_same_hand "THE FIRST in Ostler's case and THE FIRST in Penhallow's are ribbed alike, with a clove-hitch whipped three times at the third rib, and leak at the same seam: one hand made both.".
  Discovery lc_margery "The hand that made both Firsts was Margery Ostler's, who married a Penhallow: the ribbed umbrella is one family's, divided by a son and a nephew forty years ago over a year's difference on a card.".

  Kind lc_umbrella_kind "an oiled umbrella" is gear worth 4 weighing 2 described "A ribbed umbrella of oiled red cloth with a ferrule of brass, bought on Umbrella Row, where an umbrella is not a tool but a position. It keeps the rain off, which is more than most positions do.".
  Kind lc_founders_kind "a Founders' umbrella" is gear worth 9 weighing 2 described "Double-oiled, ribbed with a clove-hitch whipped three times at the third rib, and sold under a board that says only OSTLER & PENHALLOW. It is the best umbrella in Ombra, and it was made by two people who could not stand one another, which is the best reason for anything.".
  Item lc_umb_o "an umbrella from Ostler's" is lc_umbrella_kind at offstage.
  Item lc_umb_p "an umbrella from Penhallow's" is lc_umbrella_kind at offstage.
  Item lc_umb_f "a Founders' umbrella" is lc_founders_kind at offstage.
  Item lc_umb_w "the wedding umbrella" is lc_founders_kind at offstage.

  // ── Maud Orrell ───────────────────────────────────────────────────────────────────────────────────────────────────
  Person ostler "Maud Orrell" at ostler_shop {
    Role "umbrella-maker, of Ostler's". Ancestry human. Peaceable. Pronouns she. Manner proud.
    Known as "a stout woman in a Cockle with stained sleeves" when publicHours() and not knows(party, lc_ostler_face).
    Greets "A stout woman behind a bench of ribs looks up as you come in, and the look takes in your mask, your wet shoulders and your hands, in that order, to see whether any of them is Penhallow's. 'Ostler's,' she says. 'The first and the only, whatever the board across the way will tell you. What's your head?'".
    Greets again "'Ostler's,' says the stout woman, to the umbrella she is oiling.".
  }
  Initially Assert unmaskTeaches(ostler, lc_ostler_face).
  Discovery lc_ostler_face "The stout umbrella-maker in the Cockle is Maud Orrell, sixty-one, a widow, an Orrell by the register and an Ostler by her shop (on the Row a person is called by the shop that fed them), of Ostler's on Umbrella Row, who has not spoken a civil word to Penhallow's since the year her husband died.".
  Rule ostler_shop_day when hour(clock) >= 8 and hour(clock) < 20 and not (day(clock) == 3 and hour(clock) >= 14 and hour(clock) < 19 and not lcWarOver() and not lcDuelled(party)) and not at(ostler, ostler_shop) { Assert at(ostler, ostler_shop). }
  Rule ostler_row_trial when day(clock) == 3 and hour(clock) >= 14 and hour(clock) < 19 and not lcWarOver() and not lcDuelled(party) and not at(ostler, umbrella_row) { Assert at(ostler, umbrella_row). }
  Topic lc_ost_cold with ostler "Say good morning to Maud Orrell" when not masked(actor) and publicHours() once {
    Says "{ostler} goes on oiling. She does not say that she has not heard you; that would be to admit that there was something to hear. A bare face is an unoccupied space, and one does not apologise to a space for walking through it.".
  }
  Topic lc_ost_first with ostler "Ask Maud Orrell about the board over her door" when masked(actor) and publicHours() once {
    Says "'THE FIRST.' She says it the way a woman might say her husband's name. 'My great-grandmother's, in the year twelve fifty-one, by the Row's own register. Ribbed. Oiled. It has been in that case forty years and not leaked once. And across the way there is a man who will tell you his is older.' She puts the oil-pot down. 'By a year. A year! There are three hundred and sixty-five days in it, and in not one of them did a Penhallow have an idea.'".
    On discuss { Assert knows(actor, lc_war_known). }
  }
  Topic lc_ost_cousin with ostler "Ask Maud Orrell about the man in the oilskin hood" when masked(actor) and knows(actor, lc_war_known) and not lcRowQuiet() once {
    Says "'My cousin Ned. He is hired.' She is very calm. 'The Concord says a person may not quarrel with a person. A cousin is nobody's person. I did not make the Usage; I only read it.' She picks up the oil-pot again. 'He will be on the Row at five, with the ferrule capped, as the Usage says, and what a man does with his own cap is between him and his cap.' The hand with the pot is quite steady, and quite white.".
  }
  Topic lc_ost_trial with ostler "Ask Maud Orrell why the Row has no Trial of Umbrellas this year" when masked(actor) and knows(actor, lc_war_known) and not lcRowQuiet() once {
    Says "'Because there is no judge.' She says it too quickly. 'Old Corder judged it for thirty years, and sat bare for it, and died in the spring, and nobody in the Drip will sit on that stool without a face.' She looks past you at the Row. 'You would need a Bare. And who has ever heard of a Bare who was any use at all?'".
    On discuss { Assert knows(actor, lc_usages). }
  }
  Topic lc_ost_margery with ostler "Ask Maud Orrell who made THE FIRST" when masked(actor) and (lcMerged(party) or knows(actor, lc_same_hand)) once {
    Says "She takes a long time to answer. 'Margery. My great-grandmother's sister. The Ostlers had the idea and the Penhallows the money, I always said, and she married into the money.' She stops. 'She married a Penhallow. Josiah.' She looks across the Row at the board, and at the cartwheel over it, and says, quite softly, in the voice of a woman reading a stranger's will: 'Well. That is a great deal of forty years.'".
    On discuss { Assert knows(actor, lc_margery). }
  }
  Topic lc_ost_night with ostler "Knock on the stair, and ask Maud Orrell to say what she wants of the Row" when not masked(actor) and privateHours() and at(ostler, ostler_shop) once {
    Says "A lamp comes down the stair ahead of a woman in a nightgown and a shawl, with her face bare and her hair in a plait, which is how you can tell that a bare knock at night is a thing the Drip still receives. 'What I want?' says {ostler}. 'I want my husband to have lived to see her face when the Row says Ostler's was first.' She sets the lamp on the bench. 'He never did think much of it. He said an umbrella was an umbrella.' A silence. 'He was right, and I could have killed him.'".
  }

  // ── Silas Haskew ───────────────────────────────────────────────────────────────────────────────────────────────
  Person penhallow "Silas Haskew" at penhallow_shop {
    Role "umbrella-maker, of Penhallow's". Ancestry human. Peaceable. Pronouns he. Manner grim.
    Known as "a long grey man in a Cockle with a rule in his sleeve" when publicHours() and not knows(party, lc_penhallow_face).
    Greets "A long grey man at a counter does not look up from the length he is measuring; only his mask does, tilting, as a bird's head tilts. 'Penhallow's,' he says. 'Ribbed, oiled and dated. Whatever has been said to you across the way, I will thank you to check it against the register.'".
    Greets again "'Penhallow's,' says the long grey man, measuring.".
  }
  Initially Assert unmaskTeaches(penhallow, lc_penhallow_face).
  Discovery lc_penhallow_face "The long grey umbrella-maker in the Cockle is Silas Haskew, sixty-four, a widower, a Haskew by the register and a Penhallow by his shop, of Penhallow's on Umbrella Row, who keeps a register of everything and has never entered a kindness in it.".
  Rule penhallow_shop_day when hour(clock) >= 8 and hour(clock) < 20 and not (day(clock) == 3 and hour(clock) >= 14 and hour(clock) < 19 and not lcWarOver() and not lcDuelled(party)) and not at(penhallow, penhallow_shop) { Assert at(penhallow, penhallow_shop). }
  Rule penhallow_row_trial when day(clock) == 3 and hour(clock) >= 14 and hour(clock) < 19 and not lcWarOver() and not lcDuelled(party) and not at(penhallow, umbrella_row) { Assert at(penhallow, umbrella_row). }
  Topic lc_pen_cold with penhallow "Say good morning to Silas Haskew" when not masked(actor) and publicHours() once {
    Says "The rule in {penhallow}'s hand goes on along the length of cane to the mark and stops there. A bare face is not on the register. He writes something down, in any case, in a column on the counter. You do not see what.".
  }
  Topic lc_pen_first with penhallow "Ask Silas Haskew about the board over his door" when masked(actor) and publicHours() once {
    Says "'The twelve-fiftieth year.' He gives it to you as a figure, flat, in the voice in which he would give a weight. 'Entered in the Row's register on the fourth of the Rains. Ribbed, oiled. Never leaked.' The rule taps the counter once. 'Across the way, a year later, they discovered it. I do not say they copied. I say they were present at the time of the entry, and have been present since.'".
    On discuss { Assert knows(actor, lc_war_known). }
  }
  Topic lc_pen_cousin with penhallow "Ask Silas Haskew about the man with the ferrule" when masked(actor) and knows(actor, lc_war_known) and not lcRowQuiet() once {
    Says "'Kit. My late wife's nephew.' He does not stop measuring. 'The Concord abolished the Feud. It left the Usages, because the Usages were older, and nobody thought to look at the fourth.' A length of cane is set aside. 'If the Row will not put it to a Trial, it will put it to a cousin. I did not frame the alternative.' He glances, once, at the window, where a candle burns in a room over the shop by day. 'I would have preferred a judge.'".
  }
  Topic lc_pen_night with penhallow "Knock on the stair, and ask Silas Haskew what he is doing up" when not masked(actor) and privateHours() and at(penhallow, penhallow_shop) once {
    Says "He comes down in his shirt with a rule in his hand, as another man might come down with a poker, and sees a bare face, and puts the rule down. 'Sleeping,' says {penhallow}. 'I am doing a great deal of sleeping.' He sits on the counter. 'My wife used to say that a quarrel is a thing you keep warm for somebody who has gone. She said it of her father. She meant me.'".
  }

  // ── Wyn Orrell and Tam Haskew ──────────────────────────────────────────────────────────────────────────────────
  // Nineteen and twenty. They have met in the eel-pond lane every evening since the Rains began, each in a Cockle, which
  // is the humblest face in the Drip and worn by two hundred. Each took the other for some Cockle from the far end of the
  // islands, which is what the Concord means a mask to be for. Neither has asked. Nobody in Ombra would.
  Person lc_wyn "Wyn Orrell" at ostler_shop {
    Role "Maud Orrell's daughter, a girl in an oilcloth hood". Ancestry human. Peaceable. Pronouns she. Manner cheerful.
    Known as "a girl in a Cockle with an oilcloth hood" when publicHours() and not knows(party, lc_wyn_face).
    Greets "A girl in a Cockle looks up from a rib she is whipping, and for the space of a breath she has the face of someone who has been caught at something, and then no face at all, only the mask. 'We're shut to the cousins,' she says. 'Mother says. Are you a cousin?'".
    Greets again "'Not a cousin,' says the girl in the hood, with relief.".
  }
  Initially Assert unmaskTeaches(lc_wyn, lc_wyn_face).
  Discovery lc_wyn_face "The girl in the Cockle with the oilcloth hood is Wyn Orrell, nineteen, Maud's daughter, who whips ribs by day and by evening stands at the eel-pond with a boy whose family she has not asked.".
  Person lc_tam "Tam Haskew" at penhallow_shop {
    Role "Silas Haskew's son, a boy with a cane". Ancestry human. Peaceable. Pronouns he. Manner stoic.
    Known as "a boy in a Cockle with a cane in his fist" when publicHours() and not knows(party, lc_tam_face).
    Greets "A boy in a Cockle at the end of the counter, who has been looking at the ceiling, comes down from it. 'Sir,' he says, which is wrong, since you might be anyone, 'madam,' which is the same. 'We have umbrellas.' He holds the cane the way a man holds a thing that owes him money.".
    Greets again "'We have umbrellas,' says the boy, a little less certain than before.".
  }
  Initially Assert unmaskTeaches(lc_tam, lc_tam_face).
  Discovery lc_tam_face "The boy in the Cockle with the cane is Tam Haskew, twenty, Silas's son, who minds the counter by day and by evening stands at the eel-pond beside a girl whose family he has not asked.".
  Rule wyn_shop when hour(clock) >= 8 and hour(clock) < 17 and not at(lc_wyn, ostler_shop) { Assert at(lc_wyn, ostler_shop). }
  Rule wyn_pond when hour(clock) >= 17 and hour(clock) < 20 and not lcChildrenMet(party) and not at(lc_wyn, eel_pond) { Assert at(lc_wyn, eel_pond). }
  Rule wyn_home when (privateHours() or (hour(clock) >= 17 and lcChildrenMet(party))) and not at(lc_wyn, offstage) { Assert at(lc_wyn, offstage). }
  Rule tam_shop when hour(clock) >= 8 and hour(clock) < 17 and not at(lc_tam, penhallow_shop) { Assert at(lc_tam, penhallow_shop). }
  Rule tam_pond when hour(clock) >= 17 and hour(clock) < 20 and not lcChildrenMet(party) and not at(lc_tam, eel_pond) { Assert at(lc_tam, eel_pond). }
  Rule tam_home when (privateHours() or (hour(clock) >= 17 and lcChildrenMet(party))) and not at(lc_tam, offstage) { Assert at(lc_tam, offstage). }
  Topic lc_wyn_pond with lc_wyn "Ask the girl in the hood what she is looking at" when masked(actor) and at(lc_wyn, eel_pond) once {
    Says "'The eel in the sixth flume. He's very old.' She does not turn her head, and neither, three feet off, does the boy with the cane. 'Nobody bets on him. That's why I like him.' A pause you could stand a lantern in. 'Nobody comes here either, in the evenings. You'd think a pond would be popular.'".
    On discuss { Assert knows(actor, lc_children_known). }
  }
  Topic lc_tam_pond with lc_tam "Ask the boy with the cane what he is looking at" when masked(actor) and at(lc_tam, eel_pond) once {
    Says "'The eel,' says the boy, and then, because that is not enough, 'the sixth flume.' He looks at the water. 'There's a person here who knows a great deal about him. I come to be told.' He turns the cane over. 'I don't ask her anything. If I asked, she might say.'".
    On discuss { Assert knows(actor, lc_children_known). }
  }
  Topic lc_wyn_cold with lc_wyn "Say good evening to the girl in the hood" when not masked(actor) and publicHours() once {
    Says "The girl in the hood turns, and sees a bare face, and for a moment looks as scared as if she had seen a hole. Then she looks down at her rib again, and says nothing, with great firmness, as she has been taught.".
  }
  Topic lc_tam_cold with lc_tam "Say good evening to the boy with the cane" when not masked(actor) and publicHours() once {
    Says "The boy with the cane has been told that a Bare is not there, and he is a boy who does as he is told, and he tries, hard. It takes some effort. He is looking at the pavement as though it had a figure in it.".
  }

  // ── The cousins ───────────────────────────────────────────────────────────────────────────────────────────────────
  Person lc_ned "Ned Orrell" at offstage {
    Role "Maud Orrell's cousin, hired". Ancestry human. Peaceable. Pronouns he. Manner jovial.
    Known as "a big slow man in an oilskin hood" when publicHours() and not knows(party, lc_cousins_face).
    Greets "The big man in the oilskin turns the ferrule of his umbrella on the cobbles, slowly, a quarter-turn, as a man tests a tooth. 'Cousin,' he says, by way of introduction, and jerks his chin at the shop. 'Hired. I did it for the Ostlers once before, in the year of the cabbages. It was a wedding.'".
    Greets again "'Cousin,' says the big man, and sighs.".
  }
  Person lc_kit "Kit Haskew" at offstage {
    Role "Silas Haskew's late wife's nephew, hired". Ancestry human. Peaceable. Pronouns he. Manner acerbic.
    Known as "a lean man in an oilskin hood" when publicHours() and not knows(party, lc_cousins_face).
    Greets "The lean man does not stop turning his umbrella. 'I am not a cousin because I wish to be,' he says. 'I am a cousin because it is what the Row will pay me for, and because a Second's fees are more than it will.' He catches the ferrule in his palm, and looks at you as if you might be next.".
    Greets again "The lean man turns his umbrella.".
  }
  Initially Assert unmaskTeaches(lc_ned, lc_cousins_face). Initially Assert unmaskTeaches(lc_kit, lc_cousins_face).
  Discovery lc_cousins_face "The two men in the oilskin hoods are Ned Orrell and Kit Haskew, hired cousins, a drayman and a retired Second; neither has any quarrel with the other, or any idea what the quarrel is.".
  Rule ned_row when day(clock) == 3 and hour(clock) >= 13 and hour(clock) < 19 and not lcDuelOff(party) and not lcWarOver() and not lcFuneral(party) and not lcDuelled(party) and not at(lc_ned, umbrella_row) { Assert at(lc_ned, umbrella_row). }
  Rule kit_row when day(clock) == 3 and hour(clock) >= 13 and hour(clock) < 19 and not lcDuelOff(party) and not lcWarOver() and not lcDuelled(party) and not at(lc_kit, umbrella_row) { Assert at(lc_kit, umbrella_row). }
  Rule cousins_away when ((lcDuelOff(party) or lcWarOver()) or hour(clock) >= 19 or day(clock) != 3) and not lcDuelled(party) and not at(lc_kit, offstage) { Assert at(lc_kit, offstage). }
  Rule ned_away when ((lcDuelOff(party) or lcWarOver()) or hour(clock) >= 19 or day(clock) != 3) and not lcDuelled(party) and not at(lc_ned, offstage) { Assert at(lc_ned, offstage). }
  Rule cousins_mended when lcDuelled(party) and not lcFuneral(party) and publicHours() and day(clock) > 3 and not lcWarOver() and not at(lc_ned, ostler_shop) { Assert at(lc_ned, ostler_shop). Assert at(lc_kit, penhallow_shop). }
  Topic lc_ned_talk with lc_ned "Ask the big man what a cousin is for" when masked(actor) and at(lc_ned, umbrella_row) once {
    Says "'A cousin is for being hit.' He says it comfortably, the way another man would say a carter is for carting. 'The Concord says you can't hit a person, so you hit a cousin: and nobody minds, because the cousin's nobody's.' He tests the cap on his ferrule with a thumb, and finds it loose, and does not tighten it. 'I'd ask who capped it, only the Row doesn't say, and a cousin is not paid to ask.'".
  }
  Topic lc_kit_talk with lc_kit "Ask the lean man why he took the money" when masked(actor) and at(lc_kit, umbrella_row) once {
    Says "'I was a Second. Four years on the Hill.' The ferrule stops. 'A Second is hired to stand in for a man who has something to lose. I stood in for a Hill widow who wished to have her husband's brother killed, and I did not, and was struck off.' A short laugh. 'This is a better war. Nobody wants anybody dead. They only want it to be settled, and they cannot bear that it should be settled by them.'".
  }

  // ── Buying an umbrella ────────────────────────────────────────────────────────────────────────────────────────────
  // The Row's umbrellas, a real thing to carry, are sold masked; what a shop sells says how the war ended.
  Action lc_buy_ost(actor: group, site: place) "Buy an umbrella from Ostler's, four coin" {
    Speaker ostler.
    Requires able(actor) and company(actor) and at(actor, site) and at(ostler, site) and masked(actor) and at(lc_umb_o, offstage) and quantity(actor, gold) >= 4 and not lcFuneral(party) and not lcPatentP(party) and not lcMerged(party).
    Time 2 minutes.
    On success { Decrease quantity(actor, gold) by 4. Increase quantity(ostler, gold) by 4. Give lc_umb_o to actor. }
    Result "She takes down the one she has been saving, as every umbrella-maker has one, and opens it over your head in the shop to show you the ribs, and says nothing about Penhallow's at all, with a great force of will.".
  }
  Action lc_buy_pen(actor: group, site: place) "Buy an umbrella from Penhallow's, four coin" {
    Speaker penhallow.
    Requires able(actor) and company(actor) and at(actor, site) and at(penhallow, site) and masked(actor) and at(lc_umb_p, offstage) and quantity(actor, gold) >= 4 and not lcFuneral(party) and not lcPatentO(party) and not lcMerged(party).
    Time 2 minutes.
    On success { Decrease quantity(actor, gold) by 4. Increase quantity(penhallow, gold) by 4. Give lc_umb_p to actor. }
    Result "He measures your reach, and your shoulders, and your height from the heel, and writes the figures down, and then fetches the umbrella that was always going to be yours and enters it in the register as a sale.".
  }
  Action lc_buy_founders(actor: group, site: place) "Buy a Founders' umbrella, nine coin" {
    Speaker ostler.
    Requires able(actor) and company(actor) and at(actor, site) and (at(ostler, site) or at(penhallow, site)) and masked(actor) and lcMerged(party) and at(lc_umb_f, offstage) and quantity(actor, gold) >= 9.
    Time 2 minutes.
    On success { Decrease quantity(actor, gold) by 9. Increase quantity(ostler, gold) by 9. Give lc_umb_f to actor. }
    Result "Two people wrap it between them, one doing the oilcloth and the other the string, with a faint air of two people who have discovered that they have, after all, the same opinion of knots.".
  }

  // ══ The ways it may end ══════════════════════════════════════════════════════════════════════════════════════════════
  // One: the Trial, called honestly. Two: rigged. Three: the two old people asked, one at a time, to be the first to
  // put down an umbrella. Four: the two children, brought to say what they have not been asked. Five: the cousins.
  Rule lc_war_clock when day(clock) == 3 and hour(clock) >= 14 and hour(clock) < 15 and at(party, umbrella_row) and not lcWarOver() and not lcDuelOff(party) and not lcJudging(party) once says "The Row has set out its stools. There is a third, under the Board, and nobody is sitting on it: and nobody, in the way of the Row, has so much as glanced at it in twenty minutes." { }

  // The Judge's stool: only a bare judge will do, and so only a Bare will. The Row answers a bare judge. It has to.
  Action lc_take_stool(actor: group, site: place) "Take the Judge's stool under the Board, bare, and call the Trial of Umbrellas" {
    Requires able(actor) and company(actor) and at(actor, site) and not masked(actor) and lcTrialOn() and at(ostler, site) and at(penhallow, site) and not lcJudging(party) and not lcWarOver() and not lcDuelOff(party) and knows(actor, lc_usages).
    Time 1 minute.
    On success { Assert lcJudging(actor). }
    Result "You sit. Under the Board of the Usages, bare-faced, in the rain, on a stool nobody has sat on since the spring. All along the Row the shutters stop. {ostler} and {penhallow} turn to look at you at the same instant, with the expression of two people who have just realised that there is somebody to blame. It is the first time in your life that two masked citizens have looked at you together, and it is, you think, the first time in forty years that they have looked at the same thing.".
  }
  // Each maker must pitch the other's umbrella, so that none shall be accused of favouring his own. It is the Usage that
  // does it: they are made to hold each other's relic in the worst of the rain.
  Action lc_order_firsts(actor: group, site: place) "Order the Firsts down from their cases, to be pitched, each by the other" {
    Speaker ostler.
    Requires able(actor) and company(actor) and at(actor, site) and lcJudging(party) and at(ostler, site) and at(penhallow, site) and not lcTrialDraw(party).
    Resolve check(actor, persuasion, dc_fair).
    Time 6.
    On success { Assert lcTrialDraw(actor). Assert knows(actor, lc_same_hand). }
    Result "{ostler} takes THE FIRST out of its case with both hands, as you would take a baby out of a river, and {penhallow} does the same, and each carries the other's across the eleven paces of the Row without a word, and holds it over its owner's rival, open, in the rain, by the handle, for a long hour. Both umbrellas leak. They leak at the same rib: the third, where a hitch has been whipped three times, in a way that neither maker had thought to look at on the umbrella that was not his own. Nobody says anything. Penhallow's thumb finds the hitch, and stays on it.".
    Otherwise "{ostler} puts her palm flat on the glass of her case and says that it will come out over her body; and {penhallow} says that he will bring his own chair for it. They are not, you realise, disagreeing, as such. They are standing as close to one another as they have in years, holding the same line.".
  }
  Action lc_verdict(actor: group, site: place) "Give the verdict: both have lost, and by the Usage each shall shelter the other" {
    Speaker penhallow.
    Requires able(actor) and company(actor) and at(actor, site) and lcTrialDraw(party) and at(ostler, site) and at(penhallow, site) and not lcMerged(party) and not lcWarOver().
    Resolve check(actor, performance, dc_fair).
    Time 3.
    On success { Assert lcMerged(actor). Assert lcDuelOff(actor). Retract lcJudging(actor). Assert knows(actor, lc_margery). }
    Result "You rise, and the Row, which has been waiting forty years for someone to rise, goes quiet. 'The Trial is a draw,' you say. 'Neither umbrella has kept the rain off, and neither maker has kept faith. By the Third Usage, the loser shall be sheltered by the winner for as long as it takes to read the verdict aloud; and where both have lost, each shall shelter the other.' You read it again, slowly. It takes, by the Row's own clock, a very long time. Somewhere in the middle of it, {ostler} opens her umbrella over {penhallow}'s head, and he, after a moment, opens his over hers, and the two umbrellas touch at the edges. When you reach the end of the Usage they are still standing there, and neither of them has noticed that the rain stopped.".
    Otherwise "You rise, and your voice does what a bare voice does in the Drip, which is to arrive a half-second after it should have: the verdict is a thing they have each decided to have not heard. The Row goes back to its shutters. The cousins, at either end, have not moved, but the lean one has stopped turning his umbrella.".
  }
  // For a Judge who cannot talk anyone round: the exhibits are the Judge's by the Fifth Usage, and so is the Board, and a
  // Usage read aloud is a thing that a maker of the Row has never in his life walked out of.
  Action lc_seize_firsts(actor: group, site: place) "Take the Firsts down yourself, by the Judge's right over the exhibits" {
    Requires able(actor) and company(actor) and at(actor, site) and lcJudging(party) and at(ostler, site) and at(penhallow, site) and not lcTrialDraw(party).
    Time 4.
    On success { Assert lcTrialDraw(actor). Assert knows(actor, lc_same_hand). }
    Result "Nobody lays a finger on you. They stand and watch, white to the lips, while a Bare takes the two glass cases down from their hooks and carries THE FIRST of each across the eleven paces to the other's door, and puts it into the other's unwilling hands, and says: pitch it. They do, because it is the Usage, which is the one thing in the Row that nobody has ever argued with. Both leak at the same rib, at the third, where a hitch has been whipped three times, and neither maker, holding the other's, can say it is not his own.".
  }
  Action lc_read_board(actor: group, site: place) "Read the Usages aloud to the Row, all nine, slowly, and see who stays" {
    Requires able(actor) and company(actor) and at(actor, site) and lcTrialDraw(party) and knows(actor, lc_usages) and at(ostler, site) and at(penhallow, site) and not lcMerged(party) and not lcWarOver() and day(clock) == 3 and hour(clock) < 16.
    Time 10.
    On success { Assert lcMerged(actor). Assert lcDuelOff(actor). Assert knows(actor, lc_margery). }
    Result "You read the Board, from the first Usage to the ninth, in the rain, in the plain voice of somebody who has been told to do it by a rule, which is to say, with no expression at all. Nobody leaves. The Row does not walk out of a Usage. At the Third, somebody puts up an umbrella; at the Fifth, somebody puts one over somebody else; and by the Ninth the two oldest people in the lane are standing under the same canopy, looking straight ahead, in an ice-cold fury that has begun, very slightly, to thaw, as a pond does under a hand.".
  }
  Rule lc_merge_result when lcMerged(party) and not lcStood(party) says "By the Ninth Bell, they say, a door had been cut in the wall between the two shops; by the morning after, it had a lintel." { Assert lcStood(party). Increase goodwill(face_cockle) by 1. }

  // Rigged: the Trial can be won. It is, after all, only an umbrella.
  Action lc_rig_for_ostler(actor: group, site: place) "Slip a rib in Penhallow's First before it is pitched" {
    Requires able(actor) and company(actor) and at(actor, site) and lcJudging(party) and not lcTrialDraw(party) and not lcRigged(party) and not lcWarOver().
    Resolve check(actor, stealth, dc_hard).
    Time 2.
    On success { Assert lcRigged(actor). Assert lcPatentO(actor). Assert lcDuelOff(actor). }
    On failure { Assert lcRiot(actor). Increase heat(actor) by 1. }
    Result "A rib is a small thing to put out of true. Under cover of the Judge's stool and the Judge's right to handle the exhibits you give it a quarter-turn, and a hand's breadth of oilcloth goes slack in the dark of the case. At the Trial Penhallow's First opens over a puddle in the first minute, as if it had never been told how, and Ostler's holds. The Row cheers, a little guiltily. {penhallow} looks at his own umbrella for a long time, and then at you.".
    Otherwise "Under the Judge's stool, with a rib in your hand, you find that {lc_tam} has been watching your hands since you sat. 'That is mine,' he says, rather quietly; and then, a good deal louder, and to the whole of the Row, 'that is mine.' The Row turns round.".
  }
  Action lc_rig_for_penhallow(actor: group, site: place) "Slip a rib in Ostler's First before it is pitched" {
    Requires able(actor) and company(actor) and at(actor, site) and lcJudging(party) and not lcTrialDraw(party) and not lcRigged(party) and not lcWarOver().
    Resolve check(actor, stealth, dc_hard).
    Time 2.
    On success { Assert lcRigged(actor). Assert lcPatentP(actor). Assert lcDuelOff(actor). }
    On failure { Assert lcRiot(actor). Increase heat(actor) by 1. }
    Result "A rib is a small thing to put out of true. Under cover of the Judge's stool and the Judge's right to handle the exhibits you give it a quarter-turn, and a hand's breadth of oilcloth goes slack in the dark of the case. At the Trial Ostler's First opens over a puddle in the first minute, and Penhallow's holds. The Row cheers, a little guiltily. {ostler} looks at her own umbrella, furled, and then at you.".
    Otherwise "Under the Judge's stool, with a rib in your hand, you find that {lc_wyn} has been watching your hands since you sat. 'That is ours,' she says, quietly; and then, a good deal louder, 'that is ours.' The Row turns round.".
  }
  Rule lc_riot_starts when lcRiot(party) and not lcDuelling(party) and not lcDuelled(party) and not lcFuneral(party) says "The Row's patience, which has been forty years in the making, takes about four seconds to be spent. Somebody throws an umbrella, and somebody else, with a cousin's sense of occasion, throws it back; and then the two men in the oilskin hoods are in the chalk, and the ferrules are not capped." { Assert lcDuelling(party). }

  // Asked, not told: each is given the right to be first to put an umbrella down.
  Action lc_ask_ostler_first(actor: group, site: place) "Ask Maud Orrell to be the first to send her cousin home" {
    Speaker ostler.
    Requires able(actor) and company(actor) and at(actor, site) and at(ostler, site) and masked(actor) and knows(actor, lc_war_known) and not lcOstlerYields(party) and not lcWarOver() and not lcDuelled(party).
    Resolve check(actor, persuasion, dc_hard).
    Time 3.
    On success { Assert lcOstlerYields(actor). }
    Result "'First.' She turns the word over like a coin she has been handed in the wrong currency. 'It is the other way round that I have always had it: that I should be last, and watch him go first.' She wipes her hands on her apron, slowly, finger by finger. 'Send word to Ned. Tell him the cap stays on, and he may go home to his wife.' She does not look at you. 'And tell nobody. If it comes out that {ostler} asked, I will have to have been right about something else.'".
    Otherwise "{ostler} hears you out, and she is, you can see, a woman who would very much like to be talked out of it; and cannot, in front of the board, be seen to be. 'No,' she says. 'Not first. Ask him.'".
  }
  Action lc_ask_pen_first(actor: group, site: place) "Ask Silas Haskew to be the first to send his cousin home" {
    Speaker penhallow.
    Requires able(actor) and company(actor) and at(actor, site) and at(penhallow, site) and masked(actor) and knows(actor, lc_war_known) and not lcPenYields(party) and not lcWarOver() and not lcDuelled(party).
    Resolve check(actor, persuasion, dc_hard).
    Time 3.
    On success { Assert lcPenYields(actor). }
    Result "'First.' {penhallow} enters the word in the column on his counter, in pencil, and looks at it. 'I should wish it noted that it is not a concession. It is an observation of fact: that I am the more reasonable.' A length of cane is straightened that was already straight. 'Tell Kit he is dismissed with full fees. And you will say nothing of this to the girl across the way.' He pauses. 'Or the boy, to anyone.'".
    Otherwise "{penhallow} says that he will consider it, which is what a man says who has considered it for forty years. 'The register is closed on the point,' he says. 'You may ask her.'".
  }
  Rule lc_quiet_settles when lcOstlerYields(party) and lcPenYields(party) and not lcQuiet(party) and not lcChildrenMet(party) says "Neither cousin has done anything. At ten to five, in front of two shut doors, the big one lifts his hood and looks at the lean one, and the lean one shrugs. It is the first thing the two of them have ever agreed on. They go to the same public-house, and no one remarks on it, because no one has been told." { Assert lcQuiet(party). Assert lcDuelOff(party). }
  Rule lc_one_yields when (lcOstlerYields(party) or lcPenYields(party)) and not (lcOstlerYields(party) and lcPenYields(party)) and day(clock) == 3 and hour(clock) >= 17 and not lcDuelled(party) and not lcWarOver() and not lcDuelOff(party) { Assert lcDuelled(party). }

  // The children: nobody has said whose child the other is. The company is Bare, and a Bare may say it.
  Action lc_unmask_children(actor: group, site: place) "Ask the two Cockles to take their masks off, together, at the Ninth Bell" {
    Speaker lc_wyn.
    Requires able(actor) and company(actor) and at(actor, site) and at(lc_wyn, site) and at(lc_tam, site) and knows(actor, lc_children_known) and not lcChildrenMet(party) and hour(clock) >= 19 and hour(clock) < 20.
    Resolve check(actor, persuasion, dc_fair).
    Time 2.
    On success { Assert lcChildrenMet(actor). }
    Result "They look at one another, the way two people look when one has said the thing aloud, and then at you, and then, each, at the mask on the other's face. The Ninth Bell rings over the Drip. They take them off together, as a Pair would at the Swap: and under the hood is {lc_wyn}, and under the other, a yard away, is {lc_tam}. They have known each other's faces since they could walk. They have never looked at them. 'Oh,' says the boy. 'Oh,' says the girl. 'Oh, no,' say both, and, in exactly the same moment, 'oh, yes.'".
    Otherwise "'It's not done,' says the girl, very fast, 'we don't say.' The boy says nothing, and holds the cane. It is the sort of refusal that is made by people who would like to be argued with, and you have not, tonight, the argument.".
  }
  Rule lc_children_plan when lcChildrenMet(party) and day(clock) <= 3 and not lcChildrenTold(party) says "{lc_wyn} and {lc_tam} go off down the lane together, a decent yard apart, in the dark, bareheaded, talking low and fast. At the corner the girl takes the boy's cane away from him, as if it were evidence." { Assert lcChildrenTold(party). }

  // A parent's blessing is a thing asked. When both are asked, and both say yes, the war is a wedding.
  Action lc_bless_ostler(actor: group, site: place) "Ask Maud Orrell what she would give for her daughter to be in the Row's care when she is old" {
    Speaker ostler.
    Requires able(actor) and company(actor) and at(actor, site) and at(ostler, site) and lcChildrenMet(party) and not lcOstlerYields(party) and not lcFuneral(party) and not lcWarOver() and masked(actor).
    Resolve check(actor, insight, dc_fair).
    Time 3.
    On success { Assert lcOstlerYields(actor). }
    Result "You do not say the boy's name. You ask her what the Ostlers will be, in thirty years, if there is no Ostler to leave it to; and she says nothing, and puts the oil down; and then you ask whether it was the Penhallows she was afraid of, or the quiet; and she says, after a very long time, 'I should like her to have somebody who will argue.'".
    Otherwise "She hears you out, and gives you, quite calmly, the umbrella she has been oiling, to hold, for no reason. 'You are asking me something that I have not decided how to be asked,' she says. 'I will come to you.'".
  }
  Action lc_bless_penhallow(actor: group, site: place) "Ask Silas Haskew what his register will say of the boy, in thirty years, if it is not a Penhallow's" {
    Speaker penhallow.
    Requires able(actor) and company(actor) and at(actor, site) and at(penhallow, site) and lcChildrenMet(party) and not lcPenYields(party) and not lcFuneral(party) and not lcWarOver() and masked(actor).
    Resolve check(actor, insight, dc_fair).
    Time 3.
    On success { Assert lcPenYields(actor). }
    Result "You do not say the girl's name. You ask him what he would want entered, in the column marked Kindnesses, if somebody were to keep it for him; and he stops measuring. 'There is no such column.' 'No,' you say. He starts one, on the back of the counter, in pencil, very small. The first entry is the date, and then a line you cannot read, and then, below, 'for the boy'.".
    Otherwise "He hears you out with his rule in his hand. 'You are asking me to enter a thing I have not seen the figures for,' says {penhallow}, and the rule taps once. 'Bring me the figures.'".
  }
  Rule lc_wed_settles when lcChildrenMet(party) and lcOstlerYields(party) and lcPenYields(party) and not lcWedded(party) and not lcMerged(party) and not lcWarOver() says "On the Row the shutters of both shops are up at once, which they have not been in the history of the lane; and, in the eleven paces between, two umbrellas are being held over two young heads by two old hands, at arm's length, as one holds a thing one has been told is not dangerous." { Assert lcWedded(party). Assert lcDuelOff(party). Give lc_umb_w to party. }

  // ── The duel, if it comes ─────────────────────────────────────────────────────────────────────────────────────────
  // At five on the Deepening the cousins take the Row, unless the war has been ended or the company has not come. Where
  // the company is on the Row, it sees it: and may stop it, or bind what it cannot stop. A cousin dies only in front of
  // someone who could have helped.
  Relation lcDuelling(group).
  Rule lc_duel_screen when day(clock) == 3 and hour(clock) >= 17 and at(party, umbrella_row) and not lcDuelOff(party) and not lcWarOver() and not lcDuelled(party) and not lcDuelling(party) and not lcFuneral(party) says "At five the two men in the oilskins walk into the chalk, and the Row, which has not seen the Concord broken in front of it in forty years, goes very quiet. They do not bow. {lc_kit} steps in and {lc_ned} turns his ferrule, and in the third pass the ferrule goes into {lc_ned}'s side to the length of a finger. He sits down on the cobbles, with great surprise, and says, 'Oh. It was not capped.' Nobody had thought it would be." { Assert lcDuelling(party). Retract lcJudging(party). }
  Rule lc_duel_unseen when day(clock) == 3 and hour(clock) >= 17 and not at(party, umbrella_row) and not lcDuelOff(party) and not lcWarOver() and not lcDuelled(party) and not lcDuelling(party) and not lcFuneral(party) { Assert lcDuelled(party). }
  Rule lc_duel_goes_wrong when lcDuelling(party) and (hour(clock) >= 18 or day(clock) > 3) and not lcBound(party) says "Nobody knows what to do with a man bleeding on the cobbles in the Drip, on a street that has not had a feud since the Concord: they stand at their doors, in their masks, and wait for it to be somebody else's affair. By the time the Row's women come out with their aprons, {lc_ned} has stopped saying anything. The Row will not forget that it watched." { Retract lcDuelling(party). Assert lcFuneral(party). Assert lcDuelled(party). Assert at(lc_ned, offstage). }
  Action lc_halt_duel(actor: group, site: place) "Step into the chalk between the cousins" {
    Requires able(actor) and company(actor) and at(actor, site) and lcDuelling(party) and not lcBound(party).
    Resolve check(actor, brawn, dc_hard).
    Time 1.
    On success { Retract lcDuelling(actor). Assert lcDuelOff(actor). Assert lcQuiet(actor). Assert lcBound(actor). }
    Result "It is a stupid thing to do and you do it very hard. You get between the ferrules with your shoulders square, and {lc_kit}'s goes into your coat instead of the other man's and stops, and the Row, which has been waiting forty years for somebody to be rude to a cousin, exhales. {lc_ned} is helped up. {lc_kit}, who was a Second, looks at the hole in your coat with the professional regret of a man who would have liked to have been paid for it.".
    Otherwise "You are a stranger and the Row has not asked you; the lean one's elbow arrives where your ribs were, and the big one, who is sitting down and has been hit, is very kind about it.".
  }
  Action lc_judge_halts(actor: group, site: place) "As Judge, call off the cousins" {
    Requires able(actor) and company(actor) and at(actor, site) and lcDuelling(party) and lcJudging(party).
    Time 1.
    On success { Retract lcDuelling(actor). Assert lcDuelOff(actor). Assert lcQuiet(actor). }
    Result "'The Trial is not finished,' you say, in the voice of a woman who knows the Usage and has no other authority whatever; and by the Fifth Usage, painted on the Board in fresh letters, a hired cousin shall not strike while the Judge is seated. Both of them look at the Board, and at you, and at the stool. The big one, with a grunt, lowers his ferrule onto the cobbles, and the lean one, after some thought, puts the cap back on his own.".
  }
  Action lc_bind_wounds(actor: group, site: place) "Bind Ned Orrell's side before he bleeds out on the Row" {
    Requires able(actor) and company(actor) and at(actor, site) and lcDuelling(party) and not lcBound(party).
    Resolve check(actor, mending, dc_fair).
    Time 2.
    On success { Assert lcBound(actor). Retract lcDuelling(actor). Assert lcDuelled(actor). Increase goodwill(face_cockle) by 1. }
    Result "You kneel on the wet cobbles and put your two hands over the place, and press, and call for cloth; and for the first time in forty years two umbrella-makers are fetching the same thing for the same purpose, and getting in each other's way. {ostler} tears her apron into strips with her teeth. When the wound is bound she kneels by her cousin, with the cloth in her hand, and looks up at the lean one, who has stopped, and is standing quite still, with a cap in his hand that he has not put on.".
    Otherwise "Your hands are not quick enough for the place they are on; the cloth comes away dark and you have not stopped it. 'Again,' somebody says, quite near. 'Again, press harder.'".
  }
  Rule lc_duel_after when lcBound(party) and lcDuelled(party) and not lcStood(party) and not lcWarOver() says "It is, you reflect, an unusual way for a feud to end: with the bleeding stopped and nothing settled, and two people on a street who have just seen what it is they have been quarrelling with. For the first time in forty years neither of them will say whose fault it was." { Assert lcTruce(party). }

  // ══ BARNABY SWEET'S WAGER ════════════════════════════════════════════════════════════════════════════════════════════
  // Barnaby Sweet, a tallyman, a Magpie, thirty-five, cheerful, who owes the Coffee-house twelve coin, has staked the face
  // he earns his bread in against Old Gudge's champion eel, at the Deepening's race. He will lose. Gudge has not lost a
  // race in twenty years: he has thirty-one faces on his shed wall, each with the weight of its eel written under it.
  // Lost a face, a man is a Bare, and goes to the Hospice for nine days and out of the Gate; and the Concord, which is not
  // cruel, is exact. The company may save him before, or after; and what he does after is the thread's whole heart.
  Discovery lc_sweet_wager "Barnaby Sweet, a tallyman in the Magpie, has staked his mask against Old Gudge's champion eel in the Deepening's eel-race at the eel-pond; a man who loses his face is a Bare and is not answered, and a tallyman who is not answered cannot tally.".
  Discovery lc_pond_usage "The Pond's Ninth Usage, nailed on Old Gudge's shed: any Bare present may object to a stake that would make a citizen Bare, for a Bare alone can lose nothing by it.".
  Discovery lc_gudge_wall "Old Gudge has thirty-one faces on the wall of his shed, each with the weight of its eel written under it; he says he has never had one back, and has never been asked.".
  Discovery lc_survey_tip "Sweet says the Exchange's surveyors for the Heronry lodge at the Tally Coffee-house on the seventh night, and that their chain-man owes the tallymen eleven coin.".
  Kind lc_magpie_kind "Sweet's Magpie" is gear worth 0 weighing 1 described "A tallyman's domino of black and white lacquer, worn at the cheek where a thousand sums have been laid against it; the tally-marks are scratched very small inside the brow, where nobody sees them, so that the wearer can find them with a thumb.".
  Kind lc_newmagpie_kind "a new Magpie" is gear worth 8 weighing 1 described "A tallyman's domino, black and white, from the Annex's own stock, signed for three times. It has not been worn. It does not sit like a face yet, and the lacquer smells of a shop.".
  Item lc_magpie_old "Sweet's Magpie" is lc_magpie_kind at offstage owned by lc_gudge.
  Item lc_magpie_new "a new Magpie" is lc_newmagpie_kind at offstage.

  Person sweet "Barnaby Sweet" at coffee_room {
    Role "a tallyman of the Exchange". Ancestry human. Peaceable. Pronouns he. Manner jovial.
    Known as "a lanky tallyman in the Magpie with one hand always at his cheek" when publicHours() and not knows(party, lc_sweet_face) and not lcSweetBareNow().
    Greets "A lanky man in a black and white domino slides along a bench to make room, and counts you with his eyes, as a tallyman will: head, hands, boots, purse. 'Tallies,' he says. 'Done and undone. If you want to know what a thing costs, I can tell you; if you want to know what it is worth, you will have to ask a Heron.' He grins under the lacquer. 'I have a little something on at the Deepening. You might look in.'".
    Greets again "'Tallies done,' says the tallyman, 'and undone,' and winks, which in a Magpie is a movement of the whole face.".
  }
  Initially Assert unmaskTeaches(sweet, lc_sweet_face).
  Discovery lc_sweet_face "The tallyman in the Magpie is Barnaby Sweet, thirty-five, who owes the Tally Coffee-house twelve coin and has never in his life been unable to talk to a stranger.".
  Rule sweet_coffee when hour(clock) >= 9 and hour(clock) < 16 and not lcSweetBareNow() and not lcSweetSlate(party) and not at(sweet, coffee_room) { Assert at(sweet, coffee_room). }
  Rule sweet_pond when hour(clock) >= 16 and hour(clock) < 20 and not lcSweetBareNow() and not at(sweet, eel_pond) { Assert at(sweet, eel_pond). }
  Rule sweet_night when privateHours() and not lcSweetBareNow() and not lcSweetSlate(party) and not at(sweet, offstage) { Assert at(sweet, offstage). }
  Rule sweet_lost_pond when lcSweetBareNow() and not at(sweet, eel_pond) { Assert at(sweet, eel_pond). }
  Rule sweet_slate_row when lcSweetSlate(party) and publicHours() and not at(sweet, row_street) { Assert at(sweet, row_street). }
  Rule sweet_slate_night when lcSweetSlate(party) and privateHours() and not at(sweet, offstage) { Assert at(sweet, offstage). }
  Observe lc_sweet_slate_scene at row_street when lcSweetSlate(party) and publicHours() "Outside the Tally Coffee-house, on a nail that was waiting for a lamp, a slate has been hung in a wooden frame, ruled in chalk. TALLIES, it says, in an excellent hand. Under it, in columns, are the sums of the morning: the price of tallow, the weight of a bale, what a ferry owes a quay; and in each a figure and a coin dropped in the pot below. A bare man with ink to the elbow stands beside it with the air of a man who has not been spoken to in a week and has stopped minding. The coffee-house has noticed that the slate is right.".
  Topic lc_sweet_cold with sweet "Say good morning to the tallyman" when not masked(actor) and publicHours() and not lcSweetLost(party) once {
    Says "'We are not acquainted,' says the tallyman, to the coffee-house, brightly, as one speaks to a room which has been told to be nobody's witness. A pause. 'I should be.' This is, you realise, a joke, of the sort that can only be made by someone who has no idea how soon it will be true.".
  }
  Topic lc_sweet_wager_t with sweet "Ask the tallyman what he has on at the Deepening" when masked(actor) and not lcSweetLost(party) and not lcSweetBack(party) once {
    Says "'The eel.' He taps the lacquer by his eye. 'Gudge's champion, against my silver. A fair stake: his best eel, my best face. I have raised her from an elver, on the Coffee-house's leavings, and she is a thing of beauty and speed.' He laughs, a little too long. 'I owe the house twelve. If she goes, I am clear, and the Magpie's still on my head. If she does not, I will tell you what I shall do, which is nothing. I shall be a man with a very short future.'".
    On discuss { Assert knows(actor, lc_sweet_wager). }
  }
  Topic lc_sweet_bare with sweet "Sit down beside the bare man by the shed" when not masked(actor) and lcSweetLost(party) and not lcSweetBack(party) and not lcSweetNew(party) and not lcSweetSlate(party) once {
    Says "He does not look round. It is a long minute before he says, to the pond, in a voice with all the jauntiness gone out of it and the pleasant tenor left: 'You can talk to me. Isn't that odd? Nobody else in the Drip can, but you can, and I find I would like to be talked to by anybody.' He turns the lobster-pot over in his hands. 'It has been four hours. I did not know a face was so loud. You can hear it going.'".
    On discuss { Assert knows(actor, lc_sweet_wager). Assert lcSweetAsked(actor). }
  }
  Topic lc_sweet_why with sweet "Ask him why he staked it" when knows(actor, lc_sweet_wager) and (lcSweetLost(party) or privateHours() or masked(actor)) once {
    Says "'Because I was clever.' He says it flatly. 'I thought: a Magpie is what the Exchange sees. Nobody ever sees the man. So what does it matter if the mask is lost, if the man is the same? I was going to win, and be clear of debt; and if I lost, I would find I was the same man, and the Exchange would find it too.' He looks at his own hands. 'It does not. It is not that they do not like me. It is that I am not there.'".
    On discuss { Assert knows(actor, lc_sweet_wager). }
  }
  Topic lc_sweet_tip with sweet "Ask Sweet what a friend of the Exchange might hear" when (lcSweetBack(party) or lcSweetNew(party) or lcSweetSlate(party)) once {
    Says "He leans in, and so, with great effort, does the Exchange's gossip. 'The surveyors for the Heronry,' he says. 'The ones with the chains. They lodge at the Coffee-house on the seventh night, in the long room. Their chain-man owes the tallymen eleven coin; I hold the paper. If you wanted a word with a man about a reed-garden, I know where he drinks.' He grins. 'It is the only thing I have that is worth anything to anyone, now, and I give it to you with my hand on my heart. Both hands, if I could.'".
    On discuss { Assert knows(actor, lc_survey_tip). }
  }

  // ── Old Gudge ─────────────────────────────────────────────────────────────────────────────────────────────────────
  Person lc_gudge "Old Gudge" at eel_pond {
    Role "keeper of the Drip's eel-pond". Ancestry human. Peaceable. Pronouns he. Manner acerbic.
    Known as "an old man in a patched Cockle smelling of eel" when publicHours() and not knows(party, lc_gudge_face).
    Greets "The old man on the tub does not look up from the water. 'Eels,' he says. 'Raced, bet on and eaten. In that order, and not, if I can help it, by the same people.' He flicks the net a little, like a man answering a question that has not been put. 'Don't lean on the rail. It has opinions about weight.'".
    Greets again "'Eels,' says the old man, to the water.".
  }
  Initially Assert unmaskTeaches(lc_gudge, lc_gudge_face).
  Discovery lc_gudge_face "The old man on the tub is Hosea Gudge, seventy, who has kept the eel-pond forty years and has not been asked his Christian name by anyone who was not trying to bet him.".
  Topic lc_gudge_cold with lc_gudge "Say good evening to the old man on the tub" when not masked(actor) and publicHours() and not lcGudgeAngry(party) once {
    Says "'There is a rule at this pond,' says the old man, to the water, at the end of a long silence. 'The Ninth. Nailed on the shed. It was written by a man who had been Bare, I have always supposed, and was not sorry to have been.' He moves the net. 'I am only mentioning it. A Bare reads the shed. Nobody has asked me what the Ninth says in thirty years.'".
    On discuss { Assert knows(actor, lc_pond_usage). }
  }
  Topic lc_gudge_race with lc_gudge "Ask Old Gudge about the Deepening's race" when masked(actor) and not lcGudgeAngry(party) once {
    Says "'Lane one, lane four,' says the old man, 'my champion against his silver, with a face to the winner.' He sounds as a man sounds who has said it often. 'I've won thirty-one. They hang on the shed wall, the faces; I mark each under with the weight of its eel.' He sniffs. 'People say I am cruel. I am not cruel. The pond is exact. A man puts a face on a table, that is what a stake is, and I cannot take less than I'm offered.'".
    On discuss { Assert knows(actor, lc_gudge_wall). }
  }
  Topic lc_gudge_night with lc_gudge "Knock at the shed and ask Old Gudge to show you the wall" when not masked(actor) and privateHours() and not lcGudgeAngry(party) once {
    Says "A lantern, and a man in a coat made of sacks with his face bare, which is smaller than you expected and has no teeth to speak of. He lets you in. In the shed, between the hundred little doors, a wall is hung with masks: thirty-one of them, a row of ten and a row of ten and another, every one with a tag in a spidery hand. Under each, the name of an eel. 'The pond is exact,' he says, 'and it is also very quiet at night.' He touches a Cockle with a patch on the cheek. 'That one,' he says, 'wrote to me in the spring. Not to ask for it back. To say that he had been asked if he knew me, and had said no.'".
    On discuss { Assert knows(actor, lc_gudge_wall). Assert lcGudgeHeard(actor). }
  }

  // Before the race: the stake. Four ways to stop it (the Bare's Objection; a word to Sweet; a rigged lane; a rigged eel).
  Query lcRacePending() means (day(clock) == 3 and hour(clock) < 19 and not lcSweetLost(party) and not lcSweetBack(party) and not lcRaceRun(party)) or (lcRematch(party) and day(clock) == 4 and hour(clock) < 19 and not lcRematchRun(party)).
  Relation lcRematchRun(group). Relation lcGudgeAngry(group). Relation lcMagpieGood(group). Relation lcGudgeBeaten(group). Relation lcSweetSaved(group).
  Action lc_object_stake(actor: group, site: place) "Object to the stake, as a Bare, under the Pond's Ninth Usage" {
    Speaker lc_gudge.
    Requires able(actor) and company(actor) and at(actor, site) and at(lc_gudge, site) and at(sweet, site) and not masked(actor) and knows(actor, lc_pond_usage) and lcRacePending() and not lcRematch(party).
    Resolve check(actor, lore, dc_easy).
    Time 2.
    On success { Assert lcSweetBack(actor). Assert lcSweetSaved(actor). Assert lcRaceRun(actor). }
    Result "'The Ninth Usage,' you say, to the shed, to the net, to the whole attentive pond, 'any Bare present may object to a stake that would make a citizen Bare.' The old man's net comes down on the rail. Under the Cockle his face does something complicated. 'It was put in,' he says, at last, 'by a man who knew what it was to be one. I did not think it would be a Bare that read it.' The race goes forward with the stake struck out, and Gudge's champion wins as it always does, and nobody is a Bare who was not before. Sweet does not understand what has happened to him, and is very much obliged.".
    Otherwise "'That is the Row's Usage,' says {lc_gudge}, kindly, 'and nobody's Ninth. Read the shed.' You have the wrong board, or the right board read in the wrong order, and the whole pond has heard you do it.".
  }
  Action lc_warn_sweet(actor: group, site: place) "Ask Barnaby Sweet to take his face off the table" {
    Speaker sweet.
    Requires able(actor) and company(actor) and at(actor, site) and at(sweet, site) and masked(actor) and knows(actor, lc_sweet_wager) and lcRacePending() and not lcRematch(party).
    Resolve check(actor, persuasion, dc_fair).
    Time 3.
    On success { Assert lcSweetBack(actor). Assert lcSweetSaved(actor). Assert lcRaceRun(actor). }
    Result "'It is only a face,' says {sweet}; and then, as if he had heard it, and your silence after, 'it is the only one I have.' He goes to Gudge's tub himself, and the old man, who has not had a stake taken back in forty years, says something about the pond's exactness, and Sweet says something about his debts, and in the end the stake is struck out, in chalk, by a man who did not expect to, and the Magpie goes home on its own head.".
    Otherwise "'You are a good sort,' says {sweet}, 'and I am going to win, which is why you are not to worry.' He shakes your hand, with both of his, and goes down the pond to the lane-boards, and does not look back.".
  }
  Action lc_jam_grating(actor: group, site: place) "Jam the grating of lane one, where Gudge's champion will finish" {
    Requires able(actor) and company(actor) and at(actor, eel_pond) and lcRacePending() and not lcRaceFixed(party) and not lcGudgeAngry(party).
    Resolve check(actor, trapwork, dc_fair).
    Time 3.
    On success { Assert lcRaceFixed(actor). }
    Result "An eel will go where it is let and not otherwise, and a grating is only a kind of opinion. Under the planks of the first flume you move a bar a finger's breadth and fit a splinter of lath where a lath should not be; and the water in that lane, in a minute, will be a little slower than the water in the others, in a way that nobody will be able to prove.".
    On failure { Assert lcGudgeAngry(actor). }
    Otherwise "The bar moves, and the whole grating comes up with it, and {lc_gudge}, on his tub, who has not looked round all day, says without turning his head: 'Put it back.' You put it back. 'I do not want to see you at this pond again,' says the old man, with great calm, to the water.".
  }
  Action lc_swap_eels(actor: group, site: place) "Quietly put Gudge's champion in a slower lane, and a river eel in its place" {
    Requires able(actor) and company(actor) and at(actor, eel_pond) and lcRacePending() and not lcRaceFixed(party) and not lcGudgeAngry(party).
    Resolve check(actor, stealth, dc_hard).
    Time 4.
    On success { Assert lcRaceFixed(actor). }
    Result "There are a hundred little doors in the shed and each has a thinking eel behind it, and the old man knows each by its sulk. In the half minute that he takes his net to the pond's far end to shift a child off the rail, you open one door, and shut another, and carry, in a bucket, a long brown ordinary river eel to lane one. It looks a great deal like a champion. It is, you can tell by its expression, nothing of the kind.".
    On failure { Assert lcGudgeAngry(actor). }
    Otherwise "The old man's net comes down over the bucket, quite gently, as one covers a bird. 'My champion,' says {lc_gudge}, 'has a mark under the chin that this one has not got. Put it back, and be so good as to go.'".
  }
  // The race itself, once at the Deepening and once more if a rematch is called.
  Rule lc_race_sweet_told at eel_pond when day(clock) == 3 and hour(clock) >= 19 and not lcRaceRun(party) and lcRaceFixed(party) and not lcSweetBack(party) once says "Lane one and lane four go off at the drop of a cloth, and for the length of the first board it is Gudge's champion, as it has been for twenty years, in the long brown line like a thrown rope; and then, a yard from the grating, something goes wrong with the water, and the champion hesitates, and the silver goes through the gap like a bead on a string. A great noise rises from the Drip. {lc_gudge} sits down on his tub, all at once, like a man shot, with the net across his knees. 'Well,' he says. 'Thirty-one. And one.' {sweet} has both hands to his own face, and is laughing, and weeping, and checking it is still there." { }
  Rule lc_race_sweet when day(clock) == 3 and hour(clock) >= 19 and not lcRaceRun(party) and lcRaceFixed(party) and not lcSweetBack(party) { Assert lcRaceRun(party). Assert lcSweetBack(party). Assert lcGudgeBeaten(party). }
  Rule lc_race_gudge_told at eel_pond when day(clock) == 3 and hour(clock) >= 19 and not lcRaceRun(party) and not lcRaceFixed(party) and not lcSweetBack(party) once says "Lane one and lane four go off at the drop of a cloth, and it is, as it has been for twenty years, no race. The champion goes down its flume like a thrown rope; the silver does well, and very honourably, and is half a body behind at the grating. A great noise rises from the Drip, a good deal of it of the kind you make over somebody else's misfortune. {sweet} stands with his hand on his cheek for a long, long moment, and then he does the thing the pond is exact about: he takes off his Magpie, and holds it out." { }
  Rule lc_race_gudge when day(clock) == 3 and hour(clock) >= 19 and not lcRaceRun(party) and not lcRaceFixed(party) and not lcSweetBack(party) { Assert lcRaceRun(party). Assert lcSweetLost(party). Assert lcGudgeKept(party). Assert at(lc_magpie_old, eel_pond). }
  Rule lc_race_saved when day(clock) == 3 and hour(clock) >= 19 and not lcRaceRun(party) and lcSweetBack(party) { Assert lcRaceRun(party). }

  // ── After the race: a face lost, and four ways home ───────────────────────────────────────────────────────────────
  // A rematch (stake matched, at the next ninth-hour race); a price (the Pond is exact: a face is redeemable at the
  // weight of its eel in coin); an evening with Gudge; a new face (the Annex needs three signatures); the Warrant; or
  // work done bare, on a slate, at which nobody can say a bare man has not been answered.
  Measure lcRematchDay(group).
  Action lc_ask_rematch(actor: group, site: place) "Stake twelve coin on Sweet's silver, for his face, at tomorrow's race" {
    Speaker lc_gudge.
    Requires able(actor) and company(actor) and at(actor, site) and at(lc_gudge, site) and lcSweetLost(party) and not lcSweetBack(party) and not lcRematch(party) and not lcGudgeAngry(party) and quantity(actor, gold) >= 12 and day(clock) < 9.
    Time 2.
    On success { Decrease quantity(actor, gold) by 12. Increase quantity(lc_gudge, gold) by 12. Assert lcRematch(actor). Set lcRematchDay(actor) to day(clock) + 1. }
    Result "The old man looks at the twelve coin on the rail, and then at you, bare, with a long look from under the Cockle. 'A stake is a stake. Against the face, the weight of an eel in coin, matched, at the ninth hour tomorrow.' He sweeps it into the net, where it does not belong. 'The pond is exact, and it is generous, once a day.' Behind him, under the eaves, a bare man on a lobster-pot lifts his head.".
  }
  Rule lc_rematch_sweet_told at eel_pond when lcRematch(party) and day(clock) == lcRematchDay(party) and hour(clock) >= 19 and not lcRematchRun(party) and lcRaceFixed(party) once says "The silver goes off like a thrown thread. The champion, that has been first in this pond since before the Rains, is beaten by a head; and {lc_gudge}, on his tub, who has paid out to a hundred men over the years, counts out twenty-four coin into your hand and looks for the first time in your life like somebody who has been outdone by someone he approves of. 'Thirty-one,' he says. 'And one. And one.' He holds the Magpie out to Sweet on the flat of the net." { }
  Rule lc_rematch_sweet when lcRematch(party) and day(clock) == lcRematchDay(party) and hour(clock) >= 19 and not lcRematchRun(party) and lcRaceFixed(party) { Assert lcRematchRun(party). Assert lcSweetBack(party). Assert lcGudgeBeaten(party). Increase quantity(party, gold) by 24. Retract at(lc_magpie_old, eel_pond). Assert at(lc_magpie_old, offstage). }
  Rule lc_rematch_gudge_told at eel_pond when lcRematch(party) and day(clock) == lcRematchDay(party) and hour(clock) >= 19 and not lcRematchRun(party) and not lcRaceFixed(party) once says "The silver does well, and honourably, and is half a body behind at the grating, as it was the night before. {lc_gudge} sweeps your twelve coin off the rail with the edge of his net. 'The pond is exact,' he says, not unkindly. 'It is not, I am sorry to say, a respecter of effort.' Under the eaves a bare man on a lobster-pot puts his head back down on his knees." { }
  Rule lc_rematch_gudge when lcRematch(party) and day(clock) == lcRematchDay(party) and hour(clock) >= 19 and not lcRematchRun(party) and not lcRaceFixed(party) { Assert lcRematchRun(party). }
  Action lc_redeem_by_weight(actor: group, site: place) "Pay Old Gudge the weight of his champion in coin to redeem Sweet's face" {
    Speaker lc_gudge.
    Requires able(actor) and company(actor) and at(actor, site) and at(lc_gudge, site) and lcSweetLost(party) and not lcSweetBack(party) and not lcGudgeAngry(party) and at(lc_magpie_old, site) and quantity(actor, gold) >= 16.
    Time 3.
    On success { Decrease quantity(actor, gold) by 16. Increase quantity(lc_gudge, gold) by 16. Assert lends(lc_gudge, lc_magpie_old, actor). Give lc_magpie_old to actor. }
    Result "'Sixteen,' says {lc_gudge}, and weighs the coin in his hand against something that is evidently not a scale. 'That is what it comes to: the champion's weight, in coin, as the pond has always said. Nobody has ever asked what the pond says.' He takes the Magpie down from the shed wall. It is very small in his hand. 'You may tell him,' he says, 'that I had it up there four hours, and could not find the tag.'".
  }
  Action lc_gudge_returns(actor: group, site: place) "Ask Old Gudge whether the thirty-second might be the first face that went home" {
    Speaker lc_gudge.
    Requires able(actor) and company(actor) and at(actor, site) and at(lc_gudge, site) and lcSweetLost(party) and not lcSweetBack(party) and lcGudgeHeard(party) and at(lc_magpie_old, site).
    Time 2.
    On success { Assert lends(lc_gudge, lc_magpie_old, actor). Give lc_magpie_old to actor. }
    Result "He is a long time. Then he gets up off the tub, very slowly, and goes in, and comes out with it in the crook of his arm: the black and white lacquer, with its tag on a string, and the weight of an eel in a spidery hand. 'The wall,' says {lc_gudge}, 'has had a space on it all night. I did not care for the look of it.' He puts the Magpie into your hands. 'The pond is exact. It is also, I find, a thing that can be asked.'".
  }
  Action lc_gudge_returns_hard(actor: group, site: place) "Argue Old Gudge into giving Sweet's face back, as a favour to the pond" {
    Speaker lc_gudge.
    Requires able(actor) and company(actor) and at(actor, site) and at(lc_gudge, site) and lcSweetLost(party) and not lcSweetBack(party) and not lcGudgeHeard(party) and not lcGudgeAngry(party) and at(lc_magpie_old, site).
    Resolve check(actor, persuasion, dc_hard).
    Time 3.
    On success { Assert lends(lc_gudge, lc_magpie_old, actor). Give lc_magpie_old to actor. }
    Result "Gudge listens, with the net across his knees, to the argument that a pond which gives back a face has a better name than a pond that does not; and to the other one, that it is a hard thing to be the man whom the Drip walks round. He says nothing. The clock over the door gets through a whole minute of it. Then he takes it down from the wall as a man does who has found that he has been waiting to be argued out of it for years, and puts it in your hands, with the string still on.".
    Otherwise "'The pond is exact,' says {lc_gudge}. 'I am not the pond's lawyer. It was staked, and lost, and I will not be talked out of what is mine by someone who has never had a thing to lose.' He is looking, you notice, at the wall; and at a space on it that is not yet empty.".
  }
  Action lc_give_mask_back(actor: group, site: place) "Give Barnaby Sweet his Magpie" {
    Speaker sweet.
    Requires able(actor) and company(actor) and at(actor, site) and at(sweet, site) and carries(actor, lc_magpie_old) and lcSweetLost(party).
    Time 2.
    On success { Spend lc_magpie_old from actor. Assert lcSweetBack(actor). Assert lcRematchRun(actor). }
    Result "He takes it in both hands, and looks at it, the way a man looks at the first thing of his that has come back to him; and does not put it on. He turns it over. He finds the thing inside the brow, the little scratch of tallies, with his thumb, and holds the thumb there. 'You know,' says {sweet}, 'I was a man for twelve years, and I believe I was a Magpie for eleven of them.' Then he puts it on, and straightens his back, and is at once, to the whole pond, somebody; and goes on looking at you through the eyeholes as if it were not at all the same thing.".
  }
  Rule lc_magpie_credit when lcSweetBack(party) and lcSweetLost(party) and wears(party, face_magpie) and not lcMagpieGood(party) says "It is remarked on the Row, in the careful way of the Row, that a Magpie was seen at the pond, putting a face back on a man; and the tallymen of the Coffee-house, who are not sentimental, put a mark against it in the book that they keep for such things." { Assert lcMagpieGood(party). Increase goodwill(face_magpie) by 1. }

  // A new face: the Annex needs three signatures on a Bare's form, and nobody wants to be the first. The Pond's keeper
  // must say that the old one is not coming back; a Crow must say whose hand it is that tallies; and then the clerk.
  Relation lcSigGudge(group). Relation lcSigLamb(group).
  Action lc_sig_gudge(actor: group, site: place) "Ask Old Gudge to put his name, as the pond's keeper, to the face being lost" {
    Speaker lc_gudge.
    Requires able(actor) and company(actor) and at(actor, site) and at(lc_gudge, site) and lcSweetLost(party) and not lcSweetBack(party) and not lcSigGudge(party) and not lcGudgeAngry(party).
    Resolve check(actor, persuasion, dc_fair).
    Time 2.
    On success { Assert lcSigGudge(actor). }
    Result "He signs it with a thumb. It is a very exact thumb. 'This pond,' he reads aloud, as he writes, 'declares that the face of {sweet}, tallyman, was lost at the Deepening, fairly, and is not at this time redeemable.' He looks at the word. 'It is not a lie. Do not look at me like that, I never said I would not give it back; I said it was not at this time.'".
    Otherwise "He will not sign a thing that says the pond has finished with a face. He says that it has not finished with any of them.".
  }
  Action lc_sig_lamb(actor: group, site: place) "Ask Hester Lyle to sign for the tallyman's hand, as a Crow" {
    Speaker lamb.
    Requires able(actor) and company(actor) and at(actor, site) and at(lamb, site) and lcSweetLost(party) and not lcSweetBack(party) and not lcSigLamb(party) and (masked(actor) or not publicHours()).
    Resolve check(actor, persuasion, dc_fair).
    Time 2.
    On success { Assert lcSigLamb(actor). }
    Result "'I cannot say whose face it is,' says {lamb}, looking at the form, and then at the line on the slate you have brought, of Sweet's sums. 'A Crow does not know a face. A Crow knows a hand.' She runs her thumb under a seven. 'This is {sweet}'s. I should know it in the dark, with a blindfold, in another city.' She signs it in the margin. 'I should like it entered that I am not signing for his character.'".
    Otherwise "'I do not sign for people,' says {lamb}, courteously. 'I write what is said, and no more. I have, you will understand, been asked to be somebody's character before.'".
  }
  Action lc_buy_new_magpie(actor: group, site: place) "Ask Ferris Moll to cut a Magpie for Barnaby Sweet, three signatures, eight coin" {
    Speaker moll.
    Requires able(actor) and company(actor) and at(actor, site) and at(moll, site) and lcSigGudge(party) and lcSigLamb(party) and lcSweetLost(party) and not lcSweetBack(party) and not lcSweetNew(party) and at(lc_magpie_new, offstage) and quantity(actor, gold) >= 8.
    Time 3.
    On success { Decrease quantity(actor, gold) by 8. Increase quantity(moll, gold) by 8. Give lc_magpie_new to actor. }
    Result "{moll} reads the form with the whole attention of a man who is reading the first thing he has ever been asked to approve. He signs it last, at the bottom, and then he goes to the back and comes out with a domino from the stock that is not for rent, and wraps it in brown paper, and writes on the paper, in the smaller hand, a description of how {sweet} will hold his head. 'It does not fit,' he says. 'They never do. You have to wear them in.'".
  }
  Action lc_give_new_mask(actor: group, site: place) "Give Barnaby Sweet the new Magpie" {
    Speaker sweet.
    Requires able(actor) and company(actor) and at(actor, site) and at(sweet, site) and carries(actor, lc_magpie_new) and lcSweetLost(party).
    Time 2.
    On success { Spend lc_magpie_new from actor. Assert lcSweetNew(actor). }
    Result "He puts it on, and it is wrong: it sits an inch high on the cheekbone, like a stranger's hat. He stands there in it, a tallyman in a Magpie that nobody has ever seen, in front of an eel-pond that no longer knows him by his face. 'Well,' says {sweet}, and the voice, behind the lacquer, is almost his own. 'Now I shall have to be very good, until it fits.'".
  }

  // The Warrant: a Bare may tally. It is not the mask that does the sum. The Exchange does not like it, and cannot say so.
  Action lc_tally_for_sweet(actor: group) "Tally at the Coffee-house in Sweet's stead, bare, under the Warrant" {
    Requires able(actor) and company(actor) and at(actor, coffee_room) and not masked(actor) and warrantLive() and lcSweetLost(party) and not lcSweetBack(party) and not lcSweetTallied(party).
    Resolve check(actor, lore, dc_fair).
    Time 30.
    On success { Assert lcSweetTallied(actor). Increase quantity(sweet, gold) by 14. Increase heat(actor) by 1. Assert knows(actor, lc_survey_tip). }
    Result "The Magpies' bench does not answer you; it has been told by the Warrant that it may not refuse, which is not the same as being willing. For five hours you tally for a man who is not there, bare, at his stool, as the sums are put to you across the table by people who look at the wall. Nobody says anything. At the end of it the bench has paid, in coin, to a Bare, a tallyman's morning's wage and a deal more, without a word, and the oldest of them, passing, mutters the figure of an eleven-coin debt as though to the air; and then, in the way of the place, never speaks of it again. The Watch will count this against you. It was, you suppose, an unusual use of a Warrant.".
    Otherwise "You carry the wrong figure down a column and the bench, which has not been spoken to by a Bare in its life, finds it at once, and is grateful for the opportunity.".
  }

  // Bare work: nobody answers a Bare. Nothing in the Concord says nobody answers a sum.
  Relation lcSweetNeeded(group).
  Topic lc_sweet_need with sweet "Ask him to tally the company's money, bare, because nobody else will" when lcSweetAsked(actor) and lcSweetLost(party) and not lcSweetBack(party) and not lcSweetNew(party) and not lcSweetSlate(party) and not lcSweetNeeded(party) once {
    Says "He looks up so fast that the lobster-pot falls over. 'Tally?' He says it as another man would say bread. 'For you? Bare?' And then, with the terrible honesty of a man who has had no practice at lying in four hours: 'It would be done wrong. I am out of the way of it. I have been a Magpie.' A pause. 'The Bare have money. I have seen them in the Hospice queue, counting it on their knees. Nobody will do it for them. Nobody can.' He picks the pot up. 'Nobody can, but a man who is not answered himself.' He does not say anything for a minute, and then he says: 'Give me a bit of slate.'".
    On discuss { Assert lcSweetNeeded(actor). }
  }
  Action lc_chalk_slate(actor: group, site: place) "Chalk the first slate with him, and hang it where the Coffee-house can see" {
    Speaker sweet.
    Requires able(actor) and company(actor) and at(actor, site) and at(sweet, site) and lcSweetNeeded(party) and not lcSweetSlate(party).
    Resolve check(actor, lore, dc_easy).
    Time 6.
    On success { Assert lcSweetSlate(actor). }
    Result "You set the sums down together, his hand and yours, on a roofing slate from the shed: the price of tallow, the weight of a bale, what a ferry owes a quay. His hand is not what it was; it improves with every line, like a man's gait on a road he knows. By dusk it is right. By the next morning it is hung on a nail outside the Tally Coffee-house, where nobody says a word to the bare man standing beside it, and a good many people stop, and read it, and drop coin into the pot without saying a word either. It is the first transaction in the history of the Exchange in which nobody has spoken to anybody; and it works perfectly.".
    Otherwise "You set a figure wrong and he sets a worse, and you both look at the slate, which says that four and four is nine; and {sweet}, who has not laughed in six hours, laughs. It is an honest, hopeless, hiccuping laugh, and it does him more good than the sums would have.".
  }

  // ══ HESTER LAMB AND THE BOOK OF HANDS ════════════════════════════════════════════════════════════════════════════════
  // A letter-writer writes what is said, and no more, and keeps what is said. In fifty-eight years Hester Lyle has written
  // four hundred people's secrets into a ledger in sailcloth, in a hand she calls the Book of Hands, and she has never let
  // one out of the booth. On the fourth day a man in the key-grey of the Warden of Locks comes to the arcade with a writ:
  // the Inspection of Hands, by which a Warden may call for the ledger of any writer in the Sleeve, to find who has been
  // writing to the Chapel about the Lock-tax. By the Ninth Bell of the sixth day the book is to be in the Warden's house.
  // She will give it up, on the sixth day, if nobody comes. She has also, for eleven years, held a secret of her own, in
  // two baskets: that two people who quarrel every morning on a ferry are in love by post (below).
  Discovery lc_demand_known "The Warden of Locks has sent a man with a writ, the Inspection of Hands, for Hester Lyle's ledger of four hundred clients, the Book of Hands, to be in the Warden's house by the Ninth Bell of the sixth day, to find who has been writing about the Lock-tax.".
  Discovery lc_custody_known "A thing a Bare has read under the Warrant is kept for the Hearing of the Unseen, and the Warden may not Inspect it before that: so the Warrant can be asked to hold a book that a Warden has called for.".
  Discovery lc_ledger_nf "In the Book of Hands there is a page headed N. F., in a clerk's careful hand, that sets down, item by item, what the Lock-tax takes; the only client of Lyle's who writes about it, and the one the Warden's man is looking for.".
  Kind lc_hands_kind "the Book of Hands" is gear worth 0 weighing 3 described "A ledger bound in sailcloth gone black at the edges with thumbs, four hundred clients deep, the spine mended with a stitch that is not a clerk's. It is ruled in columns: NAME, DAY, WHAT WAS SAID, WHAT WAS PAID. It is the heaviest thing in the arcade, and the only one that is not for sale.".
  Item lc_hands "the Book of Hands" is lc_hands_kind at lc_booth owned by lamb.

  Person lamb "Hester Lyle" at arcade {
    Role "letter-writer, of the arcade". Ancestry human. Peaceable. Pronouns she. Manner acerbic.
    Known as "a tall woman in the Crow's domino with ink to the wrist" when publicHours() and not knows(party, lc_lamb_face).
    Greets "A tall woman at the last stall looks up over a pen, and the Crow's domino turns the look, as a bird's does, from the side: one eye and then the other. 'Letters written, read, fair-copied, answered. I take the thing said and put it where it will go. No more, and nothing less.' A pause. 'It is a more restful trade than people think. Nobody has ever asked me to be clever.'".
    Greets again "'Letters,' says the woman at the last stall, and moves the stone off a pile of fair copies, in case you have come about one.".
  }
  Initially Assert unmaskTeaches(lamb, lc_lamb_face).
  Discovery lc_lamb_face "The Crow in the last stall is Hester Lyle, fifty-eight, letter-writer to the Drip and the Row for thirty years, who has kept every secret she was ever told and has never, in her life, been thanked for one.".
  Rule lamb_stall when publicHours() and not lcSurrendered(party) and not at(lamb, arcade) { Assert at(lamb, arcade). }
  Rule lamb_booth when (privateHours() or lcSurrendered(party)) and not at(lamb, lc_booth) { Assert at(lamb, lc_booth). }
  Query lcResolved() means lcWarned(party) or lcDecoyPassed(party) or lcIndexGiven(party) or lcSealed(party) or lcBurned(party) or lcSurrendered(party).
  Query lcDemandOpen() means day(clock) >= 4 and not lcResolved().

  // The keyman: the Warden's, in the key-grey, from the fourth morning; he comes and goes with the Masked Hours.
  Person lc_keyman "a man of the Warden's" at offstage {
    Role "the Warden of Locks' keyman, with a writ". Ancestry human. Peaceable. Pronouns he. Manner stoic.
    Known as "a man in a key-grey domino with a writ under his glove" when publicHours() and not knows(party, lc_keyman_face).
    Greets "The man in the key-grey does not look at the ink-sellers, or the Crows, or the rain. 'The Inspection of Hands,' he says, as one might say a weather. 'Article thirty-three. The Warden asks that every writer of the Sleeve be ready, at the Ninth Bell on the sixth day, to put her book in the hand of the man who comes for it.' He turns a page in the writ and shows you nothing. 'It is a request, in the manner of the Warden's requests.'".
    Greets again "'The sixth day, at the Ninth Bell,' says the man in the key-grey, to nobody in particular.".
  }
  Initially Assert unmaskTeaches(lc_keyman, lc_keyman_face).
  Discovery lc_keyman_face "The Warden's keyman is a Key's undersecretary named Pettifer Rudge, a thin, pleasant man who is frightened of the Warden, and who is in the arcade because he was told that a clerk will do.".
  Rule keyman_comes when day(clock) >= 4 and publicHours() and hour(clock) >= 9 and hour(clock) < 18 and lcDemandOpen() and not at(lc_keyman, arcade) { Assert at(lc_keyman, arcade). }
  Rule keyman_goes when (not lcDemandOpen() or privateHours() or hour(clock) >= 18 or hour(clock) < 9) and not at(lc_keyman, offstage) { Assert at(lc_keyman, offstage). }
  Observe lc_keyman_demand at arcade when at(lc_keyman, arcade) and lcDemandOpen() "Pinned under a stone on Lyle's desk is a writ, in the Key's grey ink: BY THE WARDEN'S INSPECTION OF HANDS, ARTICLE THIRTY-THREE. THE BOOK OF HANDS TO BE DELIVERED THE NINTH BELL OF THE SIXTH DAY. The Crow has not touched it." teaches lc_demand_known.
  Topic lc_key_cold with lc_keyman "Say good morning to the man in the key-grey" when not masked(actor) and publicHours() once {
    Says "The man in the key-grey has been told that a Bare does not occur. He does not look at you. He looks, with great steadiness, at a crow's-foot of ink on the stall, and his hand tightens on the writ, once, and then lets it go, as a man does who is, underneath it all, rather a nice man and rather glad to have been ordered not to speak.".
  }
  Topic lc_key_writ with lc_keyman "Ask the man in the key-grey what the writ is for" when masked(actor) and publicHours() once {
    Says "'To find a person,' he says, and then, as if hearing himself, 'to find whoever has been writing, through a hand in this arcade, to the Chapel of the Bare Face, regarding the Warden's Lock-tax. Somebody has put in the Warden's possession that the Chapel has been written to. It was a hand in the arcade; the hand has a client list. I am not told what it says.' A very small, very civil cough. 'I was told: four hundred pages, and a lot of Crows. I believe it to be, in the usual way of the Key, an inconvenient task given to a man who has not been consulted.'".
    On discuss { Assert knows(actor, lc_demand_known). }
  }

  // Her register by day: she does not write for the bare; for a customer she is a trade; for a Crow she is a colleague.
  Topic lc_lamb_cold with lamb "Say good morning to the Crow at the last stall" when not masked(actor) and publicHours() once {
    Says "'A Crow does not take dictation from a bare face,' says {lamb}, and the pen does not stop; it is, you see, writing for somebody else, one clean line after another, in a hand you could have set a ruler by. 'My pen is a mask's. It writes for what is said by somebody, and a bare face is nobody.' She dips it. 'I say it kindly. It is the kindest thing that anyone will say to you today.'".
  }
  Topic lc_lamb_trade with lamb "Ask the Crow what it costs to have a letter written" when masked(actor) and not wears(actor, face_crow) and publicHours() once {
    Says "'A penny a page, and a halfpenny for the sand.' She turns the sheet to you with an air of trade. 'Read, written, fair-copied, answered: those are the four. To read, I read you your own letters, if you are not able. To write, I put it down as you say it. To fair-copy, I make it tidy. To answer, I say what you would have said, if you were me.' A beat. 'A good many ask for the last. I do not take it for those who have the time.'".
  }
  Topic lc_lamb_colleague with lamb "Ask the Crow beside you how business has been" when wears(actor, face_crow) and publicHours() once {
    Says "The Crow in the stall beside you does not look up; she makes a mark in a book, and says, to the book, in the voice of one trade to another, 'Not good, not good. There is a man in the key-grey who has been standing at the end of my stall since the morning. I have written nine letters since he came and every one has been about the weather.' She sharpens a pen that was sharp. 'A man with a writ is bad for business, as you know. People stop wanting to say anything.'".
    On discuss { Assert knows(actor, lc_demand_known). }
  }
  Topic lc_lamb_night with lamb "Ask Hester Lyle whether she has a moment" when not masked(actor) and privateHours() and at(lamb, lc_booth) once {
    Says "She looks up from the desk with her face bare, which is a longer face than you would have expected and has more tiredness in it than temper, and does not reach for the mask on its nail. 'I do not take dictation after the Ninth Bell,' says Hester Lyle. 'But there is a kettle for those who come through the curtain at night. It is the Crow's rule. By day we write what is said; by night we are said to.' She moves a pile of fair copies off the stool. 'Sit. The stove is the only thing in the arcade that is warm.'".
  }
  Rule lc_burglary when masked(party) and privateHours() and (at(party, lc_booth) or at(party, lc_dray_room) or at(party, ostler_shop) or at(party, penhallow_shop)) once says "A masked face in a house at night is a burglar, and it is the one thing in the Concord that is not mentioned, because it needs no mention. Somebody in the street has seen the shape on the stair, and is saying nothing, rapidly, to the nearest Watch domino." { Increase heat(party) by 1. }

  // Opening her: by the favour of her ledger; by an hour in her booth; or by reading what is in her hands.
  Action lc_lamb_sit(actor: group) "Sit in the booth while she fair-copies, and say nothing, for an hour" {
    Speaker lamb.
    Requires able(actor) and company(actor) and at(lamb, lc_booth) and at(actor, lc_booth) and not masked(actor) and privateHours() and not lcLambOpen(party) and not lcBetrayed(party).
    Time 6.
    On success { Assert lcLambOpen(actor). }
    Result "She writes. You sit. It is not, in the end, a very long hour: a woman's pen on paper, the stove, the rain on the awning; sixty fair copies of other people's lives going from a heap on the left to a heap on the right. At the end she blots a page and says, 'I am not used to being waited with. It is a quality I had forgotten a person could have.' She puts the stone on the heap. 'You will be wanting to ask me something, and I should like it to be a thing I can answer.'".
  }
  Action lc_lamb_read(actor: group, site: place) "Watch her hands, and work out what the two baskets are for" {
    Speaker lamb.
    Requires able(actor) and company(actor) and at(actor, site) and at(lamb, site) and not lcLambKnown(party) and knows(actor, lc_baskets).
    Resolve check(actor, insight, dc_fair).
    Time 3.
    On success { Assert lcLambKnown(actor). Assert knows(actor, lc_lamb_between). Assert knows(actor, lc_heron_writes). Assert knows(actor, lc_lamp_writes). }
    Result "She writes with two hands, you notice: the one hand in the daytime, a clerk's, flat and fast; and, when she lifts a letter from the green-tied basket, another, a looser, rounder script that comes out of the same wrist like a stranger's voice out of a familiar mouth. A Crow does not write what is not said: so the sentences in the round hand are somebody's, taken down. And the letters that go back and forth between the baskets come out, on the page, much the same size. A woman who dictates and a man who writes; eleven years. She watches you see it. She does not say a thing. She moves the stone a quarter of an inch.".
    Otherwise "Her hands are as flat and as fast as before; she has seen you looking, and has lifted nothing from either basket. 'It is a pretty pair of baskets,' says {lamb}, to the paper. 'People look at them.'".
  }
  Discovery lc_baskets "Hester Lyle keeps two baskets on a shelf behind her stall, a lamp painted on one lid and a heron on the other, in a hand that is not hers.".
  Discovery lc_lamb_between "Hester Lyle writes down what a woman called the Lamp tells her, and fair-copies what a man called the Heron writes, and has carried each one's letters to the other for eleven years without telling either who the other is.".
  Relation lcBetrayed(group).
  Rule lc_lamb_favour when lcLedgerSafe(party) and not lcLambOpen(party) and not lcBetrayed(party) { Assert lcLambOpen(party). }
  Rule lc_ledger_safe_any when (lcWarned(party) or lcDecoyPassed(party) or lcIndexGiven(party) or lcSealed(party) or lcBurned(party)) and not lcLedgerSafe(party) { Assert lcLedgerSafe(party). Increase lcBlessing(party) by 1. }

  // What she will say, once she is open. She will not say whose they are. She will say what the baskets are, and what
  // she is afraid of, and what the Swap is for.
  Topic lc_lamb_baskets with lamb "Ask Hester Lyle about the two baskets" when lcLambOpen(party) and not masked(actor) once {
    Says "'A Heron,' she says, 'and a Lamp.' A Crow does not say it; she writes it, and she is writing it now, in the air, with one finger. 'They have written one another eleven years. Neither knows who the other is. I have never told either, and I shall not.' She looks at the baskets. 'They are the best letters in Ombra. I would not say it to a client; it is a Crow's rule that a letter is the writer's. But I have read, in thirty years, a very great number of letters. And I have not often been made to put down the pen.'".
    On discuss { Assert knows(actor, lc_lamb_between). Assert knows(actor, lc_heron_writes). Assert knows(actor, lc_lamp_writes). }
  }
  Topic lc_lamb_fear with lamb "Ask Hester Lyle why she has said nothing in eleven years" when lcLambOpen(party) and knows(actor, lc_lamb_between) and not masked(actor) once {
    Says "'Because they would meet.' It comes out almost angry. 'The Heron is a man who is afraid of being a person and has made himself a sentence instead. The Lamp has something very like it. They love one another's sentences. Sentences are safe to love. People answer back. If they met, they would find the eight o'clock ferry, a Gull and a Heron, a fare, and a quarrel about an umbrella.' A silence. 'It is a wicked thing to say that of two people. I say it because I have seen how they write when they have been quarrelling all morning. It is better. It is better, the days they hate each other. I have never known what to do with that.'".
    On discuss { Assert knows(actor, lc_pair_known). }
  }
  Topic lc_lamb_swap with lamb "Ask Hester Lyle what the Swap is for" when lcLambOpen(party) and not masked(actor) and day(clock) <= 5 once {
    Says "'To be found out,' says {lamb}, drily. 'The city pretends it is exchange: you swap a spare with the first stranger, and cross the Cuff. It is a Pair's night. The Pair cross together in the one boat, nine strokes, and for each stroke each says a sentence of his own, not the city's, nobody's. At the ninth the Witness may lower the lantern, or hold it, and the Pair may lift. They say it is why the city has so many people born in the autumn.' She turns the pen over. 'I have never been a Pair. I have been, three times, a Witness. One does not say anything. It is the most that anyone is to anyone.'".
    On discuss { Assert knows(actor, lc_pair_rule). Increase lcBlessing(actor) by 1. }
  }
  Discovery lc_pair_rule "On the night of the Swap each citizen exchanges a spare mask with the first stranger who asks, and the two are a Pair till dawn: they cross the Cuff together in one boat, nine strokes, each saying for every stroke a sentence of their own; at the ninth stroke the Witness who holds the lantern may lower it or hold it up, and the Pair may lift each other's masks. A ferryman's Pair is whoever steps into the boat first.".
  Discovery lc_heron_writes "Cosimo Dray, third clerk of the Weights, has written for eleven years to a woman he has never met, whom he calls the Lamp, by way of the Dead Letter Office and a letter-writer's baskets.".
  Discovery lc_lamp_writes "Rill Ketch, ferrywoman, dictates by a lantern in her boat, to a letter-writer, letters to a man she has never met, whom she calls the Heron; she has done it for eleven years.".
  Discovery lc_pair_known "The Lamp is Rill Ketch and the Heron is Cosimo Dray: the ferrywoman and the clerk who quarrel about the fare every morning. Neither has the least idea.".
  Discovery lc_ferry_quarrel "Cosimo Dray, third clerk of the Weights, and the ferrywoman Rill Ketch quarrel about the fare every morning and every evening, at the Drip landing and the Row quay, over two coin against three and the drip from his umbrella.".
  Rule lc_pair_deduced when knows(party, lc_ferry_quarrel) and knows(party, lc_heron_writes) and knows(party, lc_lamp_writes) and not knows(party, lc_pair_known) says "You lay the three side by side, as you would lay three odd stitches: the clerk who counts out his coppers, the ferrywoman who writes by a lantern, the two baskets. A man who has never met the woman he writes to; a woman who has never met the man. And in the Drip, every morning at eight, a Gull and a Heron in a boat, quarrelling about an umbrella. They make one shape." teaches lc_pair_known { }

  // ── What the company may do about the writ ────────────────────────────────────────────────────────────────────────
  // Five roads. Each costs something different, and each leaves Lyle a different woman.
  // One: tell the clients, by night, before the book goes. A long walk; the Watch counts it.
  Action lc_warn_clients(actor: group) "Take Lyle's index of addresses and carry the warning to her clients, door to door, tonight" {
    Speaker lamb.
    Requires able(actor) and company(actor) and at(lamb, lc_booth) and at(actor, lc_booth) and not masked(actor) and privateHours() and lcLambOpen(party) and knows(actor, lc_demand_known) and not lcWarned(party) and day(clock) <= 6.
    Resolve check(actor, wayfinding, dc_fair).
    Time 24.
    On success { Assert lcWarned(actor). Increase heat(actor) by 1. }
    On failure { Assert lcWarnedHalf(actor). Increase heat(actor) by 1. }
    Result "She gives you the index, which is only the names and the streets: not what was said. It is four hundred doors in the Drip and the Row and the Hill and the Wet Post, and it is raining on all of them, and a bare knock at night is received, which is the whole of your qualification. You say the same sentence two hundred times, in two hundred hallways, to people who have taken their faces off and do not know what to do with their hands: that the Warden has called for a book. At the last door, a man in his nightshirt, a baker, says, 'I wrote to my brother in the north,' and, 'it was nothing,' and goes pale, and is, you think, the sixth who has done so. By the time you have crossed the last bridge the first of them are already lighting their stoves, for the pages they will be cutting out.".
    Otherwise "You have the names and the streets, and most of the doors, and a night is not long enough for four hundred: at the hundred and ninetieth the lamps of the Wet Post go out, and a Watch domino at the end of a bridge says 'move along' to a bare face in a way that is an entry in a book. You have done half. It is more than nothing, and it will have to be said that it is not enough.".
  }
  // Two: a decoy. Lyle will not write a line that is not said; she will turn her back.
  Action lc_forge_decoy(actor: group) "Fill a second book with a hundred dull names, ruled and ink-stained like hers" {
    Requires able(actor) and company(actor) and at(actor, lc_booth) and lcDemandOpen() and knows(actor, lc_demand_known) and not lcDecoyMade(party).
    Resolve check(actor, lore, dc_fair).
    Time 18.
    On success { Assert lcDecoyMade(actor). }
    Result "{lamb} turns her back on you and goes to the stove and stands there, which is all the permission that a Crow can give. You copy from her own columns: the rule of NAME, DAY, WHAT WAS SAID, WHAT WAS PAID, and the Crow's shorthand for a sum, and her trick of leaving the last line of every page half-filled. What you put in it is nothing: a landlady's rent, a man's seed-prices, a girl's letter to a cousin about a hat. A hundred dull people, and the book is as heavy as hers, and when you shut it the sand comes out of the spine in the same place.".
    Otherwise "It is not the hand that gives you away, but the sand. You have put it in the wrong place. {lamb}, at the stove, with her back to you, says without turning: 'The spine.' It is a thing a Crow would say about a book. You start again.".
  }
  Action lc_pass_decoy(actor: group, site: place) "Hand the keyman the second book, as Lyle's" {
    Speaker lc_keyman.
    Requires able(actor) and company(actor) and at(actor, site) and at(lc_keyman, site) and masked(actor) and lcDecoyMade(party) and lcDemandOpen().
    Resolve check(actor, deception, dc_hard).
    Time 3.
    On success { Assert lcDecoyPassed(actor). }
    On failure { Assert lcDecoyCaught(actor). Increase heat(actor) by 1. }
    Result "He weighs it in his hand, as a man does who has been told by his master that a book will have a weight, and finds that it has. He opens it at random and reads a landlady's rent. 'Four hundred,' he says, doubtfully. He reads a girl's hat. 'It is a very dull book.' 'It is,' you say, 'a Crow's.' He considers this, and writes something on the writ, and takes it away under his coat, with the care of a man who has been given a duty, and who is, very likely, going to be relieved of it.".
    Otherwise "He opens it at random, and reads, and shuts it. 'There is no sand in the spine,' he says. He says it quite gently. 'The Warden said there would be.' He puts it down on the stall with a great and tired civility, as if returning a gift. 'I shall be back at the Ninth Bell for the real one, and I shall not be so obliging about the hour.'".
  }
  Rule lc_decoy_caught_surrender when lcDecoyCaught(party) and hour(clock) >= 20 and not lcResolved() says "At the Ninth Bell the man in the key-grey comes to the stall, with two men behind him who are not Crows, and does not ask. {lamb} gives him the Book of Hands. It is not even heavy." { Assert lcSurrendered(party). }
  // Three: half the book, the index, and no more.
  Action lc_ask_lamb_index(actor: group) "Ask Lyle to give the keyman the index, the names, and keep what was said" {
    Speaker lamb.
    Requires able(actor) and company(actor) and at(lamb, arcade) and lcLambOpen(party) and lcDemandOpen() and not lcIndexGiven(party) and at(actor, arcade) and publicHours().
    Resolve check(actor, persuasion, dc_fair).
    Time 2.
    On success { Assert lcIndexGiven(actor). }
    Result "'He asked for the book,' she says. 'He has not asked what it is.' She goes in and comes out with a thin pamphlet, the index, no larger than a Bible, tied with red wool: the names, the streets, and nothing else. The man in the key-grey, who has been told that it will be four hundred pages, is given something very much like it. He turns it over twice, reads a name, and looks, for a moment, as though he had been given a present. 'The Warden asked for the book,' he says. 'He did not say it would be the whole of it.' 'He did not say,' says {lamb}, quite gently, 'that it would not.'".
    Otherwise "'No,' says {lamb}. 'A list of names is a Warden's pass-key to four hundred doors. It is all of the book that matters. It is the wrong half to give.'".
  }
  // Four: the Warrant. A Bare who has looked at a thing under it keeps it for the Hearing, and the Warden cannot call it.
  Topic lc_vail_ledger with vail "Ask Sergeant Vail whether the Watch will protect a letter-writer's book from a Warden's writ" when knows(actor, lc_demand_known) and not masked(actor) once {
    Says "'No.' {vail} answers it at once, in the way she answers the things she dislikes. 'The Inspection of Hands is the Warden's by right; the Watch cannot countermand it.' She turns a page she has not been reading. 'You carry a Warrant, however. A thing that a Bare has read under it is held for the Hearing of the Unseen, and the Warden cannot call for it till then.' She does not look up. 'I do not say that is a loophole. I say that it is an article. A Warrant used on a clerk's ledger is an unusual use; the Watch will enter it. Do not make me tell you that it will count.'".
    On discuss { Assert knows(actor, lc_custody_known). }
  }
  Action lc_seal_book(actor: group) "Take the Book of Hands into the Warrant's keeping, sealed and unread" {
    Speaker lamb.
    Requires able(actor) and company(actor) and at(lamb, lc_booth) and at(actor, lc_booth) and not masked(actor) and warrantLive() and lcLambOpen(party) and knows(actor, lc_custody_known) and not lcSealed(party) and not lcBurned(party) and not lcSurrendered(party).
    Time 3.
    On success { Assert lcSealed(actor). Increase heat(actor) by 1. Assert lends(lamb, lc_hands, actor). Give lc_hands to actor. Assert promiseMade(lc_unread). }
    Result "She lifts it down off the shelf with both hands, a woman handling a child she has been carrying for thirty years, and puts it into yours. 'You will not read it,' says {lamb}. It is not a question, and it is not an order; it is, you realise, the entire contract. 'Not a line. You will carry it for the Hearing and give it back to me when the Hearing is done. If a thing is read, it has been said.' A pause. 'I should like you to make a promise. I do not take them lightly. It is the one thing in my trade that I do not charge for.'".
  }
  Promise lc_unread "to hold the Book of Hands sealed, and give it back unread" to lamb
    kept when lcSealed(party) and newsHour() and not lcRead(party) "At the end, the Book of Hands goes back across the Crow's stall, sealed as it left, and {lamb} puts it on the shelf behind the baskets and does not open it, to see."
    broken when lcRead(party) "Somewhere in the arcade a stool is turned to the wall." { }.
  Action lc_read_hands(actor: group, site: place) "Open the Book of Hands, and read" {
    Requires able(actor) and company(actor) and at(actor, site) and carries(actor, lc_hands) and not lcRead(party).
    Grave "A thing read has been said. She asked you not to.".
    Time 6.
    On success { Assert lcRead(actor). Assert lcBetrayed(actor). Assert knows(actor, lc_ledger_nf). Assert knows(actor, lc_lamb_between). Assert knows(actor, lc_heron_writes). Assert knows(actor, lc_lamp_writes). Retract lcLambOpen(actor). }
    Result "Four hundred people. A baker to his brother; a widow to a man she should not write to; a boy to a girl he has not met; a Warden's clerk, in a careful hand, to the Chapel, item by item, what the Lock-tax takes. A Heron to a Lamp; a Lamp to a Heron, eleven years of it, in two hands in one margin. You read for six hours, in the rain, with a growing feeling that you are the only person in Ombra who knows what it is to be known. Nobody is hurt. It is merely that something that was hers has stopped being.".
  }
  // Five: she burns it herself.
  Action lc_burn_book(actor: group) "Ask Lyle to burn the Book of Hands, rather than see it read" {
    Speaker lamb.
    Requires able(actor) and company(actor) and at(lamb, lc_booth) and at(actor, lc_booth) and lcLambOpen(party) and lcDemandOpen() and not lcBurned(party) and not lcSealed(party) and not lcSurrendered(party).
    Grave "She will not write a line of it again. Four hundred people's pending letters go into the stove.".
    Time 6.
    On success { Assert lcBurned(actor). }
    Result "She does not hesitate; that is how you know it is a hard thing. She feeds it to the stove one signature at a time, the way you feed a child: the baker's brother, the widow, the boy and the girl. She reads none of it. 'A book burned is a promise kept in the only way it cannot be broken.' The sailcloth goes last, and smells of a ship. 'I keep them by heart, of course, which is worse. It is a worse place for them, and a safer.' She puts the poker down. 'The man in the key-grey will want a reason.' She smiles, for the first time. 'I have never in my life been unable to write one.'".
  }
  Rule lc_keyman_after_burn when lcBurned(party) and day(clock) >= 5 and not lcDecoyPassed(party) says "On the stall in the arcade there is now a notice, in the best Crow's script, that the Book of Hands was lost in a stove fire on the fourth night, and that the Crow regrets it. Under it a clerk of the Warden's has written, in a grey hand, that he has noted this; and, in the margin, in the same hand, a word that is not a legal one." { }
  Rule lc_book_surrenders when day(clock) == 6 and hour(clock) >= 20 and not lcResolved() says "At the Ninth Bell of the sixth day a man in the key-grey comes to the last stall of the arcade, with two others, who are not Crows, and {lamb} gives him the Book of Hands. She does not look at it as it goes. The arcade stays very quiet. In the morning her board will be turned to the wall." { Assert lcSurrendered(party). Assert lcLettersStopped(party). }
  Rule lc_stopped_when_surrendered when lcSurrendered(party) and not lcLettersStopped(party) { Assert lcLettersStopped(party). }

  // ══ THE HERON AND THE LAMP (Round 2) ═════════════════════════════════════════════════════════════════════════════════
  // Cosimo Dray, forty-one, third clerk of the Weights, and Rill Ketch, thirty-eight, who rows the Row ferry, have written
  // to one another for eleven years through a letter-writer's baskets, never meeting, each in love with the other's
  // sentences; and every morning at eight and every evening at six they quarrel on the ferry about whether an open
  // umbrella is a passenger (the Ferrymen's Twelfth: it is). He thinks the Lamp is a woman of leisure who keeps herons
  // for a hobby; she thinks the Heron is a Heronry man with fine hands. Lyle has known for eleven years and has said
  // nothing, because she is afraid they would find the ferry and the fare and lose the sentences.
  // Approaches: Lyle can tell them nothing and the company may not; the company may ask (Cosimo, Rill), may wait, may
  // forge a letter, may tell one of them (Unfacing, and a mistake), or may use the Swap, the one night the city's own
  // Usage obliges a Pair to cross the Cuff and say a sentence each at every stroke, and lets the Witness choose whether
  // they lift their masks by lantern-light or in the dark. They are the Pair; and a Witness may be anyone who asks.
  Discovery lc_laugh_clue "The Lamp has written to the Heron that she is told she laughs like a sheet being torn down the middle; he has never heard it, and it is the only description of a laugh he has ever believed.".
  Discovery lc_rill_fear "Rill Ketch believes that the sentences the Heron loves are Hester Lyle's and not hers: that she says a thing like a wet rope, and Lyle sets it down like what she meant, and he is in love with the one Lyle made.".
  Discovery lc_cosimo_fear "Cosimo Dray has let the Lamp think he is a man of leisure who keeps herons, because he is afraid that a third clerk of the Weights, who does not tip, is a column and not a person.".
  Discovery lc_swap_hint "A Witness at the Swap holds the lantern for the Pair, and at the ninth stroke may hold it up, or lower it: the dark is kinder to a Pair who are not yet ready, the light to a Pair who are.".

  Person cosimo "Cosimo Dray" at weights_floor {
    Role "third clerk of the Hall of Weights". Ancestry human. Peaceable. Pronouns he. Manner stoic.
    Known as "a thin man in the Heron's cowl counting under his breath" when publicHours() and not knows(party, lc_cosimo_face).
    Greets "A thin man looks up from the figure he is entering, and for a moment the whole of his attention is on you, apologetic, as a man's is who has been interrupted in the middle of being nobody. 'Third clerk,' he says, and then, as if clerks were not supposed to say such things aloud, 'forgive me, I mean to say that I am a Heron. It is a very small office. We do not often have visitors.'".
    Greets again "'Ah,' says the thin man, and enters nothing.".
  }
  Initially Assert unmaskTeaches(cosimo, lc_cosimo_face).
  Discovery lc_cosimo_face "The Heron who counts his fare into the ferrywoman's hand is Cosimo Dray, forty-one, third clerk of the Hall of Weights, who lodges over Penhallow's on Umbrella Row and has never in his life been late.".
  Rule cosimo_landing_am when hour(clock) == 8 and not lcMorningAfter() and not at(cosimo, drip_landing) { Assert at(cosimo, drip_landing). }
  Rule cosimo_hall when hour(clock) >= 9 and hour(clock) < 17 and not at(cosimo, weights_floor) { Assert at(cosimo, weights_floor). }
  Rule cosimo_quay_pm when hour(clock) == 17 and not at(cosimo, row_quay) { Assert at(cosimo, row_quay). }
  Rule cosimo_landing_pm when hour(clock) == 18 and not at(cosimo, drip_landing) { Assert at(cosimo, drip_landing). }
  Rule cosimo_home when (hour(clock) == 19 or privateHours()) and not (day(clock) == 5 and lcCosEscorted(party) and hour(clock) >= 19) and not lcCuffOut() and not at(cosimo, lc_dray_room) { Assert at(cosimo, lc_dray_room). }
  Query lcMorningAfter() means lcOutcome(party) and day(clock) == 6 and hour(clock) < 8.
  Query lcCuffOut() means lcPaired(party) and not lcOutcome(party) and day(clock) == 5.

  // The ferry, morning and evening. What the company sees depends on how the Swap went.
  Observe lc_quarrel_am at drip_landing when hour(clock) == 8 and at(cosimo, drip_landing) and not lcOutcome(party) and not lcEstranged(party) "Eight o'clock at the Drip landing, and the Row ferry is waiting with its lantern lit in the rain and a Gull in the stern, a broad woman in a patched domino with her sleeves rolled and her chin out. A thin man in a Heron's cowl counts something into her palm, coin by coin, as if weighing each against his conscience. 'Two,' he says. 'Four,' she says. 'The umbrella is open.' 'It is raining.' 'The Twelfth says a passenger. An open one eats room.' He opens his purse again. It is, you gather, a thing that has happened every morning for eleven years, and has gone neither better nor worse." teaches lc_ferry_quarrel.
  Observe lc_quarrel_pm at row_quay when hour(clock) == 17 and at(cosimo, row_quay) and not lcOutcome(party) and not lcEstranged(party) "At the Row quay at five the ferry comes in, and the thin Heron from the Weights is first down the steps, with his umbrella open over a pile of ledgers; and the Gull at the oars, without a word, holds out her palm. He counts into it. She counts again, with her thumb. He says, quite quietly, that it is a Penhallow's umbrella and does not drip, and she looks, with extreme deliberation, at the thread of water running from the rib on to her thwart." teaches lc_ferry_quarrel.
  Observe lc_quarrel_after_together at drip_landing when hour(clock) == 8 and lcOutcome(party) and loversTogether(party) and day(clock) >= 6 "Eight o'clock at the Drip landing, and the Heron from the Weights is standing at the foot of the ferry steps with his umbrella open, over two. The Gull at the oars is under it, with her sleeves down, for the first time in eleven years, and the passage is two coin, as a matter of Usage: one open umbrella, one person, or two persons under it, by the Ferrymen's Twelfth, one fare. Neither is speaking. It is, you gather, a kind of speaking that does not wish to be interrupted.".
  Observe lc_quarrel_after_civil at drip_landing when hour(clock) == 8 and lcOutcome(party) and lcCivil(party) and day(clock) >= 6 "Eight o'clock at the Drip landing, and the Heron counts his coppers into the Gull's palm. 'Two,' he says. 'Four,' she says. 'The umbrella.' 'It is open,' he says, 'because it is raining.' There is, in the exchange, an extraordinary new quality of care, as there would be in a duel between two people who have agreed what they are fighting about; and under the rim of the Heron's cowl the tip of one ear has gone quite pink.".
  Observe lc_quarrel_after_estranged at drip_landing when hour(clock) == 8 and lcEstranged(party) and at(cosimo, drip_landing) "Eight o'clock at the Drip landing, and the Row ferry goes out with a Gull in the stern and a thin man in a Heron's cowl on the farthest thwart, with his umbrella furled, wet to the skin. Nobody says anything about the fare. It is not paid; it is not asked. She rows him across with her back to him, and the Cuff has never looked so wide.".
  Observe lc_dray_present at lc_dray_room when at(cosimo, lc_dray_room) and privateHours() "{cosimo} sits at the table in his shirtsleeves with his face bare, which is smaller than the Heron's and a good deal more worried, writing; and at your step on the stair, his pen rises, and a drop of ink hangs on it and falls, and he does not notice." teaches lc_cosimo_face.

  // By day: bare, a colleague, a customer.
  Topic lc_cos_cold with cosimo "Say good morning to the clerk at the counter" when not masked(actor) and publicHours() once {
    Says "The Third Clerk of the Weights goes on entering a figure. It is a long figure, and requires, evidently, the whole of him; you have seen men use a sum like that, as another man uses a door, to be on the other side of it. A bare face is a thing a Heron is not trained for. He is, you see, extremely embarrassed on your behalf.".
  }
  Topic lc_cos_colleague with cosimo "Ask the clerk at the next desk how his morning has been" when wears(actor, face_heron) and publicHours() once {
    Says "'Atrocious.' He does not look up from the register. 'The ferry. There is a person who rows it, a Gull, whose views on the Ferrymen's Twelfth I should call, in any other trade, an interpretation. I pay for myself. I pay for my umbrella, which she counts as a passenger, since it is open, which it is because it is raining.' He enters something. 'I have never in my life been charged for a thing that did not eat.' The pen pauses. 'I do not like her. I mention it only because you are a Heron, and a Heron will not repeat it.'".
    On discuss { Assert knows(actor, lc_ferry_quarrel). }
  }
  Topic lc_cos_customer with cosimo "Ask the clerk about the Standard" when masked(actor) and not wears(actor, face_heron) and publicHours() once {
    Says "He sees a mask that is not a Heron's and does what a clerk does; he stands. 'The Standard is in the Standard Room,' says {cosimo}. 'It has not been shown to the public since the Concord, which I regret, because it is quite beautiful. I am not permitted to say what it weighs.' He thinks. 'It weighs a pound. It is the only thing in Ombra that is exactly what it says.' He sits down again, looking, for a moment, as though he had said a great deal more than he had planned.".
  }
  // By night: bare, and received.
  Topic lc_cos_ink with cosimo "Ask what he is writing so late" when not masked(actor) and privateHours() and at(cosimo, lc_dray_room) and not lcCosOpen(party) once {
    Says "'Accounts.' It comes out at once, and he turns the page over, which is what a man does with accounts. 'The Weights are never done. A thing that is weighed is always about to be weighed again.' He looks at the tin box; not at you; at the tin box, as a clerk looks at a figure he does not wish to carry down. 'Forgive me. It is not a thing one says to a visitor. It is late.'".
  }
  Action lc_cos_wait(actor: group) "Sit with him while he writes, and say nothing, for an hour" {
    Speaker cosimo.
    Requires able(actor) and company(actor) and at(actor, lc_dray_room) and at(cosimo, lc_dray_room) and not masked(actor) and privateHours() and not lcCosWaited(party).
    Time 6.
    On success { Assert lcCosWaited(actor). Assert lcCosOpen(actor). Increase lcCourage(actor) by 1. }
    Result "He writes. You sit. It is a quiet hour, with the rain on the slates and the umbrella-makers across the Row not sleeping; a clerk's pen going down the page, and stopping, and going on. At the end of it he blots the sheet and does not put it away. 'I should like to say,' says {cosimo}, 'that nobody has sat in this room for an hour since my mother. It is the correct length. I had not known it. I thought a person would have wanted something.'".
  }
  Action lc_cos_read(actor: group) "Watch his hands, and work out what is in the box" {
    Speaker cosimo.
    Requires able(actor) and company(actor) and at(actor, lc_dray_room) and at(cosimo, lc_dray_room) and not masked(actor) and privateHours() and not lcCosOpen(party).
    Resolve check(actor, insight, dc_fair).
    Time 3.
    On success { Assert lcCosOpen(actor). Assert knows(actor, lc_heron_writes). }
    Result "You watch his hands, as you would a card-player's. At the quarter his left hand goes to the tin box and comes away; at the half, again. It is not a man hiding a thing: it is a man keeping a thing company. 'Eleven years,' you say. He does not drop the pen, which is a measure of how long he has been waiting to be asked. 'Twelve in the spring,' says {cosimo}.".
    Otherwise "His hands go to the box and come away, and you cannot tell what it means. He has noticed you looking. He turns the page over, and says, in a voice with a great deal of civility in it, that it is, in point of fact, accounts.".
  }
  Topic lc_cos_lamp with cosimo "Ask him about the Lamp" when lcCosOpen(party) and privateHours() and not masked(actor) once {
    Says "'I write to somebody.' He says it fast, to get past it. 'Eleven years. She is called the Lamp. I do not know who she is; I do not wish to; it would be, I think, a kind of trespass.' He takes a sheet from the tin box and does not read it; he says it. 'A lamp is a small argument against the dark, and I have never once seen it lose, only seen it tired.' He sets it down. 'I do not know what a person does with a sentence like that. I read it every night. I put it in the box.'".
    On discuss { Assert knows(actor, lc_heron_writes). }
  }
  Topic lc_cos_laugh with cosimo "Ask him what he knows of her" when lcCosOpen(party) and knows(actor, lc_heron_writes) and privateHours() and not masked(actor) once {
    Says "'She wrote once that she is told she laughs like a sheet being torn down the middle.' He almost smiles. 'It is the only description of a laugh I have ever believed. I have never heard it. I think of it when the figures will not come.' He folds the paper. 'It is ridiculous to be fond of a sound one has not heard. I am, I am afraid, a man who has been fond of a number of those.'".
    On discuss { Assert knows(actor, lc_laugh_clue). }
  }
  Topic lc_cos_fear_t with cosimo "Ask him what he is afraid she would think" when lcCosOpen(party) and knows(actor, lc_heron_writes) and privateHours() and not masked(actor) once {
    Says "'That I am a column.' He says it as a joke, and nobody laughs, himself least. 'I am a third clerk. I do not tip. I am told by a person I could name, but shall not, that I have the personality of a ledger. The Lamp thinks I am a man of leisure who keeps herons. I have not corrected her.' He lifts the pen. 'Is that deceit? I wrote her thirty pages about it, and she said no: nobody has ever lied by being surprised.' He smiles, at last. 'It was the kindest thing anyone has said to me.'".
    On discuss { Assert knows(actor, lc_cosimo_fear). }
  }
  Action lc_cos_help(actor: group) "Help him answer her last question: what would you do, if we met?" {
    Speaker cosimo.
    Requires able(actor) and company(actor) and at(actor, lc_dray_room) and at(cosimo, lc_dray_room) and lcCosOpen(party) and not masked(actor) and privateHours() and not lcSentences(party) and knows(actor, lc_heron_writes).
    Resolve check(actor, performance, dc_fair).
    Time 6.
    On success { Assert lcSentences(actor). Increase lcCourage(actor) by 1. }
    Result "You do not give him a sentence; you give him permission to write a bad one. He writes it, crosses it out, writes it again: 'If we met, I should be unable to say anything, and I should say it in your presence, which is an improvement on saying it in your absence, though a smaller one than I had hoped.' He reads it twice. 'It is true,' he says, surprised. 'I did not know it was true. I thought it was a clever thing.' He folds it into the box, and, for the first time in your hearing, does not lock it.".
    Otherwise "You offer him a line that is a good deal brighter than anything he has ever written; he gives it a long, kind look, and sets it aside. 'It is very well put,' says {cosimo}. 'It is not, I am afraid, a thing I should have said.'".
  }
  Action lc_cos_ask_hard(actor: group) "Ask whether he would meet her, if there were a form he could bear" {
    Speaker cosimo.
    Requires able(actor) and company(actor) and at(actor, lc_dray_room) and at(cosimo, lc_dray_room) and lcCosOpen(party) and not masked(actor) and privateHours() and not lcCosWilling(party) and not lcCosWaited(party) and knows(actor, lc_heron_writes).
    Resolve check(actor, persuasion, dc_hard).
    Time 3.
    On success { Assert lcCosWilling(actor). Increase lcCourage(actor) by 1. }
    Result "'A form.' He has the pen in the air again, and a second drop of ink arrives on the table. 'I should not meet her. It would be a trespass.' A silence. 'But there is the Swap, which the city has provided for it. A thing that is done because it is the Usage, and not because one has been brave. I have always thought that was what it was for.' He puts the pen down. 'If I were asked, as a matter of form, by someone who knew the Usage, to be at the landing at the Ninth Bell, I could not be blamed for it by the Lamp, nor by myself.'".
    Otherwise "'No,' says {cosimo}, with the courtesy of a man to whom it has been put as a question of courage, which is a question he has long since answered in the negative. 'But thank you for asking. It is not often that I am asked.'".
  }
  Topic lc_cos_form with cosimo "Say that the Swap might be a form he could bear" when lcCosOpen(party) and lcCosWaited(party) and knows(actor, lc_cosimo_fear) and knows(actor, lc_pair_rule) and not lcCosWilling(party) and not masked(actor) and privateHours() once {
    Says "'You sat for an hour,' he says. 'You did not ask me to be anyone.' He looks at the tin box. 'A form. The Swap is a form. A thing one does because it is the Usage; I could not be blamed for it, by the Lamp or myself. If it were put to me, by someone who knew the Usage: be at the landing at the Ninth Bell on the fifth day, and ask the first boat for her spare.' He breathes out. 'I should be there. I should be early. I am always early.'".
    On discuss { Assert lcCosWilling(actor). Increase lcCourage(actor) by 1. }
  }
  Action lc_cos_forge(actor: group) "Write him a letter in the Lamp's hand, saying she would be glad to meet" {
    Speaker cosimo.
    Requires able(actor) and company(actor) and at(actor, lc_dray_room) and at(cosimo, lc_dray_room) and lcCosOpen(party) and not masked(actor) and privateHours() and not lcForged(party) and not lcCosHurt(party) and knows(actor, lc_heron_writes).
    Resolve check(actor, deception, dc_fair).
    Time 6.
    On success { Assert lcForged(actor). Assert lcCosWilling(actor). Increase lcCourage(actor) by 2. }
    On failure { Assert lcCosHurt(actor). Decrease lcCourage(actor) by 1 or to nothing. }
    Result "You have heard the sentences, and you write in the round hand: three lines, which do not say that she would be glad, but are glad. He reads it by the candle, three times, with his lips. Then he gets up and goes to the window, and stands, with his back to you, looking at the umbrellas of the Row going by under the lamps. 'She has never,' he says, 'written to me so plainly.' It is, you think, a cruel thing; and he is happier than you have ever seen anyone.".
    Otherwise "He holds it to the candle. 'She has never in her life,' says {cosimo}, very gently, 'put a comma there.' He puts it in the stove. He does not say any more; he is a man who has been shown, with great precision, what he looks like to someone who is not a clerk.".
  }
  Action lc_cos_confess(actor: group) "Tell him the letter was yours" {
    Speaker cosimo.
    Requires able(actor) and company(actor) and at(actor, lc_dray_room) and at(cosimo, lc_dray_room) and lcForged(party) and not lcConfessed(party).
    Time 2.
    On success { Assert lcConfessed(actor). }
    Result "He is silent for a long time. 'I thought it was too good,' he says. 'I thought it was a thing she would say if she were someone else.' He turns the sheet over. 'I did not think it was a thing that she would say.' He begins, to your astonishment, to laugh, in a small hiccup, like a man opening a window in his chest. 'Forgive me. It is the first time anybody has ever tried to manage me. I find that I am flattered.'".
  }
  Topic lc_cos_tell with cosimo "Tell him who the Lamp is" when knows(actor, lc_pair_known) and not masked(actor) and privateHours() and lcCosOpen(party) and not lcTold(party) once {
    Says "He stands. The pen falls, and rolls. 'The ferry,' says {cosimo}, in a voice with nothing in it. 'The woman on the ferry who counts my umbrella.' He sits down again, very slowly, as one lowers a thing that has been dropped. 'And she knew it, every day. She wrote me on the Tuesday that she had met a clerk who was a column.' A long breath. 'Thank you,' he says. 'You will oblige me by leaving.' It has the sound of a thing that cannot be taken back.".
    On discuss { Assert lcTold(actor). Assert lcEstranged(actor). Increase heat(actor) by 1. Retract lcCosWilling(actor). }
  }
  // The night of the fifth day: he will be early.
  Action lc_cos_escort(actor: group) "Remind him of the Ninth Bell, and the form" {
    Speaker cosimo.
    Requires able(actor) and company(actor) and at(actor, lc_dray_room) and at(cosimo, lc_dray_room) and lcCosWilling(party) and not lcCosEscorted(party) and day(clock) == 5 and hour(clock) == 19 and knows(actor, lc_pair_rule) and not lcTold(party).
    Time 1.
    On success { Assert lcCosEscorted(actor). }
    Result "He is in his best cowl, as it turns out, and has been for an hour, and has a spare mask in a handkerchief, and a form of words written on a card. 'I shall go ahead,' says {cosimo}. 'One is early for the Usage.' At the door he stops. 'If it goes badly, you will not be able to say you were not warned. I wished to say it.' He goes down the stair as a man goes to an examination.".
  }
  Rule lc_cos_to_landing when lcCosEscorted(party) and day(clock) == 5 and hour(clock) >= 19 and not lcOutcome(party) and not at(cosimo, drip_landing) { Assert at(cosimo, drip_landing). }

  // ── Rill's side ───────────────────────────────────────────────────────────────────────────────────────────────────
  // She is declared in drip.kyr; what she says of the Heron, and of the Lamp, is said here.
  Topic lc_rill_cold with rill "Say good morning to the ferrywoman" when not masked(actor) and publicHours() once {
    Says "{rill} takes your coin without looking at your face. It is, you discover, the most courteous thing anyone has done for you since you came down the road: she is the only person in the Drip who has ever made not being looked at feel like manners. 'Fare's two,' she says, to the Cuff.".
  }
  Topic lc_rill_gull with rill "Ask the Gull at the oars about her morning" when wears(actor, face_gull) and publicHours() once {
    Says "'The Heron.' She does not look round. 'There's a Heron gets in at eight sharp and counts his coin like it was going to leave him. Two for himself, and the umbrella's a passenger by the Twelfth, open, as it is when it is raining, which is nine days in ten.' She spits over the side, neatly. 'Never a farthing over. Never a thank you. Fine hands, though. Handles a coin as if it had feelings.' A stroke. 'I don't like him. I mention it because you are a Gull, and a Gull'll not repeat it.'".
    On discuss { Assert knows(actor, lc_ferry_quarrel). }
  }
  Topic lc_rill_fare with rill "Ask the ferrywoman what the fare is" when masked(actor) and not wears(actor, face_gull) and publicHours() once {
    Says "'Two,' says {rill}. 'Two for you, and two for the umbrella, if it's open, which it is.' She looks at the sky as if it had been sent to her for her sins. 'It's the Usage. I didn't write it. I only follow it. There's a man comes aboard of a morning who makes me feel I did.'".
  }
  // By night, bare: she is a woman with a lantern and a pencil.
  Topic lc_rill_door with rill "Ask what she is writing by the lantern" when not masked(actor) and privateHours() and not lcRillOpen(party) once {
    Says "'Lines.' She covers the scrap with the flat of her arm, as she would cover a tally. 'Rope-lines. Fare-lines. A ferrywoman has accounts.' The lantern swings; on the scrap under her arm, in pencil, in a hand that is not so much bad as furious, there are words, and not numbers. 'You are not,' she says, without turning, 'to ask what.'".
  }
  Topic lc_rill_leave with rill "Tell her she may send you away whenever she likes" when not masked(actor) and privateHours() and not lcRillMayRefuse(party) once {
    Says "'Send you off.' She looks at you properly for the first time, with a long look from under the rim of her hat. 'Nobody says that. They say stay, or they say go, or they say what a night. They don't say I may.' She puts the pencil down. 'I'll tell you if I want you off.' It is, you gather, the most generous thing she has said all week.".
    On discuss { Assert lcRillMayRefuse(actor). Increase lcThaw(actor) by 1. }
  }
  Action lc_rill_sit(actor: group, site: place) "Sit in the stern while she writes by the lantern, and say nothing, for an hour" {
    Speaker rill.
    Requires able(actor) and company(actor) and at(actor, site) and at(rill, site) and not masked(actor) and privateHours() and not lcRillOpen(party) and lcRillMayRefuse(party).
    Time 6.
    On success { Assert lcRillOpen(actor). Increase lcThaw(actor) by 1. }
    Result "She writes, and swears, and rubs out. A lantern, a pencil, a ferry-boat nodding on the black Cuff, a woman with her tongue between her teeth: it is a long hour and a good one. At the end of it she looks at the scrap, and folds it in four, and puts it in her shirt. 'You didn't offer me anything,' says {rill}. 'You didn't ask if I wanted it done better.' She takes the hat off, for the first time, and her hair is grey at the temples and quite wet. 'It's more than most.'".
  }
  Action lc_rill_read(actor: group, site: place) "Watch how she holds the pencil" {
    Speaker rill.
    Requires able(actor) and company(actor) and at(actor, site) and at(rill, site) and not masked(actor) and privateHours() and not lcRillOpen(party) and lcRillMayRefuse(party).
    Resolve check(actor, insight, dc_fair).
    Time 3.
    On success { Assert lcRillOpen(actor). Assert knows(actor, lc_lamp_writes). }
    Result "She holds it as she would an oar, with the whole fist, and writes from the shoulder, as a person writes who was taught to do something else. It is not shame: it is a different fear, the fear of a good hand in a bad one. 'It's for the Crow,' you say; and she goes still, and then not still. 'She puts them right,' says {rill}. 'Every Tuesday. Eleven years.'".
    Otherwise "She sees you looking at her hand, and closes it. 'I have been a ferrywoman since I was nine,' she says. 'It's not the pencil that's wrong.'".
  }
  Topic lc_rill_lamp with rill "Ask her who the lines are for" when lcRillOpen(party) and not masked(actor) and privateHours() once {
    Says "'There's a man I write to.' It comes out at the speed of a thing that has been held a long while. 'He thinks I light lamps. I let him. It's the first time in my life anybody's thought I was a thing that made light. His come in the Crow's hand, because his own is nothing, he says, though I doubt it.' She holds up the scrap. 'We've never met. We never will. A person can't be as good as the sentences. It's not fair on the person.'".
    On discuss { Assert knows(actor, lc_lamp_writes). }
  }
  Topic lc_rill_sheet with rill "Ask her what he knows of her" when lcRillOpen(party) and knows(actor, lc_lamp_writes) and not masked(actor) and privateHours() once {
    Says "'That I laugh like a sheet being torn down the middle.' A flicker of the real thing at the corner of her mouth. 'I told him so in a letter. It's the only thing in them that's quite true. I thought: if he ever heard it, he'd know.' She looks at the water. 'Know what, I don't know. That I was there, I suppose. That it was me, and not the Crow.'".
    On discuss { Assert knows(actor, lc_laugh_clue). }
  }
  Topic lc_rill_fear_t with rill "Ask her why she thinks it would not be fair" when lcRillOpen(party) and knows(actor, lc_lamp_writes) and not masked(actor) and privateHours() once {
    Says "'The words aren't mine.' She gets it out quite flat. '{lamb} sets them down. When I say a thing it comes out like a wet rope; when it comes back in his letters it's,' she searches, 'it's like what I meant. I think she has made me up. And he's in love with the one she made.' She scrapes the pencil on the thwart. 'I don't mind her. I mind that when he meets me he'll be meeting the rope.'".
    On discuss { Assert knows(actor, lc_rill_fear). }
  }
  Action lc_rill_author(actor: group, site: place) "Tell her the sentences were hers, and Lyle only set them down" {
    Speaker rill.
    Requires able(actor) and company(actor) and at(actor, site) and at(rill, site) and knows(actor, lc_rill_fear) and not masked(actor) and privateHours() and not lcRillFear(party).
    Resolve check(actor, persuasion, dc_hard).
    Time 3.
    On success { Assert lcRillFear(actor). Increase lcThaw(actor) by 2. }
    Result "You say it as you would a weight: that the sentence about the lamp was hers; that a Crow sets down what is said, and no more; that it is the first rule of her trade, and {lamb} has kept it for thirty years. She says nothing. Then she says, 'Say that again.' You do. She laughs: a short dreadful sound, the sound of a sheet going from top to bottom: and wipes her face with the back of her wrist. 'That's not evidence,' says {rill}. 'That's a thing somebody ought to have said years ago.'".
    Otherwise "'A Crow's a Crow,' says {rill}. 'She's a clever woman, {lamb}. I'm not.' She picks up the pencil. 'It's a kind thing, to say. I'll thank you not to say it twice.'".
  }
  Action lc_rill_custom(actor: group, site: place) "Remind her what a Pair is, and what the ferryman's Pair is" {
    Speaker rill.
    Requires able(actor) and company(actor) and at(actor, site) and at(rill, site) and knows(actor, lc_pair_rule) and lcRillOpen(party) and not masked(actor) and privateHours() and not lcSwapPrimed(party).
    Resolve check(actor, lore, dc_fair).
    Time 3.
    On success { Assert lcSwapPrimed(actor). Increase lcThaw(actor) by 1. }
    Result "'The Pair's Courtesy,' says {rill}, slowly. 'My mother used to say it. Nine strokes.' She looks at her hands on the oars as if they had said it. 'A ferryman's Pair is the first fare who steps in. I've never been anybody's. I've always had a queue.' She takes up the lantern, and sets it in the bow, where a Witness would hold it. 'Well,' she says. 'If it's the Usage. A person can't refuse the Usage.'".
    Otherwise "'That's a dead custom,' says {rill}, as to a child who has told her the moon is a cheese. 'Nobody does the strokes. They just cross.' She is, you gather, quite sure.".
  }
  Relation lcSwapPrimed(group).
  Topic lc_rill_tell with rill "Tell her who the Heron is" when knows(actor, lc_pair_known) and not masked(actor) and privateHours() and lcRillOpen(party) and not lcTold(party) once {
    Says "She does not move. The lantern goes on swinging. 'The Heron.' She says it as one repeats a figure to see if it is the right one. 'The Heron is the man with the umbrella.' She laughs, short, and it is nothing like the sheet. 'Eleven years I've been writing to him about the lamp, and I've been taking his coppers for it.' She takes up the oar, and does not use it. 'You'll oblige me by getting off my boat.'".
    On discuss { Assert lcTold(actor). Assert lcEstranged(actor). Increase heat(actor) by 1. }
  }

  // ── Ferris Moll knows the Swap as a form ──────────────────────────────────────────────────────────────────────────
  Topic lc_moll_swap with moll "Ask Ferris Moll what the Swap is" when true once {
    Says "'The Swap is a form.' He says it with relief, as a man does who has been asked a thing that has a procedure. 'There is a Usage. Spares are lodged at the Annex, the plain tallow ones, for a penny, that are not a trade's and not an Office's. At the Ninth Bell on the fifth day each citizen puts one on, and exchanges it with the first stranger who asks. The two are a Pair; they cross the Cuff in one boat, nine strokes, a sentence of one's own for each.' He looks at the pegs. 'At the ninth the Witness may lower the lantern or hold it, and the Pair may lift. Nobody does the strokes any more. Everyone should.'".
    On discuss { Assert knows(actor, lc_pair_rule). Assert knows(actor, lc_swap_hint). }
  }

  // ══ THE SWAP ═════════════════════════════════════════════════════════════════════════════════════════════════════════
  // The fifth night. At the Ninth Bell the city puts on a second face: a plain tallow mask from the Annex, lettered
  // inside the brow by its owner, and gives it to the first stranger who asks. The two are a Pair. They cross the Cuff in
  // one boat, nine strokes, a sentence of their own for each; and at the ninth the Witness, who holds the lantern and says
  // nothing, may hold it up or let it down, and the Pair may lift. It is how the city has always found out who it has been
  // talking to, and the reason, they say, that so many of Ombra's children are born in the autumn.
  Observe lc_swap_landing at drip_landing when swapNight() "The Ninth Bell has gone, and the whole Drip has put on its second face. The Cuff is full of boats. Every one has a lantern in the bow and two plain masks in it, the colour of tallow, hand-lettered inside the brow; every one is rowing, nine strokes, to the sound of two people whispering, so that from boat to boat across the black water, in every voice of the city, come the sentences: nobody's, anybody's. I have never liked the sound of the sluice. The fog has a face and it is mine. A woman is laughing at the end of the pier. A man is crying in a boat, quietly, with great dignity, as in a pew. For the length of the Cuff, everyone is somebody's Pair.".
  Observe lc_swap_masked at drip_landing when swapNight() and masked(party) "A girl in a tallow mask comes up the steps with her spare held out in both hands, like a loaf. 'Pair?' she says, and is gone, because somebody else has said it first, and she has gone off in the boat with him as if she had been fired from a gun.".
  Observe lc_swap_bare at drip_landing when swapNight() and not masked(party) "Nobody offers you a spare. It is not, you understand, that a Bare is barred; it is that you are not on the list, being no one's stranger. The Usage has a place for you all the same. A Pair needs a Witness, to hold the lantern, who may be anyone who asks; and it has long been held that the best Witness is the one who has no side.".
  Observe lc_swap_quay at row_quay when swapNight() "Over on the Row side the quay is hung with paper lamps, and the strangers wait on the steps with their spares in their hands, like new bread, looking at one another with great politeness, as at a party where nobody has been introduced and everyone has agreed to be.".
  Rule lc_swap_stage when swapNight() and lcCosEscorted(party) and not lcPaired(party) and not lcOutcome(party) and not at(rill, drip_landing) { Assert at(rill, drip_landing). }
  Rule lc_swap_default_told at drip_landing when swapNight() and hour(clock) >= 22 and not lcPaired(party) and not lcCosEscorted(party) and not lcSwapPassed(party) once says "Out on the Cuff, in the dark, a ferrywoman in a stranger's spare is rowing a man she does not know across the water, and, half a mile away, a clerk in a stranger's spare is being rowed by a man he does not know. The two boats pass within a length of each other, lantern to lantern, in the fog; and in the one a woman says a sentence, and in the other a man; and neither is heard. By the morning each will have crossed the Cuff once, in the Usage, and each will have been, as the Usage requires, somebody's Pair." { }
  Rule lc_swap_default when swapNight() and hour(clock) >= 22 and not lcPaired(party) and not lcCosEscorted(party) and not lcSwapPassed(party) { Assert lcSwapPassed(party). }
  Relation lcSwapPassed(group). Relation lcCastOff(group). Relation lcMiddle(group). Relation lcSteady(group). Relation lcCuffRead(group). Relation lcOutcome(group).
  Query lcFine() means lcPrep() and not lcSour().
  Query lcWarm() means lcPrepHigh() and not lcSour().
  Action lc_pair_them(actor: group) "Hold the lantern, and ask the Ferrywoman's first fare to step aboard" {
    Speaker rill.
    Requires able(actor) and company(actor) and at(actor, drip_landing) and at(rill, drip_landing) and at(cosimo, drip_landing) and swapNight() and lcCosEscorted(party) and knows(actor, lc_pair_rule) and not lcPaired(party) and not lcOutcome(party).
    Time 2.
    On success { Assert lcPaired(actor). }
    Result "He is already there, of course: in a tallow mask with his own initial, a C, in the brow, a clerk who has been early for the Usage since the Ninth Bell, with a card in his hand. He reads from it. 'By the Ferrymen's Usage,' says the clerk, in the whisper that the Swap allows, 'a ferrywoman's Pair is whoever steps into the boat first and asks for her spare.' He steps into the boat. He holds out his hand. 'May I have your spare, ma'am?' A silence on the landing; and the Gull in the stern, in a mask that is a Gull's no longer, but a tallow face with a lamp-black smear across the brow, puts it into his hand without a word, and takes his. She has no idea who he is. He has no idea who she is: in the tallow, a ferrywoman is any stranger, and a clerk any clerk, and it is dark. You take the lantern. Nobody in the boat asks you to say anything, and you do not.".
  }

  // The crossing: three beats; the Witness may help it, and must choose at the end.
  Observe lc_cuff_scene at lc_cuff when true "The Cuff at night, in the Swap: black water lapping at a boat that is a yard too short, and out beyond the bow the lanterns of a hundred other Pairs, each a small gold coin on the dark, going over and coming back. In the stern a clerk in a plain mask sits very upright, with a folded umbrella across his knees. At the oars, with her back to the way she is going, a woman in another, with a smear of lamp-black on her brow, rows, and counts, under her breath, as a ferryman does. You are in the bow, with the lantern, and no part in it.".
  Action lc_cuff_cast_off(actor: group) "Hold the lantern high, and say nothing, while she rows" {
    Requires able(actor) and company(actor) and at(actor, lc_cuff) and lcPaired(party) and not lcCastOff(party) and not lcOutcome(party).
    Time 3.
    On success { Assert lcCastOff(actor). }
    Result "One. 'The rain has no opinion of anyone,' says the clerk, in a whisper that is nearly his own. Two. 'Then it is the only thing on the Cuff that has none,' says the Gull, a stroke later. Three: a silence. Four. 'I was once told,' says the clerk, and stops, and tries again. 'I should like to say a thing of my own, and find that they are all, in the end, somebody else's.' The oars go in. 'Then say it,' says the woman at the oars, 'and be somebody else's. It's not as bad as it sounds.'".
  }
  Action lc_cuff_steady(actor: group) "Steer the lantern, and the boat, between the other Pairs' lights" {
    Requires able(actor) and company(actor) and at(actor, lc_cuff) and lcCastOff(party) and not lcMiddle(party) and not lcSteady(party).
    Resolve check(actor, wayfinding, dc_fair).
    Time 1.
    On success { Assert lcSteady(actor). Increase lcBlessing(actor) by 1. }
    Result "You read the Cuff as you would a street at night, by its lights: a Pair to starboard going slow, a Pair to port going fast, a long black gap where the Row ferry cuts across. A word to the oarswoman is not allowed, so you move the lantern, a hand's breadth, and she, who has been rowing the Cuff since she was nine, understands it like her own name. The boat goes through the lanterns as through a needle, and the two in it, who have been listening for nothing but one another, do not notice that it was done.".
    Otherwise "You hold the lantern where you hold it, and the boat comes rather close to a Pair going the other way, and a stranger in a tallow mask says 'oh' in an offended whisper, and the clerk says, quite unnecessarily, 'I beg your pardon.' The oarswoman, without a pause, says something to the Cuff about people who cannot hold a lantern that you will not afterwards remember.".
  }
  Action lc_cuff_read(actor: group) "Watch the two of them, and judge whether they would rather be seen" {
    Requires able(actor) and company(actor) and at(actor, lc_cuff) and lcCastOff(party) and not lcCuffRead(party) and not lcLifted(party).
    Resolve check(actor, insight, dc_fair).
    Time 1.
    On success { Assert lcCuffRead(actor). Assert knows(actor, lc_swap_hint). }
    Result "You watch what a Witness is for. His hands on his knees; her back, on the oar; the rate at which the two of them are not looking at one another. It is, you think, a thing you can learn by looking: whether two people are afraid of being seen, or of not being.".
    Otherwise "You look at the two of them, who are looking at the Cuff, and nothing at all is told you. It is a good deal like looking at a pair of stones.".
  }
  Action lc_cuff_middle(actor: group) "Count the middle strokes" {
    Requires able(actor) and company(actor) and at(actor, lc_cuff) and lcCastOff(party) and not lcMiddle(party) and not lcOutcome(party).
    Time 3.
    On success { Assert lcMiddle(actor). }
    Result "Five, six, seven, eight. Not a word is said by you; and they say, between them, a good deal. It is not the sort of conversation that has a shape, only the sort that grows one: a sentence, and a longer silence, and another sentence in answer, as two people come down opposite sides of a hill and find, near the bottom, that they have been walking to the same stream.".
  }
  Observe lc_cuff_warm at lc_cuff when lcMiddle(party) and not lcLifted(party) and lcWarm() "'A lamp is a small argument against the dark,' says the woman at the oars, in the whisper, to the black water ahead of her, 'and I have never seen it lose.' There is a stroke's silence. 'Only seen it tired,' says the clerk, very low, from the stern; and the oars stop. They have been, you see, quoting; and neither has noticed that what is being quoted came out of the other's letters. You do not move the lantern. You do not breathe.".
  Observe lc_cuff_mid at lc_cuff when lcMiddle(party) and not lcLifted(party) and lcFine() and not lcWarm() "The sentences are getting better, and each is more cautious than the last. 'I have been told,' says the clerk, 'that I have the personality of a column.' 'I have been told,' says the woman at the oars, 'that I laugh like a sheet being torn down the middle.' They have both stopped, as people do who have said a thing that a stranger could not know to say; and neither pursues it. The oars go on.".
  Observe lc_cuff_cold at lc_cuff when lcMiddle(party) and not lcLifted(party) and not lcFine() "The sentences go back and forth, and are all politer than the people. 'It is a fine night,' says the clerk, and hears it. 'It is wet,' says the oarswoman, which is also a Usage: and neither of them can bring a sentence of their own to the surface of the boat. They row on in a decent, dreadful silence, as two people who do not wish to have been paired go across a river.".
  Observe lc_cuff_hint_warm at lc_cuff when lcCuffRead(party) and lcMiddle(party) and not lcLifted(party) and lcWarm() "They want, you judge, to be seen. His hands are quite still; her stroke is easy. They would, you think, rather have a lantern than not.".
  Observe lc_cuff_hint_mid at lc_cuff when lcCuffRead(party) and lcMiddle(party) and not lcLifted(party) and lcFine() and not lcWarm() "They are afraid, a little, of being seen, and a great deal more of not being; you judge that the light would be a risk, and the dark a mercy that could go either way.".
  Observe lc_cuff_hint_cold at lc_cuff when lcCuffRead(party) and lcMiddle(party) and not lcLifted(party) and not lcFine() "They are not ready; the one is afraid of the other, and does not know why. The dark would be kinder. The dark is, in any case, what the Usage is for.".
  Action lc_lower_lantern(actor: group) "At the ninth stroke, lower the lantern: let the Pair lift in the dark" {
    Requires able(actor) and company(actor) and at(actor, lc_cuff) and lcMiddle(party) and not lcLifted(party).
    Grave "A Pair that lifts in the dark has not been seen; and a Pair that lifts in the light cannot unsee.".
    Time 1.
    On success { Assert lcLanternLow(actor). Assert lcLifted(actor). }
    Result "Nine. You lower the lantern, as the Witness may, into the well of the bow, and the Cuff goes black round the boat; only the other Pairs' lights, far off, like a street seen from the wrong end. The oars lie in the water. Nobody speaks. A rustle: the whisper of a tallow mask coming away from a face.".
  }
  Action lc_raise_lantern(actor: group) "At the ninth stroke, hold the lantern high: let the Pair lift in the light" {
    Requires able(actor) and company(actor) and at(actor, lc_cuff) and lcMiddle(party) and not lcLifted(party).
    Grave "A Pair that lifts in the light cannot unsee.".
    Time 1.
    On success { Assert lcLanternHigh(actor). Assert lcLifted(actor). }
    Result "Nine. You hold the lantern up at arm's length, as the Witness may, and the gold falls across the boat from the bow, on two plain masks, a yard apart, on a clerk's folded umbrella, on an oarswoman's cracked hands. For a moment nothing moves. Then, together, as if they had been told, they lift.".
  }
  Rule lc_out_dark_together when lcLanternLow(party) and not lcOutcome(party) and lcFine() says "Nobody says anything for a long time. Then he says, in the whisper the Usage allows, 'You said once that you were told you laugh like a sheet being torn down the middle.' A stroke of silence. 'I have never heard it,' says the man in the stern. 'I should like to.' And in the dark, from the oars, a woman starts to laugh: a short, dreadful, torn sound, a sheet going from top to bottom; and she cannot stop; and neither, when he has understood what he is hearing and what he has said, can he. They sit in the dark of the Cuff in each other's spares, a clerk and a ferrywoman, in a boat that is going nowhere, laughing like two people who have found that the thing they feared is also the thing they hoped. When you raise the lantern, as the Usage allows, it is only the two of them, with their masks in their laps, and an umbrella that is dripping on the thwarts. 'An umbrella with two under it,' says {rill}, wiping her eyes, 'is one fare.'" { Assert lcOutcome(party). Assert lcByLaugh(party). Assert loversMet(party). Assert loversRevealed(party). Assert loversTogether(party). }
  Rule lc_out_dark_unmet when lcLanternLow(party) and not lcOutcome(party) and not lcFine() says "In the dark two strangers in plain masks sit a yard apart, and each, by the Usage, lifts; and feels, with the back of a wrist, a face, which is only a face. Nothing is found, which is what the Concord designed it to find. 'Thank you,' says a man, to a woman he does not know. 'It was a good crossing.' 'It's the best we've had,' says the ferrywoman, who has had a very great number. They part on the landing as the lanterns come up, each to a stranger's face, each carrying home, to a tin box or a lantern, what the other said, and not who." { Assert lcOutcome(party). Assert lcMetDark(party). Assert loversMet(party). }
  Rule lc_out_light_together when lcLanternHigh(party) and not lcOutcome(party) and lcWarm() says "Under the first mask is {cosimo}; under the second is {rill}; and the Heron and the Gull of the eight o'clock ferry look at one another across a yard of lantern-light with the faces they know best in the city. 'You,' says Rill. 'You,' says Cosimo. A held, long silence, in which the Cuff goes on lapping the boat. 'The umbrella,' says Rill, at last, very low. 'It is open,' says Cosimo, faintly. 'It's raining.' And she begins, by degrees, to laugh, the short torn sound of a sheet going; and he has heard it described, and knows it; and says 'oh,' as a man does who has put his foot on a stair that is, after all, there. 'By the Twelfth,' says {rill}, wiping her eyes, 'an umbrella with two under it is one fare.'" { Assert lcOutcome(party). Assert loversMet(party). Assert loversRevealed(party). Assert loversTogether(party). }
  Rule lc_out_light_civil when lcLanternHigh(party) and not lcOutcome(party) and lcPrep() and not lcWarm() and not lcTold(party) and not lcEstranged(party) says "They look at each other for as long as it takes to count nine, and a man's face and a woman's, in the light of one lantern, go through something it would be unkind to describe: dismay; recognition; a kind of exhausted tenderness, like that of two people who have been introduced at last at a funeral. 'Well,' says {cosimo}. 'That is a thing.' 'It is,' says {rill}. 'I do not think I could bear to be disappointed in you,' says the clerk. 'Nor me,' says the ferrywoman. 'Then let us not be,' says the clerk, 'on the ferry. We shall quarrel as before. I propose it as a matter of form.' 'And write.' 'And write.' 'I'll have the fare out of you for the umbrella,' says the Lamp, 'mind.'" { Assert lcOutcome(party). Assert lcCivil(party). Assert loversMet(party). Assert loversRevealed(party). }
  Rule lc_out_light_cold when lcLanternHigh(party) and not lcOutcome(party) and not lcWarm() and not (lcPrep() and not lcTold(party) and not lcEstranged(party)) says "'You.' 'You.' It is a bad thing to say, in the light, with the masks off; the words have been said every morning for eleven years in another sense. 'Eleven years,' says {rill}, 'and I have been writing to a man who counts out the coppers.' 'And I,' says {cosimo}, white, 'to a woman who charges for an umbrella.' It goes from there. It goes to the leak, and the tip, and by the ninth stroke the lantern in your hand is the only thing in the boat that has not been shouted at. She rows the last yards with her back to him. At the landing he takes his spare off and drops it in the water; and she does not look to see where it went." { Assert lcOutcome(party). Assert lcEstranged(party). Assert loversMet(party). Assert loversRevealed(party). }
  Rule lc_round_lovers when lcOutcome(party) and not roundDone(party, r_lovers) { Assert roundDone(party, r_lovers). }
  Rule lc_cuff_ashore when lcOutcome(party) and at(party, lc_cuff) { Assert at(party, drip_landing). Assert at(rill, drip_landing). Assert at(cosimo, drip_landing). }

  // ── The morning after ─────────────────────────────────────────────────────────────────────────────────────────────
  Topic lc_cos_after_together with cosimo "Ask the Heron how the crossing was" when lcOutcome(party) and loversTogether(party) and day(clock) >= 6 and (masked(actor) or privateHours()) once {
    Says "'I have been trying,' says {cosimo}, 'to enter it.' He shows you a page: a column, ruled, and under it a line that says only, in his best hand, Debit: nothing. Credit: all. He has crossed out all, and written everything, and crossed it out, and written a word that is not accountancy. 'It does not balance,' he says. He is, you can see through the Heron's cowl, entirely happy. 'I have never been so glad of an error.'".
  }
  Topic lc_cos_after_civil with cosimo "Ask the Heron how the crossing was" when lcOutcome(party) and lcCivil(party) and day(clock) >= 6 and (masked(actor) or privateHours()) once {
    Says "'It was,' says {cosimo}, carefully, 'a very good crossing.' He enters nothing. 'I have decided to say so only to you. We have agreed, she and I, to go on exactly as before; it is the only way to keep it from being any worse.' A slight smile. 'She does not write the way she talks. Nor I. I find, rather to my surprise, that this is the better arrangement: two persons, and a third who is better than either, who is the letters.'".
  }
  Topic lc_cos_after_estranged with cosimo "Ask the Heron how he is" when lcEstranged(party) and masked(actor) and publicHours() once {
    Says "'I am a column,' says {cosimo}, to the page. 'It has been put to me, and I find it is borne out.' He does not look up. 'I have not written to the Lamp. I have not been written to. A person who is told what a person is, by a person, is not, I think, obliged to reply.' A long silence. 'I should be glad, if you do not mind, to be left to my figures.'".
  }
  Topic lc_rill_after_together with rill "Ask the ferrywoman how the crossing was" when lcOutcome(party) and loversTogether(party) and day(clock) >= 6 and (masked(actor) or privateHours()) once {
    Says "'It was the Usage.' She does not look round; the oars go in, twice, harder than they need to. 'I'll not say more than that. I'll say this: I had thought the sentences were Hester's.' A stroke. 'They weren't.' Another. 'Nor were his.' A third, and she laughs, the sheet, short, at the Cuff, which has not been laughed at before. 'He tipped me,' says {rill}, with deep suspicion, 'a penny. For the umbrella.'".
  }
  Topic lc_rill_after_civil with rill "Ask the ferrywoman how the crossing was" when lcOutcome(party) and lcCivil(party) and day(clock) >= 6 and (masked(actor) or privateHours()) once {
    Says "'We've agreed,' says {rill}, 'to go on as before.' She shifts the oar. 'He's still a man who counts out his coppers. I'm still a woman who'll charge for an umbrella. It's more or less what I'd have wanted.' She does not say any more. After a while she says, to the water, 'He's got a nice way of being annoyed.'".
  }
  Topic lc_rill_after_estranged with rill "Ask the ferrywoman how she is" when lcEstranged(party) and masked(actor) and publicHours() once {
    Says "'Don't.' She does not turn her head. 'I've rowed this boat since I was nine. I know what's under it. I did not know,' a stroke, 'that I could be told what I was by a man who has never in his life asked.' She says nothing for a stroke or two. 'I'll thank you to take your coin to the other end of the landing.'".
  }
  Topic lc_lamb_after_together with lamb "Ask Hester Lyle whether she has had a letter" when lcOutcome(party) and loversTogether(party) and day(clock) >= 6 and (masked(actor) or privateHours()) once {
    Says "'Neither,' says {lamb}. She has a face that was made for sparing. 'Neither has sent me a letter. They have written one another nothing since the Swap, I am told, not a line; I believe they find they have nothing to say that is not better said on the ferry.' She puts the stone on the empty baskets. 'It is the most disastrous thing that has ever happened to my trade,' says the Crow, 'and I have not been so pleased in thirty years.'".
  }
  Topic lc_lamb_after_other with lamb "Ask Hester Lyle whether she has had a letter" when lcOutcome(party) and not loversTogether(party) and not lcEstranged(party) and day(clock) >= 6 and (masked(actor) or privateHours()) once {
    Says "'Both,' says {lamb}. 'The one on Tuesday and the other on Thursday. Neither says a word of it. Neither is a worse letter than before.' She sets the stone on them, as one puts a hand on a head. 'It appears that a person can be a column and a rope in the daytime and still be a Heron and a Lamp by the post. I had not known it was allowed. It is an odd thing to be wrong about, at my age.'".
  }
  Topic lc_lamb_after_estranged with lamb "Ask Hester Lyle whether she has had a letter" when lcEstranged(party) and day(clock) >= 2 and (masked(actor) or privateHours()) once {
    Says "'No,' says {lamb}. She is quite white. 'Neither of them. It is, I think, the first time in eleven years that both baskets have been empty on a Thursday.' She looks at you, and does not accuse you of anything, which is worse. 'I told you what they would find on the ferry. I did not say that I wished to be wrong.'".
  }

  // ══ What became of them ══════════════════════════════════════════════════════════════════════════════════════════════
  Milestone lc_ms_lovers "The Heron and the Lamp" worth 50 when lcOutcome(party).
  Milestone lc_ms_together "Two sentences, one boat" worth 25 when loversTogether(party).
  Milestone lc_ms_hands "The Book of Hands" worth 50 when lcLedgerSafe(party).
  Milestone lc_ms_row "Peace on Umbrella Row" worth 50 when lcMerged(party) or lcWedded(party) or lcPatentO(party) or lcPatentP(party) or lcQuiet(party) or lcBound(party).
  Milestone lc_ms_row_whole "One umbrella, two shops" worth 25 when lcMerged(party) or lcWedded(party).
  Milestone lc_ms_sweet "A face, or a slate" worth 50 when lcSweetBack(party) or lcSweetNew(party) or lcSweetSlate(party).

  // ── Cosimo ────────────────────────────────────────────────────────────────────────────────────────────────────────
  Rule lc_fate_cosimo_laugh when newsHour() and loversTogether(party) and lcByLaugh(party) once says "Of Cosimo Dray: he was married in the spring, by the Chaplain, in a Heron's cowl that he removed at the door of the Chapel as the Concord allows. His wife, who rows the Row ferry, took the oars the next morning. He pays two, and she charges two, for one umbrella and two persons: it is, they say on the Row, the only fare in Ombra that was ever settled by a laugh. He has entered the sound of it, once, in the Hall's margin, in a column that has no heading. Nobody has been able to make the figure balance." { }
  Rule lc_fate_cosimo_light when newsHour() and loversTogether(party) and not lcByLaugh(party) once says "Of Cosimo Dray: he has not entered the crossing in any book. He keeps the tin box on the table with the lock turned for the first time, for it is empty, and he takes a Penhallow's umbrella to the ferry every morning, and holds it, by the Twelfth, over two. The Hall's Standard Room has a clerk who now says, of the third desk, that it is the only one in the building that is more than it weighs." { }
  Rule lc_fate_cosimo_civil when newsHour() and lcCivil(party) once says "Of Cosimo Dray: he quarrels with the ferrywoman at eight and at six about whether an open umbrella is a passenger, and loses, and pays. At night in his room he writes to the Lamp that he is a better man by post. She writes him that he is no such thing, and that she will have the fare. He considers it, on the whole, the best arrangement of his life, and has been heard to say so, once, to a Heron who will not repeat it." { }
  Rule lc_fate_cosimo_dark when newsHour() and lcMetDark(party) once says "Of Cosimo Dray: he crossed the Cuff in the Swap with a stranger who said the best thing he has ever heard anyone say in a boat, and never knew who. He thinks of it at night. He writes to the Lamp that he met a person, once, a little like her. She writes back that she, too, once crossed with a man whose sentences were a little like his. Neither says what is plain to the Crow in the arcade, who sets both letters down, and says nothing." { }
  Rule lc_fate_cosimo_estranged when newsHour() and lcEstranged(party) once says "Of Cosimo Dray: he rides the ferry with his umbrella furled, and pays a fare that is not asked, and has stopped writing. He is a very good third clerk, and is spoken of at the Hall as a man who has found his figures at last. The tin box is under the bed. It is locked." { }
  Rule lc_fate_cosimo_unmet when newsHour() and not lcOutcome(party) and not lcEstranged(party) once says "Of Cosimo Dray: he went to the Row quay on the Swap with a spare in his handkerchief, and gave it to a stranger who was kind, and crossed, and came home, and entered nothing. He writes to the Lamp on Thursday. He does not know that on the eight o'clock ferry he is paying her fare. It is, the Crow in the arcade has decided, still a great deal." { }

  // ── Rill ──────────────────────────────────────────────────────────────────────────────────────────────────────────
  Rule lc_fate_rill_together when newsHour() and loversTogether(party) once says "Of Rill Ketch: she dictates no more letters. She says what she has to say to a clerk in a Heron's cowl, in the boat, on the Cuff, and he says what he has to say to her, and neither has needed a Crow since. She laughs, now, in public. The Cuff, which has been listening for years for the sound of a sheet being torn, is said to have grown fond of it." { }
  Rule lc_fate_rill_civil when newsHour() and lcCivil(party) once says "Of Rill Ketch: she charges the Heron for his umbrella every morning, and he pays. She writes him on Tuesdays, in the Crow's hand, in a style she has begun to claim, in the face of all the evidence, as her own. She has a good deal of the evidence. She is, the Drip says, perfectly insufferable about it." { }
  Rule lc_fate_rill_dark when newsHour() and lcMetDark(party) once says "Of Rill Ketch: she rowed a stranger across the Cuff in the Swap, and has told nobody what he said. She writes to the Heron that she met a man, once, a little like him; she signs it with a lamp. She has not changed her fare." { }
  Rule lc_fate_rill_estranged when newsHour() and lcEstranged(party) once says "Of Rill Ketch: she goes on rowing the Row ferry. She goes on taking his coin, which is the fare, and not a farthing over, and does not look at his hands. The lantern in the stern burns every night; she does not write by it." { }
  Rule lc_fate_rill_unmet when newsHour() and not lcOutcome(party) and not lcEstranged(party) once says "Of Rill Ketch: she crossed the Swap as the Usage requires, in a stranger's spare, and gave it back to the stranger, and has gone on. She writes by the lantern on Tuesdays. She tells the Crow what to say, and the Crow puts it right. Every morning at eight a clerk with an umbrella pays her his fare, and every morning she says four." { }

  // ── Hester Lyle ───────────────────────────────────────────────────────────────────────────────────────────────────
  Rule lc_fate_lamb_gone_half when newsHour() and lcSurrendered(party) and lcWarnedHalf(party) once says "Of Hester Lyle: she gave the Book of Hands to the Warden's man at the Ninth Bell on the sixth day, with half its pages cut away by clients who had been warned in the night; and he read what was left, and found, among the baker's brothers and the widow's hats, a good deal that he could not use. Her board is turned to the wall. She writes, now, only for those who come to the booth after dark. It is, she says, a smaller trade, and an honester." { }
  Rule lc_fate_lamb_gone when newsHour() and lcSurrendered(party) and not lcWarnedHalf(party) once says "Of Hester Lyle: she gave the Book of Hands to the Warden's man at the Ninth Bell on the sixth day, and her board is turned to the wall. The stool is gone in. Four hundred people read, that week, in the Warden's house, by a man who was not trained to understand them; and four hundred did not come to her again. She writes nothing. In the arcade it is thought that a Crow who has been read is a Crow who has been unfaced." { }
  Rule lc_fate_lamb_burned when newsHour() and lcBurned(party) once says "Of Hester Lyle: she burned the Book of Hands in her own stove, and keeps what was in it by heart, and writes on at the last stall under the awning, one letter at a time, with no ledger at all, as the first of the Crows did. The man in the key-grey called twice, and went away twice. 'It is a worse place for them,' she says, 'and a safer.' She has taken, it is said, a prentice, a girl who cannot spell, to whom she is teaching nothing in the world but what a letter is for." { }
  Rule lc_fate_lamb_sealed_read when newsHour() and lcSealed(party) and lcRead(party) once says "Of Hester Lyle: she got the Book of Hands back, and knew at once, by the way the sailcloth lay, that it had been read. She did not say so. She put it on the shelf behind the baskets. She writes on, in the last stall, with a certain reserve; and has been seen, at night, in her booth, to turn it, now and then, face to the wall." { }
  Rule lc_fate_lamb_sealed when newsHour() and lcSealed(party) and not lcRead(party) once says "Of Hester Lyle: she got the Book of Hands back across her own stall, sealed as it had left her, and put it on the shelf behind the baskets, and did not open it to see. The man in the key-grey, who had no writ to bring to a Warrant, was recalled to the Key. The Warden has taken it as the greatest insult of his year, and has made it, in a long and quiet way, her fault." { }
  Rule lc_fate_lamb_warned when newsHour() and lcWarned(party) and not lcSealed(party) and not lcBurned(party) and not lcSurrendered(party) once says "Of Hester Lyle: four hundred people, who had been told by a bare face in the night that the Warden wanted their secrets, cut the pages out of her book with their own knives, and her ledger went to the Warden's man on the sixth day thin as a prayer-book. She has had, since, a great many callers. They say nothing; they stand a while in the arcade; they order a letter, and when it is written, tell her the whole of the thing again, as if it had never been said." { }
  Rule lc_fate_lamb_decoy when newsHour() and lcDecoyPassed(party) and not lcSealed(party) and not lcBurned(party) and not lcSurrendered(party) and not lcWarned(party) once says "Of Hester Lyle: she did not know until the Chapel's last bell that the Warden's man had been given a book of landladies and hats, by a hand that was not hers. She has since been seen to look at the spine of every book in her stall with a thoughtful eye, and to say of one, aloud, to nobody, that there is a place in it where the sand does not come out." { }
  Rule lc_fate_lamb_index when newsHour() and lcIndexGiven(party) and not lcSealed(party) and not lcBurned(party) and not lcSurrendered(party) and not lcWarned(party) and not lcDecoyPassed(party) once says "Of Hester Lyle: she gave the Warden's man her index, the names without the words, and kept her book. Four hundred doors were knocked at in the Row that week by the Key's clerks, who were met, at every one of them, by a person with nothing to say. She says she did not betray a secret. She does not say that four hundred people learned that their names were in the Warden's pocket, and several have stopped coming." { }

  // ── The umbrella-makers ───────────────────────────────────────────────────────────────────────────────────────────
  Rule lc_fate_row_merged when newsHour() and lcMerged(party) once says "Of Maud Orrell and Silas Haskew: they have cut a door through the wall between the shops, and sold, since the Deepening, four thousand umbrellas under a single board. They agree on nothing; they have agreed on this, and on very little else, with great vehemence, over a tray of oilcloth. It is said that when the bell rings for the Row's Trial they sit on the judge's stool together, bare, and the stool holds." { }
  Rule lc_fate_row_wed when newsHour() and lcWedded(party) once says "Of Maud Orrell and Silas Haskew: they will be, in the spring, a mother of the bride and a father of the groom, and have been heard to say so, without ceasing, in the same breath, to every person on the Row. The board over each shop still says THE FIRST. Under both of them, in a fresh hand, somebody has added a pair of initials joined by a stitch." { }
  Rule lc_fate_row_patent_o when newsHour() and lcPatentO(party) once says "Of Maud Orrell and Silas Haskew: Ostler's has the ribbon, and the queue; Penhallow's has the shutters half down and a boy sweeping nothing. Maud Orrell does not mention it. She has taken to walking past her rival's door at six in the evening with her umbrella furled, as one walks past a house in which there has been a death." { }
  Rule lc_fate_row_patent_p when newsHour() and lcPatentP(party) once says "Of Maud Orrell and Silas Haskew: Penhallow's has the ribbon, and the queue; Ostler's has the shutters half down and a girl in the door with her arms folded over her apron. Silas Haskew has entered the judgement in his register, in full, in a hand that does not shake, and drawn a line under it. He has not drawn the other line." { }
  Rule lc_fate_row_funeral when newsHour() and lcFuneral(party) once says "Of Maud Orrell and Silas Haskew: Ned Orrell was buried from the Drip chapel in the rain, with an umbrella over his coffin from each shop, which nobody remarked on, because nobody on the Row had the heart. The Concord ended the Feud three hundred years ago. It has not ended on Umbrella Row, which has just discovered that it was not as long ago as it had thought." { }
  Rule lc_fate_row_hurt when newsHour() and lcDuelled(party) and not lcFuneral(party) and not lcWarOver() once says "Of Maud Orrell and Silas Haskew: Ned Orrell carries his arm in a sling to this day, and Kit Haskew has a scar on the side of his head like a mask he did not choose. Neither shop sells to anyone who has been in the other. The boards still say THE FIRST. The Row, which has been waiting forty years to see what a duel would be like, has seen one, and does not, on the whole, wish to again." { }
  Rule lc_fate_row_quiet when newsHour() and lcQuiet(party) and not lcDuelled(party) and not lcWarOver() once says "Of Maud Orrell and Silas Haskew: the cousins were paid off and went home. The boards still say THE FIRST, and the two shops are still eleven paces apart, door to door; but there is, since the Deepening, a stool under the Usages, bare, and a rule that on the Third Day somebody sits on it. It is generally held that a quarrel which has a stool is half a quarrel." { }
  Rule lc_fate_children_wed when newsHour() and lcWedded(party) once says "Of Wyn Orrell and Tam Haskew: they will marry at the Chapel in the spring. Each has taken off the Cockle in the lane, in the dark, at the Ninth Bell, and looked at a face she or he had known since they could walk and had never looked at. They say it is the only time in their lives they have been introduced." { }
  Rule lc_fate_children_met when newsHour() and lcChildrenMet(party) and not lcWedded(party) once says "Of Wyn Orrell and Tam Haskew: they know, now, whose children they are, and have gone on meeting at the pond. They stand a good deal nearer. They have said nothing at home, and each is waiting for the other's family to be the first to see sense, which, by the habit of both families, may take some time." { }
  Rule lc_fate_children_unknown when newsHour() and not lcChildrenMet(party) and not lcWedded(party) once says "Of Wyn Orrell and Tam Haskew: they go on meeting at the eel-pond at six, in their Cockles, a yard apart, looking at an old eel in the sixth flume. Neither has asked the other's name. It will be, the Drip has decided, a long courtship, and a short one if anybody has the sense to cough." { }

  // ── Barnaby Sweet and Old Gudge ───────────────────────────────────────────────────────────────────────────────────
  Rule lc_fate_sweet_saved when newsHour() and lcSweetBack(party) and lcSweetSaved(party) once says "Of Barnaby Sweet: he did not lose his face. He does not entirely know why; he has been told that a Bare read a Usage, and has put it down to an unusual form of luck. He tallies at the Coffee-house in his Magpie, and pays his twelve coin, in installments, and has been seen to stop at the eel-pond on the way home, and take his hand from his cheek, and look at his reflection a while." { }
  Rule lc_fate_sweet_won when newsHour() and lcSweetBack(party) and lcGudgeBeaten(party) and not lcSweetSaved(party) once says "Of Barnaby Sweet: his silver won the race, and is on the Coffee-house's bill of fare, on Fridays, with a mark in the margin that nobody has ever explained. He is a Magpie of the Exchange, and a legend on the Row, and he says, to anyone who will listen, that it was the best bet of his life, and that he would not do it again for a kingdom." { }
  Rule lc_fate_sweet_redeemed when newsHour() and lcSweetBack(party) and not lcSweetSaved(party) and not lcGudgeBeaten(party) once says "Of Barnaby Sweet: he has his face back, from the wall of the shed, with the tag still on the string; he keeps the tag. It is the only face in the Drip that has been lost and returned, and he wears it with a kind of attention, as a man wears a coat that has been mended. He tallies to a hair, and is very rarely heard to laugh." { }
  Rule lc_fate_sweet_new when newsHour() and lcSweetNew(party) and not lcSweetBack(party) once says "Of Barnaby Sweet: he tallies at the Coffee-house in a Magpie that nobody has seen before. It sits an inch high, and is wearing in. The Exchange has been very decent about it, and has, in the manner of the Exchange, not mentioned it once. He still has his hand at his cheek, a little, as if to see where the old one went." { }
  Rule lc_fate_sweet_slate when newsHour() and lcSweetSlate(party) and not lcSweetBack(party) and not lcSweetNew(party) once says "Of Barnaby Sweet: the slate outside the Tally Coffee-house is the Exchange's most consulted instrument. A bare man stands beside it, answering nobody, and the Bare of the Hospice queue at his elbow with their purses, and the Magpies, who have always been jealous of an honest sum, say that he is the only tallyman in the Row who has ever been trusted by a stranger. There is talk of letting it become a custom." { }
  Rule lc_fate_sweet_tallied when newsHour() and lcSweetTallied(party) and not lcSweetBack(party) and not lcSweetNew(party) and not lcSweetSlate(party) once says "Of Barnaby Sweet: his debt was paid, by a Bare, from the Coffee-house's own coin; he has no face, and nine days at the Hospice, and nothing in the world he knows how to do. Mother Tibb has given him a bed and a list of reasons, and he has been seen on the Hospice steps, counting the Bare as they come in, under his breath, by the head, for something to count." { }
  Rule lc_fate_sweet_lost when newsHour() and lcSweetLost(party) and not lcSweetBack(party) and not lcSweetNew(party) and not lcSweetSlate(party) and not lcSweetTallied(party) once says "Of Barnaby Sweet: he went to the Hospice on the fourth day, as a man must who has no face, and out at the Gate on the thirteenth. Nobody is sure where. There is a tallyman, they say, in a river town to the south, who does sums for nothing, bare, in a market, and is, apparently, never wrong." { }
  Rule lc_fate_gudge_beaten when newsHour() and lcGudgeBeaten(party) once says "Of Old Gudge: he took the first defeat of his life on the tub with the net across his knees, and has since hung a new tag on the wall of the shed, which says, in the spidery hand, in place of the weight of an eel, WON. The pond is, he says, exact. He has been heard, once, to add that it is a good thing to be reminded." { }
  Rule lc_fate_gudge_kept when newsHour() and lcGudgeKept(party) and not lcSweetBack(party) once says "Of Old Gudge: he hung the thirty-second face on the wall of the shed, with the weight of its eel written under it, and sits under it, at night, with a lantern. The pond is exact. There is, he says, nothing to be said against exactness, except that it makes a very quiet house." { }
  Rule lc_fate_gudge_returned when newsHour() and lcGudgeKept(party) and lcSweetBack(party) and not lcGudgeBeaten(party) once says "Of Old Gudge: there is a space on the wall of the shed where the thirty-second face used to hang, and he has not filled it. People say it is the Drip's single oddest monument. He says nothing of it. He has been known to look at the space for a long time, at night, in the light of a lantern, and then take the net down off its nail and go out to the pond, and stand a while, in the rain, with the eels." { }
}
