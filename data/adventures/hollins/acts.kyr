Module hollins "Behind the Wainscot" {
  // ── The chapters ──────────────────────────────────────────────────────────────────────────────────────────────────
  // Bootscrape; I, the Ratcatcher, from the first step inside; Ten Past Four, when the Clock strikes; II, the Thaw,
  // from the morning the fire is lit; III, the Smoking, from the day the sulphur is in the house or the seventh day;
  // the Last Night, the tenth.
  Relation bootRoom(place).
  Initially Assert bootRoom(march_road). Initially Assert bootRoom(bs_street). Initially Assert bootRoom(mat_tap).
  Initially Assert bootRoom(tallis_yard). Initially Assert bootRoom(arkle_shop). Initially Assert bootRoom(saltash_office).
  Chapter ch_bootscrape "Bootscrape" when at(party, ?p) and bootRoom(?p) and not within(party, house) "Bootscrape lives on a giant's doorstep and makes a living from what falls out of the letterbox. It has done so for three hundred years without once telling anyone from outside what it knows. Four days ago a wagon the size of an inn came over the moor, and a woman as tall as a church tower got down from it and walked up the step and put a key in the door, and since then the village has been very quiet, and has watched the chimney.".
  Chapter ch_ratcatcher "I. The Ratcatcher" when within(party, house) "Inside, the house is a country. It is cold, as it has been cold for three hundred years, except where she has lit fires, and dim, except where she has opened shutters; and everywhere, in the walls, in the grate, on the shelves, the people who came in by the letterbox are going about their lives without a sound, listening, as they have listened every day since Thursday, for the floor to shake.".
  // The first dusk: the Lady winds the Clock, and it strikes, for the first time since the Going.
  Rule lady_winds_clock when at(lady, clock_foot) and state(long_clock, stopped) and hour(clock) >= 18 { Assert state(long_clock, going). }
  Rule lady_rewinds when at(lady, clock_foot) and state(long_clock, jammed) and clockTrapped(pye) and dayN(hollins) >= 5 and trapsLifted(lady) { Assert state(long_clock, going). }
  Chapter ch_tenpast "Ten Past Four" when state(long_clock, going) and within(party, hollins_country) "At six o'clock on the first evening the Lady came down the Stair, slowly, a step at a time, with Mrs Pyecroft on her shoulder and a candle in her hand like a burning tree, and the whole Hall went still. She crossed the flagstones to the Long Clock, opened its trunk, felt inside for the key, and wound it, forty turns, each turn a groan of brass through the house. Then she set the hands by her watch, and shut the trunk, and stood back; and the Clock struck six. It had not struck since the Going. The sound went into every wall in the house, and the Wainscot stood in its doorways and counted the strokes, six, and then stood there after, in the silence, as if waiting for a seventh.".
  Chapter ch_thaw "II. The Thaw" when hearthBurned(hollins) and within(party, hollins_country) "The fire was lit in the drawing room at nine on the second morning. By noon the warmth had gone into the walls, and the cress on the sill had turned to face the glass, and in the Skirting people were taking off coats that their grandparents had put on. The Hearth was gone. It is the warmest the house has been in three hundred years, and the most frightened.".
  Chapter ch_smoking "III. The Smoking" when (pyeHasSulphur(pye) or dayN(hollins) >= 7) and not ladyDead(lady) and within(party, hollins_country) "Now the house is warm all through, and the Lady sleeps more and works less, and Mrs Pyecroft goes about with her lips pressed together. In the Wainscot people have begun to pack, without saying so: a bundle by the door, a child's shoes laced together. Everyone can feel that something is coming to an end, and nobody can say what.".
  Chapter ch_last "The Last Night" when day10() and hour(clock) >= 18 and not ladyDead(lady) and within(party, hollins_country) "On the tenth evening the Lady did not ring for her supper, and Mrs Pyecroft came down the ribbon from her hatbox and sat on the counterpane by her hand, and did not go back up. The house knows. The Clock goes on. The fire in her room has been let burn low.".

  // ── Her death ─────────────────────────────────────────────────────────────────────────────────────────────────────
  Rule lady_dies when day10() and hour(clock) >= 23 and not ladyDead(lady) { Assert ladyDead(lady). }
  Relation satWith(group).
  Action sit_with_lady(actor: group, site: place) "Sit with her on the counterpane, by her hand, until the end" {
    Description "She will not see the morning.".
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, counterpane) and day10() and hour(clock) >= 18 and not ladyDead(lady) and ladyKnows(lady) and not satWith(party).
    Time 6.
    On success { Assert satWith(party). }
    Result "You sit on the counterpane by her hand, which is as big as a boat and as light on the linen as a leaf. She talks for a while, not much, in a voice you have to lean close to: about a coast in the north where the cliffs are white and the sea comes in green; about Honor Lacey, who could whistle through her teeth; about her mother. Then she asks you to stand where she can see you, in the candle, and you do; and she looks at you a long time, exactly, the way she looked at every coast in Imbar. 'There,' she says. 'Drawn.' And she closes her eyes.".
  }
  Rule wainscot_gathers at counterpane when day10() and hour(clock) >= 21 and ladyKnows(lady) and not ladyDead(lady) and at(party, counterpane) and not gathered(hollins)
    says "They come up the Stair in the dark, all of them who will: the Court in its good gloves, the colliers, the Readers, the Keys, Faith Penny in her green cap, the Winders with a candle each, Ma Riser carrying the old ones up her ladders one by one. They stand on the floor of the room, and on the bedside table, and along the foot of the bed, very quiet, six hundred people the size of the Lady's thumb. She cannot see them. She can hear them breathing. 'Oh,' she says. 'All of you.'" { Assert gathered(hollins). }
  Relation gathered(place).
  Rule concert_last at counterpane when day10() and hour(clock) >= 22 and gathered(hollins) and concertPlayed(party) and not lastAir(hollins)
    says "And from downstairs, through the floor, slow as weather, a note; and a minute's silence; and another. The Keys have gone down to the piano without being asked. The Lady smiles, and says the words under her breath with them, a beat ahead, as she must have said them in the nursery to a family in a doll's house, three hundred and twelve years ago: the Little Ship." { Assert lastAir(hollins). }
  Relation lastAir(place).

  // ── Places heard of ───────────────────────────────────────────────────────────────────────────────────────────────
  Initially Assert leadsTo(wainscot_told, skirting). Initially Assert leadsTo(stone_told, waiting_stone).
  Initially Assert leadsTo(coal_hole_known, kitchen_garden). Initially Assert leadsTo(dumbwaiter_known, kitchen_floor).
  Initially Assert leadsTo(court_told, small_house_parlour). Initially Assert leadsTo(page_held, letterdrift).
  Initially Assert leadsTo(underfolk_uncounted, wine_bins). Initially Assert leadsTo(moot_coming, small_house_parlour).

  // ── What the company is about ─────────────────────────────────────────────────────────────────────────────────────
  Objective obj_rats when hiredBy(party, pye) and not soldOut(party) and not pyeTurned(pye) and not ladyDead(lady) "Clear the pantry and the skirtings of rats for Mrs Pyecroft, twopence a tail on the string; she wants to be told where they nest.".
  Objective obj_hearth when knows(party, fire_coming) and not hearthBurned(hollins) and not hearthWarned(hollins) "Get the colliers out of the Hearth before the fire laid on the irons in the middle of their town is lit.".
  Objective obj_trap when knows(party, trap_seen) and state(pye_trap, set) and not watDead(wat) and not trapGivenUp(pye) "Spring Mrs Pyecroft's trap on the run into the back of the Pantry before Wat Tallowby goes in, as he does every morning before light.".
  Objective obj_letter when carries(party, c_letter) "Deliver the letter with the black seal where the Lady will find it: on her chart in the Library, or by her bed.".
  Objective obj_reply when carries(party, reply) "Carry the Lady's reply up the moor to the Waiting Stone.".
  Objective obj_chart when knows(party, chart_plan) and not chartWritten(party) and not ladyKnows(lady) "Draw the Wainscot into the Lady's chart at night, in a hand she can read: pace it out first, and get ink from the Readers.".
  Objective obj_answer when state(lady_chart, questioned) and knows(party, chart_known) and not ladyKnows(lady) "Answer the Lady's question in the margin of her chart: WHO ARE YOU?".
  Objective obj_moot when knows(party, moot_coming) and not occasionOver(moot) and dayN(hollins) <= 3 "Be at the Moot in the Small House parlour at two in the afternoon of the third day, with someone of the Wainscot to speak for you.".
  Objective obj_keys when knows(party, keys_need) and not concertPlayed(party) and not ladyDead(lady) "Help the Keys play the First Air to its end at night: their lost page, weight on the bass, and someone to lead the count.".
  Objective obj_smoke when knows(party, smoking_planned) and not smokingOver(hollins) and not ladyForbids(lady) and not candlesGone(pye) "Stop Mrs Pyecroft smoking the house with sulphur on the night of the {smokeNight(hollins)}th, or get the Wainscot out of its way.".
  Objective obj_poison when knows(party, poison_plan) and not poisoned(lady) and not haspStands(hasp) and not sugarSpilled(party) and not brackStopped(brack) and not potEmptied(party) and dayN(hollins) <= 6 "Keep the Jarl's poison out of the Lady's sugar on the sixth afternoon, while she naps before tea.".
  Objective obj_will when willWanted(lady) and not willMade(lady) "The Lady would make her will: fetch Mr Saltash from Bootscrape to witness it, and someone to write large.".
  Objective obj_deed when knows(party, will_needs) and (willWanted(lady) or willMade(lady)) and not deedLodged(party) and not deedSold(party) "Find the deed of Hollins, which nobody upstairs has seen, and lodge it with Mr Saltash beside her will.".
  Objective obj_bell when bellVolunteer(party) and not belled(bishop) "Bell the cat, as you told the Moot you would.".
  Objective obj_kit when knows(party, nan_fears) and not kitNanMet(kit) "Bring Kit Lacey and Nan Collier, who have written to each other for two years along the bell-wires, into one room.".
  Objective obj_under when knows(party, underfolk_uncounted) and not underfolkEntered(annet) "See the Under-folk of the cellars entered in the Post's register, so that they are somebody's, and get water.".
  Objective obj_verity when knows(party, verity_plans) and not verityRelents(verity) and not verityCaught(verity) and not ladyDead(lady) "Keep Sister Verity from stopping the Long Clock.".
  Objective obj_regiment when knows(party, fennick_stopped) and not standDown(regiment) and not regimentStopped(regiment) "Decide what becomes of the Tin Regiment, which is running down because Fennick will not wind it.".
  Objective obj_sovereign when knows(party, sovereign_wanted) and not sovereignSold(party) and not ladyDead(lady) "Bring Hob Ludd a Whitlock sovereign out of the Lady's purse, for thirty coin, if you mean to.".
  Objective obj_last when day10() and ladyKnows(lady) and not ladyDead(lady) "Be with her, if you can. She will not see the morning.".
}
