Module hollins "Behind the Wainscot" {
  // ── What the house is, after ──────────────────────────────────────────────────────────────────────────────────────
  // When she dies the book closes on the state of the house: whether she knew them; whether a will was made and lodged
  // and the deed with it; whether the deed went to the Concern; whether the Smoking came, and who was out of it;
  // whether the ratcatcher did what they were hired to. A line is told for each that applies, and then the ending.
  Relation fateTold(entity).
  Entity f_hearth: fact "the Hearth". Entity f_pye: fact "Mrs Pyecroft". Entity f_jarl: fact "the Jarl". Entity f_regiment: fact "the Regiment".
  Entity f_kit: fact "Kit and Nan". Entity f_clock: fact "the clock". Entity f_stone: fact "the stone". Entity f_under: fact "the Under-folk". Entity f_sorrel: fact "Sorrel".
  Query accounting() means ladyDead(lady).
  Rule fate_kit when accounting() and kitNanMet(kit) and not fateTold(f_kit) says "Kit Lacey and Nan Collier are married in the parlour of the Small House in the spring, under the WELCOME, with the colliers on the stair and Dame Honor at the head of the table, wearing, people notice, a new chain: buttons, and in the middle of it a piece of coal." { Assert fateTold(f_kit). }
  Rule fate_sorrel when accounting() and sorrelStays(sorrel) and not fateTold(f_sorrel) says "Sorrel Haddow sat at the chart table every day of the last week with her broom, and wrote down what the Lady said, a yard high; the Readers have bound it, and it is the first book in Hollins written by anyone who lived in its walls." { Assert fateTold(f_sorrel). }
  Rule fate_regiment_rest when accounting() and standDown(regiment) and not fateTold(f_regiment) says "The Tin Regiment sits in its Fort with its keys still, and the nursery children of the Wainscot play round them and climb on them, and sometimes, on a warm day, one of them is heard to tick." { Assert fateTold(f_regiment). }
  Rule fate_regiment_stopped when accounting() and regimentStopped(regiment) and not standDown(regiment) and not fateTold(f_regiment) says "The Tin Regiment stands in its Fort where it stopped, every soldier at his post, the Captain's sword pointing at the door. Nobody winds them. Fennick sits in the ark." { Assert fateTold(f_regiment). }
  Rule fate_regiment_pye when accounting() and pyeStabbed(pye) and not fateTold(f_regiment) says "Mrs Pyecroft was buried in Bootscrape churchyard, which was the first time most of Bootscrape had seen her face close. The tin soldiers stand in their Fort with their bayonets dark, and the Captain has not spoken since." { Assert fateTold(f_regiment). }
  Rule fate_pye_provided when accounting() and pyeTurned(pye) and not pyeStabbed(pye) and not fateTold(f_pye) says "Mrs Pyecroft goes home to Market Lambury, to a cottage with a green door her own size and bees at the bottom of the garden, and writes to Dame Honor every month, in a fair hand, about the bees." { Assert fateTold(f_pye). }
  Rule fate_pye_cowed when accounting() and pyeCowed(pye) and not pyeTurned(pye) and not fateTold(f_pye) says "Mrs Pyecroft goes down the ladder the morning after with her clothes in a bandbox, and takes the carrier to Wendle, and does not look back at the house, and nobody in Bootscrape knows what becomes of her." { Assert fateTold(f_pye). }
  Rule fate_jarl when accounting() and haspStands(hasp) and watDead(wat) and not fateTold(f_jarl) says "In the back of the Pantry, where the trap was, the Jarmen have cut a little room into the side of a honey-crock, and put a whistle made from a pin in it, and nobody goes in there but Hasp." { Assert fateTold(f_jarl). }
  Rule fate_under when accounting() and underfolkEntered(annet) and not fateTold(f_under) says "Forty-one names are entered in the Post's register under a new heading, in Faith Penny's hand: CAME IN BY THE COAL-HOLE. Drewe gives them their thimbles." { Assert fateTold(f_under). }
  Rule fate_stone when accounting() and stoneTurned(party) and not fateTold(f_stone) says "On the moor above Bootscrape the Waiting Stone stands as it always has, except that it does not seem to be waiting any more; people who walk up there say so, and cannot say why." { Assert fateTold(f_stone). }
  Rule fate_clock_cold when accounting() and not ladyKnows(lady) and not (smoked(hollins) and not evacuated(hollins)) and not fateTold(f_clock) says "The night she dies, the Winders climb into the works and stop the Long Clock, at the minute it happened, with a finger on the pendulum. It is still the day she died, the Prior says. It will be that day for a long time." { Assert fateTold(f_clock). }
  Rule fate_clock_known when accounting() and ladyKnows(lady) and not fateTold(f_clock) says "The Long Clock goes on striking. The Winders wind it now, every Sunday, forty turns, with a team on the key, because she said it was today, and so it is." { Assert fateTold(f_clock). }

  Rule fate_nursery when accounting() and smoked(hollins) and not evacuated(hollins) and refugeesHoused(hollins) and not fateTold(f_kit) says "The Nursery was spared. The colliers the Moot had sent up to the Small House came down the ladder in the summer, with the Laceys, and went away over the moor together." { Assert fateTold(f_kit). }
  Rule fate_rat_smoke when accounting() and soldOut(party) and smoked(hollins) and not evacuated(hollins) and not fateTold(f_hearth) says "The Smoking came on the night the ratcatcher's word reached Mrs Pyecroft. The Post's register ends that night, in mid-line." { Assert fateTold(f_hearth). }
  Rule fate_rat_poison when accounting() and soldOut(party) and poisoned(lady) and not fateTold(f_jarl) says "She did not live to the tenth night: there were almonds in her sugar on the sixth, and the Jarl has the Pantry." { Assert fateTold(f_jarl). }

  // ── The endings, from the most particular ─────────────────────────────────────────────────────────────────────────
  Ending ratcatcher "The Ratcatcher" over tea, smoking when ladyDead(lady) and soldOut(party) and not ladyKnows(lady) "She died on the tenth night, in a quiet house. Mrs Pyecroft paid the ratcatcher's account in full, with a bonus, and wrote a character for them in a fair hand: thorough, discreet, and successful. It is quite true. What the Wainscot calls them, those of it who are left, is not written anywhere; but it is said in Bootscrape, at the Mat, to children, as a warning.".
  Ending tea "The Tea at Ten Past Four" when ladyDead(lady) and poisoned(lady) "She died a little before midnight on the sixth day, in her bed, with Mrs Pyecroft holding one of her fingers in both arms. Doctor Hume's great-great-grandson came out from Wendle and said her heart, and nobody in the house said otherwise. Six hundred people in the walls know what was in the sugar; most of them did not want it; none of them will ever say. The Jarl has the Pantry, and the honey, and whatever else is left when her cousin's lawyers come. In the Wainscot they still tell children the story of the Child who hid the Laceys in her own house, and now it has an ending, and the children are not told it.".
  Ending smoking "The Smoking" when ladyDead(lady) and smoked(hollins) and not evacuated(hollins) "She died on the tenth night, in her bed, upstairs, warm, in a house that was quiet at last, as Mrs Pyecroft had promised her it would be. She never knew. In the spring the Bootscrape men went in through the Slot with sacks and lanterns, and came out, and went in again, for a week, and dug in the kitchen garden among the catmint, and did not talk about it afterward, then or ever. The Post's register ends on the night of the Smoking, in mid-line.".
  Ending freehold "The Freehold" when ladyDead(lady) and ladyKnows(lady) and willLodged(lady) and deedLodged(party) and not deedSold(party) "She died on the tenth night, a little before midnight, with six hundred people on her floor. Mr Saltash proved her will in the county court at Wendle in the spring, against a cousin, the Hollins Stone Concern, and a good deal of laughter, and won, with the deed on the table in front of the judge like a rolled carpet: the house and lands of Hollins, and all in it, to the people who live in its walls, in common, for ever. It is entered in the rolls of the county as the first freehold ever held in Imbar by people living inside a building that belongs to them. In Hollins the shutters are open. The Slot is a door. The Lady's chart hangs in the Hall, framed, as big as a field, with the Wainscot drawn into it in a big black hand, every lane in its place; and in the margin, in hers, under WE LIVE HERE: SO YOU DO. E. W.".
  Ending last_game_sold "The Last Game, and the Quarrymen" when ladyDead(lady) and ladyKnows(lady) and deedSold(party) "She died on the tenth night, knowing. Her last week was the best of her life, she told Dame Honor, who wrote it down. But the deed went to the Concern, and her will, if she made one, could not stand against the conveyance and the deed together. In the spring Mr Overy's men put scaffolding up the chimneys, and the Wainscot went down the rope ladder one family at a time, carrying what fitted, into Bootscrape and over the moor. They took the Small House with them, on a cart, room by room. It is the only house in Imbar that has been carried out of another house.".
  Ending last_game "The Last Game" when ladyDead(lady) and ladyKnows(lady) "She died on the tenth night, knowing; that was the whole of what she had wanted, she told Dame Honor, and more than she had hoped. She made no will that would stand, or none that could be proved without the deed. Her cousin in Sabine's country has written to Mr Saltash, and Mr Saltash has written back, and they will write for some years, Saltash says, which is how the law gives people time. In Hollins the shutters are open, and the Clock strikes, and the Wainscot lives as it lived, in a house it does not own, which it has learned is not the same as a house that does not know it.".
  Ending sold "Sold for Stone" when ladyDead(lady) and deedSold(party) "She died on the tenth night, in a quiet house, not knowing. The deed was in Mr Overy's hands and the conveyance was signed, and in the spring the Concern's men put scaffolding up the chimneys and began to take Hollins down, course by course, for a corn exchange and a gaol in Wendle. The Wainscot went down the ladder before them, one family at a time. Bootscrape took in whom it could. The rest went over the moor.".
  Ending downladder "Down the Ladder" when ladyDead(lady) and smoked(hollins) and evacuated(hollins) "She died on the tenth night, upstairs, in a house that had been smoked from cellar to Hall, and was empty. The Wainscot had gone down the rope ladder to Bootscrape, or up to the Nursery, and it stayed there. Bootscrape is twice the size it was, and has a Post, and a Court that sits in the Mat's back room on Thursdays, and a Nail, and an argument every evening about whether to go back. The house stands on the hill with its windows dark, as it stood for three hundred years, with nobody in it at all.".
  Ending cold "The House Goes Cold" when ladyDead(lady) "She died on the tenth night, in her bed, not knowing; she had thought, at the end, that the noises in the walls were her mind, and had been glad when they were quieter. Mrs Pyecroft closed her eyes and went down the ladder with her bandbox. Nobody found the deed, and the Concern's paper was not worth the trouble of the cousin's lawyers, and so for now nothing happens to Hollins at all. The fires go out. The cold comes back into the walls, slowly, over a week, and the Wainscot puts its coats on again, and goes on living in the house of a woman who never knew it was there, which is what it always did.".

  // ── Experience ────────────────────────────────────────────────────────────────────────────────────────────────────
  Milestone ms_hearth "got the Hearth out before the fire" worth 100 when hearthWarned(hollins) and hearthBurned(hollins).
  Milestone m_rats "ratted the back pantry, honestly" worth 50 when ratted(party).
  Milestone m_wat "kept Wat Tallowby out of the trap" worth 75 when day4() and not watDead(wat).
  Milestone m_bell "belled the cat" worth 150 when belled(bishop) and bellVolunteer(party) or belled(bishop) and not catShutIn(bishop).
  Milestone m_concert "played the First Air to the end" worth 150 when concertPlayed(party).
  Milestone m_chart "wrote back on the Lady's chart" worth 100 when chartWritten(party).
  Milestone m_known "made the Wainscot known to the Lady" worth 200 when ladyKnows(lady).
  Milestone m_honor "brought Honor Lacey before her" worth 100 when honorMet(honor).
  Milestone m_mother "gave the Lady her mother's letter" worth 100 when motherDelivered(lady).
  Milestone m_letter "delivered the letter with the black seal" worth 75 when letterRead(lady).
  Milestone m_stone "carried her answer to the stone" worth 75 when replyLaid(party).
  Milestone m_verity "kept the Clock going" worth 75 when verityRelents(verity).
  Milestone m_under "had the Under-folk counted" worth 75 when underfolkEntered(annet).
  Milestone m_vault "opened the Whitlocks' strongbox" worth 100 when state(strongbox, open).
  Milestone m_poison "kept the poison out of her tea" worth 150 when day7() and not poisoned(lady) and haspPlots(hasp) or haspStands(hasp) and watDead(wat).
  Milestone m_smoke "kept the Smoking from the Wainscot" worth 150 when smokingOver(hollins) and not smoked(hollins) and pyeOrdered(pye) or smoked(hollins) and evacuated(hollins).
  Milestone m_will "saw her will lodged, and the deed with it" worth 200 when willLodged(lady) and deedLodged(party).
  Milestone m_kit "brought Nan Collier up the Stair" worth 75 when kitNanMet(kit).
  Milestone m_peace "ended the Tin Regiment's war" worth 100 when standDown(regiment).
}
