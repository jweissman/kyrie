Module pentrice "Gosse's Company" {
  // ── The summons, the road, and the people of Dun Rierdan ─────────────────────────────────────────────────────
  // After the verdict a herald comes to the Painted Moon with a writ: whatever the Bench decided, the King has heard.
  // The troupe goes ahead to the Brazen Sparrow; whoever follows finds them there, lodged on credit, rehearsing in a
  // loft with a chalk line down the middle. The company is not the only story in the city: the city has its own.
  Measure favour(place). Measure arrivedR(place). Measure standingR(place).
  Relation heraldCame(place). Relation writHeld(group). Relation rierdanKnown(group).

  Person aubrey "Aubrey Lintel" nowhere {
    Role "a herald of the King's Household, in a tabard with a crowned tower on it". Ancestry human. Peaceable. Pronouns he. Manner proud.
    Arrives at moon_yard when verdictRead(pentrice) and hour(clock) >= 9.
    Arrives "A horse comes in under the Moon's arch with a man on it in a tabard of seven blue towers, and the whole yard stops to look. He dismounts as though the cobbles had been laid for it.".
    Greets "'I am sent,' says Aubrey Lintel, 'to the players that played The Alderman's Ghost, or the ones that did not, and to anyone who was in the house or says so.' He consults a roll, upside down, and rights it. 'His Majesty, Casimir of the House of Orvane, has been told a story of the Trial, and wishes the story to be played for him. That is all. It is not a command. It is not a command in a way that has never in the history of the Household been refused.'".
  }
  Topic aubrey_writ with aubrey "Take the King's writ" when verdictRead(pentrice) and not summoned(pentrice) once {
    Says "He gives you a writ, sealed in blue wax with a tower, and holds out the other hand for you to kiss it, and, on seeing your face, puts it away. The writ is addressed to GOSSE'S COMPANY OF PLAYERS AND SUCH AS GO WITH THEM, and it says: COME TO DUN RIERDAN BY THE KING'S ROAD, BEING FOUND SUFFICIENT, AND PLAY. Under it, in a different hand, someone has added: BRING THE BEAR.".
    On discuss { Assert summoned(pentrice). Assert writHeld(actor). Assert knows(actor, writ_known). }
  }
  Discovery writ_known "King Casimir Orvane has sent a writ to Gosse's Company to come to Dun Rierdan by the King's Road, and play.".
  Topic aubrey_why with aubrey "Ask Aubrey Lintel why the King has heard of them" when true once {
    Says "'Because the King,' says Aubrey, 'is eighty-one and has not been amused since the Siege of Thrall. The Chamberlain keeps a list of things that might do it. A Trial of three companies and a riot is the first new thing on it in three years.' He considers. 'He is also, I am told, afraid of something, and would like to be somewhere else for an evening. I did not say that.'".
  }

  // The troupe goes ahead. They lodge at the Sparrow until they have a house of their own.
  Rule royal_arrival when at(party, road_head) and summoned(pentrice) and not royalCall(pentrice) {
    Assert royalCall(pentrice). Set arrivedR(rierdan) to day(clock). Set favour(rierdan) to 0.
    Assert troupe(clemency).
    Retract at(gosse, moon_loft). Retract at(hepzibah, moon_loft). Retract at(swale, moon_loft). Retract at(dorcas, moon_loft).
    Retract at(pudding, moon_loft). Retract at(kit, moon_loft). Retract at(tam, moon_loft). Retract at(the_bear, moon_yard).
    Retract at(gosse, moon_taproom). Retract at(hepzibah, moon_taproom). Retract at(swale, moon_taproom). Retract at(dorcas, moon_taproom).
    Retract at(pudding, moon_taproom). Retract at(kit, moon_taproom). Retract at(tam, moon_taproom).
    Assert at(gosse, sparrow_loft). Assert at(hepzibah, sparrow_loft). Assert at(swale, sparrow_loft). Assert at(dorcas, sparrow_loft).
    Assert at(pudding, sparrow_loft). Assert at(kit, sparrow_loft). Assert at(tam, sparrow_loft). Assert at(the_bear, sparrow_taproom).
  }
  Query rehoused() means houseGranted(rierdan).
  Relation houseGranted(place).
  Rule rtroupe_taproom when troupe(?p) and royalCall(pentrice) and distinct(?p, clemency) and at(?p, sparrow_loft) and hour(clock) >= 18 and hour(clock) < 23 and not holdingAct(rierdan) {
    Retract at(?p, sparrow_loft). Assert at(?p, sparrow_taproom). }
  Rule rtroupe_loft when troupe(?p) and royalCall(pentrice) and distinct(?p, clemency) and at(?p, sparrow_taproom) and (hour(clock) >= 23 or hour(clock) < 18) and not holdingAct(rierdan) {
    Retract at(?p, sparrow_taproom). Assert at(?p, sparrow_loft). }
  Relation holdingAct(place).

  // ── The Crown ────────────────────────────────────────────────────────────────────────────────────────────────
  Person casimir "King Casimir Orvane" at audience {
    Role "King of the Seven Towers, eighty-one". Ancestry human. Peaceable. Pronouns he. Manner stoic.
    Greets "The King is a small bright-eyed old man in a coat too large for him. He watches you come the length of the rug without moving, as one watches a play, and says in a high clear voice when you reach the end: 'You are shorter than the herald said.'".
  }
  Person pyke "Sir Ferrand Pyke" at closet {
    Role "the King's Chamberlain, keeper of the Book of Names". Ancestry human. Peaceable. Pronouns he. Manner acerbic.
    Greets "Sir Ferrand Pyke is a long thin man who stands with his hands behind him in a room that cannot fit them. He consults his book before he answers anything, even a greeting, and writes down what he has said.".
  }
  Person mallam "Osbert Mallam" at closet {
    Role "the Chamberlain's clerk". Ancestry human. Peaceable. Pronouns he. Manner cheerful.
    Greets "Osbert Mallam is twenty-two and has been up all night. 'The masquers,' he says, brightly. 'Have the masquers come? Oh, you have. Splendid. Which of you is the one who does the voices?'".
  }
  Person lothar "Prince Lothar Orvane" at terrace {
    Role "the King's grandson and heir, nineteen". Ancestry human. Peaceable. Pronouns he. Manner grim.
    Greets "The young man in black does not turn. 'You are the players,' he says to the Concourse. 'You will have noticed the whole city is lit and nobody is looking at the dark.' He turns at last. He has the face of someone who has stopped sleeping out of politeness.".
  }
  Person tallis "Sergeant Hob Peverell" at river_gate {
    Role "sergeant of the River Gate". Ancestry human. Peaceable. Pronouns he. Manner cheerful.
    Greets "The sergeant looks up from the ledger and his face does something complicated. 'Marchant's masquers!' he says. 'You're late! His Lordship's steward has been down here four times since breakfast with a face like a boiled ham.' He turns a page. 'How many of you? He said eight, and a bear.'".
  }

  // The Marchants: the Chancellor's house, with a daughter and a son nobody has been told apart from.
  Person marchant "Lord Lisle Marchant" at marchant_hall {
    Role "the Lord Chancellor of Dun Rierdan". Ancestry human. Peaceable. Pronouns he. Manner proud.
    Greets "Lord Lisle Marchant is a short stout man in a robe of office, who stands in his own hall as though it were a courtroom and you had come to prove the roof. 'I understand,' he says, 'you are the masquers. I understand you are to perform in the presence of the King on his Name-Day. I understand that nobody will tell me what you will say.'".
  }
  Person simm "Beadle Simm" at marchant_hall {
    Role "the Marchants' steward". Ancestry human. Peaceable. Pronouns he. Manner stoic.
    Greets "The steward has the face of a boiled ham and the manner of one who has waited on the same family for forty years and has decided to say nothing about any of it. He looks at you, and at Kit if Kit is with you, and lets his eyes do the arithmetic.".
  }
  Person oriel "Oriel Marchant" at rot_wings {
    Role "a page of the Rotunda, small and sharp-faced". Ancestry human. Peaceable. Pronouns he. Manner cheerful.
    Known as "Orrin, a page of the Rotunda" when not knows(party, oriel_unmasked).
    Greets "A slight page in the Rotunda's blue, with soot on one cheek and a prompt-copy under his arm, looks at you with sharp interest. 'You're players,' he says, and the word is a different word in his mouth than in anyone else's. 'Real ones. Not Master Fallow's.'".
  }
  Discovery oriel_unmasked "The Rotunda's page Orrin is Lady Oriel Marchant, the Chancellor's daughter, who has been living in the wings as a boy for six weeks.".
  Person cyprian "Cyprian Marchant" at marchant_hall {
    Role "the Chancellor's son, a lieutenant of the Watch". Ancestry human. Peaceable. Pronouns he. Manner cheerful.
    Greets "A young man in the Watch's grey and pewter comes down the stair two at a time and stops in front of you with his mouth open. 'You,' he says. It is very odd to be looked at as though you were a ghost, and a welcome one.".
  }

  // The Rotunda's master: Corin Fallow, who won the Patent and is now being a power in a bigger room.
  Rule fallow_moves when royalCall(pentrice) and at(fallow, ?x) and distinct(?x, rot_front) and distinct(?x, rot_stage) { Retract at(fallow, ?x). Assert at(fallow, rot_front). }

  // The Towers.
  Person dray "Lord Warden Cassian Verrall" at king_court {
    Role "the Warden of the Realm, the King's hand in the Seven Seats". Ancestry human. Calling warrior. Level 3. Peaceable. Pronouns he. Manner grim.
    Greets "Lord Warden Cassian Verrall is a lean grey man of sixty with a soldier's back and the habit of speaking slowly so that he cannot be misquoted. 'The law,' he says, when you are introduced, as if it were a surname. 'You have come to see it done.'".
  }
  Person lucan "Lucan Verrall" at king_court {
    Role "the Warden's son, a captain of the Household". Ancestry human. Calling warrior. Level 2. Peaceable. Pronouns he. Manner compassionate.
    Greets "A broad young captain in blue leans on a pillar of the colonnade with a book open on his knee, a thing that has plainly cost him some effort to be seen doing. He shuts it when you come near.".
  }
  Person tarn "Marshal Edric Marrick" at lamp_hill {
    Role "Marshal of the Watch, in the Tower of Lamps". Ancestry human. Calling warrior. Level 4. Peaceable. Pronouns he. Manner proud.
    Greets "The Marshal of the Watch is a big, handsome, sincere man of fifty with a scar like a signature across the back of one hand. 'Players!' he says, with real pleasure. 'Good. This city has too many lawyers and not enough plays. I should like to see one where the right man wins.'".
  }
  Person ysolt "Ysolt Marrick" at bell_nave {
    Role "the Marshal's daughter, an acolyte of the Bells". Ancestry human. Peaceable. Pronouns she. Manner compassionate.
    Greets "A young woman in the grey of an acolyte is on her knees at the foot of the great rope, very straight, as one kneels who has been taught to. She gets up when you come near and the knees of her robe are quite worn.".
  }
  Person ambros "Brother Ambros" at ringers_loft {
    Role "the blind ringer of the Bells". Ancestry human. Peaceable. Pronouns he. Manner grim.
    Greets "A blind man with a face like a closed fist turns toward your footstep before you have made it. 'You walk like an actor,' says Brother Ambros. 'You walk as though somebody were looking.'".
  }
  Person salt_wives "the Salt-Wives" at salt_hall {
    Role "three old women of the guild of Salt, who keep the weather-lore of the city". Ancestry human. Numbers 3. Peaceable. Pronouns they. Manner acerbic.
    Greets "Three women in grey look up as one. The eldest says: 'Rain by Thursday.' The second says: 'And a fall by Friday.' The third says nothing at all, and smiles, and it is the smile of someone who has seen the end of the play.".
  }
  Person crake "Master Isidore Pomfret" at crake_room {
    Role "a moneylender of the Tower of Coin". Ancestry human. Peaceable. Pronouns he. Manner jovial.
    Greets "Master Pomfret rises like a very friendly sunrise. 'The King's Players!' he says. 'Or soon to be. How very good of you to call. I have heard so much, and written down so much more.' He sits, and you notice you are sitting too.".
  }
  Person pardew "Mistress Pardew" at draper {
    Role "the draper, who dresses the Rotunda and everyone else". Ancestry human. Peaceable. Pronouns she. Manner acerbic.
    Greets "Mistress Pardew looks you over once, from the hat down, and says: 'Four crowns and an alteration.' She has not asked you what you want. She knows exactly what you want.".
  }
  Person rask "Lord Anselm Rask" at rot_box {
    Role "a young lord of leisure, and the Rotunda's most generous patron". Ancestry human. Peaceable. Pronouns he. Manner jovial.
    Greets "A smooth, smiling young man with an orchid in his buttonhole rises from the royal box as if the Rotunda belonged to him, which in a manner of speaking it does. 'I adore the theatre,' he says. 'I adore everyone in it. Who are you, and are you spoken for?'".
  }
  Person printer "Master Gabriel Gadsby" at print_row {
    Role "a printer of quartos, not quite licensed". Ancestry human. Peaceable. Pronouns he. Manner cheerful.
    Greets "A man with ink to the elbow looks up from a press he is not supposed to be running. 'The Players?' he says. 'You'll want a copy of yourselves. I've done four.'".
  }
  Rule gammage_follows when royalCall(pentrice) and at(gammage, ?x) and distinct(?x, playhouse_row) { Retract at(gammage, ?x). Assert at(gammage, playhouse_row). }
}
