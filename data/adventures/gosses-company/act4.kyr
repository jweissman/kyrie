Module pentrice "Gosse's Company" {
  // ── Act IV: The Note ──────────────────────────────────────────────────────────────────────────────────────────
  // A caper. The Crown has given the company the Wick, dark for nine years, on a lease that voids if "any instrument of
  // the Players is found false". Master Pomfret of the Tower of Coin has lent three hundred crowns for the fit-out and
  // holds, besides, a note for eighty in Absalom Gosse's name, which Ambrose Swale wrote to settle a debt of his own. It
  // is a good forgery. He means to be paid, in a private performance at his daughter's wedding and a speaking part for
  // himself. The note is in the strong-box in his counting-room. The Wick opens on a Saturday, and Master Pomfret
  // will be in Lord Rask's box from seven till half past nine. Nobody is to be hanged, imprisoned or reformed.
  // Whoever takes it back has taken it back, and nothing civic changes: the Tower of Coin will go on lending.
  Relation wickGranted(place). Relation swaleOwned(group). Relation swaleHidden(group). Relation gosseTold(group).
  Relation planPudding(group). Relation planDorcas(group). Relation planTam(group). Relation planOriel(group).
  Relation disguiseHad(group). Relation keyCopied(group). Relation pomfretHeld(place). Relation clerkLured(place).
  Relation boxOpened(group). Relation noteTaken(group). Relation noteBurned(group). Relation noteReturned(group).
  Relation caughtInCounting(group). Relation heistOver(place). Relation raskCharmed(group). Relation dorcasLoved(group).
  Relation openingNight(place). Relation openingHeld(place).
  Measure openingDay(place). Measure alarm(place).
  Chapter ch_note "The Note" when wickGranted(rierdan) and not heistOver(rierdan) "The Wick has a roof, a stage and a lease, and the lease has a clause. Master Pomfret is very fond of the company. He sends flowers.".

  Rule wick_given when actIIIDone(rierdan) and not wickGranted(rierdan) {
    Assert wickGranted(rierdan). Set openingDay(rierdan) to day(clock) + 3. Assert houseGranted(rierdan).
    Assert at(pomfret_clerk, crake_room). }
  Person pomfret_clerk "Corbin Ashplant" nowhere {
    Role "Master Pomfret's chief clerk, a long grey man". Ancestry human. Peaceable. Pronouns he. Manner stoic.
    Greets "The chief clerk looks at you over a pair of spectacles and does not offer to take your name. 'Master Pomfret is at the Exchange,' he says. 'He is always at the Exchange. I am here.'".
  }
  Topic pomfret_terms with crake "Ask Master Pomfret about the lease on the Wick" when wickGranted(rierdan) and not heistOver(rierdan) once {
    Says "Master Pomfret opens a book and shows you a page of beautiful copperplate. 'Three hundred for the fit-out,' he says. 'At a most generous five in the hundred by the month. And a small matter of eighty crowns, upon a note of hand in Mr Gosse's name, which Mr Swale was good enough to bring me in the spring.' He closes the book. 'I would not dream of troubling the Chamberlain with it. The lease, I am told, is very particular about false instruments. I think we understand one another.' He smiles. 'My daughter marries at Michaelmas. I have always thought a private performance would be so nice.'".
  }

  // Swale owns it, or doesn't; Gosse is told, or isn't.
  Topic swale_ask with swale "Ask Swale why he looks like a man at his own funeral" when wickGranted(rierdan) and not swaleOwned(party) and not swaleHidden(party) once {
    Says "Ambrose Swale rises, magnificently, and sits again. 'There is a paper,' he says. 'In Isidore Pomfret's strong-box. It has Gosse's name on it, and Gosse did not write it. I did.' He looks at his hands. 'I was owed a part. I was owed the Hamlet in Pentrice, and Gosse gave it to the boy. I thought: a trifle. Eighty crowns, to settle a tailor, and a man of my gifts being sat on by a tailor.' He closes his eyes. 'Gosse has never raised his voice to me in nineteen years. I cannot bear to tell him. What would you do?'".
  }
  Topic swale_tell with swale "Tell Gosse yourself, tonight, before Pomfret does" answering swale_ask when true {
    Says "'Yes,' says Swale, in the voice of a man hearing his sentence. 'Yes. I shall.' He gets up. He puts on his coat, very slowly, as for a battle. He does not look at you again. It is the bravest thing you have seen him do and he does not know it.".
    On discuss { Assert swaleOwned(actor). Assert gosseTold(actor). }
  }
  Topic swale_hide with swale "Say nothing. We'll get the paper back and he need never know" answering swale_ask when true {
    Says "Swale's relief is so great that for a moment he cannot speak. 'Thank you,' he says, and takes your hand in both of his, which are damp. 'I shall never forget it.' He will. But he will be very useful tonight. A man with a secret is a good accomplice.".
    On discuss { Assert swaleHidden(actor). }
  }
  Topic swale_blame with swale "Let it be a company debt. We'll all say we agreed it" answering swale_ask when true {
    Says "Swale stares. 'You'd lie,' he says. 'For me.' 'For the company,' you say, and he accepts that, because it lets him. 'Gosse will know,' he says, 'whatever we say.' 'Then he'll know,' you say. It is the kindest and least honest thing you have ever said, and it will matter in the fifth act.".
    On discuss { Assert swaleHidden(actor). Assert swaleOwned(actor). }
  }

  // Four plans; the company will not agree. Hepzibah asks the player to choose the one that goes.
  Topic hepzibah_plan with hepzibah "Ask Hepzibah to gather the company about the note" when wickGranted(rierdan) and not planPudding(party) and not planDorcas(party) and not planTam(party) and not planOriel(party) once {
    Says "The company is in the Wick's wardrobe among the hampers. Four people begin speaking at once and Hepzibah rings the prompt-bell, which is how you tell it is serious. 'Jem has a plan,' she says. 'Dorcas has a plan. Tam has a plan. The Marchant girl has a plan, and so far hers is the only one with a seal in it. I have put them in order. I should like you to choose, because if I do I shall be blamed for the result.'".
  }
  Topic plan_pudding with hepzibah "Jem's: a false clerk, a false summons, and a very good coat" answering hepzibah_plan when true {
    Says "Jem Pudding stands on a hamper, in the dim, in one of Pomfret's own clerk's coats that has been taken in by Pardew. 'I've been a clerk,' he says. 'I was one for six weeks in my youth, in Marl. I was dismissed for singing.' He bows. 'I shall be perfectly dull.'".
    On discuss { Assert planPudding(actor). }
  }
  Topic plan_dorcas with hepzibah "Dorcas's: she keeps Master Pomfret in the box, and Lord Rask looks the other way" answering hepzibah_plan when true {
    Says "Dorcas is sitting on a hamper with her chin up. 'I'm forty-eight,' she says. 'A girl of twenty can't do what I can do to an old man's attention.' She does not look at anyone. 'Lord Rask has a very large box and a very small mind. I shall keep Isidore Pomfret in it till half past nine.'".
    On discuss { Assert planDorcas(actor). }
  }
  Topic plan_tam with hepzibah "Tam's: over the roof of the Tower of Coin, through the skylight" answering hepzibah_plan when true {
    Says "Tam Hautboy has drawn the Tower of Coin on the floor in chalk, with the skylight and the downpipe and the drop. 'Forty feet,' he says. 'A rope, and a hook, and a man who has built a lot of scaffolds.' He looks at the others. 'I'd want somebody on the street to cough.'".
    On discuss { Assert planTam(actor). }
  }
  Topic plan_oriel with hepzibah "Oriel's: a summons from the Chamberlain, sealed, to take the clerk away" answering hepzibah_plan when true {
    Says "Oriel Marchant has the Chamberlain's seal in a clay impression the size of a coin, and a stiff piece of the Household's paper. 'I know his hand,' she says. 'I copied it for my father a hundred times. The clerk will go. They always go for the Household.' She hesitates. 'I should be using my father's name, I think. I should like to. A little.'".
    On discuss { Assert planOriel(actor). }
  }

  // The draper's: disguise, a key, and a price. Mistress Pardew knows who everybody is, and sells it.
  Topic pardew_deal with pardew "Ask Mistress Pardew whether she dressed a clerk" when wickGranted(rierdan) and not disguiseHad(party) once {
    Says "Mistress Pardew does not answer. She measures you with her eyes. 'I have dressed every clerk in the Tower of Coin for twenty years,' she says. 'I know the coat, I know the collar, I know where the left cuff is darned. What I do not know is why a company of players should want one.' She takes a pin from her mouth. 'I shall find out in a week. Four crowns, and an alteration. And tell me one true thing you were not going to tell me.'".
  }
  Topic pardew_true with pardew "The note's a forgery. We mean to take it back" answering pardew_deal when true {
    Says "Mistress Pardew sits down on her counter, which she never does. 'Eighty crowns,' she says. 'He bought my husband's debt in the autumn and my husband died of it.' She tears the price-ticket off the coat. 'Take it. Take the key-mould too, I have a copy of the clerk's. It was a thing I did when I was angry.' She puts it in your hand. 'Bring me the paper, when you have it, and I shall burn it myself.'".
    On discuss { Assert disguiseHad(actor). Assert keyCopied(actor). Give clerk_coat to actor. Give key_kind to actor. }
  }
  Topic pardew_lie with pardew "Costumes for a play about a clerk" answering pardew_deal when true {
    Says "Mistress Pardew looks at you for a long moment. 'Four crowns,' she says. 'And an alteration. And you will be telling that to someone else tomorrow.' The coat is a good coat. The key she keeps in her pocket.".
    On discuss { Assert disguiseHad(actor). Give clerk_coat to actor. Decrease quantity(actor, gold) by 4 or to nothing. }
  }
  Kind clerk_coat "a clerk's coat of the Tower of Coin" is gear described "A grey wool coat with a black collar, smelling of ink and tallow. The left cuff is darned.".
  Kind key_kind "a wax mould of the counting-room key" is gear described "A cake of wax with the key's teeth pressed into it, wrapped in a bit of cloth.".

  // The night. The Wick opens at seven; Pomfret is in the box till half past nine.
  Rule opening_begins when wickGranted(rierdan) and day(clock) >= openingDay(rierdan) and hour(clock) >= 19 and not openingNight(rierdan) and not heistOver(rierdan) {
    Assert openingNight(rierdan). Assert holdingAct(rierdan). Set alarm(rierdan) to 0.
    Assert at(crake, wick_box). Assert at(rask, wick_box). Assert at(gosse, lant_stage). Assert at(swale, lant_stage). Assert at(hepzibah, lant_ward).
    Assert at(dorcas, lant_stage). Assert at(kit, lant_ward). Assert at(pudding, lant_ward). Assert at(tam, lant_ward). }
  Place wick_box "Lord Rask's box" is room within lantern at 1, 1.
  Passage wick_box_door "the box stair" is steps between lant_stage and wick_box.
  Observe wick_box_scene at wick_box when true "Lord Rask's box at the Wick is a velvet cupboard over the stage left, with three chairs, a bottle and a very good view. Master Pomfret has the best chair and the whole of Rask's attention. Below, the house is full. The ghost-light has been put out for the first time in nine years, and somebody has remarked on it.".
  Rule opening_ends when openingNight(rierdan) and hour(clock) >= 22 and not heistOver(rierdan) {
    Retract openingNight(rierdan). Retract holdingAct(rierdan). Assert heistOver(rierdan). }
  // The Wick opens even if no one steals anything. Dorcas keeps Pomfret in the box, or doesn't.
  Action charm_pomfret(actor: group, site: place) "Take Lord Rask's box for the evening, and a bottle, and Master Pomfret's whole attention" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, wick_box) and openingNight(rierdan) and not pomfretLocked(rierdan).
    Time 5.
    Resolve check(actor, performance, dc_fair).
    On success { Assert pomfretLocked(rierdan). Assert raskCharmed(actor). }
    On failure { Assert pomfretLocked(rierdan). Increase alarm(rierdan) by 1. }
    Result "Dorcas, in the second act's interval, in a gown not entirely hers, takes the third chair and the bottle and begins to tell Master Pomfret, in her best contralto, about her first Cordelia. Lord Rask hangs on every word that is not for him. Pomfret has the look of a man being flattered by an expert. You will have until half past nine.".
    Otherwise "Pomfret, who has been flattered by experts, says that he must see to a small matter at the Exchange before the third act. He is up out of the chair. You will have rather less than you thought.".
  }
  Relation pomfretLocked(place).
  Action lure_the_clerk(actor: group, site: place) "Send the chief clerk away with the Chamberlain's sealed summons" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, crake_room) and openingNight(rierdan) and planOriel(actor) and not clerkLured(rierdan) and at(pomfret_clerk, crake_room).
    Time 2.
    Resolve check(actor, deception, dc_fair).
    On success { Assert clerkLured(rierdan). Assert at(pomfret_clerk, king_court). }
    On failure { Increase alarm(rierdan) by 1. }
    Result "Corbin Ashplant reads the summons through his spectacles. He reads the seal. He gets up, with the cold fury of a man who knows precisely what he is looking at and cannot refuse it. 'The Household,' he says. 'At this hour.' He goes out. The door is not locked behind him. He does not leave a candle.".
    Otherwise "The clerk reads it twice. 'A good seal,' he says. 'A bad hand.' He looks at you. 'I shall go and ask.' He does not go. He sits down at his desk where he can see you.".
  }
  Action enter_by_roof(actor: group, site: place) "Go over the roof of the Tower of Coin on Tam's rope and in by the skylight" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, exchange) and openingNight(rierdan) and planTam(actor) and not inCounting(actor).
    Time 10.
    Resolve check(actor, climbing, dc_hard).
    On success { Assert inCounting(actor). Assert at(party, crake_room). }
    On failure { Increase alarm(rierdan) by 2. Assert strikes(roof_fall, actor). }
    Result "Tam throws the hook on the third try. You go up the downpipe like a cat and across the leads on your belly, and the skylight is a pane out of a frame that Tam has had a week to oil. You let yourself down on the rope into the counting-room, which is lit by one candle and smells of Pomfret. Tam, on the roof, coughs, twice, to say it is clear.".
    Otherwise "The rope is too short, or you are. You come down the last ten feet by an arrangement of gutters and let go.".
  }
  Hazard roof_fall "The Tower of Coin's gutters" means "Deal (2d6) physical damage to ally unless dexterity save against (13).".
  Relation inCounting(group).
  Action walk_in_as_clerk(actor: group, site: place) "Walk in at the counting-room door in the clerk's coat, as if you worked there" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, exchange) and openingNight(rierdan) and planPudding(actor) and disguiseHad(actor) and not inCounting(actor).
    Time 2.
    Resolve check(actor, deception, dc_fair).
    On success { Assert inCounting(actor). Assert at(party, crake_room). }
    On failure { Increase alarm(rierdan) by 1. }
    Result "You go in as Jem would, with a pen behind the ear and the expression of a man owed his supper. The night porter says, 'Evening, Mr Dunstable,' and you say, 'Evening,' in a voice that has nothing in it at all.".
    Otherwise "The porter looks at the darn in the cuff, and at your face, and makes a small interrogative noise.".
  }
  Action open_the_box(actor: group, site: place) "Open Master Pomfret's strong-box, with a key or without" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, crake_room) and inCounting(actor) and openingNight(rierdan) and not boxOpened(actor) and (clerkLured(rierdan) or planPudding(actor) or planTam(actor)) and (holding(actor, key_kind) or capable(actor, lockwork)).
    Time 5.
    Resolve check(actor, lockwork, dc_fair).
    On success { Assert boxOpened(actor). Assert noteTaken(actor). Give forged_note to actor. }
    On failure { Increase alarm(rierdan) by 2. }
    Result "The box opens with a sound like a very small cough. Under a velvet bag of crowns and a miniature of Pomfret's late wife there is a single sheet, folded in three, in a hand you have seen on a hundred bills. A. GOSSE. The letters are quite wonderful. You take it, and shut the box, and the velvet bag is where it was.".
    Otherwise "The tumbler turns and sticks. Somewhere in the Tower a floor creaks.".
  }
  Kind forged_note "the note for eighty crowns, in Gosse's hand" is document described "A note of hand for eighty crowns, in a beautiful, shaky copy of Absalom Gosse's signature. The forger has given the G a flourish Gosse never used.".
  Action leave_unseen(actor: group, site: place) "Go out by the way you came, with the paper, before the third act ends" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, crake_room) and noteTaken(actor) and openingNight(rierdan) and alarm(rierdan) < 3.
    Time 2.
    On success { Assert at(party, exchange). }
    Result "The porter says 'Goodnight, Mr Dunstable.' You say it back. The Exchange is empty under the lamps. A beggar on a stool counts three piles of coin and does not look up. The Wick's third-act bell is going down the Row, and you are in the pit, in your own coat, before the Alderman has finished dying.".
  }
  Rule alarm_rings when openingNight(rierdan) and alarm(rierdan) >= 3 and at(party, crake_room) and not caughtInCounting(party)
    says "A bell begins to go in the Tower of Coin, a small, bright, officious bell. The night porter says, in a very different voice, 'Mr Dunstable is in the Wick.' Boots on the stairs." {
    Assert caughtInCounting(party). }
  // The three endings of the night, and not one of them is a verdict.
  Action burn_the_note(actor: group, site: place) "Burn the note in the Wick's ghost-light" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, lant_stage) and holding(actor, forged_note) and not noteBurned(actor).
    Time 0.
    On success { Spend forged_note from actor. Assert noteBurned(actor). Assert noteGone(rierdan). }
    Result "The ghost-light has been out all evening. Gosse relights it himself, at the end, for tradition, and you hold the paper to the flame. It curls round the beautiful G. 'A wonderful forgery,' says Swale, behind you, hoarse. 'I thought so,' says Hepzibah.".
  }
  Action return_note_to_pardew(actor: group, site: place) "Take the note to Mistress Pardew, as promised" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, draper) and holding(actor, forged_note) and disguiseHad(actor) and not noteReturned(actor) and keyCopied(actor).
    Time 0.
    On success { Spend forged_note from actor. Assert noteReturned(actor). Assert noteGone(rierdan). }
    Result "Mistress Pardew holds it over her candle with a pair of sugar-tongs and watches until the last of the G goes. Then she sweeps the ashes into her palm and puts them in the pocket where she keeps the pins. 'Thank you,' she says. It is the only time you will hear her say it.".
  }
  Relation noteGone(place).
  Observe pomfret_next near crake when heistOver(rierdan) and noteGone(rierdan) "Master Pomfret has opened his strong-box, looked at the empty place under the velvet bag, closed it, and sat for a long time with his hands on his knees. He cannot prove a thing. 'Nine years that theatre was dark,' he says, to the miniature, pleasantly. 'I do hope they will be very happy in it.' The Tower of Coin goes on lending. It is not a story that has an end.".
  Observe pomfret_prevails near crake when heistOver(rierdan) and not noteGone(rierdan) "Master Pomfret has the note out on his desk and a pen beside it, and a diary open at Michaelmas. 'Not a very large wedding,' he says. 'Forty guests. A little speech, in the second act. I have written it myself.' He beams. He has the Chamberlain's ear and Lord Rask's, and nobody to whom he need justify himself.".
  Observe caught_net near pomfret_clerk when caughtInCounting(party) "The chief clerk has locked the door of the counting-room with you inside it and gone for the Watch. It is, he says through the keyhole, a very serious thing. He will be perhaps an hour. It is not clear what he thinks you will do in the meantime.".
  Milestone m_plan "chose a plan" worth 100 when planPudding(party) or planDorcas(party) or planTam(party) or planOriel(party).
  Milestone m_note "got the note back" worth 400 when noteTaken(party).
  Milestone m_noted "had the note gone, and nothing to show for it" worth 150 when noteGone(rierdan).
  Relation pomfretBack(place).
  Rule pomfret_returns when openingNight(rierdan) and not pomfretLocked(rierdan) and not pomfretBack(rierdan) and hour(clock) >= 20 and at(party, crake_room) { Assert pomfretBack(rierdan). Increase alarm(rierdan) by 2. }
  Observe dorcas_plan_note near dorcas when planDorcas(party) and openingNight(rierdan) "Dorcas has the gown on. She has the look of a woman who has been told she is the only plan, and has agreed to be.".
}
