Module pentrice "Gosse's Company" {
  // ── The Repertory: the Fourways Circuit ────────────────────────────────────────────────────────────────────────────
  // Once the Wick is theirs and the King's command is set (commandOn) the King's Players are let go on the Fourways road
  // while the Household waits for the King's bell (the Command is held over while the company is away and comes back to
  // three days off when it returns: Act V cannot be reached after, because an Ending closes the book, so the tour has to
  // come before it). The road offers four engagements that each mirror a play they have not yet
  // played: a market town with two pairs of twins (the Comedy of Errors; Act I played one pair and a double), a keep on
  // a moor where three women have said something to a soldier (Macbeth), a Margravate whose prince has been told by a
  // ghost (Hamlet's first act and fourth, where Act II played the third), and a wood where a wedding is to be
  // entertained (the Dream). The company is the company: its people stand in these places as they stood in the Sparrow.
  // Doc: doc/adventures/anthology/the-repertory.md.
  Place wend "the Fourways Circuit" is region.
  Place wend_area "the Fourways country" is wilderness within wend at 1, 1.
  Place wend_cross "the Fourways" is room within wend_area at 1, 1 outdoors.
  Place wend_inn "the Drum and Whistle" is building within wend_area.
  Place wend_taproom "the Drum and Whistle's taproom" is room within wend_inn at 1, 2.
  Passage wend_road "the Fourways road" is road between river_gate and wend_cross taking 1 hour
    opening when commandOn(rierdan) and commandDay(rierdan) > day(clock) "The Fourways road goes out under the gate, but the Wick is lit tonight, or the King's Players have not yet been given leave to go on it.".
  Passage wend_door "the inn door" is door between wend_cross and wend_taproom.
  Observe wend_cross_scene at wend_cross when true "Four roads and a milestone, and a signpost that has lost three of its arms to boys with knives. The fourth points up the hill to a village whose name has been scratched off and written again in chalk: MARLCROSS. The inn has a drum on its sign and a whistle painted under it, and the whistle is the more convincing.".
  Observe wend_taproom_scene at wend_taproom when true "A long low room with a fire, a settle, a window onto the road, and a table that has been the company's table for as long as the company has been this far out of the city. Hepzibah's book is open on it, and a heap of letters.".

  Relation toured(group). Relation tourOn(place).
  Relation touredFrom(group, place). Relation tourAway(place).
  Rule tour_begins when commandOn(rierdan) and not tourOn(rierdan) { Assert tourOn(rierdan). }
  Rule tour_gathers when tourOn(rierdan) and at(party, wend_cross) and troupe(?p) and distinct(?p, clemency) and not toured(?p) and at(?p, ?q) {
    Retract at(?p, ?q). Assert at(?p, wend_taproom). Assert toured(?p). Assert touredFrom(?p, ?q). Assert tourAway(rierdan). }
  Rule tour_regather when tourOn(rierdan) and at(party, wend_cross) and toured(?p) and not at(?p, wend_taproom) and at(?p, ?q) { Retract at(?p, ?q). Assert at(?p, wend_taproom). }
  // The Command waits on the company: held while it is on the road, and set three days off when it comes home.
  Rule tour_holds when tourAway(rierdan) and not tourHomeSet(rierdan) and commandOn(rierdan) and not commandDone(rierdan) and commandDay(rierdan) <= day(clock) + 1 {
    Set commandDay(rierdan) to day(clock) + 2. }
  Rule tour_home when tourAway(rierdan) and at(party, river_gate) and toured(?p) and touredFrom(?p, ?h) and at(?p, ?q) {
    Retract at(?p, ?q). Assert at(?p, ?h). Retract toured(?p). Retract touredFrom(?p, ?h). }
  Rule tour_home_clock when tourAway(rierdan) and at(party, river_gate) and not tourHomeSet(rierdan) {
    Assert tourHomeSet(rierdan). Set commandDay(rierdan) to day(clock) + 1. }
  Rule tour_homed when tourAway(rierdan) and tourHomeSet(rierdan) and at(party, river_gate) and not toured(gosse) and not toured(hepzibah) {
    Retract tourAway(rierdan). Retract tourHomeSet(rierdan). }
  Relation tourHomeSet(place).

  // The letters, and where each one points. One topic opens all four ways from the Cross.
  Relation e1Open(place). Relation e2Open(place). Relation e3Open(place). Relation e4Open(place).
  Relation e1Done(place). Relation e2Done(place). Relation e3Done(place). Relation e4Done(place).
  Relation epRep1(place). Relation epRep2(place). Relation epRep3(place). Relation epRep4(place).
  Topic hz_letters with hepzibah "Ask Hepzibah what is in the heap of letters" when tourOn(rierdan) once {
    Says "'Four,' says Hepzibah, without looking up. 'A market town that has been told we play in the King's livery and would like to see it. A soldier on the moor who wants a company to cheer his garrison, and who has also, I notice, asked for an opinion on some women. A Margravate that needs players for a prince it is rather worried about. And a squire who is to be married in a wood, and wants us to play at it, because his bride has read that this is done.' She turns a page. 'They have all offered money. I have no confidence in any of them. Choose.'".
    On discuss { Assert e1Open(rierdan). Assert e2Open(rierdan). Assert e3Open(rierdan). Assert e4Open(rierdan). }
  }
  Observe rp_board_done at wend_taproom when repertoire(rierdan) >= 2 "On the board over the settle, in Hepzibah's hand, the list of what the King's Players can play has grown past the width of the board. Someone has pinned a second sheet.".

  // Four ways out of the Cross.
  Passage to_marlcross "the lane to Marlcross" is road between wend_cross and m_square taking 30 minutes
    opening when e1Open(rierdan) "The lane up the hill to the village has not been opened by anyone you know.".
  Passage to_moor "the moor road" is road between wend_cross and moor_cairns taking 1 hour
    opening when e2Open(rierdan) "The moor road is the one with the milestone knocked over.".
  Passage to_harrowmere "the Margravate road" is road between wend_cross and hm_gate taking 2 hours
    opening when e3Open(rierdan) "The east road runs on toward a country the company has not been asked to.".
  Passage to_hollin "the green ride into the wood" is path between wend_cross and wd_lawn taking 1 hour
    opening when e4Open(rierdan) "A ride goes into the beech wood on the south side. The squire's letter has not been read.".

  // A play, once performed, joins the repertoire; each episode's ending sets its eNDone and these count it once.
  Rule rp_rep1 when e1Done(rierdan) and not e1Chaos(rierdan) and not epRep1(rierdan) { Assert epRep1(rierdan). Increase repertoire(rierdan) by 1. }
  Rule rp_rep2 when e2Done(rierdan) and not e2Murder(rierdan) and not epRep2(rierdan) { Assert epRep2(rierdan). Increase repertoire(rierdan) by 1. }
  Rule rp_rep3 when e3Done(rierdan) and not e3Grave(rierdan) and not e3Bellerophon(rierdan) and not e3TurnedAway(rierdan) and not e3Misdelivered(rierdan) and not e3Dismissed(rierdan) and not e3Held(rierdan) and not epRep3(rierdan) { Assert epRep3(rierdan). Increase repertoire(rierdan) by 1. }
  Rule rp_rep4 when e4Done(rierdan) and (e4Acted(rierdan) or e4Left(rierdan)) and not epRep4(rierdan) { Assert epRep4(rierdan). Increase repertoire(rierdan) by 1. }

  // What the road did for the company is Act V's own: repertoire raises standingR there (+1 at two plays, +1 at four), and that
  // is the only chaos slack the tour buys. This file adds nothing to it. Two things of the road are read on the night, though:
  // Swale who was kind to the Prince's speech blurts more gently (the blurt costs a point less), and the name paid in the wood
  // is missing from the Chamberlain's roll.
  Rule rp_loom_fan when holdingCommand(rierdan) and e4LoomFree(rierdan) and not loomFan(rierdan) { Assert loomFan(rierdan). Increase standingR(rierdan) by 1. }
  Observe rp_loom_fan_told at lant_stage when loomFan(rierdan) "In the second tier a large happy man in a wool mantle laughs half a beat before the joke and everyone else takes the cue from him. The scene recovers. He is the weaver from Hollin; he said he had always wanted to see how it was done.".
  Rule rp_pyramus_brave when holdingCommand(rierdan) and pyramusPlayed(rierdan) and not pyramusPaid(rierdan) { Assert pyramusPaid(rierdan). Decrease chaos(rierdan) by 1 or to nothing. }
  Relation pyramusPaid(place). Relation loomFan(place). Relation swaleSoftened(place). Relation nameRoll(place).
  Rule rp_swale_soft when swaleBlurted(rierdan) and swaleHand(party) and not swaleSoftened(rierdan) { Assert swaleSoftened(rierdan). Decrease chaos(rierdan) by 1 or to nothing. }
  Observe rp_swale_soft_told at lant_stage when swaleSoftened(rierdan) "Swale's cry in the third row ends, this time, in a sort of apology to the Prince of Harrowmere, whom nobody present has met. It costs the house a laugh and not the scene.".
  Rule rp_name_roll when holdingCommand(rierdan) and e4Price(rierdan) and not nameRoll(rierdan) and at(party, lant_stage)
    says "The Chamberlain's clerk reads out the company's names for the King's book. He reads yours, and then reads it again, and looks up, blank. 'Is there,' he says, 'a name that goes there?' There is a pause that the King notices." {
    Assert nameRoll(rierdan). Increase chaos(rierdan) by 1. }
}
