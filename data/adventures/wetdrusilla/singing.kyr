Module wetdrusilla "Wet Drusilla" {
  Hazard dune_fall "A fall down the dune" means "Deal (1d6) physical damage to ally unless dexterity save against (12).".

  // ── The Singing ───────────────────────────────────────────────────────────────────────────────────────────────────
  // The second night, in the dune-bowl. Stopped ears keep the company safe and deaf. A low note held keeps the whole deck
  // safe, Sunniva too. Otherwise Sunniva walks up the lee slope in her sleep with the urn, and sings her verse to the dark.
  Action stop_ears(actor: group) "Stop your ears with Bartle's wax" {
    Requires able(actor) and company(actor) and at(actor, deck) and holding(actor, ds_wax) and not waxed(actor) and leg() == 3.
    Time 1 minute.
    On success { Assert waxed(actor). }
    Result "You warm the wax in your fist and press it in. The Mary goes quiet as a held breath, and your own pulse comes up in the middle of the quiet like a man knocking.".
  }
  Action hold_note(actor: group) "Hold the low note against the Singing until it is light" {
    Requires able(actor) and company(actor) and at(actor, deck) and knows(actor, low_note) and leg() == 3 and day(clock) == 2 and hour(clock) >= 18 and not guarded(actor).
    Time 8 hours.
    Meanwhile guarded(actor).
    Result "You sit with your back to the mast and find the note, down under your breastbone where Perpetua put it, and hold it. Above the bowl the hum climbs, and tries your note, and slides off it like water off a roof. Around two the Captain brings you a cup and says nothing at all. Toward four the slopes go quiet one by one, and the dunes lie down.".
  }
  Rule night_calm when leg() == 3 and day(clock) >= 3 and hour(clock) >= 1 and hour(clock) < 5 and not nightPassed(party) and guarded(party)
    says "Deep in the night, with your note under it, the Singing has nothing to hold. Sunniva Cleat sleeps on the deck with the bag in both arms and her mouth a little open, and does not stir." {
    Assert nightPassed(party). Increase warmth() by 1.
  }
  Rule night_walk when leg() == 3 and day(clock) >= 3 and hour(clock) >= 1 and hour(clock) < 5 and not nightPassed(party) and not guarded(party) and not waxed(party)
    says "The hum finds you at one in the morning and goes through you like a hand through water. You are on your feet. You are at the lee rail. Then you are at the foot of a dune with sand in your mouth and one boot gone, and the Mary's lamp very high above you. At the rail, where Sunniva Cleat was, there is nobody." teaches bowl_seen {
    Assert nightPassed(party). Assert strikes(dune_fall, party). Retract at(sunniva, deck). Assert at(sunniva, crest). Assert state(dune_ladder_t, dropped).
  }
  Rule night_walk_deaf when leg() == 3 and day(clock) >= 3 and hour(clock) >= 1 and hour(clock) < 5 and not nightPassed(party) and not guarded(party) and waxed(party)
    says "The wax holds. In the silence you see Sunniva Cleat get up from the deck like a woman who has been called, and go to the lee rail, and down the ladder with the bag in her arms, and up the long slope of the dune with her face turned to the stars. Her mouth is moving." teaches bowl_seen {
    Assert nightPassed(party). Retract at(sunniva, deck). Assert at(sunniva, crest). Assert state(dune_ladder_t, dropped).
  }
  Rule heard_eight when at(sunniva, crest) and at(party, crest) and not waxed(party) and not knows(party, verse_8)
    says "She is singing. She stands on the crest with the bag open in her arms and the stars over her, and the Chorus hums under her voice like a cello under a girl. 'She left a basket on the quay with a jib / and a name pinned to the hem; / the jib was the best that she ever rigged, / and she never came back for them.' Then she sings it again, from the beginning, and her eyes are shut. You know what you have heard, and it was not given." teaches verse_8 {
    Increase verses() by 1.
  }
  Observe crest_deaf at crest when at(sunniva, crest) and waxed(party) "Sunniva Cleat stands on the crest with the urn open in her arms. Her mouth is moving. You hear your own blood, and nothing else.".
  Action walk_back(actor: group) "Take Sunniva's arm and walk her back down to the Mary" {
    Requires able(actor) and company(actor) and at(actor, crest) and at(sunniva, crest).
    Time 15 minutes.
    On success { Assert walkedBack(actor). Retract at(sunniva, crest). Assert at(sunniva, deck). Assert state(dune_ladder_t, stowed). }
    Result "She comes without resistance, as the sleeping do. Halfway down the ladder her eyes open, and she looks at you, and at the sand, and at her own hands on the bag. Neither of you says anything. On the deck she sits down against the mast and holds the bag in her lap and does not look up until the stars begin to go.".
  }
  Rule sunniva_back when at(sunniva, crest) and day(clock) >= 3 and hour(clock) >= 4 and not walkedBack(party)
    says "At four she comes down the dune alone, in the grey, with sand in her hair and her face quite empty. A thread of ash is on her sleeve. The bag is lighter than it was, and she knows it by the way it hangs. She sits against the mast, and says nothing, and will not meet anybody's eye." {
    Retract at(sunniva, crest). Assert at(sunniva, deck). Assert ashesLost(party). Decrease warmth() by 1 or to nothing. Assert state(dune_ladder_t, stowed).
  }
  Topic sunniva_heard with sunniva "Tell Sunniva you heard her on the dune" when walkedBack(party) and knows(actor, verse_8) once {
    Says "She is quiet for the length of a long breath. 'Then you have it,' says Sunniva Cleat. 'I did not give it.' She looks at the bag. 'I have sung it every night since the will was read, with the door shut. It is a very bad verse. It is not even well made.' Her mouth does something. 'Thank you for not making a speech. Don't sing it for me.'".
    On discuss { Increase warmth() by 1. }
  }
}
