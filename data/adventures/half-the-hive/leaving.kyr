Module hume "Half the Hive" {
  // ── Who goes ──────────────────────────────────────────────────────────────────────────────────────────────────────
  // Settled the moment she goes, from what each has come to: Kestrel and the Searchers always; Moss unless hurt; Hannet
  // if promised and the way is one she can be carried, or if she is still dancing for the tree it goes to; Linnet if
  // she knows Eben means to go; Eben unless he alone knows Linnet means to stay; Pim if Linnet does not; Agnes if she may
  // carry Tobit, has his likeness, or knows he is safe; Huw and the Drewes always; Ivo, if he is a Searcher and not with
  // the company. Whoever goes is at the camp that night; whoever stays is where they are.
  Relation goes(group). Relation stays(group). Relation decided(group).
  Rule decide_kestrel when leavingBegun() and not decided(kestrel) { Assert goes(kestrel). Assert decided(kestrel). }
  Rule decide_moss when leavingBegun() and not decided(moss) and not mossHurt(moss) and not travelsWith(moss, party) { Assert goes(moss). Assert decided(moss). }
  Rule decide_hannet_carried when leavingBegun() and not decided(hannet) and promiseMade(carry_hannet) and (not left(far_brow) or kestrelTurned(kestrel)) { Assert goes(hannet). Assert decided(hannet). }
  Rule decide_hannet_tree when leavingBegun() and not decided(hannet) and dancesFor(hannet, gallowtree) and left(gallowtree) { Assert goes(hannet). Assert decided(hannet). }
  Rule decide_linnet when leavingBegun() and not decided(linnet) and linnetKnows(linnet) { Assert goes(linnet). Assert decided(linnet). }
  Rule decide_eben when leavingBegun() and not decided(eben) and (linnetKnows(linnet) or not ebenKnows(eben)) { Assert goes(eben). Assert decided(eben). }
  Rule decide_pim when leavingBegun() and not decided(pim) and not linnetKnows(linnet) { Assert goes(pim). Assert decided(pim). }
  Rule decide_agnes when leavingBegun() and not decided(agnes) and (linnetPermitsDead(linnet) or likenessGiven(agnes) or agnesFreed(agnes)) { Assert goes(agnes). Assert decided(agnes). }
  Rule decide_huw when leavingBegun() and not decided(huw) { Assert goes(huw). Assert decided(huw). }
  Rule decide_drewes when leavingBegun() and not decided(drewes) { Assert goes(drewes). Assert decided(drewes). }
  Rule decide_ivo when leavingBegun() and not decided(ivo) and ivoSearcher(ivo) and not travelsWith(ivo, party) { Assert goes(ivo). Assert decided(ivo). }
  // To the camp.
  Rule goers_walk when left(?s) and siteRoom(?s, ?r) and goes(?x) and not walked(?x) { Assert at(?x, ?r). Assert walked(?x). }
  Relation walked(group).
  Rule linnet_stays_home when leavingBegun() and not goes(linnet) and decided(pim) and not walked(linnet) { Assert at(linnet, royal_gallery). Assert walked(linnet). }
  Rule pim_stays_home when leavingBegun() and goes(linnet) and not walked(pim) { Assert at(pim, royal_gallery). Assert walked(pim). }
  // Agnes carries him: the bier is empty.
  Rule tobit_carried when goes(agnes) and linnetPermitsDead(linnet) and at(tobit_bier, capped_gallery) { Assert at(tobit_bier, limbo). }

  // ── Crossed, on the Apron ─────────────────────────────────────────────────────────────────────────────────────────
  Rule lovers_cross at apron when leavingBegun() and goes(eben) and not goes(linnet) and not spread(lovers_cross) says "At the foot of the stair two people pass each other in the crowd: a long-faced man in a travelling cloak with a Waxwright's roll of blades on his back, going out after the bees, not looking back; and a young woman with a shaved head and Sisters on her arms, coming in, not looking at anyone. They do not see each other. The crowd closes between them." { Assert spread(lovers_cross). }
  Entity lovers_cross: fact "the lovers crossed".
  Rule pim_goes_told at apron when leavingBegun() and goes(pim) and not spread(pim_goes_told) says "At the head of the going, beside Kestrel, walks the keeper's novice, Pim Garnock, seventeen, with his shaved head sunburnt and his arms held out stiffly from his sides because they are covered in Sisters, and his face set like a boy's at his first funeral." { Assert spread(pim_goes_told). }
  Entity pim_goes_told: fact "Pim at the head of it".

  // ── The founding night ────────────────────────────────────────────────────────────────────────────────────────────
  // Wherever she went, the first evening, told to a company that is there.
  Query atCamp() means left(?s) and siteRoom(?s, ?r) and at(party, ?r).
  Rule founding at far_hollow when left(far_brow) and at(party, far_hollow) and day(clock) <= leftDay(hume_wold) + 1 and not spread(founding)
    says "By the time the last of the Leaving comes in under the Far Brow it is nearly dark, and the swarm has already hung itself from the rock, a great brown beard of bees as long as a barn, roaring softly; and at its top, where it touches the stone, the Sisters have begun to build. You can see it if you stand close: a first finger of new comb, white as milk, the whitest thing in the world, growing while you watch. Nobody has any strength left. Someone lights a fire, which they never do at home. Somebody passes round a crock of honey and a knife. And then, for no reason, very badly, too tired to sing, two hundred people sing: the hum, the old note under everything, sitting on the warm dust under the Far Brow with the white comb growing over their heads; and Kestrel Dunn sits by the child-handprints at the back with her knees up and her face hidden." { Assert spread(founding). }
  Rule founding_far_drove at far_hollow when left(far_brow) and at(party, far_hollow) and spread(founding) and kestrelTurned(kestrel) and not spread(founding_far) says "The old came by the shepherds' drove, slow, with the bothy to rest in. Hannet Coke was carried in on the Searchers' litter at dusk, by four of them and a man in a yellow coat, telling them all the way how to do it." { Assert spread(founding_far). }
  Rule founding_far_crag at far_hollow when left(far_brow) and at(party, far_hollow) and spread(founding) and not kestrelTurned(kestrel) and not spread(founding_far) says "They came by the crag, fast, with smoke, the way Kestrel always went. Not everyone who set out is here. The old stayed home, mostly, knowing; and of those who tried it, some turned back, and the black bees took a few. Kestrel goes along the line with her face set, counting." { Assert spread(founding_far). }
  Entity founding_far: fact "the way to the Far Brow".
  Rule founding_dell at dell_floor when left(chalk_dell) and at(party, dell_floor) and day(clock) <= leftDay(hume_wold) + 1 and not spread(founding)
    says "The swarm goes into the cave in the chalk like smoke going up a chimney, and in an hour there is a roar inside it like a sea-cave, and the Leaving sits down on the warm floor of the Dell among the harebells, too tired to talk. The white walls hold the day's heat long after sunset. Someone finds the first new comb in the cave mouth by lamplight, white as milk, a hand's breadth already, and carries the news out, and then, too tired to sing, they sing: the hum, two hundred voices in a bowl of chalk that gives it back." { Assert spread(founding). }
  Rule founding_dell_truce at dell_floor when left(chalk_dell) and at(party, dell_floor) and spread(founding) and brockTruce(brocks) and not spread(founding_dell2) says "At the back of the Dell, outside a smaller hole in the chalk, two brock sows lie in the last of the sun with their chins on their paws, watching the new town with their small black eyes, and nobody is afraid of them. Moss Ashdown, sitting as near them as he dares, is cutting fresh dance-marks into the chalk under the old ones, for whoever comes next." { Assert spread(founding_dell2). }
  Rule founding_dell_blood at dell_floor when left(chalk_dell) and at(party, dell_floor) and spread(founding) and brocksKilled(brocks) and not spread(founding_dell2) says "The children have been told not to go near the back of the Dell, where the chalk is stained and the flies are. They go anyway, and come back quiet." { Assert spread(founding_dell2). }
  Rule founding_dell_brocks at dell_floor when left(chalk_dell) and at(party, dell_floor) and spread(founding) and not brocksSafe() and not spread(founding_dell2) says "Nobody sleeps. The brocks were driven out of the cave by the bees, and they are somewhere in the dark at the back of the Dell, and every so often one of them coughs, low, like a man clearing his throat in the next room." { Assert spread(founding_dell2). }
  Entity founding_dell2: fact "the brocks at the founding".
  Rule founding_lark at chantry_yard when left(larkhill) and at(party, chantry_yard) and day(clock) <= leftDay(hume_wold) + 1 and not spread(founding)
    says "The swarm goes into the chantry tower at Larkhill through the louvres of the belfry, a brown river pouring upward, and the tower hums like a struck bell. The Leaving sits down in the walled yard and in the lane outside it. In the farmhouse windows the squire's household stands looking out at them. It is dry, and safe, and the lowland is a morning's walk away, and nobody sings." { Assert spread(founding). }
  Rule founding_lark_gift at chantry_yard when left(larkhill) and at(party, chantry_yard) and spread(founding) and corveGives(corve) and not spread(founding_lark2) says "At the gate Squire Corve stands with his hat in his hands, not coming in, until Linnet goes down to him with the jar, and draws her fingers down his forehead, his throat, his wrists, and says the words under her breath; and a Sister lands on his sleeve and walks up it and tastes his face, and walks away. Then they do sing. He stands in the middle of it with his hat crushed in his fist and does not know the tune, and hums it anyway, wrong." { Assert spread(founding_lark2). }
  Rule founding_lark_owned at chantry_yard when left(larkhill) and at(party, chantry_yard) and spread(founding) and not corveGives(corve) and not spread(founding_lark2) says "At dusk Halse the bailiff comes out of the farmhouse with a hammer and a board and, not looking at anyone, nails the board to the chantry gate: THESE BEES AND ALL THEY MAKE THE PROPERTY OF L. CORVE ESQ. OF LARKHILL. TRESPASSERS PROSECUTED. In an upper window of the farmhouse the squire stands, quite still, looking down at the yard full of people who will not look up." { Assert spread(founding_lark2). }
  Entity founding_lark2: fact "the squire at the founding".
  Rule founding_gallow at gallow_knoll when left(gallowtree) and at(party, gallow_knoll) and day(clock) <= leftDay(hume_wold) + 1 and not spread(founding)
    says "The swarm goes into the Gallowtree through the door in the trunk and the cracks in its crown, and the old tree roars from root to leaf like a forest in a gale, and the Leaving sits down on the knoll in the long evening light. It was a short walk. Everyone came: the old, the lame, the women with children. Linnet goes inside with the first of the Searchers to see where the bees are building, and comes out after a while, and sits down by herself on the far side of the knoll, and does not say what she saw." { Assert spread(founding). }
  Rule founding_gallow_know at gallow_knoll when left(gallowtree) and at(party, gallow_knoll) and spread(founding) and knows(party, gallow_rotten) and not spread(founding_gallow2) says "In the night it rains a little. You lie awake on the knoll and listen to the water going into the tree through the cracks in its crown, and down inside it, slowly, drip by drip, into the soft heart." { Assert spread(founding_gallow2). }
  Entity founding_gallow2: fact "rain in the Gallowtree".
  Rule founding_bivouac at honey_oak when left(high_wold) and at(party, honey_oak) and day(clock) <= leftDay(hume_wold) + 1 and not spread(founding)
    says "The swarm never decided. It came out of the Brow, and hung in the lindens a while, roaring, waiting for a word that did not come; and in the end it settled on the honey linden, on a great bough in the open air, and began, because it could not help it, to build: white comb hanging from the bark in the wind and the sun, beautiful, unsheltered, for anything to take. The Leaving sits in the clearing under it and does not know what to do." { Assert spread(founding). }
  Entity founding: fact "the founding night".
  // Named to the hive: whoever walked with them, at the founding; the keeper of the Leaving does it.
  Rule named_at_founding when walkedWith(party) and spread(founding) and atCamp() and not named(party)
    says "Late, by the fire, the keeper of the Leaving comes and kneels in front of you with the jar of the Mother's own scent, and draws two fingers down your forehead, your throat, the insides of your wrists, behind your ears, saying the words under the breath that have the hum's tune; not the guest's anointing, but the other one, the one for a child. 'You walked with us,' is all that is said. A Sister on the rock above you turns her head toward you, and away, as if you had always been here." { Assert named(party). }
  Rule named_founder when named(party) and partyDances(?s) and left(?s) and atCamp() and not spread(founder_named) says "And they tell you, as if it were a small thing, what the Leaving has decided to call the new comb, in the Wold way, after the first Searcher who danced for it who was not born to it. It is your name. They say it oddly, with the hum in it. It will be on the maps of the Wold for four hundred years, said wrong." { Assert spread(founder_named). }
  Entity founder_named: fact "the comb named for you".
  // The brocks come in the night, to a Dell where nothing was done about them.
  Rule brocks_raid at dell_floor when left(chalk_dell) and not brocksSafe() and able(brocks) and night() and day(clock) >= leftDay(hume_wold) and not raided(brocks) says "In the small hours the brocks come back for their cave. Two grey shapes out of the dark at the back of the Dell, low and fast, into the sleeping Leaving, and the screaming starts." {
    Assert raided(brocks). Assert at(brocks, dell_floor). Retract peaceable(brocks). }
  Relation raided(group).
  Rule brocks_assail_camp when raided(brocks) and at(brocks, dell_floor) and at(party, dell_floor) and able(brocks) and not assails(brocks, party) and not tolerates(brocks, party) and night() { Assert assails(brocks, party). }
}
