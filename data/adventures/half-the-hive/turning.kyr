Module hume "Half the Hive" {
  // ── The flight, and the Turning-out ───────────────────────────────────────────────────────────────────────────────
  // Two days after the Leaving the new queen flies from the Toot, and the Escort walks behind her up the hill in yellow;
  // at dusk the Escort is taken down to Smoke End with a cloak and a loaf apiece and pointed at the lowland. Ivo is among
  // them unless he is a Searcher, or with the company, or gone with the Leaving.
  Relation flown(group). Relation turnedOut(group).
  Rule flight when flightDay() and hour(clock) >= 10 and not flown(escort) { Assert flown(escort). Assert at(escort, toot). }
  Rule flight_seen at toot when flown(escort) and at(party, toot) and not spread(flight_seen) says "Up the Toot in the morning sun comes the Escort, a dozen men and women in their best yellow, walking in pairs, very slowly, very upright, singing something old with no words; and ahead of them, walking too, in the grass, a long gold shape with her new wings folded: the queen. At the standing stone they stop and stand round it in a ring. She climbs the stone. She stands on the top of it a long moment, trembling, with her wings opening and closing. Then she goes up, straight up, into the blue, faster than you would believe, and is a speck, and is nothing; and from all over the Toot, out of the air, out of nowhere, comes the deep rich droning of a thousand drones going up after her. The Escort stand round the stone with their faces turned up, admiringly, as they were born to, until there is nothing left to look at." { Assert spread(flight_seen). }
  Rule flight_heard when flown(escort) and within(party, hume_brow) and not spread(flight_seen) says "From up the Toot comes singing, old and wordless, and then a sound like the whole sky humming, and then quiet." { Assert spread(flight_seen). }
  Entity flight_seen: fact "the wedding flight".
  Rule turning_out when flightDay() and hour(clock) >= 18 and not turnedOut(escort) { Assert turnedOut(escort). Assert at(escort, smoke_street). }
  Rule ivo_turned when turnedOut(escort) and not ivoSearcher(ivo) and not travelsWith(ivo, party) and not goes(ivo) and not ivoTurnedOut(ivo) { Assert ivoTurnedOut(ivo). Assert at(ivo, drove_end). }
  Rule turning_seen at smoke_street when turnedOut(escort) and at(party, smoke_street) and not spread(turning_seen) says "At dusk they bring the Escort down the gorge. Not roughly: Elspet Garnock walks in front with her staff, and two of the Hum-keepers walk behind, and between them come the yellow coats, a dozen of them, blinking, dusty from the Toot. At the end of the street, where the drove road begins, Elspet gives each of them a brown cloak and a round loaf, and says the same words to each, which are thank you; and turns round; and walks back up the gorge without looking back, because that is the custom. The Escort stand at the end of the street of Smoke End in their yellow coats with their loaves under their arms, looking down the drove road at the lowland going blue in the dusk. One of them starts to laugh, and stops. Martin Sayle comes out of the Smoker's Rest and stands in his doorway, and says, 'Well, come in, then, the lot of you. First night's on the house. It always is.'" { Assert spread(turning_seen). }
  Entity turning_seen: fact "the Turning-out".
  Observe escort_out at smoke_street when turnedOut(escort) and at(escort, smoke_street) "A dozen people in dusty yellow coats sit along the bench outside the Smoker's Rest with brown cloaks over their knees, eating their loaves very slowly.".
  Observe ivo_at_edge at drove_end when ivoTurnedOut(ivo) and at(ivo, drove_end) "Where the turf meets the hedges a tall man in a dusty yellow coat is sitting on a milestone with a loaf on his knee, looking down the road.".
  Rule escort_remark when ivoTurnedOut(ivo) and at(party, drove_end) and at(ivo, drove_end) and not spread(escort_remark) says "Ivo Gildersleeve looks up from his milestone and lifts his loaf to you in salute. 'Turned out,' he says. 'With a cloak. They give you a cloak, did you know? Nobody tells you about the cloak.'" { Assert spread(escort_remark). }
  Entity escort_remark: fact "Ivo on the milestone".
  // A Searcher is paid; the Escort is fed. A Searcher is not turned out.
  Rule ivo_kept at smoke_street when turnedOut(escort) and ivoSearcher(ivo) and at(party, smoke_street) and not goes(ivo) and not spread(ivo_kept) says "Ivo is not among them. When Elspet reached his name on her slate at the Toot, there was a boy at her elbow, out of breath, sent back across the Wold by Kestrel Dunn with four words: Searcher. Paid. Strike it. And Elspet looked at the boy a long time, and struck it." { Assert spread(ivo_kept). }
  Entity ivo_kept: fact "Ivo kept".
}
