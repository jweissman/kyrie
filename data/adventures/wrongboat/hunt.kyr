Module wrongboat "The Wrong Boat" {
  // ── The hunt ──────────────────────────────────────────────────────────────────────────────────────────────
  // A pursuit that seeks a fixed place is an itinerary. These seek the company: one for each room it can stand in
  // (`seeks the company`; they had been sixty lines, one a room for each), taken up while the hunt is on, hiding or not (a hidden company is searched for, not forgotten), so that Bess (and, once the company has passed the race-head, the lads) go to
  // where the company is, by the ways that are open, and stop when they are there.
  Query huntBess() means not bessAlly(party) and not bessMet(party) and since(14) and (trailLostAt(party) == 0 or watch(clock) >= trailLostAt(party) + 30) and not bessTook(party) and not boxReturned(party).
  Query huntLads() means not ladsDealt() and not escort() and (ladsMet(party) or been(party, ferry_stage)).
  Pursuit hunt_bess for bess "coming for you" priority 8 when huntBess() seeks the company.
  Pursuit hunt_lads for lads "coming for the box" priority 8 when huntLads() seeks the company.
}
