Module wrongboat "The Wrong Boat" {
  // ── The clock, the barge and the chasers ───────────────────────────────────────────────────────────────────────
  // Time is counted from the morning the company first stands on the Staithe quay (t0, in ten-minute watches). The
  // Mary lies at each landing for a spell and goes on; Bess Lowther comes after by the road, and Mudge's two lads
  // by the road too, to a place of their own. What the company hears of where they are is not always so.
  Measure t0(). Measure stageNow(). Measure lookedAt(group). Measure ladsSetOut().
  Query bargeAt(n: number) means stageNow() == n.
  Query since(n: number) means t0() > 0 and watch(clock) >= t0() + n.
  Query ferryCrossing() means ferryPaid(party).
  Relation hiding(group). Relation disguised(group). Relation confronted(group). Relation looked(group).
  Relation decoyLaid(group). Relation decoyFound(group). Relation ferryPaid(group). Relation bessMet(group).
  Relation boxReturned(group). Relation caught(group). Relation sold(group). Relation ladsSwept(group).

  Rule begin when at(party, quay) and t0() == 0 { Set t0() to watch(clock) + 1. Set stageNow() to 1. }
  // The Mary: at Staithe to +9, on the water, at the fen +36 to +50, at Pelham +90 to +120, at the race-head
  // +150 to +170, at the Highfoot stage from +200 for good.
  Rule at_staithe when t0() > 0 and watch(clock) < t0() + 9 and stageNow() != 1 { Set stageNow() to 1. }
  Rule afloat_a when since(9) and watch(clock) < t0() + 36 and stageNow() != 0 { Set stageNow() to 0. }
  Rule at_fen when since(36) and watch(clock) < t0() + 50 and stageNow() != 2 { Set stageNow() to 2. }
  Rule afloat_b when since(50) and watch(clock) < t0() + 90 and stageNow() != 0 { Set stageNow() to 0. }
  Rule at_pelham when since(90) and watch(clock) < t0() + 120 and stageNow() != 3 { Set stageNow() to 3. }
  Rule afloat_c when since(120) and watch(clock) < t0() + 150 and stageNow() != 0 { Set stageNow() to 0. }
  Rule at_race when since(150) and watch(clock) < t0() + 170 and stageNow() != 4 { Set stageNow() to 4. }
  Rule afloat_d when since(170) and watch(clock) < t0() + 200 and stageNow() != 0 { Set stageNow() to 0. }
  Rule at_stage when since(200) and stageNow() != 5 { Set stageNow() to 5. }

  // Where the Mary lies, told from her deck.
  Relation castOff(group).
  Rule casts_off at deck when at(party, deck) and since(9) and not castOff(party)
    says "Dolly takes her pipe out. 'Cast off!' she shouts, to the world. Shim has the bow-rope in his hands before she finishes, and the quay goes backward as if somebody had pulled it, with Mother Cobbold on it getting smaller, shouting something about eleven shillings." {
    Assert castOff(party). }
  Observe mary_gone at quay when since(9) "The Patient Mary has gone. Where she lay there is a stripe of clean water, and a child on the bollard staring at it.".
  Observe water_slides at deck when bargeAt(0) and since(9) "The banks slide past at a walking pace. A heron lifts and settles. Forward, Shim is telling the river what he thinks of it.".
  Observe lies_fen at deck when bargeAt(2) "The Mary lies against the fen landing with her nose in the reeds. Dolly is leaning on the tiller, eating an onion like an apple.".
  Observe lies_fair at deck when bargeAt(3) "The Mary has taken a place on the fourth tier at Pelham quay, three barges out from the bank. Across their decks the fair is a wall of noise.".
  Observe lies_race at deck when bargeAt(4) "The Mary sits at the race-head with the lock-gate shut ahead of her and the miller's boy, on the lever, asleep.".
  Observe lies_stage at deck when bargeAt(5) "The Mary has run out of river. Dolly has tied her to the Highfoot stage for good and gone to look for a drink.".

  // A second land way, long and dry and over the downs: the sergeant's men take it, and so may anyone.
  Passage back_road "the high back road" is road between road and horse_lines taking 6 hours.
  // The way by land, for the one who cannot wait for a barge.
  Passage old_fen_road "the old fen road" is road between road and fen_landing taking 5 hours.

  // The chasers.
  Person bess "Bess Lowther" at toll_counter {
    Role "a toll-clerk, owed three months' wages". Ancestry human. Calling commoner. Level 1. Peaceable. Pronouns she. Manner stoic.
    Uses go. Plans 24 steps.
    Greets "A broad woman of forty-odd in a clerk's black sleeves, with a coin-scale in one hand and nothing in the other, turns from a barge-list and looks at you for the length of time it takes to count. 'You are not who I'm looking for,' she says. 'Or you are, and you are better at it than he was.'".
  }
  Pursuit bess_fen for bess "going by the old fen road" priority 1 when not bessAlly(party) and since(20) seeks at(bess, fen_landing).
  Pursuit bess_fair for bess "going on to Pelham fair" priority 2 when not bessAlly(party) and since(100) seeks at(bess, fairground).
  Pursuit bess_mill for bess "going down the river road" priority 3 when not bessAlly(party) and since(140) seeks at(bess, millyard).
  Pursuit bess_stage for bess "going on to Highfoot" priority 4 when not bessAlly(party) and since(190) seeks at(bess, ferry_stage).
  Pursuit bess_foot for bess "crossing at last" priority 5 when not bessAlly(party) and since(240) and ferryPaid(party) seeks at(bess, hill_foot).
  Pursuit bess_decoy for bess "gone to look at the eel-stage" priority 9 when decoyLaid(party) and not decoyFound(party) seeks at(bess, eel_stage).
  Rule decoy_found when decoyLaid(party) and not decoyFound(party) and at(bess, eel_stage) {
    Assert decoyFound(party). Retract decoyLaid(party). }
  Observe decoy_seen near bess when decoyFound(party) and at(bess, eel_stage) and at(party, eel_stage) "Bess stands on the eel-stage with a dishcloth in her hand, and a ration-cake wrapped in it, and turns it over as if there were a second side.".

  Person lads "the Trust's lads" at toll_counter {
    Role "two of the sergeant's men, sent after the music box". Ancestry human. Calling warrior. Level 2. Numbers 2. Temperament territorial.
    Uses go. Plans 24 steps.
    Warns "The two step out of the reeds side by side, in the Trust's grey coats with the badges turned inward. 'The box,' says the larger, in a voice that has not had to be raised before. 'Or we do this the long way, and you carry the bits.'".
    Comes "The smaller one moves first, and the larger moves behind him with a cudgel.".
    Pleads "The smaller lad sits down in the mud and puts both hands on his head. 'He said it was a box,' he says. 'Nobody said a woman would be crying.'".
    Lair weir. Refuge ferry_stage.
  }
  Pursuit lads_weir for lads "going to the weir" priority 1 when since(30) and not ladsSwept(party) seeks at(lads, weir).
  Pursuit lads_stage for lads "going down to the Highfoot stage" priority 2 when since(170) and not ladsSwept(party) seeks at(lads, ferry_stage).

  // Being seen: out in the open, Bess knows a face. Hiding, a disguise, or the fen mist keep her off; she looks once.
  Thing fen_mist "the mist on the fen" at causeway is scenery {
    State thin "The mist lies in the reeds, no higher than a man's knee, and the causeway runs on ahead plain enough.".
    State thick "The mist has come up out of the reeds and stands over the causeway. You can see your hand, and the planks, and nothing else.".
  }
  Initially Assert state(fen_mist, thin).
  Rule mist_up when since(30) and watch(clock) < t0() + 90 and state(fen_mist, thin) { Assert state(fen_mist, thick). }
  Rule mist_down when since(90) and state(fen_mist, thick) { Assert state(fen_mist, thin). }
  Query mistHides() means state(fen_mist, thick) and (at(party, causeway) or at(party, bell_cot) or at(party, eel_stage)).
  Rule bess_spots when at(bess, ?r) and at(party, ?r) and not hiding(party) and not disguised(party) and not confronted(party) and not bessMet(party) and not mistHides() {
    Assert confronted(party). }
  Rule bess_looks when at(bess, ?r) and at(party, ?r) and hiding(party) and not looked(party) and not confronted(party) and not bessMet(party) {
    Assert looked(party). Set lookedAt(party) to watch(clock). }
  Rule bess_finds when looked(party) and hiding(party) and dice(clock) <= 40 and not confronted(party) and at(bess, ?r) and at(party, ?r) { Assert confronted(party). }
  Rule looked_clears when looked(party) and watch(clock) >= lookedAt(party) + 3 { Retract looked(party). }
  Rule hiding_ends when hiding(party) and not at(party, hold) and not at(party, puppet_booth) and not at(party, bell_cot) and not at(party, sluice_hut) and not at(party, ferry_hut) { Retract hiding(party). }
  Rule disguise_ends when disguised(party) and not at(party, fairground) and not at(party, draper) and not at(party, puppet_booth) and not at(party, fair_quay) and not at(party, horse_lines) and not at(party, pelham_inn) { Retract disguised(party). }
  Observe spotted near bess when confronted(party) and not bessMet(party) "Bess has seen you. She does not run, and she does not shout. She puts the coin-scale down on whatever is nearest, very carefully, and walks towards you with her hands open.".

  // Hiding, and what is done once she finds you.
  Action hide_in_hold(actor: group, site: place) "Go down into the hold and pull the onion-sacks over you" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, hold) and not hiding(actor).
    Time 0.
    On success { Assert hiding(actor). }
    Result "The sacks smell of earth and a kind of sweet rot, and you are all three under them, and it is hot. Above your face the planking has a knot-hole, and through the knot-hole there is a square of light the exact size of an eye.".
  }
  Action swear_false(actor: group, site: place) "Swear to Bess that you have only cakes" {
    Speaker bess.
    Requires able(actor) and company(actor) and at(actor, site) and at(bess, site) and confronted(party) and holding(actor, music_box).
    Time 0.
    Resolve check(actor, deception, dc_hard).
    On success { Retract confronted(party). Assert bessMet(party). Retract at(bess, site). Assert at(bess, quay). }
    On failure { Assert bessKnows(party). }
    Result "You say it to her face and it does not feel like lying; it feels like acting. Bess takes it in with her head on one side. 'Cakes,' she says. 'It's a very big hamper for cakes.' But she goes, and she goes the wrong way, and at the end of the street she stops and does not look round.".
    Otherwise "'It plays,' says Bess. 'I can hear it from here. It plays when it's carried; the spring is loose.' You had not known that. She holds out her hand.".
  }
  Relation bessKnows(group).
  Action flee_bess(actor: group, site: place) "Break from her and run for it" {
    Requires able(actor) and company(actor) and at(actor, site) and at(bess, site) and confronted(party).
    Time 0.
    Resolve check(actor, stealth, dc_hard).
    On success { Retract confronted(party). Assert bessMet(party). Retract at(bess, site). Assert at(bess, quay). }
    Result "You do not decide to run. Your legs do, and the crowd, or the reeds, or the dark does the rest. Behind you a woman's voice says your name, which she cannot know, and then something else, which sounds like 'please'.".
    Otherwise "Your foot finds a rope. She is there before you have finished falling, not rough, not even angry, with one hand on your coat. 'Don't,' she says.".
  }
}
