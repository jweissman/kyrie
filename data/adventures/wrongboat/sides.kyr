Module wrongboat "The Wrong Boat" {
  // ── Bess, face to face ──────────────────────────────────────────────────────────────────────────────────────────
  Topic bess_where with bess "Hear what Bess has to say" when confronted(party) and not bessMet(party) and not bessTook(party) once {
    Says "'You have a hamper,' says Bess Lowther. 'Or you had. It came out of the Heron on Mother Cobbold's hip, and onto this river on yours.' She wipes her hands on her sleeves. 'I am not the Trust. I am a woman who is owed three months, and I would trade every one of them for what was in it. Sergeant Brill would trade me for the same, and a good deal less. Where is it?'".
  }
  Topic bess_give with bess "Put the box in her hands" answering bess_where when holding(actor, music_box) and not bessMet(party) {
    Says "She does not take it at once. She puts both hands under it as you would under a bird. It starts to play, because the spring is loose, and she stands there with her eyes shut, and the whole of the river has the grace to make less noise.".
    On discuss { Spend music_box from actor. Assert boxReturned(actor). Assert bessMet(party). }
  }
  Topic bess_give_hamper with bess "Put the hamper in her hands" answering bess_where when holding(actor, hamper_kind) and not holding(actor, music_box) and not bessMet(party) {
    Says "She takes it, and turns it to the label, and reads it twice. 'DO NOT OPEN,' she says. She sets it on her hip the way Mother Cobbold did, and her mouth does something that is not a smile. 'I'll open it at home.'".
    On discuss { Spend hamper_kind from actor. Assert boxReturned(actor). Assert bessMet(party). }
  }
  Topic bess_hob with bess "Tell her it was Hob Garrod who put it aboard" answering bess_where when not bessMet(party) and not bessKnows(party) and not ladsSwept(party) and (hobKnown(actor) or knows(actor, wage_slip_read) or hobMet(actor)) {
    Says "'I know it was,' says Bess. 'I came to Staithe to be told by someone else.' She sits down on a bollard, or a sack, or the ground. 'Come with me, then. Come and say it to his face. I'll not hurt you. Nobody on the river thinks I could.'".
    On discuss { Assert bessAlly(actor). Assert bessMet(party). Assert following(bess, actor). }
  }
  // Without anything in your hands to show it, "it was Hob Garrod" is a thing you heard shouted on a quay.
  Action bess_hob_bluff(actor: group, site: place) "Tell Bess the porter shouted Hob Garrod's name, and you know no more" {
    Speaker bess.
    Requires able(actor) and company(actor) and at(actor, site) and at(bess, site) and confronted(party) and not bessMet(party) and not bessAlly(party) and not bessKnows(party) and not ladsSwept(party) and accused(party) and not hobKnown(actor) and not knows(actor, wage_slip_read) and not hobMet(actor).
    Time 0.
    Resolve check(actor, persuasion, dc_hard).
    On success { Assert bessAlly(actor). Assert bessMet(party). Assert following(bess, actor). }
    On failure { Assert bessKnows(party). }
    Result "'Shouted,' says Bess. 'On a quay. By a porter.' She looks at you. 'It isn't much,' she says. 'But I have been walking on less since Tuesday.' She falls in beside you without another word.".
    Otherwise "'A porter shouted a name,' says Bess. 'You have a hamper and a porter. Give me the box and I will go and ask Hob myself.' She holds out her hands, and for the first time her voice is not level.".
  }
  // Standing on it is a gamble: if she believes it she goes, and if she does not she has the box and her thanks.
  Action stand_on_it(actor: group, site: place) "Tell her it is not hers to ask for" {
    Speaker bess.
    Requires able(actor) and company(actor) and at(actor, site) and at(bess, site) and confronted(party) and not bessMet(party) and not bessAlly(party).
    Time 0.
    Resolve check(actor, intimidation, dc_hard).
    On success { Retract confronted(party). Assert bessMet(party). Assert bessKnows(party). Assert bessPitied(actor). Set trailLostAt(party) to watch(clock). Retract at(bess, site). Assert at(bess, quay). }
    On failure { Assert bessTook(party). }
    Result "She takes this without moving her face. 'No,' she says. 'It is not.' She lets it lie. 'Then you will want to be a long way off, because the Trust's lads think it is theirs, and they do not ask.' She turns and goes, and she is the least dignified thing you have seen all week.".
    Otherwise "'Not mine,' says Bess. 'No.' She says it so softly that for a moment you think you have won. Then both her hands are under the box, and it is hers, and she is gentle about it.".
  }
  Topic bess_wage with bess "Ask Bess what she is owed and by whom" when bessMet(party) or bessAlly(party) {
    Says "'Three months by the Trust,' says Bess. 'Seven by Hob Garrod, for a man dead four years. I could have lived on the first and I could not on the second.' She turns the coin-scale in her hand. 'Sergeant Brill has the idea that if I come home without the box I lose the room over the toll-house. He has the idea that if I come home with it I lose it anyway, because he wants it. He is not a stupid man, and nor am I.'".
  }
  Topic bess_hob_known with bess "Tell her Hob is in the Pelham lock-up and asking for her" when bessMet(party) and hobMet(party) and not bessAlly(party) once {
    Says "She stands still. 'In the lock-up,' she says. 'For a bill.' She laughs once, a little, through her nose. 'Then he will keep,' she says. She does not ask for the box. She asks you the way to the Magpie.".
    On discuss { Assert bessPitied(actor). Assert hobTold(actor). }
  }

  // ── The Highfoot ferry, and the last chance to lose it ──────────────────────────────────────────────────────────
  Person una "Una Rendle" at ferry_hut {
    Role "the ferrywoman at Highfoot". Ancestry human. Peaceable. Pronouns she. Manner stoic.
    Greets "A small, brown, upright woman of sixty with a boathook for a stick looks at you. 'Yes,' she says.".
    Greets again "Una Rendle's boathook comes down once on the ferry-stage, like a gavel. 'Yes,' she says. It is, you gather, a complete sentence, and a different one from last time.".
  }
  Topic una_cross with una "Ask Una to put you across" when true once {
    Says "'Carrying?' says Una.".
  }
  Topic una_refuse with una "Ask Una again, with the stage as it is" answering una_cross when stageHot() {
    Says "Una looks past you to the planks, and then at the chain, and then at nothing. 'No,' she says. It is the longest speech you have had from her. 'Not with them there. I take people over. I don't take them away from things.' She picks up the boathook and turns her back.".
  }
  Topic una_truth with una "Tell her what is in the hamper" answering una_cross when not stageHot() {
    Says "'Yes.' She puts down the boathook. 'Tom,' she says. 'The song.' She goes to the ferry. The chain rattles. She takes no money.".
    On discuss { Assert ferryPaid(actor). Assert unaSung(actor). }
  }
  Topic una_nothing with una "Say nothing but yourselves" answering una_cross when not stageHot() {
    Says "'Four coin.' She holds out a hand like a root. 'It's fair-day.'".
    On discuss { Decrease quantity(actor, gold) by 4 or to nothing. Assert ferryPaid(actor). }
  }
  Topic una_tune with una "Wind the box and let her listen" answering una_cross when holding(actor, music_box) and not stageHot() {
    Says "You wind it. Una listens to all of it with her eyes on the middle distance. At the end she gets up and takes the chain in both hands. At the far bank she says one name, which is not Hob's, and it is a minute before you realise it is the name in the song.".
    On discuss { Assert ferryPaid(actor). Assert unaSung(actor). Assert boxWound(actor). }
  }
  Relation teaTaken(group). Relation sluiceTried(group).
  // With Una's goodwill the ferry is also somewhere to be unseen.
  Action hide_in_ferry(actor: group, site: place) "Lie down under the ferry's tarpaulin" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, ferry_stage) and unaSung(actor) and not hiding(actor).
    Time 0.
    On success { Assert hiding(actor). }
    Result "Una says nothing, and throws the tarpaulin over you herself, and sits on it. Nothing short of a warrant will move her.".
  }
  // The failable climax of the river: Bess or the lads at the stage and the ferry on the far bank. A rope over the
  // water on the chain, hand over hand; or a rush at the ferry when it is brought across.
  Action cross_by_chain(actor: group, site: place) "Go hand over hand along the ferry chain, over the water" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, ferry_stage) and not ferryPaid(actor) and stageHot() and not chained(actor).
    Time 1.
    Resolve check(actor, climbing, dc_hard).
    On success { Assert chained(actor). Assert ferryPaid(actor). }
    On failure { Assert chained(actor). Assert chainFell(actor). }
    Result "The chain is cold and wet and thick as your wrist, and it sings in the middle. You do not look down. On the other bank you are on your face on the stones, all three of you, hands burning, and behind you on the stage two small figures are standing still at the water's edge, looking.".
    Otherwise "The chain swings. You swing with it, and then the pack does, and the box in it, and there is a moment when you see it all clearly: the hamper, the strap, the water. You hold on to the chain. The box does not.".
  }
  Relation chained(group). Relation chainFell(group).
  Rule chain_drops_box when chainFell(party) and holding(party, music_box) { Spend music_box from party. Assert dropped(party). }
  Rule chain_drops_hamper when chainFell(party) and holding(party, hamper_kind) { Spend hamper_kind from party. }
  // The ferry is the company's, and goes back to being Una's the moment it has crossed.
  Rule ferry_returns when ferryPaid(party) and at(party, far_bank) { Retract ferryPaid(party). }

  // ── Pelham on fair-day ──────────────────────────────────────────────────────────────────────────────────────────
  Person dealer "Joel Sunderland" at horse_lines {
    Role "a horse-dealer". Ancestry human. Peaceable. Pronouns he. Manner jovial.
    Greets "A man like a barrel with a whip tucked in his belt looks at your boots first, then your face, then your boots. 'I've a mare for you,' he says. 'Or I've a gelding for you. Or I've neither and I'm lying. Which would you like?'".
    Greets again "Joel Sunderland looks at your boots, then your face, then your boots, and says the mare is gone. 'But I have a gelding,' he says, 'with a character. He has already thrown two men, and he has not thrown them far.'".
  }
  Person tunney "Orpha Tunney" at draper {
    Role "slop-seller". Ancestry human. Peaceable. Pronouns she. Manner acerbic.
    Greets "The woman behind the counter takes a tape off her neck. 'I do not ask why,' she says. 'I measure.'".
    Greets again "Orpha Tunney has the tape off her neck and round your shoulders before you have spoken. 'I do not ask why,' she says, again, and her mouth twitches. 'I measure. You have changed size. People always do, on the second visit.'".
  }
  Topic draper_what with tunney "Ask Mrs Tunney what she could make of you" when true once {
    Says "'What do you want to be taken for?' says Orpha Tunney, with the tape already out.".
  }
  Topic dress_barge with tunney "A bargeman, with a smell to match" answering draper_what when quantity(actor, gold) >= 4 {
    Says "Four coin and a quarter of an hour. The smock is stiff with tar, and you smell, truly, like a barge. She hands you a pipe with no tobacco in it. 'Keep it in your mouth,' she says. 'It does half the work.'".
    On discuss { Decrease quantity(actor, gold) by 4. Assert disguised(actor). }
  }
  Topic dress_bride with tunney "A bridegroom's party, in lavender" answering draper_what when quantity(actor, gold) >= 7 {
    Says "'Mm,' says Orpha Tunney. 'A man who wants to be looked at, so he will not be seen.' It costs seven coin and you leave in a waistcoat that can be heard from the next field.".
    On discuss { Decrease quantity(actor, gold) by 7. Assert disguised(actor). Assert flamboyant(actor). }
  }
  Topic dress_none with tunney "Nothing. I was only measuring" answering draper_what when true {
    Says "'Everyone is,' says Orpha Tunney, and puts the tape away.".
  }
  Person hoby "Gabriel Hoby" at puppet_booth {
    Role "a puppet-man, between acts". Ancestry human. Peaceable. Pronouns he. Manner proud.
    Greets "A thin man in his shirt, with a king's head on one hand and a crocodile's on the other, looks round the edge of the cloth. 'The cast is always one short,' he says. 'Are you any good at falling over?'".
    Greets again "Gabriel Hoby has the crocodile on his hand and the king on the other, and the king is losing the argument. 'The cast,' he says, from behind the cloth, 'is one short again. Are you any better at falling over than last time?'".
  }
  Topic hoby_villain with hoby "Ask Hoby what his play is about" when true once {
    Says "'The Wicked Toll-Clerk,' says Hoby. 'A king, a crocodile, a baby that is a sausage, and a gap where a villain goes. Name me one.'".
  }
  Topic hoby_bess with hoby "A toll-clerk with a coin-scale" answering hoby_villain when true {
    Says "'Perfect!' says Hoby. 'Hands on the scale, a face like a closed door, a long black sleeve!' He is already chalking it on the wall. 'By tomorrow,' he says, 'every child in Pelham will boo a woman they have never met, and will know her on sight.'".
    On discuss { Assert hobyPlay(actor). }
  }
  Topic hoby_hob with hoby "A bargeman who owes everybody" answering hoby_villain when true {
    Says "'A bargeman!' says Hoby. 'Done! He falls in the river in the second act and nobody helps!' He rubs out the toll-clerk with his sleeve, whistling.".
  }
  Topic hoby_me with hoby "Yourself, for putting up with this" answering hoby_villain when true {
    Says "He puts down the crocodile. 'I'll put you on,' he says. 'I'll give you the baby.' He is pleased with himself, and you have, for the length of a fair-day, the best hiding place in Pelham.".
    On discuss { Assert hiding(actor). }
  }
  Action hide_in_booth(actor: group, site: place) "Duck behind the puppet-cloth and take a head" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, puppet_booth) and not hiding(actor) and quantity(actor, rations) >= 1.
    Time 1.
    On success { Assert hiding(actor). Decrease quantity(actor, rations) by 1. }
    Result "You take the crocodile. It is lighter than you expected, and shaped to the arm. Outside, a roar of children. Nobody looks at the man behind the cloth.".
  }
  // The quay-warden sees what he is shown.
  Person warden "the quay-warden" at fair_quay {
    Role "Pelham's quay-warden, a man with a bell". Ancestry human. Peaceable. Pronouns he. Manner stoic.
  }
  Topic warden_bess with warden "Ask the quay-warden if anyone has asked after a box" when since(150) and not disguised(party) {
    Says "'Black sleeves?' says the warden, scratching himself. 'Toll-clerk? Came off a cart asking after three persons and a hamper.' He looks at you for a moment longer than he need. 'She went up Quay Street.' He does not say which of you the handbill had in mind.".
  }
  Topic warden_bess_disg with warden "Ask the quay-warden if anyone has asked after a box" when since(150) and disguised(party) {
    Says "'Black sleeves?' says the warden, to your smock, with the face of a man at ease. 'Cart, an hour ago. Asked after three furriners and a hamper. I said I'd not seen any furriners. Been a quiet morning.' He rings the bell for no reason.".
  }
  Action bluff_warden(actor: group, site: place) "Tell the warden you are Pelham's, born and bred" {
    Speaker warden.
    Requires able(actor) and company(actor) and at(actor, site) and at(warden, site) and disguised(actor) and flamboyant(actor) and not wardenBluffed(actor).
    Time 0.
    Resolve check(actor, performance, dc_fair).
    On success { Assert wardenBluffed(actor). Assert hiding(actor). }
    On failure { Assert wardenBluffed(actor). Assert accused(actor). }
    Result "You wear the lavender like a medal. 'Born in Cuckold Lane,' you tell him, 'in the third house.' There is no Cuckold Lane in Pelham, but he is looking at the waistcoat, and not at you, and the waistcoat is saying it is a bridegroom's party and in a hurry.".
    Otherwise "'Cuckold Lane,' says the warden. 'There's no Cuckold Lane.' He takes out his bell.".
  }
  Relation wardenBluffed(group).

  // ── The fen ─────────────────────────────────────────────────────────────────────────────────────────────────────
  Person noll "Noll Fairley" at bell_cot {
    Role "the fen bell-ringer". Ancestry human. Peaceable. Pronouns he. Manner compassionate.
  }
  Topic noll_wait with noll "Ask Noll why he rings the bell" when true once {
    Says "'To tell the lost where the road is,' says the man in the bell-cot. He is perhaps seventy, all beard and mild attention. 'How long would you wait for somebody who might not come?'".
  }
  Topic noll_forever with noll "As long as it took" answering noll_wait when true {
    Says "'Yes,' says Noll. 'That's what I said once.' He pulls the rope. 'You'll sit in the loft, then, if anyone comes looking. I'll say I never saw a soul. I've said it before.'".
    On discuss { Assert nollWaited(actor). }
  }
  Topic noll_sunset with noll "Until sunset, and no longer" answering noll_wait when true {
    Says "'Sensible,' says Noll, without reproach, and goes on with his rope.".
  }
  Topic noll_never with noll "I would not wait at all" answering noll_wait when true {
    Says "'Would you not?' says Noll, with real interest, and rings the quarter.".
  }
  Topic noll_bess with noll "Ask Noll if anyone has been this way" when since(40) {
    Says "'A woman with a scale in her hand went over the causeway a while back,' says Noll. 'In the mist. She asked me the time and went on. I rang her out of it myself.' He ponders. 'She's behind you now, not before. The mist is a great liar.'".
  }
  Action lay_false_trail(actor: group, site: place) "Wrap a ration-cake in a dishcloth and leave it in the eel-skiff" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, eel_stage) and quantity(actor, rations) >= 1 and not decoyLaid(actor) and not decoyFound(actor).
    Time 0.
    On success { Decrease quantity(actor, rations) by 1. Assert decoyLaid(actor). }
    Result "A cake in a cloth, in a skiff, tied up as if by someone in a hurry who did not wish to be seen leaving it. It looks, you think, like a lie that has had its hair done.".
  }
  Action hide_in_bellcot(actor: group, site: place) "Hunker in the bell-cot's loft behind the rope" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, bell_cot) and not hiding(actor) and quantity(actor, rations) >= 1.
    Time 1.
    On success { Assert hiding(actor). Decrease quantity(actor, rations) by 1. }
    Result "The loft smells of tallow and cold iron. The rope passes inches from your ear. Noll has not looked up.".
  }

  // ── The mill, the weir, and the lads ────────────────────────────────────────────────────────────────────────────
  Person tabitha "Tabitha Auster" at millyard {
    Role "the miller's wife". Ancestry human. Peaceable. Pronouns she. Manner jovial.
    Greets "A big red-armed woman looks up from the sack. 'Don't stand there like a lot of sacks yourselves!' she shouts. 'If you want the kitchen it's through the door and mind the cat, if you want a job it's the flour, and if you're running from something I've a pie and I never saw you!'".
    Greets again "Tabitha Auster is shouting something about flour before you are properly in the yard, and stops. 'It's you,' she says, at a quieter pitch that on anybody else would be a roar. 'Come in. The pie's on. I never saw you. I never saw you twice.'".
  }
  Topic tabitha_flour with tabitha "Ask Mrs Auster whether you are running from a man or toward one" when true once {
    Says "'Well?' says Tabitha, and beats the sack. 'Well, which is it? It makes a difference to the pie. If it's from, you want the cold end of the kitchen with the door shut. If it's toward, you want hot tea and no one to see you drink it, because you'll cry.'".
  }
  Topic tabitha_from with tabitha "From. Most definitely from" answering tabitha_flour when true {
    Says "'The cold end,' says Tabitha at once. 'And I'll say you were the new carter.'".
    On discuss { Assert hiding(actor). }
  }
  Topic tabitha_toward with tabitha "Toward. I think. I'm not sure" answering tabitha_flour when true {
    Says "'You poor lamb,' says Tabitha. 'Tea.' She puts it in your hand and goes out, and she is right, and you do cry a little, and no one sees.".
    On discuss { Assert teaTaken(actor). }
  }
  Person wilfred "Wilfred Auster" at millyard {
    Role "the miller". Ancestry human. Peaceable. Pronouns he. Manner stoic.
  }
  Topic wilfred_sum with wilfred "Ask Mr Auster about the sum on the slate in the kitchen" when true once {
    Says "'The boy's,' says Wilfred. 'How many sacks to fill the Aldwater from here to the sea. Due Sunday.' He looks at the wheel. 'It's about forty thousand. He'll tell you a hundred.'".
  }
  Thing sluice "the relief sluice" at sluice_hut is scenery {
    State held "The relief sluice is shut, and the weir pours white over its apron.".
    State open "The relief sluice stands open and a second, brown torrent runs down below the apron, scouring the stage where anyone had been standing.".
  }
  Initially Assert state(sluice, held).
  // The wheel is stiff, it is the miller's, and the water does not choose. A roll, two watches, and two men in the
  // river whom the company then has to live with.
  Action open_sluice(actor: group, site: place) "Spin the wheel and open the relief" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, sluice_hut) and not sluiceOpen(actor) and not sluiceTried(actor).
    Time 2.
    Resolve check(actor, brawn, dc_fair).
    On success { Assert sluiceOpen(actor). Assert sluiceTried(actor). Assert state(sluice, open). }
    On failure { Assert sluiceTried(actor). Assert ladsMet(party). Set ladsMetAt(party) to watch(clock). Retract at(lads, weir). Assert at(lads, sluice_hut). }
    Result "It takes all three of you. The wheel goes round with a noise like a cart on stones, and the water answers, a long way below, with a note you feel in your feet. Nobody has told you what is standing on the apron.".
    Otherwise "The wheel screams. Down at the weir two heads turn to look up the path, and then the grey coats are coming up it, not hurrying, because it is a dead end.".
  }
  Rule sluice_sweeps when sluiceOpen(party) and at(lads, weir) and not ladsSwept(party) {
    Assert ladsSwept(party). Retract at(lads, weir). }
  Observe sluice_news at weir when ladsSwept(party) "Below the apron the water has taken back a stretch of bank. One grey coat is on the far shingle, on all fours, being sick; the other is not there. Wilfred Auster is coming down the path with a boathook, looking at the water.".
  Action pay_lads(actor: group, site: place) "Pay the lads fifteen coin to find the wrong woman" {
    Speaker lads.
    Requires able(actor) and company(actor) and at(actor, site) and at(lads, site) and quantity(actor, gold) >= 15 and ladsMetAt(party) > 0 and not ladsPaid(actor) and not ladsRouted(actor) and not ladsSwept(actor) and not caught(actor).
    Time 2.
    On success { Decrease quantity(actor, gold) by 15. Assert ladsPaid(actor). Retract at(lads, site). }
    Result "The larger lad counts them, twice, in his palm. 'There's a woman at Highfoot,' he says, without conviction, 'who's got the look.' They go off along the bank, arguing about who will say what to the sergeant.".
  }

  // ── The Last Pint, and the man who was to have bought it ────────────────────────────────────────────────────────
  Person quill "Barnaby Fosse" at inn_room {
    Role "innkeeper, and a mender of clocks". Ancestry human. Peaceable. Pronouns he. Manner grim.
    Greets "A thin man with a cough and a loupe on a string looks up from a clock with its back off. 'You've brought it,' he says. 'Garrod's message said a box. I've been expecting it a month.'".
    Greets again "Barnaby Fosse has the clock's back off and a spring in his teeth. 'You have the face of a man who has delivered a box,' he says, round the spring. 'Or lost one. I never could tell the two faces apart.'".
  }
  Topic quill_ask with quill "Ask Mr Fosse what he wants with a music box" when true once {
    Says "'Movement,' says Fosse. 'Forty. The question is not the price.' He coughs. 'Who are you to sell it?'".
  }
  Topic quill_carrier with quill "Say you are only carrying it for a friend" answering quill_ask when holding(actor, music_box) {
    Says "'Then your friend can have forty,' says Fosse. He turns the box over, goes still, and holds it to the lamp. 'Oh,' he says. He reads the back-plate twice. 'That is a bargeman's work. A Lowther is a name on a plate; this is a man's initials, and hers. I'll not buy it.' He gives it back.".
    On discuss { Assert knows(actor, maker_known). Assert quillRead(actor). Assert boxKnown(actor). }
  }
  Topic quill_seller with quill "Say you are the seller and want forty" answering quill_ask when holding(actor, music_box) {
    Says "'Forty,' says Fosse, and counts it out. He winds the box once and listens. 'You might want to read the plate,' he says, 'before you walk out.' The coins are on the table. The box is in his hand.".
    On discuss { Spend music_box from actor. Increase quantity(actor, gold) by 40. Assert soldQuill(actor). }
  }
  Relation quillRead(group). Relation soldQuill(group).
}
