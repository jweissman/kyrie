Module skerrow "The Light on Skerrow Holm" {
  // ── The Caller ────────────────────────────────────────────────────────────────────────────────────────────────
  // It is in the cistern at the turn of the tide, and in the sea otherwise. It does not climb into a bright lamp. It
  // does not stand an hour of the bell. It calls, in a voice of someone drowned that the listener knew, and it takes
  // the one who answers. Nobody on the holm will tell the company any of this in so many words.
  Person caller "something in the cistern" at open_water {
    Role "a grey length of something, lying in the black water". Species tide_caller. Level 4. Numbers 1. Temperament ambush.
    Warns "In the black water by the ladder a pale hand opens, and closes, and then there are many, along a grey back as long as the room. They are all pointed at you. A voice that you know, and cannot have heard, says your name very gently.".
    Comes "The grey length comes up the ladder with the hands open.".
    Lair cistern.
  }
  Rule caller_sea when not hunting() and not at(caller, open_water) and at(caller, ?p) { Retract at(caller, ?p). Assert at(caller, open_water). }
  Rule caller_cistern when hunting() and state(lamp, bright) and not at(caller, cistern) and at(caller, ?p) { Retract at(caller, ?p). Assert at(caller, cistern). }
  Rule caller_stair when hunting() and state(lamp, low) and not at(caller, keeper_room) and at(caller, ?p) { Retract at(caller, ?p). Assert at(caller, keeper_room). }
  Rule caller_lamp when hunting() and state(lamp, out) and not at(caller, lamp_room) and at(caller, ?p) { Retract at(caller, ?p). Assert at(caller, lamp_room). }

  // The calls: one in each gap in the bell. They grow nearer, and more personal.
  Rule the_call when hunting() and within(party, holm) and watch(clock) >= lastCall(tide) + 6 {
    Increase callN(tide) by 1. Set lastCall(tide) to watch(clock).
  }
  Observe call_one near tide as sound when callN(tide) == 1 and within(party, holm) and not bellRecent() "Out on the water a man shouts, a long way off, one word, the way you would shout across a river. It might be a gull.".
  Observe call_two near tide as sound when callN(tide) == 2 and within(party, holm) and not bellRecent() "A woman's voice, nearer, from under the window. 'Is anyone there?' She says it kindly, like someone who already knows.".
  Observe call_three near tide as sound when callN(tide) == 3 and within(party, holm) and not bellRecent() "From the sea-side of the rock, a child, laughing, and then a name, and then the laugh again, nearer than the name.".
  Observe call_four near tide as sound when callN(tide) == 4 and within(party, holm) and not bellRecent() "The voice is at the foot of the tower. It is no one you have to guess at. It says a name the way it was said at home.".
  Observe call_five near tide as sound when callN(tide) >= 5 and within(party, holm) and not bellRecent() "The voices have stopped being separate. A whole street of them is in the cistern, all saying the one name, quite softly, over and over, and waiting.".

  // Answering: the company may answer. It is a thing that can be done once and not undone.
  Hazard taken_by_the_sea "Answering the sea" means "Kill ally.".
  Relation answeredTrue(group). Relation answeredFalse(group).
  Action answer_voice(actor: group, site: place) "Answer the voice by your own name" {
    Requires able(actor) and company(actor) and at(actor, site) and within(actor, holm) and callN(tide) >= 1 and hunting() and not answeredTrue(actor).
    Time 0.
    On success { Assert answeredTrue(actor). Assert strikes(taken_by_the_sea, actor). }
    Result "You say it. It is a relief to say it. The voice is glad. By the time the cold has reached the top of the stair one of you is no longer in the room.".
  }
  Action answer_false(actor: group, site: place) "Answer the voice with someone else's name, and make it sound afraid" {
    Requires able(actor) and company(actor) and at(actor, site) and within(actor, holm) and callN(tide) >= 1 and hunting() and not answeredFalse(actor).
    Time 0.
    Resolve check(actor, deception, dc_hard).
    On success { Assert answeredFalse(actor). Set bellUntil(tide) to watch(clock) + 8. }
    On failure { Assert answeredFalse(actor). Assert strikes(taken_by_the_sea, actor). }
    Result "You say a name that is not yours, in a voice that is not yours, and put into it everything you have ever been afraid of. A long silence. The water turns over once, once, like a sleeper changing sides, and goes out.".
    Otherwise "You say the false name. The voice stops. Then, tenderly, it says your own.".
  }
  Item holy_a "a flask of holy water" is holy_water at store.
  Item holy_b "a second flask of holy water" is holy_water in hettie_basket hidden until basket_looked.
  Thing hettie_basket "Hettie's basket" at kitchen {
    State covered closed "A basket with a cloth over it stands by the range. It smells of a loaf and, faintly, of a chapel.".
    State open "The basket stands open: a loaf, a jar, a candle-end, a small flask of holy water, and a man's pipe wrapped in a handkerchief.".
    Change open_basket "Look in Hettie's basket" from covered to open.
    Holds.
  }
  Discovery basket_looked "Hettie's basket holds a loaf, a jar, a candle-end, holy water and a pipe.".
  Observe basket_taught at kitchen when state(hettie_basket, open) "The pipe has been smoked, once, long ago, and tied up as a keepsake." teaches basket_looked.
  Action splash_caller(actor: group, site: place) "Throw holy water where the hands are opening" {
    Requires able(actor) and company(actor) and at(actor, site) and at(caller, site) and holding(actor, holy_water).
    Time 0.
    On success { Spend holy_water from actor. Set bellUntil(tide) to watch(clock) + 12. }
    Result "The flask breaks on the grey back, and where the water runs there is a sound like fat on a griddle. The hands close. Every one of them. The thing goes down the ladder without looking back, and the water in the cistern goes still, and stays still for two hours.".
  }
  Action drive_it_off(actor: group, site: place) "Take a torch to it" {
    Requires able(actor) and company(actor) and at(actor, site) and at(caller, site) and capable(actor, flame).
    Time 0.
    Resolve check(actor, intimidation, dc_hard).
    On success { Set bellUntil(tide) to watch(clock) + 4. }
    Result "You hold the flame out at the full length of the arm. It does not like the light. The hands fold, one at a time. It goes back down the stair, step by step, facing you.".
    Otherwise "You hold the flame out. It does not mind. It says your name again, in the voice of the person you would least like to refuse.".
  }
}
