Module longman "The Long Man" {
  Description "Merrowdale: a dry dale under a long straight ridge the village calls the Long Man, a lake behind it, and three days before the autumn storm.".

  // The dale, north to south: Hollow Water, the Long Man across the dale's throat, the low fields, Merrow.
  Place dale "Merrowdale" is region.
  Place hollow "Hollow Water" is wilderness within dale at 1, 0.
  Place long_man "the Long Man" is site within dale at 1, 1.
  Place fields "the low fields" is wilderness within dale at 1, 2.
  Place merrow "Merrow" is settlement within dale at 0, 2.
  Place south "the south road" is wilderness within dale at 0, 3.

  Place inn "the Drowned Ox" is building within merrow.
  Place chapel "the Chapel of the Ford" is building within merrow.
  Place mill "Teller's mill" is building within merrow.
  Place cottage "Gammer Coller's cottage" is building within merrow.
  Place hall "the Hall" is building within merrow.

  Place road_end "the end of the south road" is room within south at 0, 0.
  Place green "Merrow green" is room within merrow at 1, 2.
  Place taproom "the Drowned Ox" is room within inn at 1, 3.
  Place nave "the chapel" is room within chapel at 0, 2.
  Place vestry "the vestry" is room within chapel at 0, 3.
  Place millhouse "the millhouse" is room within mill at 2, 2.
  Place reeve_room "Gammer Coller's kitchen" is room within cottage at 0, 1.
  Place hall_floor "the Hall" is level within hall.
  Place undercroft "the Hall's undercroft" is level within hall.
  Place yard "the Hall yard" is room within merrow at 1, 0.
  Place study "the steward's study" is room within hall_floor at 0, 0.
  Place chamber "the steward's bedchamber" is room within hall_floor at 1, 0.
  Place cellar "the Hall cellar" is room within undercroft at 2, 0.
  Place race "the mill race" is room within merrow at 2, 1.
  Place low_field "the low field" is room within fields at 0, 1.
  Place springs "the Weeping Springs" is room within fields at 0, 0.
  Place landing "the mill landing" is room within fields at 1, 1.
  Place hollow_door "the Hollow Door" is room within fields at 1, 0.
  // Where people go who have left the dale: downriver on the barge.
  Place downriver "downriver" is room within south at 1, 0.

  Passage south_road "the south road" is road between road_end and green taking 30 minutes.
  Passage ox_door "the Ox's door" is door between green and taproom.
  Passage chapel_porch "the chapel porch" is doorway between green and nave.
  Passage vestry_door "the vestry door" is door between nave and vestry.
  Passage mill_lane "the mill lane" is path between green and race taking 10 minutes.
  Passage mill_door "the mill door" is door between race and millhouse.
  Passage reeve_door "Gammer Coller's door" is door between green and reeve_room.
  Passage hall_lane "the Hall lane" is road between green and yard taking 30 minutes.
  Passage study_door "the study door" is door between yard and study.
  Passage chamber_door "the bedchamber door" is door between study and chamber.
  Passage cellar_stair "the cellar stair" is stair between yard and cellar.
  Passage dyke_path "the dyke path" is path between green and low_field taking 20 minutes.
  Passage spring_path "the spring path" is path between low_field and springs taking 20 minutes.
  Passage beck_path "the beck path" is path between low_field and landing taking 20 minutes.
  Passage mill_steps "the mill steps" is steps between millhouse and landing.
  Passage wall_foot "the foot of the wall" is path between springs and hollow_door taking 20 minutes.
  Passage door_path "the beck side" is path between landing and hollow_door taking 20 minutes.

  // Who comes up the south road: a company of its own (company.kyr) when the dale is a campaign, the world's company
  // when it is a country reached across a march (placed.kyr).

  Observe road_scene at road_end when true "The south road comes up out of the willows into a dale of black, wet-smelling earth. At its head a long green ridge lies across the valley, dead straight, like a sleeper under a blanket. A village of grey stone sits below it with its back to the hill.".
  Observe green_scene at green when not drowned(green) "A green with a well and a lime tree, and grey houses with their backs to the hill. The chapel stands at the low end by the beck; the Drowned Ox faces it across the grass. Up the lane, the Hall's roofs show at the north end of the Long Man.".
  Observe green_drowned at green when drowned(green) "Brown water stands over the green to the height of a man's waist, and moves. The lime tree is full of thatch.".
  Observe taproom_scene at taproom when true "A low taproom smelling of peat and wet wool. A sign over the hearth shows an ox up to its horns in water, which the landlord says is a joke.".
  Observe nave_scene at nave when true "A plain chapel with a floor of flagstones worn into hollows. By the door stands the font: a square grey pillar, smooth as soap, notched all the way up one edge. The highest notch is level with the roof-beam.".
  Observe vestry_scene at vestry when true "A cupboard of a room, with the parish register chained to a shelf and a basin of cold water.".
  Observe millhouse_scene at millhouse when not drowned(millhouse) "The millhouse shakes with the wheel. Flour hangs in the air like smoke.".
  Observe race_scene at race when true "The mill race runs full and loud along its stone channel to the wheel, fuller than a beck this size has any right to.".
  Observe reeve_scene at reeve_room when true "A kitchen with a peat fire, a cat, and on pegs by the door a row of tools for ditches: spades, a slasher, a long hook.".
  Observe yard_scene at yard when true "A cobbled yard under the north end of the Long Man, where the ridge rises behind the Hall like a wall behind a house.".
  Observe yard_smashed at yard when state(cart, smashed) "Something walked through the yard gate without opening it.".
  Observe study_scene at study when true "A steward's study: a fire, a desk heaped with bills, and the Hall's accounts in a row of ledgers.".
  Observe chamber_scene at chamber when true "A narrow bedchamber over the yard, with a cold grate, a washstand, and a bed with curtains of faded green.".
  Observe cellar_scene at cellar when true "The Hall cellar is old at the back, older than the Hall: walls of smooth grey stone, fitted without mortar. Barrels stand along them, and the air at the back is colder than a cellar's should be.".
  Item bar "an iron bar" is crowbar at cellar.
  Observe bar_seen at cellar when at(bar, cellar) "An iron bar leans against the barrels, one end bright with scraped bronze.".
  Observe field_scene at low_field when not drowned(low_field) "A low field of black earth under the Long Man. The furrows hold water, and the grass is the bright green of a meadow that is turning into a bog.".
  Observe field_drowned at low_field when drowned(low_field) "The low field is under a hand's depth of water. The furrows are gone; reeds are coming up through it.".
  Observe springs_scene at springs when true "At the foot of the Long Man a row of small springs comes out of the turf, clear and very cold. They run into a ditch that runs to the mill.".
  Observe landing_scene at landing when true "A stone landing where the beck widens below the mill, with rings for mooring.".
  Observe hollow_door_scene at hollow_door when true "At the south end of the Long Man the beck comes out of the hill through a great round arch of grey stone, smooth and pale, glazed blue-green where the water runs. An iron grate closes it, newer than the arch by a thousand years.".
  Observe downriver_scene at downriver when true "The beck goes on south toward the river and the towns.".

  // The people of Merrow, and what they want.
  Person venn "Aldous Venn" at study {
    Role "steward of the Hall". Ancestry human. Peaceable.
    Objects "Venn sees {?i} in your hands, and his face changes. 'That belongs to the Hall,' he says. 'Give it here.'".
  }
  Person dunnet "Dunnet" at yard {
    Role "foreman at the Hall". Ancestry human. Calling warrior. Peaceable.
    Wants bandages. Wants tin_lantern.
    Objects "Dunnet looks at {?i}, and at you, and goes in to the steward without a word. The study door bangs.".
  }
  Initially Assert serves(dunnet, venn).
  Person ysolt "Mother Ysolt" at nave {
    Role "priest of the Chapel of the Ford". Ancestry human. Calling cleric. Peaceable.
    Wants keeper_mask.
  }
  Event mask_buried near ysolt when keeps(ysolt, ?face) and itemKind(?face, keeper_mask) "Mother Ysolt takes the grey face in both hands and looks at it a long time. That evening she buries it in the chapel yard with the words for the dead, and rings the bell once." then {
    Assert buried(?face).
  }
  Relation buried(item).
  Person hob "Hob Teller" at millhouse {
    Role "the miller". Ancestry human. Peaceable.
  }
  Person nell "Gammer Coller" at reeve_room {
    Role "the dyke-reeve". Ancestry human. Peaceable.
    Objects "'That is the reeve's rod,' says Gammer Coller, very quietly. 'It is not yours, and it is not mine to lose. Put it back.'".
  }
  Person martin "Martin Pask" at taproom {
    Role "landlord of the Drowned Ox". Profession innkeeper. Peaceable.
    Sells rations for 2 coin from 6.
    Sells torch for 1 coin from 6.
  }
  Person folk "the people of Merrow" at green {
    Role "villagers". Ancestry human. Numbers 4. Peaceable.
  }
  Observe folk_here at green when at(folk, green) and not storming() and not dark() "A few people are at the well, and stop talking to watch you come.".
  Topic folk_long_man with folk "Ask the people at the well about the Long Man" when true once {
    Says "'The Long Man's barrow,' says a woman with a basket of eggs. 'There's a giant king under it, that the Long Folk buried with his gold. You don't go up there after dark.' She nods at the ridge. 'The Mower walks.'".
  }
  Topic folk_mower with folk "Ask the people at the well about the Mower" when true once {
    Says "'Grey,' says a boy, before anyone can stop him, 'and taller than the chapel door. It came down onto the green last week and stood looking at the springs half the night, and Hob Teller hid in his own millpond.' His mother cuffs him, not hard.".
  }
  Topic folk_venn with folk "Ask the people at the well about the steward" when true once {
    Says "They look at one another. 'Owes money downriver, they say,' says the woman with the eggs. 'The barge comes up for his old metal. He'll have put that notice up because the Mower knocked his cart about.'".
  }
  Topic martin_news with martin "Ask Martin Pask what is new in Merrow" when true once {
    Says "'Storm coming,' says Martin, wiping a pot. 'Three days, Gammer Coller says, and she's never been wrong in my life. And the Heron's due up the beck tomorrow noon for the steward's cart. Cass Rowell drinks here.' He sets the pot down. 'If you're going after the Mower, the steward's your man. I'd want paying first.'".
  }

  // The steward's notice, the steward's bronze, and the steward's key.
  Discovery bounty_known "The notice on the Ox's door, in a clerk's hand: WHOEVER LAYS THE MOWER THAT WALKS THE LONG MAN SHALL HAVE FORTY CROWNS OF THE STEWARD. A. VENN, FOR THE LORD." {
    Source notice "the steward's notice on the Ox's door" at green readable by party.
    Known by venn.
  }
  Thing cart "the cart under the tarpaulin" at yard {
    Holds.
    State covered closed "A cart stands under a tarpaulin with its shafts down, the tarpaulin roped tight.".
    State uncovered "The cart's tarpaulin is thrown back.".
    State smashed "The cart lies on its side with its wheels smashed and its tarpaulin torn.".
    Change uncover "Untie the tarpaulin on the cart" from covered to uncovered.
  }
  // The bronze is the steward's, he says, and his foreman says so first.
  Rule dunnet_sees_cart when state(cart, uncovered) and together(dunnet, party) and serves(dunnet, venn) and not noticedCart(dunnet) says "'That's the steward's,' says Dunnet, and comes over, not quickly. 'You'll want to ask him before you go in there.'" { Assert noticedCart(dunnet). }
  Relation noticedCart(group).
  Item teeth "a sack of bell-teeth" is bell_teeth in cart owned by venn.
  Thing cellar_chest "a barrel by the cellar's back wall" at cellar {
    Holds.
  }
  // The grate key is on the steward's belt by day, and on its hook by the study door while he sleeps; he lends it
  // to whoever takes his forty crowns. He sleeps after supper, in the room behind the study.
  Rule venn_retires when dark() and at(venn, study) and able(venn) { Assert at(venn, chamber). }
  Rule venn_rises when not dark() and at(venn, chamber) and able(venn) { Assert at(venn, study). }
  Thing key_hook "the hook by the study door" at study {
    Holds.
    State worn closed "The steward wears a big iron key on his belt.".
    State hung "A big iron key hangs on the hook by the study door.".
    State empty "Nothing hangs on the hook by the study door.".
  }
  Item key "the steward's iron key" is cell_key in key_hook owned by venn.
  Rule venn_sleeps when dark() and state(key_hook, worn) and not lends(venn, key, ?c) { Assert state(key_hook, hung). }
  Rule venn_wakes when not dark() and state(key_hook, hung) and not lends(venn, key, ?c) and inside(key, key_hook) { Assert state(key_hook, worn). }
  // The hook says what hangs on it: once the key is gone, nothing does.
  Rule hook_emptied when state(key_hook, hung) and not inside(key, key_hook) { Assert state(key_hook, empty). }
  Rule hook_filled when state(key_hook, empty) and inside(key, key_hook) { Assert state(key_hook, hung). }
  Discovery ledger_known "Venn's ledger: twelve bronze teeth sold to Cass Rowell of the barge Heron this year, at eight crowns the tooth, against a debt of sixty crowns, with more to come." {
    Source ledger "the steward's ledger" at study readable by party.
    Known by venn.
  }
  Discovery cellar_known "Behind a barrel in the Hall cellar, a door has been set into a hole broken through the old grey wall, into the inside of the Long Man." {
    Found by searching cellar "Behind the last barrel the old wall has been broken through, and a heavy new door set into the hole. Cold, dry air comes round its edges.".
    Found by searching gallery "Low in the gallery wall an old breach has been fitted with a heavy new door. It does not give: it is barred from the other side.".
    Known by venn, dunnet.
  }

  // Venn hides the bronze in the cellar at nightfall on the first day, and loads it onto the barge when it comes.
  Rule teeth_hidden when watch(clock) >= 60 and inside(teeth, cart) { Retract inside(teeth, cart). Assert inside(teeth, cellar_chest). }
  // Loaded, the teeth are Cass's: on her deck at the landing, hers to sell back, and gone downriver when she goes.
  Rule teeth_loaded when at(cass, landing) and inside(teeth, cellar_chest) { Retract inside(teeth, cellar_chest). Retract owns(venn, teeth). Assert at(teeth, landing). Assert aboard(teeth). }
  Relation aboard(item).
  Rule cass_wants when aboard(teeth) and at(teeth, landing) and not forSale(teeth) { Assert forSale(teeth). Assert soldBy(teeth, cass). Set price(teeth) to 12. }
  Rule teeth_sail when aboard(teeth) and at(teeth, landing) and at(cass, downriver) { Assert at(teeth, downriver). }
  // Told what the bronze held shut, Cass will not carry it: she leaves it on the landing and has the Hall's plate instead.
  Topic cass_weir with cass "Tell Cass Rowell what the bronze was holding shut" when knows(actor, wall_known) and knows(actor, teeth_taken) and aboard(teeth) {
    Says "Cass hears you out without a word, looking past you at the hill. 'My father was under a weir on the Lune when it went,' she says. 'I'll not carry one downriver in a sack.' She whistles, and one of her hands sets the sack down on the landing stones. 'The steward owes me sixty crowns. I'll have them in silver before dusk, or I'll have his plate.'".
    On discuss { Retract aboard(teeth). Retract forSale(teeth). Retract soldBy(teeth, cass). Assert dunned(venn). }
  }
  Relation dunned(group). Relation ruined(group).
  Rule venn_ruined when dunned(venn) and at(cass, downriver) and not ruined(venn) { Assert ruined(venn). }
  Observe study_stripped at study when ruined(venn) "The dresser by the fire is bare: the Hall's plate has gone downriver on the Heron.".
  // Cass drinks at the Ox for an hour while her hands load.
  Rule cass_drinks when watch(clock) >= 186 and watch(clock) < 192 and at(cass, landing) { Assert at(cass, taproom). }
  Rule cass_back when watch(clock) >= 192 and at(cass, taproom) { Assert at(cass, landing). }
  // The Ox's cellar is the lowest in Merrow but the mill's: when the low field goes under, Martin bails.
  Observe ox_bailing at taproom when drowned(low_field) and not drawn(hollow) and not broke(long_man) "Martin Pask is bailing his cellar by the bucket and swearing at the hill. 'Never in my life,' he says. 'Not once, not in a wet year.'".
  Observe cass_at_ox at taproom when at(cass, taproom) "Cass Rowell sits alone by the fire with her boots on the fender, reading a letter and moving her lips.".
  // Merrow's evenings are spent in the Ox, and its nights in its own beds.
  Rule folk_evening when dark() and untilLight(clock) > 42 and at(folk, green) and not storming() and not lostToWater(folk) { Assert at(folk, taproom). }
  Rule folk_bed when at(folk, taproom) and untilLight(clock) <= 42 { Assert at(folk, green). }
  Observe green_night at green when dark() and not drowned(green) "The green is dark. Somebody's dog barks once.".
  Observe ox_evening_first at taproom when at(folk, taproom) and watch(clock) < 144 "The taproom is full and loud. Everybody has an opinion about the steward's notice, and nobody means to go up the hill after dark to earn it.".
  Observe ox_evening_second at taproom when at(folk, taproom) and watch(clock) >= 144 "The talk in the Ox is of the barge, and of the low field, where Ned Rook went in over his boots this afternoon by the springs, on ground that was dry at Lammas.".
  // Hob walks up to the springs at dusk with his spade, and stands looking at the water.
  Rule hob_walks when dark() and untilLight(clock) > 48 and at(hob, millhouse) and not confessed(hob) { Assert at(hob, springs). }
  Rule hob_home when at(hob, springs) and untilLight(clock) <= 48 { Assert at(hob, millhouse). }
  Observe hob_watching at springs when at(hob, springs) "Hob Teller stands at the springs in the dusk with a spade over his shoulder, looking at the water as a man looks at a debt.".


  // Dunnet hurt: an arm bound properly buys what wages would.
  Observe dunnet_sling at yard when hurt(dunnet) and at(dunnet, yard) "Dunnet sits on the mounting-block with his arm in a sling of sacking and his jaw set.".
  Event dunnet_bound near dunnet when keeps(dunnet, ?b) and itemKind(?b, bandages) and hurt(dunnet) "Dunnet lets you set the arm and bind it, and only swears once. 'The bar comes off the cellar door at dark,' he says. 'For you. Not for him.'" then {
    Retract hurt(dunnet). Assert promisedDoor(dunnet). Retract serves(dunnet, venn).
  }
  // Pell's lantern brought back: Dunnet tells it all, and then tells Mother Ysolt.
  Event pell_told near dunnet when keeps(dunnet, lantern) "Dunnet turns the lantern over and over in his hands and wipes the glass with his thumb. 'Pell's,' he says. 'The steward told them Pell went down the river in the spring. He never. The clay stood up and took him while we had the teeth out, and I ran.' He gets up. 'I'm going to tell Mother Ysolt. Then they can all know.'" then {
    Assert confessedPell(dunnet). Retract serves(dunnet, venn).
  }
  Relation confessedPell(group). Relation pellKnown().
  // He goes down to the chapel at dusk, and by morning the whole parish has it.
  Rule dunnet_to_chapel when confessedPell(dunnet) and dark() and at(dunnet, yard) { Assert at(dunnet, nave). }
  Rule pell_known when confessedPell(dunnet) and at(dunnet, nave) and not pellKnown() { Assert pellKnown(). Assert exposed(venn). }
  Observe dunnet_at_chapel at nave when at(dunnet, nave) "Dunnet sits on the bench by the font with Pell's lantern on his knees.".
  Observe pell_mourned at green when pellKnown() and at(folk, green) and not dark() "At the well they are talking low about Pell, and nobody says the steward's name, and everyone means it.".
  // Dunnet is owed his wages, and is frightened of what is behind the cellar door.
  Relation promisedDoor(group).
  Topic dunnet_fear with dunnet "Ask Dunnet about the Mower" when true once {
    Says "Dunnet looks at the hill. 'It's not the Mower I mind,' he says. 'It's what's in the wet tunnel. It stood up out of the floor at Pell and me, all mud, and came after us. I'm not going back through that door, not for the steward, not for anyone.'".
  }
  Topic dunnet_door with dunnet "Ask Dunnet what is behind the cellar door" when knows(actor, cellar_known) or state(cellar_door, barred) {
    Says "'The inside of the Long Man,' says Dunnet. 'Tunnels, dry as a church, all that grey stone. And the wheels. We had the teeth out of the big wheel in the wet tunnel, twelve of them, before the mud stood up.' He looks at his boots. 'The steward keeps it barred now.'".
    On discuss { Assert knows(actor, cellar_known). }
  }
  Action pay_dunnet(actor: group, site: place) "Give Dunnet three coin toward the wages he is owed" {
    Description "He is owed three months, and the steward will not pay.".
    Requires able(actor) and company(actor) and at(actor, site) and at(dunnet, site) and quantity(actor, gold) >= 3
      and not promisedDoor(dunnet).
    On success {
      Decrease quantity(actor, gold) by 3. Increase quantity(dunnet, gold) by 3. Assert promisedDoor(dunnet).
      Retract serves(dunnet, venn).
    }
    Result "Dunnet counts the coins twice. 'The steward sleeps after supper,' he says, low. 'The bar comes off the cellar door at dark, and goes back on at cockcrow. That's all. I never saw you.'".
  }
  // Dunnet takes the bar off at dark and puts it back at cockcrow; a bar the company lifted itself is its own affair.
  Rule door_unbarred when promisedDoor(dunnet) and dark() and state(cellar_door, barred) { Assert state(cellar_door, unbarred). Assert dunnetsBar(cellar_door). }
  Rule door_rebarred when dunnetsBar(cellar_door) and not dark() and state(cellar_door, unbarred) and not at(party, cellar) { Assert state(cellar_door, barred). Retract dunnetsBar(cellar_door). }
  Relation dunnetsBar(entity).

  // Venn: what he says, and what he pays.
  Topic venn_bounty with venn "Ask Aldous Venn about the Mower" when not exposed(venn) and not hostile(venn, actor) {
    Says "'The Mower,' says Venn, and smiles as if it were a joke between gentlemen. 'The Long Man's ghost. It walks the crest at night and frightens the parish, and now it has taken to coming down into my yard. Forty crowns, and you may keep the mask it wears to show for it; Mother Ysolt will want to bury it.' He unhooks a big iron key from his belt and hangs it by the door. 'It lies up inside the hill by day, the men say. That key opens the grate at the Hollow Door.'".
    On discuss { Assert knows(actor, bounty_known). Assert lends(venn, key, actor). Assert state(key_hook, hung). }
  }
  Topic venn_bronze with venn "Ask Aldous Venn what was in the cart" when knows(actor, ledger_known) and not exposed(venn) and not hostile(venn, actor) {
    Says "Venn's smile stays where it is, but his eyes go to the ledgers. 'Old metal,' he says. 'Lumber from the Long Folk's mill under the hill. The estate has debts, and the hill is the estate's.' He spreads his hands. 'Nobody in Merrow ever had a use for it.'".
  }
  // Shown his own ledger beside what the bronze held shut, he gives up the key, and then the dale.
  Topic venn_shown with venn "Show Aldous Venn his own ledger, and tell him what the bronze held shut" when knows(actor, ledger_known) and knows(actor, teeth_taken) and not exposed(venn) {
    Says "Venn reads his own hand as if a stranger had written it. 'A sluice,' he says. 'Old metal off a sluice.' He sits down. 'Sixty crowns, and a letter from the Lord every week asking where they are.' He unhooks the iron key from his belt and hangs it by the door, and does not look at it. 'Take it. Do what you like with the hill.' When you go out he is writing, fast, to Cass Rowell.".
    On discuss { Assert exposed(venn). Assert lends(venn, key, actor). Assert state(key_hook, hung). }
  }
  Relation exposed(group).
  Rule venn_flees when exposed(venn) and at(cass, landing) and able(venn) and not at(venn, landing) and not at(venn, downriver) { Assert at(venn, landing). }
  Rule venn_sails when exposed(venn) and at(venn, landing) and at(cass, downriver) { Assert at(venn, downriver). }
  Observe venn_waits at landing when exposed(venn) and at(venn, landing) "Aldous Venn sits on the Heron's hatch with a valise on his knees, and does not look up at the hill.".
  Action claim_bounty(actor: group, carrier: member, face: item, site: place) "Show Aldous Venn {face}" {
    Requires able(actor) and company(actor) and at(actor, site) and at(venn, site) and memberOf(carrier, actor)
      and ownedItem(face, carrier) and itemKind(face, keeper_mask) and not paidBounty(venn).
    On success { Decrease quantity(venn, gold) by 40. Increase quantity(actor, gold) by 40. Assert paidBounty(venn). }
    Result "Venn turns the grey face over in his hands, and for a moment he looks old. Then he counts out forty crowns, most of them in silver he has clearly borrowed. 'Merrow will sleep tonight,' he says.".
  }
  Relation paidBounty(group).
  Initially Set quantity(venn, gold) to 40.

  // Mother Ysolt and the font.
  Topic ysolt_mower with ysolt "Ask Mother Ysolt about the Mower" when not convinced(ysolt) {
    Says "'The Long Man is restless,' says Mother Ysolt. 'He was a king, and a cruel one; the font is his tally, a notch for every sin, and the parish has prayed him down for two hundred years. Now he walks again. Bring me his mask and I will put it in the ground with the proper words, and he will lie still.'".
  }
  Relation convinced(group).
  Topic ysolt_notches with ysolt "Tell Mother Ysolt what the notches on the font are" when knows(actor, notches_known) and not convinced(ysolt) {
    Says "Mother Ysolt stands a long time at the font with her hand flat on the stone, looking up at the highest notch and the roof-beam beside it. 'The chapel step,' she says at last. 'The register says the water came to the chapel step.' She turns. 'If it comes again, it will not stop at the step. I will ring the bell, and Merrow will go up the hill to the Hall, and the steward can say what he likes.'".
    On discuss { Assert convinced(ysolt). }
  }
  Discovery wept_known "The parish register, two hundred years back: 'In the year the Long Man wept, the water came over the low field to the chapel step. The Mower walked by day as well as night, and in seven days the water went back. The lord's men had dug into the Barrow for its gold.'" {
    Source register "the parish register" at vestry readable by party.
    Known by ysolt.
  }

  // Hob Teller and the springs.
  Topic hob_springs with hob "Ask Hob Teller about the springs" when not confessed(hob) {
    Says "'Blessed springs,' says Hob. 'My father's wheel stood still every dry summer. This one turns day and night.' He does not look toward the hill.".
  }
  Relation confessed(group).
  Topic hob_cuts with hob "Show Hob Teller the spade-cuts at the springs" when knows(actor, cuts_known) and not confessed(hob) {
    Says "Hob goes white, then red. 'It was the drought,' he says. 'A few spits with the spade, in the spring, to let them run. They've run harder every week since.' He looks at his mill, the lowest house in Merrow. 'I'll stake them and clay them over tomorrow, before light. God help me, I'll do it.'".
    On discuss { Assert confessed(hob). }
  }
  Rule hob_staunches when confessed(hob) and state(cuts, open) and untilLight(clock) == 1 { Assert state(cuts, staunched). }
  Thing cuts "the cuts at the springs" at springs {
    State open "The springs pour out of the turf, cold and clear, more water than a few springs ought to give.".
    State staunched "The cuts at the springs have been staked and packed with clay. The water seeps instead of pouring.".
    Change staunch "Stake the spade-cuts and pack them with clay" from open to staunched needing digging or shovel after learning cuts_known.
  }
  Discovery cuts_known "Someone has cut the Weeping Springs wider with a spade, this year: the edges are still square." {
    Found by searching springs "Under the water the turf is cut in clean square bites, too regular for water to have made. A spade did this, not long ago.".
  }

  // Gammer Coller and her rod.
  Topic nell_rhyme with nell "Ask Gammer Coller about the Mower" when true once {
    Says "'There's a rhyme,' says Gammer Coller. 'When the Mower walks the crown, keep the willow-roots cut down. When the Mower walks the green, the water's coming in between. When the Mower walks by day, Merrow, take your bed away.' She pokes the fire. 'It's been walking the green this month. Nobody asked me.'".
  }
  Topic nell_rod with nell "Ask Gammer Coller about the rod by her door" when true once {
    Says "'The dyke-reeve's rod,' she says, and takes it down: black wood, with notched bronze on both ends. 'Every reeve has had it since there were reeves. You measure a ditch with it.' She runs her thumb along the notches. 'Not that the notches match any measure I know.'".
    On discuss { Assert knows(actor, rod_seen). }
  }
  Topic nell_lend with nell "Ask Gammer Coller for the loan of her rod" when knows(actor, mower_keeps) and at(rod, reeve_room) {
    Says "She listens without a word while you tell her what the Mower does. Then she lays the rod on the table. 'I always thought it walked like a reeve,' she says. 'Bring it back.'".
    On discuss { Assert lends(nell, rod, actor). }
  }
  Item rod "the dyke-reeve's rod" is sluice_rod at reeve_room hidden until rod_seen owned by nell.
  Discovery rod_seen "Gammer Coller keeps an old rod shod in notched bronze, the dyke-reeve's rod, by her door.".

  // Cass Rowell's barge, the Heron: up the beck at noon on the second day, away at dusk.
  Person cass "Cass Rowell" at downriver {
    Role "master of the barge Heron". Ancestry human. Calling thief. Level 3. Peaceable.
    Buys bell_teeth for 8 coin.
  }
  Person hands "the Heron's hands" at downriver {
    Role "bargemen". Ancestry human. Calling warrior. Level 2. Numbers 2.
  }
  Initially Assert serves(hands, cass). Initially Set quantity(cass, gold) to 60.
  Thing hold "the Heron's hold" at downriver {
    Holds.
  }
  Rule cass_comes when watch(clock) >= 168 and watch(clock) < 204 and at(cass, downriver) { Assert at(cass, landing). Assert at(hands, landing). Assert at(hold, landing). }
  Rule cass_goes when watch(clock) >= 204 and at(cass, landing) and able(cass) { Assert at(cass, downriver). Assert at(hands, downriver). Assert at(hold, downriver). }
  Observe heron_scene at landing when at(cass, landing) "The barge Heron lies at the landing, low in the water, with a brown sail furled and two bargemen sitting on the hatch.".
  Topic cass_trade with cass "Ask Cass Rowell what she is carrying" when true once {
    Says "'Whatever pays,' says Cass. 'Wool down, iron up. Bronze, when the steward has it. He owes me sixty crowns and pays me in old teeth.' She looks you over. 'If you've teeth to sell, I buy at eight. If you want them back, they cost twelve. That's trade.'".
  }

  // The steward's grate, and the key that opens it.
  Thing grate "the iron grate" on culvert {
    State locked blocking "The iron grate is locked with a padlock the size of a loaf.".
    State open "The iron grate stands open on its hinges.".
    Change unlock "Unlock the grate with the steward's key" from locked to open needing key.
  }
  Initially Assert keyholder(venn, grate).
}
