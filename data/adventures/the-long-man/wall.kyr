Module longman "The Long Man" {
  Description "The Long Man: the crest a figure walks at night, and the grey galleries inside the hill.".

  Place inside "the galleries" is level within long_man.
  Place crest "the crest of the Long Man" is room within long_man at 1, 0.
  Place gauge_head "the gauge stone" is room within long_man at 2, 0.
  Place gallery "the grey gallery" is room within inside at 1, 1.
  Place sluice "the sluice chamber" is room within inside at 2, 2.
  Place rest "the keeper's niche" is room within inside at 0, 1.
  Place leak "the wet gallery" is room within inside at 1, 2.
  Place shaft_foot "the foot of the gauge shaft" is room within inside at 2, 1.
  // The clay core, where what the leak made of the clay goes when the leak is shut.
  Place core "the clay core" is room within inside at 0, 2.
  Initially Assert unlit(gallery). Initially Assert unlit(sluice). Initially Assert unlit(rest). Initially Assert unlit(leak).
  Initially Assert unlit(shaft_foot).

  Passage crest_steps "the steps up the Long Man" is steps between yard and crest taking 20 minutes.
  Passage valley_face "the valley face" is path between crest and springs taking 20 minutes.
  Passage crest_walk "the crest" is path between crest and gauge_head taking 10 minutes.
  Passage culvert "the culvert" is culvert between hollow_door and sluice taking 10 minutes.
  Passage broken_wall "the broken wall" is doorway between cellar and gallery.
  Passage sluice_way "the sluice passage" is passage between gallery and sluice.
  Passage niche_way "the keeper's passage" is passage between gallery and rest.
  Passage wet_way "the wet passage" is passage between gallery and leak.
  Passage shaft_way "the shaft passage" is passage between gallery and shaft_foot.
  Passage gauge_shaft "the gauge shaft" is shaft between shaft_foot and gauge_head taking 30 minutes needing climbing or rope.
  Passage sinkhole "the sinkhole" is climb between crest and leak taking 20 minutes needing rope.

  Thing cellar_door "the door in the broken wall" on broken_wall {
    State barred blocking "A heavy door closes the hole broken through the wall, barred on the cellar side.".
    State unbarred "The door in the broken wall stands with its bar off.".
  }
  // The bar is on the cellar side: only someone in the cellar can lift it.
  Action lift_bar(actor: group, site: place) "Lift the oak bar off the door in the broken wall" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, cellar) and state(cellar_door, barred).
    On success { Assert state(cellar_door, unbarred). }
    Result "The bar comes off its brackets with a groan, and cold, dry air comes round the door.".
  }
  Initially Assert keyholder(venn, cellar_door).

  Observe crest_scene at crest when not dark() "The crest of the Long Man is a dead-level walk of turf, wide as a lane. On one hand the dale falls away to Merrow's roofs; on the other, a long way down, lies Hollow Water, black and still, filling the valley to the hills. Nothing grows on the crest higher than a hand: every sapling has been cut off at the root, clean.".
  Observe crest_night at crest when dark() "By night the crest is a pale road between two darks: the dale's, with a few lights in it, and the lake's, with none.".
  Observe sinkhole_scene at crest when true "Halfway along, the turf has fallen into a raw hole a cart wide. Water drips somewhere far down in it.".
  Observe gauge_scene at gauge_head when true "At the north end of the crest a square grey stone stands over a square shaft going down into the hill. Notches are cut down every edge of the shaft, deeper than the light goes.".
  Observe gallery_scene at gallery when true "A tunnel lined with smooth grey stone, tall and narrow, as if cut for something taller than a man. The air is dry and still. Ways go off to either hand.".
  Observe sluice_scene at sluice when true "A chamber over the culvert, where the beck runs loud below an iron grating. Two great wheels of grey stone stand on their edges, set round with teeth of green bronze, and a third, smaller, works the shutter of the bottom sluice.".
  Observe rest_scene at rest when true "A niche in the gallery wall, taller than two men, with a ledge of grey stone at the back and tools laid on it in order: blades, hooks, a stone trowel, all of the same grey. Notches run in close rows up the walls.".
  Observe leak_scene at leak when not state(leak_gate, mended) "Water comes through a crack in the inner face of the gallery, a sheet of it, and runs away under the floor. A shutter of bronze teeth hangs half across the crack on a wheel with twelve empty sockets in its rim.".
  Observe leak_mended at leak when state(leak_gate, mended) "The bronze shutter is closed across the crack, every socket of its wheel filled. The wall of the gallery is wet, and no more.".
  Observe shaft_scene at shaft_foot when true "The bottom of a square shaft. Notches climb its four edges up into the dark, and the stone of the shaft-side toward the lake sweats.".

  // The Mower: it stands in its niche by day and walks the crest by night, and goes after its bronze.
  Person mower "the Mower" at rest {
    Role "the tall grey figure that walks the Long Man". Species automaton. Level 12.
    Wants bell_teeth.
  }
  Rule mower_rises when dark() and at(mower, rest) and able(mower) and not hunting(mower) { Assert at(mower, crest). }
  Rule mower_returns when not dark() and not at(mower, rest) and able(mower) { Assert at(mower, rest). Retract hunting(mower). }
  Relation hunting(group).
  // At midnight on the first night it comes down for the bronze that was in the cart, and finds the cart empty.
  Rule mower_hunts at yard when dark() and watch(clock) >= 96 and watch(clock) < 132 and state(cart, covered) and able(mower)
    says "Something tall comes over the yard wall without climbing it. The Mower goes to the cart, tears the tarpaulin away, finds nothing, and turns the cart over as if it were a barrow." {
    Assert state(cart, smashed). Assert hunting(mower). Assert at(mower, yard).
  }
  Observe mower_crest at crest when dark() and at(mower, crest) "The Mower walks the crest, slowly, the length of it and back. Every few paces it stoops, and a long blade flicks, and something small falls." teaches mower_keeps.
  Observe mower_resting at rest when at(mower, rest) "The Mower stands in its niche: a figure taller than two men, grey and too smooth, with its long arms at its sides and a face like a blank mask. It does not move. On its breastplate, in the light, a row of notches." .
  Observe mower_yard at yard when at(mower, yard) "The Mower stands in the yard by the overturned cart, its blank face turned toward the cellar." .
  Discovery keeper_named "The notches on the Mower's breastplate, read: KEEPER OF THE WALL." {
    Found by searching rest with lore "The notches on the Mower's breastplate are writing, the same writing as on the walls. It says, as near as it can be read: KEEPER OF THE WALL.".
  }
  Entity mower_keeps: fact "The Mower keeps the Long Man: it cuts every sapling on the crest before its roots can crack the wall, and it goes after bronze taken from its wheels.".
  Initially Assert established(mower_keeps).
  // Given back its bronze, it fits the teeth to the leak gate's wheel that night, and closes the gate.
  Event mower_mends near mower when keeps(mower, teeth) and not state(leak_gate, mended) "The Mower takes the sack of teeth in both hands, turns, and walks away into the hill. Some time later, deep inside the Long Man, something heavy closes with a sound like a bell." then {
    Assert state(leak_gate, mended).
  }
  Item mask "the Mower's mask" is keeper_mask at core.
  Rule mower_falls when dead(mower) and at(mower, ?p) and at(mask, core) { Assert at(mask, ?p). }

  // The leak gate, and what the leak has made of the clay.
  Thing leak_gate "the bronze shutter" at leak {
    State jammed "A shutter of bronze teeth hangs half across the crack, on a wheel with twelve empty sockets.".
    State fitted "The bronze teeth are back in the shutter's wheel; it hangs open, ready to be turned.".
    State mended "The shutter is closed across the crack.".
    Change heave "Heave the shutter's wheel round and close it" from fitted to mended needing brawn.
  }
  Action fit_teeth(actor: group, carrier: member, site: place) "Fit the bell-teeth back into the shutter's wheel" {
    Description "Twelve sockets, twelve teeth. They go in with a sound like a bell.".
    Requires able(actor) and company(actor) and at(actor, site) and at(leak_gate, site) and state(leak_gate, jammed)
      and memberOf(carrier, actor) and awake(carrier) and ownedItem(teeth, carrier).
    Time 6.
    Resolve drop(teeth, carrier).
    On success { Assert at(teeth, core). Assert state(leak_gate, fitted). }
    Result "One by one the teeth go into their sockets, and each one rings as it seats. When the twelfth is in, the wheel turns a finger's width under your hand.".
  }
  Person wet "the Wet" at leak {
    Role "a heaving mass of wet clay". Species mud_elemental. Level 5.
  }
  Initially Assert temperament(wet, temper_territorial). Initially Assert warning(wet, wet_rises). Initially Assert onslaught(wet, wet_comes).
  Entity wet_rises: fact "At the far end of the wet gallery the floor heaves, and a shape stands up out of the clay, streaming, as tall as a door.".
  Entity wet_comes: fact "The Wet comes down the gallery at you, faster than mud should.".
  Rule wet_slumps at leak when state(leak_gate, mended) and at(wet, leak) says "The Wet sags, and sags, and is a heap of clay on the floor, and then is only floor." { Assert at(wet, core). }

  // The sluice: the bottom gate under the chamber. Opened, it fills the culvert and runs the beck high.
  Thing bottom_sluice "the bottom sluice" at sluice {
    State shut "The small wheel is turned home; the bottom sluice is shut.".
    State open dangerous "The small wheel is turned out, and below the grating the water roars.".
    Change open_it "Turn the small wheel and open the bottom sluice" from shut to open needing brawn.
    Change shut_it "Turn the small wheel home and shut the bottom sluice" from open to shut needing brawn.
  }
  Thing culvert_water "the water in the culvert" on culvert is scenery {
    State low "The beck runs ankle-deep along the culvert floor.".
    State high blocking dangerous "The culvert is full to the roof with fast brown water.".
  }
  Rule culvert_fills when state(bottom_sluice, open) and state(culvert_water, low) says "Somewhere below, the water changes its voice." { Assert state(culvert_water, high). }
  Rule culvert_drains when state(bottom_sluice, shut) and state(culvert_water, high) { Assert state(culvert_water, low). }
  Rule mower_guards_sluice when state(bottom_sluice, open) and together(mower, party) and able(mower) says "The Mower turns its blank face toward the open sluice, and then toward you." { Assert assails(mower, party). }

  // The gauge shaft and its notches.
  Discovery notches_known "The notches on the font are water heights, like the notches down the gauge shaft: the same cuts, the same spacing. The highest notch on the font is level with the chapel's roof-beam." {
    Source shaft_notches "the notches down the gauge shaft" at shaft_foot readable by party.
  }
  Entity wall_known: fact "The Long Man is a wall: it holds Hollow Water back from the dale, and the beck comes through it by a culvert.".
  Initially Assert established(wall_known).
  Observe sluice_teaches at sluice when true "Above the grating the wheels and the culvert make plain what the Long Man is: not a barrow, a wall, with a lake behind it and a sluice through it." teaches wall_known.
  Observe teeth_missing at leak when not state(leak_gate, mended) "Fresh bright scars ring the empty sockets, where a bar has been used." teaches teeth_taken.
  Entity teeth_taken: fact "Twelve bronze teeth have been prised out of the wheel of the shutter that should close the leak in the Long Man.".
  Initially Assert established(teeth_taken).

  // The storm comes on the third day; two hours after midnight the Long Man breaks, unless its leak is shut or the
  // lake is drawn down.
  Relation storming(). Relation broke(place). Relation drowned(place). Relation drawn(place).
  Rule storm_comes when watch(clock) >= 312 and not storming() says "The wind goes round to the north, and the rain comes in over the fell in grey ropes." { Assert storming(). }
  Observe storm_scene at crest when storming() "Rain drives across the crest. Hollow Water has come up the lake face of the Long Man, grey and heaving, nearer than it was.".
  Rule field_wets when watch(clock) >= 240 and not state(leak_gate, mended) and not drowned(low_field) { Assert drowned(low_field). }
  Rule long_man_breaks when watch(clock) >= 396 and not state(leak_gate, mended) and not drawn(hollow) and not broke(long_man)
    says "In the dark, under the noise of the rain, there is another noise, very deep, like a wall falling a long way off. Then the sound of water." {
    Assert broke(long_man). Assert drowned(low_field). Assert drowned(green).
  }
  Hazard flood_waters "The flood" means "Deal (4d6) physical damage to ally unless dexterity save against (14).".
  Rule flood_takes when broke(long_man) and (at(party, green) or at(party, low_field) or at(party, landing) or at(party, millhouse) or at(party, nave) or at(party, taproom) or at(party, hollow_door) or at(party, springs))
    and not swept(party) { Assert strikes(flood_waters, party). Assert swept(party). }
  Relation swept(group).
  // Merrow on the hill, if Mother Ysolt rang the bell; otherwise Merrow in the low town when the water came.
  Rule bell_rung at green when storming() and convinced(ysolt) and at(folk, green)
    says "The chapel bell rings and rings, and doors open all over Merrow, and people go up the Hall lane in the rain with what they can carry." {
    Assert at(folk, yard). Assert at(ysolt, yard).
  }
  Relation lostToWater(group).
  Rule folk_lost when broke(long_man) and at(folk, green) { Assert lostToWater(folk). Assert at(folk, core). }
  Observe folk_saved at yard when at(folk, yard) and broke(long_man) "Merrow stands in the Hall yard in the rain, and looks down the lane at where it lived.".
  Goal false.
}
