Module dorothea "The Dorothea" {
  Description "The way home: the Dorothea lades dried cod, takes on a tide, and goes back by the same stations in reverse. Left behind, a company waits for the next ship, or finds another way.".

  // She stays two days at the jetty: a day to discharge and lade, a night to sleep, a morning ebb to go. A company that is
  // not aboard when she goes is on Skerrow; the next sail is the Mary Ann's, twelve days after, and a crown dearer.
  Measure back(entity). Measure leftAt(entity).
  Relation homeward(entity). Relation stranded(group).
  Rule hull_returns when arrived(hull) and not homeward(hull) and not safeHome(hull) and watch(clock) >= reachedAt(hull) + 144
    says "At the top of the morning ebb Bascom comes down the jetty with the pipe unlit, and the lines come off the rings, and the Dorothea goes out of Skerrow roads with her bow turned east." {
    Assert homeward(hull). Retract at(hull, jetty). Assert at(hull, roads). Set back(hull) to 0. Set leftAt(hull) to watch(clock). Retract arrived(hull). Retract troubled(hull). Assert state(hull, underway).
    Retract at(bascom, jetty). Assert at(bascom, helm).
  }
  Rule home_tick when homeward(hull) and not troubled(hull) and at(hull, roads) or homeward(hull) and not troubled(hull) and at(hull, teeth) or homeward(hull) and not troubled(hull) and at(hull, open_sea) or homeward(hull) and not troubled(hull) and at(hull, sound) { Increase back(hull) by 1. }
  Rule home_combs when homeward(hull) and at(hull, roads) and back(hull) >= 14 says "Ahead, the Combs: lower on the flood, the sea going over them in long white lines. Bascom takes the wheel herself. 'Not a word,' she says." {
    Retract at(hull, roads). Assert at(hull, teeth).
  }
  Rule home_open when homeward(hull) and at(hull, teeth) and back(hull) >= 32 says "The Combs are astern. The sea opens its long shoulders, and there is a smell in the wind of a place with chimneys." {
    Retract at(hull, teeth). Assert at(hull, open_sea).
  }
  Rule home_sound when homeward(hull) and at(hull, open_sea) and back(hull) >= 120 says "The first headland of the Sound stands up out of the haze, and a tern goes by with something silver in its beak, and Nipper, who has not been out of sight of land for two days, says it is the best thing he has ever seen." {
    Retract at(hull, open_sea). Assert at(hull, sound).
  }
  Rule home_quay when homeward(hull) and at(hull, sound) and back(hull) >= 160 and not safeHome(hull) says "Tolleth takes the Dorothea in with the sea going out of her like a great held breath. A woman on the quay shouts a name, and Mab Hallam answers it with a word that is not a name." {
    Retract at(hull, sound). Assert at(hull, quay). Assert safeHome(hull). Assert state(hull, alongside). Retract homeward(hull). Assert arrived(hull).
  }
  Relation safeHome(entity).
  Rule left_behind_isle when homeward(hull) and not aboardNow(party) and at(party, green) and not stranded(party) { Assert stranded(party). }
  Observe stranded_scene at jetty when stranded(party) and not arrived(hull) "The jetty is bare. Out on the roads a brown sail is getting small. Someone has chalked on the Gull's wall: MARY ANN, THE 24TH.".
  Observe tied_up_back at quay when safeHome(hull) "The Dorothea lies against Tolleth quay with her gangway down and her crew carrying casks of dried cod up the quay as though they had never left. Bascom is counting.".
}
