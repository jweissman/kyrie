Module tallow "Tallow Deep" {
  Relation lcConvoyOrdered(group). Relation lcConvoyArrived(group). Relation lcConvoyEntering(group).
  Relation lcConvoyInRoad(group). Relation lcConvoyAdvancing(group). Relation lcConvoyThrough(group).
  Relation lcGuardSupplied(group). Relation lcGuardLeft(group). Relation lcConvoyLeft(group).
  Measure lcConvoyDue(group). Measure lcConvoyEnterDue(group). Measure lcConvoyAdvanceDue(group).
  Measure lcGuardDue(group). Measure lcConvoyFoodDue(group).

  Person lc_convoy "the Ferryman's supply party" nowhere {
    Role "two armed men carrying a small pack of food for the road guard". Ancestry human.
    Calling warrior. Level 2. Numbers 2. Temperament territorial.
    Warns "Two men with short spears have put a leather pack down between them. The pack is tied with blue cord.".
    Comes "The men step away from the pack and come forward together.".
    Lair calx_portal.
  }
  Initially Set quantity(lc_convoy, rations) to 5.

  Rule lc_order_convoy when lcVanguardArrived(party) and at(lc_vanguard, calx_portal) and able(lc_vanguard)
    and not lcTruce(party) and not lcConvoyOrdered(party) {
    Assert lcConvoyOrdered(party). Set lcConvoyDue(party) to watch(clock) + 18.
  }
  Rule lc_convoy_arrives when lcConvoyOrdered(party) and able(lc_convoy) and not lcConvoyArrived(party) and not lcTruce(party)
    and able(lc_vanguard) and (at(lc_vanguard, calx_portal) or at(lc_vanguard, calx_way) or at(lc_vanguard, gate_house))
    and watch(clock) >= lcConvoyDue(party) {
    Assert lcConvoyArrived(party). Assert at(lc_convoy, calx_portal).
    Decrease quantity(lc_convoy, rations) by 1. Set lcConvoyFoodDue(party) to watch(clock) + 144.
  }
  Rule lc_convoy_enters when lcConvoyArrived(party) and at(lc_convoy, calx_portal) and able(lc_convoy)
    and state(portal_inside, cleared) and not lcConvoyEntering(party) and not lcConvoyInRoad(party) {
    Assert lcConvoyEntering(party). Set lcConvoyEnterDue(party) to watch(clock) + 6.
  }
  Rule lc_convoy_in_road when lcConvoyEntering(party) and at(lc_convoy, calx_portal) and able(lc_convoy)
    and state(portal_inside, cleared) and watch(clock) >= lcConvoyEnterDue(party) {
    Retract at(lc_convoy, calx_portal). Assert at(lc_convoy, calx_way).
    Retract lcConvoyEntering(party). Assert lcConvoyInRoad(party).
  }
  Rule lc_convoy_entry_stops when lcConvoyEntering(party)
    and (not at(lc_convoy, calx_portal) or not able(lc_convoy) or not state(portal_inside, cleared)) {
    Retract lcConvoyEntering(party).
  }
  Rule lc_convoy_advances when lcConvoyInRoad(party) and at(lc_convoy, calx_way) and able(lc_convoy)
    and state(calx_gate, raised) and not lcConvoyAdvancing(party) and not lcConvoyThrough(party) {
    Assert lcConvoyAdvancing(party). Set lcConvoyAdvanceDue(party) to watch(clock) + 6.
  }
  Rule lc_convoy_through when lcConvoyAdvancing(party) and at(lc_convoy, calx_way) and able(lc_convoy)
    and state(calx_gate, raised) and watch(clock) >= lcConvoyAdvanceDue(party) {
    Retract at(lc_convoy, calx_way). Assert at(lc_convoy, gate_house).
    Retract lcConvoyAdvancing(party). Assert lcConvoyThrough(party).
  }
  Rule lc_convoy_stopped when lcConvoyAdvancing(party)
    and (not state(calx_gate, raised) or not at(lc_convoy, calx_way) or not able(lc_convoy)) {
    Retract lcConvoyAdvancing(party).
  }
  Rule lc_guard_provisioned when at(lc_convoy, ?place) and able(lc_convoy)
    and at(lc_vanguard, ?place) and able(lc_vanguard) and lc_guard_posted() and lc_convoy_posted()
    and quantity(lc_convoy, rations) >= 1 and not lcGuardSupplied(party) and not lcTruce(party) {
    Increase quantity(lc_vanguard, rations) by quantity(lc_convoy, rations). Set quantity(lc_convoy, rations) to 0.
    Assert lcGuardSupplied(party).
  }
  Action lc_take_convoy_food(actor: group, site: place) "Take the supply party's remaining rations" {
    Requires able(actor) and company(actor) and at(actor, site) and at(lc_convoy, site)
      and not able(lc_convoy) and quantity(lc_convoy, rations) >= 1.
    Time 10 minutes.
    On success {
      Increase quantity(actor, rations) by quantity(lc_convoy, rations).
      Set quantity(lc_convoy, rations) to 0.
    }
    Result "You untie the blue cord and take the food from the pack.".
  }
  Query lc_guard_posted() means at(lc_vanguard, calx_portal) or at(lc_vanguard, calx_way) or at(lc_vanguard, gate_house).
  Query lc_convoy_posted() means at(lc_convoy, calx_portal) or at(lc_convoy, calx_way) or at(lc_convoy, gate_house).
  Rule lc_guard_eats when lc_guard_posted() and able(lc_vanguard)
    and watch(clock) >= lcGuardDue(party) and quantity(lc_vanguard, rations) >= 1 {
    Decrease quantity(lc_vanguard, rations) by 1. Set lcGuardDue(party) to watch(clock) + 144.
  }
  Rule lc_guard_leaves_hungry when lc_guard_posted() and at(lc_vanguard, ?place) and able(lc_vanguard)
    and watch(clock) >= lcGuardDue(party) and quantity(lc_vanguard, rations) < 1 and not lcGuardLeft(party) {
    Retract at(lc_vanguard, ?place). Assert lcGuardLeft(party).
  }
  Rule lc_convoy_eats when lc_convoy_posted() and able(lc_convoy)
    and watch(clock) >= lcConvoyFoodDue(party) and quantity(lc_convoy, rations) >= 1 {
    Decrease quantity(lc_convoy, rations) by 1. Set lcConvoyFoodDue(party) to watch(clock) + 144.
  }
  Rule lc_convoy_leaves_hungry when lc_convoy_posted() and at(lc_convoy, ?place) and able(lc_convoy)
    and watch(clock) >= lcConvoyFoodDue(party) and quantity(lc_convoy, rations) < 1 and not lcConvoyLeft(party) {
    Retract at(lc_convoy, ?place). Assert lcConvoyLeft(party).
  }
  Observe lc_convoy_at_portal at calx_portal when at(lc_convoy, calx_portal) and able(lc_convoy)
    "A pack with blue cord has come up the west road. Its two carriers have spears.".
  Observe lc_convoy_at_road at gate_house as sound when at(lc_convoy, calx_way) and able(lc_convoy)
    "Someone is carrying a pack along the road west of the gate.".
  Observe lc_guard_supplied near lc_vanguard when lcGuardSupplied(party) and able(lc_vanguard)
    "The road guard's food has arrived from the west. The opened pack is tied with blue cord.".
  Observe lc_guard_waits_food at gate_house when at(lc_vanguard, gate_house) and able(lc_vanguard)
    and not lcGuardSupplied(party)
    "The guard has brought food for a day. More is expected from the west.".
  Observe lc_guard_left at gate_house when lcGuardLeft(party)
    "The guard's place is empty. A scrap of blue cloth lies under the wheel.".
}
