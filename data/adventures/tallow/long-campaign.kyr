Module tallow "Tallow Deep" {
  Relation lcStarted(group). Relation lcSold(group). Relation lcKept(group).
  Relation lcFed(group). Relation lcSaved(group). Relation lcPrepared(group).
  Relation lcScoutArrived(group). Relation lcRaidArrived(group). Relation lcOccupied(group).
  Relation lcCleared(group). Relation lcCrewArrived(group). Relation lcRivalHelp(group).
  Relation lcRivalRefused(group). Measure lcStart(group). Measure lcRaidAt(group).
  Discovery lc_warden_news "Merren hopes to feed a road crew that can keep protections in repair.".
  Discovery lc_enemy_news "Merren once knew a ferryman now in the Dark Lord's service.".
  Discovery lc_drawing_risk "A drawing sold to a stranger could reach people looking for the hill's entrances.".
  Discovery lc_rival_need "Linnet searches the hill to feed her household.".
  Discovery lc_boats_memory "Merren remembers racing paper boats with the Ferryman.".

  Person lc_quartermaster "Quartermaster Merren Talwick" at taproom {
    Role "a quartermaster sent to provision the Rì's road crews". Ancestry human. Calling warrior. Level 2. Peaceable. Pronouns she. Manner stoic.
    Greets "A woman in a weather-stained coat sits with her boots off. A brass wheel is sewn to one sleeve. 'Merren Talwick,' she says. 'I am meant to get a repair crew fed. The crew is real. So is the hunger.'".
  }
  Topic lc_why with lc_quartermaster "Ask Merren why the road matters" when true once {
    Says "'The Rì's people can send masons and oil, if there is a road to send them on. A Warden at Quillet told me about a bell that still carried when it was cracked. You cannot keep a shore with good intentions alone.' She looks toward Lowen's kitchen. 'Nor can you feed a village on a promise of masons.'".
    On discuss { Assert knows(actor, lc_warden_news). }
  }
  Topic lc_enemy with lc_quartermaster "Ask Merren who else wants the road" when true once {
    Says "'Men who call their master the Dark Lord. They take stores, then offer to protect the people they have made hungry. Their captain ferried me across the Mere one summer. We spent a whole afternoon racing paper boats. He was very bad at it.'".
    On discuss { Assert knows(actor, lc_enemy_news). }
  }
  Topic lc_offer with lc_quartermaster "Ask Merren what she needs from Swallet" when been(party, adit) and not lcStarted(party) once {
    Says "'Word of the entrances, first. Then food for the crew. If you sell a drawing to the buyer on the green, he will pay; I cannot tell you where it will go. Keep it, and any stranger must look for himself. Either way, once you answer him, I must send for the crew.'".
    On discuss { Assert knows(actor, lc_drawing_risk). }
  }

  Person lc_buyer "the buyer of drawings" at green {
    Role "a stranger with a leather case and two clean pencils". Ancestry human. Peaceable. Pronouns he. Manner stoic.
    Greets "A man with a leather case is sketching the ridge from the green. 'I pay for a better drawing,' he says. 'Entrances, paths, anything a person would need to find their way in.'".
  }
  Action lc_sell(actor: group, site: place) "Sell the buyer a drawing of the entrances" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, green) and knows(actor, lc_drawing_risk) and not lcStarted(actor).
    Time 10 minutes.
    On success { Assert lcStarted(actor). Assert lcSold(actor). Set lcStart(actor) to watch(clock). Set lcRaidAt(actor) to watch(clock) + 72. Increase quantity(actor, gold) by 4. }
    Result "He pays four coin and folds the drawing into his case. He does not say who will read it. Across the green Merren begins writing a message to her crew.".
  }
  Action lc_keep(actor: group, site: place) "Keep the drawing and send the buyer away" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, green) and knows(actor, lc_drawing_risk) and not lcStarted(actor).
    Time 10 minutes.
    On success { Assert lcStarted(actor). Assert lcKept(actor). Set lcStart(actor) to watch(clock). Set lcRaidAt(actor) to watch(clock) + 120. }
    Result "The buyer puts his pencils away. 'I will have to look for myself,' he says. Across the green Merren begins writing a message to her crew.".
  }
  Observe lc_warning at green when lcStarted(party) and not lcRaidArrived(party) "Merren's message has gone. A repair crew is expected; strangers are looking for the ways into the hill. The river bank would be an exposed approach.".
  Observe lc_drawing_sold at green when lcSold(party) and not lcRaidArrived(party) "The buyer left with your drawing of the entrances.".
  Observe lc_drawing_kept at green when lcKept(party) and not lcRaidArrived(party) "The buyer has no drawing of the entrances from you.".

  Action lc_feed(actor: group, site: place) "Give two days of rations to Merren's repair crew" {
    Requires able(actor) and company(actor) and at(actor, site) and at(lc_quartermaster, site) and lcStarted(actor) and knows(actor, lc_warden_news) and not lcFed(actor) and not lcSaved(actor) and quantity(actor, rations) >= 2.
    Time 10 minutes.
    On success { Decrease quantity(actor, rations) by 2. Assert lcFed(actor). }
    Result "Merren puts the food aside for the crew. Lowen watches the bags go. 'They will eat,' she says. 'So will we, I hope.'".
  }
  Action lc_save(actor: group, site: place) "Keep the rations for the next descent" {
    Requires able(actor) and company(actor) and at(actor, site) and at(lc_quartermaster, site) and lcStarted(actor) and not lcFed(actor) and not lcSaved(actor).
    Time 10 minutes.
    On success { Assert lcSaved(actor). }
    Result "Merren nods. 'I cannot feed a crew on what you need below. I will tell them to bring their own, and they will come later.'".
  }
  Person lc_rival "Linnet Trevallick" at garden {
    Role "a salvage hunter with a hungry household". Ancestry human. Calling thief. Level 2. Peaceable. Pronouns she. Manner acerbic.
    Greets "Linnet is sorting useful nails from a rotten board. 'The hill is big enough for both of us,' she says. 'The things in it are not.'".
  }
  Topic lc_rival_food with lc_rival "Ask Linnet why she searches the hill" when true once {
    Says "'My brother cannot work the quarry with his leg as it is. I can sell what I find. We eat when I do.' She picks a nail out of the grass. 'I would rather be ahead of you than behind you. Do not take it personally.'".
    On discuss { Assert knows(actor, lc_rival_need). }
  }
  Action lc_rival_help(actor: group, site: place) "Give Linnet a ration so she can block the river path" {
    Requires able(actor) and company(actor) and at(actor, site) and at(lc_rival, site) and lcStarted(actor)
      and knows(actor, lc_rival_need) and not lcPrepared(actor) and not lcRivalHelp(actor) and not lcRivalRefused(actor) and not lcRaidArrived(actor)
      and quantity(actor, rations) >= 1 and watch(clock) + 6 < lcRaidAt(actor).
    Time 1 hour.
    On success { Decrease quantity(actor, rations) by 1. Assert lcRivalHelp(actor). Assert lcPrepared(actor). Increase lcRaidAt(actor) by 18. }
    Result "Linnet takes the food to her brother, then carries stones down to the bank. When she returns she says the path is blocked; an armed band will need three hours to clear it. 'Next time I still get first look at the good nails.'".
  }
  Action lc_rival_refuse(actor: group, site: place) "Keep your food and leave Linnet to her own work" {
    Requires able(actor) and company(actor) and at(actor, site) and at(lc_rival, site) and lcStarted(actor)
      and not lcRivalHelp(actor) and not lcRivalRefused(actor) and not lcRaidArrived(actor).
    Time 10 minutes.
    On success { Assert lcRivalRefused(actor). }
    Result "Linnet nods and goes back to the nails. 'I would have done the same,' she says. She does not sound pleased.".
  }
  Observe lc_rival_after at garden when lcRivalHelp(party) "Linnet has put the best of the nails aside in a neat row. There are fewer than before.".
  Observe lc_rival_alone at garden when lcRivalRefused(party) "Linnet is still sorting the nails, with her back to the river.".
  Action lc_prepare(actor: group, site: place) "Block the river path with loose stones" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, bank) and lcStarted(actor) and not lcPrepared(actor) and not lcRaidArrived(actor) and watch(clock) + 6 < lcRaidAt(actor).
    Time 1 hour.
    On success { Assert lcPrepared(actor). Increase lcRaidAt(actor) by 18. }
    Result "You pile loose stone across the path. A band can clear it, but will lose three hours doing so.".
  }

  Person lc_ferryman "the Ferryman" nowhere {
    Role "a man with a ferryman's pole". Ancestry human. Calling warrior. Level 4. Peaceable. Pronouns he. Manner stoic.
    Greets "'The road need not be your concern,' says the Ferryman. 'Give my people room to use it and we will keep the village supplied. Refuse, and the next men I send may not stop to ask.'".
  }
  Person lc_raiders "the Ferryman's raiders" nowhere {
    Role "three armed raiders sent to take the bank". Ancestry human. Calling warrior. Level 3. Numbers 3. Temperament territorial.
    Warns "Three armed figures are coming up the bank, one with a hooked pole for pulling down cover. They have not come to ask for a bed.".
    Comes "The raiders come up from the river together.".
    Lair bank.
  }
  Person lc_garrison "the Ferryman's garrison" nowhere {
    Role "three armed soldiers sent to hold the bank". Ancestry human. Calling warrior. Level 3. Numbers 3. Peaceable. Manner stoic.
    Greets "'The road is open,' says the soldier nearest the water. 'We will be here to see it stays that way.'".
  }
  Person lc_crew "Merren's road crew" nowhere {
    Role "two masons with a handcart of tools". Ancestry human. Peaceable. Manner stoic.
    Greets "'We were told there would be food,' says the mason at the handles. 'That is a good start.'".
  }
  Relation lcTermsHeard(group). Relation lcAccepted(group). Relation lcRefused(group).
  Rule lc_scout when lcStarted(party) and watch(clock) >= lcStart(party) + 18 and not lcScoutArrived(party) {
    Assert lcScoutArrived(party). Assert at(lc_ferryman, green).
  }
  Observe lc_ferryman_arrived at green when lcScoutArrived(party) and not lcTermsHeard(party) "A man with a ferryman's pole leans against the trough. He studies the path to the Rising.".
  Topic lc_terms with lc_ferryman "Hear the Ferryman's offer" when lcScoutArrived(party) and not lcTermsHeard(party) once {
    Says "'A place for my people at the bank, and a ration now for the men on their way. In return, no raids on Swallet while we hold the road.' He looks at the inn. 'Merren will tell you not to trust me. Ask her about the paper boats.'".
    On discuss { Assert lcTermsHeard(actor). }
  }
  Topic lc_remember with lc_quartermaster "Ask Merren about the Ferryman's paper boats" when lcTermsHeard(party) and knows(party, lc_enemy_news) once {
    Says "Merren smiles before she can stop herself. 'His always sank. He said the water was unfair.' She pulls her boot on. 'He has learned to make the water unfair to other people. That does not mean he has forgotten how to laugh.'".
    On discuss { Assert knows(actor, lc_boats_memory). }
  }
  Observe lc_boats at taproom when knows(party, lc_boats_memory) "Merren has folded a scrap of paper into a boat. It sits on the sill, far from the water.".
  Action lc_accept(actor: group, site: place) "Accept the Ferryman's terms for the bank" {
    Requires able(actor) and company(actor) and at(actor, site) and at(lc_ferryman, site) and lcTermsHeard(actor) and not lcAccepted(actor) and not lcRefused(actor) and not lcRaidArrived(actor) and quantity(actor, rations) >= 1.
    Time 10 minutes.
    On success { Assert lcAccepted(actor). Decrease quantity(actor, rations) by 1. }
    Result "The Ferryman takes a ration and marks the bank on his drawing. His men are coming; he promises they will not raid Swallet while they hold the road.".
  }
  Action lc_refuse(actor: group, site: place) "Refuse the Ferryman's terms" {
    Requires able(actor) and company(actor) and at(actor, site) and at(lc_ferryman, site) and lcTermsHeard(actor) and not lcAccepted(actor) and not lcRefused(actor) and not lcRaidArrived(actor).
    Time 10 minutes.
    On success { Assert lcRefused(actor). }
    Result "'Then watch the bank,' he says. He goes to the trough and washes the mud off his pole.".
  }
  Rule lc_raid when lcStarted(party) and not lcAccepted(party) and not lcRaidArrived(party) and watch(clock) >= lcRaidAt(party) {
    Assert lcRaidArrived(party). Assert at(lc_raiders, bank).
  }
  Rule lc_garrison_arrives when lcStarted(party) and lcAccepted(party) and not lcRaidArrived(party) and watch(clock) >= lcRaidAt(party) {
    Assert lcRaidArrived(party). Assert lcOccupied(party). Assert at(lc_garrison, bank).
  }
  Rule lc_crew_fed_arrives when lcFed(party) and not lcCrewArrived(party) and not lcOccupied(party) and watch(clock) >= lcStart(party) + 60 {
    Assert lcCrewArrived(party). Assert at(lc_crew, taproom).
  }
  Rule lc_crew_late_arrives when lcSaved(party) and not lcCrewArrived(party) and not lcOccupied(party) and watch(clock) >= lcStart(party) + 132 {
    Assert lcCrewArrived(party). Assert at(lc_crew, taproom).
  }
  Rule lc_take_bank when lcRaidArrived(party) and able(lc_raiders) and not lcOccupied(party) and watch(clock) >= lcRaidAt(party) + 36 {
    Assert lcOccupied(party).
  }
  Rule lc_clear_bank when lcOccupied(party) and not lcAccepted(party) and lcRaidArrived(party) and not able(lc_raiders) and not lcCleared(party) {
    Retract lcOccupied(party). Assert lcCleared(party).
  }
  Rule lc_clear_garrison when lcOccupied(party) and lcAccepted(party) and lcRaidArrived(party) and not able(lc_garrison) and not lcCleared(party) {
    Retract lcOccupied(party). Assert lcCleared(party).
  }
  Observe lc_raid_sign at bank when lcRaidArrived(party) and able(lc_raiders) "Fresh bootprints go from the water to the path. Three men have come up carrying weapons.".
  Observe lc_cover at bank when lcPrepared(party) "Loose stones lie across the river path.".
  Observe lc_holding at green when lcOccupied(party) "The Ferryman's people hold the river bank. The path to the Rising is still there; going down it will mean meeting them.".
  Observe lc_liberated at green when lcCleared(party) "The river bank is no longer held. Lowen has set a pot of water on the hearth for whoever comes back up the path.".
  Observe lc_crew_fed at taproom when lcFed(party) and lcCrewArrived(party) "The bags you gave Merren are open on Lowen's table. The road crew has its food.".
  Observe lc_crew_hungry at taproom when lcSaved(party) and not lcCrewArrived(party) "Merren's crew has not come yet. Lowen keeps a pot warm, though she cannot say when it will be needed.".
}
