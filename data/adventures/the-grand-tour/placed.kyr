Module sennet "The Grand Tour" {
  // A province of a generated world's first country: the company that comes down the coast road is the world's own.
  Entity party: group "Your company".
  // What the country's towns say of Sennet (the Rector's proclamation, nailed up where travellers are kept): once
  // the Tour is settled, one way or another, it is old news there, and they say so to whoever comes back.
  Entity word: fact "What is said of Sennet and its Grand Tour in the towns of the country.".
  Rule word_old when (doorOpen(sennet_bay) or cloudgateFell(sennet_bay) or closingDay()) and not stale(word) { Assert stale(word). }
}
