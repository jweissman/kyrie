Module muster "The Long Muster's Road" {
  // ── What the road costs ───────────────────────────────────────────────────────────────────────────────────────
  // A crossing, not a string of toll-booths. Pitons and rope are spent when they are used. Hunger bites at noon.
  // The season turns on the seventh day and the fifth arch closes in both directions. The weather can be read from
  // the heights. And a company that goes back loses what it carried up: the line, the days, the rope.
  Relation lineFixed(group). Relation hungerToday(group). Relation ateBread(group). Relation yeastDead(group).
  Query lateSeason() means day(clock) >= 7.
  Hazard hunger_pangs "A day without food on the fell" means "Deal (1d6) physical damage to ally unless constitution save against (13).".
  Rule hunger_bites when hungry(party) and hour(clock) == 12 and not hungerToday(party) and not within(party, kell)
    { Assert strikes(hunger_pangs, party). Assert hungerToday(party). }
  Rule hunger_resets when hungerToday(party) and hour(clock) >= 14 { Retract hungerToday(party). }

  Action rig_parapet(actor: group, site: place) "Drive a piton into the parapet and rig a line over the gap with a coil of rope" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, via_n) and holding(actor, piton) and holding(actor, rope) and not lineFixed(actor) and not lateSeason().
    Time 6.
    Resolve check(actor, climbing, dc_fair).
    On success { Spend piton from actor. Spend rope from actor. Assert lineFixed(actor). }
    Result "It takes three tries to find a crack that holds. The piton rings home, and the rope goes out over four hundred feet of air to the second, and the line sings in the wind like a plucked string. Nothing you carry will cross without it now, and nothing you used to carry is left to use anywhere else.".
    On failure { Spend piton from actor. }
    Otherwise "The crack takes the piton and spits it. It goes down into the gap without a sound, and it was one of yours.".
  }
  Observe late_snow_via at via_n when lateSeason() "Snow has come to the Viaduct in the night. The parapet is a white line, and the gap beyond it is white, and nothing crosses until the thaw.".
  Observe late_snow_octavius at octavius_hall when lateSeason() "The vault leaks snow-water down the wall in a line of icicles. In the lee of the rock a pack-mule's bones are already white to the knee.".

  // Weather you can read from the heights.
  Observe sky_high_snow at high1 when state(sky, snow_sky) "Snow blows across the High Road in long flat ribbons, and the peaks beyond the next shoulder have gone.".
  Observe sky_high_wind at high1 when state(sky, wind_sky) "The wind lays the heather flat and takes the breath out of your mouth. Nothing is in the air. Nothing could be.".
  Observe sky_high_thaw at high1 when state(sky, thaw_sky) "Every rock on the fell is running with water, and the whole slope talks.".
  Observe sky_ledge_snow at ledge1 when state(sky, snow_sky) "A line of clean white runs along the Ledge, unbroken, and a goat on the far buttress is watching it with the look of someone who has been told.".
  Observe sky_via_wind at via_n when state(sky, wind_sky) "The wind comes up the gap in gusts that move the rust-red birds on the parapet one block along.".
  Observe sky_via_thaw at via_n when state(sky, thaw_sky) "Far below, the river is the colour of tea and the noise of it comes up through the stone.".
  Observe sky_eagle_snow at eagle when state(sky, snow_sky) "Snow is drifting into the roofless fort in a long tongue from the gate-arch, over the courier-pouches.".
  Observe sky_pass_snow at pass_n when state(sky, snow_sky) "The notch is full of driven snow. The marmots are gone to ground and the giant's smoke goes up straight, which means there is nothing in the sky to bend it.".

  // The oxen stop at noon and the marmots empty the slope when the giant wakes: both are readable.
  Relation giantAwakeSeen(group).
  Rule marmots_see when at(party, pass_n) and not dark() and not giantAwakeSeen(party)
    says "The marmots whistle once, and again, and are gone: a slope of dived holes and a few shaken stones." { Assert giantAwakeSeen(party). }
  Rule marmots_calm when dark() and giantAwakeSeen(party) { Retract giantAwakeSeen(party). }
  Query giantAwake() means not dark().
  Relation gateNight(group).
  Rule gate_night when gateRebuffed(party) and not gateNight(party) and (hour(clock) >= 22 or hour(clock) < 4) { Assert gateNight(party). }
  Rule gate_cools when gateRebuffed(party) and gateNight(party) and hour(clock) >= 6 and hour(clock) < 12 { Retract gateRebuffed(party). Retract gateNight(party). }
  Rule yeast_dies when holding(party, yeast_pot) and chilled(party) { Spend yeast_pot from party. Assert yeastDead(party). }
  Observe yeast_dead_note at pistrina when yeastDead(party) "Octa Draycott looks at the empty place on her shelf and stands there for a quarter of a minute. 'Cold night,' she says. She has a spare pot. She does not offer it.".
  // The valley says the passes are closing, on the fifth to the sixth day.
  Observe closing_gate at gate when day(clock) >= 5 and not lateSeason() "The captain on the wall is looking north with his hand over his eyes. 'Early,' he says, to the sky. 'The passes will be shut within the week.'".
  Observe closing_forum at forum when day(clock) >= 5 and not lateSeason() "People in the forum keep stopping to look at the north wall of the valley. The grain-carts are going out the wrong way, back to the granary, with the last of the harvest.".
  Observe closing_eagle at eagle when day(clock) >= 5 and not lateSeason() "Fresh snow lies on the far peaks, down to the first terrace. The wind off the Viaduct smells of it.".
  Observe closing_octavius at octavius_hall when day(clock) >= 5 and not lateSeason() "A thin line of white has come down the north face of the fell overnight. The scribe's bench is damp with it.".
}
