Module muster "The Long Muster's Road" {
  Discovery ropeway_known "The Cohort's engineers will string a rope-way across the fifth arch of the Viaduct, from the north pier to the south abutment, for anyone the Cohort counts a friend.".
  Relation dispatchSent(group).
  Topic hobday_dispatch with hobday "Give the reeve the Prefect's dispatch" when holding(actor, dispatch) and not dispatchSent(party) once {
    Says "The reeve breaks no seal. He turns it over and reads the superscription, twice, and goes the colour of the dish he is standing by. 'There is a bishop at Hale who keeps the old archives,' he says slowly. 'He will know who to give it to. I'll send it by the carrier on the quarter-day, and I'll put in twenty crowns of my own for the postage and the shame.'".
    On discuss { Spend dispatch from actor. Increase quantity(actor, gold) by 40. Assert dispatchSent(party). }
  }
  Observe dispatch_news_inn at taproom when dispatchSent(party) "Maud Hennick has put a second lamp in the window.".
  Observe dispatch_news_shrine at shrine when dispatchSent(party) "A new wax tablet has been pushed into the cracks, in a courier's hand: THE LETTER WENT NORTH. AWAIT THE ANSWER.".
  Observe ropeway_seen at via_n when knows(party, ropeway_known) "A pair of iron staples is driven into the north pier, new, bright, with a rope's worn groove.".
  Observe ropeway_seen_s at via_s when knows(party, ropeway_known) "Across the gap, the engineers' rope-way hangs from two staples, taut as a bowstring.".
  Observe valley_news_kell at green when scoutGiven(party) "Dunya of the Last Cohort is standing at Kell trough looking at the thirty houses with every sign of delight.".

  Objective cross_road when not been(party, septimus_hall) "Sixty miles of road lead over the Hesper Fells from Kell Ford, and the board in the village says the far end is held.".
  Objective find_cohort when been(party, septimus_hall) and not been(party, gate) "The road is the legion's, and the legion's road leads somewhere. Five days, the milestones say, from the Ford.".
  Objective tell_valley when been(party, gate) and not told_prefect(party) and not told_moll(party) "The Cohort holds its gate against an empire that is dust. Someone should be told. Or not.".
  Objective carry_dispatch when dispatchTaken(party) and not dispatchSent(party) "The Prefect has given the company a dispatch for the Emperor. Someone north should read it.".

  Milestone m_septimus "reached the Mansio Septimus" worth 100 when been(party, septimus_hall).
  Milestone m_octavius "reached the Mansio Octavius" worth 150 when been(party, octavius_hall).
  Milestone m_viaduct "crossed the fifth arch of the Great Viaduct" worth 300 when been(party, via_s).
  Milestone m_eagle "stood in the roofless Mansio of the Eagle" worth 150 when been(party, eagle).
  Milestone m_pass "passed the giant in the Giant's Pass" worth 250 when been(party, pass_s).
  Milestone m_gate "came down to the gate of the Last Cohort and was let in" worth 300 when been(party, forum) and admitted(party).
  Milestone m_told "told the Last Cohort what became of the empire" worth 300 when told_prefect(party) or told_moll(party).
  Milestone m_sent "sent the Prefect's dispatch north" worth 250 when dispatchSent(party).
}
