Module muster "The Long Muster's Road" {
  // ── Questions put to the company ─────────────────────────────────────────────────────────────────────────────────
  // The valley asks before it receives. The Prefect puts three questions to whoever comes in at the gate; the
  // answers are the company's character in the valley's eyes (and in the Prefect's), and they shape what the
  // valley will hear and from whom. Smaller questions are put by the giant, the apothecary, the salt-reckoner, the
  // Centurion, the Archivist, the innkeeper and the reeve, each of whom wants to know one thing before they will
  // tell one thing.
  Measure prefectRegard(group). Relation interviewQ1(group). Relation interviewQ2(group). Relation interviewQ3(group).
  Relation reeveNamed(group). Relation giantAnswered(group). Relation orsaAnswered(group). Relation rheaAnswered(group).
  Relation mollAnswered(group). Relation merulaAnswered(group). Relation mollSwore(group).

  // The Prefect's interview.
  Topic corvin_q1 with corvin "Let the Prefect put his first question" when admitted(party) and not interviewQ1(party) once {
    Says "Corvin folds his hands on the accounts. 'I shall ask three things,' he says, 'as my fathers asked of every stranger who came to the gate, in the days when we had strangers. First: who sent you?'".
  }
  Topic corvin_q1_none with corvin "Say that nobody sent you: you came to see what the road led to" answering corvin_q1 when true {
    Says "'Nobody,' says Corvin. He tastes it. 'It is the first time I have heard that answer in my life. In my father's day men came because they were told. Nobody comes because they are not.' He almost smiles. 'Go on.'".
    On discuss { Assert interviewQ1(party). Increase prefectRegard(party) by 2. }
  }
  Topic corvin_q1_north with corvin "Say that the north sent you: you are what the Emperor's silence looks like" answering corvin_q1 when true {
    Says "A pause that goes on a long time. 'That is a very fine sentence,' says Corvin. 'Whoever taught you to say it was not wrong.' He looks down. 'I do not believe you are what you say, and I am glad you said it.'".
    On discuss { Assert interviewQ1(party). Increase prefectRegard(party) by 1. }
  }
  Topic corvin_q1_private with corvin "Say that you would tell him alone, and no one else" answering corvin_q1 when true {
    Says "'Ah,' says Corvin, and glances at the clerk, who finds a reason to be at the far end of the hall. 'Then it is a thing worth hearing.' He leans forward. 'Go on.'".
    On discuss { Assert interviewQ1(party). Increase prefectRegard(party) by 1. }
  }
  Topic corvin_q2 with corvin "Let the Prefect put his second question" when interviewQ1(party) and not interviewQ2(party) once {
    Says "'Second,' says Corvin. 'You came through the forum. You saw the standard. Tell me what you saw in it.'".
  }
  Topic corvin_q2_fine with corvin "Say that it is the most beautiful thing you have seen on the road" answering corvin_q2 when true {
    Says "'It is,' says Corvin, simply. 'I know it is. I do not know why.' His shoulders ease. 'You have a good eye.'".
    On discuss { Assert interviewQ2(party). Increase prefectRegard(party) by 1. }
  }
  Topic corvin_q2_heavy with corvin "Say that it looks heavy: that it looks like something people carry" answering corvin_q2 when true {
    Says "'Heavy,' says Corvin. His hands are very still. 'Orsa says it too, and Elpis, and a boy of ten last week.' He looks at you for a long moment. 'Everyone who says heavy has been right.'".
    On discuss { Assert interviewQ2(party). Increase prefectRegard(party) by 2. }
  }
  Topic corvin_q2_metal with corvin "Say that it is metal on a pole, and the people are the thing" answering corvin_q2 when true {
    Says "'Metal on a pole,' says Corvin, without heat. 'That is what the Hearth says. It is also what my fathers said in the plague winter, in private, with the doors shut.' He looks at the doors. 'I have never heard it said in the Praetorium.'".
    On discuss { Assert interviewQ2(party). }
  }
  Topic corvin_q3 with corvin "Let the Prefect put his last question" when interviewQ2(party) and not interviewQ3(party) once {
    Says "'Third,' says Corvin, and his voice has changed. 'What is north of the Viaduct?'".
  }
  Topic corvin_q3_kell with corvin "Say that there is a village, thirty houses round a trough, and they keep a lamp in the window" answering corvin_q3 when knows(actor, red_cloak_known) or been(party, green) {
    Says "Corvin does not move. 'A lamp,' he says. 'In a window.' He is looking at nothing. 'For whom?' 'They do not know,' you say. 'They put it in because they always have.' He puts his hand over his mouth. 'Then someone was always going to answer,' he says through his fingers. 'We were looking at the wrong end of the road.'".
    On discuss { Assert interviewQ3(party). Assert received(party). Increase prefectRegard(party) by 2. }
  }
  Topic corvin_q3_bishop with corvin "Say that there are scholars at Hale who keep the empire's old archives" answering corvin_q3 when true {
    Says "'Archives,' says Corvin. 'Scholars.' A light goes into his face. 'Then there is a place the Emperor's name is written, and read.' He turns the idea over like a coin. 'I shall write them a dispatch.'".
    On discuss { Assert interviewQ3(party). Assert received(party). Increase prefectRegard(party) by 1. }
  }
  Topic corvin_q3_refuse with corvin "Say that you will not answer, because the answer is not yours to give" answering corvin_q3 when true {
    Says "'Not yours,' says Corvin, after a time. 'No.' He nods. 'That is a fair answer. It is the answer of a courier who has been told something to carry and not told what.' He stands. 'You may go where you will in the valley, on that.'".
    On discuss { Assert interviewQ3(party). Increase prefectRegard(party) by 1. }
  }

  // The giant's question.
  Topic giant_asks with giant "Ask the giant what he wants besides iron" when tolerates(giant, party) or giantPaid(party) once {
    Says "The giant turns the fire-iron over and looks at the end of it. 'Is the king still king?' he says. 'The one I keep this house for. He had a beard, I think. It was a long time ago.'".
  }
  Topic giant_yes with giant "Say that the king is still king, and sends his regards" answering giant_asks when true {
    Says "'Good,' says the giant, with immense relief. He puts down the iron. 'That is a weight. Eat. There is mutton. Do not tell the little ones.'".
    On discuss { Assert giantAnswered(party). Increase marraTrust(marra) by 0. }
  }
  Topic giant_no with giant "Say that the king is dead, and so is his kingdom, and you are sorry" answering giant_asks when true {
    Says "The giant says nothing at all for a long time. 'I see,' he says. His great hands open on his knees. 'Then I shall keep the house for no one. That is easier, in a way. One does not get disappointed.' After a time: 'Go on. I shall mind the fire.'".
    On discuss { Assert giantAnswered(party). }
  }

  // The reeve's question.
  Topic reeve_names with hobday "Let the reeve ask where to write if you do not come back" when true once {
    Says "The reeve has his hammer in his fist and a nail between his teeth. 'The board has forty-one names,' he says round the nail. 'Every one of them, I wrote, to somebody. I would like not to write a forty-second to nobody. Who?'".
  }
  Topic reeve_name_one with hobday "Give the name of someone at home" answering reeve_names when true {
    Says "He writes it in a small neat hand on a slip, and pins the slip to the board, under the others. 'There,' he says. 'That is done properly.'".
    On discuss { Assert reeveNamed(party). }
  }
  Topic reeve_name_none with hobday "Say there is no one" answering reeve_names when true {
    Says "'Then I'll write it to the road,' says the reeve, after a moment. 'It can have a letter. It has had all the rest of us.'".
    On discuss { Assert reeveNamed(party). }
  }

  // The apothecary's question.
  Topic orsa_asks with orsa "Let Dame Orsa ask what herbs you carried over the Fells" when true once {
    Says "She sets down the pestle and looks at you very straight. 'Tell me honestly,' she says. 'You carried herbs over two hundred miles of fell to sell to a woman you hadn't met. What did you think they were worth?'".
  }
  Topic orsa_ans_fair with orsa "Say that you asked a fair price, and would take a fair one" answering orsa_asks when true {
    Says "'Fair,' she says, pleased. 'Then I shall be fair.' She opens a drawer. 'Kingsfoil, ninety. Is that fair?'".
    On discuss { Assert orsaAnswered(party). }
  }
  Topic orsa_ans_high with orsa "Say that nothing from the north was ever worth less than gold to you" answering orsa_asks when true {
    Says "'Gold,' she says, and laughs. 'We have no gold. We have salt and bread and I can give you a cure for anything you have.' She points a stained finger. 'But I take the compliment.'".
    On discuss { Assert orsaAnswered(party). }
  }

  // The salt-reckoner's question.
  Topic rhea_asks with rhea "Let the salt-reckoner ask how you came by the Aenean coin" when true once {
    Says "Rhea does not look up. 'Aenean silver does not turn up in a stranger's pocket,' she says. 'Where did you get it? Be exact. I shall know.'".
  }
  Topic rhea_ans_road with rhea "Say you took it off the stack at the Eagle, where the Muster left it" answering rhea_asks when true {
    Says "'Honest,' says Rhea. 'Dead men's silver on a dead men's road.' She weighs it. 'Fair.'".
    On discuss { Assert rheaAnswered(party). }
  }
  Topic rhea_ans_sale with rhea "Say you were paid it, for a service, in the world beyond the Fells" answering rhea_asks when true {
    Says "She looks at you for a long time. 'There is no world beyond the Fells,' she says. 'But I take your meaning.' She slides the coin back across the trestle. 'Do not say that to the Eagles.'".
    On discuss { Assert rheaAnswered(party). }
  }

  // The Centurion's question.
  Topic merula_asks with merula "Let the Centurion ask what you saw in the Pass" when true once {
    Says "'What did you see at the head of the Descent?' says Merula. She is not looking at you; she is looking at the rack of spears. 'I should like to hear you tell it, and I shall know if you leave a thing out.'".
  }
  Topic merula_ans_all with merula "Tell her everything: the toll, the men, the one with the bow" answering merula_asks when true {
    Says "She listens to the end, standing very straight. At the bow she shuts her eyes. 'Thank you,' she says, in a voice that has been sanded. 'I shall act on it.'".
    On discuss { Assert merulaAnswered(party). Assert knows(actor, marcus_known). }
  }
  Topic merula_ans_part with merula "Say you saw some men in the Pass who took a toll, and no more" answering merula_asks when true {
    Says "'Some men,' says Merula. 'Yes. Men.' She turns the cane over. 'A toll. I shall have that looked at.' She does not ask again.".
    On discuss { Assert merulaAnswered(party). }
  }

  // The Archivist's question.
  Topic moll_asks with moll "Let the Archivist ask what it is you want of the Annals" when annalsOpen(party) once {
    Says "'Before I show you a thing I must know what it will be used for,' says Moll. 'A history in the wrong hand is a knife. What do you want to do with it?'".
  }
  Topic moll_ans_know with moll "Say that you only want to know" answering moll_asks when true {
    Says "'Only,' he says. 'Yes. That is what the first Archivist said. It is the right reason and the most dangerous.' He turns a page. 'Read.'".
    On discuss { Assert mollAnswered(party). }
  }
  Topic moll_ans_swear with moll "Swear on the lamp of the shrine that you will not use it to harm the valley" answering moll_asks when true {
    Says "He considers the oath for a long time. 'It is a fine thing to swear on,' he says. 'Eleven hundred years of lamp.' He nods, once. 'I shall hold you to it.'".
    On discuss { Assert mollAnswered(party). Assert mollSwore(party). }
  }
}
