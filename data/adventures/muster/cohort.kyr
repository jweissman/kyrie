Module muster "The Long Muster's Road" {
  // ── The Last Cohort: two thousand people who were left to hold a road ────────────────────────────────────────────
  // Eleven hundred and four years of the last emperor's reign (they count no other). A rearguard of nine hundred
  // was told to hold the valley until the General sent for it; he did not send. They became a town: wheat on the
  // terraces, vines, salt-oxen, a school that teaches the March by heart, a granary kept on a rota, a Sending of one
  // courier north every spring on a lot, and a standard in the forum that every soul in the valley salutes at the
  // fourth hour. Three parties keep the faith in three ways: the Eagles (who hold the standard and the discipline),
  // the Hearth (who hold the fields, and doubt) and the Archive (who have counted, in private, every unanswered
  // spring). The company arrives into that. It may be received as a courier, as a clerk, as a liar or as a thief; it
  // may tell, or not tell; and what it does with the truth is the point of the road.
  Discovery empire_gone "The empire the Cohort serves has been dust for eleven hundred years.".
  Discovery cohort_law "The Muster's law holds the valley: the Prefect rules by the last emperor's regnal year, a courier goes north every spring, and no answer has come.".
  Discovery cohort_factions "The Last Cohort keeps its faith in three parties: the Eagles, who hold the standard; the Hearth, who hold the fields and doubt; and the Archive, who count the springs.".
  Relation received(group). Relation gateRebuffed(group). Relation merulaFull(group). Relation admitted(group). Relation claimedRelief(group). Relation dispatchTaken(group).
  Relation told_prefect(group). Relation told_ostrander(group). Relation told_merula(group). Relation told_elpis(group). Relation traded_only(group).
  Relation valleyTold(group). Measure toldAt(group). Relation scoutGiven(group). Relation pardoned(group). Relation merulaKnowsSon(group).
  Relation goldReturned(group). Relation sealNoted(group). Relation doseTold(group). Relation hobbeShut(group). Relation hearthOwes(group). Relation brandShut(group). Relation brandTold(group). Relation prefectReadSeal(group). Relation forgeryKnown(group).
  Relation orsaConfessed(group). Relation gaiusPontus(group). Relation liviaMapped(group). Relation hobbeFreed(group). Relation gaiusSecret(group).

  // ── The gate: a challenge in a language the company probably cannot speak ───────────────────────────────────────
  Person sentries "the sentries of the gate" at gate {
    Role "four soldiers of the Last Cohort in red cloaks, on the wall". Ancestry human. Calling warrior. Level 3. Numbers 4. Temperament territorial.
    Warns "A voice from the wall rings out in an Aenean so formal it sounds like singing. A spear comes down across the road. 'Quis venit? Give the word, or the pouch.' It means: who comes?".
    Comes "The sentries come down off the wall at the double.".
    Lair gate.
    State challenging blocking "Four soldiers of the Last Cohort stand across the gate with their spears crossed.".
    State stood_down "The sentries lean on their spears on the wall and let the road lie open.".
    Guards gate_forum.
  }
  Rule sentries_stand_down when tolerates(sentries, party) and state(sentries, challenging) { Assert state(sentries, stood_down). Retract warned(sentries, party). }
  Observe sentry_gloss at gate when holding(party, old_glossary) "With the scribe's glossary open in your hand the song resolves into words: QUIS VENIT, who comes; DA TESSERAM, give the watchword; ET SI NON, and if not.".
  Action answer_challenge(actor: group, site: place) "Answer the sentries' challenge in the old script, out of the glossary" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, gate) and at(sentries, gate) and able(sentries)
      and holding(actor, old_glossary) and not tolerates(sentries, actor) and not gateRebuffed(actor).
    Time 0.
    On success { Assert tolerates(sentries, actor). Retract warned(sentries, actor). Assert admitted(actor). }
    Result "You read the answer off the glossary's page, falling over every second syllable: VENIMUS A SEPTENTRIONE, we come from the north; NON HOSTES, not enemies; NUNTIUM FERIMUS, we bring word. The captain on the wall listens with his head down, and then lifts it. 'He speaks like a clerk from the schools,' he says. 'Admit them.'".
  }
  Action plead_without_glossary(actor: group, site: place) "Make signs and shout the little Aenean you have, and hold up your empty hands" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, gate) and at(sentries, gate) and able(sentries)
      and not holding(actor, old_glossary) and not tolerates(sentries, actor) and not gateRebuffed(actor).
    Time 0.
    Resolve check(actor, lore, dc_formidable).
    On success { Assert tolerates(sentries, actor). Retract warned(sentries, actor). Assert admitted(actor). }
    On failure { Assert gateRebuffed(actor). }
    Result "Somewhere between the roadside inscriptions and the milestones you have a hundred words. You shout them in the wrong order, and one of the guards laughs, and says something to the others, and a spear goes up. 'Ad Praetorium,' he says, with great slowness, as to a child. To the Praetorium.".
    Otherwise "The captain listens to the whole of it with the particular patience of the very well-bred. 'Not Aenean,' he says to the others. 'Not even Hale.' The spears stay level until morning.".
  }
  Action deliver_pouch(actor: group, site: place) "Hold up a courier's pouch with the Cohort's own seal" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, gate) and at(sentries, gate) and able(sentries)
      and holding(actor, courier_pouch) and not tolerates(sentries, actor) and not gateRebuffed(actor).
    Time 0.
    On success { Spend courier_pouch from actor. Assert tolerates(sentries, actor). Retract warned(sentries, actor). Assert admitted(actor). }
    Result "The voice on the wall stops. A spear comes up. 'That is ours,' says one of them. 'That is the seal.' The captain comes down the wall-stair and takes it out of your hand with two fingers, and looks at the wheel, and at the date, and at you. 'Where?' he says. 'The Eagle,' you say. 'The stack.' He gives it to a boy, who runs. 'Then you walked the Viaduct,' says the captain. 'Come in. The Prefect will want you.'".
  }

  Action claim_relief(actor: group, site: place) "Say that you are the relief the General promised, come at last" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, gate) and at(sentries, gate) and able(sentries) and not tolerates(sentries, actor) and not gateRebuffed(actor).
    Time 0.
    Resolve check(actor, deception, dc_formidable).
    On success { Assert tolerates(sentries, actor). Retract warned(sentries, actor). Assert admitted(actor). Assert claimedRelief(actor). }
    On failure { Assert gateRebuffed(actor). }
    Result "There is a silence on the wall. The captain takes off his helmet. 'Eleven hundred and four years,' he says, and cannot finish. A horn begins, and the gate opens, and you walk in under it.".
    Otherwise "The captain's face does not change. 'The relief would have a seal,' he says. 'Lower your hands.' Spears come level along the wall, and nothing you say will move them before morning.".
  }
  Observe gate_sound at gate as sound when true "From the wall a horn sounds the watch, three notes, as it has been sounded every watch for eleven hundred years.".

  // ── The standard, and the General's letters ────────────────────────────────────────────────────────────────────
  Thing standard "the standard of the Cohort" at forum is scenery {
    State raised "The bronze eagle stands on its pole in the middle of the forum, burnished, with its wings half open.".
    State struck "The standard has been taken down and lies on a plank, wrapped in sacking. A clerk is chiselling a new line under the old on the tablet beside it.".
    State kept "The standard is where it was. Someone has hung a black cloth over it, and nobody has said why.".
    State golden "The eagle on the pole has been taken down and put up again, and it is the same eagle, and it is not: it catches the light as bronze never could, and the whole forum has gone quiet before it.".
  }
  Initially Assert state(standard, raised).
  Thing generals_letters "the General's sealed bundle" at archive {
    State sealed closed "A bundle of letters tied in red tape and sealed with the General's own wheel lies on the table, whole, to every eye in the valley, since the Muster marched.".
    State broken "The seal is broken, and the letters lie open.".
    Change break_seal "Break the General's seal and read" from sealed to broken.
    Holds.
  }
  Rule seal_broken_noticed when state(generals_letters, broken) and at(party, archive) and not sealNoted(party)
    says "Ede Cassel's pen stops. Ostrander does not turn round. 'That seal has been whole for eleven hundred years,' he says to the cedar presses. 'It was the one thing in this room I was sure of.' The Annals are shut when you look for them again, and the oath you swore on the lamp is not one he will hold you to now, because you have shown him what it was worth." { Assert sealNoted(party). Retract annalsOpen(party). Retract ostranderSwore(party). }
  Discovery general_read "The General wrote that the Emperor was ill, that the Muster's rearguard must hold the road until a relief came, and that he would send for them from the sea by the spring. He did not send.".
  Observe letters_read at archive when state(generals_letters, broken) "The letters are in three hands: the General's, in a hurry; a secretary's fair copy; and under the last a postscript in the General's own, shaky and plain: SEND FOR THEM. IF I FORGET, SOMEONE SEND FOR THEM. It is dated the eleventh day of the march." teaches general_read.

  // ── The Prefect ────────────────────────────────────────────────────────────────────────────────────────────────
  Person corvin "Vettius Corvin" at praetorium_hall {
    Role "Prefect of the Last Cohort". Ancestry human. Calling warrior. Level 3. Pronouns he. Manner stoic. Peaceable.
    Greets "A tired man in a red cloak sits on the tribunal's plain chair, with the cohort's accounts. 'A courier,' he says, 'from the north. I did not think I should see it.' Then, in the plain tongue, with a courtesy that costs him: 'Salve. Sit. Whatever you are, you are welcome. We have bread.'".
  }
  Topic corvin_ask with corvin "Ask the Prefect about the Cohort" when true {
    Says "'The Long Muster marched out from the capital in the year one of the Taurine count,' says Corvin. 'Eleven thousand went south-east. My fathers held the rearguard, nine hundred, and the road behind them is held to this day. We have kept the gate for eleven hundred and four years, and the Emperor has not called us home.' His eye goes to the tablet-wall. 'A courier goes north every spring. I would be glad to be told that one had arrived.'".
    On discuss { Assert knows(actor, cohort_law). Assert knows(actor, cohort_factions). }
  }
  Topic corvin_year with corvin "Ask the Prefect what year it is" when true {
    Says "'The eleven hundred and fourth year of the Taurine count,' says Corvin, 'the sixth day before the Nones of Frost. My sixteenth as Prefect.' He says it like his own address. 'Eleven hundred and four. It sits well.'".
  }
  Topic corvin_seal with corvin "Ask the Prefect whether he has read the General's letters" when knows(actor, general_read) and prefectRegard(party) >= 4 and not prefectReadSeal(party) once {
    Says "Corvin is silent. 'Once,' he says. 'In my thirtieth year, in the plague of the cattle, when I thought the seal was a thing a man might break to find the answer. I broke it. I read, and I resealed it with the General's wheel from the case, and I put it back.' He rubs his face. 'I have told no one. The seal is whole to the valley. What it says is that nobody was coming, and that he knew it.' He studies you. 'What would you do with that?'".
    On discuss { Assert prefectReadSeal(party). }
  }
  Topic corvin_trade with corvin "Say that you came only to trade, and ask nothing of the valley" when admitted(party) and interviewQ3(party) and not valleyTold(party) and not traded_only(party) once {
    Says "Corvin looks at you for a long moment, and something in his shoulders eases. 'Then you are welcome in all that matters,' he says. 'Orsa wants herbs. Rhea wants Aenean coin. The children want to be told what is on the other side, and I should be grateful if you did not tell them today.' He doesn't ask what you know. You see that he has chosen not to.".
    On discuss { Assert traded_only(party). Assert state(standard, raised). }
  }
  Topic corvin_dispatch with corvin "Ask the Prefect for his dispatch" when received(party) and prefectRegard(party) >= 3 and not dispatchTaken(party) once {
    Says "Corvin writes for some time, seals it, and holds it out. 'To the Emperor, or to whoever keeps his archive. Carry it north. Let it be answered, if it can be.'".
    On discuss { Give dispatch_item to actor. Assert dispatchTaken(party). }
  }
  Kind dispatch "the Prefect's dispatch" is document teaching dispatch_read described "A letter on vellum, sealed with the wheel, addressed to the Emperor.".
  Discovery dispatch_read "The Prefect asks the Emperor whether the Cohort may be relieved, and whether the northern road is still held.".
  Item dispatch_item "the Prefect's dispatch" is dispatch at nowhere.

  // ── Telling: five ways to put the same fact into the valley ────────────────────────────────────────────────────
  Topic corvin_tell with corvin "Tell the Prefect that the empire is gone" when admitted(party) and interviewQ3(party) and not valleyTold(party) and not traded_only(party) once {
    Says "Corvin does not move until the clerk in the doorway has gone away. 'Eleven hundred and four years,' he says. 'You are certain.' He gets up, goes to the window, and looks at the eagle in the forum. 'I shall have the standard struck at dawn. The valley will want to know what we are, if not what we were told. I shall tell them. It had better come from me.' He turns. 'Thank you,' he says, and goes to stand at the window with his back to you.".
    On discuss { Assert told_prefect(party). Assert valleyTold(party). Assert knows(actor, empire_gone). Assert state(standard, struck). Set toldAt(party) to watch(clock). }
  }
  Topic ostrander_tell with ostrander "Tell the Archivist what the road is" when admitted(party) and not valleyTold(party) and not traded_only(party) once {
    Says "Ostrander listens with his eyes shut. 'The Annals record, in the General's own year, that an answer was promised by the spring,' he says, 'a promise which, being a thousand and a hundred springs old, I have come to read as a kind of weather.' He opens his eyes. 'The Prefect is a decent man and a tired one. I will tell him by degrees. In a year, in two. Not at dawn, with the buccina.' He takes a red book down from the press. 'There is a note in the engineers' hand about the fifth arch. The Cohort can string a rope-way, and I shall have the note copied for you: come back to me in half a day, and not before. Let us send someone north, to see, and let them take the Annals, and let the valley be told afterwards, by someone it trusts, what it has been waiting for.'".
    On discuss { Assert told_ostrander(party). Assert valleyTold(party). Assert knows(actor, empire_gone). Give itinerarium_copy to actor. Assert state(standard, kept). Retract annalsOpen(party). Set toldAt(party) to watch(clock). }
  }
  Topic merula_tell with merula "Tell the Centurion that the empire is gone" when admitted(party) and not valleyTold(party) and not traded_only(party) once {
    Says "Lucilla Merula takes it standing, as soldiers do. 'Then I have been a Centurion of nothing for twenty years,' she says, 'and my century is the best drilled nothing in the world.' She picks up her cane. 'I shall not tell the valley. I shall tell the First Century, tonight, in the barracks, and tomorrow we shall decide whether to go north and look. A column, six, with the Archivist's maps. A century that knows what it is for does not stand on a wall.' Her eye goes to the standard through the door. 'Keep your mouths shut about my face.'".
    On discuss { Assert told_merula(party). Assert valleyTold(party). Assert knows(actor, empire_gone). Set toldAt(party) to watch(clock). }
  }
  Topic elpis_tell with elpis "Tell the granary-reeve that the empire is gone" when admitted(party) and edeVouched(party) and not edePushed(party) and not valleyTold(party) and not traded_only(party) once {
    Says "Elpis Varo puts down her tally-stick. 'Then the sixth of the harvest we send north on the Sending is a sixth we owe nobody,' she says, evenly. 'Then the Sending is eleven hundred years of the best barley in the valley fed to the Eagle's pride. Then every child who went hungry in the plague winter went hungry for a lie.' She stands. 'I shall tell the Hearth at the evening call. And I shall not send the sixth.'".
    On discuss { Assert told_elpis(party). Assert valleyTold(party). Assert knows(actor, empire_gone). Set toldAt(party) to watch(clock). }
  }
  Topic merula_scout with merula "Ask the Centurion for a scout" when (told_prefect(party) or told_merula(party) or merulaKnowsSon(party)) and not told_ostrander(party) and not claimedRelief(party) and not scoutGiven(party) once {
    Says "'You told us,' says Merula, 'or you brought me something I did not know how to ask for. Then you are owed, and I pay.' Her face does something. 'Dunya knows the Pass and the Viaduct, and she knows a thing about the fifth arch. Ask her.'".
    On discuss { Assert scoutGiven(party). Assert willing(dunya, party). Set hire(dunya) to 0. Assert knows(actor, ropeway_known). }
  }
  Person dunya "Dunya" at barracks {
    Role "scout of the First Century". Ancestry human. Calling ranger. Level 3. Pronouns she. Manner stoic. Peaceable.
    Carries marra_crook.
    Joins "Dunya shoulders a pack with a legion's wheel stamped on it. 'I have always wanted to see the Ford,' she says. 'Is it as small as they say?'".
  }

  // ── The Centurion's son, and the letter that waited nine springs ───────────────────────────────────────────────
  Person merula "Lucilla Merula" at barracks {
    Role "Centurion of the First Century". Ancestry human. Calling warrior. Level 4. Pronouns she. Manner acerbic. Peaceable.
    Greets "The woman with the cane lowers it. 'You walked the Pass, then,' she says. 'Not many do. Past the Eagle, past the giant, past the men at the head of the Descent. What did you see in the road?'".
  }
  Topic merula_deserters with merula "Tell the Centurion about the men at the head of the Descent" when paidDeserters(party) or aurelMet(party) {
    Says "'Seven,' says Merula, as if reading from a report. 'Walked out of the Sending, one by one, lot or no lot. Mine to deal with.' She addresses the wall. 'The tall one with the bow. Name. Report.'".
  }
  Topic merula_letter with merula "Give the Centurion the pouch addressed to her, from the Eagle" when holding(actor, aurel_letter_kind) and not merulaKnowsSon(party) once {
    Says "She takes it in both hands and reads the superscription. 'He writes square,' she says. She breaks the seal, reads, and sits down on the spear-rack, which is not done. 'He saw them,' she says. 'And could not come and say.' She turns the letter over. 'I would have had him flogged. Because I would have had to.' She turns to you. 'What do you want for this?'".
    On discuss { Spend aurel_letter_kind from actor. Assert merulaKnowsSon(party). }
  }
  Topic merula_ans_all with merula "Ask nothing for it, and tell her everything about the men in the Pass" answering merula_letter when true {
    Says "She listens to the end with her cane across her knees. 'Then I owe you the pardon,' she says. 'I will ask it in the Prefect's name.'".
    On discuss { Assert merulaFull(party). Assert knows(actor, aurel_known). }
  }
  Topic merula_ans_part with merula "Ask a scout for it, and say no more about the Pass" answering merula_letter when true {
    Says "'A scout,' says Merula. 'Yes.' She puts the letter inside her cuirass. 'I do not do pardons for scouts.'".
  }
  Topic merula_pardon with merula "Ask the Centurion to pardon the seven in the Pass" when merulaKnowsSon(party) and merulaFull(party) and not dunyaSilent(party) and not pardoned(party) once {
    Says "'Pardon is the Prefect's,' says Merula. 'I will put it to him. Scouts, I will say. Orders from me, forty years back, mislaid. He will not check.' She faces the mountains. 'Dismissed. If they are home by spring, you did that.'".
    On discuss { Assert pardoned(party). }
  }
  Observe pardon_news at gate when pardoned(party) and watch(clock) >= toldAt(party) + 800 "Seven men in patched red cloaks stand outside the gate with their hats in their hands. The sentries have not yet opened it. The captain on the wall has taken off his helmet, and the Centurion is coming down the wall-stair with her cane under her arm, not using it.".

  // ── The Archivist, the notches on the beam, and the line that was forged ──────────────────────────────────────
  Person ostrander "Tiberin Ostrander" at archive {
    Role "Archivist of the Cohort". Ancestry human. Pronouns he. Manner grim. Peaceable.
    Greets "An old man among scrolls looks up. He has read a date and does not believe it. 'You are not Aenean,' he says. 'Good. Shut the door.'".
  }
  Topic ostrander_beam with ostrander "Ask the Archivist what the notches on the roof-beam are" when true {
    Says "'Springs,' he says. 'One for each Sending that returned with nothing. Eleven hundred and three, and one yet to cut. My predecessors cut them, in the dark, after the Prefects had gone to bed. We do not talk of the beam. It would be a poor kind of faith that kept count.' He weighs it with his eye. 'The kind that did not would be easier to read.'".
  }
  Topic ostrander_forged with ostrander "Ask the Archivist about the year the Annals say a reply came" when told_ostrander(party) and ostranderSwore(party) and not forgeryKnown(party) once {
    Says "Ostrander turns three pages before he answers. 'The year of the cattle plague. The Sending went north in the spring and came home with nothing, as it has done every year, and the valley had buried four hundred head and a good many children. The Prefect before Corvin asked me what to put. I wrote: A REPLY WAS RECEIVED; HOLD. In my own hand, in the red ink.' He folds his hands. 'The only false line in the Annals. I have not forgiven myself for it, and the valley got through the winter.'".
    On discuss { Assert forgeryKnown(party). Assert knows(actor, forgery_known). }
  }
  Entity forgery_known: fact "In the year after the plague of the cattle, the Archivist wrote in the Annals that a reply from the Emperor had been received, to keep the valley from despair. There was none.".
  Topic ostrander_stones with ostrander "Show the Archivist the soldier's scratches you copied on the road" when knows(actor, rufus_1) and knows(actor, rufus_2) and knows(actor, rufus_3) and knows(actor, rufus_4) and not told_ostrander(party) {
    Says "He reads them with a finger, line by line. At WE WAITED he stops. 'Rufus,' he says. 'I have the muster-roll. Gaius Rufus, VI Cohort, died in the second winter of the march, south of here. He did not see the sea. The boots did not hold.' He sits. 'Nobody has told me what he wrote. You have walked the whole road, and read all of it. Then you know more of us than we do.'".
  }
  Kind itinerarium_kind "a copy of the Itinerarium" is document teaching itinerarium_read described "A red-bound book in the legion's square hand: every mile of the road, every mansio, every halt.".
  Discovery itinerarium_read "The Itinerarium of the Long Muster lists every halt on the road and, in a later hand, the engineers' note that the fifth arch of the Viaduct can be bridged by a rope-way from the north pier.".
  Item itinerarium_copy "a copy of the Itinerarium" is itinerarium_kind at nowhere.

  // ── The apothecary, who has been keeping the Prefect asleep ───────────────────────────────────────────────────
  Person orsa "Dame Orsa" at apothecary {
    Role "apothecary of the Cohort". Ancestry human. Profession herbalist. Pronouns she. Manner jovial. Peaceable.
    Buys kingsfoil for 90 coin.
    Buys gentian_gathered for 12 coin.
    Buys alhuren_gathered for 20 coin.
    Buys heather for 4 coin.
    Buys cloudberry for 6 coin.
    Buys comfrey for 12 coin.
    Buys bruisewort_gathered for 8 coin.
    Sells antidote for 8 coin from 4.
    Sells bandages for 2 coin from 8.
    Greets "A broad woman in a stained apron looks over your pouches before she squints at you. 'Whatever you have from the high places,' she says. 'We've had no herb from the north side in my life. Kingsfoil I know from the Herbal. One sprig and I'll pay you what it weighs in salt.'".
  }
  Topic orsa_hearth with orsa "Ask Dame Orsa what the Hearth says in the apothecary's" when true {
    Says "'That a sixth of the barley goes north to feed nobody,' says Orsa comfortably. 'That the standard eats better than the children. That the Prefect should be kept sleeping and the Sending kept going, because it is all the same to a man in a gown.' She grinds. 'I'm Hearth, dear. I'm also the one who knows what the Prefect takes for his sleep.'".
  }
  Topic orsa_poppy with orsa "Ask Dame Orsa what the Prefect takes for his sleep" when orsaFair(party) and not orsaConfessed(party) once {
    Says "She sets down the pestle. 'Poppy,' she says. 'A pinch in his evening wine, sixteen years. He asked me the first winter what a man takes who cannot stop thinking about the spring. I gave it. He never asked what was in it.' She wipes her hands. 'I stopped last month. He sleeps a little on his own.'".
    On discuss { Assert orsaConfessed(party). }
  }

  // ── The courier who goes north, and the one who went further ──────────────────────────────────────────────────
  Person gaius "Old Gaius" at shrine {
    Role "the cohort's courier, retired". Ancestry human. Pronouns he. Manner grim. Peaceable.
    Greets "An old man sits by the lamp with a pouch in his lap. 'Thirty-one springs, and the knees went in the nineteenth, and I said to the surgeon, they will go on a road or on a bed, and he said road, so I went,' says Gaius, to the pouch. 'A day up, nine at the stack, a day back, and nobody there, not once. Sit. Mind the lamp. Where was I?'".
  }
  Topic gaius_pontus with gaius "Show Old Gaius the lead tag from the eyrie" when holding(actor, courier_tag) and not gaiusPontus(party) once {
    Says "He takes the tag and reads it with his thumb, and goes on reading it long after the thumb has stopped. 'Cato. Five hundred and three. They said the cold, but the cold does not leave a man's tag in a nest, does it, and I always thought, past the stack, at noon, with nothing to stand behind.' He puts it in his shirt. 'Ostrander will want to cut a notch. He cut one when my wife died and I said that is not a notch matter and he said everything is a notch matter.'".
    On discuss { Spend courier_tag from actor. Assert gaiusPontus(party). }
  }
  Topic gaius_aurel with gaius "Ask Old Gaius whether he knows the men in the Pass" when knows(actor, aurel_known) and not gaiusSecret(party) once {
    Says "He watches the lamp-flame. 'Every spring, going north, I leave a sack of barley and a skin of wine under the milestone in the notch, under the heap of small stones. Nine years. In the autumn the sack is gone.' He turns the pouch over. 'You will say nothing. He is the one man who knows there is nobody at the Eagle.'".
    On discuss { Assert gaiusSecret(party). }
  }
  Topic gaius_sending with gaius "Ask Old Gaius how the Sending goes" when true {
    Says "'The lot is drawn at the evening call out of a helmet, and it was my father's helmet, with the dent, which is a story,' says Gaius. 'Anyway whoever it falls on takes the pouch and a loaf and a skin and goes out by the Sending gate while the wall stands there, and then you come home and say no answer, and the Prefect says it will come. I liked the loaf. Nobody mentions the loaf.'".
  }

  // ── The standard-bearer, and what is in his hands ──────────────────────────────────────────────────────────────
  Person brand "Silas Brand" at shrine {
    Role "Aquilifer of the Cohort, who carries the standard". Ancestry human. Calling warrior. Level 3. Pronouns he. Manner proud. Peaceable.
    Greets "A big man in a polished cuirass kneels before the plinth, polishing, and does not stop. 'The standard does not rest,' he says, 'and neither does the man who bears it. Salve. If you are here to make trouble, do it quietly. The lamp can hear.'".
  }
  Topic brand_ask with brand "Ask the Aquilifer about the standard" when true {
    Says "'Bronze,' says Brand. 'Cast the year the Muster marched. It was nearly lost in the Schism, when the Eagles said it should go north and the Hearth said it should stay. There was a man killed.' He polishes the wing. 'It is warm in the morning. Do not tell me it is the sun.'".
  }
  Action press_brand(actor: group, site: place) "Press the Aquilifer on why he polishes one wing every night" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, shrine) and at(brand, shrine) and admitted(actor) and not brandTold(actor) and not brandShut(actor) and not goldReturned(actor).
    Time 1.
    Resolve check(actor, insight, dc_hard).
    On success { Assert brandTold(actor). Assert knows(actor, brass_known). }
    Result "He puts both hands flat on the plinth and does not look round. 'Eleven years,' he says. 'I took a file to it at night, on the wing. Brass. Under a skin of bronze.' He is quiet. 'The Eagles say the Hearth stole the gold in the Schism. I never said what I found. If the gold is anywhere, where is it?'".
    On failure { Assert brandShut(actor). }
    Otherwise "'It is a wing,' says Brand. He goes on polishing, and in a little he is humming, loud enough to cover anything you could say. He does not stop again that day, or, you suspect, any day you are in the valley.".
  }
  Entity brass_known: fact "The standard of the Last Cohort is brass under a skin of bronze. The gold wings were hidden by the Hearth in the Schism of 871; the Aquilifer has known the pole is brass for eleven years.".
  Topic brand_gold with brand "Lay the gold eagle's wing before the Aquilifer" when holding(actor, golden_idol) and not goldReturned(party) once {
    Says "He kneels and touches it with one finger. 'It is warm,' he says. The lamp on the plinth gutters and steadies. 'The Hearth hid it. So we should not carry it north to be lost.' He sits back. 'We cursed them for it for two hundred and thirty years.' Then, to the wing: 'Well.'".
    On discuss { Spend golden_idol from actor. Assert goldReturned(party). Assert state(standard, golden). }
  }

  // ── The granary-reeve of the Hearth ────────────────────────────────────────────────────────────────────────────
  Person elpis "Elpis Varo" at granary {
    Role "granary-reeve, who keeps the rota". Ancestry human. Pronouns she. Manner acerbic. Peaceable.
    Greets "A woman with a tally-stick in each fist and flour to the elbow does not look up from the board. 'Four hundred and sixty sacks,' she says. 'A sixth to the Sending. A twelfth to the Eagles' table. Never a sack to the children without a form.' She looks up. 'You'll want the form. Everyone does.'".
  }
  Topic elpis_owes with elpis "Remind the granary-reeve that the Hearth owes the one who paid a Hearth man's fine" when hearthOwes(party) once {
    Says "Elpis looks at you for the first time as if you were a sack to be weighed. 'Form,' she says, and writes it herself. 'Four days. Take them out of the north end, where it keeps.' She does not say thank you. She puts the stick behind her ear.".
    On discuss { Increase quantity(actor, rations) by 4. }
  }
  Topic corvin_dose with corvin "Tell the Prefect what Dame Orsa puts in his evening cup" when orsaConfessed(party) and admitted(party) and not doseTold(party) once {
    Says "Corvin sets down the cup he was lifting. The cup stays where it is. 'Sixteen years,' he says, 'of the clearest sleep in the valley.' He rings a small bell, and a clerk is sent down the steps for Dame Orsa, who comes up them slowly, and does not look at you. 'Thank you,' he says, and does not say what for.".
    On discuss { Assert doseTold(party). Increase prefectRegard(party) by 2. Retract at(orsa, apothecary). Assert at(orsa, praetorium_hall). }
  }
  Rule gaius_barley_pass when gaiusSecret(party) and at(party, pass_s) and not tolerates(deserters, party)
    says "The tall man on the boulder looks at the sack under the milestone, and at you, and at the sack. 'Gaius,' he says, and raises his bow an inch, which here is a greeting. They let you by." { Assert tolerates(deserters, party). }
  Topic elpis_tithe with elpis "Ask the granary-reeve about the sixth that goes north" when true {
    Says "'It is stood at the Sending gate in the spring in thirty sacks and thirty-one skins,' says Elpis. 'Then it is brought back in the autumn by the Sending and put in the Eagles' own store, and the Eagles eat it, nicely, as a reward for faith. Nobody has asked in eleven hundred years why it is brought back.' She taps the board. 'Sums are mine. Opinions go on a form. The form is in the drawer. The drawer is stuck.'".
  }
}
