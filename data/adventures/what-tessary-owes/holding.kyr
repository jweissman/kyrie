Module tessary "What Tessary Owes" {
  // ── The Holding ───────────────────────────────────────────────────────────────────────────────────────────────────
  // Where pledged things are kept against their promises, and forfeit things for ever: beyond the Balance, a white
  // floor under no sky. Everything here has a tag. (A contribution to Imbar's cosmology for canon review: the Kept's
  // tradition, not a narrator's fact. See doc/adventures/what-tessary-owes/03-revised-design.md.)
  Place holding_plane "the Holding" is plane.
  Place white_floor "the white floor" is region within holding_plane.
  Place holding "the Holding" is site within white_floor at 0, 0.
  Place threshold "the threshold of the Holding" is room within holding at 0, 0 outdoors.
  Place sheaves "the field of sheaves" is room within holding at 1, 0 outdoors.
  Place folded_lake "the folded lake" is room within holding at 2, 0 outdoors.
  Place notary_desk "the Notary's desk" is room within holding at 0, 1 outdoors.
  Place tags "the avenue of tags" is room within holding at 1, 1 outdoors.
  Place ranks "the Ranks" is room within holding at 1, 2 outdoors.
  Place far_edge "the far edge" is room within holding at 2, 2 outdoors.

  // The Door stands open on the night of the Settlement; at other times only to the Assessor and whoever goes with
  // them, or to whomever the Comptroller admits.
  Relation holdingAdmits(group).
  Query doorOpen() means feastEve() and hour(clock) >= 18 or night(ossel) >= 15 or travelsWith(tally, party) or holdingAdmits(party).
  Passage holding_door "the Door of the Holding" is passage between weighing_chamber and threshold
    opening when doorOpen() "The Door of the Holding stands at the end of the nave with the white floor showing through it, and when you walk toward it you do not come any nearer.".
  Passage floor_n "the white floor" is passage between threshold and sheaves taking 10 minutes.
  Passage floor_lake "the white floor" is passage between sheaves and folded_lake taking 10 minutes.
  Passage floor_desk "the white floor" is passage between threshold and notary_desk taking 10 minutes.
  Passage floor_tags "the white floor" is passage between notary_desk and tags taking 10 minutes.
  Passage floor_sheaves_tags "the white floor" is passage between sheaves and tags taking 10 minutes.
  Passage floor_ranks "the white floor" is passage between tags and ranks taking 10 minutes.
  Passage floor_edge "the white floor" is passage between ranks and far_edge taking 30 minutes.
  Passage floor_lake_edge "the white floor" is passage between folded_lake and far_edge taking 30 minutes.

  Observe threshold_scene at threshold when true "You step through and there is no sky. There is a floor, white, faintly ruled, going on in every direction until it is too far to see, and there is a light that comes from nowhere and casts no shadows. Behind you the Door stands on its own, with the nave of the Weighing Chamber dim inside it like a room seen through a window at night. Ahead, in rows that go on past seeing, things stand on the floor with tags tied to them.".
  Observe sheaves_scene at sheaves when true "A field of sheaves, standing in stooks on the white floor, gold and dry and smelling of August: a harvest, a whole country's harvest, acres of it. The tag on the nearest stook is old leather, and the writing on it says, in a script like the Scruples', a king's word that his people would not starve, given in a year of famine, and broken.".
  Observe lake_scene at folded_lake when true "A lake, folded. That is the only way to say it: a lake has been folded like linen, in squares, and laid on the floor in a stack higher than a house, and you can see through the folds the reeds and the fish and a little boat, very small and perfectly still, caught between two layers of water. Its tag is the size of a door.".
  Observe tags_scene at tags when true "An avenue of tags with nothing tied to them: little white tags on cords, hanging from a rail at the height of your eyes, thousands of them, stirring though there is no wind. Each has a name on it in the ruled script. These are the names of the Scruples, pledged at their births. Some are very old. Some are new, and the ink still wet.".
  Observe ranks_scene at ranks when true "The Ranks. Soldiers of the Long Muster, standing in files on the white floor as if on parade, barefoot, in their shirts, their eyes closed, their hands at their sides. They are breathing, very slowly, all together. There are a hundred and fifty of them, and more; there are faces you have seen on the boardwalks of the Withies, and faces you have seen only on the Assessor's pages. Nobody has tied tags to them. Their tags are in the Weighing Chamber, in the pan.".
  Observe edge_scene at far_edge when true "The floor ends. It does not drop away; it stops, and beyond it is dark that is not night, and in the dark, very far off, there are nine points of black light, arranged in no shape you know, perfectly still. The air here is cold and smells of iron. Something about the nine points makes you want very much to look somewhere else.".
  Observe ranks_count at ranks when held(ossel) > 150 "The files are longer than they were. New faces at the ends of them, in their shirts, with their eyes closed.".

  // The Notary: the Balance's own clerk, who keeps the Holding and sits with the Assembly at a Settlement.
  Person notary "the Notary" at notary_desk {
    Role "a figure at a white desk, made of fine ruled lines of light, as a drawing of a clerk is made of lines". Ancestry human. Peaceable. Pronouns it. Manner stoic.
    Greets "The figure at the desk looks up. It has no face, only the lines where a face would be drawn, very close together, and when it speaks the lines move. 'Weighed,' it says, in a voice like a page turning. 'Come in. Everything here is accounted for.'".
  }
  Topic notary_place with notary "Ask the Notary what this place is" when true once {
    Says "'The Holding,' says the Notary. 'Where what is pledged is kept against the promise it was pledged for, until the promise is kept or released, and where what is forfeit is kept for ever.' Its lines move. 'A harvest. A lake. A singer's voice, in a jar, over there; she pledged it against her lover's return, and he came home, and she has never come for it. I do not know why. People are not always in a hurry for what is theirs.'".
  }
  Topic notary_lights with notary "Ask the Notary about the nine black lights at the far edge" when true once {
    Says "The Notary is quiet for a long time. 'Security,' it says at last. 'For the oldest promise this floor holds. The Scruples call it the Fastening; your priests have other words. The nine jewels your songs remember are the tallies of it, and what they tally is held there.' Its lines grow very close together. 'I do not discuss the terms. I will say that they are being kept. I will say that at one place in Imbar the ledger is uneven, and the fastening there is slack, and it is the place you came from.'".
  }
  Topic notary_redeem with notary "Ask the Notary how the held may be redeemed" when true once {
    Says "'Three ways,' says the Notary. 'The debt is paid, and all that was pledged for it goes home. The debt is released, by the one it is owed to, and all goes home. Or a single thing is redeemed by another pledge of its weight, laid on this desk.' It turns a page that is not there. 'A soldier's oath weighs about what a person's name weighs, and everything they carry of worth. I make that observation to everyone who asks. Very few people ask twice.'".
    On discuss { Assert knows(actor, redeem_by_pledge). }
  }
  Discovery redeem_by_pledge "In the Holding a single held thing may be redeemed by laying another pledge of its weight on the Notary's desk: a soldier's oath weighs about what a person's name weighs, and everything they carry of worth.".
  Topic notary_comptroller with notary "Ask the Notary about the Comptroller's default" when knows(actor, note_designed) once {
    Says "'Entered in his hand eleven hundred years ago,' says the Notary. 'An honest entry.' The lines of its face do not move at all. 'The note he drew for your city was not honest. I hold what I am given. I do not choose what I am given. If the Assembly sits at the Settlement and finds the note drawn to be broken, I will hold that too.' A pause. 'He has been very unhappy. I make that observation as well.'".
  }
  // A goose, pledged in a wager three hundred years ago and forfeit, who has views.
  Person old_goose "a goose" at sheaves {
    Role "a grey goose with a tag round its neck, three hundred years forfeit". Species goose_kind. Peaceable. Pronouns she.
  }
  Observe old_goose_scene near old_goose when at(old_goose, sheaves) "Among the sheaves a grey goose is eating a king's harvest, one grain at a time, with the air of someone who has been doing it for a very long while and intends to go on. The tag round her neck says she was wagered on a horse-race in the Ossel country three hundred and four years ago, by a miller, who lost. When she sees you she hisses, on principle.".
  Topic notary_goose with notary "Ask the Notary about the goose" when true once {
    Says "'Forfeit,' says the Notary. 'A miller wagered her on a horse and the horse lost. She is the property of the Balance. She has eaten approximately a third of the harvest of Old Ennelmark.' Its lines move in a way that might be a sigh. 'Nothing forfeit to the Holding ages. Nothing in the Holding can be made to leave it. I have tried.'".
  }

  // ── The held ──────────────────────────────────────────────────────────────────────────────────────────────────────
  Person held_files "the held of the Long Muster" at ranks {
    Role "soldiers asleep on their feet, in files". Ancestry human. Numbers 1. Peaceable. Pronouns they.
  }
  Initially Assert asleep(held_files).
  Person davy "Davy Teazle" at ranks {
    Role "a private of the Long Muster, asleep on his feet, in his shirt". Ancestry human. Calling warrior. Level 1. Peaceable. Pronouns he.
  }
  Initially Assert asleep(davy). Initially Assert heldNow(davy).
  Relation davyWoke(place).
  Action wake_davy(actor: group, site: place) "Lay Davy's coat over his shoulders" {
    Time 1 minute.
    Requires able(actor) and company(actor) and at(actor, site) and at(davy, site) and carries(actor, davy_coat)
      and heldNow(davy) and not davyWoke(ossel).
    On success { Assert davyWoke(ossel). Retract asleep(davy). }
    Result "You put the red coat round his shoulders, the darned elbow and all, and he shivers once, the whole length of him, and opens his eyes. 'Mam?' he says. Then he sees you, and the white floor, and the files of sleepers going away on either side of him, and his face does the thing a face does when a dream turns out not to be one. 'I put my boots together,' he says. 'Didn't I? She'll never believe it.'".
  }
  Topic davy_talk with davy "Ask Davy what it is like here" when davyWoke(ossel) and heldNow(davy) once {
    Says "'Like standing guard,' says Davy. 'Only nobody comes to relieve you.' He pulls the coat round himself. 'I can't move my feet. I've tried. I can hear the others breathing. Sometimes somebody talks in his sleep, the Lucey twins mostly, they always did.' He looks at you. 'Are we coming home? Tell me straight. The army never told anyone anything straight.'".
  }
  Rule davy_sleeps_again when davyWoke(ossel) and heldNow(davy) and not at(party, ranks) { Assert asleep(davy). }
  Rule davy_wakes_again when davyWoke(ossel) and heldNow(davy) and at(party, ranks) and asleep(davy) { Retract asleep(davy). }

  // Durrance, if she was taken: her own oath, said to her to its last words, wakes her.
  Relation durranceWoke(place).
  Action wake_durrance(actor: group, site: place) "Say the Muster's oath to Durrance, to the very end: 'until it release me'" {
    Time 1 minute.
    Requires able(actor) and company(actor) and at(actor, site) and at(durrance, site) and heldNow(durrance)
      and knows(actor, oath_words) and not durranceWoke(ossel).
    On success { Assert durranceWoke(ossel). Retract asleep(durrance). }
    Result "You say it into her face, the way she said it to you in the Drum: I swear to keep the city of Tessary, its walls and its people, while I live or until it release me. At release her eyes open. She looks at you for a long moment without knowing you, and then knowing you. 'Until it release me,' she says. 'Nobody ever listens to that part.' She tries to move her feet, and cannot. 'Well,' she says. 'Here I am, then. Where's the one doing the calling? I said I'd like to look at them.'".
  }
  Rule durrance_sleeps_again when durranceWoke(ossel) and heldNow(durrance) and not at(party, ranks) { Assert asleep(durrance). }
  Rule durrance_wakes_again when durranceWoke(ossel) and heldNow(durrance) and at(party, ranks) and asleep(durrance) { Retract asleep(durrance). }

  // The deeds of the held, put into their hands before the Settlement: the city's promise, kept to every soldier.
  Action deliver_deeds(actor: group, site: place) "Go down the files putting a sealed deed into every hand" {
    Description "A hundred and sixty-odd deeds, name by name. It will take a while.".
    Time 6.
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, ranks) and carries(actor, held_deeds)
      and not deedsDelivered(ossel) and not matured(ossel).
    On success { Assert deedsDelivered(ossel). }
    Result "You go down the files with the casket open, reading the names off the deeds, finding the faces. Pike. Haskett. Moll Bryer. The Lucey twins, side by side. Teazle, D. Every hand takes the paper as you put it there, the way a sleeping hand will close on whatever is put in it, and holds it. When you come to the end of the last file the casket is empty, and all down the Ranks, very faintly, there is a sound like a great many people breathing out.".
  }

  // ── The pledge ────────────────────────────────────────────────────────────────────────────────────────────────────
  // One pledge to a person, for there is one name to a person: laid on the Notary's desk, it redeems one held thing.
  Relation pledgedSelf(group). Relation redeemedBy(group, group). Relation tallyFreed(place). Relation tallyNameFound(group).
  Observe tally_tag at tags when knows(party, tally_name_known) and not tallyFreed(ossel) "In the ninth row, near the end, a tag hangs whose ink is twenty-nine years old. You know it is the Assessor's before you read it. It is a short name. It would sound strange in Tessary, and then, after a while, it would not.".
  Discovery tally_name_known "The Assessor's name hangs in the avenue of tags in the Holding, pledged at their birth.".
  Topic tally_name with tally "Ask the Assessor what their name is" when tallySawDefaults(ossel) and not knows(actor, tally_name_known) once {
    Says "The Assessor looks at you for a long time. 'It is held,' they say. 'In the ninth row of the avenue of tags. I have never seen it. One is not shown one's name.' A pause. 'I find, since the Room of Defaults, that I would like to know what it is. I note that. I do not know what to do with it.'".
    On discuss { Assert knows(actor, tally_name_known). }
  }
  Action pledge_for_davy(actor: group, site: place) "Lay your name and everything you carry of worth on the Notary's desk, to redeem Davy Teazle" {
    Speaker notary. Time 1 minute.
    Grave "A name pledged to the Holding is held. It is not given back.".
    Requires able(actor) and company(actor) and at(actor, site) and at(notary, site) and knows(actor, redeem_by_pledge)
      and heldNow(davy) and not pledgedSelf(actor) and not discharged(ossel).
    On success { Assert pledgedSelf(actor). Assert redeemedBy(davy, actor). Set quantity(actor, gold) to 0. Assert registered(actor). }
    Result "You say your name, the whole of it, and the Notary writes it on a tag, and ties the tag to the rail with the others, and it hangs there stirring. 'Held,' it says. 'Teazle, D., redeemed.' Your purse is empty; you did not see it go. When you try to think of your own name it is there, still, but at a distance, like a word in a language you used to speak. 'You will be called something,' says the Notary. 'People always are.'".
  }
  Action pledge_for_durrance(actor: group, site: place) "Lay your name and everything you carry of worth on the Notary's desk, to redeem Agathe Durrance" {
    Speaker notary. Time 1 minute.
    Grave "A name pledged to the Holding is held. It is not given back.".
    Requires able(actor) and company(actor) and at(actor, site) and at(notary, site) and knows(actor, redeem_by_pledge)
      and heldNow(durrance) and not pledgedSelf(actor) and not discharged(ossel).
    On success { Assert pledgedSelf(actor). Assert redeemedBy(durrance, actor). Set quantity(actor, gold) to 0. Assert registered(actor). }
    Result "You say your name, the whole of it, and the Notary writes it on a tag and ties it to the rail. 'Held,' it says. 'Durrance, A., redeemed.' Your purse is empty. Your own name, when you reach for it, is there, but at a distance, like the name of a town you passed through once.".
  }
  Action pledge_for_tally(actor: group, site: place) "Lay your name and everything you carry of worth on the Notary's desk, to redeem the Assessor's name" {
    Speaker notary. Time 1 minute.
    Grave "A name pledged to the Holding is held. It is not given back. The Assessor's, redeemed, is theirs.".
    Requires able(actor) and company(actor) and at(actor, site) and at(notary, site) and knows(actor, redeem_by_pledge)
      and knows(actor, tally_name_known) and not tallyFreed(ossel) and not pledgedSelf(actor) and not tallyUnravelled(ossel).
    On success { Assert pledgedSelf(actor). Assert tallyFreed(ossel). Set quantity(actor, gold) to 0. Assert registered(actor). }
    Result "The Notary goes down the avenue of tags without seeming to walk, and comes back with one small white tag in the lines of its hand, and lays it on the desk, and ties yours in its place. 'A Scruple's name, redeemed,' it says. 'That has not happened before.' Its lines move. 'They will not be able to lie any more easily than they could. But they will be able to leave.'".
  }
  Relation tallyUnravelled(place).
  Rule redeemed_go_home when redeemedBy(?s, ?c) and heldNow(?s) {
    Retract heldNow(?s). Retract asleep(?s). Assert cameHome(?s). Assert wokeHome(?s). }
  Relation wokeHome(group).
  Rule davy_home when wokeHome(davy) and at(davy, ranks) { Retract at(davy, ranks). Assert at(davy, teazle_room). }
  Rule durrance_home when wokeHome(durrance) and at(durrance, ranks) { Retract at(durrance, ranks). Assert at(durrance, drum_taproom). }
  Rule comptroller_redeems when redeemedByComptroller(davy) and heldNow(davy) and lowWater() and dark() {
    Retract heldNow(davy). Retract asleep(davy). Assert cameHome(davy). Assert wokeHome(davy). }
  Rule davy_back_told when wokeHome(davy) and not knows(party, davy_back)
    says "Word runs along the Withies faster than the tide: Davy Teazle woke up on the Tideline Steps in his shirt with his boots beside him, and walked home, and put his boots on the mat inside his mother's door, side by side." teaches davy_back { }
  Discovery davy_back "Davy Teazle has come home to the Withies.".
  Event nan_pays near nan when knows(party, davy_back) and nanOffer(party) and not nanPaid(party) "Nan Teazle puts a tin in your hands without a word. Nine coin in it. Davy is asleep in the cupboard bed behind her, in his coat, with his boots on." then {
    Increase quantity(party, gold) by 9. Assert nanPaid(party). }
  Event nan_pays_knowing near nan when toldNan(party) and nanOffer(party) and heldNow(davy) "Before you go, Nan Teazle puts a tin in your hands. 'Nine coin,' she says. 'You told me where he is. That was the bargain.'" then {
    Increase quantity(party, gold) by 9. Assert nanPaid(party). }
  Relation nanPaid(group).
}
