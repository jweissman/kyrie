Module tessary "What Tessary Owes" {
  // ── The middle of the fortnight ───────────────────────────────────────────────────────────────────────────────────
  // What happens between the first week's findings and the Feast happens somewhere, at an hour, whether or not anyone
  // is there: Durrance's night, the Treasurer at the Swatch, the lightermen at Marrable's door, the Muster on the Row,
  // the Board, the Seal. The Muffled Drum hears of each a day or two before, and Hannelore says what it hears.
  Topic gossip_deserters with sedge "Ask Hannelore what they are saying in the Drum" when night(ossel) >= 2 and night(ossel) <= 4 once {
    Says "'Deserters,' says Hannelore, and empties a pot into the slop-bucket as if it had said it. 'That bill on the Landgate. Printed, on good paper. The Board hasn't paper like that; it came off the Factor's press, and the whole Withies knows it.' She wipes the bar. 'And Benno Fisk is buying rounds, which he never did in his life. And nobody says a word to Thomasin about her page, so she sits there and says it to herself.'".
  }
  Topic gossip_coats with sedge "Ask Hannelore what they are saying in the Drum" when night(ossel) >= 5 and night(ossel) <= 6 once {
    Says "'Coats,' says Hannelore. 'Lads go down to the Factor's hall in the morning in red and come back in grey with a salt-white collar. And they say she's offered to pay the next ebb's silver herself, all twelve, if the right sergeant asks her nicely.' She looks up at the drum. 'The spring ebb's the night after next. Two in the morning. If you've anything to do for Thomasin, do it before then.'".
  }
  Topic gossip_tonight with sedge "Ask Hannelore what they are saying in the Drum" when night(ossel) == 7 and not heldNow(durrance) once {
    Says "'Nothing,' says Hannelore. 'Nobody's saying anything tonight.' She is polishing the same pot she was polishing when you came in. 'Spring ebb's at two. Thomasin's at the top of the page. She's said she'll sit up here with her boots on, like a soldier.' She puts the pot down. 'Rap, rap, and the long roll. My husband used to beat it. I've not touched it since.'".
  }
  Topic gossip_treasurer with sedge "Ask Hannelore what they are saying in the Drum" when night(ossel) >= 8 and night(ossel) <= 10 and not quireDrowned(ossel) once {
    Says "'The Treasurer,' says Hannelore. 'Twice now the eel-men have seen him at the head of the Swatch Stair before dawn, in his good coat, buttoned up, looking down at the water. Not doing anything. Just looking.' She frowns. 'Somebody ought to say something to him. Somebody he'd listen to.' And then, lower: 'And the Factor's lightermen were in the Eel quarter yesterday asking which door is Councillor Marrable's. Asking nicely.'".
  }
  Topic gossip_terraces with sedge "Ask Hannelore what they are saying in the Drum" when night(ossel) >= 11 and night(ossel) <= 12 and not fiskTurned(fisk) and not riotHappened(ossel) and not riotCalmed(ossel) once {
    Says "'Torches,' says Hannelore. 'The lads at the Factor's hall say if the Board's going to vote no, they'll go up the Terraces the night before and ask it again, louder. Fisk's getting them together on Scriveners' Row after dark, the night before the sitting.' She shakes her head. 'And the Factor says leave it to her, and pays for the torches. Work that out.'".
  }
  Topic gossip_coats_back with sedge "Ask Hannelore what they are saying in the Drum" when night(ossel) >= 11 and night(ossel) <= 12 and fiskTurned(fisk) once {
    Says "'There's grey coats in the canal,' says Hannelore, and almost smiles. 'Fisk's been telling the lads at the Factor's hall what she wants them for, and some of them believed him. Half the Withies went fishing for coats this morning.' She looks at you. 'The Board sits the day after tomorrow. Ten in the morning. I've never been on the public bench in my life. I might go.'".
  }
  Topic gossip_board with sedge "Ask Hannelore what they are saying in the Drum" when night(ossel) == 13 and not voted(ossel) once {
    Says "'The Board's sitting,' says Hannelore. 'Ten till two, and then the count. Public bench is open to anyone who'll stand, and anyone with anything to say can stand up and say it, before two.' She unties her apron. 'Half the Withies is going. Mind, if the Board votes yes, the Factor's lost, and she doesn't like losing. I'd watch the Office of Seals tonight, if I were the Keeper. He sleeps in there with it.'".
  }
  Topic gossip_carried with sedge "Ask Hannelore what they are saying in the Drum" when votePassed(ossel) and night(ossel) == 13 and not sealTried(ossel) once {
    Says "'Carried!' says Hannelore, and kisses you on both cheeks before you can stop her. Then she sobers. 'It's not done till the Seal's on the deeds tomorrow, mind. The Factor's lightermen were on Scriveners' Row this afternoon looking at the Keeper's windows. Somebody ought to sit up with him tonight.'".
  }
  Topic gossip_feast with sedge "Ask Hannelore what they are saying in the Drum" when night(ossel) == 14 once {
    Says "'Feast tomorrow,' says Hannelore. 'Feast of Settlement, and the spring ebb with it. Fifteenth night.' She looks at the drum for a long time. 'There's people in the Withies hanging their sons' boots on the door. I don't know if it's for luck or the other thing.'".
  }

  // The tenth night: an hour before he goes down the stair, the Treasurer goes to the head of it and stands there.
  // Anyone at the head of the Swatch Stair can speak to him. Who knows what to tell him can give him a reason; anyone
  // can try to give him a smaller one.
  Rule quire_to_throat when night(ossel) == 10 and hour(clock) == 3 and quirePressed(ossel) and not quireHope(quire)
    and not quireDrowned(ossel) and at(quire, exchequer_room) {
    Retract at(quire, exchequer_room). Assert at(quire, throat_head). }
  Rule quire_off_throat when quireDrowned(ossel) and at(quire, throat_head) { Retract at(quire, throat_head). }
  Rule quire_back_home when quireHope(quire) and at(quire, throat_head) and hour(clock) != 3 {
    Retract at(quire, throat_head). Assert at(quire, exchequer_room). }
  Observe quire_at_throat near quire when at(quire, throat_head) and not quireHope(quire) "At the head of the Swatch Stair, in the dark, a man is standing with his coat buttoned to the neck, looking down at the full basin. It is the Treasurer. He has taken his spectacles off and holds them folded in one hand, as if he did not expect to need them again.".
  Relation triedQuire(group).
  Action stay_quire(actor: group, site: place) "Ask the Treasurer who will send the money to the mothers on the first of the month" {
    Time 1.
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, throat_head) and at(quire, throat_head)
      and not quireHope(quire) and not quireDrowned(ossel) and not triedQuire(actor).
    Resolve check(actor, persuasion, dc_fair).
    On success { Assert quireHope(quire). }
    On failure { Assert triedQuire(actor). }
    Result "He looks at you as if you had asked him the time. 'Four marks,' he says. 'Each. A hundred and thirty-eight of them, and twelve more after the Feast.' He thinks about it. 'Nobody,' he says. 'Nobody would. The Board would stop it in a week.' He puts his spectacles back on, and stands there a while longer, and then he turns round and walks back up toward the Lettered Quarter, slowly, like a man who has remembered an appointment.".
    Otherwise "He hears you out politely, and thanks you, and says you should go home to bed. He does not move from the top step.".
  }
  Rule quire_saved_told when quireHope(quire) and night(ossel) == 10 and not quireDrowned(ossel) and not spread(quire_lived)
    and inTessary() and not at(party, throat_head) says "Word goes along the Tidewall in the morning that the Treasurer was seen at the head of the Swatch Stair before dawn, and that he went home." { Assert spread(quire_lived). }
  Discovery quire_lived "The Treasurer stood at the head of the Swatch Stair on the tenth night, and went home.".

  // The thirteenth day: the Council House bell.
  Discovery board_sits "The Board of Moieties sits on the thirteenth day, from ten in the morning until the count at two in the afternoon. The public bench is open, and anyone with something to say may stand up and say it before two.".
  Rule board_bell when night(ossel) == 13 and hour(clock) >= 8 and hour(clock) < 10 and inTessary() and not spread(board_sits)
    says "The Council House bell rings over the city, nine strokes and then nine more: the Board of Moieties sits at ten to hear the question of the Veterans' Settlement, and the public bench is open." teaches board_sits {
    Assert spread(board_sits). }
}
