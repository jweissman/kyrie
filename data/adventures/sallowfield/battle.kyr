Module sallowfield "Three Nights at Sallowfield" {
  // ── The night ─────────────────────────────────────────────────────────────────────────────────────────────────
  // Wyre comes at dusk of the third day (or the second, if his riders found the town unwatched). The night is two
  // waves, with the company's choices between them:
  //   +0   the wear: each post loses a quarter of what he sends at it.
  //   +6   the first wave: at each post, what stands there (works, the posted, the drill, the company if it is there)
  //        against what Wyre sent. The reports come in, some late, some wrong.
  //   +6..+12  the company's hour: fall back from a post, hold one to the last, burn the bridge behind the men on it,
  //        light the causeway for the second wave, ring the bell, give out the arrows, move.
  //   +12  the second wave goes where the first one opened a road, against what is left standing.
  //   +14  fire and the push inward; +18 the picked men come for the company, wherever it is; +54 the morning.
  Relation overrun(place). Relation counted(place).
  Relation stands1(place). Relation overrun1(place). Relation stands2(place). Relation overrun2(place).
  Relation w1done(place). Relation w2done(place). Relation here(place). Relation sacrificed(place). Relation abandoned(place).
  Relation casualtyDone(group). Relation cas1(group). Relation p1done(group). Relation p3done(group). Relation p4done(group). Relation dawned(group).
  Relation greenBurns(group). Relation greenSaved(group). Relation helplessLost(group). Relation grainTaken(group). Relation bellSilenced(group).
  Relation pact(group). Relation grainGiven(group). Relation wyreWithdraws(group). Relation wyreDead(group). Relation picksBeaten(group). Relation picksWithdrawn(group).
  Relation felled(group). Relation morning(group). Relation bellMod(group). Relation w2planned(group). Relation lured(group). Relation bridgeBurned(group). Relation picksArgued(group).
  Measure overrunCount(group). Measure thrust2(place).

  Query battleOn() means watch(clock) >= assaultAt(wyre) and not pact(party) and not wyreWithdraws(party).

  Rule wyre_sees_spoiled when planned(party) and grainSpoiled(party) and wyreKnowsSpoiled(party) and watch(clock) >= assaultAt(wyre) and not wyreWithdraws(party) {
    Assert wyreWithdraws(party). }

  Rule move_to_posts when posted(?v, ?p) and watch(clock) >= assaultAt(wyre) - 12 and able(?v) and not at(?v, ?p) and not travelsWith(?v, party) { Assert at(?v, ?p). }

  // Where the company stands is read at the clash: the post it is at (the nave includes the loft and the roof).
  Rule here_on when postsite(?p) and at(party, ?p) and not here(?p) { Assert here(?p). }
  Rule here_nave_on when (at(party, bell_loft) or at(party, tower_roof)) and not here(nave) { Assert here(nave). }
  Rule here_off when here(?p) and postsite(?p) and distinct(?p, nave) and not at(party, ?p) { Retract here(?p). }
  Rule here_nave_off when here(nave) and not at(party, nave) and not at(party, bell_loft) and not at(party, tower_roof) { Retract here(nave). }

  Rule p1_wear when battleOn() and not p1done(party) {
    Assert p1done(party).
    Decrease defence(ford_stones) by thrust(ford_stones) / 4 or to nothing. Decrease defence(bridge) by thrust(bridge) / 4 or to nothing.
    Decrease defence(mill_yard) by thrust(mill_yard) / 4 or to nothing. Decrease defence(nave) by thrust(nave) / 4 or to nothing. }

  // ── The first wave ──────────────────────────────────────────────────────────────────────────────────────────
  Rule w1_hold_with when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and postsite(?p) and not w1done(?p) and here(?p) and defence(?p) + 2 * count(posted(?v, ?p) and able(?v)) + drillBonus(party) + 11 >= thrust(?p) + dice(?p) / 20 {
    Assert w1done(?p). Assert stands1(?p). }
  Rule w1_lost_with when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and postsite(?p) and not w1done(?p) and here(?p) and defence(?p) + 2 * count(posted(?v, ?p) and able(?v)) + drillBonus(party) + 11 < thrust(?p) + dice(?p) / 20 {
    Assert w1done(?p). Assert overrun1(?p). Assert overrun(?p). }
  Rule w1_hold when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and postsite(?p) and not w1done(?p) and not here(?p) and defence(?p) + 2 * count(posted(?v, ?p) and able(?v)) + drillBonus(party) + 4 >= thrust(?p) + dice(?p) / 20 {
    Assert w1done(?p). Assert stands1(?p). }
  Rule w1_lost when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and postsite(?p) and not w1done(?p) and not here(?p) and defence(?p) + 2 * count(posted(?v, ?p) and able(?v)) + drillBonus(party) + 4 < thrust(?p) + dice(?p) / 20 {
    Assert w1done(?p). Assert overrun1(?p). Assert overrun(?p). }

  // What the first wave leaves: a held post is worn by a third of what was thrown at it; a fallen one has nothing left.
  Rule w1_worn when stands1(?p) and not worn1(?p) { Decrease defence(?p) by thrust(?p) / 3 or to nothing. Assert worn1(?p). }
  Rule w1_gone when overrun1(?p) and not worn1(?p) { Set defence(?p) to 0. Assert worn1(?p). }
  Relation worn1(place).

  // Where the second wave goes depends on where the first one got through, or was stopped.
  Rule w2_base when w1done(ford_stones) and w1done(bridge) and w1done(mill_yard) and w1done(nave) and not w2planned(party) {
    Set thrust2(ford_stones) to thrust(ford_stones) / 2. Set thrust2(bridge) to thrust(bridge) / 2.
    Set thrust2(mill_yard) to thrust(mill_yard) / 2. Set thrust2(nave) to thrust(nave) / 2. }
  Rule w2_held_ford when stands1(ford_stones) and w1done(nave) and not w2planned(party) { Increase thrust2(mill_yard) by 4. }
  Rule w2_fell_ford when overrun1(ford_stones) and w1done(nave) and not w2planned(party) { Increase thrust2(mill_yard) by 2. Increase thrust2(nave) by 2. }
  Rule w2_held_bridge when stands1(bridge) and w1done(nave) and not w2planned(party) { Increase thrust2(ford_stones) by 3. }
  Rule w2_fell_bridge when overrun1(bridge) and w1done(nave) and not w2planned(party) { Increase thrust2(nave) by 5. }
  Rule w2_fell_mill when overrun1(mill_yard) and w1done(nave) and not w2planned(party) { Increase thrust2(nave) by 3. }
  Rule w2_latch when w1done(ford_stones) and w1done(bridge) and w1done(mill_yard) and w1done(nave) and not w2planned(party) { Assert w2planned(party). }

  // ── The company's hour ──────────────────────────────────────────────────────────────────────────────────────
  Action hold_to_the_last(actor: group, p: place) "Hold {p} to the last: the people posted there will not come back" {
    Requires able(actor) and company(actor) and postsite(p) and count(posted(?v, p)) >= 1 and stands1(p) and w2planned(party) and not w2done(p) and not sacrificed(p) and not abandoned(p) and watch(clock) < assaultAt(wyre) + 12.
    Time 0.
    On success { Assert sacrificed(p). Increase defence(p) by 7. }
    Result "You pass the word. Nobody says anything. A woman at {p} takes down her apron and puts it over the dog.".
  }
  Action fall_back_from(actor: group, p: place) "Give up {p} without a second fight, and bring its people in" {
    Requires able(actor) and company(actor) and postsite(p) and count(posted(?v, p)) >= 1 and stands1(p) and w2planned(party) and not w2done(p) and not sacrificed(p) and not abandoned(p) and watch(clock) < assaultAt(wyre) + 12.
    Time 0.
    On success { Assert abandoned(p). }
    Result "The word goes along the line to {p}, and the line comes back with its dead and its wounded and its tools, and without its pride. Behind them the post is a place where the enemy will be.".
  }
  Action burn_the_bridge_behind(actor: group, site: place) "Fire the bridge behind the men on it, with the pitch" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, bridge) and holding(actor, lamp_oil) and overrun1(bridge) and not bridgeCut(party) and not bridgeBurned(party) and w2planned(party) and watch(clock) < assaultAt(wyre) + 12.
    Time 0.
    On success { Spend lamp_oil from actor. Assert bridgeBurned(party). Decrease thrust2(nave) by 5 or to nothing. }
    Result "The pitch goes on the planking and the lamp after it. The men on the near arch see it go up, and the men on the far side see it too, and nobody comes over the packhorse bridge for the rest of the night. Some of the men on it are not going to come back from it either.".
  }
  Action light_the_causeway(actor: group, site: place) "Light the lantern on the reed causeway, and walk it into the marsh" {
    Requires able(actor) and company(actor) and at(actor, site) and at(actor, reed_marsh) and w2planned(party) and not lured(party) and watch(clock) < assaultAt(wyre) + 12.
    Time 0.
    On success { Assert lured(party). Decrease thrust2(ford_stones) by 5 or to nothing. Decrease thrust2(mill_yard) by 4 or to nothing. }
    Result "A lantern on a pole, going slowly away along a track that is not a track. A horseman at the edge of the meadow sees it and shouts. Then a dozen of them are following it, and the first of the horses goes in to the girth.".
  }

  // ── The second wave ─────────────────────────────────────────────────────────────────────────────────────────
  // Only a post that stood the first wave is fought for again; one that fell is simply passed. A post given up is the
  // enemy's. The company's weight counts for nine if it is there, three if not.
  Rule abandon_effect when abandoned(?p) and not w2done(?p) { Assert w2done(?p). Assert overrun2(?p). Assert overrun(?p). }
  Rule w2_hold_with when battleOn() and w2planned(party) and watch(clock) >= assaultAt(wyre) + 12 and postsite(?p) and stands1(?p) and not w2done(?p) and here(?p) and defence(?p) + 2 * count(posted(?v, ?p) and able(?v)) + drillBonus(party) + 9 >= thrust2(?p) + dice(?p) / 20 {
    Assert w2done(?p). Assert stands2(?p). }
  Rule w2_lost_with when battleOn() and w2planned(party) and watch(clock) >= assaultAt(wyre) + 12 and postsite(?p) and stands1(?p) and not w2done(?p) and here(?p) and defence(?p) + 2 * count(posted(?v, ?p) and able(?v)) + drillBonus(party) + 9 < thrust2(?p) + dice(?p) / 20 {
    Assert w2done(?p). Assert overrun2(?p). Assert overrun(?p). }
  Rule w2_hold when battleOn() and w2planned(party) and watch(clock) >= assaultAt(wyre) + 12 and postsite(?p) and stands1(?p) and not w2done(?p) and not here(?p) and defence(?p) + 2 * count(posted(?v, ?p) and able(?v)) + drillBonus(party) + 3 >= thrust2(?p) + dice(?p) / 20 {
    Assert w2done(?p). Assert stands2(?p). }
  Rule w2_lost when battleOn() and w2planned(party) and watch(clock) >= assaultAt(wyre) + 12 and postsite(?p) and stands1(?p) and not w2done(?p) and not here(?p) and defence(?p) + 2 * count(posted(?v, ?p) and able(?v)) + drillBonus(party) + 3 < thrust2(?p) + dice(?p) / 20 {
    Assert w2done(?p). Assert overrun2(?p). Assert overrun(?p). }
  // A post that fell in the first wave is not fought for again: the second wave passes it.
  Rule w2_passes when overrun1(?p) and w2planned(party) and watch(clock) >= assaultAt(wyre) + 12 and not w2done(?p) { Assert w2done(?p). }

  Rule count_overrun when overrun(?p) and not counted(?p) { Increase overrunCount(party) by 1. Assert counted(?p). }

  // The dead, by name. The first wave takes some of a post that held and many of a post that fell; the second takes
  // more; a post held to the last takes all of its people.
  Rule cas1_lost when overrun1(?p) and posted(?v, ?p) and able(?v) and not cas1(?v) and dice(?v) <= 40 { Slay ?v. Assert felled(?v). Assert cas1(?v). }
  Rule cas1_lost_spared when overrun1(?p) and posted(?v, ?p) and able(?v) and not cas1(?v) and dice(?v) > 40 { Assert cas1(?v). }
  Rule cas1_held when stands1(?p) and posted(?v, ?p) and able(?v) and not cas1(?v) and dice(?v) <= 8 { Slay ?v. Assert felled(?v). Assert cas1(?v). }
  Rule cas1_held_spared when stands1(?p) and posted(?v, ?p) and able(?v) and not cas1(?v) and dice(?v) > 8 { Assert cas1(?v). }
  Rule cas2_sacrificed when sacrificed(?p) and w2done(?p) and posted(?v, ?p) and able(?v) and not casualtyDone(?v) { Slay ?v. Assert felled(?v). Assert casualtyDone(?v). }
  Rule cas2_lost when overrun2(?p) and not abandoned(?p) and posted(?v, ?p) and able(?v) and not casualtyDone(?v) and dice(?v) <= 55 { Slay ?v. Assert felled(?v). Assert casualtyDone(?v). }
  Rule cas2_held when stands2(?p) and posted(?v, ?p) and able(?v) and not casualtyDone(?v) and dice(?v) <= 12 { Slay ?v. Assert felled(?v). Assert casualtyDone(?v). }
  Rule cas2_done when w2done(?p) and posted(?v, ?p) and not casualtyDone(?v) { Assert casualtyDone(?v). }
  // The company's own: those who fight beside the fall of a post may not come out of it.
  Rule cas_company_lost when overrun(?p) and at(party, ?p) and travelsWith(?v, party) and able(?v) and not casualtyDone(?v) and dice(?v) <= 35 { Slay ?v. Assert felled(?v). Assert casualtyDone(?v). }
  Rule cas_company_lost_spared when overrun(?p) and at(party, ?p) and travelsWith(?v, party) and able(?v) and not casualtyDone(?v) and dice(?v) > 35 { Assert casualtyDone(?v). }

  // ── Fire, and the push inward ───────────────────────────────────────────────────────────────────────────────
  Rule p3_fire when battleOn() and watch(clock) >= assaultAt(wyre) + 14 and not p3done(party) and (overrun(ford_stones) or overrun(bridge) or overrun(mill_yard)) and not bucketLine(party) {
    Assert p3done(party). Assert greenBurns(party). }
  Rule p3_fire_saved when battleOn() and watch(clock) >= assaultAt(wyre) + 14 and not p3done(party) and (overrun(ford_stones) or overrun(bridge) or overrun(mill_yard)) and bucketLine(party) {
    Assert p3done(party). Assert greenSaved(party). }
  Rule p3_quiet when battleOn() and watch(clock) >= assaultAt(wyre) + 14 and not p3done(party) and not overrun(ford_stones) and not overrun(bridge) and not overrun(mill_yard) { Assert p3done(party). }
  // The helpless in a burning green are lost; the lost are counted in the bad dawn (see the fates).
  Rule p3_helpless when greenBurns(party) and not evacuated(party) and not helplessLost(party) { Assert helplessLost(party). }
  Rule p3_grain when battleOn() and p3done(party) and overrun(mill_yard) and not grainSpoiled(party) and not grainTaken(party) { Assert grainTaken(party). Assert winterShort(party). }
  Rule p3_bell when battleOn() and p3done(party) and overrun(nave) and not bellSilenced(party) { Assert bellSilenced(party). }
  Rule bell_silent_costs when bellSilenced(party) and not bellMod(party) { Assert bellMod(party). Decrease drillBonus(party) by 1 or to nothing. }

  // ── The picked men come for the company, wherever it is ──────────────────────────────────────────────────────
  Rule picks_come when battleOn() and p3done(party) and watch(clock) >= assaultAt(wyre) + 18 and not p4done(party) and not fothergillTurned(party) and not picksWithdrawn(party) and at(party, ?r) {
    Assert p4done(party). Assert at(picks, ?r). }
  Rule picks_turned when battleOn() and p3done(party) and watch(clock) >= assaultAt(wyre) + 18 and not p4done(party) and fothergillTurned(party) { Assert p4done(party). Assert picksWithdrawn(party). }
  Rule picks_beaten_rule when p4done(party) and dead(picks) and not picksBeaten(party) { Assert picksBeaten(party). }
  Rule wyre_with_the_picks when p4done(party) and overrunCount(party) >= 2 and not picksWithdrawn(party) and at(picks, ?r) and not at(wyre, ?r) and not dead(wyre) { Assert at(wyre, ?r). }
  Rule wyre_dies when dead(wyre) and not wyreDead(party) { Assert wyreDead(party). }
  Rule dawn_comes when watch(clock) >= assaultAt(wyre) + 48 and not dawned(party) { Assert dawned(party). }
  Rule morning_comes when watch(clock) >= assaultAt(wyre) + 54 and not morning(party) { Assert morning(party). }

  Action yield_the_grain(actor: group, site: place) "Tell the picked men they may have the granary, and go" {
    Requires able(actor) and company(actor) and at(actor, site) and at(picks, site) and able(picks) and not grainGiven(party) and not grainSpoiled(party).
    Time 0.
    On success { Assert grainGiven(party). Assert picksWithdrawn(party). Assert winterShort(party). Retract at(picks, site). Retract at(wyre, site). }
    Result "The one with the helm under his arm looks at you for some time. 'The captain will be pleased,' he says, 'and in a year he will want something else.' He puts the helm on. They go, in a line, towards the granary, and the night is quiet behind them.".
  }
  Action parley_the_picks(actor: group, site: place) "Argue with the picked men that there is nothing here worth their dying" {
    Requires able(actor) and company(actor) and at(actor, site) and at(picks, site) and able(picks) and not picksWithdrawn(party) and not parleyTried(party).
    Time 0.
    Resolve check(actor, persuasion, dc_hard).
    On success { Assert picksWithdrawn(party). Assert picksArgued(party). Retract at(picks, site). Retract at(wyre, site). }
    On failure { Assert parleyTried(party). }
    Result "You tell them what the village is: a ford, a mill, sixty people, no coin. You tell them what it will cost them, and you tell them exactly, because you have counted. The one with the helm laughs once, shortly, and says to the others, 'He's right about the coin.' They go with their granary unvisited and their purses as empty as they came.".
    Otherwise "They hear you out. The helm is already back on. 'Sorry,' says the first, and he does sound it.".
  }
  Relation parleyTried(group).

  // ── What the night looks like from wherever you are standing ─────────────────────────────────────────────────
  // Reports are told of what is posted where, and not all of them are true: a horn can be a feint, and the nave
  // is a long way from the ford. First-wave reports live for the hour of the company's choices.
  Observe night_ford_holds near party when stands1(ford_stones) and barricadeUp(party) and watch(clock) < assaultAt(wyre) + 18 "From the ford, a long way off, the noise of the first rush stops, and starts, and stops. The coach has held.".
  Observe night_ford_holds_bare near party when stands1(ford_stones) and not barricadeUp(party) and watch(clock) < assaultAt(wyre) + 18 "From the ford, a long way off, the noise of the first rush stops, and starts, and stops. Nobody comes up the meadow.".
  Observe night_ford_falls near party when overrun1(ford_stones) and watch(clock) < assaultAt(wyre) + 18 "The ford has gone. You know by the sound: the noise of the wall coming apart, and then the noise of men who no longer have to climb.".
  Observe night_bridge_holds near party when stands1(bridge) and posted(wadsworth, bridge) and watch(clock) < assaultAt(wyre) + 18 "Nothing comes over the packhorse bridge. A single voice shouts 'Again!' and it is Hob Wadsworth's.".
  Observe night_bridge_holds_plain near party when stands1(bridge) and not posted(wadsworth, bridge) and watch(clock) < assaultAt(wyre) + 18 "Nothing comes over the packhorse bridge.".
  Observe night_bridge_horn near party when stands1(bridge) and watch(clock) >= assaultAt(wyre) + 6 and watch(clock) < assaultAt(wyre) + 12 "A horn, from the bridge: three blasts, and a voice that is not one of ours shouting that the bridge is lost. Nobody at the bridge has lost anything. It is going round the village faster than it can be answered.".
  Observe night_bridge_falls near party when overrun1(bridge) and watch(clock) < assaultAt(wyre) + 18 "The bridge has gone, and its people with it, and the road into the village is a lit road now.".
  Observe night_mill_holds near party when stands1(mill_yard) and posted(quarmby, mill_yard) and watch(clock) < assaultAt(wyre) + 18 "The mill wheel is still turning. Somebody has put out a lantern in the yard and the dark is full of thrown meal.".
  Observe night_mill_holds_plain near party when stands1(mill_yard) and not posted(quarmby, mill_yard) and watch(clock) < assaultAt(wyre) + 18 "The mill wheel is still turning.".
  Observe night_mill_falls near party when overrun1(mill_yard) and watch(clock) < assaultAt(wyre) + 18 "The mill has stopped. You did not know how loud it was until it stopped.".
  // The nave is the farthest from everything: its report comes late, in the second wave.
  Observe night_nave_holds near party when stands2(nave) and watch(clock) < assaultAt(wyre) + 24 "The chapel door is shut, and has been hit, and is shut.".
  Observe night_nave_falls near party when overrun(nave) and watch(clock) >= assaultAt(wyre) + 12 and watch(clock) < assaultAt(wyre) + 24 "Someone is in the chapel. The bell, which was ringing, has stopped in the middle of a stroke.".
  Observe night_second_ford near party when stands2(ford_stones) and watch(clock) >= assaultAt(wyre) + 12 and watch(clock) < assaultAt(wyre) + 24 "The ford again, and again it holds. They are not coming that way a third time.".
  Observe night_second_mill near party when overrun2(mill_yard) and watch(clock) >= assaultAt(wyre) + 12 and watch(clock) < assaultAt(wyre) + 24 "The second wave has come through the mill yard. The wheel has stopped and the meal is on fire.".
  Observe night_second_lured near party when lured(party) and watch(clock) >= assaultAt(wyre) + 12 and watch(clock) < assaultAt(wyre) + 24 "Somewhere out on the marsh a great many men are shouting at once, and a horse is screaming, and the sound goes on a long time.".
  Observe night_bridge_burned near party when bridgeBurned(party) and watch(clock) >= assaultAt(wyre) + 6 and watch(clock) < assaultAt(wyre) + 24 "Over the roofs, orange, low: the bridge, burning from end to end.".
  Observe night_fire near party when greenBurns(party) and watch(clock) < assaultAt(wyre) + 30 "Over the roofs, red. The green is burning; the thatch goes first, in a long sigh, and then the rest.".
  Observe night_fire_out near party when greenSaved(party) and watch(clock) < assaultAt(wyre) + 30 "A torch has gone into the thatch by the inn, and a dozen buckets have been waiting for it. The steam goes up like a flag.".
}
