Module sallowfield "Three Nights at Sallowfield" {
  // ── The night ─────────────────────────────────────────────────────────────────────────────────────────────────
  // Wyre comes at dusk of the third day (or the second, if his riders found the town unwatched). Four hours, in four
  // movements, each a thing the company can still affect: the first wears the posts down; the second is the clash
  // at each post, decided by what stands there (works, the posted, the drill, the company if it is present) against
  // what Wyre sent; the third is fire and the inward push; the fourth is his picked men, who come for the company.
  // A post that is overrun costs its people, by name.
  Relation stands(place). Relation overrun(place). Relation clashed(place). Relation counted(place).
  Relation casualtyDone(group). Relation p1done(group). Relation p3done(group). Relation p4done(group). Relation dawned(group).
  Relation greenBurns(group). Relation greenSaved(group). Relation helplessLost(group). Relation grainTaken(group). Relation bellSilenced(group).
  Relation pact(group). Relation grainGiven(group). Relation wyreWithdraws(group). Relation wyreDead(group). Relation picksBeaten(group). Relation picksWithdrawn(group).
  Measure overrunCount(group).

  Query battleOn() means watch(clock) >= assaultAt(wyre) and not pact(party) and not wyreWithdraws(party).

  Rule wyre_sees_spoiled when planned(party) and grainSpoiled(party) and wyreKnowsSpoiled(party) and watch(clock) >= assaultAt(wyre) and not wyreWithdraws(party) {
    Assert wyreWithdraws(party). }

  Rule move_to_posts when posted(?v, ?p) and watch(clock) >= assaultAt(wyre) - 12 and able(?v) and not at(?v, ?p) and not travelsWith(?v, party) { Assert at(?v, ?p). }

  Rule p1_wear when battleOn() and not p1done(party) {
    Assert p1done(party).
    Decrease defence(ford_stones) by thrust(ford_stones) / 4 or to nothing. Decrease defence(bridge) by thrust(bridge) / 4 or to nothing.
    Decrease defence(mill_yard) by thrust(mill_yard) / 4 or to nothing. Decrease defence(nave) by thrust(nave) / 4 or to nothing. }

  // The clash at each post. The company counts for eleven if it is there (it is a post of its own choosing), and for nothing if not.
  Rule clash_ford_with when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and not clashed(ford_stones) and at(party, ford_stones) and defence(ford_stones) + 2 * count(posted(?v, ford_stones) and able(?v)) + drillBonus(party) + 11 >= thrust(ford_stones) + dice(ford_stones) / 20 { Assert clashed(ford_stones). Assert stands(ford_stones). }
  Rule clash_ford_with_lost when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and not clashed(ford_stones) and at(party, ford_stones) and defence(ford_stones) + 2 * count(posted(?v, ford_stones) and able(?v)) + drillBonus(party) + 11 < thrust(ford_stones) + dice(ford_stones) / 20 { Assert clashed(ford_stones). Assert overrun(ford_stones). }
  Rule clash_ford when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and not clashed(ford_stones) and not at(party, ford_stones) and defence(ford_stones) + 2 * count(posted(?v, ford_stones) and able(?v)) + drillBonus(party) + 4 >= thrust(ford_stones) + dice(ford_stones) / 20 { Assert clashed(ford_stones). Assert stands(ford_stones). }
  Rule clash_ford_lost when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and not clashed(ford_stones) and not at(party, ford_stones) and defence(ford_stones) + 2 * count(posted(?v, ford_stones) and able(?v)) + drillBonus(party) + 4 < thrust(ford_stones) + dice(ford_stones) / 20 { Assert clashed(ford_stones). Assert overrun(ford_stones). }
  Rule clash_bridge_with when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and not clashed(bridge) and at(party, bridge) and defence(bridge) + 2 * count(posted(?v, bridge) and able(?v)) + drillBonus(party) + 11 >= thrust(bridge) + dice(bridge) / 20 { Assert clashed(bridge). Assert stands(bridge). }
  Rule clash_bridge_with_lost when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and not clashed(bridge) and at(party, bridge) and defence(bridge) + 2 * count(posted(?v, bridge) and able(?v)) + drillBonus(party) + 11 < thrust(bridge) + dice(bridge) / 20 { Assert clashed(bridge). Assert overrun(bridge). }
  Rule clash_bridge when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and not clashed(bridge) and not at(party, bridge) and defence(bridge) + 2 * count(posted(?v, bridge) and able(?v)) + drillBonus(party) + 4 >= thrust(bridge) + dice(bridge) / 20 { Assert clashed(bridge). Assert stands(bridge). }
  Rule clash_bridge_lost when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and not clashed(bridge) and not at(party, bridge) and defence(bridge) + 2 * count(posted(?v, bridge) and able(?v)) + drillBonus(party) + 4 < thrust(bridge) + dice(bridge) / 20 { Assert clashed(bridge). Assert overrun(bridge). }
  Rule clash_mill_with when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and not clashed(mill_yard) and at(party, mill_yard) and defence(mill_yard) + 2 * count(posted(?v, mill_yard) and able(?v)) + drillBonus(party) + 11 >= thrust(mill_yard) + dice(mill_yard) / 20 { Assert clashed(mill_yard). Assert stands(mill_yard). }
  Rule clash_mill_with_lost when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and not clashed(mill_yard) and at(party, mill_yard) and defence(mill_yard) + 2 * count(posted(?v, mill_yard) and able(?v)) + drillBonus(party) + 11 < thrust(mill_yard) + dice(mill_yard) / 20 { Assert clashed(mill_yard). Assert overrun(mill_yard). }
  Rule clash_mill when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and not clashed(mill_yard) and not at(party, mill_yard) and defence(mill_yard) + 2 * count(posted(?v, mill_yard) and able(?v)) + drillBonus(party) + 4 >= thrust(mill_yard) + dice(mill_yard) / 20 { Assert clashed(mill_yard). Assert stands(mill_yard). }
  Rule clash_mill_lost when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and not clashed(mill_yard) and not at(party, mill_yard) and defence(mill_yard) + 2 * count(posted(?v, mill_yard) and able(?v)) + drillBonus(party) + 4 < thrust(mill_yard) + dice(mill_yard) / 20 { Assert clashed(mill_yard). Assert overrun(mill_yard). }
  Rule clash_nave_with when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and not clashed(nave) and (at(party, nave) or at(party, bell_loft) or at(party, tower_roof)) and defence(nave) + 2 * count(posted(?v, nave) and able(?v)) + drillBonus(party) + 11 >= thrust(nave) + dice(nave) / 20 { Assert clashed(nave). Assert stands(nave). }
  Rule clash_nave_with_lost when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and not clashed(nave) and (at(party, nave) or at(party, bell_loft) or at(party, tower_roof)) and defence(nave) + 2 * count(posted(?v, nave) and able(?v)) + drillBonus(party) + 11 < thrust(nave) + dice(nave) / 20 { Assert clashed(nave). Assert overrun(nave). }
  Rule clash_nave when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and not clashed(nave) and not at(party, nave) and not at(party, bell_loft) and not at(party, tower_roof) and defence(nave) + 2 * count(posted(?v, nave) and able(?v)) + drillBonus(party) + 4 >= thrust(nave) + dice(nave) / 20 { Assert clashed(nave). Assert stands(nave). }
  Rule clash_nave_lost when battleOn() and p1done(party) and watch(clock) >= assaultAt(wyre) + 6 and not clashed(nave) and not at(party, nave) and not at(party, bell_loft) and not at(party, tower_roof) and defence(nave) + 2 * count(posted(?v, nave) and able(?v)) + drillBonus(party) + 4 < thrust(nave) + dice(nave) / 20 { Assert clashed(nave). Assert overrun(nave). }

  Rule count_overrun when overrun(?p) and not counted(?p) { Increase overrunCount(party) by 1. Assert counted(?p). }
  Rule cas_lost when overrun(?p) and posted(?v, ?p) and able(?v) and not casualtyDone(?v) and dice(?v) <= 55 { Slay ?v. Assert casualtyDone(?v). }
  Rule cas_lost_spared when overrun(?p) and posted(?v, ?p) and able(?v) and not casualtyDone(?v) and dice(?v) > 55 { Assert casualtyDone(?v). }
  Rule cas_held when stands(?p) and posted(?v, ?p) and able(?v) and not casualtyDone(?v) and dice(?v) <= 15 { Slay ?v. Assert casualtyDone(?v). }
  Rule cas_held_spared when stands(?p) and posted(?v, ?p) and able(?v) and not casualtyDone(?v) and dice(?v) > 15 { Assert casualtyDone(?v). }

  // Third movement: fire, and the push inward.
  Rule p3_fire when battleOn() and watch(clock) >= assaultAt(wyre) + 12 and not p3done(party) and overrunCount(party) >= 1 and (overrun(ford_stones) or overrun(bridge) or overrun(mill_yard)) and not bucketLine(party) {
    Assert p3done(party). Assert greenBurns(party). }
  Rule p3_fire_saved when battleOn() and watch(clock) >= assaultAt(wyre) + 12 and not p3done(party) and overrunCount(party) >= 1 and (overrun(ford_stones) or overrun(bridge) or overrun(mill_yard)) and bucketLine(party) {
    Assert p3done(party). Assert greenSaved(party). }
  Rule p3_quiet when battleOn() and watch(clock) >= assaultAt(wyre) + 12 and not p3done(party) and not overrun(ford_stones) and not overrun(bridge) and not overrun(mill_yard) { Assert p3done(party). }
  Rule p3_helpless when greenBurns(party) and not evacuated(party) and not helplessLost(party) { Assert helplessLost(party). }
  Rule p3_grain when battleOn() and p3done(party) and overrun(mill_yard) and not grainSpoiled(party) and not grainTaken(party) { Assert grainTaken(party). Assert winterShort(party). }
  Rule p3_bell when battleOn() and p3done(party) and overrun(nave) and not bellSilenced(party) { Assert bellSilenced(party). }

  // Fourth movement: the picked men come for the company, wherever it is.
  Rule picks_come when battleOn() and p3done(party) and watch(clock) >= assaultAt(wyre) + 18 and not p4done(party) and not fothergillTurned(party) and not picksWithdrawn(party) and at(party, ?r) {
    Assert p4done(party). Assert at(picks, ?r). }
  Rule picks_turned when battleOn() and p3done(party) and watch(clock) >= assaultAt(wyre) + 18 and not p4done(party) and fothergillTurned(party) { Assert p4done(party). Assert picksWithdrawn(party). }
  Rule picks_beaten_rule when p4done(party) and dead(picks) and not picksBeaten(party) { Assert picksBeaten(party). }
  Rule wyre_with_the_picks when p4done(party) and overrunCount(party) >= 2 and not picksWithdrawn(party) and at(picks, ?r) and not at(wyre, ?r) and not dead(wyre) { Assert at(wyre, ?r). }
  Rule wyre_dies when dead(wyre) and not wyreDead(party) { Assert wyreDead(party). }
  Rule dawn_comes when watch(clock) >= assaultAt(wyre) + 48 and not dawned(party) { Assert dawned(party). }

  Action yield_the_grain(actor: group, site: place) "Tell the picked men they may have the granary, and go" {
    Requires able(actor) and company(actor) and at(actor, site) and at(picks, site) and able(picks) and not grainGiven(party) and not grainSpoiled(party).
    Time 0.
    On success { Assert grainGiven(party). Assert picksWithdrawn(party). Assert winterShort(party). Retract at(picks, site). Retract at(wyre, site). }
    Result "The one with the helm under his arm looks at you for some time. 'The captain will be pleased,' he says, 'and in a year he will want something else.' He puts the helm on. They go, in a line, towards the granary, and the night is quiet behind them.".
  }
  Action parley_the_picks(actor: group, site: place) "Argue with the picked men that there is nothing here worth their dying" {
    Requires able(actor) and company(actor) and at(actor, site) and at(picks, site) and able(picks) and not picksWithdrawn(party) and not parleyTried(party).
    Time 0.
    Resolve check(actor, persuasion, dc_hard).
    On success { Assert picksWithdrawn(party). Retract at(picks, site). Retract at(wyre, site). }
    On failure { Assert parleyTried(party). }
    Result "You tell them what the village is: a ford, a mill, sixty people, no coin. You tell them what it will cost them, and you tell them exactly, because you have counted. The one with the helm laughs once, shortly, and says to the others, 'He's right about the coin.' They go.".
    Otherwise "They hear you out. The helm is already back on. 'Sorry,' says the first, and he does sound it.".
  }
  Relation parleyTried(group).

  // What the night looks like from wherever you are standing. Each report lives for the hours after its clash.
  Observe night_ford_holds near party when stands(ford_stones) and watch(clock) < assaultAt(wyre) + 24 "From the ford, a long way off, the noise of the first rush stops, and starts, and stops. The coach has held.".
  Observe night_ford_falls near party when overrun(ford_stones) and watch(clock) < assaultAt(wyre) + 24 "The ford has gone. You know by the sound: the noise of the wall coming apart, and then the noise of men who no longer have to climb.".
  Observe night_bridge_holds near party when stands(bridge) and watch(clock) < assaultAt(wyre) + 24 "Nothing comes over the packhorse bridge. A single voice shouts 'Again!' and it is Hob Wadsworth's.".
  Observe night_bridge_falls near party when overrun(bridge) and watch(clock) < assaultAt(wyre) + 24 "The bridge has gone, and its people with it, and the road into the village is a lit road now.".
  Observe night_mill_holds near party when stands(mill_yard) and watch(clock) < assaultAt(wyre) + 24 "The mill wheel is still turning. Somebody has put out a lantern in the yard and the dark is full of thrown meal.".
  Observe night_mill_falls near party when overrun(mill_yard) and watch(clock) < assaultAt(wyre) + 24 "The mill has stopped. You did not know how loud it was until it stopped.".
  Observe night_nave_holds near party when stands(nave) and watch(clock) < assaultAt(wyre) + 24 "The chapel door is shut, and has been hit, and is shut.".
  Observe night_nave_falls near party when overrun(nave) and watch(clock) < assaultAt(wyre) + 24 "Someone is in the chapel. The bell, which was ringing, has stopped in the middle of a stroke.".
  Observe night_fire near party when greenBurns(party) and watch(clock) < assaultAt(wyre) + 30 "Over the roofs, red. The green is burning; the thatch goes first, in a long sigh, and then the rest.".
  Observe night_fire_out near party when greenSaved(party) and watch(clock) < assaultAt(wyre) + 30 "A torch has gone into the thatch by the inn, and a dozen buckets have been waiting for it. The steam goes up like a flag.".
}
