Module wrayford "The Third Night" {
  // The country beyond a march of a generated world: the company that comes in by the road is the world's own.
  Entity party: group "Your company".
  // What is said of Wrayford in the country behind it: once it is seen through, it is old news there.
  Entity word: fact "What is said of Wrayford in the country behind it.".
  Rule word_old when verdictGiven(wray) and not stale(word) { Assert stale(word). }
}
