Module lull "The Lull" {
  // ── The Watching of the Working Day ───────────────────────────────────────────────────────────────────────────────
  // At the Working Day's dusk the town watches the bridge, and every Hand's work stands or falls in front of it. The
  // Lull ends if one of those who asked for it means it to, with enough of the young who mean it beside him; whether
  // its law goes with it depends on why he came.
  Rule working_hands when working() and hour(clock) >= 6 and not joins(corin) and not wardensBroke(club) { Assert joins(corin). Assert means(corin). Assert joins(davy). Assert means(davy). Assert joins(club). Assert means(club). }
  Relation counted(group).
  Rule count_hand when working() and hour(clock) >= 19 and joins(?x) and means(?x) and not counted(?x) and not wardensBroke(club) { Assert counted(?x). Increase handsMeaning(lull_country) by 1. }
  Measure handsMeaning(place).
  Relation outcomeMonday(place). Relation outcomeSeventh(place). Relation outcomeSunday(place). Relation outcomeMeant(place). Relation outcomeBroken(place).
  Query lullEnds() means joins(tobias) and handsMeaning(lull_country) >= 5 and not wardensBroke(club) and not killedMeant(party).
  Rule working_meant when dayThree() and workingBegun(lull_country) and lullDusk() and killedMeant(party) and not workingOver(lull_country) { Assert workingOver(lull_country). Assert outcomeMeant(lull_country). }
  Rule working_broken when dayThree() and workingBegun(lull_country) and lullDusk() and wardensBroke(club) and not killedMeant(party) and not workingOver(lull_country) { Assert workingOver(lull_country). Assert outcomeBroken(lull_country). }
  Rule working_holds_seventh when dayThree() and workingBegun(lull_country) and lullDusk() and lullEnds() and not tobiasGrief(tobias) and not workingOver(lull_country) { Assert workingOver(lull_country). Assert outcomeSeventh(lull_country). Assert bridgeBuilt(club). Assert state(bridge_gap, mended). }
  Rule working_holds_monday when dayThree() and workingBegun(lull_country) and lullDusk() and lullEnds() and tobiasGrief(tobias) and not workingOver(lull_country) { Assert workingOver(lull_country). Assert outcomeMonday(lull_country). Assert bridgeBuilt(club). Assert state(bridge_gap, mended). }
  Rule working_sunday when dayThree() and workingBegun(lull_country) and lullDusk() and not lullEnds() and not wardensBroke(club) and not killedMeant(party) and not workingOver(lull_country) { Assert workingOver(lull_country). Assert outcomeSunday(lull_country). Assert bridgeBuilt(club). Assert state(bridge_gap, mended). }
  Rule working_called_off when dayThree() and lullDusk() and clubDisbanded(club) and not workingOver(lull_country) { Assert workingOver(lull_country). Assert outcomeSunday(lull_country). }
  Query watchingWorking() means (at(party, green) or at(party, mill_bridge)).
  // What the Watching sees, told to whoever is there.
  Rule watched_paid when workingOver(lull_country) and joins(folk) and lullDusk() and dayThree() and watchingWorking() and not spreadFact(paid_told) and not wardensBroke(club)
    says "The sun goes off the Tump, and the Long Table, which has been carried down to the leat bank, holds its breath. At the stone-end of the bridge, where the townsfolk worked for Haskett's wages, the stone comes apart from the stone and slides into the leat, a course at a time, with a sound like a cart tipping; and from a dozen aprons the coins rise and go away up the Tump road in the dusk like starlings, home to Sixways. The people who were paid stand looking at their hands." { Assert spreadFact(paid_told). }
  Entity paid_told: fact "the paid work".
  Rule watched_stands when workingOver(lull_country) and bridgeBuilt(club) and lullDusk() and dayThree() and watchingWorking() and not spreadFact(stands_told)
    says "And the rest stands. The new oak lies across the leat from pier to pier, rough, and a little crooked where Davy Mote set it, and the stones at the Mill end are the stones the young carried meaning it, and they do not move. Corin Lindsell walks out onto the middle of it, slowly, and stamps, once, and it holds her. Behind her the Mill stands dark across the water, and for the first time in fifty-seven years there is a way to its door." { Assert spreadFact(stands_told). }
  Entity stands_told: fact "the bridge stands".
  Rule watched_seventh when outcomeSeventh(lull_country) and lullDusk() and dayThree() and watchingWorking() and not spreadFact(seventh_told)
    says "Then the starlings come over, as they do every dusk, and go over the Tump, and come back. They come back. They come down onto the new bridge in hundreds, onto the rails and the stones and Tobias Lindsell's shoulders, and stay there, talking. Up at the Mill there is a sound like a door taking a breath. Nobody moves. Tobias says, so that only Corin and the birds can hear it: 'Monday, then.' And Corin says: 'Tuesday too.' Midnight will come, and go, and something tells everyone at that table that tomorrow will be tomorrow." { Assert spreadFact(seventh_told). Assert weekReturned(lull_country). }
  Rule watched_hester when outcomeSeventh(lull_country) and lullDusk() and dayThree() and at(hester, mill_bridge) and watchingWorking() and not spreadFact(hester_watched_told)
    says "On the bank Hester Lindsell, in her quilt of strikers' shirts, has her eyes open, and is laughing without any sound, and has one hand out of the quilt, open, palm up, on her knee." { Assert spreadFact(hester_watched_told). }
  Entity hester_watched_told: fact "Hester watched".
  Rule watched_monday when outcomeMonday(lull_country) and lullDusk() and dayThree() and not spreadFact(monday_told)
    says "Then the starlings come over, as they do every dusk, and go over the Tump, and do not come back. The sky over the valley is empty of them, all at once, the way a room is empty when someone has left it. Up at the Mill the great doors open, by themselves, outward, and in the dusk across the new bridge come the Hands: a hundred shapes of grey lint in the shape of weavers, walking, not hurrying, and they go past the Long Table without turning their no-faces to it, up the Tump road, over the shoulder, and away out of the valley into the world, where the work is. Tobias Lindsell watches them go with his hands open on his knees. 'Let it end,' he said. It has." { Assert spreadFact(monday_told). Assert weekReturned(lull_country). Assert lawGone(lull_country). }
  Rule watched_sunday when outcomeSunday(lull_country) and lullDusk() and dayThree() and not clubDisbanded(club) and watchingWorking() and not spreadFact(sunday_told)
    says "Then the starlings come over, and go over the Tump, and the sun goes, and the bridge stands, and the night comes down on Linger the way it always has, and at the Long Table people start, a little sheepishly, to eat. Corin sits on the middle of her bridge with her feet over the water. 'It holds,' she says. 'It holds, and it's still Lullday.' She does not say it bitterly. She says it as if she were trying it for size." { Assert spreadFact(sunday_told). }
  Rule watched_broken when outcomeBroken(lull_country) and lullDusk() and dayThree() and watchingWorking() and not spreadFact(broken_told)
    says "There is nothing on the leat to watch. The timbers have gone down toward the Swallow. The Long Table is quiet, and eats, and does not look at the young of Linger, who sit at the bottom with the children, or at Corin Lindsell, whose right hand is bound in a cloth and will not, the bonesetter says, ever be quite a clockmaker's hand again." { Assert spreadFact(broken_told). }
  Rule watched_meant when outcomeMeant(lull_country) and lullDusk() and dayThree() and watchingWorking() and not spreadFact(meant_told)
    says "Nobody sets anything out on the grass tonight. They have carried the dead to the chapel, and laid them under the rafters full of starlings, and at the Watching the Long Table sits with the dusk coming down and watches the chapel arch instead, the whole town, the way it watches what was made that day, to see whether it will hold. It holds. In the Lull it always does, when it was meant." { Assert spreadFact(meant_told). }
  Entity seventh_told: fact "the Seventh Day". Entity monday_told: fact "Monday". Entity sunday_told: fact "the long Sunday". Entity broken_told: fact "the broken bridge". Entity meant_told: fact "what was meant".

  // ── Afterwards ────────────────────────────────────────────────────────────────────────────────────────────────────
  // At midnight after the Working Day the book closes on what became of each person, and then on the valley. The
  // valley goes on: its road open every day if the week came back, one in seven if not.
  Query accounting() means workingOver(lull_country) and cameIn(party) and (pastThree() or dayThree() and hour(clock) >= 23).
  Rule fate_corin_seventh when accounting() and outcomeSeventh(lull_country) and not spreadFact(fate_corin) says "Corin Lindsell has a workshop at the end of the Shift Bridge, in the old weighbridge house, with a clock over the door that is right twice a day, which is more than any clock in the Lull managed for fifty-seven years. On Lulldays the clocks she makes for wages come apart at sunset, and she does not mind, and the ones she makes for people do not." { Assert spreadFact(fate_corin). }
  Rule fate_corin_monday when accounting() and outcomeMonday(lull_country) and not spreadFact(fate_corin) says "Corin Lindsell sells clocks in Sixways and in the mill towns, good ones, at a good price, and they keep time. She does not go to the Watching; there is no Watching now. Some evenings she stands on the Shift Bridge and listens for the starlings." { Assert spreadFact(fate_corin). }
  Rule fate_corin_held when accounting() and outcomeSunday(lull_country) and corinClockHeld(corin) and not spreadFact(fate_corin) says "Corin Lindsell still makes clocks, in the Lull, for people; they hold. She is making one for every member of the Old Shift, in order of age, and says she will start on the Club when she has finished, and then on everybody else, and that it should take her about fifty-seven years." { Assert spreadFact(fate_corin). }
  Rule fate_corin_hurt when accounting() and corinHurt(corin) and not spreadFact(fate_corin) says "Corin Lindsell's hand mended crooked. She has taught Davy Mote to cut the wheels, and sits beside him at the bench and tells him what he is doing wrong, and the clocks still come apart at sunset, both of theirs." { Assert spreadFact(fate_corin). }
  Rule fate_corin_sunday when accounting() and not spreadFact(fate_corin) says "Corin Lindsell went out over the Tump a Lullday after the Working Day with a bag of tools, to make clocks in the world. She comes back for the Watching once a year, her count, and every time Linger is a week older and she is a year, and every time her grandfather says, You look tired." { Assert spreadFact(fate_corin). }
  Entity fate_corin: fact "Corin".
  Rule fate_tobias_love when accounting() and joins(tobias) and bridgeBuilt(club) and not tobiasGrief(tobias) and not spreadFact(fate_tobias) says "Tobias Lindsell keeps the Shift Bridge. He sits on a chair at the Mill end with Corin's clock in his waistcoat, and tells the strike to anyone who crosses, and tells it, now, from the right side of the window." { Assert spreadFact(fate_tobias). }
  Rule fate_tobias_broken when accounting() and joins(tobias) and wardensBroke(club) and not spreadFact(fate_tobias) says "Tobias Lindsell went into the leat after the timbers, at eighty-two, and brought one out, and set it on the bank, and sat on it. He sits on it still, most Lulldays, with Corin's clock in his waistcoat, and tells the strike from the right side of the window, to whoever will listen." { Assert spreadFact(fate_tobias). }
  Rule fate_tobias_grief when accounting() and tobiasGrief(tobias) and not spreadFact(fate_tobias) says "Tobias Lindsell died in the autumn, of being eighty-two in a valley where time had started again, quite quickly, in his chair by the empty bed. They found his hands open." { Assert spreadFact(fate_tobias). }
  Rule fate_tobias_none when accounting() and not spreadFact(fate_tobias) says "Tobias Lindsell sits by his window in the Lull and tells the strike to whoever asks, always from the window, and does not say which side." { Assert spreadFact(fate_tobias). }
  Entity fate_tobias: fact "Tobias".
  Rule fate_hester_eased when accounting() and hesterEased(hester) and not hesterDead(hester) and not spreadFact(fate_hester) says "Hester Lindsell has her poppy from Ruth Coll every Lullday, carried in by whoever is going, and is dying as slowly as ever, and minds it less, and says so." { Assert spreadFact(fate_hester). }
  Rule fate_hester_you when accounting() and diedBy(hester, party) and not spreadFact(fate_hester) says "Hester Lindsell had her Monday from a Sixer's hand, and the Lull never asked whose. Tobias knows. On your account he says nothing at all, which in him is a kind of thanks." { Assert spreadFact(fate_hester). }
  Rule fate_hester_tobias when accounting() and diedBy(hester, tobias) and not spreadFact(fate_hester) says "Hester Lindsell is buried on the Tump under the Strike Post, by the striker's grave of Nell Lumb, her little sister. The Lull believes the wasting took her." { Assert spreadFact(fate_hester). }
  Entity fate_hester: fact "Hester".
  Rule fate_simeon_with when accounting() and simeonWith(hester) and not spreadFact(fate_simeon) says "Simeon Eddowes sat with Hester Lumb at the end, as she drank what she had asked for, and held her hand, and told her a gloss he had been keeping sixty years, and she laughed at it. He lives at the Glossary now, and paints, very slowly, and every board he paints holds." { Assert spreadFact(fate_simeon). }
  Rule fate_simeon_home when accounting() and simeonHome(simeon) and not spreadFact(fate_simeon) says "Simeon Eddowes lives at the Glossary, unbanned by nobody in particular, and argues every day with Aldith Mote, and loses." { Assert spreadFact(fate_simeon). }
  Rule fate_simeon_out when accounting() and not simeonHome(simeon) and not spreadFact(fate_simeon) says "Simeon Eddowes writes his glosses in Exiles' Row, facing the stone." { Assert spreadFact(fate_simeon). }
  Entity fate_simeon: fact "Simeon".
  Rule fate_abel_wed when accounting() and wedded(wenna) and not spreadFact(fate_abel) says "Abel and Wenna Rooke are on the march road with Dulcie and the cart, with a box of green candles under the seat, going somewhere. Wenna has seen the sea. It was, she says, too big, and she has made Abel take her back twice." { Assert spreadFact(fate_abel). }
  Rule fate_abel_week when accounting() and weekReturned(lull_country) and not wedded(wenna) and not spreadFact(fate_abel) says "Abel Rooke carts for Linger now, six days in seven, and Wenna Spurling rides beside him on the seat to Sixways and back, which is not the sea, she says, but it is a road." { Assert spreadFact(fate_abel). }
  Rule fate_abel_not when accounting() and not spreadFact(fate_abel) says "Abel Rooke has stopped making chairs. Wenna Spurling dips candles in the chandlery in the Lull, and smells the road on every Sixer's boots, and says nothing." { Assert spreadFact(fate_abel). }
  Entity fate_abel: fact "Abel and Wenna".
  Rule fate_dorcas_week when accounting() and weekReturned(lull_country) and not dorcasStays(dorcas) and not piranOut(piran) and not spreadFact(fate_dorcas) says "Piran Penhallow walks out over the Tump to the Waiting Woman every evening now, because there is an every evening; and he is getting older at the same pace as his wife, at last, and says it is the best thing that ever happened to him, and she says he is a fool." { Assert spreadFact(fate_dorcas). }
  Rule fate_dorcas_out when accounting() and piranOut(piran) and not spreadFact(fate_dorcas) says "Piran Penhallow keeps the bar of the Waiting Woman beside his wife, and draws a poor pint, and has carved a new sign for the inn: a woman at a window, sixty, in a blue gown, looking out." { Assert spreadFact(fate_dorcas). }
  Rule fate_dorcas_in when accounting() and dorcasStays(dorcas) and not spreadFact(fate_dorcas) says "Dorcas Penhallow lives in the Lull now, at her husband's workshop, and is ill a day a week instead of seven, and sits for him at the window, not turning her face from the light." { Assert spreadFact(fate_dorcas). }
  Rule fate_dorcas_none when accounting() and not spreadFact(fate_dorcas) says "Dorcas Penhallow walks in over the Tump every Lullday, and Piran tells her she looks tired, and she tells him it is the walk." { Assert spreadFact(fate_dorcas). }
  Entity fate_dorcas: fact "Dorcas and Piran".
  Rule fate_houses_dead when accounting() and dead(hobday) and not spreadFact(fate_houses) says "Lettice Pryce gives nothing to anybody now. She sits in the parlour with the cabinets and the carpet, and Mabyn Gale comes over every Lullday and sits with her, and neither of them says a word about generosity, and it holds." { Assert spreadFact(fate_houses). }
  Rule fate_houses_peace when accounting() and housesAtPeace(mabyn) and not spreadFact(fate_houses) says "The Pryces and the Gales keep one open house between them, on alternate Lulldays, and the guests of both are fed half as much and twice as well." { Assert spreadFact(fate_houses). }
  Rule fate_houses_given when accounting() and pryceHouseGiven(lettice) and not spreadFact(fate_houses) says "Mabyn Gale gave the Pryces' house back to Lettice Pryce at the next Watching, and it held, because Mabyn meant it; and Lettice has not forgiven her for that either." { Assert spreadFact(fate_houses). }
  Rule fate_houses_none when accounting() and not spreadFact(fate_houses) says "Lettice Pryce gave the Glossary a weathercock in the spring. Mabyn Gale gave it a wind." { Assert spreadFact(fate_houses). }
  Entity fate_houses: fact "the Open Houses".
  Rule fate_nan_out when accounting() and (nanExposed(nan) or nanBanned(nan)) and not spreadFact(fate_nan) says "Quick Nan sells pasties on Sixways street and not over the Tump. The bright ribbons on the Strike Post have all gone; the Lull blue is back, ugly and holding." { Assert spreadFact(fate_nan). }
  Rule fate_nan_reformed when accounting() and nanReformed(nan) and not spreadFact(fate_nan) says "Quick Nan sells pasties on the Green on Lulldays, eaten before sunset, and nothing else; and she put six coin in the chapel basin for the mothers, and the Glosser says it held." { Assert spreadFact(fate_nan). }
  Rule fate_nan_partner when accounting() and nanPartner(nan) and not spreadFact(fate_nan) says "Quick Nan's ribbons still go off the Strike Post at sunset, and the mothers of Linger still sit in the chapel afterwards, and the Glossers still say it is a hard year." { Assert spreadFact(fate_nan). }
  Rule fate_nan_week when accounting() and weekReturned(lull_country) and not spreadFact(fate_nan) says "Quick Nan has a stall on Linger green every day of the week now, and sells what she sells, and it stays sold, and she finds she misses the race against the sunset more than she can say." { Assert spreadFact(fate_nan). }
  Rule fate_nan_none when accounting() and not spreadFact(fate_nan) says "Quick Nan still goes in at six and out by four." { Assert spreadFact(fate_nan). }
  Entity fate_nan: fact "Nan".
  Rule fate_linnet_stay when accounting() and stayPromised(party) and not spreadFact(fate_linnet) says "In the music room over the Open Hand there is a tune that everybody in Linger knows, that has a next bit. Linnet Gale plays it at every Watching, and looks down the Long Table to where you sit." { Assert spreadFact(fate_linnet). }
  Rule fate_linnet_come when accounting() and linnetWillCome(linnet) and not spreadFact(fate_linnet) says "Linnet Gale has her fiddle and her boots and a pack Mabyn filled, and is waiting at the stone for you to ask her again, on the road, so that she knows you meant it." { Assert spreadFact(fate_linnet). }
  Rule fate_linnet_tune when accounting() and linnetTune(linnet) and not spreadFact(fate_linnet) says "Linnet Gale's tune with the next bit is sung at the Watching every Lullday, by people who do not know who it was made for." { Assert spreadFact(fate_linnet). }
  Rule fate_linnet_week when accounting() and weekReturned(lull_country) and not spreadFact(fate_linnet) says "Linnet Gale's tunes are remembered now, because there is a tomorrow to remember them in. She plays Monday's on Tuesday, and people know it, and sing it back to her wrong." { Assert spreadFact(fate_linnet). }
  Rule fate_linnet_none when accounting() and not spreadFact(fate_linnet) says "Linnet Gale makes a tune a day in the music room over the Open Hand, and in the morning it is gone." { Assert spreadFact(fate_linnet). }
  Entity fate_linnet: fact "Linnet".

  Ending seventh_day "The Seventh Day" when accounting() and outcomeSeventh(lull_country) "Midnight came to the Lull and went, and the starlings did not stop, and in the morning it was Monday. Nobody in Linger under fifty-seven had ever seen one. They did not know what to do with it, and mostly they rested, out of habit, and some of them went down to the Shift Bridge and stood on it. The week came back to the valley, and the Lullday stayed in it: one day in seven the law still holds there, and whatever is done without meaning it comes apart at sunset, and people walk in from Sixways on that day, now, to rest, and to see what holds. The road is open every day. The Fold-stone has stopped being notched. Somebody has carved on it, under all the rows of seven: AND THEN MONDAY.".
  Ending monday "Monday" when accounting() and outcomeMonday(lull_country) "Midnight came to the Lull and went, and it was Monday, and then Tuesday, and then it was a valley like any other, with a mill in it that Mercer Haskett has bought from nobody in particular and set going. Things made there for wages hold, now, and so does everything else. The Old Shift began to age at the world's pace, and are going, one by one; the young are learning to hurry. On the Tump the ribbons on the Strike Post fade, and no new ones are tied. In the mill towns, they say, there are grey workers on the roads who will do any work at all, without faces, and nobody asks where they came from.".
  Ending long_sunday "The Long Sunday" when accounting() and outcomeSunday(lull_country) "Midnight came to the Lull, and the starlings stopped in the middle of a note, and the lanterns went out, and it was the six days it does not keep. The Shift Bridge stands across the leat, made meaning it, to a mill nobody goes into. The next Lullday was Lullday, and the one after. The road goes down from the Fold-stone one day in seven, and Sixways notches the stone, and in the valley it is the holy day, still, as it was asked, and nobody can say whether the asking is still meant, or only still kept.".
  Ending broken_bridge "The Bridge in the Leat" when accounting() and outcomeBroken(lull_country) "Midnight came, and the starlings stopped, and the Lull folded up its six days as it always has. The timbers of the Shift Bridge went down the Idle into the Swallow and under the hill and came out, they say, in Sixways, in the spring behind the Waiting Woman. Nobody in the Lull speaks of the Working Day. The Rest-wardens fine nobody for anything for a long time afterwards. The warden who broke Corin Lindsell's hand goes to the Watching every Lullday and sits at the bottom of the Table, with the children.".
  Ending what_was_meant "What Was Meant" when accounting() and outcomeMeant(lull_country) "In the Lull you can only be killed by somebody who means it. On the Working Day somebody was. The bridge was not finished; the work came to nothing either way, and the Lull is the Lull, and the dead are buried on the Tump under the Strike Post among the ribbons. The town does not speak of whose hand it was. It does not need to. At the Watching, every Lullday, there is a place left at the Long Table, and something set out on the grass in front of it, and it holds.".

  // ── What the company grows by ─────────────────────────────────────────────────────────────────────────────────────
  Milestone m_first_lull "walked into the Lull" worth 50 when cameIn(party).
  Milestone m_watching "sat through a Watching" worth 25 when sawWatching(party).
  Relation sawWatching(group).
  Rule watching_seen when lullDusk() and at(party, green) and not sawWatching(party) { Assert sawWatching(party). }
  Milestone m_law "found what holds in the Lull" worth 150 when knows(party, meaning_law).
  Milestone m_sixnight "lived through the Sixnight" worth 100 when sixnightLived(party).
  Milestone m_beam "read the strikers' beam" worth 50 when knows(party, beam_names).
  Milestone m_window "heard which side of the window" worth 100 when knows(party, tobias_inside).
  Milestone m_wedding "saw Abel and Wenna wed" worth 100 when wedded(wenna).
  Milestone m_heads "told Dorcas and Piran the truth" worth 75 when piranKnowsIll(piran) or dorcasKnowsHeads(dorcas).
  Milestone m_ribbons "set the mothers of Linger right" worth 100 when jenetHealed(jenet).
  Milestone m_brock "settled the Old Brock" worth 100 when brockFed(brock) or brockGone(brock) or dead(brock) and not bountyTaken(party).
  Milestone m_clock "saw Corin's clock hold" worth 150 when corinClockHeld(corin).
  Milestone m_overseer "faced the Overseer" worth 150 when overseerBroken(overseer) or state(pay_chest, open).
  Milestone m_hester "answered Hester Lindsell" worth 100 when hesterEased(hester) or diedBy(hester, party).
  Milestone m_houses "ended the war of the Open Houses" worth 75 when housesAtPeace(mabyn) or pryceHouseGiven(lettice).
  Milestone m_bridge "worked on the Shift Bridge" worth 100 when workedBridge(party).
  Milestone m_working "saw the Working Day through" worth 200 when workingOver(lull_country) and cameIn(party).
}
