Module tower_player "Promises below ground" {
  Entity cinder_gift: reward "Ys's one-use cinder seal".
  Initially Assert giftEffect(cinder_gift, cinder_lesson). Initially Assert rewardFor(cinder_gift, burial).
  Topic ys_mission with ys "Ask Ys why she risked the tower" when functioning(siphon) {
    Says "'Those families need clean water more than another promise. I came for the drain and could not get the siphon apart. The warden thinks everyone is a thief. Read its oath or use the flue; fighting is your choice. Open the hatch, stop the siphon and I can walk home. I have a one-use cinder seal to give you afterward. It lets one companion learn a fire invocation. It would be useful against the frost things in the northern fen.'".
  }
  Topic ys_recovery with ys "Ask Ys about tomorrow's expedition" when rescued(ys) and knows(ys, burial) and not claimed(cinder_gift) {
    Says "'We have breathing space, not a cure for every loss. The warden swore to keep grave robbers from the reservoir; I came to drain it, not plunder it. I have left a one-use cinder seal here. Let one companion study it and the invocation will be theirs permanently. Rest at the refuge before going north. Frost things hate fire, but a quiet traveler can sometimes pass them. Do not spend lives to prove you can win.'".
    On discuss { Assert knows(actor, burial). Retract assumesFalse(actor, burial). }
  }
  Rule offer_lesson when rescued(ys) and able(ys) and not claimed(cinder_gift) {
    Assert offeredAt(cinder_gift, green). Assert at(cinder_gift, green).
  }
  Topic ys_after_lesson with ys "Ask Ys what remains to be done" when rescued(ys) and claimed(cinder_gift) {
    Says "'The seal is spent, but the invocation is part of your companion now. Take supplies and recover before going north. Stopping the frost can preserve a safe camp; taking salvage without stopping it is a different choice. I cannot promise that fighting will bring everyone home.'".
  }
  Goal false.
}
