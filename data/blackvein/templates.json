{
  "resident": {
    "__no_id": true,
    "id": "=dig(#_role, 'id')",
    "context": "=gen(resident_context)",
    "gold": "=dig(#_role, 'gold')"
  },
  "settled_situation": {
    "__no_id": true,
    "culture": "river",
    "pace": "ordinary",
    "name": "Blackvein",
    "creatures": "=concat(gatherEntries(communityRoles, party), mapGenList(resident, gatherEntries(communityRoles, residents), '_role'))",
    "actors": "=gen(community_actors)",
    "initial": "=concat(gen(community_schedule), gen(hero_purse), gen(worker_purse))",
    "outcomes": "=gatherEntries(communityRoles, outcomes)"
  },
  "community_schedule": {
    "__no_id": true,
    "args": [
      "vey"
    ],
    "value": "=lookup(communityPressure, #pace)",
    ">name": "enforceAt"
  },
  "community_actors": {
    "__no_id": true,
    "order": "=gatherEntries(communityRoles, controllers)"
  },
  "resident_context": {
    "__no_id": true,
    "raceId": "=dig(#_role, 'raceId') ? dig(#_role, 'raceId') : lookup(communityPopulation, #culture)",
    "classId": "=dig(#_role, 'classId')",
    ">name": "=dig(#_role, 'name')"
  },
  "hero_purse": {
    "__no_id": true,
    ">name": "quantity",
    "args": [
      "party",
      "gold"
    ],
    "value": 4
  },
  "worker_purse": {
    "__no_id": true,
    ">name": "quantity",
    "args": [
      "ada",
      "gold"
    ],
    "value": 12
  }
}
