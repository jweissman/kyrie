# cistern: the Water-Wardens' cistern under a hill, where they held the springs and read the still water.
@art water
@kind cave
@ground heath fell wood meadow
@near river
@seen a square doorway in a hillside
@names keep, pool, lake, watch, fountain
@danger 1
@lair hall
--- outside
  Observe {w}_door_seen at {w} when true "A square doorway goes into the hillside under a lintel of a single dressed stone. Cold air comes out of it, smelling of water.".
  Observe {w}_cut at {w} when true "Letters are cut deep in the lintel, in a script older than the folk's: {oldup}." teaches {w}_named.
  Thing {w}_lintel "the letters over the door" at {w} {
    State unread "Letters are cut in the lintel stone in the old script. Someone who reads it could say what they mean.".
    State read "{oldup}, the letters say: in the old tongue, “{gloss}”. The Water-Wardens named their works for what they kept.".
    Change read "Read the letters over the door" from unread to read needing lore.
  }
--- base
  Place {w}_site "{name}" is site within {land} at {x}, {y}.
  Initially Assert unlit({w}_stair). Initially Assert unlit({w}_hall). Initially Assert unlit({w}_wheel_room).
  Initially Assert unlit({w}_head).
  Thing {w}_wheel "the bronze sluice-wheel" at {w}_wheel_room {
    State fast "A wheel of bronze as high as a man is set in the wall above the channel, green with age and fast in its seat.".
    State turned "The bronze wheel has been wound round as far as it will go.".
    Change wind "Wind the sluice-wheel round" from fast to turned needing brawn or crowbar.
  }
  Rule {w}_drains when state({w}_wheel, turned) and state({w}_water, flooded) says "Deep in the hill a gate grinds open. The black water begins to fall, and goes on falling, and the dark fills with the sound of it." { Assert state({w}_water, drained). }
  Thing {w}_marks "marks cut up a pillar" at {w}_hall {
    State unread "One pillar is cut with marks from the floor to as high as you can reach, each with a word beside it in the old script.".
    State read "Each mark is the height the water stood in a year {epithet} kept it, and the word beside it is the year's name. There are hundreds. The last mark is the highest, and has no word.".
    Change read "Read the marks on the pillar" from unread to read needing lore.
  }
  Observe {w}_marks_learned at {w}_hall of {w}_marks as reading when state({w}_marks, read) "{craft} {belief}" teaches {makersfact}.
  Item {w}_votive "{richname}" is {rich} at {w}_head.
  Observe {w}_head_votive at {w}_head as feature when true "Things glint in the bottom of the basin: offerings, left for the springs by people who meant them.".
--- shape stair 1 if shape0
  Place {w}_stair "the long stair" is room within {w}_site at 0, 0.
  Place {w}_hall "the pillared hall" is room within {w}_site at 1, 0.
  Place {w}_wheel_room "the wheel-room" is room within {w}_site at 1, 1.
  Place {w}_head "the spring-head" is room within {w}_site at 2, 0.
  Passage {w}_in "the square doorway" is doorway between {w} and {w}_stair.
  Passage {w}_down "the foot of the long stair" is steps between {w}_stair and {w}_hall.
  Passage {w}_ledge "the ledge along the wall" is passage between {w}_hall and {w}_wheel_room.
  Passage {w}_arch "the low arch" is passage between {w}_hall and {w}_head.
  Observe {w}_stair_scene at {w}_stair when true "A straight stair goes down into the hill, a hundred steps and more, each tread worn hollow in the middle. The walls are dressed stone without mortar, the joints so fine a knife would not go in.".
  Observe {w}_hall_scene at {w}_hall when true "Pillars stand in rows into the dark, square and plain, holding up a roof you cannot see. Your voices go away into the hall and come back changed.".
  Observe {w}_wheel_scene at {w}_wheel_room when true "A cell cut off the side of the hall, above a stone channel that runs away under the wall.".
  Observe {w}_head_scene at {w}_head when true "A round chamber where the springs come up through the floor into a basin of white stone. The water is so clear the basin seems empty until it moves.".
  Thing {w}_water "black water" on {w}_arch is scenery {
    State flooded blocking "Black water stands in the hall to the springing of the arches, still as a floor. At its far end a low arch goes down under it.".
    State drained "The water has gone down out of the hall. Silt lies in ridges between the pillars, and the low arch stands open, streaming.".
  }
--- shape well 1 if shape1
  Place {w}_stair "the head of the steps" is room within {w}_site at 0, 0.
  Place {w}_hall "the water-stair" is room within {w}_site at 0, 1.
  Place {w}_wheel_room "the sluice-niche" is room within {w}_site at 1, 1.
  Place {w}_head "the spring-pool" is room within {w}_site at 0, 2.
  Passage {w}_in "the square doorway" is doorway between {w} and {w}_stair.
  Passage {w}_down "the flights down the shaft" is steps between {w}_stair and {w}_hall.
  Passage {w}_ledge "the ledge round the shaft" is passage between {w}_hall and {w}_wheel_room.
  Passage {w}_arch "the arch at the bottom of the shaft" is passage between {w}_hall and {w}_head.
  Observe {w}_stair_scene at {w}_stair when true "The doorway opens on the top of a great square shaft cut down into the hill. Far above, a square of sky shows through ferns; far below, the dark. Flights of steps go down the four sides of the shaft by turns, each landing wider than the one below.".
  Observe {w}_hall_scene at {w}_hall when true "The lowest flights of the shaft, where the steps go down into black water as if into the floor of a room. Sound falls into the shaft from somewhere far above and does not come back up.".
  Observe {w}_wheel_scene at {w}_wheel_room when true "A niche cut into the side of the shaft above the water, over a stone channel that runs away into the hill.".
  Observe {w}_head_scene at {w}_head when true "Under the bottom of the shaft, a round chamber where the springs come up through the floor into a basin of white stone. The water is so clear the basin seems empty until it moves.".
  Thing {w}_water "black water" on {w}_arch is scenery {
    State flooded blocking "Black water fills the bottom of the shaft over the lowest flights, still as a floor. Under it, at the foot of the last flight, the top of an arch.".
    State drained "The water has gone down out of the shaft. Silt lies on the lowest steps, and the arch at the bottom stands open, streaming.".
  }
--- shape outfall 1 if shape2
  Observe {w}_outfall_seen at {w} when true "Lower down the hillside a stone channel comes out of the ground into a culvert, dry now, just big enough to crawl into.".
  Place {w}_stair "the long stair" is room within {w}_site at 0, 0.
  Place {w}_hall "the hall of round pillars" is room within {w}_site at 1, 0.
  Place {w}_wheel_room "the wheel-room" is room within {w}_site at 1, 1.
  Place {w}_head "the spring-head" is room within {w}_site at 2, 0.
  Passage {w}_in "the square doorway" is doorway between {w} and {w}_stair.
  Passage {w}_outfall "the culvert under the hill" is crawl between {w} and {w}_wheel_room.
  Passage {w}_down "the foot of the long stair" is steps between {w}_stair and {w}_hall.
  Passage {w}_ledge "the ledge along the wall" is passage between {w}_hall and {w}_wheel_room.
  Passage {w}_arch "the low arch" is passage between {w}_hall and {w}_head.
  Observe {w}_stair_scene at {w}_stair when true "A straight stair goes down into the hill, a hundred steps and more, turning twice. The walls are dressed stone without mortar, the joints so fine a knife would not go in.".
  Observe {w}_hall_scene at {w}_hall when true "Round pillars stand in rows into the dark, some fallen across one another where the roof has come down between them. Your voices go away into the hall and come back changed.".
  Observe {w}_wheel_scene at {w}_wheel_room when true "A cell cut off the side of the hall, above a stone channel that runs away under the wall and out of the hill. Daylight comes faintly along it.".
  Observe {w}_head_scene at {w}_head when true "A round chamber where the springs come up through the floor into a basin of white stone. The water is so clear the basin seems empty until it moves.".
  Thing {w}_water "black water" on {w}_arch is scenery {
    State flooded blocking "Black water stands among the fallen pillars to the springing of the arches, still as a floor. At its far end a low arch goes down under it.".
    State drained "The water has gone down out of the hall. Silt lies in ridges round the fallen pillars, and the low arch stands open, streaming.".
  }
--- sign pool 1 if greatart
  Thing {w}_pool "the still water in the basin" at {w}_head is scenery {
    State still "The water in the basin is so still you could take it for glass.".
    State gazed "The water in the basin is only water again.".
    Change gaze "Look long into the still water" from still to gazed.
  }
  Observe {w}_far_sight at {w}_head as revelation when state({w}_pool, gazed) "The still water shows the roof, and your own faces; and then neither, but {greatseen}, under a sky that is not this one, and water standing behind it as still as this. When the water lets it go you know the place: {greatwhere}." teaches {greatfound}.
--- successors shrine 2
  Observe {w}_shrine at {w}_stair when true "Halfway down the stair a niche has been cut, rougher than the work around it, and an altar set in it: the kingdom of {successors} kept the springs holy after the Wardens were gone. Offerings lie green on the altar.".
  Item {w}_coins "{commonname}" is {common} at {w}_stair.
--- successors well 1
  Observe {w}_well at {w}_hall when true "A shaft has been cut down through the roof of the hall from above, and a rotten rope hangs out of it into the water: the kingdom of {successors} drew their water here.".
--- successors forgotten 1
  Observe {w}_forgotten at {w}_stair when true "Nobody has been down here in a long time. The dust on the treads has no footprints in it but the rats'.".
--- present frogs 2
  Person {w}_frogs "frogs as big as dogs" at {w}_hall {
    Role "frogs as big as dogs, lying in the black water". Species frog. Numbers 3. Level 1. Temperament ambush.
    Comes "The water between the pillars bursts open and something wet and heavy is on you.".
  }
  Observe {w}_spawn at {w} as sign noticed by woodcraft when able({w}_frogs) "Frog-spawn lies in the wet by the doorway, every egg the size of a fist, and something heavy has worn a slide in the mud going in.".
--- present keeper 1
  Person {w}_keeper "the wheel-keeper" at {w}_wheel_room {
    Role "a figure of green bronze that stands beside the wheel, as it has stood for a thousand years". Species bronze_construct. Level 3. Temperament obedient. Lair {w}_wheel_room.
    Warns "The bronze figure by the wheel turns its head toward you, slowly, with a sound like a door.".
  }
  Observe {w}_wardmark at {w} as sign noticed by lore when able({w}_keeper) "Cut small under the letters on the lintel is one more word in the old script: KEPT. The Water-Wardens set it over a door when they left something below to keep the place.".
--- present empty 2
  Observe {w}_still at {w}_hall when true "Nothing moves in the water. Nothing has, for a long time.".
--- hook gold 2
  Topic {w}_hook with {keeper} "Ask {{keeper}} about the old wells" when not knows(actor, {w}_named) once {
    Says "'The old wells?' {{keeper}} leans on the bar. 'A door in the hill out in {where}, and a stair going down further than anyone has followed it: {name}, we call it. Folk say the kings of old kept their gold down there under the water, where no thief would follow. Folk say a lot of things.'".
    On discuss { Assert knows(actor, {w}_named). Assert knows(actor, {w}_found). }
  }
--- hook springs 1
  Topic {w}_hook with {priest} "Ask {{priest}} where the shrine's water comes from" when not knows(actor, {w}_named) once {
    Says "'From the hill,' says {{priest}}. 'There is a door into it, out in {where}: {name}. The springs come up inside, and the old people held them there with gates of bronze. Nobody goes in now. They say something lives in the water.'".
    On discuss { Assert knows(actor, {w}_named). Assert knows(actor, {w}_found). }
  }
