{
  "region": {
    "__no_id": true,
    "terrain": "=defined('terrain') ? #terrain : lookup(regionTerrain, default)",
    "ancestry": "=defined('ancestry') ? #ancestry : lookup(regionAncestry, #terrain)",
    "domain": "=defined('domain') ? #domain : lookup(faithDomain, default)",
    "deity": "=lookup(deityName, #domain)",
    "settlements": "=genList(settlement, 3)",
    "sites": "=genList(site, 3)",
    "wonder": "=gen(wonder)",
    "feature": "=lookup(placeFeature, #terrain)",
    "affix": "=lookup(regionAffix, #terrain)",
    "name": "=capitalize(#feature) + #affix"
  },
  "settlement": {
    "__no_id": true,
    "id": "='s' + (#_index + 1)",
    "feature": "=lookup(placeFeature, #terrain)",
    "affix": "=lookup(placeAffix, #terrain)",
    "name": "=capitalize(#feature + #affix)",
    "size": "=lookup(settlementSize, #_index == 0 ? 'first' : 'other')",
    "trade": "=lookup(regionTrade, #terrain)",
    "merchantType": "=lookup(tradeMerchant, #trade)",
    "inn": "='the ' + capitalize(lookup(innAdjective, default)) + ' ' + capitalize(lookup(innObject, default))",
    "innkeeper": "=lookup(townsfolkName, #ancestry)",
    "priest": "=lookup(townsfolkName, #ancestry)",
    "merchant": "=lookup(townsfolkName, #ancestry)",
    "traveller": "=lookup(townsfolkName, #ancestry)",
    "calling": "=lookup(travellerCalling, #terrain)"
  },
  "site": {
    "__no_id": true,
    "id": "='w' + (defined('_index') ? #_index + 1 : 0)",
    "_kind": "=select(siteKind, #terrain, 'defined(\"kind\") ? dig(#__it, \"_key\") == #kind : true')",
    "kind": "=dig(#_kind, '_key')",
    "feature": "=lookup(placeFeature, #terrain)",
    "affix": "=lookup(siteNoun, #kind)",
    "name": "=capitalize(#feature) + ' ' + capitalize(#affix)",
    "hours": "=1d2"
  },
  "wonder": {
    "__no_id": true,
    "kind": "=lookup(wonderKind, default)",
    "description": "=lookup(wonderDescription, #kind)"
  }
}
