    "discriminator": "habitat",
    "groups": {
      "wood": [
        {
          "_key": "deer",
          "text": "Deer go off between the trees without a sound."
        },
        {
          "_key": "squirrel",
          "text": "A squirrel scolds you from a bough overhead."
        },
        {
          "_key": "owl",
          "text": "An owl watches from a hollow oak, and does not blink."
        },
        {
          "_key": "fox",
          "text": "A fox crosses the way ahead and is gone."
        },
        {
          "_key": "stag",
          "text": "A stag stands in a clearing, watching, before it turns away."
        }
      ],
      "grove": [
        {
          "_key": "pixie",
          "text": "Small lights move between the trunks, and there is laughter that is not quite birdsong."
        },
        {
          "_key": "deer",
          "text": "Deer lift their heads from the moss and watch you out of sight."
        },
        {
          "_key": "owl",
          "text": "An owl calls in daylight, which the old folk say is bad luck."
        }
      ],
      "river": [
        {
          "_key": "otter",
          "text": "An otter's head breaks the water downstream and is gone."
        },
        {
          "_key": "dragonfly",
          "text": "Dragonflies hang over the shallows."
        },
        {
          "_key": "turtle",
          "text": "A turtle slides off a stone into the water."
        },
        {
          "_key": "frog",
          "text": "Frogs fall silent along the bank as you come down to it."
        }
      ],
      "lake": [
        {
          "_key": "frog",
          "text": "Frogs fall silent along the shore as you pass."
        },
        {
          "_key": "dragonfly",
          "text": "Dragonflies hang over the reeds, blue and still."
        },
        {
          "_key": "turtle",
          "text": "Turtles sun themselves on a drowned log."
        }
      ],
      "fen": [
        {
          "_key": "snake",
          "text": "A snake swims across a channel with its head held up like a stick."
        },
        {
          "_key": "frog",
          "text": "The frogs stop, all at once, and start again behind you."
        },
        {
          "_key": "crow",
          "text": "Crows go up out of the reeds, complaining."
        },
        {
          "_key": "lizard",
          "text": "A lizard watches from a tussock, its throat pulsing."
        }
      ],
      "fells": [
        {
          "_key": "goat",
          "text": "Wild goats watch you from a ledge, chewing."
        },
        {
          "_key": "raven",
          "text": "Ravens tumble over the crags, calling."
        },
        {
          "_key": "hawk",
          "text": "A hawk hangs on the wind, then drops."
        },
        {
          "_key": "rabbit",
          "text": "Rabbits scatter from the turf by the road."
        }
      ],
      "heights": [
        {
          "_key": "eagle",
          "text": "An eagle turns far overhead."
        },
        {
          "_key": "goat",
          "text": "Wild goats stand on rock no goat should stand on."
        },
        {
          "_key": "raven",
          "text": "A raven keeps pace with you from cairn to cairn."
        }
      ],
      "snow": [
        {
          "_key": "stoat",
          "text": "A stoat in its winter white bounds across the snow."
        },
        {
          "_key": "raven",
          "text": "A raven sits on a drift, black as a hole in the world."
        },
        {
          "_key": "hawk",
          "text": "A hawk quarters the snowfield, low and slow."
        }
      ],
      "cave": [
        {
