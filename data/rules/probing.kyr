Module probing "Trying things: looking closely, prodding, prying, burning, pushing, listening" {
  Entity looking: verb "looked over closely". Entity prodding: verb "prodded with a pole".
  Entity prying: verb "pried at with a bar". Entity burning: verb "put to the flame".
  Entity pushing: verb "pushed and pulled". Entity listening: verb "listened at".
  // Anything that can be handled can be tried; what it does when tried is the author's (an observation, an event,
  // a rule on tried). A try that finds nothing says so; offering it never reveals anything.
  Initially Assert needs(prodding, pole). Initially Assert needs(prying, crowbar). Initially Assert needs(burning, flame).
  Goal false.
  Action look_closely(actor: group, target: entity, site: place) "Look closely at {target}" {
    Time 2 minutes.
    Requires able(actor) and at(actor, site) and probeable(target) and reaches(actor, target) and not benighted(actor)
      and not tried(target, looking).
    On success { Assert tried(target, looking). }
    Result "You look closely at {target}.".
  }
  Action prod(actor: group, target: entity, site: place) "Prod {target} with the pole" {
    Time 2 minutes.
    Requires able(actor) and at(actor, site) and probeable(target) and reaches(actor, target) and not benighted(actor)
      and equippedFor(actor, prodding) and not tried(target, prodding).
    On success { Assert tried(target, prodding). }
    Result "You prod {target} with the pole, from as far off as it allows.".
  }
  Action pry(actor: group, target: entity, site: place) "Pry at {target} with the bar" {
    Time 3 minutes.
    Requires able(actor) and at(actor, site) and probeable(target) and reaches(actor, target) and not benighted(actor)
      and equippedFor(actor, prying) and not tried(target, prying).
    On success { Assert tried(target, prying). }
    Result "You get the bar into {target} and lean on it.".
  }
  Action burn(actor: group, target: entity, site: place) "Hold a flame to {target}" {
    Time 2 minutes.
    Requires able(actor) and at(actor, site) and probeable(target) and reaches(actor, target)
      and equippedFor(actor, burning) and not tried(target, burning).
    On success { Assert tried(target, burning). }
    Result "You hold a flame to {target}.".
  }
  Action push(actor: group, target: entity, site: place) "Push and pull at {target}" {
    Time 2 minutes.
    Requires able(actor) and at(actor, site) and probeable(target) and reaches(actor, target) and not benighted(actor)
      and not tried(target, pushing).
    On success { Assert tried(target, pushing). }
    Result "You push at {target}, then pull.".
  }
  Action listen(actor: group, target: entity, site: place) "Listen at {target}" {
    Time 2 minutes.
    Requires able(actor) and at(actor, site) and probeable(target) and reaches(actor, target) and not benighted(actor)
      and not tried(target, listening).
    On success { Assert tried(target, listening). }
    Result "You put an ear to {target}, and hold your breath.".
  }
}
