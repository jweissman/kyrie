Module dominion "Who holds what, how a power stands toward a company, and how its agents go about the land" {
  Kind byway.
  Relation holds(group, place). Relation keeps(group, entity). Relation covets(group, entity).
  Relation bywayFrom(byway, place). Relation bywayTo(byway, place). Measure bywayTime(byway).
  Relation knowsWay(group, byway). Relation travelling(group, byway).
  Query keepsKind(g: group, k: itemkind) means keeps(g, ?i) and itemKind(?i, k).
  // How a power stands toward a company, kept by the power and obeyed by everyone who serves it: alarmed when
  // something has gone wrong in what it holds; admitting a company to come and go; or hostile to it on sight.
  Relation alarmed(group). Relation admits(group, group). Relation hostile(group, group).
  Rule admitted when admits(?power, ?company) and serves(?member, ?power) and not tolerates(?member, ?company)
    and not hostile(?power, ?company) { Assert tolerates(?member, ?company). }
  Rule turned when hostile(?power, ?company) and serves(?member, ?power) and tolerates(?member, ?company) {
    Retract tolerates(?member, ?company).
  }
  Rule unadmitted when hostile(?power, ?company) and admits(?power, ?company) { Retract admits(?power, ?company). }
  // Who takes a toll where: a collector standing on a road. A road nobody tolls is open; trade on it moves.
  Relation tolls(group, place).
  // Where a power buys on credit, and what it owes there.
  Relation credit(group, group). Measure owes(group, group).
  // What raiders, tithe-takers and foragers have taken from a place.
  Measure losses(place).
  // A stronghold its holder has left. A power that covets it sends the band it posts, by night, and holds it.
  Relation vacant(place). Relation posts(group, group).
  Rule seized when vacant(?site) and covets(?power, ?site) and posts(?band, ?power) and able(?power) and able(?band)
    and untilLight(clock) == 1 {
    Retract vacant(?site). Assert holds(?power, ?site). Assert at(?band, ?site).
  }
  Goal false.
  Action depart(actor: group, way: byway, origin: place, destination: place) "Set out by {way} toward {destination}" {
    Description "Someone who knows the land's old ways leaves for a distant place, and is out of sight until they arrive.".
    Requires able(actor) and knowsWay(actor, way) and at(actor, origin) and bywayFrom(way, origin)
      and bywayTo(way, destination).
    On success { Retract at(actor, origin). Assert travelling(actor, way). }
  }
  Action arrive(actor: group, way: byway, destination: place) "Come by {way} to {destination}" {
    Requires travelling(actor, way) and bywayTo(way, destination).
    Time bywayTime(way).
    On success { Retract travelling(actor, way). Assert at(actor, destination). }
  }
}
