Module world_services "Lodging, goods and camping" {
  Kind service. Kind servicekind.
  Entity lodging: servicekind "Lodging". Entity healing: servicekind "Healing". Entity passage_fare: servicekind "Passage".
  Entity raising: servicekind "Raising the dead".
  Relation offers(group, service). Relation serviceOf(service, servicekind). Relation sells(group, good).
  Measure fee(service). Measure goodsPrice(group, good).
  Goal false.
  // A host who owes the company a night for what it did (it brought up what a deep site's makers died for) keeps it
  // as a guest once: the next bed and supper are on the house. (Not "guest": an adventure of its own may say that.)
  Relation onTheHouse(group, group).
  Action take_lodging(actor: group, host: group, service: service, site: place) "Take {service} from {host}" {
    Requires able(actor) and able(host) and distinct(actor, host) and at(actor, site) and at(host, site)
      and not refusesService(host, actor) and not onTheHouse(host, actor) and offers(host, service)
      and serviceOf(service, lodging) and quantity(actor, gold) >= fee(service).
    Time untilMorning(clock). Resolve recover(actor).
    On success { Decrease quantity(actor, gold) by fee(service). Increase quantity(host, gold) by fee(service).
      Retract hungry(actor). Increase nextMeal(actor) by 144.
      Set lastSlept(actor) to watch(clock) + untilMorning(clock). Retract weary(actor). }
    Result "You eat what is put in front of you, and sleep long, under a roof.".
  }
  Action take_lodging_guest(actor: group, host: group, service: service, site: place) "Take {service} from {host}, on the house" {
    Requires able(actor) and able(host) and distinct(actor, host) and at(actor, site) and at(host, site)
      and onTheHouse(host, actor) and offers(host, service) and serviceOf(service, lodging).
    Time untilMorning(clock). Resolve recover(actor).
    On success { Retract onTheHouse(host, actor). Retract hungry(actor). Increase nextMeal(actor) by 144.
      Set lastSlept(actor) to watch(clock) + untilMorning(clock). Retract weary(actor). }
    Result "You eat what is put in front of you, and sleep long, under a roof, and nobody will take your coin.".
  }
  Action take_healing(actor: group, healer: group, service: service, site: place) "Ask {healer} for {service}" {
    Requires able(actor) and able(healer) and distinct(actor, healer) and at(actor, site) and at(healer, site)
      and not refusesService(healer, actor) and offers(healer, service) and serviceOf(service, healing) and quantity(actor, gold) >= fee(service).
    Time 6. Resolve recover(actor).
    On success { Decrease quantity(actor, gold) by fee(service). Increase quantity(healer, gold) by fee(service). }
    Result "{healer} cleans and dresses every wound in the company.".
  }
  // A priest who can call the dead back (Orsino's Raise Dead) does it at the shrine, for a great price, through a
  // night's vigil: the companion comes back weak, with half their health, and what killed them gone.
  Action take_raising(actor: group, healer: group, service: service, lost: member, site: place) "Ask {healer} to raise {lost} from the dead" {
    Description "A long vigil at the shrine, a night's worth of hours, and the price of it. They come back with half their health.".
    Requires able(actor) and able(healer) and distinct(actor, healer) and at(actor, site) and at(healer, site)
      and not refusesService(healer, actor) and offers(healer, service) and serviceOf(service, raising)
      and memberOf(lost, actor) and fallen(lost) and quantity(actor, gold) >= fee(service).
    Time untilMorning(clock). Resolve raise(lost).
    On success { Decrease quantity(actor, gold) by fee(service). Increase quantity(healer, gold) by fee(service). }
    Result "{healer} keeps the vigil over {lost} through the long hours, and at the end of them {lost} draws a breath, and then another.".
  }
  Action buy_goods(actor: group, seller: group, goods: good, site: place) "Buy one {goods} from {seller}" {
    Time 3 minutes.
    Requires able(actor) and able(seller) and distinct(actor, seller) and at(actor, site) and at(seller, site)
      and not refusesService(seller, actor) and sells(seller, goods) and quantity(seller, goods) >= 1 and quantity(actor, gold) >= goodsPrice(seller, goods).
    On success { Decrease quantity(actor, gold) by goodsPrice(seller, goods). Increase quantity(seller, gold) by goodsPrice(seller, goods).
      Decrease quantity(seller, goods) by 1. Increase quantity(actor, goods) by 1. }
    Result "{seller} counts the coins and hands over a {goods}.".
  }
  // Where a night in the open costs something (the cold on a pass, after dark), and what: the camp says so before it
  // is made (see Exposure).
  Relation unsheltered(place, entity).
  Action camp(actor: group, site: place) "Make camp at {site}" {
    Requires able(actor) and at(actor, site) and not indoors(site) and not settled(site) and not hungry(actor).
    Time untilMorning(clock). Resolve rough(actor). Interrupted when threatened(actor).
    On success { Set lastSlept(actor) to watch(clock). Retract weary(actor). }
    Result "You find what shelter there is, and sleep as well as you can, with one ear open.".
  }
}
