Module world_people "Company and intention" {
  Relation acceptsEscort(group, group). Relation dismissed(group, group).
  // Someone taken from home: who set them free, where home is, and what their people will give whoever brings them
  // back. Brought home by a company they are home, and grateful to it, and the thanks are paid.
  Relation freedBy(group, group). Relation home(group, place). Relation cameHome(group). Relation grateful(group, group).
  Measure thanks(group).
  Rule brought_home when following(?person, ?company) and home(?person, ?place) and at(?person, ?place)
    and not cameHome(?person) {
    Retract following(?person, ?company). Assert cameHome(?person). Assert grateful(?person, ?company).
    Increase quantity(?company, gold) by thanks(?person).
  }
  // Who someone is to the one who plays: family (kin), or someone expecting them with a letter or an errand (expects);
  // what they owe someone is dominion's owes. An origin says so at the outset; what people say and do follows it.
  Relation kin(group, group). Relation expects(group, group).
  // Someone who would join the company, once they are willing, for their hire (which may be nothing); and whoever has
  // joined it, who goes where it goes and can be talked to on the way.
  Relation willing(group, group). Measure hire(group). Relation travelsWith(group, group).
  // A traveller of the country who has joined (a fellow, as against the one who plays): how much of their own story
  // they have told, and whether they have told some tonight. A story is told a part a night.
  Relation fellow(member). Measure confided(group). Relation hushed(group).
  // What someone says on joining the company, or leaving it, in their own words (Joins, Leaves): said instead of the
  // voice tables' (data/voice/join.json, part.json), which speak by what they are to the one who plays.
  Relation joining(group, entity). Relation parting(group, entity).
  Rule hush_lifts when hushed(?c) and not dark() { Retract hushed(?c). }
  Goal false.
  Action recruit(actor: group, recruit: group, site: place) "Ask {recruit} to join the company" {
    Description "They come with you from now on: they fight beside you, and what they can do, you can.".
    Requires able(actor) and company(actor) and able(recruit) and distinct(actor, recruit) and at(actor, site)
      and at(recruit, site) and willing(recruit, actor) and quantity(actor, gold) >= hire(recruit).
    Resolve enlist(recruit, actor).
    On success { Decrease quantity(actor, gold) by hire(recruit). Retract willing(recruit, actor). Retract at(recruit, site).
      Assert travelsWith(recruit, actor). }
  }
  Action lead(actor: group, companion: group, site: place) "Ask {companion} to come with you" {
    Requires able(actor) and able(companion) and distinct(actor, companion) and at(actor, site)
      and at(companion, site) and acceptsEscort(companion, actor) and not following(companion, actor).
    On success { Assert following(companion, actor). Retract dismissed(companion, actor). }
  }
  Action part_ways(actor: group, companion: group, site: place) "Let {companion} make their own way" {
    Requires able(actor) and able(companion) and at(actor, site) and at(companion, site)
      and acceptsEscort(companion, actor) and not dismissed(companion, actor) and not hobbled(companion).
    On success { Retract following(companion, actor). Assert dismissed(companion, actor). }
  }
}
