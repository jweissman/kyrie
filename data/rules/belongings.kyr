Module belongings "What the company carries" {
  Kind item. Kind itemkind.
  Relation itemKind(item, itemkind). Relation ownedItem(item, member). Relation wearing(item, member).
  Relation forSale(item). Relation soldBy(item, group) exclusive. Relation wearable(itemkind). Relation consumable(itemkind).
  // What could be used on a member to any end: a remedy for a hurt or an ill they have, a light while they carry none
  // burning, or a draught for what it does.
  Relation relieves(member, itemkind).
  // What is used by lighting it, on whoever carries it (a torch, a candle); what burns in something else, and what
  // it burns in (lamp oil, in a lantern).
  Relation lightsUp(itemkind). Relation burns(itemkind, itemkind). Relation fuel(itemkind).
  Relation canTrain(member, ability). Relation teaches(group, ability).
  Relation proficient(member, itemkind).
  Relation wants(group, itemkind). Measure pays(group, itemkind).
  // What a kind of thing is worth (its catalog value), and those who deal in valuables: a merchant who buys any
  // treasure brought in, at its worth, if they have the coin (as Orsino's shops buy junk). Treasure brought home and
  // sold is the company's experience, the first time it is sold: its worth, to each who brought it.
  Measure worth(itemkind). Relation buysValuables(group). Relation realized(item). Relation valuable(itemkind).
  // What a kind of thing weighs, where it says (a module's own kind, "weighing 2"); selm weighs less than nothing.
  Measure mass(itemkind).
  // What each member carries, and can carry (see Burden): a company with anyone carrying more is laden, and goes
  // slowly, at half its pace.
  Measure carried(member). Measure capacity(member).
  Query laden(a: group) means memberOf(?m, a) and carried(?m) > capacity(?m).
  Relation weighed(group).
  Rule laden_felt when laden(?a) and company(?a) and not weighed(?a)
    says "What you carry drags at you: you will go at half your pace until you set something down." { Assert weighed(?a). }
  Rule laden_eased when weighed(?a) and not laden(?a) says "You go easier for what you have set down." { Retract weighed(?a). }
  // How fast a member goes, in hundredths of their own, where a module says (the stilling: half at a point of dose);
  // unset is their own. A company walks at its slowest member's speed, and laden at half that.
  Measure speed(member).
  // How much coin a dealer keeps in the house: what they pay out, trade brings back by the next morning.
  Measure purse(group). Relation appraised(item, group).
  Rule purse_refilled when untilLight(clock) == 1 and buysValuables(?m) and purse(?m) > quantity(?m, gold) {
    Set quantity(?m, gold) to purse(?m).
  }
  // Whose a thing is, and to whom they have lent it. An owner, or one who serves them, who sees the company with it
  // unlent (awake, and there to see it), says so once, in their own words if they have them ("Objects" in a person),
  // and is not the company's friend after. One asleep sees nothing.
  Relation owns(group, item). Relation lends(group, item, group). Relation objected(group, item).
  Relation objection(group, entity).
  Query unlent(o: group, i: item, c: group) means carries(c, i) and not lends(o, i, c) and not objected(o, i).
  Rule owner_objects when owns(?o, ?i) and company(?c) and unlent(?o, ?i, ?c) and perceives(?o, ?c)
    and not objection(?o, ?w) says "{?o} sees {?i} in your hands. 'That is mine.'" {
    Assert objected(?o, ?i). Assert hostile(?o, ?c).
  }
  Rule owner_objects_aloud when owns(?o, ?i) and company(?c) and unlent(?o, ?i, ?c) and perceives(?o, ?c)
    and objection(?o, ?w) says "{?w}" { Assert objected(?o, ?i). Assert hostile(?o, ?c). }
  Rule servant_objects when owns(?o, ?i) and company(?c) and unlent(?o, ?i, ?c) and serves(?s, ?o) and perceives(?s, ?c)
    and not objection(?s, ?w) says "{?s} sees {?i} in your hands, and goes to tell {?o}." {
    Assert objected(?o, ?i). Assert hostile(?o, ?c).
  }
  Rule servant_objects_aloud when owns(?o, ?i) and company(?c) and unlent(?o, ?i, ?c) and serves(?s, ?o)
    and perceives(?s, ?c) and objection(?s, ?w) says "{?w}" { Assert objected(?o, ?i). Assert hostile(?o, ?c). }
  Measure price(item).
  // How many of a kind a seller has out for sale. What is used up (a torch, a flask of oil) comes back to the shelf:
  // each dawn whatever of theirs has been bought and spent is set out again, up to what they began with.
  Measure shelf(group, itemkind).
  Goal false.
  Action take_item(actor: group, find: item, form: itemkind, recipient: member, site: place) "Collect {find} for {recipient}" {
    Time 1 minute.
    Requires able(actor) and at(actor, site) and at(find, site) and not forSale(find) and not benighted(actor)
      and itemKind(find, form) and memberOf(recipient, actor) and awake(recipient) and noticed(find, actor).
    Resolve acquire(find, form, recipient).
    On success { Retract at(find, site). }
    Result "{recipient} takes {find}.".
  }
  Action take_out(actor: group, find: item, form: itemkind, box: thing, recipient: member, site: place) "Take {find} out of {box} for {recipient}" {
    Time 1 minute.
    Requires able(actor) and at(actor, site) and at(box, site) and inside(find, box) and not shut(box)
      and noticed(box, actor) and noticed(find, actor) and not benighted(actor)
      and itemKind(find, form) and memberOf(recipient, actor) and awake(recipient).
    Resolve acquire(find, form, recipient).
    On success { Retract inside(find, box). }
    Result "{recipient} takes {find} from {box}.".
  }
  Action put_in(actor: group, cargo: item, carrier: member, box: thing, site: place) "Put {cargo} in {box}" {
    Time 1 minute.
    Description "Set it in, on or into the thing, where it stays until someone takes it out.".
    Requires able(actor) and at(actor, site) and at(box, site) and receptacle(box) and not shut(box)
      and noticed(box, actor) and not benighted(actor)
      and memberOf(carrier, actor) and awake(carrier) and ownedItem(cargo, carrier).
    Resolve drop(cargo, carrier).
    On success { Assert inside(cargo, box). }
    Result "{carrier} puts {cargo} in {box}.".
  }
  Action buy_item(actor: group, find: item, form: itemkind, recipient: member, merchant: group, site: place) "Buy {find} for {recipient}" {
    Time 3 minutes.
    Requires able(actor) and at(actor, site) and at(find, site) and forSale(find) and itemKind(find, form)
      and memberOf(recipient, actor) and awake(recipient) and soldBy(find, merchant)
      and able(merchant) and not refusesService(merchant, actor) and at(merchant, site) and distinct(actor, merchant) and quantity(actor, gold) >= price(find).
    Resolve purchase(find, form, recipient, actor, merchant).
    On success { Retract at(find, site). Retract forSale(find). Decrease shelf(merchant, form) by 1. }
    Result "{recipient} pays {merchant}, and takes {find}.".
  }
  Action equip_item(actor: group, tool: item, form: itemkind, wearer: member) "Equip {tool} on {wearer}" {
    Time 2 minutes.
    Requires able(actor) and memberOf(wearer, actor) and awake(wearer) and ownedItem(tool, wearer)
      and itemKind(tool, form) and wearable(form) and proficient(wearer, form) and not wearing(tool, wearer).
    Resolve equip(tool, wearer).
    Result "{wearer} readies {tool}.".
  }
  Action use_item(actor: group, dose: item, form: itemkind, carrier: member, recipient: member) "Use {dose} on {recipient}" {
    Time 2 minutes.
    Requires able(actor) and memberOf(carrier, actor) and memberOf(recipient, actor) and awake(carrier)
      and awake(recipient) and ownedItem(dose, carrier) and itemKind(dose, form) and consumable(form) and not lightsUp(form)
      and not fuel(form) and relieves(recipient, form).
    Resolve consume(dose, carrier, recipient).
  }
  Action light_item(actor: group, dose: item, form: itemkind, carrier: member) "Light {dose}" {
    Time 1 minute.
    Requires able(actor) and memberOf(carrier, actor) and awake(carrier) and ownedItem(dose, carrier)
      and itemKind(dose, form) and lightsUp(form) and relieves(carrier, form).
    Resolve consume(dose, carrier, carrier).
    Result "{carrier} lights {dose}.".
  }
  // A lantern is filled and lit: the flask of oil is spent, and burns in it as long as the flask says.
  Action light_lamp(actor: group, dose: item, form: itemkind, vessel: item, shape: itemkind, carrier: member) "Fill {vessel} from {dose} and light it" {
    Time 2 minutes.
    Requires able(actor) and memberOf(carrier, actor) and awake(carrier) and ownedItem(vessel, carrier)
      and itemKind(vessel, shape) and burns(shape, form) and ownedItem(dose, carrier) and itemKind(dose, form)
      and relieves(carrier, form).
    Resolve consume(dose, carrier, carrier).
    Result "{carrier} fills {vessel} and lights it.".
  }
  Action transfer_item(actor: group, cargo: item, carrier: member, recipient: member) "Give {cargo} to {recipient}" {
    Time 1 minute.
    Requires able(actor) and memberOf(carrier, actor) and memberOf(recipient, actor) and awake(carrier)
      and not ownedItem(cargo, recipient) and awake(recipient) and ownedItem(cargo, carrier).
    Resolve transfer_item(cargo, carrier, recipient).
    Result "{carrier} hands {cargo} to {recipient}.".
  }
  // What a companion who has fallen, or cannot stir, was carrying, the others can take.
  Action take_from(actor: group, cargo: item, carrier: member, recipient: member) "Take {cargo} from {carrier} for {recipient}" {
    Time 1 minute.
    Requires able(actor) and memberOf(carrier, actor) and memberOf(recipient, actor) and not awake(carrier)
      and awake(recipient) and ownedItem(cargo, carrier).
    Resolve transfer_item(cargo, carrier, recipient).
    Result "{recipient} takes {cargo} from {carrier}.".
  }
  Action give(actor: group, gift: item, form: itemkind, carrier: member, recipient: group, site: place) "Give {gift} to {recipient}" {
    Time 1 minute.
    Description "Hand it to someone who has asked for it, or will take it. What they do with it is theirs to decide.".
    Requires able(actor) and at(actor, site) and able(recipient) and at(recipient, site) and distinct(actor, recipient)
      and memberOf(carrier, actor) and awake(carrier) and ownedItem(gift, carrier) and itemKind(gift, form)
      and wants(recipient, form).
    Resolve drop(gift, carrier).
    On success { Assert keeps(recipient, gift). }
    Result "{carrier} gives {gift} to {recipient}.".
  }
  // What was taken in front of its owner can be handed back: they will not forget it, but they need not fight for it.
  Action give_back(actor: group, gift: item, carrier: member, owner: group, site: place) "Give {gift} back to {owner}" {
    Time 1 minute.
    Description "Hand back what is theirs. They will remember it was taken; they need not fight you for it.".
    Requires able(actor) and at(actor, site) and able(owner) and at(owner, site) and memberOf(carrier, actor)
      and awake(carrier) and ownedItem(gift, carrier) and owns(owner, gift) and objected(owner, gift).
    Resolve drop(gift, carrier).
    On success { Assert keeps(owner, gift). Retract hostile(owner, actor). }
    Result "{carrier} holds out {gift}, and {owner} takes it back without a word.".
  }
  Action sell(actor: group, ware: item, form: itemkind, carrier: member, buyer: group, site: place) "Sell {ware} to {buyer}" {
    Time 3 minutes.
    Description "Someone who buys this kind of thing pays what they said they would, if they have the coin.".
    Requires able(actor) and at(actor, site) and able(buyer) and at(buyer, site) and distinct(actor, buyer)
      and memberOf(carrier, actor) and awake(carrier) and ownedItem(ware, carrier) and itemKind(ware, form)
      and pays(buyer, form) >= 1 and quantity(buyer, gold) >= pays(buyer, form) and not refusesService(buyer, actor).
    Resolve realize(ware, carrier, actor).
    On success { Assert keeps(buyer, ware). Assert realized(ware). Decrease quantity(buyer, gold) by pays(buyer, form).
      Increase quantity(actor, gold) by pays(buyer, form). }
    Result "{buyer} takes {ware}, and counts out the coin for it.".
  }
  Action sell_valuable(actor: group, ware: item, form: itemkind, carrier: member, buyer: group, site: place) "Sell {ware} to {buyer}" {
    Time 3 minutes.
    Description "Someone who deals in valuables pays what a thing is worth, if they have the coin. The first time a treasure is sold, what it is worth is experience for each of the company.".
    Requires able(actor) and at(actor, site) and able(buyer) and at(buyer, site) and distinct(actor, buyer)
      and memberOf(carrier, actor) and awake(carrier) and ownedItem(ware, carrier) and itemKind(ware, form)
      and buysValuables(buyer) and valuable(form) and worth(form) >= 1 and pays(buyer, form) < 1
      and quantity(buyer, gold) >= worth(form) and not refusesService(buyer, actor).
    Resolve realize(ware, carrier, actor).
    On success { Assert keeps(buyer, ware). Assert realized(ware). Decrease quantity(buyer, gold) by worth(form).
      Increase quantity(actor, gold) by worth(form). }
    Result "{buyer} turns {ware} over in the light, names a price, and counts out the coin.".
  }
  // A dealer without the coin for a treasure still says what it is worth, and whether to wait or go elsewhere.
  Action appraise(actor: group, ware: item, form: itemkind, carrier: member, buyer: group, site: place) "Show {ware} to {buyer}" {
    Time 2 minutes.
    Description "Someone who deals in valuables says what a thing is worth, when they have not the coin for it.".
    Requires able(actor) and at(actor, site) and able(buyer) and at(buyer, site) and distinct(actor, buyer)
      and memberOf(carrier, actor) and awake(carrier) and ownedItem(ware, carrier) and itemKind(ware, form)
      and buysValuables(buyer) and valuable(form) and worth(form) >= 1 and pays(buyer, form) < 1
      and quantity(buyer, gold) < worth(form) and purse(buyer) >= worth(form) and not appraised(ware, buyer)
      and not refusesService(buyer, actor).
    On success { Assert appraised(ware, buyer). }
    Result "{buyer} turns {ware} over in the light, and hands it back. 'Worth {worth(form)} coin, that. I have not got it in the house today; come back in the morning.'".
  }
  Action appraise_beyond(actor: group, ware: item, form: itemkind, carrier: member, buyer: group, site: place) "Show {ware} to {buyer}" {
    Time 2 minutes.
    Description "Someone who deals in valuables says what a thing is worth, when it is worth more than they ever have.".
    Requires able(actor) and at(actor, site) and able(buyer) and at(buyer, site) and distinct(actor, buyer)
      and memberOf(carrier, actor) and awake(carrier) and ownedItem(ware, carrier) and itemKind(ware, form)
      and buysValuables(buyer) and valuable(form) and worth(form) >= 1 and pays(buyer, form) < 1
      and purse(buyer) < worth(form) and not appraised(ware, buyer) and not refusesService(buyer, actor).
    On success { Assert appraised(ware, buyer). }
    Result "{buyer} turns {ware} over in the light for a long time, and hands it back. 'Worth {worth(form)} coin, that, and there is not that much in this place. Take it to a town.'".
  }
  Action put_item(actor: group, cargo: item, carrier: member, site: place) "Set down {cargo}" {
    Time 1 minute.
    Requires able(actor) and at(actor, site) and memberOf(carrier, actor) and awake(carrier) and ownedItem(cargo, carrier).
    Resolve drop(cargo, carrier).
    On success { Assert at(cargo, site). }
    Result "{carrier} sets {cargo} down.".
  }
  Action train_member(actor: group, mentor: group, student: member, lesson: ability, site: place) "Train {student} in {lesson}" {
    Requires able(actor) and able(mentor) and distinct(actor, mentor) and at(actor, site) and at(mentor, site)
      and memberOf(student, actor) and awake(student) and teaches(mentor, lesson) and canTrain(student, lesson).
    Resolve train(lesson, student).
    Time 6.
    Result "{mentor} spends an hour drilling {student} in {lesson}.".
  }
}
