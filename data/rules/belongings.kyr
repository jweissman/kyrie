Module belongings "What the company carries" {
  Kind item. Kind itemkind.
  Relation itemKind(item, itemkind). Relation ownedItem(item, member). Relation wearing(item, member).
  Relation forSale(item). Relation soldBy(item, group) exclusive. Relation wearable(itemkind). Relation consumable(itemkind).
  Relation canTrain(member, ability). Relation teaches(group, ability).
  Relation proficient(member, itemkind).
  Relation wants(group, itemkind). Measure pays(group, itemkind).
  Measure price(item).
  Goal false.
  Action take_item(actor: group, find: item, form: itemkind, recipient: member, site: place) "Collect {find} for {recipient}" {
    Requires able(actor) and at(actor, site) and at(find, site) and not forSale(find) and not benighted(actor)
      and itemKind(find, form) and memberOf(recipient, actor) and awake(recipient).
    Resolve acquire(find, form, recipient).
    On success { Retract at(find, site). }
    Result "{recipient} takes {find}.".
  }
  Action buy_item(actor: group, find: item, form: itemkind, recipient: member, merchant: group, site: place) "Buy {find} for {recipient}" {
    Requires able(actor) and at(actor, site) and at(find, site) and forSale(find) and itemKind(find, form)
      and memberOf(recipient, actor) and awake(recipient) and soldBy(find, merchant)
      and able(merchant) and not refusesService(merchant, actor) and at(merchant, site) and distinct(actor, merchant) and quantity(actor, gold) >= price(find).
    Resolve purchase(find, form, recipient, actor, merchant).
    On success { Retract at(find, site). Retract forSale(find). }
    Result "{merchant} takes the money and hands {find} to {recipient}.".
  }
  Action equip_item(actor: group, tool: item, form: itemkind, wearer: member) "Equip {tool} on {wearer}" {
    Requires able(actor) and memberOf(wearer, actor) and awake(wearer) and ownedItem(tool, wearer)
      and itemKind(tool, form) and wearable(form) and proficient(wearer, form) and not wearing(tool, wearer).
    Resolve equip(tool, wearer).
    Result "{wearer} readies {tool}.".
  }
  Action use_item(actor: group, dose: item, form: itemkind, carrier: member, recipient: member) "Use {dose} on {recipient}" {
    Requires able(actor) and memberOf(carrier, actor) and memberOf(recipient, actor) and awake(carrier)
      and awake(recipient) and ownedItem(dose, carrier) and itemKind(dose, form) and consumable(form).
    Resolve consume(dose, carrier, recipient).
    Result "{carrier} uses {dose}.".
  }
  Action transfer_item(actor: group, cargo: item, carrier: member, recipient: member) "Give {cargo} to {recipient}" {
    Requires able(actor) and memberOf(carrier, actor) and memberOf(recipient, actor)
      and not ownedItem(cargo, recipient) and awake(recipient) and ownedItem(cargo, carrier).
    Resolve transfer_item(cargo, carrier, recipient).
    Result "{carrier} hands {cargo} to {recipient}.".
  }
  Action give(actor: group, gift: item, form: itemkind, carrier: member, recipient: group, site: place) "Give {gift} to {recipient}" {
    Description "Hand it to someone who has asked for it, or will take it. What they do with it is theirs to decide.".
    Requires able(actor) and at(actor, site) and able(recipient) and at(recipient, site) and distinct(actor, recipient)
      and memberOf(carrier, actor) and awake(carrier) and ownedItem(gift, carrier) and itemKind(gift, form)
      and wants(recipient, form).
    Resolve drop(gift, carrier).
    On success { Assert keeps(recipient, gift). }
    Result "{carrier} gives {gift} to {recipient}.".
  }
  Action sell(actor: group, ware: item, form: itemkind, carrier: member, buyer: group, site: place) "Sell {ware} to {buyer}" {
    Description "Someone who buys this kind of thing pays what they said they would, if they have the coin.".
    Requires able(actor) and at(actor, site) and able(buyer) and at(buyer, site) and distinct(actor, buyer)
      and memberOf(carrier, actor) and awake(carrier) and ownedItem(ware, carrier) and itemKind(ware, form)
      and pays(buyer, form) >= 1 and quantity(buyer, gold) >= pays(buyer, form) and not refusesService(buyer, actor).
    Resolve drop(ware, carrier).
    On success { Assert keeps(buyer, ware). Decrease quantity(buyer, gold) by pays(buyer, form).
      Increase quantity(actor, gold) by pays(buyer, form). }
    Result "{buyer} pays for {ware}.".
  }
  Action put_item(actor: group, cargo: item, carrier: member, site: place) "Set down {cargo}" {
    Requires able(actor) and at(actor, site) and memberOf(carrier, actor) and awake(carrier) and ownedItem(cargo, carrier).
    Resolve drop(cargo, carrier).
    On success { Assert at(cargo, site). }
    Result "{carrier} sets {cargo} down.".
  }
  Action train_member(actor: group, mentor: group, student: member, lesson: ability, site: place) "Train {student} in {lesson}" {
    Requires able(actor) and able(mentor) and distinct(actor, mentor) and at(actor, site) and at(mentor, site)
      and memberOf(student, actor) and awake(student) and teaches(mentor, lesson) and canTrain(student, lesson).
    Resolve train(lesson, student).
    Time 6.
    Result "{mentor} spends an hour drilling {student} in {lesson}.".
  }
}
