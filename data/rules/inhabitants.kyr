Module inhabitants "How creatures that live somewhere answer those who come into it" {
  // A creature's temperament says how it meets a company that comes where it lives. A territorial one warns, then
  // falls on whoever stays; a defensive one warns, and fights only for its lair; a proud one names a price; a savage
  // one falls on you at once; one that lies in ambush strikes unless keen eyes spot it first; an obedient one keeps
  // its post and nothing else; a wary one slinks away, and fights only when cornered in its refuge. A group of one
  // species takes its species' temperament; a place may give any group one (temper_savage, temper_proud…).
  Kind temperament.
  Entity temper_territorial: temperament "territorial". Entity temper_defensive: temperament "defensive".
  Entity temper_wary: temperament "wary". Entity temper_ambush: temperament "ambush".
  Entity temper_proud: temperament "proud".
  Entity temper_obedient: temperament "obedient". Entity temper_savage: temperament "savage".
  // A tame creature (a dog, a horse, a cat about a house) knows people: it comes to see who you are, and lets you
  // make much of it.
  Entity temper_tame: temperament "tame".
  Relation temperament(group, temperament).
  // Where it lives and what it defends; where it goes when beaten or frightened off.
  Relation lair(group, place). Relation refuge(group, place).
  // What it does, in the place's own words: its warning, its onslaught, what makes it flinch, how it yields.
  Relation warning(group, entity). Relation onslaught(group, entity). Relation flinch(group, entity).
  Relation plea(group, entity). Relation greeting(group, entity).
  Relation greeted(group, group). Relation petted(group, group).
  // What drives it off (sunlight, flame), and the price a proud one names.
  Relation fears(group, capability). Measure tribute(group).
  Relation warned(group, group). Relation yielded(group, group).
  // Plain words for a creature whose place gives it none, by temperament: temper_words_<temperament>_<what>.
  Entity temper_words_territorial_warning: fact "{?g} stands its ground and watches you. It will not have you here for long.".
  Entity temper_words_territorial_onslaught: fact "{?g} comes at you.".
  Entity temper_words_defensive_warning: fact "{?g} will not let you come any nearer.".
  Entity temper_words_defensive_onslaught: fact "{?g} comes at you to drive you off.".
  Entity temper_words_savage_onslaught: fact "{?g} comes at you without a sound.".
  Entity temper_words_ambush_warning: fact "Something is waiting here, and you see it before it moves: {?g}.".
  Entity temper_words_ambush_onslaught: fact "{?g} springs out at you.".
  Entity temper_words_obedient_onslaught: fact "{?g} comes at you, as it was made to.".
  Entity temper_words_wary_flinch: fact "{?g} slips away from you.".
  Entity temper_words_wary_onslaught: fact "Cornered, {?g} turns on you.".
  Entity temper_words_proud_warning: fact "{?g} looks at you as if you owed it something.".
  // The same words for a band of more than one, where they differ.
  Entity temper_words_territorial_warning_many: fact "{?g} stand their ground and watch you. They will not have you here for long.".
  Entity temper_words_territorial_onslaught_many: fact "{?g} come at you.".
  Entity temper_words_defensive_onslaught_many: fact "{?g} come at you to drive you off.".
  Entity temper_words_savage_onslaught_many: fact "{?g} come at you without a sound.".
  Entity temper_words_ambush_warning_many: fact "Something is waiting here, and you see them before they move: {?g}.".
  Entity temper_words_ambush_onslaught_many: fact "{?g} spring out at you.".
  Entity temper_words_obedient_onslaught_many: fact "{?g} come at you, as they were made to.".
  Entity temper_words_wary_flinch_many: fact "{?g} slip away from you.".
  Entity temper_words_wary_onslaught_many: fact "Cornered, {?g} turn on you.".
  Entity temper_words_proud_warning_many: fact "{?g} look at you as if you owed them something.".
  // The watch it waits until, once it has warned, before it comes at whoever stays: the rest of this one, however
  // many small things are done in it.
  Measure patience(group).
  Query confronts(g: group, c: group) means together(g, c) and company(c) and able(g) and not routed(g)
    and not tolerates(g, c) and not assails(g, c).

  // Fear comes first: whatever it fears, brought into its presence, drives it back to its refuge.
  Rule temper_shies when fears(?g, ?k) and company(?c) and together(?g, ?c) and capable(?c, ?k) and able(?g)
    and refuge(?g, ?r) and not at(?g, ?r) and flinch(?g, ?f) says "{?f}" {
    Assert at(?g, ?r). Retract assails(?g, ?c). Retract warned(?g, ?c).
  }
  // Beaten, it may beg; then it goes back to its refuge, and comes out again the next day.
  Rule temper_yields when routed(?g) and company(?c) and together(?g, ?c) and able(?g) and plea(?g, ?p)
    and not yielded(?g, ?c) says "{?p}" {
    Assert yielded(?g, ?c). Assert tolerates(?g, ?c). Retract assails(?g, ?c).
  }
  Rule temper_falls_back when routed(?g) and refuge(?g, ?r) and not at(?g, ?r) { Assert at(?g, ?r). }
  Rule temper_rallies when routed(?g) and refuge(?g, ?r) and at(?g, ?r) and untilLight(clock) == 1 {
    Retract routed(?g).
  }
  // A warning spent: whoever stayed is fallen on (for a defensive one, only in its lair).
  Rule temper_closes when warned(?g, ?c) and together(?g, ?c) and able(?g) and not routed(?g) and not tolerates(?g, ?c)
    and patience(?g) <= watch(clock) and not temperament(?g, temper_defensive) and onslaught(?g, ?o) says "{?o}" {
    Assert assails(?g, ?c). Retract warned(?g, ?c).
  }
  Rule temper_defends when warned(?g, ?c) and temperament(?g, temper_defensive) and lair(?g, ?l) and at(?c, ?l)
    and at(?g, ?l) and able(?g) and not routed(?g)
    and not tolerates(?g, ?c) and patience(?g) <= watch(clock) and onslaught(?g, ?o) says "{?o}" {
    Assert assails(?g, ?c). Retract warned(?g, ?c).
  }
  Rule temper_let_go when warned(?g, ?c) and not together(?g, ?c) { Retract warned(?g, ?c). }
  // The first meeting: a warning stops the company where it stands, whatever it was doing, and it must answer.
  Rule temper_warns when temperament(?g, ?t) and warnsFirst(?t) and company(?c) and confronts(?g, ?c) and not warned(?g, ?c)
    and warning(?g, ?w) says "{?w}" {
    Assert warned(?g, ?c). Assert halts(?g, ?c). Set patience(?g) to watch(clock) + 1.
  }
  Relation warnsFirst(temperament).
  Initially Assert warnsFirst(temper_territorial). Initially Assert warnsFirst(temper_defensive).
  Initially Assert warnsFirst(temper_proud).
  Rule temper_falls_on when temperament(?g, temper_savage) and company(?c) and confronts(?g, ?c) and onslaught(?g, ?o)
    says "{?o}" {
    Assert assails(?g, ?c).
  }
  Rule temper_springs when temperament(?g, temper_ambush) and company(?c) and confronts(?g, ?c)
    and not capable(?c, perception) and not warned(?g, ?c)
    and onslaught(?g, ?o) says "{?o}" {
    Assert assails(?g, ?c).
  }
  Rule temper_spotted when temperament(?g, temper_ambush) and company(?c) and confronts(?g, ?c)
    and capable(?c, perception) and not warned(?g, ?c)
    and warning(?g, ?w) says "{?w}" {
    Assert warned(?g, ?c). Assert halts(?g, ?c). Set patience(?g) to watch(clock) + 1.
  }
  Rule temper_keeps_post when temperament(?g, temper_obedient) and company(?c) and confronts(?g, ?c)
    and lair(?g, ?p) and at(?g, ?p)
    and onslaught(?g, ?o) says "{?o}" {
    Assert assails(?g, ?c).
  }
  Rule temper_cornered when temperament(?g, temper_wary) and company(?c) and confronts(?g, ?c)
    and refuge(?g, ?r) and at(?g, ?r)
    and onslaught(?g, ?o) says "{?o}" {
    Assert assails(?g, ?c).
  }
  Rule temper_slinks when temperament(?g, temper_wary) and company(?c) and confronts(?g, ?c)
    and refuge(?g, ?r) and not at(?g, ?r)
    and flinch(?g, ?f) says "{?f}" {
    Assert at(?g, ?r).
  }
  // A tame one greets whoever comes, once, if it is awake: in its own words (Greets), or as its kind does
  // (data/voice/greet.json).
  Rule temper_greets when temperament(?g, temper_tame) and company(?c) and together(?g, ?c) and alert(?g)
    and not greeted(?g, ?c) and not hostile(?g, ?c) {
    Assert greeted(?g, ?c). Assert tolerates(?g, ?c).
  }
  Goal false.
  // A tame creature lets itself be made much of, by anyone it has not taken against.
  Action pet(actor: group, animal: group, site: place) "Make much of {animal}" {
    Description "Crouch down, hold out a hand, scratch behind its ears.".
    Requires able(actor) and company(actor) and at(actor, site) and at(animal, site) and temperament(animal, temper_tame)
      and able(animal) and not hostile(animal, actor).
    Time 0.
    On success { Assert petted(animal, actor). Assert tolerates(animal, actor). Assert greeted(animal, actor). }
  }
  // Words instead of blows, for a band that can be spoken to and will hear words (one that warns, or watches from
  // the edge of the light): talked round, it lets the company be; faced down, it gives way. The one of the company best
  // at it speaks, once; it is rolled only when it could go either way. Talked to badly, a band gives you the rest of
  // the watch to be gone, and then comes at you; warned off badly, it comes at you at once.
  Relation hears(temperament). Relation spokenTo(group, group).
  Initially Assert hears(temper_territorial). Initially Assert hears(temper_defensive).
  Initially Assert hears(temper_wary). Initially Assert hears(temper_proud).
  Action talk_round(actor: group, hearers: group, site: place) "Ask {hearers} to let you by" {
    Time 3 minutes.
    Requires able(actor) and company(actor) and at(actor, site) and at(hearers, site) and able(hearers) and talks(hearers)
      and temperament(hearers, ?t) and hears(?t) and not tolerates(hearers, actor) and not assails(hearers, actor)
      and not routed(hearers) and not spokenTo(hearers, actor).
    Resolve check(actor, persuasion, dc_fair).
    On success { Assert spokenTo(hearers, actor). Assert tolerates(hearers, actor). Retract warned(hearers, actor). }
    On failure { Assert spokenTo(hearers, actor). Assert warned(hearers, actor). Set patience(hearers) to watch(clock) + 2. }
    Result "You talk it over with {hearers}, and in the end you are let be.".
    Otherwise "You talk it over with {hearers}, and get nowhere: there will be no more patience for you here.".
  }
  Action face_down(actor: group, hearers: group, site: place) "Warn {hearers} off" {
    Time 2 minutes.
    Requires able(actor) and company(actor) and at(actor, site) and at(hearers, site) and able(hearers) and talks(hearers)
      and temperament(hearers, ?t) and hears(?t) and not tolerates(hearers, actor) and not assails(hearers, actor)
      and not routed(hearers) and not spokenTo(hearers, actor).
    Resolve check(actor, intimidation, dc_hard).
    On success { Assert spokenTo(hearers, actor). Assert tolerates(hearers, actor). Retract warned(hearers, actor). }
    On failure { Assert spokenTo(hearers, actor). Assert assails(hearers, actor). }
    Result "You face {hearers} out, and you are given room.".
    Otherwise "You face {hearers} out, and it goes the wrong way.".
  }
  // A proud creature's price, paid: it lets the company be.
  Action pay_tribute(actor: group, lord: group, site: place) "Give {lord} what it asks" {
    Time 2 minutes.
    Description "A proud creature names a price for letting you pass; paid, it keeps its word.".
    Requires able(actor) and company(actor) and at(actor, site) and at(lord, site) and warned(lord, actor)
      and temperament(lord, temper_proud) and quantity(actor, gold) >= tribute(lord).
    On success {
      Decrease quantity(actor, gold) by tribute(lord). Increase quantity(lord, gold) by tribute(lord).
      Assert tolerates(lord, actor). Retract warned(lord, actor).
    }
    Result "{lord} takes it, and lets you be.".
  }
  // What can be heard from the next room can be drawn out of it, and met where the company waits for it, ready: the
  // first blow is the company's (see Environment). The follow-up review met a banshee as a fight the moment its room
  // was entered, with no say in how. A place says which of its dwellers will come (drawable). The company awaits what
  // it drew out until it is met: once they part, or it can fight no more, the waiting is over.
  Relation drawable(group). Relation awaits(group, group).
  Rule awaiting_over when awaits(?c, ?g) and (not together(?c, ?g) or not able(?g)) { Retract awaits(?c, ?g). }
  Action draw_out(actor: group, lurker: group, whence: place, way: passage, site: place) "Draw out what is in {whence}, and wait for it here" {
    Description "Make a noise at the way in, and step back to meet whatever comes, weapons out.".
    Requires able(actor) and company(actor) and at(actor, site) and drawable(lurker) and able(lurker) and not routed(lurker)
      and at(lurker, whence) and connects(way, whence, site) and visibleTo(way, actor) and passable(way, lurker).
    Time 5 minutes.
    On success { Assert at(lurker, site). Assert awaits(actor, lurker). }
    Result "You make a noise at the way into {whence}, and step back to wait, weapons out. Something comes.".
  }
}
