Module world_making "What a company can make of what it carries" {
  // A way of making one thing of two others one of the company carries (a recipe): willow bark and meadowsweet
  // steeped into a minor potion of healing, dandelion and heather into an antidote, a rag in a flask of lamp oil to
  // throw. What it takes, what it makes, and whether it is a remedy (a mender's work, which can go wrong: the first
  // of what it takes is spoiled) or plain work anyone can do. A recipe is two facts and its entity: add one here, of
  // kinds the catalog has, and it can be made wherever the company has light to work by.
  Kind recipe. Relation takes(recipe, itemkind). Relation takesWith(recipe, itemkind). Relation makes(recipe, itemkind).
  Relation remedy(recipe).
  Goal false.
  Entity steeped_willow: recipe "willow bark and meadowsweet, steeped".
  Initially Assert takes(steeped_willow, willow_bark). Initially Assert takesWith(steeped_willow, herbs).
  Initially Assert makes(steeped_willow, minor_healing_potion). Initially Assert remedy(steeped_willow).
  Entity dandelion_tisane: recipe "dandelion and heather, boiled down".
  Initially Assert takes(dandelion_tisane, dandelion). Initially Assert takesWith(dandelion_tisane, heather).
  Initially Assert makes(dandelion_tisane, antidote). Initially Assert remedy(dandelion_tisane).
  Entity oil_and_rag: recipe "a rag stuffed in a flask of lamp oil".
  Initially Assert takes(oil_and_rag, lamp_oil). Initially Assert takesWith(oil_and_rag, bandages).
  Initially Assert makes(oil_and_rag, fire_flask).
  Action make_remedy(actor: group, mk_maker: member, mk_recipe: recipe, mk_first: item, mk_first_kind: itemkind, mk_second: item, mk_second_kind: itemkind, mk_made: itemkind) "{mk_maker}: make {mk_made} of {mk_first} and {mk_second}" {
    Description "Steeped, boiled down and strained, the two are one dose that does what both would, and more: a mender's work, and it can spoil.".
    Requires able(actor) and memberOf(mk_maker, actor) and awake(mk_maker) and not benighted(actor)
      and remedy(mk_recipe) and takes(mk_recipe, mk_first_kind) and takesWith(mk_recipe, mk_second_kind) and makes(mk_recipe, mk_made)
      and ownedItem(mk_first, mk_maker) and itemKind(mk_first, mk_first_kind) and ownedItem(mk_second, mk_maker) and itemKind(mk_second, mk_second_kind).
    Time 6.
    Resolve check(actor, mending, dc_fair).
    On success { Spend mk_first_kind from actor. Spend mk_second_kind from actor. Give mk_made to actor. }
    On failure { Spend mk_first_kind from actor. }
    Result "{mk_maker} makes {mk_made} of them.".
    Otherwise "It boils over, or goes to a brown sludge: {mk_first} is spoiled.".
  }
  Action make_plain(actor: group, mk_maker: member, mk_recipe: recipe, mk_first: item, mk_first_kind: itemkind, mk_second: item, mk_second_kind: itemkind, mk_made: itemkind) "{mk_maker}: make {mk_made} of {mk_first} and {mk_second}" {
    Description "Plain work, quickly done.".
    Requires able(actor) and memberOf(mk_maker, actor) and awake(mk_maker) and not benighted(actor)
      and not remedy(mk_recipe) and takes(mk_recipe, mk_first_kind) and takesWith(mk_recipe, mk_second_kind) and makes(mk_recipe, mk_made)
      and ownedItem(mk_first, mk_maker) and itemKind(mk_first, mk_first_kind) and ownedItem(mk_second, mk_maker) and itemKind(mk_second, mk_second_kind).
    Time 1.
    On success { Spend mk_first_kind from actor. Spend mk_second_kind from actor. Give mk_made to actor. }
    Result "{mk_maker} makes {mk_made} of them.".
  }
}
