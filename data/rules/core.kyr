Module world_core "Bodies, places, time and the shared catalog" {
  Kind group. Kind place. Kind good. Kind clock. Kind capability.
  // An ending an author writes (Ending … when … "epilogue"): reached once, and the book closes on it.
  Kind ending. Relation reached(ending).
  // A chapter of a module's story, opened once (see Chapter).
  Kind heading. Relation chapterOpened(heading).
  // A promise the company makes (see Promise): made, then kept or broken.
  Kind promise. Relation promiseMade(promise). Relation promiseKept(promise). Relation promiseBroken(promise).
  // An occasion and its matters, taken up in order (see Occasion): begun, a matter open since a watch, done, over.
  Kind occasion. Kind matter. Relation occasionBegun(occasion). Relation occasionOver(occasion).
  Relation matterOpen(matter). Relation matterDone(matter). Measure matterSince(matter).
  // Something done that a company grows by (Milestone … worth … when …): achieved once, and worth so much experience.
  Kind milestone. Relation achieved(milestone). Measure merit(milestone).
  Entity gold: good "coin". Entity rations: good "ration". Entity clock: clock "Time".
  Entity woodcraft: capability "Woodcraft". Entity mending: capability "Mending".
  Entity lockwork: capability "Lockwork". Entity trapwork: capability "Trapwork".
  Entity wayfinding: capability "Wayfinding". Entity digging: capability "Digging".
  Entity brawn: capability "Brawn". Entity stealth: capability "Stealth".
  Entity lore: capability "Lore". Entity rites: capability "Rites of the dead".
  Entity climbing: capability "Climbing". Entity light: capability "Light". Entity flame: capability "Flame".
  Entity sunlight: capability "Sunlight". Entity perception: capability "Keen eyes".
  // What a keeper of the deep fears that only its makers' own bane brings: the Stone-Singers' bell, the Wardens' oath.
  Entity knell: capability "The singers' knell". Entity oath: capability "The Wardens' oath".
  Entity persuasion: capability "Persuasion". Entity deception: capability "Deception".
  Entity intimidation: capability "Intimidation". Entity insight: capability "Insight".
  // How hard a check is (Resolve check(actor, persuasion, dc_fair)): ten, thirteen, sixteen or nineteen to beat.
  Kind difficulty. Entity dc_easy: difficulty "easy". Entity dc_fair: difficulty "fair".
  Entity dc_hard: difficulty "hard". Entity dc_formidable: difficulty "formidable".
  // The lie of the land a region is: what a party's perks of place (an elven tribe in a forest) answer to.
  Kind terrainkind. Relation terrain(place, terrainkind).
  Entity forest: terrainkind "forest". Entity marsh: terrainkind "marsh". Entity mountain: terrainkind "mountain".
  Entity frost: terrainkind "frost". Entity desert: terrainkind "desert". Entity hills: terrainkind "hills".
  // The land a stretch of country is (a river's vale, a wood, a mere, a pass): what a chart draws it as. The names
  // are prefixed, as every module shares them and an author's own place may well be called "pass".
  Kind landkind. Relation landform(place, landkind).
  Entity land_river: landkind "river". Entity land_lake: landkind "lake". Entity land_peak: landkind "peak".
  Entity land_pass: landkind "pass". Entity land_wood: landkind "wood".
  Relation at(entity, place) exclusive.
  // How big a settlement is: what can be seen of it from the road, and what it can spare.
  Kind sizekind. Relation townSize(place, sizekind).
  Entity size_hamlet: sizekind "hamlet". Entity size_village: sizekind "village". Entity size_town: sizekind "town".
  Relation able(group). Relation dead(group). Relation distinct(entity, entity).
  // Someone or something in a place of an area, however deep ("within(party, cherrett_lodging)": the parlour, the
  // stair or her room). Computed, as distinct is, of what is bound: never asserted.
  Relation within(entity, place).
  Relation closed(place). Relation indoors(place). Relation settled(place).
  Relation peaceable(group). Relation routed(group).
  Relation dark().
  Relation witnessedAttack(group, group, group).
  Relation refusesService(group, group).
  Relation capable(group, capability). Relation brings(member, capability).
  // What the company can do for a while by what it has done, not by what it carries (a brand lit at the ox fire and
  // held up high: flame, for two hours): Assert granted(party, flame). Set grantedUntil(party, flame) to watch(clock) +
  // 12. It ends when that watch comes; one given no end lasts until it is retracted (the Liberty of the Ice's 23: a
  // brand made in the story could not be what the wolves feared).
  Relation granted(group, capability). Measure grantedUntil(group, capability).
  Rule grant_ends when granted(?c, ?k) and grantedUntil(?c, ?k) >= 1 and watch(clock) >= grantedUntil(?c, ?k) {
    Retract granted(?c, ?k).
  }
  Relation serves(group, group).
  Query allied(a: group, b: group) means serves(a, b) or serves(b, a) or (serves(a, ?m) and serves(b, ?m)).
  Relation unlit(place). Relation company(group).
  // Where a company has been: once it has stood somewhere, it knows the place and can find it again.
  Relation been(group, place).
  Rule been_there when company(?c) and at(?c, ?p) and not been(?c, ?p) { Assert been(?c, ?p). }
  // A place's law: everyone in it, or anywhere within it, fights under that condition (a plane where fire burns
  // small, a temple where no blade is drawn). The law names a catalog condition.
  Kind law. Relation law(place, law).
  // A place where light dies: only sunlight shows anything there.
  Relation lightless(place).
  // One who lets another be: does not bar its way or fall on it (a toll paid, a bribe taken, recruits believed).
  Relation tolerates(group, group).
  // Someone falling on another: on the company, it starts a fight there and then.
  Relation assails(group, group).
  // Someone stopping another where they stand (a challenge, a hold-up): on the company, whatever it was doing is
  // broken off, and it must deal with them.
  Relation halts(group, group).
  // A company on the way, between where it set out and where it is going: enRoute(company, by this passage).
  Relation enRoute(group, passage).
  Query benighted(a: group) means company(a) and at(a, ?p) and not capable(a, sunlight)
    and ((unlit(?p) and not capable(a, light)) or lightless(?p)).
  // The kind of work the company has done (its backgrounds' families): what those who do the same work know it by.
  Kind craft. Relation craft(group, craft).
  Entity craft_wild: craft "the wild". Entity craft_roads: craft "the roads". Entity craft_mechanisms: craft "mechanisms".
  Entity craft_shadows: craft "the shadows". Entity craft_healing: craft "healing". Entity craft_faith: craft "faith".
  Entity craft_learning: craft "learning". Entity craft_earth: craft "the earth". Entity craft_arms: craft "arms".
  Entity craft_water: craft "the water". Entity craft_stage: craft "the stage". Entity craft_trade: craft "trade".
  Entity craft_court: craft "the court". Entity craft_margins: craft "the margins".
  // How someone carries themselves, which shows in what they say (Orsino's personalities); and the words they are
  // spoken of in. Someone with no manner given has one all the same (see VoiceContext).
  Kind manner. Relation manner(group, manner).
  Entity manner_proud: manner "proud". Entity manner_grim: manner "grim". Entity manner_cheerful: manner "cheerful".
  Entity manner_acerbic: manner "acerbic". Entity manner_compassionate: manner "compassionate".
  Entity manner_stoic: manner "stoic". Entity manner_jovial: manner "jovial".
  Kind pronoun. Relation pronouns(group, pronoun).
  Entity pron_he: pronoun "he". Entity pron_she: pronoun "she". Entity pron_they: pronoun "they". Entity pron_it: pronoun "it".
  // Who is awake to the world. A group that the day's round or a spell has put to sleep sees nothing that happens.
  Relation asleep(group).
  Query alert(g: group) means able(g) and not asleep(g).
  // Whether one would see what another does where both are: awake, there, and not hidden from them.
  Relation unseen(group, group).
  Query perceives(o: group, s: group) means at(o, ?p) and at(s, ?p) and alert(o) and not unseen(s, o).
  Measure quantity(entity, good). Measure watch(clock). Measure encounterXp(group).
  Goal false.
  // Someone who means the company no good where it is: a long wait or a rest is broken off when one arrives.
  Query threatened(a: group) means at(a, ?p) and at(?o, ?p) and able(?o) and distinct(?o, a) and not peaceable(?o)
    and not allied(?o, a) and not tolerates(?o, a).
  Action wait(actor: group) "Wait a while" {
    Requires able(actor). Time 1.
  }
  // A company that cannot move (all of it asleep, or held fast) can only lie as it is until it can.
  Action lie_still(actor: group) "Lie as you are" {
    Description "You cannot move. Time passes over you until you can.".
    Requires company(actor) and not able(actor) and not dead(actor). Time 1.
  }
  Action wait_hour(actor: group) "Wait an hour" {
    Requires able(actor). Time 6. Interrupted when threatened(actor).
    Result "An hour passes.".
  }
  Measure untilLight(clock). Measure untilMorning(clock).
  // The hour of the day (0 to 23) and the day since the company came (1, 2…): what people's days are kept by. The
  // night's count (nightCount) is that of the night that falls on that day, from noon until noon the next.
  Measure hour(clock). Measure day(clock). Measure nightCount(clock).
  // A die thrown each watch, 1 to 100, for what is left to chance: dice(clock) for the world, and dice(x) for each
  // thing's own, so that what is left to chance in two places, or for two people, does not fall out alike.
  Measure dice(entity).
  // The season by the campaign's calendar, when it keeps one: 1 spring, 2 summer, 3 autumn, 4 winter (0: none).
  Measure season(clock).
  Action wait_for_light(actor: group) "Wait until first light" {
    Requires able(actor) and dark(). Time untilLight(clock). Interrupted when threatened(actor).
    Result "The sky greys, then lightens. It is morning.".
  }
  Measure untilDark(clock). Measure untilTurn(clock).
  Action wait_for_dark(actor: group) "Wait until dark" {
    Requires able(actor) and not dark(). Time untilDark(clock). Interrupted when threatened(actor).
    Result "The light goes. It is dark.".
  }
  Action wait_watch(actor: group) "Wait and watch" {
    Description "Until someone comes or goes, or something changes here; or until the day turns.".
    Requires able(actor). Time untilTurn(clock). Interrupted when threatened(actor). Watchful.
    Result "Nothing comes, and nothing changes. The hours go by.".
  }
  Action assail(actor: group, prey: group, site: place) "Fall on {prey}" {
    Description "Someone who means harm closes and attacks.".
    Requires able(actor) and at(actor, site) and at(prey, site) and able(prey) and distinct(actor, prey)
      and not peaceable(actor) and not allied(actor, prey) and not tolerates(actor, prey) and not company(actor).
    On success { Assert assails(actor, prey). }
  }
  Action attack(actor: group, opponent: group, site: place) "Attack {opponent}" {
    Description "Once it starts it goes on until one side is down or runs, and whoever falls may not get up.".
    Requires able(actor) and able(opponent) and distinct(actor, opponent) and at(actor, site) and reaches(actor, opponent)
      and not peaceable(opponent).
    Resolve combat(opponent).
  }
}
