Module world_belief "What people hold true, and how they come to let it go" {
  Kind claim.
  // A claim someone holds, and how firmly they hold it: 2 sure of it, 1 shaken, and at nothing they let it go.
  // Whoever will hear reasons (a disputant) can be argued with; what tells against a claim is a fact about the world
  // (refutes), true whether anyone knows it or not.
  Relation believes(group, claim). Measure conviction(group, claim). Relation disputant(group).
  Relation refutes(fact, claim).
  // How a claim was let go: for a reason the world gave (reasoned), or only to good arguing, and whose (swayedBy). A
  // reason may shake a claim without its being let go: whoever was given one holds it still, less firmly, until the
  // rest of the way is argued. Let go for a reason it stays let go. Argued away without one, it is back by morning,
  // and the one who argued it away is scorned for it: not listened to again.
  Relation reasoned(group, claim). Relation swayedBy(group, claim, group). Relation doubts(group, claim).
  Relation scorns(group, group).
  // What one person hears is carried to another (the Liberty of the Ice's 5: a lie told to Abel, or a truth told on the
  // Liars' Bench in front of Kemble, had to be carried to Harker by hand-made relations and rules). Whoever is told of
  // something has heard of it (heardOf, asserted by what tells them: a topic, a rule); one who passes on what they hear
  // to someone (passesTo: a tattler to their master) has passed it on once the two are together; one who overhears
  // (overhears) hears what anyone beside them has heard.
  Relation heardOf(group, entity). Relation passesTo(group, group). Relation overhears(group).
  Rule passed_on when heardOf(?a, ?f) and passesTo(?a, ?b) and together(?a, ?b) and able(?a) and not heardOf(?b, ?f) {
    Assert heardOf(?b, ?f).
  }
  Rule overheard when heardOf(?a, ?f) and overhears(?k) and together(?k, ?a) and able(?k) and not heardOf(?k, ?f) {
    Assert heardOf(?k, ?f).
  }
  Rule let_go when believes(?g, ?c) and conviction(?g, ?c) < 1 { Retract believes(?g, ?c). Assert doubts(?g, ?c). }
  Rule sway_wears_off when doubts(?g, ?c) and swayedBy(?g, ?c, ?a) and not reasoned(?g, ?c) and untilLight(clock) == 1 {
    Retract doubts(?g, ?c). Retract swayedBy(?g, ?c, ?a). Assert believes(?g, ?c). Set conviction(?g, ?c) to 2.
    Assert scorns(?g, ?a).
  }
  Goal false.
}
