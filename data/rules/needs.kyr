Module world_needs "Food and sleep" {
  Relation eats(group). Relation hungry(group).
  Measure nextMeal(group).
  // A company that sleeps grows weary eighteen hours after it last woke from sleep (a bed, a camp, a rest), and stays
  // so until it sleeps again; a weary company fights the worse for it (see Campaign.encounterBattle). A sleep that can
  // be broken (a camp, a rest) has its effects when it ends; a bed at an inn cannot, and has them when it begins, so
  // it sets lastSlept to when the night will end.
  Relation sleeps(group). Relation weary(group).
  Measure lastSlept(group).
  Goal false.
  Rule meal when eats(?g) and watch(clock) >= nextMeal(?g) and quantity(?g, rations) >= 1 {
    Decrease quantity(?g, rations) by 1. Increase nextMeal(?g) by 144. Retract hungry(?g).
  }
  Rule hunger when eats(?g) and watch(clock) >= nextMeal(?g) and quantity(?g, rations) < 1 and not hungry(?g) {
    Assert hungry(?g).
  }
  // Told by the narrator when it comes (see Narrator.exchange), not said: it does not stop a wait for light.
  Rule weariness when sleeps(?g) and watch(clock) >= lastSlept(?g) + 108 and not weary(?g) {
    Assert weary(?g).
  }
}
